# Deterministic LF in the repository and on every checkout.
#
# The frozen oracle artifacts include lexer token streams whose positions are byte
# offsets into the source. If a checkout rewrites LF to CRLF (core.autocrlf), every
# offset shifts by the number of preceding lines and byte parity with the oracle
# breaks. Force LF so the sources a clone sees are identical to the ones the frozen
# oracle was produced from.
* text=auto eol=lf

# Generated binaries and archives: never line-ending convert.
*.zip binary
*.ar  binary
*.a   binary
*.lib binary
*.exe binary
*.dll binary
*.o   binary
*.obj binary
*.ir  binary
*.irx binary
*.png binary
*.ico binary
