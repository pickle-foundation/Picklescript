module runtime.boxscalar

/// Port of `runtime/src/boxscalar.rs`: primitive boxing ports.
///
/// The ABI stays native: `pickle_box_int/float/bool/char` allocate a
/// 32-byte box whose low word is the value; `pickle_box_class_id` reports the
/// boxed type; `pickle_unbox_int/float/bool/char` extract or panic on a
/// wrong box.
///
/// What a self-hosted runtime owns is the CONTRACT: box class ids, the
/// payload-bearing class families, and the exact unbox failure messages.

import { PICKLE_CLASS_BOX_INT, PICKLE_CLASS_BOX_FLOAT, PICKLE_CLASS_BOX_BOOL, PICKLE_CLASS_BOX_CHAR } from runtime.object

/// Size of a boxed scalar object (payload + tag word) in object bytes.
const BOX_OBJECT_SIZE: int = 32

/// Panic message for an unbox of the wrong kind / a null.
fn unboxMessage(what: string) -> string {
    "pickle: cannot unbox null as " + what
}

/// Class ids that carry a boxed payload:
///   PICKLE_CLASS_BOX_INT(3), PICKLE_CLASS_BOX_FLOAT(4),
///   PICKLE_CLASS_BOX_BOOL(5), PICKLE_CLASS_BOX_CHAR(6).
fn isBoxClass(cid: int) -> bool {
    cid >= PICKLE_CLASS_BOX_INT && cid <= PICKLE_CLASS_BOX_CHAR
}

/// Canonical name of a box class.
fn boxClassName(cid: int) -> string? {
    if (cid == PICKLE_CLASS_BOX_INT) {
        return "int"
    }
    if (cid == PICKLE_CLASS_BOX_FLOAT) {
        return "float"
    }
    if (cid == PICKLE_CLASS_BOX_BOOL) {
        return "bool"
    }
    if (cid == PICKLE_CLASS_BOX_CHAR) {
        return "char"
    }
    none
}