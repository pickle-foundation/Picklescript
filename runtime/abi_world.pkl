module runtime.abi_world

/// The process execution-mode seam: the optional world lock plus the portable
/// per-object lock and condition-cell contract every synchronization primitive
/// is built on.
///
/// TWO MODES. `runtime.abi_gil` answers whether the old process-wide lock still
/// serializes Pickle execution:
///
///   - **Parallel (default).** No world lock is taken. Threads run Pickle code
///     concurrently; allocation, registration and the collector are safe on
///     their own (Phase 2/3), and each sync object owns a lock cell. Blocking
///     calls enter a native section instead of releasing a GIL.
///   - **Serialized (`PKL_GIL=1`).** Every thread runs Pickle code under one
///     world lock. This is the pre-Phase-4 behaviour, kept as a bisecting aid:
///     if a race disappears under `PKL_GIL=1`, the bug is in the parallel
///     contracts, not in the language or the collector.
///
/// The mode is read once from the environment and never changes, so the branch
/// in `lockAcquire`/`parkOn` is perfectly predictable.
///
/// THE PORTABLE CONTRACT, IN PLATFORM-NEUTRAL TERMS:
///
///   worldAcquire()          enter a native section, take the world lock,
///                           leave it (no-op lock in parallel mode)
///   worldRelease()          enter a native section, give the lock up
///   worldHeld()             snapshot probe (startup only)
///   lockAcquire(cell)       take a one-word per-object lock, blocking
///   lockRelease(cell)       release it
///   parkOn(lockCell, cv)    atomically release `lockCell`, sleep on `cv`,
///                           reacquire `lockCell`; spurious wakes possible
///   wakeOn(cv)              wake one sleeper
///   wakeAllOn(cv)           wake every sleeper
///
///   - blocking: the OS parks the waiter, it never spins
///   - every wait is a predicate loop around `parkOn`
///   - a lock cell and a condition cell are one zero-initialized word each;
///     their encoding is a backend detail
///   - a thread blocked on a lock or a condition cell is in a native section,
///     so the collector never waits for it
///
/// THIS MODULE IS THE SEAM. Every portable runtime module imports these
/// functions and never names an OS lock. The Win32 implementation lives in
/// `runtime/abi_world_win.pkl` (SRWLOCK + CONDITION_VARIABLE, both
/// zero-initialized image data); a POSIX build supplies
/// `runtime/abi_world_posix.pkl` with the same `winWorld*`/`winLock*` entry
/// points backed by `pthread_mutex_t`/futex and a different word layout. The
/// build's platform filter selects exactly one backend file, so the portable
/// modules are unchanged. The same rule applies to every future parking
/// primitive: the OS call belongs in a `_win`/`_posix` module, the
/// wait/notify contract belongs here or in the module that owns the object.
///
/// WHAT MUST NOT HAPPEN. No `win_acquire_srw_exclusive`, `CRITICAL_SECTION`,
/// `pthread_mutex_*`, or futex call may appear outside a backend module. A
/// second hand-rolled spinlock is also forbidden.

import { winWorldAcquire, winWorldRelease, winWorldHeld, winWorldPark, winLockAcquire, winLockRelease, winTryLockAcquire, winParkOn, winWakeOn, winWakeAllOn } from runtime.abi_world_win
import { abiGilMode } from runtime.abi_gil
import { abiGcEnterNative, abiGcLeaveNative } from runtime.abi_gcengine

/// Take the world lock, blocking until it is free; a no-op in parallel mode.
///
/// The blocked acquirer is in a native section: it touches no managed object
/// while it waits, so the collector does not count it. `abiGcLeaveNative`
/// restores the count and runs a safepoint before the caller can use the heap
/// again.
fn worldAcquire() {
    abiGcEnterNative()
    if (abiGilMode() != 0) {
        winWorldAcquire()
    }
    abiGcLeaveNative()
}

/// Release the world lock. The caller must own it. In parallel mode this only
/// starts a native section, which is what a caller continues into: a blocking
/// OS call that must not hold up a collection.
fn worldRelease() {
    abiGcEnterNative()
    if (abiGilMode() != 0) {
        winWorldRelease()
    }
}

/// Non-blocking probe: does the world lock look owned right now?
///
/// This is a snapshot, not ownership. The only caller is the startup net in
/// `abiThreadSpawn`, which uses it to acquire the lock lazily on an image whose
/// entry trampoline did not run `pickle_runtime_init` (the JIT lane). It is
/// only consulted in serialized mode.
fn worldHeld() -> bool {
    return winWorldHeld()
}

/// Take the one-word lock at `cell`, blocking until it is free.
///
/// Fast path: one non-blocking hardware acquire. A contended acquire is a
/// native section around the blocking acquire, because the holder may itself be
/// parked at a safepoint until the collection that is waiting for *this* thread
/// finishes. Counting a blocked acquirer would deadlock the collector.
fn lockAcquire(cell: int) {
    if (abiGilMode() != 0) {
        return
    }
    if (winTryLockAcquire(cell) != 0) {
        return
    }
    abiGcEnterNative()
    winLockAcquire(cell)
    abiGcLeaveNative()
}

/// Release the lock at `cell`. The caller must own it.
fn lockRelease(cell: int) {
    if (abiGilMode() != 0) {
        return
    }
    winLockRelease(cell)
}

/// Atomically release `lockCell`, sleep on `cv`, reacquire `lockCell`.
///
/// `cv` and `lockCell` are the address of one zero-initialized word each, owned
/// by the calling primitive. Parking can wake spuriously, so the caller must
/// wrap the call in a predicate loop:
///
///     while (!ready()) {
///         parkOn(lockCell, cv)
///     }
///
/// The release/park is atomic with respect to the waker, which holds the same
/// lock cell when it changes the predicate - that is what rules out a lost
/// wakeup between the check and the sleep.
///
/// The sleep is a native section: no other thread waits on this one, and
/// `abiGcLeaveNative` restores the count and runs a safepoint afterwards. In
/// serialized mode the object lock is a no-op and the wait releases the world
/// lock instead, which is the pre-Phase-4 behaviour.
fn parkOn(lockCell: int, cv: int) {
    abiGcEnterNative()
    if (abiGilMode() != 0) {
        winWorldPark(cv)
    } else {
        winParkOn(lockCell, cv)
    }
    abiGcLeaveNative()
}

/// Wake one thread parked on `cv`; a no-op when nobody is waiting. The caller
/// must hold the lock cell paired with the condition cell.
fn wakeOn(cv: int) {
    winWakeOn(cv)
}

/// Wake every thread parked on `cv`. The caller must hold the paired lock cell.
fn wakeAllOn(cv: int) {
    winWakeAllOn(cv)
}
