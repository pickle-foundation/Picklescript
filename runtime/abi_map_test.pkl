module runtime.abi_map_test

/// Behavioral tests for the ported map ABI bodies, mirroring `runtime/src/map.rs`'s own
/// `mod tests` case for case, plus pins for the 64-bit hash arithmetic.
///
/// The hash pins come from an INDEPENDENT reference implementation of FNV-1a, not from
/// the Rust map. That distinction matters: if they came from the Rust side they would
/// only prove the table agrees with itself, while these prove the ported FNV-1a,
/// the `(h ^ x) * PRIME` mix and the two's-complement negation of the out-of-range
/// constants all reproduce the standard algorithm. `0xCBF29CE484222325` is written as
/// `(0 - 0x340D631B7BDDDCDB)` because Pickle rejects literals above `i64::MAX`.

import { abiMapNew, abiMapSet, abiMapSetSlow, abiMapGet, abiMapGetSlow, abiMapGetBoxed, abiMapHas, abiMapRemove, abiMapMerge, abiMapClear, abiMapEntries } from runtime.abi_map
import { abiMapLen, abiMapKeys, abiMapValues, keyHash, keyEq, deepHash, mapNew, mapGet, entriesCount, needsGrow, isLiveKey } from runtime.abi_map
import { LEN_WORD, CAP_WORD, OCCUPIED_WORD, ENTRIES_WORD, GOLDEN, CYCLIC_HASH, keyScratch, KEY_FLAG_OFF } from runtime.abi_map
import { llKey } from runtime.abi_map
import { abiTupleField } from runtime.abi_tuple
import { abiBoxI64, abiUnboxI64, abiBoxBool, newBox } from runtime.abi_box
import { abiListLen, abiListGet, abiListPush, listNew } from runtime.abi_list
import { abiStrFromI64, abiStrLen, newStr, byteInto } from runtime.abi_string
import { PICKLE_CLASS_MAP, PICKLE_CLASS_BOX_INT, PICKLE_CLASS_BOX_BOOL } from runtime.object
import { HEADER } from runtime.layout

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

/// Build a string object from explicit byte values (Pickle string literals are `string`,
/// not the `*int` raw object the ABI takes).
fn mkStr(b0: int, b1: int, b2: int, b3: int, b4: int) -> *int {
    var o = newStr(5)
    byteInto(o, 0, b0)
    byteInto(o, 1, b1)
    byteInto(o, 2, b2)
    byteInto(o, 3, b3)
    byteInto(o, 4, b4)
    return o
}

fn mkAlpha() -> *int { return mkStr(97, 108, 112, 104, 97) }
fn mkBeta() -> *int { return mkStr(98, 101, 116, 97, 32) }

/// A user class instance with `n` boxed-int slots, like `make_obj` in the native tests.
fn mkObj(classId: int, slots: List<int>) -> *int {
    unsafe {
        var o = alloc(int, 3 + len(slots))
        o[0] = 0
        o[1] = classId
        o[2] = HEADER + len(slots) * 8
        var i = 0
        while (i < len(slots)) {
            o[3 + i] = abiBoxI64(slots[i]) as int
            i = i + 1
        }
        return o
    }
}

/// An enum object: tag plus `n` boxed-int fields (`enum_new(tag, n)`).
fn mkEnum(tag: int, n: int) -> *int {
    return newBox(7, tag)
}

/// A list of boxed ints, like `list_of(&[...])` in the native tests.
fn listOf(vals: List<int>) -> *int {
    var l = listNew(0)
    var i = 0
    while (i < len(vals)) {
        abiListPush(l, abiBoxI64(vals[i]))
        i = i + 1
    }
    return l
}

fn isNull(p: *int) -> bool { return (p as int) == 0 }

/// Build a string object of arbitrary length from explicit byte values.
fn mkStrBytes(bs: List<int>) -> *int {
    var o = newStr(len(bs))
    var i = 0
    while (i < len(bs)) {
        byteInto(o, i, bs[i])
        i = i + 1
    }
    return o
}

// ---------------------------------------------------------------------------
// 64-bit arithmetic pins
// ---------------------------------------------------------------------------

test fn fnv1a_matches_the_reference_implementation() {
    // Independently computed FNV-1a over these exact bytes.
    expect(keyHash(mkAlpha())).toBe(-8447022563750764501)
    // mkBeta is "beta" space-padded out to the 5-byte helper's arity, which is why
    // this is not the hash of the 4-byte "beta".
    expect(keyHash(mkBeta())).toBe(795837917815194981)
    // A 5-byte all-NUL string is NOT the empty string: two extra FNV rounds.
    expect(keyHash(mkStr(0, 0, 0, 0, 0))).toBe(-1964607543390246577)
    // The empty string is the bare offset basis.
    expect(keyHash(newStr(0))).toBe(-3750763034362895579)
}

test fn fnv1a_is_case_and_length_sensitive() {
    // Same bytes in a different order must not collide.
    expect(keyHash(mkStr(97, 98, 99, 0, 0))).toBe(7181009592312429571)
    expect(keyHash(mkStr(99, 98, 97, 0, 0))).toBe(7433921410713404571)
    expect(keyHash(mkStr(97, 98, 99, 0, 0)) != keyHash(mkStr(99, 98, 97, 0, 0))).toBe(true)
    expect(keyHash(mkStr(97, 108, 112, 104, 97)) != keyHash(mkStr(97, 108, 112, 104, 98))).toBe(true)
}

test fn boxed_scalar_key_hash_mixes_class_and_payload() {
    // boxed(class, bits) = mix(mix(FNV_OFFSET, class), bits), pinned per case.
    expect(keyHash(abiBoxI64(0))).toBe(591640642936787734)
    expect(keyHash(abiBoxI64(1))).toBe(591641742448415945)
    expect(keyHash(abiBoxI64(100))).toBe(591750594099608834)
    expect(keyHash(abiBoxI64(200))).toBe(591579070285607918)
    expect(keyHash(abiBoxI64(-5))).toBe(-591646140494928789)
    expect(keyHash(abiBoxI64(-1))).toBe(-591641742448415945)
    // The class id is mixed in, so an equal payload in another box class is a different key.
    expect(keyHash(abiBoxBool(true))).toBe(585902291750289875)
    expect(keyHash(abiBoxBool(true)) != keyHash(abiBoxI64(1))).toBe(true)
}

test fn none_key_hashes_to_the_golden_constant() {
    // A null key and the stored `none` marker are one identity, hashed as GOLDEN.
    expect(keyHash(0 as *int)).toBe(GOLDEN)
    expect(keyHash(0 as *int)).toBe(-7046029254386353131)
}

test fn cyclic_hash_constant_is_stable() {
    expect(CYCLIC_HASH).toBe(3387441590996828161)
}

test fn a_revisited_ancestor_reports_the_cyclic_hash() {
    // A list that refers to itself: deepHash must detect the revisit rather than
    // recurse forever, and report cyclic = true.
    var selfRef = listNew(0)
    abiListPush(selfRef, selfRef)
    var cyclic = 0
    var h = 0
    unsafe {
        let path = keyScratch()
        let flag = (path + KEY_FLAG_OFF) as *int
        flag[0] = 0
        h = deepHash(selfRef, path as *int, 0, flag)
        cyclic = flag[0]
    }
    expect(cyclic != 0).toBe(true)
    // The *inner* revisit reports CYCLIC_HASH, but the outer call keeps mixing: its
    // result is mix(FNV_OFFSET, PICKLE_CLASS_LIST) then mix(that, CYCLIC_HASH).
    // Pinning the composed value checks both that the revisit was detected and that
    // the cyclic marker is propagated upward rather than swallowed.
    expect(h).toBe(-1819398542068248969)
}

test fn cyclic_keys_fall_back_to_root_identity() {
    // Two *distinct* self-referential lists are different keys, even though both are
    // "a list containing itself" -- identity is the only strength-safe comparison.
    var a = listNew(0)
    abiListPush(a, a)
    var b = listNew(0)
    abiListPush(b, b)
    expect(keyEq(a, a)).toBe(true)
    expect(keyEq(a, b)).toBe(false)
}

test fn equal_acyclic_structures_hash_identically() {
    // The property the whole hash is built to guarantee.
    expect(keyHash(listOf([1, 2, 3]))).toBe(keyHash(listOf([1, 2, 3])))
    expect(keyHash(listOf([1, 2, 3])) != keyHash(listOf([3, 2, 1]))).toBe(true)
    expect(keyHash(listOf([1, 2])) != keyHash(listOf([1, 2, 3]))).toBe(true)
    // Nesting: a list of lists.
    var inner = listOf([7])
    var outer = listNew(0)
    abiListPush(outer, inner)
    var outerB = listNew(0)
    abiListPush(outerB, listOf([7]))
    expect(keyHash(outer)).toBe(keyHash(outerB))
}

// ---------------------------------------------------------------------------
// Basic table operations (native: insert_lookup_remove)
// ---------------------------------------------------------------------------

test fn insert_lookup_remove() {
    var m = mapNew(0)
    var k1 = mkAlpha()
    var k2 = mkBeta()
    var v1 = abiBoxI64(11)
    var v2 = abiBoxI64(22)
    expect(isNull(mapGet(m, k1))).toBe(true)
    expect(isNull(mapSet(m, k1, v1))).toBe(true)
    expect(mapGet(m, k1) as int).toBe(v1 as int)
    expect(isNull(mapGet(m, k2))).toBe(true)
    expect(isNull(mapSet(m, k2, v2))).toBe(true)
    expect(mapGet(m, k2) as int).toBe(v2 as int)
    expect(abiMapLen(m)).toBe(2)
    // Overwrite returns the old value and replaces it.
    var v3 = abiBoxI64(33)
    expect(mapSet(m, k1, v3) as int).toBe(v1 as int)
    expect(mapGet(m, k1) as int).toBe(v3 as int)
    expect(abiMapLen(m)).toBe(2)
    // Remove.
    expect(mapRemove(m, k2) as int).toBe(v2 as int)
    expect(isNull(mapGet(m, k2))).toBe(true)
    expect(abiMapLen(m)).toBe(1)
}

test fn many_keys_grow() {
    // 500 string keys: forces several rehashes (16 -> 32 -> ... -> 1024).
    var m = mapNew(0)
    var i = 0
    while (i < 500) {
        abiMapSet(m, abiStrFromI64(i), abiBoxI64(i * 7))
        i = i + 1
    }
    var j = 0
    while (j < 500) {
        expect(abiUnboxI64(abiMapGet(m, abiStrFromI64(j)))).toBe(j * 7)
        j = j + 1
    }
    expect(abiMapLen(m)).toBe(500)
}

test fn bloom_filter_never_hides_a_live_key() {
    var m = mapNew(0)
    var i = 0
    while (i < 300) {
        abiMapSet(m, abiStrFromI64(i), abiBoxI64(i + 5))
        i = i + 1
    }
    // Growth has rehashed and rebuilt the filter several times.
    i = 0
    while (i < 300) {
        expect(abiUnboxI64(abiMapGet(m, abiStrFromI64(i)))).toBe(i + 5)
        i = i + 1
    }
    // Removal leaves stale bits; stale bits may only cause extra probes.
    expect(abiUnboxI64(abiMapRemove(m, abiStrFromI64(7)))).toBe(12)
    expect(isNull(abiMapGet(m, abiStrFromI64(7)))).toBe(true)
    i = 0
    while (i < 300) {
        if (i != 7) {
            expect(abiUnboxI64(abiMapGet(m, abiStrFromI64(i)))).toBe(i + 5)
        }
        i = i + 1
    }
    // `clear` resets the table and the filter together.
    abiMapClear(m)
    expect(abiMapLen(m)).toBe(0)
    expect(isNull(abiMapGet(m, abiStrFromI64(8)))).toBe(true)
    abiMapSet(m, abiStrFromI64(8), abiBoxI64(88))
    expect(abiUnboxI64(abiMapGet(m, abiStrFromI64(8)))).toBe(88)
    expect(isNull(abiMapGet(m, abiStrFromI64(9)))).toBe(true)
}

/// The inlined bloom rejection answers an absent key without entering the
/// runtime. The first get has no cached hash and takes the slow leg; that leg
/// caches the hash on the heap key, so every later get here reaches the
/// two-bit probe. A negative answer must stay null, and the following set must
/// still insert (the inline deliberately does not touch the get->set cache).
test fn bloom_negative_inline_answers_absent_keys() {
    var m = mapNew(0)
    abiMapSet(m, mkAlpha(), abiBoxI64(1))
    let absent = mkStr(122, 101, 116, 97, 33)
    expect(isNull(abiMapGet(m, absent))).toBe(true)
    var i = 0
    while (i < 100) {
        expect(isNull(abiMapGet(m, absent))).toBe(true)
        i = i + 1
    }
    abiMapSet(m, absent, abiBoxI64(42))
    expect(abiUnboxI64(abiMapGet(m, absent))).toBe(42)
}

/// Long keys (> 8 bytes) get their hash cached by the set path, so the inline
/// probe runs for them too. A bloom hit must delegate to the full probe, both
/// before and after removal (removal leaves stale bits behind).
test fn bloom_inline_handles_long_keys() {
    var m = mapNew(0)
    let k = newStr(12)
    var i = 0
    while (i < 12) {
        byteInto(k, i, 97 + i)
        i = i + 1
    }
    abiMapSet(m, k, abiBoxI64(7))
    expect(abiUnboxI64(abiMapGet(m, k))).toBe(7)
    expect(abiUnboxI64(abiMapRemove(m, k))).toBe(7)
    expect(isNull(abiMapGet(m, k))).toBe(true)
}

/// The inline's negative answer never enters the runtime, so it also skips the
/// get->set last-lookup stamp. That is the one observable difference from the
/// slow path, and pinning it proves the filter (not a full probe) answered.
test fn bloom_negative_inline_skips_the_get_set_cache() {
    var m = mapNew(0)
    let alpha = mkAlpha()
    abiMapSet(m, alpha, abiBoxI64(3))
    expect(abiUnboxI64(abiMapGet(m, alpha))).toBe(3)
    let absent = mkStr(122, 101, 116, 97, 33)
    // First touch has no cached hash, so the runtime hashes, caches and stamps.
    expect(isNull(abiMapGet(m, absent))).toBe(true)
    expect(abiUnboxI64(abiMapGet(m, alpha))).toBe(3)
    let before = llKey
    expect(before).toBe(alpha as int)
    // Second touch: the hash is cached and both filter bits are clear. A full
    // probe would overwrite llKey with `absent`; the inline must not.
    expect(isNull(abiMapGet(m, absent))).toBe(true)
    expect(llKey).toBe(before)
}

test fn a_text_equal_get_lets_the_set_reuse_its_slot() {
    var m = mapNew(0)
    let stored = mkAlpha()
    let v1 = abiBoxI64(11)
    abiMapSet(m, stored, v1)
    // Split fields are always fresh objects, so the benchmark's `m[w]` set
    // follows a get with a text-equal but pointer-different key. The get
    // stamps the matched slot; the set must trust that stamp instead of
    // falling through to a second probe (and must not append a duplicate).
    let fresh = mkAlpha()
    expect((fresh as int) != (stored as int)).toBe(true)
    expect(abiUnboxI64(abiMapGet(m, fresh))).toBe(11)
    let v2 = abiBoxI64(22)
    abiMapSet(m, fresh, v2)
    expect(abiMapLen(m)).toBe(1)
    expect(abiUnboxI64(abiMapGet(m, stored))).toBe(22)
    expect(abiUnboxI64(abiMapGet(m, fresh))).toBe(22)
}

/// The widened get->set cache relies on `mapVer` covering every structural
/// mutation. `abiMapSetSlow` is reachable directly, so it must bump the
/// version itself. Without that bump, a get's stamp survives a growth and the
/// next set can overwrite whatever unrelated key landed on the old slot index.
test fn a_direct_slow_set_invalidates_the_get_set_cache() {
    var m = mapNew(0)
    let a = mkAlpha()
    abiMapSet(m, a, abiBoxI64(1))
    let fresh = mkAlpha()
    expect(abiUnboxI64(abiMapGet(m, fresh))).toBe(1)
    // Force a rehash behind the cache's back.
    var keys = List<*int>()
    var i = 0
    while (i < 20) {
        let k = mkStrBytes([100, 48 + (i / 10), 48 + (i % 10)])
        keys.push(k)
        abiMapSetSlow(m, k, abiBoxI64(100 + i))
        i = i + 1
    }
    abiMapSet(m, fresh, abiBoxI64(7))
    expect(abiMapLen(m)).toBe(21)
    expect(abiUnboxI64(abiMapGet(m, a))).toBe(7)
    i = 0
    while (i < 20) {
        expect(abiUnboxI64(abiMapGet(m, keys[i]))).toBe(100 + i)
        i = i + 1
    }
}

/// `rehash` skips equality checks because a fresh table and pairwise-distinct
/// live keys cannot produce a hit. Its placement rule must still be exactly
/// `findSlot`'s: scan from `hash & mask` to the first EMPTY slot. Comparing a
/// grown table with the same keys inserted into a table pre-sized to the final
/// capacity pins keys, values, `occupied`, len and every slot word.
test fn rehash_matches_a_pre_sized_insert_slot_for_slot() {
    var grown = mapNew(0)
    var keys = List<*int>()
    var vals = List<*int>()
    var i = 0
    while (i < 300) {
        let k = mkStrBytes([107, 48 + (i / 100), 48 + ((i / 10) % 10), 48 + (i % 10)])
        let v = abiBoxI64(i)
        keys.push(k)
        vals.push(v)
        abiMapSet(grown, k, v)
        i = i + 1
    }
    unsafe {
        let pre = mapNew(grown[CAP_WORD])
        expect(pre[CAP_WORD]).toBe(grown[CAP_WORD])
        i = 0
        while (i < 300) {
            abiMapSet(pre, keys[i], vals[i])
            i = i + 1
        }
        expectSameTable(grown, pre)
    }
}

test fn a_fresh_table_reports_zero_live_entries() {
    // Regression: `alloc` returns uninitialised memory (a fresh alloc(8) reads back with
    // all eight words non-zero), and an open-addressing table treats "this slot is
    // non-zero" as "this slot holds a live entry". Before the table was zeroed
    // explicitly, `entriesCount` on a brand-new map reported 16 live entries, so
    // `needsGrow` fired on the very first insert and `findSlot` probed an unreadable key.
    unsafe {
        var m = mapNew(0)
        var entries = m[ENTRIES_WORD] as *int
        var cap = m[CAP_WORD]
        expect(entriesCount(entries, cap)).toBe(0)
        expect(m[OCCUPIED_WORD]).toBe(0)
        expect(needsGrow(m)).toBe(false)
        // Every slot must genuinely read null, not merely "not crash".
        var i = 0
        while (i < cap) {
            expect(entries[i * 2]).toBe(0)
            expect(entries[i * 2 + 1]).toBe(0)
            i = i + 1
        }
    }
}

test fn a_rehashed_table_is_zeroed_before_reuse() {
    // Same invariant one rehash later: the fresh table must be zeroed before entries are
    // re-probed into it, or `map_len` and the probe chains disagree with the contents.
    var m = mapNew(0)
    var i = 0
    while (i < 100) {
        abiMapSet(m, abiStrFromI64(i), abiBoxI64(i))
        i = i + 1
    }
    unsafe {
        var entries = m[ENTRIES_WORD] as *int
        expect(entriesCount(entries, m[CAP_WORD])).toBe(abiMapLen(m))
        var live = 0
        var j = 0
        while (j < m[CAP_WORD]) {
            if (isLiveKey(entries[j * 2])) {
                live = live + 1
                // A live slot carries a real value pointer.
                expect(entries[j * 2 + 1] != 0).toBe(true)
            } else {
                // A free slot must be fully zeroed -- both halves. A stale key in one
                // half with a zeroed value is exactly what corrupts `entriesCount`.
                expect(entries[j * 2]).toBe(0)
                expect(entries[j * 2 + 1]).toBe(0)
            }
            j = j + 1
        }
        expect(live).toBe(100)
    }
}

test fn capacity_is_rounded_up_to_a_power_of_two() {
    // `find_slot` masks with `cap - 1`, so the table MUST be a power of two.
    unsafe {
        var m = mapNew(0)
        expect(m[CAP_WORD]).toBe(16)
        expect(m[LEN_WORD]).toBe(0)
        expect((m[ENTRIES_WORD] as int) != 0).toBe(true)
        // A request below INITIAL_CAP is floored to it.
        var s = mapNew(4)
        expect(s[CAP_WORD]).toBe(16)
        // A request above it rounds up.
        var t = mapNew(20)
        expect(t[CAP_WORD]).toBe(32)
        var u = mapNew(64)
        expect(u[CAP_WORD]).toBe(64)
        // Header is class id MAP and size MAP_OBJECT_SIZE.
        expect(m[1]).toBe(PICKLE_CLASS_MAP)
        expect(m[2]).toBe(56)
    }
}

test fn growth_doubles_capacity_and_preserves_every_entry() {
    // Rehash must re-probe every live entry, not just rehash in place: a plain copy
    // would strand entries whose new home is a different slot.
    var m = mapNew(0)
    var i = 0
    while (i < 40) {
        abiMapSet(m, abiStrFromI64(i), abiBoxI64(i))
        i = i + 1
    }
    unsafe {
        // needsGrow is checked BEFORE each insert against `(occupied + 1) >= cap * 0.7`,
        // so the sequence is 16 -> 32 (at 12 inserts) -> 64 (at 23), and the 40th insert
        // leaves capacity at 64 holding 40 entries. Simulating that rule gives 64, not
        // 128 -- an off-by-one here reads as "capacity is too small", which it is not.
        expect(m[CAP_WORD]).toBe(64)
    }
    var j = 0
    while (j < 40) {
        expect(abiUnboxI64(abiMapGet(m, abiStrFromI64(j)))).toBe(j)
        j = j + 1
    }
    expect(abiMapLen(m)).toBe(40)
}

test fn tombstones_count_toward_growth() {
    // Regression: `needsGrow` once counted LIVE entries only, so the tombstones left by
    // `mapRemove` could fill every probe slot while the live count stayed low. The next
    // insert then called `findSlot` on a table with no empty slot to stop on and probed
    // forever. This is the smallest form of the real sequence (grow / churn / grow /
    // churn / grow); it hung the harness before tombstones were folded into occupied
    // growth tracking.
    var m = mapNew(0)
    var i = 0
    while (i < 61) {
        abiMapSet(m, abiStrFromI64(i), abiBoxI64(i))
        i = i + 1
    }
    var a = 15
    while (a < 45) {
        abiMapRemove(m, abiStrFromI64(a))
        a = a + 1
    }
    i = 61
    while (i < 91) {
        abiMapSet(m, abiStrFromI64(i), abiBoxI64(i))
        i = i + 1
    }
    a = 45
    while (a < 75) {
        abiMapRemove(m, abiStrFromI64(a))
        a = a + 1
    }
    i = 91
    while (i < 121) {
        abiMapSet(m, abiStrFromI64(i), abiBoxI64(i))
        i = i + 1
    }
    a = 75
    while (a < 105) {
        abiMapRemove(m, abiStrFromI64(a))
        a = a + 1
    }
    i = 121
    while (i < 129) {
        abiMapSet(m, abiStrFromI64(i), abiBoxI64(i))
        i = i + 1
    }

    expect(abiMapLen(m)).toBe(39)
    unsafe {
        var cap = m[CAP_WORD]
        // A saturated table has no empty slot; `findSlot` needs one to terminate.
        expect(m[OCCUPIED_WORD] < cap).toBe(true)
        // Survivors reachable, removed keys gone.
        expect(abiUnboxI64(abiMapGet(m, abiStrFromI64(5)))).toBe(5)
        expect(abiUnboxI64(abiMapGet(m, abiStrFromI64(128)))).toBe(128)
        expect(isNull(mapGet(m, abiStrFromI64(20)))).toBe(true)
    }
}

// ---------------------------------------------------------------------------
// Boxed keys (native: boxed_int_keys)
// ---------------------------------------------------------------------------

test fn boxed_int_keys() {
    var m = mapNew(0)
    var k1 = abiBoxI64(100)
    var k2 = abiBoxI64(200)
    var k3 = abiBoxI64(-5)
    var v1 = abiBoxI64(11)
    var v2 = abiBoxI64(22)
    var v3 = abiBoxI64(33)
    expect(isNull(mapGet(m, k1))).toBe(true)
    abiMapSet(m, k1, v1)
    abiMapSet(m, k2, v2)
    abiMapSet(m, k3, v3)
    expect(mapGet(m, k1) as int).toBe(v1 as int)
    expect(mapGet(m, k2) as int).toBe(v2 as int)
    expect(mapGet(m, k3) as int).toBe(v3 as int)
    expect(abiMapLen(m)).toBe(3)
    // Overwrite; the int identity (payload + class) must still match.
    var v2b = abiBoxI64(99)
    abiMapSet(m, k2, v2b)
    expect(mapGet(m, k2) as int).toBe(v2b as int)
    expect(abiMapLen(m)).toBe(3)
    // A second box with the same payload is the same key.
    expect(mapGet(m, abiBoxI64(200)) as int).toBe(v2b as int)
    // A string is never equal to a box key.
    expect(isNull(mapGet(m, abiStrFromI64(200)))).toBe(true)
    // Remove by payload identity.
    expect(mapRemove(m, abiBoxI64(100)) as int).toBe(v1 as int)
    expect(isNull(mapGet(m, abiBoxI64(100)))).toBe(true)
    expect(abiMapLen(m)).toBe(2)
}

test fn the_none_key_is_a_usable_key() {
    // A null key becomes the `none` marker, which is a real, retrievable entry.
    var m = mapNew(0)
    var v = abiBoxI64(5)
    abiMapSet(m, 0 as *int, v)
    expect(abiMapLen(m)).toBe(1)
    expect(mapGet(m, 0 as *int) as int).toBe(v as int)
    expect(abiMapHas(m, 0 as *int)).toBe(true)
    // `map_keys` surfaces it back to callers as null, the `T?` representation.
    var keys = abiMapKeys(m)
    expect(abiListLen(keys)).toBe(1)
    expect(abiListGet(keys, 0) as int).toBe(0)
    // A `none` key is not equal to any other key, and hashes as GOLDEN.
    expect(keyEq(0 as *int, 0 as *int)).toBe(true)
    expect(keyEq(0 as *int, abiBoxI64(0))).toBe(false)
    // Removing it works too.
    expect(mapRemove(m, 0 as *int) as int).toBe(v as int)
    expect(abiMapLen(m)).toBe(0)
}

test fn none_key_does_not_collide_with_a_real_entry() {
    // The marker substitution must not make `none` and some real key share a slot.
    var m = mapNew(0)
    abiMapSet(m, 0 as *int, abiBoxI64(1))
    abiMapSet(m, abiBoxI64(2), abiBoxI64(2))
    abiMapSet(m, mkAlpha(), abiBoxI64(3))
    expect(abiMapLen(m)).toBe(3)
    expect(abiUnboxI64(abiMapGet(m, 0 as *int))).toBe(1)
    expect(abiUnboxI64(abiMapGet(m, abiBoxI64(2)))).toBe(2)
    expect(abiUnboxI64(abiMapGet(m, mkAlpha()))).toBe(3)
}

// ---------------------------------------------------------------------------
// Composite keys (native: composite_keys, class_and_enum_keys, rehash)
// ---------------------------------------------------------------------------

test fn composite_list_keys_compare_structurally() {
    var m = mapNew(0)
    var k1 = listOf([1, 2, 3])
    var k2 = listOf([4, 5])
    abiMapSet(m, k1, abiBoxI64(100))
    abiMapSet(m, k2, abiBoxI64(200))
    // A *distinct* list with equal contents is the same key (structural).
    expect(abiUnboxI64(mapGet(m, listOf([1, 2, 3])))).toBe(100)
    expect(abiUnboxI64(mapGet(m, listOf([4, 5])))).toBe(200)
    expect(abiMapLen(m)).toBe(2)
    // Different contents are different keys.
    expect(isNull(mapGet(m, listOf([1, 2])))).toBe(true)
    expect(isNull(mapGet(m, listOf([1, 2, 4])))).toBe(true)
}

test fn nested_list_keys() {
    var m = mapNew(0)
    var inner = listOf([7])
    var outer = listNew(0)
    abiListPush(outer, inner)
    abiMapSet(m, outer, abiBoxI64(99))
    var outerB = listNew(0)
    abiListPush(outerB, listOf([7]))
    expect(abiUnboxI64(mapGet(m, outerB))).toBe(99)
}

test fn rehash_with_composite_keys() {
    // 40 composite keys: forces a rehash, then every key must still be found.
    var m = mapNew(0)
    var a = 0
    while (a < 40) {
        abiMapSet(m, listOf([a, a * 2]), abiBoxI64(a * 100))
        a = a + 1
    }
    var b = 0
    while (b < 40) {
        expect(abiUnboxI64(abiMapGet(m, listOf([b, b * 2])))).toBe(b * 100)
        b = b + 1
    }
    expect(abiMapLen(m)).toBe(40)
    // Remove by a structurally-equal key.
    expect(abiUnboxI64(mapRemove(m, listOf([7, 14])))).toBe(700)
    expect(isNull(mapGet(m, listOf([7, 14])))).toBe(true)
    expect(abiMapLen(m)).toBe(39)
}

test fn class_keys_compare_by_class_and_slots() {
    var m = mapNew(0)
    var base = 100
    var a = mkObj(base, [1, 2])
    var b = mkObj(base, [1, 2])
    abiMapSet(m, a, abiBoxI64(7))
    // Two class instances with equal fields are the same key.
    expect(abiUnboxI64(abiMapGet(m, b))).toBe(7)
    // Same class, different fields -> different key.
    expect(isNull(abiMapGet(m, mkObj(base, [1, 3])))).toBe(true)
    // A different class id never matches, even with identical slots.
    expect(isNull(abiMapGet(m, mkObj(base + 1, [1, 2])))).toBe(true)
}

test fn enum_keys_compare_by_tag_and_payload() {
    var m = mapNew(0)
    var e1 = mkEnum(0, 0)
    var e1b = mkEnum(0, 0)
    abiMapSet(m, e1, abiBoxI64(55))
    expect(abiUnboxI64(abiMapGet(m, e1b))).toBe(55)
    // Different tag is a different key.
    expect(isNull(abiMapGet(m, mkEnum(1, 0)))).toBe(true)
    expect(abiMapLen(m)).toBe(1)
}

test fn a_map_used_as_a_key_matches_regardless_of_inner_order() {
    // Inner entries combine by addition when hashed, so insertion order cannot matter.
    var m = mapNew(0)
    var inner1 = mapNew(0)
    abiMapSet(inner1, abiStrFromI64(1), abiBoxI64(10))
    abiMapSet(inner1, abiStrFromI64(2), abiBoxI64(20))
    var inner2 = mapNew(0)
    abiMapSet(inner2, abiStrFromI64(2), abiBoxI64(20))
    abiMapSet(inner2, abiStrFromI64(1), abiBoxI64(10))
    expect(keyHash(inner1)).toBe(keyHash(inner2))
    expect(keyEq(inner1, inner2)).toBe(true)
    // And they work as keys of an outer map.
    abiMapSet(m, inner1, abiBoxI64(1))
    expect(abiUnboxI64(abiMapGet(m, inner2))).toBe(1)
}

test fn tuple_keys_compare_by_arity_and_fields() {
    var m = mapNew(0)
    var t1 = tupleOf(2, 10, 20)
    abiMapSet(m, t1, abiBoxI64(1))
    expect(abiUnboxI64(abiMapGet(m, tupleOf(2, 10, 20)))).toBe(1)
    expect(isNull(abiMapGet(m, tupleOf(2, 10, 21)))).toBe(true)
    expect(isNull(abiMapGet(m, tupleOf(1, 10, 0)))).toBe(true)
}

/// Build a tuple object with `n` boxed-int fields, mirroring `tuple_new`.
fn tupleOf(n: int, a: int, b: int) -> *int {
    unsafe {
        var t = alloc(int, 4 + n)
        t[0] = 0
        t[1] = 8
        t[2] = 32 + n * 8
        t[3] = n
        t[4] = abiBoxI64(a) as int
        if (n > 1) { t[5] = abiBoxI64(b) as int }
        return t
    }
}

// ---------------------------------------------------------------------------
// Tombstones
// ---------------------------------------------------------------------------

test fn removal_leaves_a_tombstone_that_does_not_break_the_probe_chain() {
    // Open addressing with tombstones: entries after a removed one live in the same
    // probe chain, so a body that cleared the slot instead of tombstoning it would
    // strand them and every lookup past the hole would miss.
    var m = mapNew(0)
    var i = 0
    while (i < 12) {
        abiMapSet(m, abiStrFromI64(i), abiBoxI64(i))
        i = i + 1
    }
    // Remove every other key.
    var r = 0
    while (r < 12) {
        if (r % 2 == 0) {
            expect(abiUnboxI64(mapRemove(m, abiStrFromI64(r)))).toBe(r)
        }
        r = r + 2
    }
    expect(abiMapLen(m)).toBe(6)
    // The survivors are all still reachable.
    var s = 1
    while (s < 12) {
        expect(abiUnboxI64(abiMapGet(m, abiStrFromI64(s)))).toBe(s)
        expect(abiMapHas(m, abiStrFromI64(s))).toBe(true)
        s = s + 2
    }
    // The removed ones are gone, and re-inserting one works.
    var t = 0
    while (t < 12) {
        if (t % 2 == 0) { expect(abiMapHas(m, abiStrFromI64(t))).toBe(false) }
        t = t + 2
    }
    abiMapSet(m, abiStrFromI64(0), abiBoxI64(1000))
    expect(abiUnboxI64(abiMapGet(m, abiStrFromI64(0)))).toBe(1000)
    expect(abiMapLen(m)).toBe(7)
}

test fn removal_of_an_absent_key_is_a_null_and_does_not_change_len() {
    var m = mapNew(0)
    abiMapSet(m, abiStrFromI64(1), abiBoxI64(1))
    expect(isNull(mapRemove(m, abiStrFromI64(999)))).toBe(true)
    expect(abiMapLen(m)).toBe(1)
    expect(isNull(mapRemove(m, mkAlpha()))).toBe(true)
    expect(abiMapLen(m)).toBe(1)
}

// ---------------------------------------------------------------------------
// ABI entry points (native: abi_roundtrip_boxed_ints)
// ---------------------------------------------------------------------------

test fn abi_roundtrip_boxed_ints() {
    var m = abiMapNew(0)
    var k1 = mkAlpha()
    var k2 = mkBeta()
    abiMapSet(m, k1, abiBoxI64(7))
    abiMapSet(m, k2, abiBoxI64(-3))
    expect(abiMapHas(m, k1)).toBe(true)
    expect(abiMapHas(m, mkStr(103, 97, 109, 109, 97))).toBe(false)
    expect(abiMapLen(m)).toBe(2)
    // `get_boxed` returns the default for an absent key rather than null.
    var default = abiBoxI64(0)
    expect(abiUnboxI64(abiMapGetBoxed(m, k1, default))).toBe(7)
    expect(abiUnboxI64(abiMapGetBoxed(m, mkStr(103, 97, 109, 109, 97), default))).toBe(0)
    // `get` returns null for an absent key.
    expect(isNull(abiMapGet(m, mkStr(103, 97, 109, 109, 97)))).toBe(true)
    // Snapshots.
    expect(abiListLen(abiMapKeys(m))).toBe(2)
    expect(abiListLen(abiMapValues(m))).toBe(2)
}

test fn snapshots_exclude_tombstones_and_match_length() {
    var m = mapNew(0)
    var i = 0
    while (i < 20) {
        abiMapSet(m, abiStrFromI64(i), abiBoxI64(i))
        i = i + 1
    }
    var r = 0
    while (r < 20) {
        if (r % 3 == 0) { mapRemove(m, abiStrFromI64(r)) }
        r = r + 3
    }
    var n = abiMapLen(m)
    expect(abiListLen(abiMapKeys(m))).toBe(n)
    expect(abiListLen(abiMapValues(m))).toBe(n)
    // Every surviving key is present exactly once in the snapshot.
    var ks = abiMapKeys(m)
    var i2 = 0
    while (i2 < n) {
        var k = abiListGet(ks, i2)
        expect(abiMapHas(m, k)).toBe(true)
        i2 = i2 + 1
    }
}

test fn values_snapshot_holds_the_values_not_the_keys() {
    var m = mapNew(0)
    abiMapSet(m, abiStrFromI64(1), abiBoxI64(111))
    abiMapSet(m, abiStrFromI64(2), abiBoxI64(222))
    var vs = abiMapValues(m)
    expect(abiListLen(vs)).toBe(2)
    // The values are the boxed ints, not the string keys.
    var total = 0
    var i = 0
    while (i < abiListLen(vs)) {
        total = total + abiUnboxI64(abiListGet(vs, i))
        i = i + 1
    }
    expect(total).toBe(333)
}

test fn an_empty_map_answers_every_query() {
    var m = abiMapNew(0)
    expect(abiMapLen(m)).toBe(0)
    expect(abiMapHas(m, mkAlpha())).toBe(false)
    expect(isNull(abiMapGet(m, mkAlpha()))).toBe(true)
    expect(abiListLen(abiMapKeys(m))).toBe(0)
    expect(abiListLen(abiMapValues(m))).toBe(0)
    expect(abiUnboxI64(abiMapGetBoxed(m, mkAlpha(), abiBoxI64(42)))).toBe(42)
}

test fn merge_inserts_the_other_maps_entries() {
    var a = abiMapNew(0)
    abiMapSet(a, mkAlpha(), abiBoxI64(1))
    var b = abiMapNew(0)
    abiMapSet(b, mkBeta(), abiBoxI64(2))
    abiMapMerge(a, b)
    expect(abiMapLen(a)).toBe(2)
    expect(abiUnboxI64(abiMapGet(a, mkAlpha()))).toBe(1)
    expect(abiUnboxI64(abiMapGet(a, mkBeta()))).toBe(2)
    // The right-hand map is untouched.
    expect(abiMapLen(b)).toBe(1)
    expect(abiMapHas(b, mkAlpha())).toBe(false)
}

test fn merge_lets_the_right_hand_map_win_collisions() {
    var a = abiMapNew(0)
    abiMapSet(a, mkAlpha(), abiBoxI64(1))
    var b = abiMapNew(0)
    abiMapSet(b, mkAlpha(), abiBoxI64(9))
    abiMapMerge(a, b)
    expect(abiMapLen(a)).toBe(1)
    expect(abiUnboxI64(abiMapGet(a, mkAlpha()))).toBe(9)
}

test fn merge_with_an_empty_side_changes_only_the_non_empty_one() {
    var a = abiMapNew(0)
    abiMapSet(a, mkAlpha(), abiBoxI64(1))
    abiMapMerge(a, abiMapNew(0))
    expect(abiMapLen(a)).toBe(1)
    expect(abiUnboxI64(abiMapGet(a, mkAlpha()))).toBe(1)

    var into = abiMapNew(0)
    var b = abiMapNew(0)
    abiMapSet(b, mkBeta(), abiBoxI64(2))
    abiMapMerge(into, b)
    expect(abiMapLen(into)).toBe(1)
    expect(abiUnboxI64(abiMapGet(into, mkBeta()))).toBe(2)
}

test fn merge_into_itself_is_a_no_op() {
    var a = abiMapNew(0)
    abiMapSet(a, mkAlpha(), abiBoxI64(1))
    abiMapSet(a, mkBeta(), abiBoxI64(2))
    abiMapMerge(a, a)
    expect(abiMapLen(a)).toBe(2)
    expect(abiUnboxI64(abiMapGet(a, mkAlpha()))).toBe(1)
    expect(abiUnboxI64(abiMapGet(a, mkBeta()))).toBe(2)
}

test fn merge_skips_tombstones() {
    var b = abiMapNew(0)
    abiMapSet(b, mkAlpha(), abiBoxI64(1))
    abiMapSet(b, mkBeta(), abiBoxI64(2))
    abiMapRemove(b, mkAlpha())
    var a = abiMapNew(0)
    abiMapMerge(a, b)
    expect(abiMapLen(a)).toBe(1)
    expect(abiMapHas(a, mkAlpha())).toBe(false)
    expect(abiUnboxI64(abiMapGet(a, mkBeta()))).toBe(2)
}

test fn merge_grows_the_destination_as_needed() {
    // Enough entries to force at least one rehash in a fresh destination table.
    var b = abiMapNew(0)
    var i = 0
    while (i < 40) {
        abiMapSet(b, abiBoxI64(i), abiBoxI64(i * 2))
        i = i + 1
    }
    var a = abiMapNew(0)
    abiMapMerge(a, b)
    expect(abiMapLen(a)).toBe(40)
    expect(abiUnboxI64(abiMapGet(a, abiBoxI64(0)))).toBe(0)
    expect(abiUnboxI64(abiMapGet(a, abiBoxI64(39)))).toBe(78)
}

test fn entries_of_empty_map_is_empty() {
    let l = abiMapEntries(abiMapNew(0))
    expect(abiListLen(l)).toBe(0)
}

test fn entries_pairs_keys_with_values() {
    var m = abiMapNew(0)
    abiMapSet(m, mkAlpha(), abiBoxI64(1))
    abiMapSet(m, mkBeta(), abiBoxI64(2))
    let es = abiMapEntries(m)
    expect(abiListLen(es)).toBe(2)
    var i = 0
    var sum = 0
    while (i < abiListLen(es)) {
        let pair = abiListGet(es, i)
        let k = abiTupleField(pair, 0)
        let v = abiTupleField(pair, 1)
        sum = sum + abiUnboxI64(v)
        // Each pair's key still resolves to the same value in the map.
        expect(abiUnboxI64(abiMapGet(m, k))).toBe(abiUnboxI64(v))
        i = i + 1
    }
    expect(sum).toBe(3)
}

test fn entries_are_shallow_pairs() {
    let k = mkAlpha()
    var m = abiMapNew(0)
    abiMapSet(m, k, abiBoxI64(7))
    let es = abiMapEntries(m)
    let pair = abiListGet(es, 0)
    expect((abiTupleField(pair, 0) as int) == (k as int)).toBe(true)
    expect(abiUnboxI64(abiTupleField(pair, 1))).toBe(7)
}

test fn entries_surface_a_none_key_as_null() {
    var m = abiMapNew(0)
    abiMapSet(m, 0 as *int, abiBoxI64(9))
    let es = abiMapEntries(m)
    expect(abiListLen(es)).toBe(1)
    let pair = abiListGet(es, 0)
    expect(abiTupleField(pair, 0) as int).toBe(0)
    expect(abiUnboxI64(abiTupleField(pair, 1))).toBe(9)
}

test fn entries_cover_every_live_slot_after_removal() {
    var m = abiMapNew(0)
    abiMapSet(m, mkAlpha(), abiBoxI64(1))
    abiMapSet(m, mkBeta(), abiBoxI64(2))
    abiMapRemove(m, mkAlpha())
    let es = abiMapEntries(m)
    expect(abiListLen(es)).toBe(1)
    let pair = abiListGet(es, 0)
    expect(abiUnboxI64(abiTupleField(pair, 1))).toBe(2)
}

test fn clear_empties_the_map_and_keeps_it_usable() {
    var m = abiMapNew(0)
    abiMapSet(m, mkAlpha(), abiBoxI64(1))
    abiMapSet(m, mkBeta(), abiBoxI64(2))
    expect(abiMapLen(m)).toBe(2)
    abiMapClear(m)
    expect(abiMapLen(m)).toBe(0)
    expect(abiMapHas(m, mkAlpha())).toBe(false)
    expect(abiMapGet(m, mkAlpha()) as int).toBe(0)
    expect(abiListLen(abiMapEntries(m))).toBe(0)
    // The same table is reused, so refilling needs no rehash.
    abiMapSet(m, mkAlpha(), abiBoxI64(7))
    expect(abiMapLen(m)).toBe(1)
    expect(abiUnboxI64(abiMapGet(m, mkAlpha()))).toBe(7)
    // Clearing an already-empty map is a no-op.
    abiMapClear(m)
    expect(abiMapLen(m)).toBe(0)
}
// ---------------------------------------------------------------------------
// Differential: the string fast path against the general lookup
//
// `abiMapGet` specialises short string keys and delegates everything else to
// `abiMapGetSlow`. These tests pin the specialisation against the general body
// over the same tables: same hit, same absent result, and - because map values
// are pointers - the exact same value object. The general body stays the
// authority for every key class.
// ---------------------------------------------------------------------------

/// Both lookups must agree on presence and on the exact value object.
fn expectSameLookup(m: *int, key: *int) {
    expect(abiMapGet(m, key) as int).toBe(abiMapGetSlow(m, key) as int)
}

test fn fast_lookup_matches_the_general_lookup_for_short_strings() {
    var m = abiMapNew(0)
    let kAlpha = mkAlpha()
    let kBeta = mkBeta()
    abiMapSet(m, kAlpha, abiBoxI64(11))
    abiMapSet(m, kBeta, abiBoxI64(22))
    // Pointer-identical key: the identity shortcut.
    expectSameLookup(m, kAlpha)
    // Fresh but structurally equal key: exercises hash + byte compare.
    let fresh = mkAlpha()
    expect((fresh as int) != (kAlpha as int)).toBe(true)
    expectSameLookup(m, fresh)
    // Absent short key, and the empty string.
    expectSameLookup(m, mkStr(122, 122, 122, 122, 122))
    expectSameLookup(m, newStr(0))
}

test fn fast_lookup_matches_the_general_lookup_across_the_eight_byte_boundary() {
    var m = abiMapNew(0)
    let k0 = newStr(0)
    let k7 = mkStrBytes([97, 98, 99, 100, 101, 102, 103])
    let k8 = mkStrBytes([97, 98, 99, 100, 101, 102, 103, 104])
    let k9 = mkStrBytes([97, 98, 99, 100, 101, 102, 103, 104, 105])
    abiMapSet(m, k0, abiBoxI64(0))
    abiMapSet(m, k7, abiBoxI64(7))
    abiMapSet(m, k8, abiBoxI64(8))
    abiMapSet(m, k9, abiBoxI64(9))
    expectSameLookup(m, k0)
    expectSameLookup(m, k7)
    expectSameLookup(m, k8)
    expectSameLookup(m, k9)
    // Fresh copies on both sides of the fast-path cut-off.
    expectSameLookup(m, mkStrBytes([97, 98, 99, 100, 101, 102, 103]))
    expectSameLookup(m, mkStrBytes([97, 98, 99, 100, 101, 102, 103, 104]))
    expectSameLookup(m, mkStrBytes([97, 98, 99, 100, 101, 102, 103, 104, 105]))
    // Shares eight bytes with `k9` but not the ninth.
    expectSameLookup(m, mkStrBytes([97, 98, 99, 100, 101, 102, 103, 104, 106]))
    // Same prefix, shorter length: a length mismatch must not match bytes.
    expectSameLookup(m, mkStrBytes([97, 98, 99, 100, 101, 102, 103]))
}

test fn fast_lookup_matches_the_general_lookup_across_tombstones() {
    var m = abiMapNew(0)
    var keys = List<*int>()
    var i = 0
    while (i < 24) {
        let k = mkStrBytes([119, 48 + (i / 10), 48 + (i % 10), 33, 33, 33])
        keys.push(k)
        abiMapSet(m, k, abiBoxI64(i))
        i = i + 1
    }
    // Punch alternating holes so probing has to step over tombstones.
    i = 0
    while (i < 24) {
        if (i % 2 == 0) {
            abiMapRemove(m, keys[i])
        }
        i = i + 1
    }
    i = 0
    while (i < 24) {
        expectSameLookup(m, keys[i])
        // Fresh equal copies see exactly the same table state.
        expectSameLookup(m, mkStrBytes([119, 48 + (i / 10), 48 + (i % 10), 33, 33, 33]))
        i = i + 1
    }
    // Reinsert into the tombstoned slots and compare again.
    i = 0
    while (i < 24) {
        if (i % 2 == 0) {
            abiMapSet(m, keys[i], abiBoxI64(100 + i))
        }
        i = i + 1
    }
    i = 0
    while (i < 24) {
        expectSameLookup(m, keys[i])
        i = i + 1
    }
}

test fn fast_lookup_matches_the_general_lookup_for_grown_tables() {
    var m = abiMapNew(0)
    var i = 0
    while (i < 200) {
        let k = mkStrBytes([107, 48 + (i / 100), 48 + ((i / 10) % 10), 48 + (i % 10)])
        abiMapSet(m, k, abiBoxI64(i))
        i = i + 1
    }
    i = 0
    while (i < 200) {
        // Rebuild the same bytes at each length so every lookup hashes afresh.
        let k = mkStrBytes([107, 48 + (i / 100), 48 + ((i / 10) % 10), 48 + (i % 10)])
        expectSameLookup(m, k)
        i = i + 1
    }
    expectSameLookup(m, mkStrBytes([107, 57, 57, 57]))
}

test fn fast_lookup_delegates_non_string_keys() {
    var m = abiMapNew(0)
    abiMapSet(m, abiBoxI64(7), abiBoxI64(70))
    abiMapSet(m, abiBoxI64(8), abiBoxI64(80))
    expectSameLookup(m, abiBoxI64(7))
    expectSameLookup(m, abiBoxI64(8))
    expectSameLookup(m, abiBoxI64(9))
    // `none` is a real key, distinct from a boxed zero.
    abiMapSet(m, 0 as *int, abiBoxI64(99))
    expectSameLookup(m, 0 as *int)
    expectSameLookup(m, abiBoxI64(0))
}

test fn fast_lookup_delegates_when_probing_over_a_foreign_key_class() {
    var m = abiMapNew(0)
    abiMapSet(m, mkAlpha(), abiBoxI64(1))
    abiMapSet(m, abiBoxI64(42), abiBoxI64(2))
    // Composite keys in the same table must still resolve by deep equality.
    let lk = listOf([1, 2, 3])
    abiMapSet(m, lk, abiBoxI64(3))
    expectSameLookup(m, mkAlpha())
    expectSameLookup(m, abiBoxI64(42))
    expectSameLookup(m, mkBeta())
    expectSameLookup(m, lk)
    expectSameLookup(m, listOf([1, 2, 3]))
    expectSameLookup(m, listOf([3, 2, 1]))
}

test fn fast_lookup_matches_the_general_lookup_on_an_empty_map() {
    var m = abiMapNew(0)
    expectSameLookup(m, mkAlpha())
    expectSameLookup(m, newStr(0))
    expectSameLookup(m, 0 as *int)
    expectSameLookup(m, abiBoxI64(1))
}

// ---------------------------------------------------------------------------
// Differential: the string fast path on insert against the general insert
//
// Both tables start from `abiMapNew(0)` and receive the same operations with
// the same key and value objects, so a correct fast path must leave every
// header word and every entry word pointer-identical to the general body's.
// Growth, tombstone reuse and probe order are all observable this way.
// ---------------------------------------------------------------------------

/// Every observable word of the two tables must agree.
fn expectSameTable(a: *int, b: *int) {
    unsafe {
        expect(a[LEN_WORD]).toBe(b[LEN_WORD])
        expect(a[CAP_WORD]).toBe(b[CAP_WORD])
        expect(a[OCCUPIED_WORD]).toBe(b[OCCUPIED_WORD])
        let ea = a[ENTRIES_WORD] as *int
        let eb = b[ENTRIES_WORD] as *int
        let cap = a[CAP_WORD]
        var i = 0
        while (i < cap * 2) {
            expect(ea[i]).toBe(eb[i])
            i = i + 1
        }
    }
}

test fn fast_set_matches_the_general_set_for_short_strings() {
    let fast = abiMapNew(0)
    let slow = abiMapNew(0)
    let kAlpha = mkAlpha()
    let kBeta = mkBeta()
    let v1 = abiBoxI64(11)
    let v2 = abiBoxI64(22)
    abiMapSet(fast, kAlpha, v1)
    abiMapSetSlow(slow, kAlpha, v1)
    abiMapSet(fast, kBeta, v2)
    abiMapSetSlow(slow, kBeta, v2)
    expectSameTable(fast, slow)
    // Overwrite through a fresh, equal key: the slot is reused, not appended.
    let fresh = mkAlpha()
    let v3 = abiBoxI64(33)
    abiMapSet(fast, fresh, v3)
    abiMapSetSlow(slow, fresh, v3)
    expectSameTable(fast, slow)
    expect(abiMapLen(fast)).toBe(2)
    expect(abiMapGet(fast, kAlpha) as int).toBe(v3 as int)
}

test fn fast_set_matches_the_general_set_across_short_lengths() {
    let fast = abiMapNew(0)
    let slow = abiMapNew(0)
    var keys = List<*int>()
    var vals = List<*int>()
    var i = 0
    while (i < 12) {
        let k = mkStrBytes([97 + i, 98 + i, 99, 100, 101, 102, 103, 104])
        // Trim to a different length for each key: 0..8 bytes.
        let trimmed = newStr(i % 9)
        var q = 0
        while (q < i % 9) {
            byteInto(trimmed, q, 97 + i + q)
            q = q + 1
        }
        let _ = k
        let v = abiBoxI64(i)
        keys.push(trimmed)
        vals.push(v)
        abiMapSet(fast, trimmed, v)
        abiMapSetSlow(slow, trimmed, v)
        i = i + 1
    }
    expectSameTable(fast, slow)
    i = 0
    while (i < len(keys)) {
        expect(abiMapGet(fast, keys[i]) as int).toBe(abiMapGet(slow, keys[i]) as int)
        i = i + 1
    }
}

test fn fast_set_matches_the_general_set_around_tombstones() {
    let fast = abiMapNew(0)
    let slow = abiMapNew(0)
    var keys = List<*int>()
    var i = 0
    while (i < 20) {
        let k = mkStrBytes([119, 48 + (i / 10), 48 + (i % 10)])
        keys.push(k)
        let v = abiBoxI64(i)
        abiMapSet(fast, k, v)
        abiMapSetSlow(slow, k, v)
        i = i + 1
    }
    expectSameTable(fast, slow)
    // Remove the odd slots, then insert fresh keys that must reuse the
    // earliest tombstone exactly where the general body does.
    i = 0
    while (i < 20) {
        if (i % 2 == 1) {
            abiMapRemove(fast, keys[i])
            abiMapRemove(slow, keys[i])
        }
        i = i + 1
    }
    expectSameTable(fast, slow)
    i = 0
    while (i < 10) {
        let k = mkStrBytes([122, 48 + i, 33])
        let v = abiBoxI64(100 + i)
        abiMapSet(fast, k, v)
        abiMapSetSlow(slow, k, v)
        i = i + 1
    }
    expectSameTable(fast, slow)
}

test fn fast_set_matches_the_general_set_across_growth() {
    let fast = abiMapNew(0)
    let slow = abiMapNew(0)
    var keys = List<*int>()
    var i = 0
    while (i < 200) {
        let k = mkStrBytes([107, 48 + (i / 100), 48 + ((i / 10) % 10), 48 + (i % 10)])
        keys.push(k)
        let v = abiBoxI64(i)
        abiMapSet(fast, k, v)
        abiMapSetSlow(slow, k, v)
        i = i + 1
    }
    expectSameTable(fast, slow)
    i = 0
    while (i < 200) {
        expect(abiMapGet(fast, keys[i]) as int).toBe(abiMapGet(slow, keys[i]) as int)
        i = i + 1
    }
}

test fn fast_set_delegates_foreign_key_classes() {
    let fast = abiMapNew(0)
    let slow = abiMapNew(0)
    let kLong = mkStrBytes([97, 98, 99, 100, 101, 102, 103, 104, 105])
    let boxes = List<*int>()
    var i = 0
    while (i < 6) {
        boxes.push(abiBoxI64(i))
        i = i + 1
    }
    let lk = listOf([1, 2, 3])
    abiMapSet(fast, kLong, boxes[0])
    abiMapSetSlow(slow, kLong, boxes[0])
    abiMapSet(fast, boxes[1], boxes[2])
    abiMapSetSlow(slow, boxes[1], boxes[2])
    abiMapSet(fast, 0 as *int, boxes[3])
    abiMapSetSlow(slow, 0 as *int, boxes[3])
    abiMapSet(fast, lk, boxes[4])
    abiMapSetSlow(slow, lk, boxes[4])
    let shortKey = mkAlpha()
    abiMapSet(fast, shortKey, boxes[5])
    abiMapSetSlow(slow, shortKey, boxes[5])
    expectSameTable(fast, slow)
    expect(abiMapLen(fast)).toBe(5)
}

test fn fast_set_matches_the_general_set_on_an_empty_map() {
    let fast = abiMapNew(0)
    let slow = abiMapNew(0)
    expectSameTable(fast, slow)
    let v = abiBoxI64(1)
    let ek = newStr(0)
    abiMapSet(fast, ek, v)
    abiMapSetSlow(slow, ek, v)
    expectSameTable(fast, slow)
    expect(abiMapLen(fast)).toBe(1)
}

// ---------------------------------------------------- string hash cache
/// The header cache is only a memo of the exact FNV value, but it must never be
/// written into a static `.rdata` descriptor and must never survive a payload
/// mutation. This pins both directions plus the fast-path insertion.
test fn string_hash_cache_matches_the_reference_and_is_writable_only() {
    let k = mkAlpha()
    unsafe {
        expect(k[0]).toBe(0)
        expect((k[2] & 2) != 0).toBe(false)
    }
    // Reference value from `fnv1a_matches_the_reference_implementation`.
    let h = keyHash(k)
    expect(h).toBe(-8447022563750764501)
    unsafe {
        expect(k[0]).toBe(h)
        expect((k[2] & 2) != 0).toBe(true)
    }
    // A second lookup must return the memo, and a map insert must populate the
    // same memo through the inlined fast path.
    expect(keyHash(k)).toBe(h)
    let m = abiMapNew(0)
    let k2 = mkBeta()
    abiMapSet(m, k2, abiBoxI64(42))
    unsafe {
        expect((k2[2] & 2) != 0).toBe(true)
    }
    expect(keyHash(k2)).toBe(795837917815194981)

    // Simulate a read-only static descriptor (no heap flag): hashing must
    // compute the same value and leave the word untouched, because a static
    // descriptor lives in `.rdata`.
    let ro = mkAlpha()
    unsafe {
        ro[2] = ro[2] & (0 - 2)
        ro[0] = 0
    }
    expect(keyHash(ro)).toBe(h)
    unsafe {
        expect(ro[0]).toBe(0)
        expect((ro[2] & 2) != 0).toBe(false)
    }
}

// ---------------------------------------------------------------------------
// Collector span release
// ---------------------------------------------------------------------------

/// Fill a map with enough keys that its table outgrows the managed bump arena:
/// `needsGrow` doubles the capacity to 16384, and a cap-16384 table is
/// `(4 + 2*16384) * 8` = 262,176 bytes, just over `MANAGED_MAX_BUMP` (262,144),
/// so `abiManagedAlloc` hands it straight to the heap. The map is dropped when
/// this helper returns.
fn buildAFreedOversizedMap() {
    let m = abiMapNew(0)
    var i = 0
    while (i < 9000) {
        abiMapSet(m, abiBoxI64(i), abiBoxI64(i))
        i = i + 1
    }
    expect(abiMapLen(m)).toBe(9000)
}

/// Regression (2026-11-23): `mapTableNew` returns a pointer `MAP_BLOOM_OFF`
/// bytes into the table block (the bloom filter precedes the entries in the
/// same allocation). Sweeping used to release that interior pointer, which is
/// harmless for an arena-backed table but is a `HeapFree(base + 32)` for an
/// oversized raw table and corrupts the process heap on the next heap call.
/// The explicit collection below sweeps the dead oversized map; before the
/// base adjustment this test died with STATUS_HEAP_CORRUPTION.
test fn sweeping_an_oversized_map_releases_the_block_base() {
    buildAFreedOversizedMap()
    gcCollect(true)
    // The heap is still usable and a map still works after the sweep.
    let m = abiMapNew(0)
    abiMapSet(m, abiBoxI64(7), abiBoxI64(11))
    expect(abiMapLen(m)).toBe(1)
    expect(abiUnboxI64(abiMapGet(m, abiBoxI64(7)))).toBe(11)
    expect(abiMapHas(m, abiBoxI64(8))).toBe(false)
}
