module runtime.boxscalar_test

import { isBoxClass, boxClassName, BOX_OBJECT_SIZE, unboxMessage } from runtime.boxscalar

test fn box_class_ids() {
    expect(isBoxClass(3)).toBe(true)
    expect(isBoxClass(4)).toBe(true)
    expect(isBoxClass(5)).toBe(true)
    expect(isBoxClass(6)).toBe(true)
    expect(isBoxClass(2)).toBe(false)
    expect(isBoxClass(7)).toBe(false)
    expect(isBoxClass(9)).toBe(false)
    expect(isBoxClass(10)).toBe(false)
    expect(isBoxClass(0)).toBe(false)
    expect(isBoxClass(1)).toBe(false)
}

test fn box_class_names() {
    expect(boxClassName(3)).toBe("int")
    expect(boxClassName(4)).toBe("float")
    expect(boxClassName(5)).toBe("bool")
    expect(boxClassName(6)).toBe("char")
    expect(boxClassName(2)).toBe(none)
    expect(boxClassName(7)).toBe(none)
    expect(boxClassName(-1)).toBe(none)
}

test fn box_object_size() {
    expect(BOX_OBJECT_SIZE).toBe(32)
}

test fn unbox_messages() {
    expect(unboxMessage("int")).toBe("pickle: cannot unbox null as int")
    expect(unboxMessage("float")).toBe("pickle: cannot unbox null as float")
    expect(unboxMessage("bool")).toBe("pickle: cannot unbox null as bool")
    expect(unboxMessage("char")).toBe("pickle: cannot unbox null as char")
}