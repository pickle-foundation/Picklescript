module runtime.console_test

import { terminalColorEnabled, printTextNone, printTextStr, printTextInt, printTextFloat, printTextBool, printTextCharCp, printTextByte, printTextOfListLen, printTextOfMapLen, printTextOfEnumTag, printTextOfTupleLen, printTextClassById, strTextNone, strTextStr, strTextList, strTextOfMapLen, strTextOfEnumTag, strTextTuple, strTextClassById } from runtime.console
import { int64ToString } from runtime.strings

fn sText(v: string) -> string {
    strTextStr(v)
}

fn neverName(id: int) -> string? {
    none
}

fn enumName(id: int) -> string? {
    if (id == 7) {
        return "enum"
    }
    none
}

test fn color_decision() {
    expect(terminalColorEnabled(false, false, true)).toBe(true)
    expect(terminalColorEnabled(true, false, true)).toBe(false)
    expect(terminalColorEnabled(false, true, true)).toBe(false)
    expect(terminalColorEnabled(false, false, false)).toBe(false)
}

test fn scalar_text_parity_with_intrinsic() {
    expect(printTextInt(42)).toBe(str(42))
    expect(printTextInt(0)).toBe("0")
    expect(int64ToString(-7)).toBe("-7")
    expect(printTextBool(true)).toBe("true")
    expect(printTextBool(false)).toBe("false")
    expect(printTextFloat(1.5)).toBe("1.5")
}

test fn raw_object_print_forms() {
    expect(printTextNone()).toBe("none")
    expect(printTextStr("hi")).toBe("hi")
    expect(printTextOfListLen(3)).toBe("List(len=3)")
    expect(printTextOfListLen(0)).toBe("List(len=0)")
    expect(printTextOfMapLen(2)).toBe("Map(len=2)")
    expect(printTextOfEnumTag(1)).toBe("Enum(tag=1)")
    expect(printTextOfTupleLen(2)).toBe("Tuple(len=2)")
    expect(printTextByte(0x41 as byte)).toBe("A")
    expect(printTextCharCp(0x1F600)).toBe("😀")
}

test fn str_form_list_and_tuple() {
    var emptyStrs: List<string> = ["x"]
    emptyStrs.pop()
    expect(strTextNone()).toBe("none")
    expect(strTextStr("a")).toBe("a")
    expect(strTextList(emptyStrs, sText)).toBe("[]")
    expect(strTextList(["a", "b"], sText)).toBe("[a, b]")
    expect(strTextTuple([strTextStr("a"), printTextInt(1)])).toBe("(a, 1)")
    expect(strTextTuple(emptyStrs)).toBe("()")
    expect(strTextOfMapLen(5)).toBe("Map(5)")
    expect(strTextOfEnumTag(0)).toBe("Enum(0)")
}

test fn class_name_seam_and_fallback() {
    expect(printTextClassById(7, enumName)).toBe("enum")
    expect(printTextClassById(0, enumName)).toBe("<object>")
    expect(printTextClassById(100000, neverName)).toBe("<object>")
    expect(strTextClassById(7, enumName)).toBe("enum")
    expect(strTextClassById(-1, neverName)).toBe("<object>")
}