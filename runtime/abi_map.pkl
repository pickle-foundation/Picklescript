module runtime.abi_map

/// Sovereign map ABI bodies, ported from `runtime/src/map.rs`.
///
/// Ported as ONE tranche on purpose. The table is the easy half; the *keys* are the
/// hard half, and they hash and compare STRUCTURALLY. `Map<List<int>, V>` and
/// `Map<Map<...>, V>` are legal Pickle, so a port that only handled string and boxed
/// keys would look correct on the obvious cases and silently return "absent" for
/// composite ones. Everything here therefore goes through `deepHash`/`deepEq`, which
/// recurse through lists, maps, enums, tuples and user-class instances.
///
/// # Word arithmetic on the full 64-bit word
///
/// `int` is signed 64-bit and wraps on overflow (verified: `+`, `*`, `^` all behave as
/// mod-2^64, which is what `u64::wrapping_*` does). So FNV-1a is expressible directly:
/// `h = (h ^ x) * FNV_PRIME` with wrapping multiply, exactly `mix` in Rust.
///
/// The FNV constants have the high bit set, and Pickle rejects out-of-range integer
/// literals (`codegen: integer literal out of range for i64`), so they are written in
/// two's-complement negation form -- the same trick `x64.pkl` uses for `i64::MIN`:
/// `u64 0xCBF29CE484222325` is `(0 - 0x340D631B7BDDDCDB)`. `CYCLIC_HASH` happens to be
/// below 2^63, so it is a plain literal. Bit patterns are what matter, so every one of
/// these reproduces the Rust `u64` value exactly; `abi_map_test.pkl` pins the hashes
/// against literals taken from a reference implementation rather than against the Rust
/// map, so the arithmetic is checked independently of the table.
///
/// # The sentinel substitution
///
/// Rust marks a tombstone with `object::nil_sentinel()` and stores the canonical `none`
/// key at `object::none_key()`. Both are Rust `static`s, so their *addresses* are
/// link-time constants a Pickle body cannot produce. This port substitutes small
/// integers in the key slot:
///
///   - `0` empty slot (null - exactly what Rust uses)
///   - `1` tombstone
///   - `2` the `none` key
///
/// This is observably faithful. `map_keys` already surfaces a stored `none` key back to
/// callers as null, and the markers never escape the table otherwise. It is safe
/// because page zero is never mapped, so no live heap object can have address 1 or 2:
/// `isTombstone`/`isNoneKey` test a forged address 1 or 2 as a marker, but no allocator
/// ever hands one out.
///
/// KNOWN WEAKNESS - the one observable difference from Rust: a program that explicitly
/// forges `1 as *int` or `2 as *int` as a map key would write what the table reads as a
/// marker, silently losing that entry. Rust's sentinels are unreachable addresses, so
/// this cannot happen there. Reaching it needs a deliberate forge of an unmap address;
/// it is documented rather than defended against because the alternative (exporting the
/// real sentinel addresses) changes the Rust ABI surface.
///
/// KNOWN LIMITATION - like every ported container, map objects and every rehash table
/// come from `alloc`, which the GC does not track: correct, never reclaimed. `rehash`
/// therefore leaks the previous table exactly as `abi_list`'s growth leaks its old span.
///
/// # Other gaps, inherited from `runtime/src/map.rs`
///
/// - `map_set`'s `gc_check_*` argument probes (report_call_site + panic) are omitted:
///   the compiled paths always pass correctly classed arguments, and Pickle cannot yet
///   declare an extern to call `pickle_panic_cstr` (see PICKLE_AUDIT.md 18.0).
/// - `deep_hash`'s `FREE_SENTINEL` branch returns *without* popping `path`, which is
///   faithful to the original (it makes later sibling hashes in the same `keyHash` see a
///   spurious ancestor) rather than quietly "fixed".
/// - `Map<f64, V>` keys compare by `box_bits`, not numeric equality, so `0.0` and `-0.0`
///   are distinct keys. That is the Rust behaviour, kept as-is.

import { PICKLE_CLASS_MAP, PICKLE_CLASS_STRING, PICKLE_CLASS_LIST, PICKLE_CLASS_ENUM } from runtime.object
import { PICKLE_CLASS_TUPLE, PICKLE_CLASS_BOX_INT, PICKLE_CLASS_BOX_FLOAT } from runtime.object
import { PICKLE_CLASS_BOX_BOOL, PICKLE_CLASS_BOX_CHAR } from runtime.object
import { HEADER, MAP_LEN_OFF, MAP_CAP_OFF, MAP_OCCUPIED_OFF, MAP_ENTRIES_OFF, MAP_OBJECT_SIZE, MAP_BLOOM_OFF } from runtime.layout
import { LIST_LEN_OFF, LIST_DATA_OFF, ENUM_TAG_OFF, ENUM_FIELDS_OFF, TUPLE_LEN_OFF } from runtime.layout
import { boxBits } from runtime.abi_box
import { abiListNew, abiListPush } from runtime.abi_list
import { abiTupleNew, abiTupleSetField } from runtime.abi_tuple
import { abiStrCmp, byteAt, SIZE_WORD, FLAG_HEAP, FLAG_HASH } from runtime.abi_string
// The map object and its entry array both come from `alloc(int, n)`, so the
// raw-allocation slots must travel with them. See `abi_raw.pkl`.
// `abiRegisterObject` records the map *object*; the entries array is raw
// backing, never registered.
import { abiRawAlloc, abiManagedAlloc, abiRegisterObject, abiRawParallelMode } from runtime.abi_raw
import { lockAcquire, lockRelease } from runtime.abi_world

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

/// FNV-1a offset basis, `0xCBF29CE484222325`, in two's-complement negation form.
const FNV_OFFSET: int = 0 - 0x340D631B7BDDDCDB
/// FNV-1a prime, `0x100000001B3` -- fits in `i64`, plain literal.
const FNV_PRIME: int = 0x100000001B3
/// `0x9E3779B97F4A7C15`, the golden-ratio step, in negation form. Also the fixed hash
/// of a `none`/null key, matching `key_hash`'s early return.
const GOLDEN: int = 0 - 0x61C8864680B583EB
/// Hash reported by `deepHash` when it revisits an ancestor. Below 2^63, plain literal.
const CYCLIC_HASH: int = 0x2F029C2DF8C00001
/// `map_new`'s floor before rounding to a power of two (`INITIAL_CAP`).
const INITIAL_CAP: int = 16
/// `MAX_LOAD`, the occupancy fraction at which the table grows.
const MAX_LOAD: float = 0.7
/// `heap::FREE_SENTINEL` (`0xDEAD`), a freed-then-reused key's class. Its blocks are
/// free-list metadata, so `deepHash` hashes them by identity instead of walking slots.
const FREE_SENTINEL: int = 0xDEAD
/// Size above which a reported class size is treated as stale (`1 << 26`).
const MAX_PLAUSIBLE_SIZE: int = 0x4000000

// Key-slot markers; see the module doc's "sentinel substitution".
const KEY_EMPTY: int = 0
const KEY_TOMBSTONE: int = 1
const KEY_NONE: int = 2

// `deepEq` verdicts, standing in for Rust's `enum Cmp`.
const CMP_EQUAL: int = 0
const CMP_DIFF: int = 1
const CMP_CYCLIC: int = 2

// Word indices: every layout offset above is a BYTE offset, and `*int` indexes words.
const LEN_WORD: int = MAP_LEN_OFF / 8
const CAP_WORD: int = MAP_CAP_OFF / 8
const OCCUPIED_WORD: int = MAP_OCCUPIED_OFF / 8
const ENTRIES_WORD: int = MAP_ENTRIES_OFF / 8
const LIST_LEN_WORD: int = LIST_LEN_OFF / 8
const LIST_DATA_WORD: int = LIST_DATA_OFF / 8
const ENUM_TAG_WORD: int = ENUM_TAG_OFF / 8
const ENUM_FIELDS_WORD: int = ENUM_FIELDS_OFF / 8
const TUPLE_LEN_WORD: int = TUPLE_LEN_OFF / 8
/// Word index of payload slot `k`, since `slot(k)` is `HEADER + k*8`.
const SLOT0_WORD: int = HEADER / 8
/// `slot(1 + i)` -- the shape enum and tuple payload fields live at.
const SLOT1_WORD: int = SLOT0_WORD + 1

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

fn isTombstone(k: int) -> bool { return k == KEY_TOMBSTONE }
fn isNoneKey(k: int) -> bool { return k == KEY_EMPTY || k == KEY_NONE }
/// Is this key slot a live entry (neither empty nor a tombstone)?
fn isLiveKey(k: int) -> bool { return k != KEY_EMPTY && k != KEY_TOMBSTONE }

fn mix(h: int, x: int) -> int { return (h ^ x) * FNV_PRIME }

/// Smallest power of two >= `n`, for `n >= 1`. Mirrors `usize::next_power_of_two`
/// for the range `map_new` can produce (`cap.max(16)`).
fn nextPow2(n: int) -> int {
    var p = 1
    while (p < n) { p = p * 2 }
    return p
}

/// Is `addr` on the recursion path already? `depth` is the number of entries
/// stored; the path itself is a raw unmanaged block (see `keyScratch`).
fn pathHas(path: *int, depth: int, addr: int) -> bool {
    var i = 0
    while (i < depth) {
        unsafe {
            if (path[i] == addr) { return true }
        }
        i = i + 1
    }
    return false
}

/// Is the ancestor pair `(a, b)` on the equality path already? The path is stored
/// flat as interleaved `[a, b, a, b, ...]`; `depth` counts pairs.
fn pathHasPair(path: *int, depth: int, a: int, b: int) -> bool {
    var i = 0
    while (i < depth) {
        unsafe {
            if (path[2 * i] == a && path[2 * i + 1] == b) { return true }
        }
        i = i + 1
    }
    return false
}

// --------------------------------------------------------------- key scratch
/// The deep-key walkers need (a) the ancestor chain for cycle detection and
/// (b) `deepEqMap`'s matched-entry flags. Both used to be `List` allocations per
/// call, which made `keyHash`/`keyEq` - and through them every map lookup -
/// may-collect, so the hottest lookup in the benchmark paid a shadow frame
/// (prologue zeroing, push/pop) even on the string/box fast path that never
/// touches a composite key. A fixed per-thread raw block removes the allocation
/// entirely: the walkers become leaf/idempotent for the GC analysis and the
/// lookup keeps only a plain stack frame.
///
/// Layout: `KEY_PATH_WORDS` words of path, then `KEY_USED_LEVELS` per-depth
/// regions of `KEY_USED_BYTES` bytes for `used` flags. Depth beyond either
/// region is treated as cyclic, which falls back to identity for the whole key -
/// the same conservative semantics a cycle already gets.
const KEY_PATH_WORDS: int = 2048
const KEY_USED_BASE: int = KEY_PATH_WORDS * 8
const KEY_USED_BYTES: int = 512
const KEY_USED_LEVELS: int = 64
/// One shared flag word after the path/used regions. `deepHash` sets it when it
/// meets a cycle instead of returning a `(hash, cyclic)` tuple: a tuple return is
/// a heap tuple with boxed scalars in this backend, so the old signature made
/// every hash allocate and put `keyHash` - and with it every map lookup - in the
/// may-collect set, which is what kept a shadow frame on `pickle_map_get`.
/// Callers clear the word, hash, then read it.
const KEY_FLAG_OFF: int = KEY_USED_BASE + KEY_USED_BYTES * KEY_USED_LEVELS
const KEY_SCRATCH_BYTES: int = KEY_FLAG_OFF + 8

/// Win32 TLS index for this thread's scratch block; -1 until first use.
var keyScratchTls: int = -1

/// This thread's raw scratch block. Bypasses `abiRawAlloc` on purpose: that seam
/// owns the raw-allocation counters and tests read them, while this block is
/// runtime bookkeeping, not user allocation. The block is never freed (one per
/// thread, 48 KiB); a thread that exits leaks it, which matches the thread
/// node leak documented in `abi_shadow`.
fn keyScratch() -> int {
    if (keyScratchTls == -1) {
        keyScratchTls = win_tls_alloc()
    }
    var base = 0
    if (keyScratchTls != -1) {
        base = win_tls_get(keyScratchTls)
        if (base == 0) {
            var heap = win_get_process_heap()
            base = win_heap_alloc(heap, 0, KEY_SCRATCH_BYTES)
            if (base != 0) {
                win_tls_set(keyScratchTls, base)
            }
        }
    }
    return base
}

/// Is `classId` one of the four boxed-scalar classes? `deepHash`/`deepEq` treat them
/// alike: hash/compare the raw payload word.
fn isBoxClass(classId: int) -> bool {
    return classId == PICKLE_CLASS_BOX_INT || classId == PICKLE_CLASS_BOX_FLOAT ||
           classId == PICKLE_CLASS_BOX_BOOL || classId == PICKLE_CLASS_BOX_CHAR
}

/// FNV-1a over a string object's inline bytes. Mirrors `fnv1a(string_bytes_ptr(..),
/// string_bytes_len(..))`. Whole payload words are loaded once and consumed eight
/// bytes at a time, then the tail is read through `byteAt` so the final partial
/// word is never over-read. FNV is byte-sequential, but removing the per-byte
/// `byteAt` call is worth roughly half the hash cost - and `keyHash` runs on
/// every map probe.
fn fnv1aStr(s: *int) -> int {
    unsafe {
        var flags = s[SIZE_WORD]
        if ((flags & FLAG_HASH) != 0) {
            return s[0]
        }
        var h = FNV_OFFSET
        var n = s[LEN_WORD]
        var full = n >> 3
        var w = 0
        while (w < full) {
            var v = s[BYTES_WORD + w]
            var j = 0
            while (j < 8) {
                h = (h ^ ((v >> (j * 8)) & 255)) * FNV_PRIME
                j = j + 1
            }
            w = w + 1
        }
        var i = full * 8
        while (i < n) {
            h = (h ^ byteAt(s, i)) * FNV_PRIME
            i = i + 1
        }
        if ((flags & FLAG_HEAP) != 0) {
            s[0] = h
            s[SIZE_WORD] = flags | FLAG_HASH
        }
        return h
    }
}

/// Identity hash for a stale/reused or free-list block: `FNV_OFFSET`, xored with the
/// class id and the address, then multiplied. Lookups then miss instead of walking
/// arbitrary memory.
fn identityHash(obj: *int, classId: int) -> int {
    unsafe {
        return mix(mix(FNV_OFFSET, classId), obj as int)
    }
}

/// Word index of the first inline payload byte. `layout::STR_BYTES_OFF` is
/// `HEADER + 8` (length word at `HEADER`), i.e. word 4.
const STR_BYTES_WORD: int = 4
/// Word index of a boxed scalar's payload (`HEADER` bytes in, word 3).
const BOX_BITS_WORD: int = HEADER / 8

/// Is `classId` a boxed scalar? Inlined into the hot entry points below; kept
/// as a named helper for the cold paths.
fn boxClassFast(classId: int) -> bool {
    return classId == PICKLE_CLASS_BOX_INT || classId == PICKLE_CLASS_BOX_FLOAT ||
           classId == PICKLE_CLASS_BOX_BOOL || classId == PICKLE_CLASS_BOX_CHAR
}

/// FNV-1a over a string's inline bytes with the loads inlined - the body
/// `fnv1aStr` computes, but without the cross-module `byteAt` call per byte.
/// No calls at all, so `computeMayGC` leaves it frame-free and it is cheap
/// enough to run on every map probe. MUST stay bit-identical to `fnv1aStr`:
/// stored keys are hashed by whichever path ran when they were inserted.
fn strHashFast(s: *int) -> int {
    unsafe {
        var flags = s[SIZE_WORD]
        if ((flags & FLAG_HASH) != 0) {
            return s[0]
        }
        var h = FNV_OFFSET
        var n = s[LEN_WORD]
        if (n <= 8) {
            var v = s[STR_BYTES_WORD]
            var i = 0
            while (i < n) {
                h = (h ^ (v & 255)) * FNV_PRIME
                v = v >> 8
                i = i + 1
            }
        } else {
            var full = n >> 3
            var w = 0
            while (w < full) {
                var v = s[STR_BYTES_WORD + w]
                var j = 0
                while (j < 8) {
                    h = (h ^ ((v >> (j * 8)) & 255)) * FNV_PRIME
                    j = j + 1
                }
                w = w + 1
            }
            var rem = n & 7
            if (rem != 0) {
                var v = s[STR_BYTES_WORD + full]
                var j = 0
                while (j < rem) {
                    h = (h ^ ((v >> (j * 8)) & 255)) * FNV_PRIME
                    j = j + 1
                }
            }
        }
        if ((flags & FLAG_HEAP) != 0) {
            s[0] = h
            s[SIZE_WORD] = flags | FLAG_HASH
        }
        return h
    }
}

/// Byte equality of two strings with the loads inlined. Length first, then
/// whole words, then the final partial word masked so the comparison is exact
/// even if a producer left non-zero padding. No calls, hence frame-free. Must
/// agree with `abiStrCmp(a, b) == 0` for keys to be found.
fn strEqFast(a: *int, b: *int) -> bool {
    unsafe {
        var n = a[LEN_WORD]
        if (n != b[LEN_WORD]) {
            return false
        }
        var full = n >> 3
        var i = 0
        while (i < full) {
            if (a[STR_BYTES_WORD + i] != b[STR_BYTES_WORD + i]) {
                return false
            }
            i = i + 1
        }
        var rem = n & 7
        if (rem != 0) {
            var mask = (1 << (rem * 8)) - 1
            if ((a[STR_BYTES_WORD + full] & mask) != (b[STR_BYTES_WORD + full] & mask)) {
                return false
            }
        }
        return true
    }
}

/// `layout::enum_field_count` -- derived from the reported size, not stored.
fn enumFieldCount(obj: *int) -> int {
    unsafe {
        var size = obj[2]
        if (size <= HEADER + 8) { return 0 }
        return (size - (HEADER + 8)) / 8
    }
}

/// `layout::tuple_field_count` -- the explicit stored count.
fn tupleFieldCount(obj: *int) -> int {
    unsafe { return obj[TUPLE_LEN_WORD] }
}

/// Does `obj` need the deep walk at all? Mirrors `deep_hash`'s dispatch.
fn isBuiltin(classId: int) -> bool {
    return classId == PICKLE_CLASS_STRING || classId == PICKLE_CLASS_LIST ||
           classId == PICKLE_CLASS_MAP || classId == PICKLE_CLASS_ENUM ||
           classId == PICKLE_CLASS_TUPLE || isBoxClass(classId)
}

// ---------------------------------------------------------------------------
// Deep structural hash
// ---------------------------------------------------------------------------

/// Deep structural hash. `path` is the ancestor chain, so a cycle is *detected* rather
/// than recursed forever: a revisit reports `(CYCLIC_HASH, true)` instead of descending.
/// Two equal acyclic structures always produce the same hash.
///
/// Returns the hash; `flag[0]` is set to `1` when any node on the walk is cyclic.
/// Mirrors `deep_hash`'s `(u64, bool)`, but with the flag out-parameter so the
/// function returns a plain `int`: a tuple return would allocate.
fn deepHash(obj: *int, path: *int, depth: int, flag: *int) -> int {
    unsafe {
        var addr = obj as int
        if (isNoneKey(addr)) {
            return GOLDEN
        }
        if (depth >= KEY_PATH_WORDS) {
            flag[0] = 1
            return CYCLIC_HASH
        }
        if (pathHas(path, depth, addr)) {
            flag[0] = 1
            return CYCLIC_HASH
        }
        path[depth] = addr
        var classId = obj[1]
        // A FREE_SENTINEL block can only be reached through a stale key. Hash by
        // identity instead of trampling free-list metadata. Faithful to the original,
        // which returns here without popping `path`.
        if (classId == FREE_SENTINEL) {
            return identityHash(obj, classId)
        }

        var h = FNV_OFFSET

        if (classId == PICKLE_CLASS_STRING) {
            h = fnv1aStr(obj)
        } else if (isBoxClass(classId)) {
            h = mix(h, classId)
            h = mix(h, boxBits(obj))
        } else if (classId == PICKLE_CLASS_LIST) {
            // Ordered: element order participates in the hash.
            h = mix(h, classId)
            var n = obj[LIST_LEN_WORD]
            var data = obj[LIST_DATA_WORD] as *int
            var i = 0
            while (i < n) {
                var eh = deepHash(data[i] as *int, path, depth + 1, flag)
                h = mix(h, eh)
                i = i + 1
            }
        } else if (classId == PICKLE_CLASS_MAP) {
            // Order-insensitive: entries combine by addition, so two maps holding the
            // same pairs hash alike regardless of insertion order.
            h = mix(h, classId)
            var cap = obj[CAP_WORD]
            var entries = obj[ENTRIES_WORD] as *int
            var sum = 0
            var i = 0
            while (i < cap) {
                var k = entries[i * 2]
                if (!isLiveKey(k)) {
                    i = i + 1
                    continue
                }
                var kh = deepHash(k as *int, path, depth + 1, flag)
                var vh = deepHash(entries[i * 2 + 1] as *int, path, depth + 1, flag)
                sum = sum + kh
                sum = sum + vh * GOLDEN
                i = i + 1
            }
            h = mix(h, sum)
        } else if (classId == PICKLE_CLASS_ENUM) {
            h = mix(h, classId)
            h = mix(h, obj[ENUM_TAG_WORD])
            var n = enumFieldCount(obj)
            var i = 0
            while (i < n) {
                var eh = deepHash(obj[SLOT1_WORD + i] as *int, path, depth + 1, flag)
                h = mix(h, eh)
                i = i + 1
            }
        } else if (classId == PICKLE_CLASS_TUPLE) {
            // Ordered: arity and element order participate.
            h = mix(h, classId)
            var n = tupleFieldCount(obj)
            h = mix(h, n)
            var i = 0
            while (i < n) {
                var eh = deepHash(obj[SLOT1_WORD + i] as *int, path, depth + 1, flag)
                h = mix(h, eh)
                i = i + 1
            }
        } else {
            // User class/struct/interface instance: class identity + slots.
            h = mix(h, classId)
            var size = obj[2]
            if (size < HEADER || size >= MAX_PLAUSIBLE_SIZE) {
                // Absurd size: a stale/reused key. Hash by identity so lookups miss.
                return identityHash(obj, classId)
            }
            var slots = (size - HEADER) / 8
            var i = 0
            while (i < slots) {
                var eh = deepHash(obj[SLOT0_WORD + i] as *int, path, depth + 1, flag)
                h = mix(h, eh)
                i = i + 1
            }
        }

        return h
    }
}

/// Hash a map key object. Mirrors `key_hash`.
///
/// Strings hash over their bytes and boxed scalars over `(class_id, payload)`, with
/// `class_id` mixed in everywhere so equal payloads never collide across key types.
/// Composite keys hash deeply. A key containing a cycle falls back to *root-identity*
/// hashing -- identity is the one strength-safe semantics for cyclic structures.
fn keyHash(key: *int) -> int {
    unsafe {
        var addr = key as int
        // A `none` key (null outside, the KEY_NONE marker in the table) is one
        // distinguished identity whose hash matches the fixed constant `deepHash`
        // uses for a null slot, so none-as-key and none-nested are interchangeable.
        if (isNoneKey(addr)) {
            return GOLDEN
        }
        var classId = key[1]
        if (classId == PICKLE_CLASS_STRING) {
            return fnv1aStr(key)
        }
        if (isBoxClass(classId)) {
            var h = FNV_OFFSET
            h = mix(h, classId)
            h = mix(h, boxBits(key))
            return h
        }
        var path = keyScratch()
        if (path == 0) {
            // TLS/scratch failure: identity is the same conservative fallback a
            // cyclic key takes, and it keeps the lookup allocation-free.
            return identityHash(key, classId)
        }
        var flag = (path + KEY_FLAG_OFF) as *int
        flag[0] = 0
        var h = deepHash(key, path as *int, 0, flag)
        if (flag[0] != 0) {
            return identityHash(key, classId)
        }
        return h
    }
}

// ---------------------------------------------------------------------------
// Deep structural equality
// ---------------------------------------------------------------------------

/// Deep structural equality. `path` holds the ancestor `(a, b)` pairs, so cycles are
/// detected rather than recursed forever (`CMP_CYCLIC`); `depth` counts pairs
/// already stored.
fn deepEq(a: *int, b: *int, path: *int, depth: int) -> int {
    unsafe {
        var aa = a as int
        var bb = b as int
        if (aa == bb) { return CMP_EQUAL }
        // A `none` (null or marker) equals only itself.
        if (isNoneKey(aa)) {
            if (isNoneKey(bb)) { return CMP_EQUAL }
            return CMP_DIFF
        }
        if (isNoneKey(bb)) { return CMP_DIFF }
        if (depth >= KEY_PATH_WORDS / 2) { return CMP_CYCLIC }
        if (pathHasPair(path, depth, aa, bb)) { return CMP_CYCLIC }
        path[2 * depth] = aa
        path[2 * depth + 1] = bb

        var r = CMP_EQUAL
        var classA = a[1]
        if (classA != b[1]) {
            r = CMP_DIFF
        } else if (classA == PICKLE_CLASS_STRING) {
            if (abiStrCmp(a, b) != 0) { r = CMP_DIFF }
        } else if (isBoxClass(classA)) {
            if (boxBits(a) != boxBits(b)) { r = CMP_DIFF }
        } else if (classA == PICKLE_CLASS_LIST) {
            var la = a[LIST_LEN_WORD]
            if (la != b[LIST_LEN_WORD]) {
                r = CMP_DIFF
            } else {
                var da = a[LIST_DATA_WORD] as *int
                var db = b[LIST_DATA_WORD] as *int
                var i = 0
                while (i < la) {
                    r = deepEq(da[i] as *int, db[i] as *int, path, depth + 1)
                    if (r != CMP_EQUAL) { break }
                    i = i + 1
                }
            }
        } else if (classA == PICKLE_CLASS_MAP) {
            r = deepEqMap(a, b, path, depth + 1)
        } else if (classA == PICKLE_CLASS_ENUM) {
            if (a[ENUM_TAG_WORD] != b[ENUM_TAG_WORD]) {
                r = CMP_DIFF
            } else {
                var na = enumFieldCount(a)
                if (na != enumFieldCount(b)) {
                    r = CMP_DIFF
                } else {
                    var i = 0
                    while (i < na) {
                        r = deepEq(a[SLOT1_WORD + i] as *int, b[SLOT1_WORD + i] as *int, path, depth + 1)
                        if (r != CMP_EQUAL) { break }
                        i = i + 1
                    }
                }
            }
        } else if (classA == PICKLE_CLASS_TUPLE) {
            var na = tupleFieldCount(a)
            if (na != tupleFieldCount(b)) {
                r = CMP_DIFF
            } else {
                var i = 0
                while (i < na) {
                    r = deepEq(a[SLOT1_WORD + i] as *int, b[SLOT1_WORD + i] as *int, path, depth + 1)
                    if (r != CMP_EQUAL) { break }
                    i = i + 1
                }
            }
        } else {
            // User class/struct/interface instance.
            var na = 0
            var nb = 0
            var sa = a[2]
            var sb = b[2]
            if (sa > HEADER) { na = (sa - HEADER) / 8 }
            if (sb > HEADER) { nb = (sb - HEADER) / 8 }
            if (na != nb) {
                r = CMP_DIFF
            } else {
                var i = 0
                while (i < na) {
                    r = deepEq(a[SLOT0_WORD + i] as *int, b[SLOT0_WORD + i] as *int, path, depth + 1)
                    if (r != CMP_EQUAL) { break }
                    i = i + 1
                }
            }
        }

        return r
    }
}

/// Read/write one matched-entry flag in a raw flag block (one bit per entry).
fn usedGet(used: *int, j: int) -> bool {
    unsafe {
        return ((used[j >> 3] >> ((j & 7) * 8)) & 255) != 0
    }
}

fn usedSet(used: *int, j: int) {
    unsafe {
        var w = j >> 3
        used[w] = used[w] | (1 << ((j & 7) * 8))
    }
}

/// Order-insensitive map equality: every live entry of `a` must match a *distinct*
/// live entry of `b`. Mirrors the `PICKLE_CLASS_MAP` arm of `deep_eq`.
fn deepEqMap(a: *int, b: *int, path: *int, depth: int) -> int {
    unsafe {
        var la = a[LEN_WORD]
        var lb = b[LEN_WORD]
        if (la != lb) { return CMP_DIFF }
        var capa = a[CAP_WORD]
        var ea = a[ENTRIES_WORD] as *int
        var capb = b[CAP_WORD]
        var eb = b[ENTRIES_WORD] as *int

        // `used[j]` marks entry `j` of `b` as already matched, so a duplicate in `a`
        // cannot claim the same `b` entry twice. The flags live in this depth's
        // slice of the per-thread scratch block; a `List<bool>` here would make
        // the whole key-equality chain may-collect again.
        if (depth >= KEY_USED_LEVELS || capb > KEY_USED_BYTES * 8) {
            return CMP_CYCLIC
        }
        var used = ((path as int) + KEY_USED_BASE + depth * KEY_USED_BYTES) as *int
        var usedWords = (capb + 7) / 8
        var f = 0
        while (f < usedWords) {
            used[f] = 0
            f = f + 1
        }

        var r = CMP_EQUAL
        var i = 0
        while (i < capa && r == CMP_EQUAL) {
            var ka = ea[i * 2]
            var va = ea[i * 2 + 1]
            if (!isLiveKey(ka)) {
                i = i + 1
                continue
            }
            var found = false
            var j = 0
            while (j < capb) {
                if (!usedGet(used, j)) {
                    var kb = eb[j * 2]
                    var vb = eb[j * 2 + 1]
                    if (isLiveKey(kb)) {
                        let kr = deepEq(ka as *int, kb as *int, path, depth)
                        if (kr == CMP_EQUAL) {
                            let vr = deepEq(va as *int, vb as *int, path, depth)
                            if (vr == CMP_EQUAL) {
                                usedSet(used, j)
                                found = true
                                j = capb
                            } else if (vr != CMP_DIFF) {
                                r = vr
                                j = capb
                            }
                        } else if (kr != CMP_DIFF) {
                            r = kr
                            j = capb
                        }
                    }
                }
                j = j + 1
            }
            if (!found && r == CMP_EQUAL) { r = CMP_DIFF }
            i = i + 1
        }
        return r
    }
}

/// Are `a` and `b` the same key? Mirrors `key_eq`: matching class plus matching
/// bytes/payload, compared deeply for composites. A cyclic key pair falls back to
/// root identity (the same strength-safe semantics `keyHash` uses).
fn keyEq(a: *int, b: *int) -> bool {
    unsafe {
        var aa = a as int
        var bb = b as int
        if (aa == bb) { return true }
        // A `none` key equals only itself.
        if (isNoneKey(aa) || isNoneKey(bb)) { return false }

        var classA = a[1]
        var classB = b[1]
        if (classA != classB) { return false }

        // Fast path for non-composite keys: avoid allocating a cycle-tracking
        // path list on every probe. Strings and boxed scalars are acyclic and
        // compared by bytes/payload, matching deepEq's behaviour.
        if (classA == PICKLE_CLASS_STRING) {
            return abiStrCmp(a, b) == 0
        }
        if (isBoxClass(classA)) {
            return boxBits(a) == boxBits(b)
        }

        var path = keyScratch()
        if (path == 0) {
            // No scratch: only identity equality is provable, and that was
            // already checked above.
            return false
        }
        return deepEq(a, b, path as *int, 0) == CMP_EQUAL
    }
}

// ---------------------------------------------------------------------------
// Open-addressing table
// ---------------------------------------------------------------------------

/// Allocate a zeroed span of `words` words. Mirrors the
/// `ptr::write_bytes(fresh, 0, ...)` that `map_new` and `rehash` perform.
///
/// This is NOT optional. `alloc` returns UNINITIALISED memory -- measured: a fresh
/// `alloc(8)` reads back with all eight words non-zero, and `alloc(2048)` came back with
/// 801 dirty words -- exactly like the native `heap::raw_alloc`, which also skips the
/// zeroing. Native `map_new` and `rehash` therefore zero the table explicitly, because
/// for an open-addressing table "this slot is empty" is a load-bearing invariant, not an
/// aesthetic one: `entriesCount` counted 16 live entries on a brand-new map before this
/// zeroing was added, so `needs_grow` fired immediately and `find_slot` walked into an
/// unreadable key. Anything that wants an empty span has to ask for one.
fn zeroed(words: int) -> *int {
    unsafe {
        var p = abiManagedAlloc(words * 8) as *int
        // Sentinel zeroing is a table-sized memset: the loop this replaced
        // stored one word per iteration, which showed up as ~0.7ms of the
        // benchmark's per-document map construction (four tables per map).
        memset(p, 0, words * 8)
        return p
    }
}

/// A negative-membership filter stored immediately before the entry table, in
/// the same allocation. Four words / 256 bits, indexed by two hash bytes, with
/// one bit each: for the benchmark's 40-key tables that rejects ~90% of absent
/// keys with one or two word tests, saving the entry load and the dependent key
/// load on the 87% of query lookups that miss. Bits are only ever OR'd in, so
/// removal and overwrite may leave stale bits (a false positive just takes the
/// ordinary probe); `clear` and `rehash` reset the filter with the table. It is
/// metadata, never part of `entries`, `map_keys` order, or the FNV values.
///
/// `MAP_BLOOM_OFF` in `runtime.layout` is the same number as `BLOOM_BYTES`: the
/// collector needs it to recover the block base from a map's entries pointer,
/// so the byte count lives with the other map offsets and this module derives
/// its word count from it rather than declaring an independent literal.
const BLOOM_WORDS: int = MAP_BLOOM_OFF / 8
const BLOOM_BYTES: int = MAP_BLOOM_OFF

/// LAST-LOOKUP CACHE (get -> set fusion).
///
/// The benchmark's hottest map shape is `m[w] = m.get(w).unwrapOr(0) + 1`,
/// which probes the identical key twice in a row. `abiMapGet` records the slot
/// its probe settled on (the matching slot on a hit, the insertion slot on a
/// miss - the first tombstone, else the empty slot); `abiMapSet` revalidates
/// that slot with one version compare and skips hashing and probing entirely.
///
/// Correctness comes from the version, not from the slot: every mutating entry
/// point bumps `mapVer`, and a set only trusts the cache when the version it
/// read at entry equals the version the get stamped. Any interleaved mutation
/// (including table growth, which reallocates `entries`) invalidates it. The
/// slot word is re-checked anyway (it must still hold the same key pointer, or
/// an empty/tombstone sentinel), so a corrupted cache degrades to the ordinary
/// probe instead of writing a wrong slot.
var mapVer: int = 1
var llVer: int = 0
var llMap: int = 0
var llKey: int = 0
var llSlot: int = 0
var llHash: int = 0

/// Serialises version bumps once the process can run more than one thread.
///
/// A version must be *unique*, not merely monotone: two sets that both read `V`
/// and both write `V + 1` would stamp the cache with the same version for two
/// different mutations, and a get stamped `V + 1` could then validate the wrong
/// slot. In single-thread mode this is the plain `mapVer + 1` it has always
/// been - no branch beyond the cached mode word, no lock.
var mapVerLock: int = 0

fn mapBump() -> int {
    if (abiRawParallelMode() == 0) {
        var v = mapVer + 1
        mapVer = v
        return v
    }
    var v = 0
    unsafe {
        lockAcquire((&mapVerLock) as int)
        v = mapVer + 1
        mapVer = v
        lockRelease((&mapVerLock) as int)
    }
    return v
}

/// Zeroed bloom filter + `cap` two-word entry slots in one allocation. The
/// returned pointer is the entry table; the filter is `BLOOM_BYTES` before it.
fn mapTableNew(cap: int) -> *int {
    unsafe {
        var base = zeroed(BLOOM_WORDS + cap * 2)
        return (base as int + BLOOM_BYTES) as *int
    }
}

fn bloomAdd(entries: *int, h: int) {
    unsafe {
        var b = (entries as int - BLOOM_BYTES) as *int
        var bit = h & 255
        b[bit >> 6] = b[bit >> 6] | (1 << (bit & 63))
        var bit2 = (h >> 8) & 255
        b[bit2 >> 6] = b[bit2 >> 6] | (1 << (bit2 & 63))
    }
}

fn bloomHit(entries: *int, h: int) -> bool {
    unsafe {
        var b = (entries as int - BLOOM_BYTES) as *int
        var bit = h & 255
        if ((b[bit >> 6] & (1 << (bit & 63))) == 0) { return false }
        var bit2 = (h >> 8) & 255
        return (b[bit2 >> 6] & (1 << (bit2 & 63))) != 0
    }
}

/// Live entries in the table.
fn entriesCount(entries: *int, cap: int) -> int {
    unsafe {
        var n = 0
        var i = 0
        while (i < cap) {
            if (isLiveKey(entries[i * 2])) { n = n + 1 }
            i = i + 1
        }
        return n
    }
}

/// Does the table need to grow before the next insert? Mirrors `needs_grow`: at
/// `(occupied + 1) >= cap * MAX_LOAD`, where `occupied` counts live entries AND
/// tombstones. Tracked incrementally on the map for O(1) checks.
fn needsGrow(map: *int) -> bool {
    unsafe {
        var occupied = map[OCCUPIED_WORD]
        var cap = map[CAP_WORD]
        return (occupied as float + 1.0) >= (cap as float * MAX_LOAD)
    }
}

/// Locate `key` in `entries`. Returns an ENCODED slot rather than `(slot, found)`:
/// a hit is `slot + 1` (always odd), a miss is the plain slot (always even, since
/// slots are `idx * 2`). The encoding exists for speed: a tuple return allocates
/// a heap tuple plus boxed `int`/`bool` fields on every probe, which made
/// `mapSet` (one probe per insert) about five times the cost of `mapGet`.
/// On a miss the slot is either an empty one or the first tombstone passed,
/// whichever comes first. Mirrors `find_slot`.
fn findSlot(entries: *int, cap: int, key: *int, h: int) -> int {
    unsafe {
        var mask = cap - 1
        var idx = h & mask
        var firstTomb = -1
        while (true) {
            var slot = idx * 2
            var k = entries[slot]
            if (k == KEY_EMPTY) {
                var target = slot
                if (firstTomb >= 0) { target = firstTomb }
                return target
            }
            if (isTombstone(k)) {
                if (firstTomb < 0) { firstTomb = slot }
            } else if (keyEq(k as *int, key)) {
                return slot + 1
            }
            idx = (idx + 1) & mask
        }
    }
    return 0
}

/// Re-probe every live entry into a table of `newCap` slots. Mirrors `rehash`; the old
/// table is abandoned rather than freed (`alloc` has no free -- see the module doc).
///
/// The fresh table starts empty, and a map's live entries are pairwise unequal,
/// so the old two calls (`findSlot` then `bloomAdd`) were doing work rehash
/// cannot need: `findSlot`'s equality tests can never fire, and its tombstone
/// search has no tombstones to find. What remains is exactly `findSlot`'s
/// placement rule - walk from `hash & mask` to the first EMPTY slot - plus the
/// two bloom bit stores. Placement is therefore slot-for-slot identical to
/// inserting the same keys into a pre-sized map; `abi_map_test` pins that.
fn rehash(oldEntries: *int, oldCap: int, newCap: int) -> *int {
    unsafe {
        var fresh = mapTableNew(newCap)
        var mask = newCap - 1
        var bloom = (fresh as int - BLOOM_BYTES) as *int
        var i = 0
        while (i < oldCap) {
            var k = oldEntries[i * 2]
            if (isLiveKey(k)) {
                var kp = k as *int
                // Every insertion path caches the FNV hash on heap strings,
                // which is nearly every rehashed key; reading it avoids
                // `keyHash`'s class dispatch and deep-key entry checks.
                var h = 0
                if (kp[1] == PICKLE_CLASS_STRING && (kp[SIZE_WORD] & FLAG_HASH) != 0) {
                    h = kp[0]
                } else {
                    h = keyHash(kp)
                }
                var idx = h & mask
                var placed = false
                while (!placed) {
                    var slot = idx * 2
                    if (fresh[slot] == KEY_EMPTY) {
                        fresh[slot] = k
                        fresh[slot + 1] = oldEntries[i * 2 + 1]
                        placed = true
                    } else {
                        idx = (idx + 1) & mask
                    }
                }
                var bit = h & 255
                bloom[bit >> 6] = bloom[bit >> 6] | (1 << (bit & 63))
                var bit2 = (h >> 8) & 255
                bloom[bit2 >> 6] = bloom[bit2 >> 6] | (1 << (bit2 & 63))
            }
            i = i + 1
        }
        return fresh
    }
}

/// Create an empty map. Mirrors `map_new`: the requested capacity is floored at
/// `INITIAL_CAP` and rounded up to a power of two, which `findSlot`'s
/// `idx & (cap - 1)` masking requires.
fn mapNew(cap: int) -> *int {
    unsafe {
        // A fresh map can land on an address a freed oversized map used to
        // occupy, so invalidate the last-lookup cache unconditionally.
        mapVer = mapBump()
        var c = cap
        if (c < INITIAL_CAP) { c = INITIAL_CAP }
        c = nextPow2(c)
        var obj = abiManagedAlloc(MAP_OBJECT_SIZE) as *int
        obj[0] = 0
        obj[1] = PICKLE_CLASS_MAP
        obj[2] = MAP_OBJECT_SIZE
        obj[LEN_WORD] = 0
        obj[CAP_WORD] = c
        obj[OCCUPIED_WORD] = 0
        obj[ENTRIES_WORD] = mapTableNew(c) as int
        abiRegisterObject(obj as int)
        return obj
    }
}

/// Insert `key -> value`, returning the previous value if any. Mirrors `map_set`.
///
/// Only a *null* key is translated to the `none` marker -- there is no other way for a
/// caller to present one.
fn mapSet(map: *int, key: *int, value: *int) -> *int {
    unsafe {
        mapVer = mapBump()
        var k = key as int
        if (k == KEY_EMPTY) { k = KEY_NONE }
        var h = keyHash(k as *int)
        if (needsGrow(map)) {
            var newCap = map[CAP_WORD] * 2
            map[ENTRIES_WORD] = rehash(map[ENTRIES_WORD] as *int, map[CAP_WORD], newCap) as int
            map[CAP_WORD] = newCap
            map[OCCUPIED_WORD] = map[LEN_WORD]
        }
        var entries = map[ENTRIES_WORD] as *int
        var fr = findSlot(entries, map[CAP_WORD], k as *int, h)
        var found = (fr & 1) != 0
        var slot = fr - (fr & 1)
        var old = entries[slot + 1] as *int
        if (!found && entries[slot] == KEY_EMPTY) {
            map[OCCUPIED_WORD] = map[OCCUPIED_WORD] + 1
        }
        entries[slot] = k
        entries[slot + 1] = value as int
        var bb = (entries as int - BLOOM_BYTES) as *int
        var bit = h & 255
        bb[bit >> 6] = bb[bit >> 6] | (1 << (bit & 63))
        var bit2 = (h >> 8) & 255
        bb[bit2 >> 6] = bb[bit2 >> 6] | (1 << (bit2 & 63))
        if (!found) {
            map[LEN_WORD] = map[LEN_WORD] + 1
        }
        return old
    }
}

/// Look up `key`; null when absent. Mirrors `map_get`, including its bounded probe:
/// at most `cap` steps, so a corrupted key chain cannot spin forever.
fn mapGet(map: *int, key: *int) -> *int {
    unsafe {
        var k = key as int
        if (k == KEY_EMPTY) { k = KEY_NONE }
        var h = keyHash(k as *int)
        var cap = map[CAP_WORD]
        var mask = cap - 1
        var idx = h & mask
        var probes = 0
        var entries = map[ENTRIES_WORD] as *int
        var bb = (entries as int - BLOOM_BYTES) as *int
        var bit = h & 255
        var bloom = false
        if ((bb[bit >> 6] & (1 << (bit & 63))) != 0) {
            var bit2 = (h >> 8) & 255
            if ((bb[bit2 >> 6] & (1 << (bit2 & 63))) != 0) {
                bloom = true
            }
        }
        if (!bloom) { return 0 as *int }
        while (probes < cap) {
            var slot = idx * 2
            var sk = entries[slot]
            if (sk == KEY_EMPTY) { return 0 as *int }
            if (isLiveKey(sk) && keyEq(sk as *int, k as *int)) {
                return entries[slot + 1] as *int
            }
            idx = (idx + 1) & mask
            probes = probes + 1
        }
        return 0 as *int
    }
}

/// Remove `key`, returning the removed value when present else null. Mirrors
/// `map_remove`: the slot keeps its position and becomes a tombstone, which is what
/// keeps the probe chains of the entries after it intact.
fn mapRemove(map: *int, key: *int) -> *int {
    unsafe {
        mapVer = mapBump()
        var k = key as int
        if (k == KEY_EMPTY) { k = KEY_NONE }
        var h = keyHash(k as *int)
        var cap = map[CAP_WORD]
        var mask = cap - 1
        var idx = h & mask
        var probes = 0
        var entries = map[ENTRIES_WORD] as *int
        while (probes < cap) {
            var slot = idx * 2
            var sk = entries[slot]
            if (sk == KEY_EMPTY) { return 0 as *int }
            if (isLiveKey(sk) && keyEq(sk as *int, k as *int)) {
                var v = entries[slot + 1] as *int
                entries[slot] = KEY_TOMBSTONE
                entries[slot + 1] = KEY_EMPTY
                map[LEN_WORD] = map[LEN_WORD] - 1
                return v
            }
            idx = (idx + 1) & mask
            probes = probes + 1
        }
        return 0 as *int
    }
}

/// Materialize the live keys (or values) as a fresh `List`. Mirrors `map_snapshot`.
fn mapSnapshot(map: *int, wantKeys: bool) -> *int {
    unsafe {
        var cap = map[CAP_WORD]
        let count = map[LEN_WORD]
        var entries = map[ENTRIES_WORD] as *int
        // A snapshot has exactly one element per live entry. Preallocate the
        // known final length so sparse maps do not retain capacity-sized list
        // storage. No allocation happens between `abiListNew` and the length
        // store below, so `data` cannot move.
        var l = abiListNew(count)
        var data = l[LIST_DATA_WORD] as *int
        var n = 0
        var i = 0
        while (i < cap) {
            var k = entries[i * 2]
            if (!isLiveKey(k)) {
                i = i + 1
                continue
            }
            var val = 0 as *int
            if (wantKeys) {
                // A stored `none` key is the marker; surface it as null, the runtime
                // representation the compiler expects for `T?`.
                if (k == KEY_NONE) { val = 0 as *int } else { val = k as *int }
            } else {
                val = entries[i * 2 + 1] as *int
            }
            data[n] = val as int
            n = n + 1
            i = i + 1
        }
        l[LIST_LEN_WORD] = n
        return l
    }
}

// ---------------------------------------------------------------------------
// ABI entry points
// ---------------------------------------------------------------------------

/// Create an empty map. Mirrors `pickle_map_new(cap)`.
#[symbol("pickle_map_new")]
fn abiMapNew(cap: int) -> *int {
    return mapNew(cap)
}

/// Insert `key -> value`. Mirrors `pickle_map_set`, which discards the previous value.
///
/// HOT PATH, SPECIALIZED. The string hash and probe comparison are inlined
/// below. The old comment here recorded the opposite decision, measured while
/// this body still paid shadow-frame zeroing for every temp: inlining doubled
/// the frame and lost ~14%. That trade only holds when the extra homes are
/// zeroed; this function's frame is dominated by the growth path now, so the
/// calls are the larger cost. Composite keys still fall back to
/// `keyHash`/`keyEq`.
/// Insert or overwrite `key`. Mirrors `pickle_map_set`.
///
/// The general body: every key kind, including composite (deep) keys. Kept as
/// the reference implementation and the fallback for keys the string fast path
/// does not cover. Not exported; `abiMapSet` below is the ABI entry.
fn abiMapSetSlow(map: *int, key: *int, value: *int) {
    unsafe {
        // The get->set cache's version guard assumes every structural
        // mutation bumps `mapVer`. `abiMapSet` bumps before delegating here,
        // but tests and future internal callers reach this body directly, so
        // bump again: an extra increment only invalidates a cache entry that
        // the following set would have had to re-probe anyway.
        mapVer = mapBump()
        var k = key as int
        if (k == KEY_EMPTY) { k = KEY_NONE }
        var kp = k as *int
        var h = GOLDEN
        var kStr = false
        if (k != KEY_NONE) {
            var cid = kp[1]
            if (cid == PICKLE_CLASS_STRING) {
                var sf = kp[SIZE_WORD]
                if ((sf & FLAG_HASH) != 0) {
                    h = kp[0]
                } else {
                    h = FNV_OFFSET
                    var sn = kp[LEN_WORD]
                    if (sn <= 8) {
                        // Short keys (every term in the benchmark): one 64-bit load,
                        // one byte per step. Bytes past `sn` live in the string's
                        // last allocated word and are shifted out before they can
                        // enter the hash.
                        var v = kp[STR_BYTES_WORD]
                        var n = 0
                        while (n < sn) {
                            h = (h ^ (v & 255)) * FNV_PRIME
                            v = v >> 8
                            n = n + 1
                        }
                    } else {
                        var full = sn >> 3
                        var w = 0
                        while (w < full) {
                            var v = kp[STR_BYTES_WORD + w]
                            var j = 0
                            while (j < 8) {
                                h = (h ^ ((v >> (j * 8)) & 255)) * FNV_PRIME
                                j = j + 1
                            }
                            w = w + 1
                        }
                        var rem = sn & 7
                        if (rem != 0) {
                            var vr = kp[STR_BYTES_WORD + full]
                            var jr = 0
                            while (jr < rem) {
                                h = (h ^ ((vr >> (jr * 8)) & 255)) * FNV_PRIME
                                jr = jr + 1
                            }
                        }
                    }
                    if ((sf & FLAG_HEAP) != 0) {
                        kp[0] = h
                        kp[SIZE_WORD] = sf | FLAG_HASH
                    }
                }
                kStr = true
            } else if (boxClassFast(cid)) {
                h = mix(mix(FNV_OFFSET, cid), kp[BOX_BITS_WORD])
            } else {
                h = keyHash(kp)
            }
        }
        // Inlined `needsGrow`: `(occupied+1) >= cap * 0.7` in exact integer form
        // (`*10` vs `*7`). `cap` is a power of two, so the float threshold can
        // never sit on an integer and the two forms agree at every boundary.
        if ((map[OCCUPIED_WORD] + 1) * 10 >= map[CAP_WORD] * 7) {
            mapGrowThenSet(map, k as *int, value)
            return
        }
        var entries = map[ENTRIES_WORD] as *int
        var cap = map[CAP_WORD]
        var mask = cap - 1
        var idx = h & mask
        var firstTomb = -1
        var target = -1
        var found = false
        var done = false
        while (!done) {
            var slot = idx * 2
            var sk = entries[slot]
            if (sk == KEY_EMPTY) {
                target = slot
                if (firstTomb >= 0) { target = firstTomb }
                done = true
            } else if (sk == KEY_TOMBSTONE) {
                if (firstTomb < 0) { firstTomb = slot }
                idx = (idx + 1) & mask
            } else {
                var same = false
                if (sk == k) {
                    same = true
                } else if (kStr && (sk as *int)[1] == PICKLE_CLASS_STRING) {
                    var skp = sk as *int
                    var eq = false
                    var ln = kp[LEN_WORD]
                    if (ln == skp[LEN_WORD]) {
                        var nfull = ln >> 3
                        var q = 0
                        eq = true
                        while (q < nfull) {
                            if (kp[STR_BYTES_WORD + q] != skp[STR_BYTES_WORD + q]) {
                                eq = false
                                break
                            }
                            q = q + 1
                        }
                        var nrem = ln & 7
                        if (eq && nrem != 0) {
                            var msk = (1 << (nrem * 8)) - 1
                            if ((kp[STR_BYTES_WORD + nfull] & msk) != (skp[STR_BYTES_WORD + nfull] & msk)) {
                                eq = false
                            }
                        }
                    }
                    same = eq
                } else {
                    same = keyEq(sk as *int, kp)
                }
                if (same) {
                    target = slot
                    found = true
                    done = true
                } else {
                    idx = (idx + 1) & mask
                }
            }
        }
        if (!found && entries[target] == KEY_EMPTY) {
            map[OCCUPIED_WORD] = map[OCCUPIED_WORD] + 1
        }
        entries[target] = k
        entries[target + 1] = value as int
        var bb = (entries as int - BLOOM_BYTES) as *int
        var bit = h & 255
        bb[bit >> 6] = bb[bit >> 6] | (1 << (bit & 63))
        var bit2 = (h >> 8) & 255
        bb[bit2 >> 6] = bb[bit2 >> 6] | (1 << (bit2 & 63))
        if (!found) {
            map[LEN_WORD] = map[LEN_WORD] + 1
        }
    }
}

/// Insert or overwrite `key`. Mirrors `pickle_map_set`.
///
/// STRING-KEY FAST PATH, the set-side twin of `abiMapGet`. It specialises the
/// benchmark's shape (`Map<string, int>`, short keys) and delegates every other
/// key kind, long key, or table-growth boundary to `abiMapSetSlow`. The probe
/// order, tombstone reuse, `occupied`/`len` updates and FNV arithmetic are
/// identical; `abi_map_test.pkl` pins the fast and slow tables slot for slot.
#[symbol("pickle_map_set")]
fn abiMapSet(map: *int, key: *int, value: *int) {
    unsafe {
        var k = key as int
        if (k == KEY_EMPTY) { k = KEY_NONE }
        // Fused get->set. The version read must happen before the bump below:
        // the get stamped the version it observed, and any mutation after that
        // point makes this comparison fail.
        var mv = mapVer
        mapVer = mapBump()
        if (llVer == mv && llMap == (map as int) && llKey == k && llSlot >= 0) {
            var ce = map[ENTRIES_WORD] as *int
            var cs = llSlot
            var ck = ce[cs]
            if (ck != KEY_EMPTY && ck != KEY_TOMBSTONE) {
                // The get stamped this slot only after matching `k` at this map
                // version, and nothing has mutated the map since (every
                // mutation bumps `mapVer`, which `mv` was read before). The
                // entry is therefore still the one it matched, even when the
                // stored key is a different, text-equal object - which is the
                // common shape: every split field is a fresh allocation. Only
                // the value changes; the stored key keeps its slot.
                ce[cs + 1] = value as int
                return
            }
            // Empty or tombstone: the get chose this slot as the insertion
            // target. The growth boundary is still checked, and delegates to
            // the ordinary path (which rehashes) when it is reached.
            if ((map[OCCUPIED_WORD] + 1) * 10 >= map[CAP_WORD] * 7) {
                mapGrowThenSet(map, key, value)
                return
            }
            ce[cs] = k
            ce[cs + 1] = value as int
            var ch = llHash
            var cbb = (ce as int - BLOOM_BYTES) as *int
            var cbit = ch & 255
            cbb[cbit >> 6] = cbb[cbit >> 6] | (1 << (cbit & 63))
            var cbit2 = (ch >> 8) & 255
            cbb[cbit2 >> 6] = cbb[cbit2 >> 6] | (1 << (cbit2 & 63))
            if (ck == KEY_EMPTY) {
                map[OCCUPIED_WORD] = map[OCCUPIED_WORD] + 1
            }
            map[LEN_WORD] = map[LEN_WORD] + 1
            return
        }
        if (k == KEY_NONE) {
            abiMapSetSlow(map, key, value)
            return
        }
        var kp = k as *int
        if (kp[1] != PICKLE_CLASS_STRING) {
            abiMapSetSlow(map, key, value)
            return
        }
        var sn = kp[LEN_WORD]
        if (sn > 8) {
            abiMapSetSlow(map, key, value)
            return
        }
        var h = 0
        var kflags = kp[SIZE_WORD]
        if ((kflags & FLAG_HASH) != 0) {
            h = kp[0]
        } else {
            h = FNV_OFFSET
            var v = kp[STR_BYTES_WORD]
            var n = 0
            while (n < sn) {
                h = (h ^ (v & 255)) * FNV_PRIME
                v = v >> 8
                n = n + 1
            }
            if ((kflags & FLAG_HEAP) != 0) {
                kp[0] = h
                kp[SIZE_WORD] = kflags | FLAG_HASH
            }
        }
        // Growth is the cold half: let the general body rehash and re-enter.
        if ((map[OCCUPIED_WORD] + 1) * 10 >= map[CAP_WORD] * 7) {
            mapGrowThenSet(map, key, value)
            return
        }
        var entries = map[ENTRIES_WORD] as *int
        var cap = map[CAP_WORD]
        var mask = cap - 1
        var idx = h & mask
        var firstTomb = -1
        var target = -1
        var found = false
        var done = false
        while (!done) {
            var slot = idx * 2
            var sk = entries[slot]
            if (sk == KEY_EMPTY) {
                target = slot
                if (firstTomb >= 0) { target = firstTomb }
                done = true
            } else if (sk == KEY_TOMBSTONE) {
                if (firstTomb < 0) { firstTomb = slot }
                idx = (idx + 1) & mask
            } else {
                if (sk == k) {
                    target = slot
                    found = true
                    done = true
                } else {
                    var skp = sk as *int
                    if (skp[1] != PICKLE_CLASS_STRING) {
                        // Only `keyEq` may decide cross-class equality.
                        abiMapSetSlow(map, key, value)
                        return
                    }
                    var eq = false
                    var ln = kp[LEN_WORD]
                    if (ln == skp[LEN_WORD]) {
                        var nfull = ln >> 3
                        var q = 0
                        eq = true
                        while (q < nfull) {
                            if (kp[STR_BYTES_WORD + q] != skp[STR_BYTES_WORD + q]) {
                                eq = false
                                break
                            }
                            q = q + 1
                        }
                        var nrem = ln & 7
                        if (eq && nrem != 0) {
                            var msk = (1 << (nrem * 8)) - 1
                            if ((kp[STR_BYTES_WORD + nfull] & msk) != (skp[STR_BYTES_WORD + nfull] & msk)) {
                                eq = false
                            }
                        }
                    }
                    if (eq) {
                        target = slot
                        found = true
                        done = true
                    } else {
                        idx = (idx + 1) & mask
                    }
                }
            }
        }
        if (!found && entries[target] == KEY_EMPTY) {
            map[OCCUPIED_WORD] = map[OCCUPIED_WORD] + 1
        }
        entries[target] = k
        entries[target + 1] = value as int
        var bb = (entries as int - BLOOM_BYTES) as *int
        var bit = h & 255
        bb[bit >> 6] = bb[bit >> 6] | (1 << (bit & 63))
        var bit2 = (h >> 8) & 255
        bb[bit2 >> 6] = bb[bit2 >> 6] | (1 << (bit2 & 63))
        if (!found) {
            map[LEN_WORD] = map[LEN_WORD] + 1
        }
    }
}

/// Cold half of `abiMapSet`: grow the table, then re-enter the fast insert.
/// Re-entering re-hashes once, which is invisible next to the rehash copy and
/// happens only on geometric growth boundaries.
fn mapGrowThenSet(map: *int, key: *int, value: *int) {
    unsafe {
        var newCap = map[CAP_WORD] * 2
        map[ENTRIES_WORD] = rehash(map[ENTRIES_WORD] as *int, map[CAP_WORD], newCap) as int
        map[CAP_WORD] = newCap
        map[OCCUPIED_WORD] = map[LEN_WORD]
    }
    abiMapSet(map, key, value)
}

/// Look up `key`, returning `default` when absent instead of null so compiled
/// `T?`-less call sites get a real object. Mirrors `pickle_map_get_boxed`.
///
/// The body duplicates `abiMapGet` on purpose: a shared probe helper would be
/// a second shadowed frame on the hottest lookup in the benchmark.
#[symbol("pickle_map_get_boxed")]
fn abiMapGetBoxed(map: *int, key: *int, default: *int) -> *int {
    unsafe {
        var k = key as int
        if (k == KEY_EMPTY) { k = KEY_NONE }
        var kp = k as *int
        var h = GOLDEN
        var kStr = false
        if (k != KEY_NONE) {
            var cid = kp[1]
            if (cid == PICKLE_CLASS_STRING) {
                // Inlined `strHashFast`; see `abiMapGet`.
                var sf = kp[SIZE_WORD]
                if ((sf & FLAG_HASH) != 0) {
                    h = kp[0]
                } else {
                    h = FNV_OFFSET
                    var sn = kp[LEN_WORD]
                    if (sn <= 8) {
                        // Short keys (every term in the benchmark): one 64-bit load,
                        // one byte per step. Bytes past `sn` live in the string's
                        // last allocated word and are shifted out before they can
                        // enter the hash.
                        var v = kp[STR_BYTES_WORD]
                        var n = 0
                        while (n < sn) {
                            h = (h ^ (v & 255)) * FNV_PRIME
                            v = v >> 8
                            n = n + 1
                        }
                    } else {
                        var full = sn >> 3
                        var w = 0
                        while (w < full) {
                            var v = kp[STR_BYTES_WORD + w]
                            var j = 0
                            while (j < 8) {
                                h = (h ^ ((v >> (j * 8)) & 255)) * FNV_PRIME
                                j = j + 1
                            }
                            w = w + 1
                        }
                        var rem = sn & 7
                        if (rem != 0) {
                            var vr = kp[STR_BYTES_WORD + full]
                            var jr = 0
                            while (jr < rem) {
                                h = (h ^ ((vr >> (jr * 8)) & 255)) * FNV_PRIME
                                jr = jr + 1
                            }
                        }
                    }
                    if ((sf & FLAG_HEAP) != 0) {
                        kp[0] = h
                        kp[SIZE_WORD] = sf | FLAG_HASH
                    }
                }
                kStr = true
            } else if (boxClassFast(cid)) {
                h = mix(mix(FNV_OFFSET, cid), kp[BOX_BITS_WORD])
            } else {
                h = keyHash(kp)
            }
        }
        var cap = map[CAP_WORD]
        var mask = cap - 1
        var idx = h & mask
        var probes = 0
        var entries = map[ENTRIES_WORD] as *int
        var bb = (entries as int - BLOOM_BYTES) as *int
        var bit = h & 255
        var bloom = false
        if ((bb[bit >> 6] & (1 << (bit & 63))) != 0) {
            var bit2 = (h >> 8) & 255
            if ((bb[bit2 >> 6] & (1 << (bit2 & 63))) != 0) {
                bloom = true
            }
        }
        if (!bloom) { return default }
        var firstTomb = -1
        while (probes < cap) {
            var slot = idx * 2
            var sk = entries[slot]
            if (sk == KEY_EMPTY) {
                // Compound map assignments lower to get_boxed followed by set
                // with this same key object. Preserve the probe result so that
                // set can update/insert without re-hashing or re-probing.
                var tgt = slot
                if (firstTomb >= 0) { tgt = firstTomb }
                llVer = mapVer
                llMap = map as int
                llKey = k
                llSlot = tgt
                llHash = h
                return default
            }
            if (sk != KEY_TOMBSTONE) {
                var same = false
                if (sk == k) {
                    same = true
                } else if (kStr && (sk as *int)[1] == PICKLE_CLASS_STRING) {
                    // Inlined `strEqFast`; see `abiMapGet`.
                    var skp = sk as *int
                    var eq = false
                    var ln = kp[LEN_WORD]
                    if (ln == skp[LEN_WORD]) {
                        var nfull = ln >> 3
                        var q = 0
                        eq = true
                        while (q < nfull) {
                            if (kp[STR_BYTES_WORD + q] != skp[STR_BYTES_WORD + q]) {
                                eq = false
                                break
                            }
                            q = q + 1
                        }
                        var nrem = ln & 7
                        if (eq && nrem != 0) {
                            var msk = (1 << (nrem * 8)) - 1
                            if ((kp[STR_BYTES_WORD + nfull] & msk) != (skp[STR_BYTES_WORD + nfull] & msk)) {
                                eq = false
                            }
                        }
                    }
                    same = eq
                } else {
                    same = keyEq(sk as *int, kp)
                }
                if (same) {
                    llVer = mapVer
                    llMap = map as int
                    llKey = k
                    llSlot = slot
                    llHash = h
                    return entries[slot + 1] as *int
                }
            }
            idx = (idx + 1) & mask
            probes = probes + 1
        }
        return default
    }
}

/// The general lookup: every key kind, including composite (deep) keys.
///
/// Kept as the reference implementation and the fallback for keys the string
/// fast path does not cover. Not exported; `abiMapGet` below is the ABI entry.
fn abiMapGetSlow(map: *int, key: *int) -> *int {
    unsafe {
        var k = key as int
        if (k == KEY_EMPTY) { k = KEY_NONE }
        var kp = k as *int
        var h = GOLDEN
        var kStr = false
        if (k != KEY_NONE) {
            var cid = kp[1]
            if (cid == PICKLE_CLASS_STRING) {
                var sf = kp[SIZE_WORD]
                if ((sf & FLAG_HASH) != 0) {
                    h = kp[0]
                } else {
                    h = FNV_OFFSET
                    var sn = kp[LEN_WORD]
                    if (sn <= 8) {
                        // Short keys (every term in the benchmark): one 64-bit load,
                        // one byte per step. Bytes past `sn` live in the string's
                        // last allocated word and are shifted out before they can
                        // enter the hash.
                        var v = kp[STR_BYTES_WORD]
                        var n = 0
                        while (n < sn) {
                            h = (h ^ (v & 255)) * FNV_PRIME
                            v = v >> 8
                            n = n + 1
                        }
                    } else {
                        var full = sn >> 3
                        var w = 0
                        while (w < full) {
                            var v = kp[STR_BYTES_WORD + w]
                            var j = 0
                            while (j < 8) {
                                h = (h ^ ((v >> (j * 8)) & 255)) * FNV_PRIME
                                j = j + 1
                            }
                            w = w + 1
                        }
                        var rem = sn & 7
                        if (rem != 0) {
                            var vr = kp[STR_BYTES_WORD + full]
                            var jr = 0
                            while (jr < rem) {
                                h = (h ^ ((vr >> (jr * 8)) & 255)) * FNV_PRIME
                                jr = jr + 1
                            }
                        }
                    }
                    if ((sf & FLAG_HEAP) != 0) {
                        kp[0] = h
                        kp[SIZE_WORD] = sf | FLAG_HASH
                    }
                }
                kStr = true
            } else if (boxClassFast(cid)) {
                h = mix(mix(FNV_OFFSET, cid), kp[BOX_BITS_WORD])
            } else {
                h = keyHash(kp)
            }
        }
        var cap = map[CAP_WORD]
        var mask = cap - 1
        var idx = h & mask
        var probes = 0
        var entries = map[ENTRIES_WORD] as *int
        var bb = (entries as int - BLOOM_BYTES) as *int
        var bit = h & 255
        var bloom = false
        if ((bb[bit >> 6] & (1 << (bit & 63))) != 0) {
            var bit2 = (h >> 8) & 255
            if ((bb[bit2 >> 6] & (1 << (bit2 & 63))) != 0) {
                bloom = true
            }
        }
        if (!bloom) { return 0 as *int }
        while (probes < cap) {
            var slot = idx * 2
            var sk = entries[slot]
            if (sk == KEY_EMPTY) { return 0 as *int }
            if (sk != KEY_TOMBSTONE) {
                var same = false
                if (sk == k) {
                    same = true
                } else if (kStr && (sk as *int)[1] == PICKLE_CLASS_STRING) {
                    var skp = sk as *int
                    var eq = false
                    var ln = kp[LEN_WORD]
                    if (ln == skp[LEN_WORD]) {
                        var nfull = ln >> 3
                        var q = 0
                        eq = true
                        while (q < nfull) {
                            if (kp[STR_BYTES_WORD + q] != skp[STR_BYTES_WORD + q]) {
                                eq = false
                                break
                            }
                            q = q + 1
                        }
                        var nrem = ln & 7
                        if (eq && nrem != 0) {
                            var msk = (1 << (nrem * 8)) - 1
                            if ((kp[STR_BYTES_WORD + nfull] & msk) != (skp[STR_BYTES_WORD + nfull] & msk)) {
                                eq = false
                            }
                        }
                    }
                    same = eq
                } else {
                    same = keyEq(sk as *int, kp)
                }
                if (same) { return entries[slot + 1] as *int }
            }
            idx = (idx + 1) & mask
            probes = probes + 1
        }
        return 0 as *int
    }
}

/// Look up `key`; null when absent. Mirrors `pickle_map_get`.
///
/// STRING-KEY FAST PATH. The benchmark's maps are `Map<string, int>` and every
/// lookup key is short, so this entry specialises exactly that shape and hands
/// everything else (boxed keys, composite keys, `none`, long strings) to
/// `abiMapGetSlow`. Splitting the body matters: the generic version carries the
/// deep-key walkers' live ranges, which spread the seven pinned registers over
/// unrelated slots and leave the hash/probe loop's own state in memory. Here
/// the hot body touches only the hash word, the byte cursor and the probe
/// index, so those stay in callee-saved registers.
///
/// Correctness notes:
///   - A stored key of a non-string class aborts to the generic path instead of
///     being treated as unequal: only `keyEq` may decide cross-class equality
///     (e.g. a boxed int against a string), and restarting the probe is cheap
///     because such maps are not on the hot path.
///   - Strings longer than 8 bytes use the generic body's general hash rather
///     than duplicating it here.
///   - The tombstone/empty sentinels and the wrapping `u64` FNV arithmetic are
///     identical to `abiMapGetSlow`; `abi_map_test.pkl` pins them by comparing
///     the two implementations over the same tables.
#[symbol("pickle_map_get")]
fn abiMapGet(map: *int, key: *int) -> *int {
    unsafe {
        var k = key as int
        if (k == KEY_EMPTY) { k = KEY_NONE }
        var kp = k as *int
        if (k == KEY_NONE) {
            return abiMapGetSlow(map, key)
        }
        if (kp[1] != PICKLE_CLASS_STRING) {
            return abiMapGetSlow(map, key)
        }
        var sn = kp[LEN_WORD]
        if (sn > 8) {
            return abiMapGetSlow(map, key)
        }
        var h = 0
        var kflags = kp[SIZE_WORD]
        if ((kflags & FLAG_HASH) != 0) {
            h = kp[0]
        } else {
            h = FNV_OFFSET
            var v = kp[STR_BYTES_WORD]
            var n = 0
            while (n < sn) {
                h = (h ^ (v & 255)) * FNV_PRIME
                v = v >> 8
                n = n + 1
            }
            if ((kflags & FLAG_HEAP) != 0) {
                kp[0] = h
                kp[SIZE_WORD] = kflags | FLAG_HASH
            }
        }
        var cap = map[CAP_WORD]
        var mask = cap - 1
        var idx = h & mask
        var probes = 0
        var entries = map[ENTRIES_WORD] as *int
        var bb = (entries as int - BLOOM_BYTES) as *int
        var bit = h & 255
        var bloom = false
        if ((bb[bit >> 6] & (1 << (bit & 63))) != 0) {
            var bit2 = (h >> 8) & 255
            if ((bb[bit2 >> 6] & (1 << (bit2 & 63))) != 0) {
                bloom = true
            }
        }
        if (!bloom) { return 0 as *int }
        var firstTomb = -1
        while (probes < cap) {
            var slot = idx * 2
            var sk = entries[slot]
            if (sk == KEY_EMPTY) {
                // Miss: remember the slot the paired set would insert into
                // (first tombstone on the probe chain, else this empty slot).
                var tgt = slot
                if (firstTomb >= 0) { tgt = firstTomb }
                llVer = mapVer
                llMap = map as int
                llKey = k
                llSlot = tgt
                llHash = h
                return 0 as *int
            }
            if (sk != KEY_TOMBSTONE) {
                if (sk == k) {
                    llVer = mapVer
                    llMap = map as int
                    llKey = k
                    llSlot = slot
                    llHash = h
                    return entries[slot + 1] as *int
                }
                var skp = sk as *int
                if (skp[1] != PICKLE_CLASS_STRING) {
                    return abiMapGetSlow(map, key)
                }
                var ln = kp[LEN_WORD]
                if (ln == skp[LEN_WORD]) {
                    var nfull = ln >> 3
                    var q = 0
                    var eq = true
                    while (q < nfull) {
                        if (kp[STR_BYTES_WORD + q] != skp[STR_BYTES_WORD + q]) {
                            eq = false
                            break
                        }
                        q = q + 1
                    }
                    var nrem = ln & 7
                    if (eq && nrem != 0) {
                        var msk = (1 << (nrem * 8)) - 1
                        if ((kp[STR_BYTES_WORD + nfull] & msk) != (skp[STR_BYTES_WORD + nfull] & msk)) {
                            eq = false
                        }
                    }
                    if (eq) {
                        llVer = mapVer
                        llMap = map as int
                        llKey = k
                        llSlot = slot
                        llHash = h
                        return entries[slot + 1] as *int
                    }
                }
            } else {
                if (firstTomb < 0) { firstTomb = slot }
            }
            idx = (idx + 1) & mask
            probes = probes + 1
        }
        return 0 as *int
    }
}

/// Whether `key` is present. Mirrors `pickle_map_has`.
#[symbol("pickle_map_has")]
fn abiMapHas(map: *int, key: *int) -> bool {
    return (abiMapGet(map, key) as int) != KEY_EMPTY
}

/// Remove `key`; the removed value when present, else null -- exactly the `T?`
/// option representation. Mirrors `pickle_map_remove`.
#[symbol("pickle_map_remove")]
fn abiMapRemove(map: *int, key: *int) -> *int {
    return mapRemove(map, key)
}

/// Number of live entries. Mirrors `pickle_map_len`.
#[symbol("pickle_map_len")]
fn abiMapLen(map: *int) -> int {
    unsafe { return map[LEN_WORD] }
}

/// Remove every entry, keeping the allocated table.
///
/// BEYOND PARITY - the native runtime has no `pickle_map_clear`. Resetting every
/// entry word to `KEY_EMPTY` and zeroing the length preserves the existing
/// capacity, so a cleared map can be refilled without a rehash.
#[symbol("pickle_map_clear")]
fn abiMapClear(map: *int) {
    unsafe {
        mapVer = mapBump()
        var cap = map[CAP_WORD]
        var entries = map[ENTRIES_WORD] as *int
        var b = (entries as int - BLOOM_BYTES) as *int
        var j = 0
        while (j < BLOOM_WORDS) {
            b[j] = 0
            j = j + 1
        }
        var i = 0
        while (i < cap * 2) {
            entries[i] = KEY_EMPTY
            i = i + 1
        }
        map[LEN_WORD] = 0
        map[OCCUPIED_WORD] = 0
    }
}

/// All live keys as a fresh `List`. Mirrors `pickle_map_keys`.
#[symbol("pickle_map_keys")]
fn abiMapKeys(map: *int) -> *int {
    return mapSnapshot(map, true)
}

/// All live values as a fresh `List`. Mirrors `pickle_map_values`.
#[symbol("pickle_map_values")]
fn abiMapValues(map: *int) -> *int {
    return mapSnapshot(map, false)
}

/// All live entries as a fresh `List<(K, V)>` of two-field tuples.
///
/// BEYOND PARITY - `runtime/src/map.rs` has no entries; native code pairs the
/// `keys`/`values` snapshots. The walk is over the entry table directly, using
/// the same live-slot test `mapSnapshot`/`rehash` use, and each pair is a fresh
/// two-field tuple whose fields are the stored pointers - the snapshot is
/// shallow and unordered (entry-table order, which depends on hashing and
/// insertion history). A stored `none` key surfaces as the null pointer, the
/// representation the compiler's `T?` expects, exactly as `keys` does.
#[symbol("pickle_map_entries")]
fn abiMapEntries(map: *int) -> *int {
    unsafe {
        var l = abiListNew(0)
        var cap = map[CAP_WORD]
        var entries = map[ENTRIES_WORD] as *int
        var i = 0
        while (i < cap) {
            var k = entries[i * 2]
            if (isLiveKey(k)) {
                var pair = abiTupleNew(2)
                var key = k as *int
                if (k == KEY_NONE) {
                    key = 0 as *int
                }
                abiTupleSetField(pair, 0, key)
                abiTupleSetField(pair, 1, entries[i * 2 + 1] as *int)
                abiListPush(l, pair)
            }
            i = i + 1
        }
        return l
    }
}

/// Merge every live entry of `other` into `map`; `other` wins collisions.///
/// BEYOND PARITY - `runtime/src/map.rs` has no merge; native code spells it as a
/// loop of `insert`. The walk is over `other`'s entry table directly - the same
/// live-slot test `mapSnapshot`/`rehash` use - so no key list is allocated and
/// no second hash lookup is needed to fetch each value. Keys and values are
/// copied as pointers, so this is a shallow merge and `other` is left untouched.
/// Merging a map into itself is a no-op: every key already exists, so no entry
/// is added and no growth is triggered.
#[symbol("pickle_map_merge")]
fn abiMapMerge(map: *int, other: *int) {
    unsafe {
        var cap = other[CAP_WORD]
        var entries = other[ENTRIES_WORD] as *int
        var i = 0
        while (i < cap) {
            var k = entries[i * 2]
            if (isLiveKey(k)) {
                mapSet(map, k as *int, entries[i * 2 + 1] as *int)
            }
            i = i + 1
        }
    }
}
