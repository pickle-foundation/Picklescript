module runtime.abi_net

// TCP-first networking seam (v1, Windows/Winsock now; plat* split for future
// POSIX/Linux). High-level stdlib API lives in std.net; this module owns raw
// socket operations and handle/state management behind a portable ABI.
//
// Sockets are UINT_PTR (int) on x64. INVALID_SOCKET == -1. All pointers/sizes
// passed to win_* intrinsics are ints. Byte buffers are *int word arrays with
// raw-byte helpers for struct/IO marshalling.

import { abiRawAlloc } from runtime.abi_raw
import { worldAcquire, worldRelease } from runtime.abi_world

const AF_INET: int = 2
const SOCK_STREAM: int = 1
const SOCK_DGRAM: int = 2
const IPPROTO_TCP: int = 6
const IPPROTO_UDP: int = 17
const SOL_SOCKET: int = 65535
const SO_REUSEADDR: int = 4
const SO_KEEPALIVE: int = 8
const SO_BROADCAST: int = 32
const SO_RCVTIMEO: int = 4102  // 0x1006 (DWORD ms on Windows)
const SO_SNDTIMEO: int = 4101  // 0x1005 (DWORD ms on Windows)
const TCP_NODELAY: int = 1
const SD_RECEIVE: int = 0
const SD_SEND: int = 1
const SD_BOTH: int = 2
const SOMAXCONN: int = 128
const INVALID_SOCKET: int = -1
const SOCKET_ERROR: int = -1
const WSA_VERSION: int = 514 // 0x0202
const AI_PASSIVE: int = 1
const NI_NUMERICHOST: int = 2
const NI_NUMERICSERV: int = 8

var wsaReady: int = 0

fn rawByteAtBuf(p: *int, i: int) -> int {
    unsafe {
        return (p[i >> 3] >> ((i & 7) * 8)) & 255
    }
}

fn putRawByteBuf(buf: *int, b: int, v: int) {
    unsafe {
        let sh = (b & 7) * 8
        let mask = 255 << sh
        buf[b >> 3] = (buf[b >> 3] & ((0 - 1) ^ mask)) | ((v & 255) << sh)
    }
}

fn zeroBuf(buf: *int, words: int) {
    unsafe {
        var i = 0
        while (i < words) {
            buf[i] = 0
            i = i + 1
        }
    }
}

// Ensure Winsock is initialized. Returns 0 on success, else WSA error code.
fn netEnsureWsa() -> int {
    if (wsaReady == 1) {
        return 0
    }
    unsafe {
        let wsa = alloc(int, 64) // >= sizeof(WSADATA) on x64
        zeroBuf(wsa, 64)
        let rc = win_wsa_startup(WSA_VERSION, wsa as int)
        free(wsa)
        if (rc == 0) {
            wsaReady = 1
        }
        return rc
    }
}

fn platSocketTcp() -> int {
    let _rc = netEnsureWsa()
    return win_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP)
}

fn platSocketUdp() -> int {
    let _rc = netEnsureWsa()
    return win_socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)
}

fn platClose(s: int) -> int {
    if (s == INVALID_SOCKET || s == 0) {
        return 0
    }
    return win_closesocket(s)
}

fn platShutdown(s: int, how: int) -> int {
    return win_shutdown(s, how)
}

// Build IPv4 sockaddr_in (16 bytes) in buf for numeric dotted host + port.
fn fillSockaddrIn4(buf: *int, a: int, b: int, c: int, d: int, port: int) {
    unsafe {
        zeroBuf(buf, 2)
        // sin_family AF_INET (u16 LE)
        putRawByteBuf(buf, 0, AF_INET & 255)
        putRawByteBuf(buf, 1, 0)
        // sin_port network byte order (big-endian)
        putRawByteBuf(buf, 2, (port >> 8) & 255)
        putRawByteBuf(buf, 3, port & 255)
        // sin_addr
        putRawByteBuf(buf, 4, a & 255)
        putRawByteBuf(buf, 5, b & 255)
        putRawByteBuf(buf, 6, c & 255)
        putRawByteBuf(buf, 7, d & 255)
    }
}

fn platBind4(s: int, a: int, b: int, c: int, d: int, port: int) -> int {
    unsafe {
        let sa = alloc(int, 2)
        fillSockaddrIn4(sa, a, b, c, d, port)
        let rc = win_bind(s, sa as int, 16)
        free(sa)
        return rc
    }
}

fn platListen(s: int, backlog: int) -> int {
    return win_listen(s, backlog)
}

/// Every blocking socket call releases the world lock around the OS call. The
/// peer endpoint may be another Pickle thread in this process (the loopback
/// handshake tests), and it cannot make progress while the caller holds the
/// only world lock. The buffer(s) stay valid because they are either raw
/// `alloc` blocks or reachable from the caller's shadow frame, and the
/// collector's mark walks every registered thread's frame chain.
fn platAccept(s: int) -> int {
    unsafe {
        let sa = alloc(int, 16) // room for storage + len
        zeroBuf(sa, 16)
        let lenp = alloc(int, 1)
        lenp[0] = 16
        worldRelease()
        let client = win_accept(s, sa as int, lenp as int)
        worldAcquire()
        free(lenp)
        free(sa)
        return client
    }
}

fn platConnect4(s: int, a: int, b: int, c: int, d: int, port: int) -> int {
    unsafe {
        let sa = alloc(int, 2)
        fillSockaddrIn4(sa, a, b, c, d, port)
        worldRelease()
        let rc = win_connect(s, sa as int, 16)
        worldAcquire()
        free(sa)
        return rc
    }
}

fn platSend(s: int, buf: *int, n: int) -> int {
    worldRelease()
    let rc = win_send(s, buf as int, n, 0)
    worldAcquire()
    return rc
}

fn platRecv(s: int, buf: *int, n: int) -> int {
    worldRelease()
    let rc = win_recv(s, buf as int, n, 0)
    worldAcquire()
    return rc
}

fn platSetsockoptInt(s: int, level: int, opt: int, val: int) -> int {
    unsafe {
        let p = alloc(int, 1)
        p[0] = val
        let rc = win_setsockopt(s, level, opt, p as int, 4)
        free(p)
        return rc
    }
}

fn platSetsockoptReuseAddr(s: int, on: int) -> int {
    return platSetsockoptInt(s, SOL_SOCKET, SO_REUSEADDR, on)
}

fn platSetNoDelay(s: int, on: int) -> int {
    return platSetsockoptInt(s, IPPROTO_TCP, TCP_NODELAY, on)
}

fn platSetKeepAlive(s: int, on: int) -> int {
    return platSetsockoptInt(s, SOL_SOCKET, SO_KEEPALIVE, on)
}

fn platSetBroadcast(s: int, on: int) -> int {
    return platSetsockoptInt(s, SOL_SOCKET, SO_BROADCAST, on)
}

fn platSetRecvTimeoutMs(s: int, ms: int) -> int {
    // Windows expects DWORD milliseconds for SO_RCVTIMEO/SO_SNDTIMEO.
    var v = ms
    if (v < 0) { v = 0 }
    return platSetsockoptInt(s, SOL_SOCKET, SO_RCVTIMEO, v)
}

fn platSetSendTimeoutMs(s: int, ms: int) -> int {
    var v = ms
    if (v < 0) { v = 0 }
    return platSetsockoptInt(s, SOL_SOCKET, SO_SNDTIMEO, v)
}

// Fill meta[0..4]=a,b,c,d,port from sockaddr_in at sa. Returns 0 on success.
fn readSockaddrIn4(sa: *int, meta: *int) -> int {
    unsafe {
        meta[0] = rawByteAtBuf(sa, 4)
        meta[1] = rawByteAtBuf(sa, 5)
        meta[2] = rawByteAtBuf(sa, 6)
        meta[3] = rawByteAtBuf(sa, 7)
        let p0 = rawByteAtBuf(sa, 2)
        let p1 = rawByteAtBuf(sa, 3)
        meta[4] = p0 * 256 + p1
        return 0
    }
}

// Return local port for an IPv4 socket, or -1 on error.
fn platLocalPort4(s: int) -> int {
    unsafe {
        let sa = alloc(int, 4)
        zeroBuf(sa, 4)
        let lenp = alloc(int, 1)
        lenp[0] = 16
        let rc = win_getsockname(s, sa as int, lenp as int)
        if (rc != 0) {
            free(lenp)
            free(sa)
            return -1
        }
        let p0 = rawByteAtBuf(sa, 2)
        let p1 = rawByteAtBuf(sa, 3)
        free(lenp)
        free(sa)
        // network byte order to host
        return p0 * 256 + p1
    }
}

fn platPeerPort4(s: int) -> int {
    unsafe {
        let sa = alloc(int, 4)
        zeroBuf(sa, 4)
        let lenp = alloc(int, 1)
        lenp[0] = 16
        let rc = win_getpeername(s, sa as int, lenp as int)
        if (rc != 0) {
            free(lenp)
            free(sa)
            return -1
        }
        let p0 = rawByteAtBuf(sa, 2)
        let p1 = rawByteAtBuf(sa, 3)
        free(lenp)
        free(sa)
        return p0 * 256 + p1
    }
}

// Write local IPv4 endpoint into meta[0..4]=a,b,c,d,port. Returns 0 or -1.
fn platLocalAddr4(s: int, meta: *int) -> int {
    unsafe {
        let sa = alloc(int, 4)
        zeroBuf(sa, 4)
        let lenp = alloc(int, 1)
        lenp[0] = 16
        let rc = win_getsockname(s, sa as int, lenp as int)
        if (rc != 0) {
            free(lenp)
            free(sa)
            return -1
        }
        let _ = readSockaddrIn4(sa, meta)
        free(lenp)
        free(sa)
        return 0
    }
}

// Write peer IPv4 endpoint into meta[0..4]=a,b,c,d,port. Returns 0 or -1.
fn platPeerAddr4(s: int, meta: *int) -> int {
    unsafe {
        let sa = alloc(int, 4)
        zeroBuf(sa, 4)
        let lenp = alloc(int, 1)
        lenp[0] = 16
        let rc = win_getpeername(s, sa as int, lenp as int)
        if (rc != 0) {
            free(lenp)
            free(sa)
            return -1
        }
        let _ = readSockaddrIn4(sa, meta)
        free(lenp)
        free(sa)
        return 0
    }
}

fn platSendTo4(s: int, buf: *int, n: int, a: int, b: int, c: int, d: int, port: int) -> int {
    unsafe {
        let sa = alloc(int, 2)
        fillSockaddrIn4(sa, a, b, c, d, port)
        worldRelease()
        let rc = win_sendto(s, buf as int, n, 0, sa as int, 16)
        worldAcquire()
        free(sa)
        return rc
    }
}

// Receive a UDP datagram. On success returns bytes received and writes
// meta[0..4] = source a,b,c,d,port (host order). Returns -1 on error.
fn platRecvFrom4(s: int, buf: *int, n: int, meta: *int) -> int {
    unsafe {
        let sa = alloc(int, 4)
        zeroBuf(sa, 4)
        let lenp = alloc(int, 1)
        lenp[0] = 16
        worldRelease()
        let rc = win_recvfrom(s, buf as int, n, 0, sa as int, lenp as int)
        worldAcquire()
        if (rc >= 0) {
            let a = rawByteAtBuf(sa, 4)
            let b = rawByteAtBuf(sa, 5)
            let c = rawByteAtBuf(sa, 6)
            let d = rawByteAtBuf(sa, 7)
            let p0 = rawByteAtBuf(sa, 2)
            let p1 = rawByteAtBuf(sa, 3)
            meta[0] = a
            meta[1] = b
            meta[2] = c
            meta[3] = d
            meta[4] = p0 * 256 + p1
        }
        free(lenp)
        free(sa)
        return rc
    }
}

fn netLastError() -> int {
    return win_wsa_get_last_error()
}

fn platUdpConnect4(s: int, a: int, b: int, c: int, d: int, port: int) -> int {
    return platConnect4(s, a, b, c, d, port)
}

// Resolve an IPv4 host string (numeric or "localhost") into the first address.
// Writes meta[0..3]=a,b,c,d and returns 0, or -1 if not a deterministic local
// numeric/localhost form. OS DNS for arbitrary hostnames is exposed separately.
fn platResolveLocal4(meta: *int, host: *int, hostLen: int) -> int {
    unsafe {
        // "localhost" (9 chars)
        if (hostLen == 9) {
            let l0 = rawByteAtBuf(host, 0)
            let l1 = rawByteAtBuf(host, 1)
            let l2 = rawByteAtBuf(host, 2)
            let l3 = rawByteAtBuf(host, 3)
            let l4 = rawByteAtBuf(host, 4)
            let l5 = rawByteAtBuf(host, 5)
            let l6 = rawByteAtBuf(host, 6)
            let l7 = rawByteAtBuf(host, 7)
            let l8 = rawByteAtBuf(host, 8)
            if (l0 == 108 && l1 == 111 && l2 == 99 && l3 == 97 && l4 == 108 && l5 == 104 && l6 == 111 && l7 == 115 && l8 == 116) {
                meta[0] = 127
                meta[1] = 0
                meta[2] = 0
                meta[3] = 1
                return 0
            }
        }
        // numeric dotted quad
        var oct = 0
        var digits = 0
        var val = 0
        var a = -1
        var b = -1
        var c = -1
        var d = -1
        var i = 0
        while (i < hostLen) {
            let ch = rawByteAtBuf(host, i)
            if (ch == 46) {
                if (digits == 0 || oct >= 3) { return -1 }
                if (oct == 0) { a = val }
                if (oct == 1) { b = val }
                if (oct == 2) { c = val }
                oct = oct + 1
                digits = 0
                val = 0
            } else {
                if (ch < 48 || ch > 57) { return -1 }
                if (digits >= 3) { return -1 }
                val = val * 10 + (ch - 48)
                if (val > 255) { return -1 }
                digits = digits + 1
            }
            i = i + 1
        }
        if (oct != 3 || digits == 0) { return -1 }
        d = val
        if (a < 0 || b < 0 || c < 0) { return -1 }
        meta[0] = a
        meta[1] = b
        meta[2] = c
        meta[3] = d
        return 0
    }
}

// --- portable ABI surface (v2) ---

#[symbol("pickle_net_tcp_socket")]
fn net_tcp_socket() -> int {
    return platSocketTcp()
}

#[symbol("pickle_net_close")]
fn net_close(s: int) -> int {
    return platClose(s)
}

#[symbol("pickle_net_shutdown")]
fn net_shutdown(s: int, how: int) -> int {
    return platShutdown(s, how)
}

#[symbol("pickle_net_bind4")]
fn net_bind4(s: int, a: int, b: int, c: int, d: int, port: int) -> int {
    return platBind4(s, a, b, c, d, port)
}

#[symbol("pickle_net_listen")]
fn net_listen(s: int, backlog: int) -> int {
    return platListen(s, backlog)
}

#[symbol("pickle_net_accept")]
fn net_accept(s: int) -> int {
    return platAccept(s)
}

#[symbol("pickle_net_connect4")]
fn net_connect4(s: int, a: int, b: int, c: int, d: int, port: int) -> int {
    return platConnect4(s, a, b, c, d, port)
}

#[symbol("pickle_net_send")]
fn net_send(s: int, buf: int, n: int) -> int {
    unsafe {
        return platSend(s, buf as *int, n)
    }
}

#[symbol("pickle_net_recv")]
fn net_recv(s: int, buf: int, n: int) -> int {
    unsafe {
        return platRecv(s, buf as *int, n)
    }
}

#[symbol("pickle_net_local_port4")]
fn net_local_port4(s: int) -> int {
    return platLocalPort4(s)
}

#[symbol("pickle_net_peer_port4")]
fn net_peer_port4(s: int) -> int {
    return platPeerPort4(s)
}

#[symbol("pickle_net_set_reuseaddr")]
fn net_set_reuseaddr(s: int, on: int) -> int {
    return platSetsockoptReuseAddr(s, on)
}

#[symbol("pickle_net_last_error")]
fn net_last_error() -> int {
    return netLastError()
}

#[symbol("pickle_net_udp_socket")]
fn net_udp_socket() -> int {
    return platSocketUdp()
}

#[symbol("pickle_net_sendto4")]
fn net_sendto4(s: int, buf: int, n: int, a: int, b: int, c: int, d: int, port: int) -> int {
    unsafe {
        return platSendTo4(s, buf as *int, n, a, b, c, d, port)
    }
}

#[symbol("pickle_net_recvfrom4")]
fn net_recvfrom4(s: int, buf: int, n: int, meta: int) -> int {
    unsafe {
        return platRecvFrom4(s, buf as *int, n, meta as *int)
    }
}

#[symbol("pickle_net_udp_connect4")]
fn net_udp_connect4(s: int, a: int, b: int, c: int, d: int, port: int) -> int {
    return platUdpConnect4(s, a, b, c, d, port)
}

#[symbol("pickle_net_local_addr4")]
fn net_local_addr4(s: int, meta: int) -> int {
    unsafe {
        return platLocalAddr4(s, meta as *int)
    }
}

#[symbol("pickle_net_peer_addr4")]
fn net_peer_addr4(s: int, meta: int) -> int {
    unsafe {
        return platPeerAddr4(s, meta as *int)
    }
}

#[symbol("pickle_net_set_nodelay")]
fn net_set_nodelay(s: int, on: int) -> int {
    return platSetNoDelay(s, on)
}

#[symbol("pickle_net_set_keepalive")]
fn net_set_keepalive(s: int, on: int) -> int {
    return platSetKeepAlive(s, on)
}

#[symbol("pickle_net_set_broadcast")]
fn net_set_broadcast(s: int, on: int) -> int {
