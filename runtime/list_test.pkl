module runtime.list_test

import { rangeSeq, insertionSort, MSG_REMOVE_OOB, MSG_INSERT_OOB, MSG_CAP_OVERFLOW, INITIAL_CAP } from runtime.list

test fn range_sequence_forward() {
    var r = rangeSeq(0, 5, 1)
    expect(len(r)).toBe(5)
    expect(r[0]).toBe(0)
    expect(r[4]).toBe(4)
    var s = rangeSeq(0, 5, 2)
    expect(len(s)).toBe(3)
    expect(s[0]).toBe(0)
    expect(s[2]).toBe(4)
}

test fn range_sequence_negative_step() {
    var r = rangeSeq(10, 0, -2)
    expect(len(r)).toBe(5)
    expect(r[0]).toBe(10)
    expect(r[4]).toBe(2)
}

test fn range_sequence_bounds_are_begin_inclusive_end_exclusive() {
    var r = rangeSeq(5, 5, 1)
    expect(len(r)).toBe(0)
    var s = rangeSeq(-3, 3, 3)
    expect(len(s)).toBe(2)
    expect(s[0]).toBe(-3)
    expect(s[1]).toBe(0)
}

test fn range_sequence_zero_step_is_empty() {
    expect(len(rangeSeq(0, 5, 0))).toBe(0)
    expect(len(rangeSeq(5, 0, 0))).toBe(0)
}

test fn ascending_sort() {
    var a = [3, 1, 2, 1]
    var lt = (x: int, y: int) => x < y
    insertionSort(a, lt)
    expect(a[0]).toBe(1)
    expect(a[1]).toBe(1)
    expect(a[2]).toBe(2)
    expect(a[3]).toBe(3)
}

test fn sort_empty_and_single_elements() {
    var e = [0]
    e.pop()
    var lt = (x: int, y: int) => x < y
    insertionSort(e, lt)
    expect(len(e)).toBe(0)
    var one = [7]
    insertionSort(one, lt)
    expect(one[0]).toBe(7)
}

test fn sort_is_stable_for_equal_keys() {
    var a = [15, 5, 12, 8]
    var lt = (x: int, y: int) => x >= 10 && y < 10
    insertionSort(a, lt)
    expect(a[0]).toBe(15)
    expect(a[1]).toBe(12)
    expect(a[2]).toBe(5)
    expect(a[3]).toBe(8)
}

test fn message_constants() {
    expect(MSG_REMOVE_OOB).toBe("pickle: remove index out of bounds")
    expect(MSG_INSERT_OOB).toBe("pickle: insert index out of bounds")
    expect(MSG_CAP_OVERFLOW).toBe("pickle: list capacity overflow")
    expect(INITIAL_CAP).toBe(8)
}