module runtime.abi_string

import { abiBoxI64, abiUnboxI64 } from runtime.abi_box
import { abiListNew, abiListLen, abiListGet, abiListPush } from runtime.abi_list
// String payloads come from `alloc(int, n)`, whose symbol lives in `abi_raw.pkl`.
//
// NO REGISTRATION. These bodies deliberately do NOT register their blocks in the
// sweepability registry (nor, therefore, in the allocation/collection seam the
// registry feeds). The blocks are raw allocations the collector does not track,
// which is exactly why the KNOWN LIMITATION note below says they are never
// reclaimed - putting them in a *sweepability* registry would misstate that and
// risk the collector freeing a live payload. It would also break parity with the
// reference: native `pickle_str_*` ops run through `Gc::alloc` without touching
// the ported registry, so a string built by `str(...)`, `+`, or an `expect`
// message moves neither the registered count/bytes nor the seam counters, and
// the ABI suites pin that. Keeping `newStr` out of the registry matches native.

/// Sovereign `string` ABI bodies, ported from `runtime/src/strings.rs`.
///
/// These are the first runtime functions written IN PICKLE that occupy real C
/// ABI slots. `#[symbol]` (added to both compilers) makes the exact export name
/// writable from Pickle, so emitted code calling `pickle_str_concat` reaches
/// this module instead of the Rust runtime.
///
/// Verified: importing this module and running under both the JIT and the
/// ported AOT driver produces correct output for concatenation, `i64`
/// formatting (including negatives and zero), byte length, and string pattern
/// matching (which lowers to `pickle_str_cmp`).
///
/// Layout is the authority in `runtime.layout` and mirrors `runtime/src/layout.rs`:
/// 24-byte header (`next`, `class_id`/`flags`, `size`), then `len` at word 3
/// (`STR_LEN_OFF / 8`), then UTF-8 bytes from word 4 (`STR_BYTES_OFF / 8`).
///
/// TRAP 1 - `alloc(T, n)` does NOT zero memory, and payload bytes are written
/// with `|=` for byte-granularity. Every payload word must be zeroed first or
/// the string carries uninitialized bits past its length. This presents as a
/// wrong *value* (garbage characters), not a crash, so it is easy to misread as
/// a logic bug.
///
/// TRAP 2 - never call `println` (or anything that concatenates) from inside an
/// ABI body. `println` lowers to `pickle_str_concat`, so the body re-enters
/// itself and recurses until the stack is exhausted. Print from the caller.
///
/// TRAP 3 - `byteAt` reads a string OBJECT payload; `rawByteAt` reads a bare
/// address such as a `pkl_strdata_*` literal blob. They differ by 32 bytes and
/// are easy to confuse. `pickle_str_from_bytes` is the literal-materialisation
/// path for `IrConst.Str` (x64 lowers a string constant to a
/// `pickle_str_from_bytes` call), so it must use `rawByteAt`; using `byteAt`
/// there silently corrupts every string literal in the program.
///
/// GAP - Rust treats a null string as empty in `str_len` and `string_concat`,
/// but Pickle has no null pointer literal and `Option` is not generic over
/// `*T`, so those defensive branches are not expressible in source yet. These
/// bodies assume a non-null operand, which is what the compiler emits for a
/// `string`-typed value. A future null-pointer primitive should restore the
/// branches verbatim rather than leave the omission.
///
/// KNOWN LIMITATION - these strings come from `pickle_raw_alloc`, which the GC
/// does not track. They are correct and safe, but never reclaimed, so a
/// long-running program leaks every string it builds. Verified benign: 20k
/// ported strings plus a forced `gcCollect` completes with the collector still
/// working and its collection count advancing. Making them collectable needs a
/// managed allocator that registers with the GC - the next tranche, not a
/// correctness question for this one.

const HEADER_WORDS: int = 3
const LEN_WORD: int = 3
const BYTES_WORD: int = 4

fn wordsFor(n: int) -> int {
    return HEADER_WORDS + 1 + (n + 7) / 8
}

/// Allocate a `string` object of `n` bytes. Header words are set; payload words
/// are zeroed so `byteInto`'s `|=` is well-defined.
fn newStr(n: int) -> *int {
    unsafe {
        var words = wordsFor(n)
        if (words < HEADER_WORDS + 1) {
            words = HEADER_WORDS + 1
        }
        var p = alloc(int, words)
        p[0] = 0
        p[1] = 0
        p[2] = words * 8
        p[3] = n
        var w = BYTES_WORD
        while (w < words) {
            p[w] = 0
            w = w + 1
        }
        return p
    }
}

/// Allocate a `string` object WITHOUT recording it in the sweepability
/// registry. This is the layout of a native *static* descriptor name: native
/// keeps the ten builtin class names as `&'static` bytes on a Rust descriptor
/// (never `Gc::alloc`), so seeding them must not move the managed-object or
/// GC counters. Same header/length/payload layout as `newStr`, so `byteInto`,
/// `byteAt` and `STR_BYTES_OFF` all still apply; the block is never reclaimed.
fn newStrUnmanaged(n: int) -> *int {
    unsafe {
        var words = wordsFor(n)
        if (words < HEADER_WORDS + 1) {
            words = HEADER_WORDS + 1
        }
        var p = alloc(int, words)
        p[0] = 0
        p[1] = 0
        p[2] = words * 8
        p[3] = n
        var w = BYTES_WORD
        while (w < words) {
            p[w] = 0
            w = w + 1
        }
        return p
    }
}

/// Read byte `i` of a `string` OBJECT's inline payload.
fn byteAt(s: *int, i: int) -> int {
    unsafe {
        return (s[BYTES_WORD + (i >> 3)] >> ((i & 7) * 8)) & 255
    }
}

/// Read byte `i` of a RAW byte address - a `pkl_strdata_*` literal blob with no
/// header and no length word. See TRAP 3 above.
fn rawByteAt(p: *int, i: int) -> int {
    unsafe {
        return (p[i >> 3] >> ((i & 7) * 8)) & 255
    }
}

/// OR a byte into position `i`. ONLY valid on a zeroed payload: it cannot clear
/// bits, so writing 0 over a non-zero byte is a no-op. See `byteOverwrite`.
fn byteInto(s: *int, i: int, b: int) -> int {
    unsafe {
        var w = BYTES_WORD + (i >> 3)
        s[w] = s[w] | (b << ((i & 7) * 8))
        return 0
    }
}

/// ASSIGN a byte at position `i`, clearing whatever was there.
///
/// The mask is built from 255 shifted left by the same sub-word offset, so the
/// clear covers exactly the addressed byte and leaves its 7 neighbours in the
/// word alone. This is what `pickle_str_set` needs: it copies the source
/// payload and then overwrites one byte, which `byteInto` cannot express - ORing
/// 65 over an existing 63 yields 127, not 65.
fn byteOverwrite(s: *int, i: int, b: int) -> int {
    unsafe {
        var w = BYTES_WORD + (i >> 3)
        var shift = (i & 7) * 8
        var mask = (255 << shift) & 0 - 1
        s[w] = (s[w] & (mask ^ (0 - 1))) | (b << shift)
        return 0
    }
}

/// Length in bytes of a `string`. Mirrors `layout.rs::str_len`, which reads the
/// `STR_LEN_OFF` word.
#[symbol("pickle_str_len")]
fn abiStrLen(s: *int) -> int {
    unsafe {
        return s[LEN_WORD]
    }
}

/// Copy `n` bytes from a raw byte address into a fresh `string`.
/// Mirrors `strings.rs::string_from_bytes`.
#[symbol("pickle_str_from_bytes")]
fn abiStrFromBytes(ptr: *int, n: int) -> *int {
    unsafe {
        if (n < 1) {
            return newStr(0)
        }
        var p = newStr(n)
        var i = 0
        while (i < n) {
            byteInto(p, i, rawByteAt(ptr, i))
            i = i + 1
        }
        return p
    }
}

/// Concatenate two `string`s into a fresh third. Mirrors
/// `strings.rs::string_concat`.
#[symbol("pickle_str_concat")]
fn abiStrConcat(a: *int, b: *int) -> *int {
    unsafe {
        var la = a[LEN_WORD]
        var lb = b[LEN_WORD]
        var p = newStr(la + lb)
        var i = 0
        while (i < la) {
            byteInto(p, i, byteAt(a, i))
            i = i + 1
        }
        var j = 0
        while (j < lb) {
            byteInto(p, la + j, byteAt(b, j))
            j = j + 1
        }
        return p
    }
}

/// Whether `s` begins with `prefix`, byte-for-byte.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no prefix/suffix predicate, so
/// this symbol exists only in the port. The comparison is over raw UTF-8 bytes,
/// which is the same equality the `contains` scan and `pickle_str_cmp` use; a
/// multi-byte prefix therefore matches only on a code-point boundary, exactly
/// like it would in Rust's `str::starts_with`. An empty prefix matches every
/// string (the empty run occurs at offset 0), and a prefix longer than `s`
/// cannot match.
#[symbol("pickle_str_starts_with")]
fn abiStrStartsWith(s: *int, prefix: *int) -> bool {
    var sn = abiStrLen(s)
    var pn = abiStrLen(prefix)
    if (pn > sn) {
        return false
    }
    var i = 0
    while (i < pn) {
        if (byteAt(s, i) != byteAt(prefix, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

/// Whether `s` ends with `suffix`, byte-for-byte. The mirror of
/// `abiStrStartsWith`, aligned at `len(s) - len(suffix)`.
///
/// BEYOND PARITY - see `abiStrStartsWith`. An empty suffix matches every
/// string, and a suffix longer than `s` cannot match.
#[symbol("pickle_str_ends_with")]
fn abiStrEndsWith(s: *int, suffix: *int) -> bool {
    var sn = abiStrLen(s)
    var xn = abiStrLen(suffix)
    if (xn > sn) {
        return false
    }
    var off = sn - xn
    var i = 0
    while (i < xn) {
        if (byteAt(s, off + i) != byteAt(suffix, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

/// `s` with `prefix` removed, or the null pointer when `s` does not start with
/// it.
///
/// BEYOND PARITY, mirroring Rust's `str::strip_prefix`: an empty prefix matches
/// and yields a fresh copy of `s`, a longer prefix cannot match, and a match
/// yields the remainder as a fresh string. The result is the compiler's
/// `string?` representation (a nullable managed pointer).
#[symbol("pickle_str_strip_prefix")]
fn abiStrStripPrefix(s: *int, prefix: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var p = abiStrLen(prefix)
        if (p > n) {
            return 0 as *int
        }
        var i = 0
        while (i < p) {
            if (byteAt(s, i) != byteAt(prefix, i)) {
                return 0 as *int
            }
            i = i + 1
        }
        return abiStrSubstring(s, p, n)
    }
}

/// `s` with `suffix` removed, or the null pointer when `s` does not end with
/// it. The trailing mirror of `abiStrStripPrefix` and Rust's
/// `str::strip_suffix`.
#[symbol("pickle_str_strip_suffix")]
fn abiStrStripSuffix(s: *int, suffix: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var m = abiStrLen(suffix)
        if (m > n) {
            return 0 as *int
        }
        var start = n - m
        var i = 0
        while (i < m) {
            if (byteAt(s, start + i) != byteAt(suffix, i)) {
                return 0 as *int
            }
            i = i + 1
        }
        return abiStrSubstring(s, 0, start)
    }
}

/// Whether the bytes of `needle` occur as a contiguous run starting at `off`.
/// The scan primitive `abiStrIndexOf` builds on.
fn strMatchAt(hay: *int, off: int, needle: *int, nn: int) -> bool {
    var j = 0
    while (j < nn) {
        if (byteAt(hay, off + j) != byteAt(needle, j)) {
            return false
        }
        j = j + 1
    }
    return true
}

/// Byte offset of the first occurrence of `needle` in `s`, boxed, or the null
/// pointer when absent.
///
/// BEYOND PARITY - `runtime/src/strings.rs` only exposes `pickle_str_contains`,
/// so this symbol exists only in the port. The scan is the same raw UTF-8 byte
/// run `contains` uses, so a multi-byte needle matches only on a code-point
/// boundary. An empty needle is found at offset 0. The boxed `int` result is the
/// compiler's `int?` representation (`pickle_box_i64`/`pickle_unbox_i64`), so
/// `s.indexOf(sub)` lowers with no extra wrapping.
#[symbol("pickle_str_index_of")]
fn abiStrIndexOf(s: *int, needle: *int) -> *int {
    var sn = abiStrLen(s)
    var nn = abiStrLen(needle)
    if (nn > sn) {
        return 0 as *int
    }
    var last = sn - nn
    var i = 0
    while (i <= last) {
        if (strMatchAt(s, i, needle, nn)) {
            return abiBoxI64(i)
        }
        i = i + 1
    }
    return 0 as *int
}

/// Last byte offset of `needle` in `s`, or the null pointer when absent.
///
/// BEYOND PARITY. Same raw UTF-8 byte match as `pickle_str_index_of`, but the
/// scan runs right to left from `len(s) - len(needle)`, so overlapping matches
/// still report the last starting offset. An empty needle is found at
/// `len(s)`, matching the empty-needle rule of `indexOf` at offset 0.
#[symbol("pickle_str_last_index_of")]
fn abiStrLastIndexOf(s: *int, needle: *int) -> *int {
    var sn = abiStrLen(s)
    var nn = abiStrLen(needle)
    if (nn > sn) {
        return 0 as *int
    }
    var i = sn - nn
    while (i >= 0) {
        if (strMatchAt(s, i, needle, nn)) {
            return abiBoxI64(i)
        }
        i = i - 1
    }
    return 0 as *int
}

/// Count non-overlapping occurrences of `needle` in `s`.
///
/// BEYOND PARITY. The scan advances by the needle length after a match, so
/// `"aaa".count("aa")` is 1, the same non-overlap rule `replace` uses. An empty
/// needle counts 0 - it has no width to advance the scan.
#[symbol("pickle_str_count")]
fn abiStrCount(s: *int, needle: *int) -> int {
    var sn = abiStrLen(s)
    var nn = abiStrLen(needle)
    if (nn < 1 || nn > sn) {
        return 0
    }
    var n = 0
    var i = 0
    var last = sn - nn
    while (i <= last) {
        if (strMatchAt(s, i, needle, nn)) {
            n = n + 1
            i = i + nn
        } else {
            i = i + 1
        }
    }
    return n
}

/// Copy `s` without leading/trailing ASCII whitespace (space, tab, LF, CR).
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no trim. The whitespace set is
/// the one `compiler.front`'s `stringTrim` helper already uses, so the language
/// member and the compiler's own source tooling agree. The scan is over raw
/// UTF-8 bytes and stops at the first non-whitespace byte, so a multi-byte
/// scalar is never split: only the four single-byte ASCII whitespace bytes are
/// stripped. A string with nothing to strip is returned unchanged.
#[symbol("pickle_str_trim")]
fn abiStrTrim(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var start = 0
        while (start < n) {
            var c = byteAt(s, start)
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                start = start + 1
            } else {
                break
            }
        }
        var end = n
        while (end > start) {
            var c = byteAt(s, end - 1)
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                end = end - 1
            } else {
                break
            }
        }
        if (start == 0 && end == n) {
            return s
        }
        var out = newStr(end - start)
        var i = start
        while (i < end) {
            byteInto(out, i - start, byteAt(s, i))
            i = i + 1
        }
        return out
    }
}

/// Copy `s` with leading ASCII whitespace removed.
///
/// BEYOND PARITY - the leading half of `abiStrTrim`. Only the four single-byte
/// ASCII whitespace bytes (space, tab, LF, CR) are stripped, so a multi-byte
/// scalar is never split. A string with nothing to strip is returned unchanged.
#[symbol("pickle_str_trim_start")]
fn abiStrTrimStart(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var start = 0
        while (start < n) {
            var c = byteAt(s, start)
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                start = start + 1
            } else {
                break
            }
        }
        if (start == 0) {
            return s
        }
        var out = newStr(n - start)
        var i = start
        while (i < n) {
            byteInto(out, i - start, byteAt(s, i))
            i = i + 1
        }
        return out
    }
}

/// Copy `s` with trailing ASCII whitespace removed. The trailing half of
/// `abiStrTrim`, with the same byte-oriented rule and unchanged fast path.
#[symbol("pickle_str_trim_end")]
fn abiStrTrimEnd(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var end = n
        while (end > 0) {
            var c = byteAt(s, end - 1)
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                end = end - 1
            } else {
                break
            }
        }
        if (end == n) {
            return s
        }
        var out = newStr(end)
        var i = 0
        while (i < end) {
            byteInto(out, i, byteAt(s, i))
            i = i + 1
        }
        return out
    }
}

/// Split `s` into lines at `\n`, treating `\r\n` as one line ending.
///
/// BEYOND PARITY, with the semantics of Rust's `str::lines`: the final line
/// ending is optional, so a trailing `\n` does not add an empty final line, and
/// an empty string yields an empty list. A `\r` is dropped only when it directly
/// precedes the `\n` that ends a line, so a lone trailing `\r` is preserved.
#[symbol("pickle_str_split_lines")]
fn abiStrSplitLines(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var out = abiListNew(0)
        if (n == 0) {
            return out
        }
        var start = 0
        var i = 0
        while (i < n) {
            if (byteAt(s, i) == 10) {
                var end = i
                if (end > start && byteAt(s, end - 1) == 13) {
                    end = end - 1
                }
                abiListPush(out, abiStrSubstring(s, start, end))
                start = i + 1
            }
            i = i + 1
        }
        if (start < n) {
            abiListPush(out, abiStrSubstring(s, start, n))
        }
        return out
    }
}

/// Whether `c` is one of the four ASCII whitespace bytes `trim` strips:
/// space, tab, line feed, carriage return.
fn isAsciiSpace(c: int) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

/// Split `s` into fields at runs of ASCII whitespace.
///
/// BEYOND PARITY. The shape is Rust's `str::split_whitespace`, but the
/// whitespace set is the same four ASCII bytes `trim` strips (space, `\t`,
/// `\n`, `\r`): every maximal run is one separator, so leading, trailing, and
/// repeated whitespace contribute no empty fields. An empty or all-whitespace
/// string yields an empty list.
#[symbol("pickle_str_split_whitespace")]
fn abiStrSplitWhitespace(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var out = abiListNew(0)
        var i = 0
        while (i < n) {
            while (i < n && isAsciiSpace(byteAt(s, i))) {
                i = i + 1
            }
            if (i >= n) {
                break
            }
            var start = i
            while (i < n && !isAsciiSpace(byteAt(s, i))) {
                i = i + 1
            }
            abiListPush(out, abiStrSubstring(s, start, i))
        }
        return out
    }
}

/// Copy `s` with ASCII lower-case letters (`a`-`z`) upper-cased.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no case mapping. Full Unicode
/// case mapping needs tables, so the scope is deliberately ASCII: `a`-`z` lose
/// 32, and every other byte - including all bytes >= 0x80, so every UTF-8
/// continuation/lead byte - is copied unchanged. A multi-byte scalar is
/// therefore never split or corrupted. Always returns a fresh string, so
/// mutating the result cannot affect the receiver.
#[symbol("pickle_str_to_upper")]
fn abiStrToUpper(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var out = newStr(n)
        var i = 0
        while (i < n) {
            var c = byteAt(s, i)
            if (c >= 97 && c <= 122) {
                byteInto(out, i, c - 32)
            } else {
                byteInto(out, i, c)
            }
            i = i + 1
        }
        return out
    }
}

/// Copy `s` with ASCII upper-case letters (`A`-`Z`) lower-cased.
///
/// BEYOND PARITY - the mirror of `abiStrToUpper`. Only `A`-`Z` change (they
/// gain 32); every other byte passes through, so multi-byte scalars survive
/// byte-for-byte. Always returns a fresh string.
#[symbol("pickle_str_to_lower")]
fn abiStrToLower(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var out = newStr(n)
        var i = 0
        while (i < n) {
            var c = byteAt(s, i)
            if (c >= 65 && c <= 90) {
                byteInto(out, i, c + 32)
            } else {
                byteInto(out, i, c)
            }
            i = i + 1
        }
        return out
    }
}

/// Copy the `[start, end)` byte span of `s`.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no substring. The bounds follow
/// `List.slice` exactly: both clamp to `[0, len]` (negatives to 0, over-long to
/// `len`) and `end < start` yields an empty string, so the call is total.
/// Offsets are BYTE offsets - the same unit `s.indexOf` returns - so
/// `s.substring(i, i + needle.len())` extracts a match. A span that splits a
/// multi-byte scalar copies the raw bytes, so the result is not guaranteed to
/// be valid UTF-8; callers working with non-ASCII text must slice on scalar
/// boundaries. Always returns a fresh string.
#[symbol("pickle_str_substring")]
fn abiStrSubstring(s: *int, start: int, end: int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var a = start
        if (a < 0) {
            a = 0
        }
        if (a > n) {
            a = n
        }
        var b = end
        if (b < 0) {
            b = 0
        }
        if (b > n) {
            b = n
        }
        if (b < a) {
            b = a
        }
        var out = newStr(b - a)
        var i = a
        while (i < b) {
            byteInto(out, i - a, byteAt(s, i))
            i = i + 1
        }
        return out
    }
}

/// Join a `List<string>` with `sep` between elements.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no join. The body measures every
/// element and the separators first, allocates exactly once, then copies the
/// bytes, so the result is one fresh string. An empty list yields an empty
/// string, a single element is copied without a separator, and an empty
/// separator simply concatenates. Elements are copied as raw bytes, so any
/// multi-byte scalars survive intact.
#[symbol("pickle_list_join")]
fn abiListJoin(list: *int, sep: *int) -> *int {
    unsafe {
        var n = abiListLen(list)
        var sn = abiStrLen(sep)
        var total = 0
        var i = 0
        while (i < n) {
            total = total + abiStrLen(abiListGet(list, i))
            if (i > 0) {
                total = total + sn
            }
            i = i + 1
        }
        var out = newStr(total)
        var pos = 0
        var j = 0
        while (j < n) {
            if (j > 0) {
                var k = 0
                while (k < sn) {
                    byteInto(out, pos, byteAt(sep, k))
                    pos = pos + 1
                    k = k + 1
                }
            }
            var s = abiListGet(list, j)
            var ln = abiStrLen(s)
            var m = 0
            while (m < ln) {
                byteInto(out, pos, byteAt(s, m))
                pos = pos + 1
                m = m + 1
            }
            j = j + 1
        }
        return out
    }
}

/// Split `s` on every non-overlapping occurrence of `sep`.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no split. The scan is the same
/// raw byte run `contains`/`indexOf` use, left to right, and matches do not
/// overlap (`"aaa".split("aa")` is `["", "a"]`). The field list always has at
/// least one element: no match yields the whole string, a leading/trailing
/// separator yields an empty leading/trailing field, and an empty `s` yields
/// `[""]`. An empty separator has no split point, so it yields `[s]` - a total
/// rule chosen over the native `str::split("")` char walk, which has no
/// byte-offset meaning here.
#[symbol("pickle_str_split")]
fn abiStrSplit(s: *int, sep: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var sn = abiStrLen(sep)
        var out = abiListNew(0)
        if (sn == 0) {
            abiListPush(out, abiStrSubstring(s, 0, n))
            return out
        }
        var start = 0
        var i = 0
        var last = n - sn
        while (i <= last) {
            if (strMatchAt(s, i, sep, sn)) {
                abiListPush(out, abiStrSubstring(s, start, i))
                i = i + sn
                start = i
            } else {
                i = i + 1
            }
        }
        abiListPush(out, abiStrSubstring(s, start, n))
        return out
    }
}

/// Replace every non-overlapping occurrence of `needle` in `s` with `repl`.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no replace. The scan is left to
/// right and non-overlapping, so `"aaa".replace("aa", "b")` is `"ba"`. The body
/// counts the matches first, allocates the exact result length, then copies -
/// one fresh string, no growth loop. An empty `needle` has no match, so the
/// result is a fresh copy of `s` (rather than the infinite insertion native
/// `str::replace` avoids by matching empty runs).
#[symbol("pickle_str_replace")]
fn abiStrReplace(s: *int, needle: *int, repl: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var fl = abiStrLen(needle)
        if (fl == 0) {
            return abiStrSubstring(s, 0, n)
        }
        var tl = abiStrLen(repl)
        var count = 0
        var i = 0
        var last = n - fl
        while (i <= last) {
            if (strMatchAt(s, i, needle, fl)) {
                count = count + 1
                i = i + fl
            } else {
                i = i + 1
            }
        }
        if (count == 0) {
            return abiStrSubstring(s, 0, n)
        }
        var out = newStr(n - count * fl + count * tl)
        var pos = 0
        var src = 0
        var j = 0
        while (j <= last) {
            if (strMatchAt(s, j, needle, fl)) {
                var a = src
                while (a < j) {
                    byteInto(out, pos, byteAt(s, a))
                    pos = pos + 1
                    a = a + 1
                }
                var k = 0
                while (k < tl) {
                    byteInto(out, pos, byteAt(repl, k))
                    pos = pos + 1
                    k = k + 1
                }
                j = j + fl
                src = j
            } else {
                j = j + 1
            }
        }
        var m = src
        while (m < n) {
            byteInto(out, pos, byteAt(s, m))
            pos = pos + 1
            m = m + 1
        }
        return out
    }
}

/// Split `s` into one string per UTF-8 scalar.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no chars. The walk reads a lead
/// byte, derives the sequence length from its prefix (`0xxxxxxx`, `110xxxxx`,
/// `1110xxxx`, `11110xxx`), and clamps it to the remaining bytes, so the loop
/// always advances. A continuation byte or an over-long lead byte that does not
/// fit is therefore its own one-byte element instead of a stall - the result is
/// a partition of the input bytes, valid UTF-8 or not. An empty `s` yields an
/// empty list.
#[symbol("pickle_str_chars")]
fn abiStrChars(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var out = abiListNew(0)
        var i = 0
        while (i < n) {
            var b = byteAt(s, i)
            var k = 1
            if (b >= 192 && b < 224) {
                k = 2
            }
            if (b >= 224 && b < 240) {
                k = 3
            }
            if (b >= 240 && b < 248) {
                k = 4
            }
            if (i + k > n) {
                k = n - i
            }
            abiListPush(out, abiStrSubstring(s, i, i + k))
            i = i + k
        }
        return out
    }
}

/// Copy every byte of `s` into `out` starting at byte offset `off`.
/// The caller sizes `out`; this is the shared tail of the padding bodies.
fn copyInto(out: *int, off: int, s: *int) -> int {
    unsafe {
        var n = abiStrLen(s)
        var i = 0
        while (i < n) {
            byteInto(out, off + i, byteAt(s, i))
            i = i + 1
        }
        return 0
    }
}

/// Write `count` bytes of the repeating `pad` cycle into `out` starting at
/// byte offset `off`. `pad` must be non-empty; the caller checks that.
fn fillInto(out: *int, off: int, count: int, pad: *int) -> int {
    unsafe {
        var pn = abiStrLen(pad)
        var k = 0
        while (k < count) {
            byteInto(out, off + k, byteAt(pad, k % pn))
            k = k + 1
        }
        return 0
    }
}

/// Repeat `s` `n` times into a fresh string.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no repeat. The result is
/// exactly `max(0, n) * len(s)` bytes: a count of zero or less, or an empty
/// `s`, yields the empty string. The unit is the byte, matching `len`,
/// `substring`, and `slice`, so repeating multi-byte text keeps its bytes
/// intact.
#[symbol("pickle_str_repeat")]
fn abiStrRepeat(s: *int, n: int) -> *int {
    unsafe {
        var sn = abiStrLen(s)
        if (n < 1 || sn < 1) {
            return newStr(0)
        }
        var out = newStr(sn * n)
        var rep = 0
        var pos = 0
        while (rep < n) {
            copyInto(out, pos, s)
            pos = pos + sn
            rep = rep + 1
        }
        return out
    }
}

/// `s.padStart(width, pad)`: left-pad to `width` bytes with the repeating
/// `pad` cycle, truncated from the front.
///
/// BEYOND PARITY. When `s` is already at least `width` bytes long the result is
/// a fresh copy of `s`; an empty `pad` cannot add anything, so it also returns
/// a fresh copy. `"abc".padStart(6, "xy")` is `"xyxabc"`. Byte units again.
#[symbol("pickle_str_pad_start")]
fn abiStrPadStart(s: *int, width: int, pad: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var pn = abiStrLen(pad)
        if (width <= n || pn < 1) {
            return abiStrSubstring(s, 0, n)
        }
        var out = newStr(width)
        var fill = width - n
        fillInto(out, 0, fill, pad)
        copyInto(out, fill, s)
        return out
    }
}

/// `s.padEnd(width, pad)`: right-pad to `width` bytes with the repeating `pad`
/// cycle, truncated from the front.
///
/// BEYOND PARITY. Same copy rules as `padStart`; `"abc".padEnd(6, "xy")` is
/// `"abcxyx"`.
#[symbol("pickle_str_pad_end")]
fn abiStrPadEnd(s: *int, width: int, pad: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var pn = abiStrLen(pad)
        if (width <= n || pn < 1) {
            return abiStrSubstring(s, 0, n)
        }
        var out = newStr(width)
        copyInto(out, 0, s)
        fillInto(out, n, width - n, pad)
        return out
    }
}

/// Decimal text for an `i64`. Mirrors `strings.rs::int64_to_string`.
///
/// The reference takes the magnitude `unsigned_abs`, so `i64::MIN` is formatted
/// from `2^63` rather than from a negated `i64` (where `0 - n` would overflow
/// back to MIN and corrupt the digit loop). Pickle has no `u64`, so the MIN
/// magnitude is reached through the identity `2^63 = 10 * 922337203685477580 + 8`
/// - the quotient fits an `i64`, and its decimal digits are produced by the same
/// div-by-10 loop with `8` appended as the least-significant digit.
#[symbol("pickle_str_from_i64")]
fn abiStrFromI64(v: int) -> *int {
    unsafe {
        var MIN = 0 - 9223372036854775807 - 1
        if (v == MIN) {
            var p = newStr(20)
            var o = 20
            byteInto(p, o - 1, 48 + 8)
            o = o - 1
            var n = 922337203685477580
            while (n > 0) {
                var dig = n % 10
                o = o - 1
                byteInto(p, o, 48 + dig)
                n = n / 10
            }
            byteInto(p, 0, 45)
            return p
        }
        var neg = 0
        var m = v
        if (m < 0) {
            neg = 1
            m = 0 - m
        }
        var digits = 1
        var t = m
        while (t >= 10) {
            digits = digits + 1
            t = t / 10
        }
        var total = digits
        if (neg == 1) {
            total = digits + 1
        }
        var p2 = newStr(total)
        var o2 = total
        var d = m
        var i = 0
        while (i < digits) {
            var dig = d % 10
            o2 = o2 - 1
            byteInto(p2, o2, 48 + dig)
            d = d / 10
            i = i + 1
        }
        if (neg == 1) {
            byteInto(p2, 0, 45)
        }
        return p2
    }
}

/// Byte at `index` of a string, widened to the compiler's `byte` ABI (`int`).
///
/// GAP - out of range. Native `strings.rs::pickle_str_get` panics with
/// `pickle: string index {index} out of range (len {len})`; that goes through
/// `panic::pickle_panic_cstr`, which is a PRIVATE native (`pub fn`, no
/// `#[no_mangle]`), so a ported body cannot call it and Pickle has no panic
/// syntax. The reachable window is narrower than it looks: the checker only
/// requires the index to be an `int` (check.rs:3871-3875) and the emitter passes
/// the value through unclamped, so a *dynamic* index really can go out of range
/// in user code and native aborts while this returns 0. Restoring the branch
/// needs a first-class abort primitive, not a cleverer check.
#[symbol("pickle_str_get")]
fn abiStrGet(s: *int, index: int) -> int {
    unsafe {
        var len = s[LEN_WORD]
        if (index < 0) {
            return 0
        }
        if (index >= len) {
            return 0
        }
        return byteAt(s, index)
    }
}

/// Copy-on-write single-byte replacement. Mirrors `strings.rs::pickle_str_set`:
/// native allocates a FRESH string, copies the payload, overwrites one byte with
/// `v as u8` (a truncation, not a checked range), and returns the new object -
/// the emitter then stores it back into the original target.
///
/// Same out-of-range GAP as `abiStrGet`: native panics, this returns `s`
/// unchanged so the caller keeps a valid string instead of a corrupt one.
#[symbol("pickle_str_set")]
fn abiStrSet(s: *int, index: int, v: int) -> *int {
    unsafe {
        var len = s[LEN_WORD]
        if (index < 0) {
            return s
        }
        if (index >= len) {
            return s
        }
        var p = newStr(len)
        var i = 0
        while (i < len) {
            byteInto(p, i, byteAt(s, i))
            i = i + 1
        }
        byteOverwrite(p, index, v & 255)
        return p
    }
}

/// `"true"` / `"false"`. Mirrors `strings.rs::pickle_str_from_bool`, which picks
/// one of two literal byte blobs and passes it to `string_from_bytes`.
///
/// Built byte-by-byte rather than through a literal blob because Pickle has no
/// source syntax for a raw string-data address: `pkl_strdata_*` is reachable
/// only via the `IrConst::StrAddr` the emitter synthesises for its own
/// `pickle_str_from_bytes` call (emit.rs:4992). A `"true"` literal in this
/// module would therefore be routed back into the body being defined.
fn abiStrBytes(b0: int, b1: int, b2: int, b3: int, b4: int, n: int) -> *int {
    unsafe {
        var p = newStr(n)
        byteInto(p, 0, b0)
        if (n > 1) {
            byteInto(p, 1, b1)
        }
        if (n > 2) {
            byteInto(p, 2, b2)
        }
        if (n > 3) {
            byteInto(p, 3, b3)
        }
        if (n > 4) {
            byteInto(p, 4, b4)
        }
        return p
    }
}

#[symbol("pickle_str_from_bool")]
fn abiStrFromBool(v: bool) -> *int {
    unsafe {
        if (v) {
            return abiStrBytes(116, 114, 117, 101, 0, 4)
        }
        return abiStrBytes(102, 97, 108, 115, 101, 5)
    }
}

/// One-byte string holding `v as u8`. Mirrors `pickle_str_from_byte`, which
/// writes the byte RAW rather than re-encoding - see the native comment: a
/// re-encode would corrupt multi-byte text, because a `byte` in the checker is
/// already the leading byte of a UTF-8 sequence, not a code point.
#[symbol("pickle_str_from_byte")]
fn abiStrFromByte(v: int) -> *int {
    unsafe {
        var p = newStr(1)
        byteInto(p, 0, v & 255)
        return p
    }
}

/// Rust `char` (UCS-4 code point) to UTF-8, with the native replacement rule:
/// `char::from_u32(v).unwrap_or('\u{FFFD}')` turns every invalid code point -
/// surrogates, anything above U+10FFFF, and (via the i32 ABI) any negative
/// value - into U+FFFD, which encodes as the three bytes EF BF BD.
#[symbol("pickle_str_from_char")]
fn abiStrFromChar(v: int) -> *int {
    unsafe {
        var cp = v
        if (!isScalar(cp)) {
            cp = REPLACEMENT
        }
        var n = utf8Len(cp)
        var p = newStr(n)
        if (n == 1) {
            byteInto(p, 0, cp)
            return p
        }
        // `leadByte` needs the ORIGINAL code point, so keep `start` and let the
        // continuation loop consume `cp`.
        var start = cp
        var i = n
        while (i > 1) {
            i = i - 1
            byteInto(p, i, 128 + (cp & 63))
            cp = cp / 64
        }
        byteInto(p, 0, leadByte(n, start))
        return p
    }
}

/// Rust's `char::from_u32` accepts exactly the Unicode scalar values: 0..=10FFFF
/// minus the surrogate block D800..=DFFF.
fn isScalar(cp: int) -> bool {
    if (cp < 0) {
        return false
    }
    if (cp > 1114111) {
        return false
    }
    if (cp >= 55296) {
        if (cp <= 57343) {
            return false
        }
    }
    return true
}

/// Leading byte of an `n`-byte sequence: `1110xxxx` / `110xxxxx` / `10xxxxxx`
/// with the low `n-1` bits of the code point folded in. Split out so the shift
/// and mask stay parenthesised - `&` and `+` precedence in one expression is
/// exactly the kind of thing that is right by luck.
fn leadByte(n: int, cp: int) -> int {
    unsafe {
        var mask = 0
        if (n == 2) {
            mask = 31
        }
        if (n == 3) {
            mask = 15
        }
        if (n == 4) {
            mask = 7
        }
        var hi = 0
        if (n == 2) {
            hi = 192
        }
        if (n == 3) {
            hi = 224
        }
        if (n == 4) {
            hi = 240
        }
        return hi | ((cp >> (6 * (n - 1))) & mask)
    }
}

/// U+FFFD REPLACEMENT CHARACTER, native's `unwrap_or('\u{FFFD}')` fallback.
const REPLACEMENT: int = 65533

/// Byte length of a code point's UTF-8 encoding.
fn utf8Len(cp: int) -> int {
    if (cp < 128) {
        return 1
    }
    if (cp < 2048) {
        return 2
    }
    if (cp < 65536) {
        return 3
    }
    return 4
}

/// Snapshot a string's raw bytes as a fresh `List<byte>`, boxed per byte.
/// Mirrors `strings.rs::pickle_str_to_bytes`: `list_new(len)` then `len` pushes
/// of `pickle_box_i64(byte)`.
///
/// The native body takes a `gc.temp_lease` to keep the in-flight list rooted
/// across the per-byte box allocations, which can trigger a nested collection.
/// The port has no collection at all - `newBox` is raw `alloc` - so there is
/// nothing to keep alive, and the list stays a plain local.
#[symbol("pickle_str_to_bytes")]
fn abiStrToBytes(s: *int) -> *int {
    unsafe {
        var len = s[LEN_WORD]
        var out = abiListNew(len)
        var i = 0
        while (i < len) {
            abiListPush(out, abiBoxI64(byteAt(s, i)))
            i = i + 1
        }
        return out
    }
}

/// Build a `string` from a `List<byte>`, the inverse of `abiStrToBytes`.
/// Mirrors `strings.rs::pickle_str_from_list`, including its `len == 0` early
/// return of an empty string that never touches the data span.
///
/// GAP - the native range guard. Native panics `str(bytes): byte out of
/// 0..=255` via the private `pickle_panic_cstr`, unreachable from a ported body.
/// The branch is dead for CHECKED Pickle (a `byte` is 0..=255 by construction,
/// check.rs:768-770), but this module has no way to prove it, so the value is
/// truncated to a byte the way `pickle_str_from_byte` does. Silently accepting
/// a bad element is the wrong default, so this is recorded as a gap rather than
/// presented as parity.
#[symbol("pickle_str_from_list")]
fn abiStrFromList(list: *int) -> *int {
    unsafe {
        var len = abiListLen(list)
        if (len == 0) {
            return newStr(0)
        }
        var p = newStr(len)
        var i = 0
        while (i < len) {
            byteInto(p, i, abiUnboxI64(abiListGet(list, i)) & 255)
            i = i + 1
        }
        return p
    }
}

/// Lexicographic byte comparison returning -1 / 0 / 1. Mirrors
/// `strings.rs::string_cmp`: compare the common prefix, then order by length.
#[symbol("pickle_str_cmp")]
fn abiStrCmp(a: *int, b: *int) -> int {
    unsafe {
        var la = a[LEN_WORD]
        var lb = b[LEN_WORD]
        var n = la
        if (lb < n) {
            n = lb
        }
        var i = 0
        while (i < n) {
            var x = byteAt(a, i)
            var y = byteAt(b, i)
            if (x != y) {
                if (x < y) {
                    return 0 - 1
                }
                return 1
            }
            i = i + 1
        }
        if (la == lb) {
            return 0
        }
        if (la < lb) {
            return 0 - 1
        }
        return 1
    }
}

/// Substitute `%s` placeholders in `template` with the elements of `parts`, in
/// order, producing one fresh string.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no format. The compiler
/// stringifies every argument first (through the same `pickle_str_from_*`
/// helpers interpolation uses) and passes a `List<string>`, so this body only
/// has to splice text and parts.
///
/// Placeholder rules, chosen to stay total and byte-oriented:
///   * `%s` consumes the next part. With no part left, the two bytes are copied
///     literally, so `format("%s%s", "a")` is `"a%s"` rather than a panic.
///   * `%%` emits one `%`.
///   * Any other `%` (including a trailing one) is copied verbatim, so a lone
///     percent never swallows the next byte.
///   * Extra parts past the last placeholder are ignored.
///
/// The template is a RUNTIME string, so it is not subject to string-literal
/// interpolation; callers write `format("x = %s", x)`. A literal `%` is `%%`.
///
/// The scan splits the template into text runs and part strings, pushes them in
/// order onto a segment list, and reuses `abiListJoin` with an empty separator,
/// so the result is measured and allocated exactly once. `newStr(0)` supplies
/// the empty separator - a `""` literal here would route back through the body
/// being defined (see TRAP 3 on `abiStrFromBytes`).
#[symbol("pickle_str_format")]
fn abiStrFormat(template: *int, parts: *int) -> *int {
    unsafe {
        var tn = abiStrLen(template)
        var pn = abiListLen(parts)
        var segs = abiListNew(0)
        var start = 0
        var i = 0
        var pi = 0
        while (i < tn) {
            if (byteAt(template, i) == 37) {
                var pct = false
                var slot = false
                if (i + 1 < tn) {
                    var nb = byteAt(template, i + 1)
                    if (nb == 37) {
                        pct = true
                    }
                    if (nb == 115) {
                        slot = true
                    }
                }
                if (pct) {
                    if (i > start) {
                        abiListPush(segs, abiStrSubstring(template, start, i))
                    }
                    abiListPush(segs, abiStrSubstring(template, i, i + 1))
                    i = i + 2
                    start = i
                    continue
                }
                if (slot && pi < pn) {
                    if (i > start) {
                        abiListPush(segs, abiStrSubstring(template, start, i))
                    }
                    abiListPush(segs, abiListGet(parts, pi))
                    pi = pi + 1
                    i = i + 2
                    start = i
                    continue
                }
            }
            i = i + 1
        }
        if (tn > start) {
            abiListPush(segs, abiStrSubstring(template, start, tn))
        }
        return abiListJoin(segs, newStr(0))
    }
}