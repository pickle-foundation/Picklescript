module runtime.abi_string

import { abiBoxI64, abiUnboxI64 } from runtime.abi_box
import { abiListNew, abiListLen, abiListGet, abiListPush } from runtime.abi_list
import { abiManagedAlloc, MANAGED_MAX_BUMP, managedArenaBase, managedArenaUsed, managedArenaCap } from runtime.abi_raw
// String payloads come from `alloc(int, n)`, whose symbol lives in `abi_raw.pkl`.
//
// NO REGISTRATION. These bodies deliberately do NOT register their blocks in the
// sweepability registry (nor, therefore, in the allocation/collection seam the
// registry feeds). The blocks are raw allocations the collector does not track,
// which is exactly why the KNOWN LIMITATION note below says they are never
// reclaimed - putting them in a *sweepability* registry would misstate that and
// risk the collector freeing a live payload. It would also break parity with the
// reference: native `pickle_str_*` ops run through `Gc::alloc` without touching
// the ported registry, so a string built by `str(...)`, `+`, or an `expect`
// message moves neither the registered count/bytes nor the seam counters, and
// the ABI suites pin that. Keeping `newStr` out of the registry matches native.

/// Sovereign `string` ABI bodies, ported from `runtime/src/strings.rs`.
///
/// These are the first runtime functions written IN PICKLE that occupy real C
/// ABI slots. `#[symbol]` (added to both compilers) makes the exact export name
/// writable from Pickle, so emitted code calling `pickle_str_concat` reaches
/// this module instead of the Rust runtime.
///
/// Verified: importing this module and running under both the JIT and the
/// ported AOT driver produces correct output for concatenation, `i64`
/// formatting (including negatives and zero), byte length, and string pattern
/// matching (which lowers to `pickle_str_cmp`).
///
/// Layout is the authority in `runtime.layout` and mirrors `runtime/src/layout.rs`:
/// 24-byte header (`next`, `class_id`/`flags`, `size`), then `len` at word 3
/// (`STR_LEN_OFF / 8`), then UTF-8 bytes from word 4 (`STR_BYTES_OFF / 8`).
///
/// TRAP 1 - `alloc(T, n)` does NOT zero memory, and payload bytes are written
/// with `|=` for byte-granularity. Every payload word must be zeroed first or
/// the string carries uninitialized bits past its length. This presents as a
/// wrong *value* (garbage characters), not a crash, so it is easy to misread as
/// a logic bug.
///
/// TRAP 2 - never call `println` (or anything that concatenates) from inside an
/// ABI body. `println` lowers to `pickle_str_concat`, so the body re-enters
/// itself and recurses until the stack is exhausted. Print from the caller.
///
/// TRAP 3 - `byteAt` reads a string OBJECT payload; `rawByteAt` reads a bare
/// address such as a `pkl_strdata_*` literal blob. They differ by 32 bytes and
/// are easy to confuse. `pickle_str_from_bytes` is the literal-materialisation
/// path for `IrConst.Str` (x64 lowers a string constant to a
/// `pickle_str_from_bytes` call), so it must use `rawByteAt`; using `byteAt`
/// there silently corrupts every string literal in the program.
///
/// GAP - Rust treats a null string as empty in `str_len` and `string_concat`,
/// but Pickle has no null pointer literal and `Option` is not generic over
/// `*T`, so those defensive branches are not expressible in source yet. These
/// bodies assume a non-null operand, which is what the compiler emits for a
/// `string`-typed value. A future null-pointer primitive should restore the
/// branches verbatim rather than leave the omission.
///
/// KNOWN LIMITATION - these strings come from `pickle_raw_alloc`, which the GC
/// does not track. They are correct and safe, but never reclaimed, so a
/// long-running program leaks every string it builds. Verified benign: 20k
/// ported strings plus a forced `gcCollect` completes with the collector still
/// working and its collection count advancing. Making them collectable needs a
/// managed allocator that registers with the GC - the next tranche, not a
/// correctness question for this one.

const HEADER_WORDS: int = 3
const LEN_WORD: int = 3
const BYTES_WORD: int = 4
/// Header word 0 caches the FNV-1a hash of the payload. Word 2 is the allocated
/// byte count, always a multiple of 8, so its low three bits are free flags:
/// bit 0 marks a writable heap block (static `.rdata` descriptors leave it 0
/// and must never be written), bit 1 marks a valid cached hash, bit 2 marks a
/// shared/immutable string (interned values; future in-place append must copy).
/// The cached value is the exact 64-bit hash, so map probe order is unchanged.
const SIZE_WORD: int = 2
const FLAG_HEAP: int = 1
const FLAG_HASH: int = 2
const FLAG_SHARED: int = 4

/// FNV-1a, byte-for-byte the constants `abi_map` uses. Duplicated rather than
/// imported because `abi_map` imports this module; a cycle is not available and
/// the hash must stay identical for map placement and the `FLAG_HASH` shortcut.
const FNV_OFFSET: int = 0 - 0x340D631B7BDDDCDB
const FNV_PRIME: int = 0x100000001B3

/// Lazily allocated raw table of interned `str(int)` results for
/// `-999..999`, indexed by `v + 1000`. Zero means "not built yet".
var internTab: int = 0

fn wordsFor(n: int) -> int {
    return HEADER_WORDS + 1 + (n + 7) / 8
}

/// Allocate a `string` object of `n` bytes. Header words are set; payload words
/// are zeroed so `byteInto`'s `|=` is well-defined.
fn newStr(n: int) -> *int {
    unsafe {
        var words = wordsFor(n)
        if (words < HEADER_WORDS + 1) {
            words = HEADER_WORDS + 1
        }
        var p = abiManagedAlloc(words * 8) as *int
        p[0] = 0
        p[1] = 0
        p[2] = (words * 8) | FLAG_HEAP
        p[3] = n
        // Wide clear via the CRT once the payload is worth a call; below that a
        // short word loop is cheaper than the call overhead.
        if (words - BYTES_WORD >= 8) {
            memset(((p as int) + BYTES_WORD * 8) as *int, 0, (words - BYTES_WORD) * 8)
        } else {
            var w = BYTES_WORD
            while (w < words) {
                p[w] = 0
                w = w + 1
            }
        }
        return p
    }
}

/// `newStr` without the payload clear. Only valid where every payload byte is
/// written before the string escapes (`abiStrConcat`'s wide path writes the full
/// logical payload with `memcpy` and masks the final word).
fn newStrRaw(n: int) -> *int {
    unsafe {
        var words = wordsFor(n)
        if (words < HEADER_WORDS + 1) {
            words = HEADER_WORDS + 1
        }
        // Inline the managed-arena bump. Every concat/substring allocation pays
        // this path, and `abiManagedAlloc`'s clamp/round checks are dead work
        // here: `words * 8` is already an 8-byte multiple of at least 32 bytes.
        // The cold paths (new chunk, oversized request) stay in `abi_raw`.
        var bytes = words * 8
        var addr = 0
        if (bytes <= MANAGED_MAX_BUMP && managedArenaUsed + bytes <= managedArenaCap) {
            addr = managedArenaBase + managedArenaUsed
            managedArenaUsed = managedArenaUsed + bytes
        } else {
            addr = abiManagedAlloc(bytes)
        }
        var p = addr as *int
        p[0] = 0
        p[1] = 0
        p[2] = bytes | FLAG_HEAP
        p[3] = n
        return p
    }
}

/// `newStr` with a payload capacity larger than the logical length. The extra
/// words are uninitialised: every byte below `n` is the caller's responsibility
/// and the final logical word must be masked before the string escapes. Used by
/// the in-place append path so a run of appends does not allocate and copy the
/// whole prefix again on every step.
fn newStrCap(n: int, cap: int) -> *int {
    unsafe {
        var need = n
        if (cap > need) {
            need = cap
        }
        var words = wordsFor(need)
        if (words < HEADER_WORDS + 1) {
            words = HEADER_WORDS + 1
        }
        var p = abiManagedAlloc(words * 8) as *int
        p[0] = 0
        p[1] = 0
        p[2] = (words * 8) | FLAG_HEAP
        p[3] = n
        return p
    }
}

/// Clear the bytes past the logical end of the final payload word, so string
/// equality, hashing and word-at-a-time copying never observe stale padding.
fn maskStrTail(p: *int, n: int) {
    unsafe {
        var rem = n & 7
        if (rem != 0) {
            var w = BYTES_WORD + (n >> 3)
            p[w] = p[w] & ((1 << (rem * 8)) - 1)
        }
    }
}

// ---------------------------------------------------------------------------
// Short-string interning
// ---------------------------------------------------------------------------

/// Intern table for payloads of 1..8 bytes, keyed by (length, bytes). Split
/// fields and one-byte-prefixed numbers (`"w" + str(id)`) are the whole
/// vocabulary of generated text, so sharing those objects removes an
/// allocation per token and makes equal keys pointer-identical: map probes hit
/// the identity branch on the first slot instead of comparing bytes, and the
/// cached hash written at creation is reused by every lookup.
///
/// Strings are immutable values here - every mutating helper copies when
/// `FLAG_SHARED` is set (`abiStrAppendOwned`, `abiStrSet`) - so sharing is
/// unobservable except through identity, which no string operation exposes.
/// The table only grows; entries are never removed, matching the arena's
/// no-free model.
var shortInternTab: int = 0
var shortInternCap: int = 1024
var shortInternCount: int = 0

/// Allocate a zeroed word table. `abi_raw` has no zeroing helper and `abi_map`
/// owns the only `zeroed`, which would create an import cycle.
fn shortInternTable(cap: int) -> *int {
    unsafe {
        var p = abiManagedAlloc(cap * 8) as *int
        var i = 0
        while (i < cap) {
            p[i] = 0
            i = i + 1
        }
        return p
    }
}

/// Build an interned object: 40 bytes (five words), cached FNV hash, shared
/// flag, and the masked payload word. The padding bytes are zero by
/// construction, the same invariant `newStr` maintains.
fn shortInternNew(v: int, ln: int, h: int) -> *int {
    unsafe {
        var bytes = 40
        var addr = 0
        if (bytes <= MANAGED_MAX_BUMP && managedArenaUsed + bytes <= managedArenaCap) {
            addr = managedArenaBase + managedArenaUsed
            managedArenaUsed = managedArenaUsed + bytes
        } else {
            addr = abiManagedAlloc(bytes)
        }
        var p = addr as *int
        p[0] = h
        p[1] = 0
        p[2] = bytes | FLAG_HEAP | FLAG_HASH | FLAG_SHARED
        p[3] = ln
        p[4] = v
        return p
    }
}

/// Cold: allocate the first table and publish it. Kept out of the hot probe so
/// the common path's frame stays small.
fn shortInternInit() -> *int {
    unsafe {
        var t = shortInternTable(1024)
        shortInternTab = t as int
        shortInternCap = 1024
        return t
    }
}

/// FNV-1a over the `ln` low bytes of `vv`. Only the insert path needs the
/// cached map hash; table placement uses a cheaper mix, so the hot path never
/// runs this loop.
fn shortInternFnv(vv: int, ln: int) -> int {
    var h = FNV_OFFSET
    var t = vv
    var n = 0
    while (n < ln) {
        h = (h ^ (t & 255)) * FNV_PRIME
        t = t >> 8
        n = n + 1
    }
    return h
}

/// Cold: the probe proved `idx` empty. Load factor 0.7, the same bound the map
/// uses, is enforced here rather than in the hot probe: a hit never grows the
/// table, and a miss is the only path that can push the load factor up. That
/// keeps the per-field probe free of the count/capacity multiply and branch.
/// `vv` is already masked.
fn shortInternInsert(tab: *int, vv: int, ln: int, idx: int) -> *int {
    unsafe {
        if ((shortInternCount + 1) * 10 >= shortInternCap * 7) {
            shortInternGrow()
            // Re-probe the grown table from the top. The recursive call sees
            // the new table, a load factor below the bound, and the same key,
            // so it either hits an already-inserted equal entry or inserts.
            return shortInternWord(vv, ln)
        }
        var q = shortInternNew(vv, ln, shortInternFnv(vv, ln))
        tab[idx] = q as int
        shortInternCount = shortInternCount + 1
        return q
    }
}

/// Cold: double the table and re-probe every entry. Re-indexing must use the
/// same mix the hot probe uses; stored payloads are already masked.
fn shortInternGrow() {
    unsafe {
        var oldTab = shortInternTab as *int
        var oldCap = shortInternCap
        var ncap = oldCap * 2
        var nmask = ncap - 1
        var ntab = shortInternTable(ncap)
        var j = 0
        while (j < oldCap) {
            var p = oldTab[j]
            if (p != 0) {
                var sp = p as *int
                var vv = sp[BYTES_WORD]
                var ni = (((vv ^ (sp[LEN_WORD] * (0 - 0x61C8864680B583EB))) * 0x7FB5D329728EA185) >> 33) & nmask
                while (ntab[ni] != 0) {
                    ni = (ni + 1) & nmask
                }
                ntab[ni] = p
            }
            j = j + 1
        }
        shortInternTab = ntab as int
        shortInternCap = ncap
    }
}

/// Intern the payload `v` masked to `ln` bytes (0..8). The cached hash written
/// on insert is FNV-1a over exactly those bytes, so an interned object is
/// interchangeable with any other string carrying the same text: map
/// placement, bloom bits and the `FLAG_HASH` shortcut all agree.
///
/// The hot path only probes: table placement uses an inexpensive multiplicative
/// mix (it need not match the map hash), and growth/insertion/masking live in
/// cold helpers. Those moved out to keep this frame - and therefore the
/// per-call spill traffic - small; the probe runs once per split field and once
/// per generated name.
fn shortInternWord(v: int, ln: int) -> *int {
    unsafe {
        var msk = 0 - 1
        if (ln < 8) {
            msk = (1 << (ln * 8)) - 1
        }
        var vv = v & msk
        var tab = shortInternTab as *int
        if ((tab as int) == 0) {
            tab = shortInternInit()
        }
        var mask = shortInternCap - 1
        // One multiply of (payload ^ length-tag) and the high half of the
        // product give the slot. The earlier xor-shift bought no measurable
        // spread over this on the 1..8-byte payload domain and cost two extra
        // instructions on every field. Growth re-indexes with the same mix.
        var idx = (((vv ^ (ln * (0 - 0x61C8864680B583EB))) * 0x7FB5D329728EA185) >> 33) & mask
        while (true) {
            var p = tab[idx]
            if (p == 0) {
                return shortInternInsert(tab, vv, ln, idx)
            }
            var sp = p as *int
            if (sp[LEN_WORD] == ln && sp[BYTES_WORD] == vv) {
                return sp
            }
            idx = (idx + 1) & mask
        }
        return 0 as *int
    }
}

/// Allocate a `string` object WITHOUT recording it in the sweepability
/// registry. This is the layout of a native *static* descriptor name: native
/// keeps the ten builtin class names as `&'static` bytes on a Rust descriptor
/// (never `Gc::alloc`), so seeding them must not move the managed-object or
/// GC counters. Same header/length/payload layout as `newStr`, so `byteInto`,
/// `byteAt` and `STR_BYTES_OFF` all still apply; the block is never reclaimed.
fn newStrUnmanaged(n: int) -> *int {
    unsafe {
        var words = wordsFor(n)
        if (words < HEADER_WORDS + 1) {
            words = HEADER_WORDS + 1
        }
        var p = abiManagedAlloc(words * 8) as *int
        p[0] = 0
        p[1] = 0
        p[2] = (words * 8) | FLAG_HEAP
        p[3] = n
        var w = BYTES_WORD
        while (w < words) {
            p[w] = 0
            w = w + 1
        }
        return p
    }
}

/// Read byte `i` of a `string` OBJECT's inline payload.
fn byteAt(s: *int, i: int) -> int {
    unsafe {
        return (s[BYTES_WORD + (i >> 3)] >> ((i & 7) * 8)) & 255
    }
}

/// Read byte `i` of a RAW byte address - a `pkl_strdata_*` literal blob with no
/// header and no length word. See TRAP 3 above.
fn rawByteAt(p: *int, i: int) -> int {
    unsafe {
        return (p[i >> 3] >> ((i & 7) * 8)) & 255
    }
}

/// OR a byte into position `i`. ONLY valid on a zeroed payload: it cannot clear
/// bits, so writing 0 over a non-zero byte is a no-op. See `byteOverwrite`.
fn byteInto(s: *int, i: int, b: int) -> int {
    unsafe {
        var w = BYTES_WORD + (i >> 3)
        s[w] = s[w] | (b << ((i & 7) * 8))
        return 0
    }
}

/// ASSIGN a byte at position `i`, clearing whatever was there.
///
/// The mask is built from 255 shifted left by the same sub-word offset, so the
/// clear covers exactly the addressed byte and leaves its 7 neighbours in the
/// word alone. This is what `pickle_str_set` needs: it copies the source
/// payload and then overwrites one byte, which `byteInto` cannot express - ORing
/// 65 over an existing 63 yields 127, not 65.
fn byteOverwrite(s: *int, i: int, b: int) -> int {
    unsafe {
        var w = BYTES_WORD + (i >> 3)
        var shift = (i & 7) * 8
        var mask = (255 << shift) & 0 - 1
        s[w] = (s[w] & (mask ^ (0 - 1))) | (b << shift)
        return 0
    }
}

/// Copy `n` bytes from `src`'s payload (byte 0) into `dst`'s payload starting at
/// byte `doff`, moving whole words instead of calling `byteAt`/`byteInto` per
/// byte. `dst`'s payload must be zeroed; every destination word is ORed so a
/// shifted copy never clobbers the neighbouring bytes it shares a word with.
/// The final word is masked down to the copied span, so the caller can operate
/// on the rest of that word afterwards (`abiListJoin` copies elements back to
/// back).
///
/// Word-aligned `doff` copies one word per load; a shifted `doff` combines the
/// top of the previous source word with the current one. Shifts are masked
/// because this port's `>>` is arithmetic (`sar`).
fn copyPayloadTo(dst: *int, doff: int, src: *int, n: int) -> int {
    unsafe {
        if (n < 1) {
            return 0
        }
        var r = doff & 7
        var di = BYTES_WORD + (doff >> 3)
        var sw = (n + 7) >> 3
        if (r == 0) {
            var full = n >> 3
            var i = 0
            while (i < full) {
                dst[di + i] = src[i]
                i = i + 1
            }
            if ((n & 7) != 0) {
                dst[di + full] = dst[di + full] | (src[full] & ((1 << ((n & 7) * 8)) - 1))
            }
        } else {
            var sh = r * 8
            var inv = 64 - sh
            var top = (1 << sh) - 1
            var dw = (r + n + 7) >> 3
            var i = 0
            while (i < dw) {
                var v = 0
                if (i > 0) {
                    v = (src[i - 1] >> inv) & top
                }
                if (i < sw) {
                    v = v | (src[i] << sh)
                }
                dst[di + i] = dst[di + i] | v
                i = i + 1
            }
        }
        var endBit = (doff + n) & 7
        if (endBit != 0) {
            var w = BYTES_WORD + ((doff + n) >> 3)
            dst[w] = dst[w] & ((1 << (endBit * 8)) - 1)
        }
        return 0
    }
}

/// Copy `n` bytes from `src`'s payload starting at byte `soff` into the START of
/// `dst`'s payload - the substring shape, where the source offset is arbitrary
/// and the destination is aligned. `dst` must be a fresh `n`-byte string with a
/// zeroed payload. Each destination word combines two source words; the second
/// word is only read when it is inside the source payload (`sn` bytes), so a span
/// ending flush against the source allocation cannot over-read it.
fn copyPayloadFrom(dst: *int, src: *int, soff: int, n: int, sn: int) -> int {
    unsafe {
        if (n < 1) {
            return 0
        }
        var r = soff & 7
        var sa = soff >> 3
        var si = BYTES_WORD + sa
        var sw = (sn + 7) >> 3
        var dw = (n + 7) >> 3
        if (r == 0) {
            var full = n >> 3
            var i = 0
            while (i < full) {
                dst[BYTES_WORD + i] = src[si + i]
                i = i + 1
            }
            if ((n & 7) != 0) {
                dst[BYTES_WORD + full] = src[si + full] & ((1 << ((n & 7) * 8)) - 1)
            }
            return 0
        }
        var sh = r * 8
        var inv = 64 - sh
        var keep = (1 << inv) - 1
        var i = 0
        while (i < dw) {
            var v = (src[si + i] >> sh) & keep
            if (i + 1 < dw || sa + i + 1 < sw) {
                v = v | (src[si + i + 1] << inv)
            }
            dst[BYTES_WORD + i] = v
            i = i + 1
        }
        var endBit = n & 7
        if (endBit != 0) {
            dst[BYTES_WORD + dw - 1] = dst[BYTES_WORD + dw - 1] & ((1 << (endBit * 8)) - 1)
        }
        return 0
    }
}

/// Copy the `[start, end)` span of `s` with NO bounds checks and NO payload
/// clear. The caller guarantees `0 <= start <= end <= len(s)`.
///
/// This is the split/substring hot shape. `abiStrSubstring` is total, so its
/// clamps and `newStr`'s zeroing run on every call, but `copyPayloadFrom`
/// assigns every destination word, which makes that clear dead work. `newStrRaw`
/// plus one assignment per word replaces it.
fn strSubFast(s: *int, start: int, end: int) -> *int {
    unsafe {
        var ln = end - start
        var out = newStrRaw(ln)
        if (ln > 0) {
            if (ln <= 8) {
                // One destination word covers the whole span. The second source
                // word is only read when the span crosses a word boundary, and
                // then it is inside the source payload (start + ln <= len).
                var r = start & 7
                var si = BYTES_WORD + (start >> 3)
                var v = 0
                if (r == 0) {
                    v = s[si]
                } else {
                    // `>>` is arithmetic, so the shifted-out bytes would fill
                    // the top of `v` with the source word's sign bit. Mask them
                    // before OR-ing the next word in; otherwise a UTF-8 lead
                    // byte at the top of a payload word (bit 7 set) turns every
                    // following zero bit into 1.
                    v = (s[si] >> (r * 8)) & ((1 << ((8 - r) * 8)) - 1)
                    if (r + ln > 8) {
                        v = v | (s[si + 1] << ((8 - r) * 8))
                    }
                }
                if (ln == 8) {
                    out[BYTES_WORD] = v
                } else {
                    out[BYTES_WORD] = v & ((1 << (ln * 8)) - 1)
                }
            } else {
                copyPayloadFrom(out, s, start, ln, s[LEN_WORD])
            }
        } else {
            out[BYTES_WORD] = 0
        }
        return out
    }
}

/// Length in bytes of a `string`. Mirrors `layout.rs::str_len`, which reads the
/// `STR_LEN_OFF` word.
#[symbol("pickle_str_len")]
fn abiStrLen(s: *int) -> int {
    unsafe {
        return s[LEN_WORD]
    }
}

/// Copy `n` bytes from a raw byte address into a fresh `string`.
/// Mirrors `strings.rs::string_from_bytes`.
#[symbol("pickle_str_from_bytes")]
fn abiStrFromBytes(ptr: *int, n: int) -> *int {
    unsafe {
        if (n < 1) {
            return newStr(0)
        }
        var p = newStr(n)
        copyPayloadTo(p, 0, ptr, n)
        return p
    }
}

/// Concatenate two `string`s into a fresh third. Mirrors
/// `strings.rs::string_concat`.
///
/// Results that fit one payload word (`"w" + str(id)`, small appends) are
/// packed inline and, for the generated-name shape, interned; longer results
/// copy whole payload words up to 32 bytes and fall back to `memcpy` above
/// that. The final partial word is always masked so the payload past `n` stays
/// canonical for word-compares. (The narrow `copyPayloadTo` path this replaced
/// measured ~130ns for a 4-byte concat and ~170ns for each append to a growing
/// line.)
#[symbol("pickle_str_concat")]
fn abiStrConcat(a: *int, b: *int) -> *int {
    unsafe {
        var la = a[LEN_WORD]
        var lb = b[LEN_WORD]
        var n = la + lb
        // One payload word covers generated names and small appends. Keeping
        // that case in this body avoids a dispatcher call on the hot path; the
        // >8-byte copy loops stay in `abiStrConcatWide`, so this frame only
        // carries the short path's temps.
        if (n <= 8) {
            // Generated names are a one-byte prefix plus a shared `str(int)`
            // result. Intern that shape directly: it skips the result
            // allocation and makes the name pointer-identical to the split
            // field it will be looked up against, so the map probe's first slot
            // matches by identity. `b` must be shared (immutable) and short
            // enough for one payload word; anything else keeps the general
            // packing path below.
            if (la == 1 && lb <= 7 && (b[SIZE_WORD] & FLAG_SHARED) != 0) {
                var pv = (a[BYTES_WORD] & 255) | ((b[BYTES_WORD] & ((1 << (lb * 8)) - 1)) << 8)
                return shortInternWord(pv, n)
            }
            // Inline of `newStrRaw` for the one-word case. `wordsFor` returns 4
            // for an empty result and 5 otherwise; allocating five
            // unconditionally keeps the always-written payload word inside the
            // block (the empty case otherwise wrote one word past a 32-byte
            // allocation).
            var bytes = 40
            var addr = 0
            if (bytes <= MANAGED_MAX_BUMP && managedArenaUsed + bytes <= managedArenaCap) {
                addr = managedArenaBase + managedArenaUsed
                managedArenaUsed = managedArenaUsed + bytes
            } else {
                addr = abiManagedAlloc(bytes)
            }
            var p = addr as *int
            p[0] = 0
            p[1] = 0
            p[2] = bytes | FLAG_HEAP
            p[3] = n
            // Reading a word past either source is safe: every string object
            // owns at least one payload word. The low `la` bytes of `a` and the
            // next `lb` bytes of `b` are packed explicitly, so padding bits in
            // either source can never leak into the result.
            var v = 0
            if (la == 0) {
                if (lb == 8) {
                    v = b[BYTES_WORD]
                } else if (lb > 0) {
                    v = b[BYTES_WORD] & ((1 << (lb * 8)) - 1)
                }
            } else if (lb == 0) {
                if (la == 8) {
                    v = a[BYTES_WORD]
                } else {
                    v = a[BYTES_WORD] & ((1 << (la * 8)) - 1)
                }
            } else {
                v = (a[BYTES_WORD] & ((1 << (la * 8)) - 1)) | ((b[BYTES_WORD] & ((1 << (lb * 8)) - 1)) << (la * 8))
            }
            p[BYTES_WORD] = v
            return p
        }
        return abiStrConcatWide(a, b, la, lb)
    }
}

/// Concatenation longer than one payload word. The final partial word is
/// masked so the payload past `n` stays canonical for word-compares.
fn abiStrConcatWide(a: *int, b: *int, la: int, lb: int) -> *int {
    unsafe {
        var n = la + lb
        var p = newStrRaw(n)
        if (n <= 32) {
            // Short strings (generated names, small counts) dominate the
            // benchmark. Copy whole payload words here; two `memcpy` calls cost
            // more than the entire copy at this size. The final word is masked
            // so bytes past `n` (which may be uninitialised in `newStrRaw`) and
            // padding read past either source word cannot escape.
            var aw = (la + 7) >> 3
            var bw = (lb + 7) >> 3
            var i = 0
            while (i < aw) {
                p[BYTES_WORD + i] = a[BYTES_WORD + i]
                i = i + 1
            }
            var r = la & 7
            if (bw > 0) {
                if (r == 0) {
                    i = 0
                    while (i < bw) {
                        p[BYTES_WORD + aw + i] = b[BYTES_WORD + i]
                        i = i + 1
                    }
                } else {
                    var sh = r * 8
                    var inv = 64 - sh
                    var m = BYTES_WORD + (la >> 3)
                    var dw = (n + 7) >> 3
                    var lim = bw + 1
                    if (m + lim > BYTES_WORD + dw) {
                        lim = BYTES_WORD + dw - m
                    }
                    i = 0
                    while (i < lim) {
                        var high = 0
                        if (i < bw) {
                            high = b[BYTES_WORD + i] << sh
                        }
                        var low = 0
                        if (i == 0) {
                            low = p[m] & ((1 << sh) - 1)
                        } else {
                            // Arithmetic shift sign-extends: a source byte with
                            // the high bit set would smear 1s across the word.
                            low = (b[BYTES_WORD + i - 1] >> inv) & ((1 << sh) - 1)
                        }
                        p[m + i] = high | low
                        i = i + 1
                    }
                }
            }
            var rem = n & 7
            if (rem != 0) {
                p[BYTES_WORD + (n >> 3)] = p[BYTES_WORD + (n >> 3)] & ((1 << (rem * 8)) - 1)
            }
            return p
        }
        var dst = (p as int) + BYTES_WORD * 8
        memcpy(dst as *int, ((a as int) + BYTES_WORD * 8) as *int, la)
        memcpy((dst + la) as *int, ((b as int) + BYTES_WORD * 8) as *int, lb)
        var r = n & 7
        if (r != 0) {
            var w = BYTES_WORD + (n >> 3)
            p[w] = p[w] & ((1 << (r * 8)) - 1)
        }
        return p
    }
}

/// Append `b` to `a`, mutating `a` in place when it is a private heap string
/// with enough spare capacity. This is what makes `s = s + x + y` linear instead
/// of quadratic: the backend only emits this call when it has proven that `a` is
/// owned by the assignment chain, and the header checks here make a proof bug
/// degrade to the old allocating concat rather than corrupt anything.
///
/// Safety rules enforced here, independent of the caller:
///  * static `.rdata` descriptors have no `FLAG_HEAP`, so they are always copied;
///  * interned values carry `FLAG_SHARED`, so they are always copied;
///  * a heap block is only written when the new length fits its recorded
///    capacity (`SIZE_WORD` with the low flag bits cleared);
///  * the cached hash in word 0 is invalidated (`FLAG_HASH` cleared).
///
/// Growth is geometric (`n + n/2 + 16`), so a loop appending small pieces pays a
/// bounded number of reallocations. The in-place copy walks backwards when the
/// two operands are the same object, so `s = s + s` duplicates instead of
/// smearing; `byteOverwrite` is used there because the spare capacity bytes are
/// uninitialised and an OR would not clear them. On the copying path the new
/// buffer is fully written below `n` and its final word is masked, which keeps
/// the padding invariant every other string operation relies on.
#[symbol("pickle_str_append_owned")]
fn abiStrAppendOwned(a: *int, b: *int) -> *int {
    unsafe {
        var la = a[LEN_WORD]
        var lb = b[LEN_WORD]
        var n = la + lb
        var flags = a[SIZE_WORD]
        var capBytes = flags & (0 - 8)
        if ((flags & FLAG_HEAP) == 0 || (flags & FLAG_SHARED) != 0 || n > capBytes - BYTES_WORD * 8) {
            return abiStrAppendCopy(a, b, la, lb, n)
        }
        if ((a as int) == (b as int)) {
            return abiStrAppendSelf(a, b, la, lb, n, capBytes)
        }
        if (lb > 8) {
            return abiStrAppendLong(a, b, la, lb, n, capBytes)
        }
        // Small pieces (a digit, a space, a one-byte term suffix) are most of
        // what appending costs. A word store replaces the CRT `memcpy` call;
        // the destination may start mid-word, so the first word keeps its low
        // `la & 7` bytes and the second (only when the piece crosses the word
        // boundary) takes the overflow. The tail mask below canonicalises every
        // byte past the new end. This stays inline because the call to a
        // separate in-place body cost more than the store on a growing line.
        var w = b[BYTES_WORD]
        var r = la & 7
        var di = BYTES_WORD + (la >> 3)
        if (r == 0) {
            a[di] = w
        } else {
            var sh = r * 8
            a[di] = (a[di] & ((1 << sh) - 1)) | (w << sh)
            if (r + lb > 8) {
                a[di + 1] = w >> ((8 - r) * 8)
            }
        }
        a[LEN_WORD] = n
        // Keep the capacity bits, drop the now-stale cached hash.
        a[SIZE_WORD] = capBytes | FLAG_HEAP
        var rem = n & 7
        if (rem != 0) {
            var tw = BYTES_WORD + (n >> 3)
            a[tw] = a[tw] & ((1 << (rem * 8)) - 1)
        }
        return a
    }
}

/// Cold: `s = s + s` must duplicate, not smear. Walking backwards and using
/// `byteOverwrite` (which clears) keeps the spare capacity bytes canonical.
fn abiStrAppendSelf(a: *int, b: *int, la: int, lb: int, n: int, capBytes: int) -> *int {
    unsafe {
        var j = lb - 1
        while (j >= 0) {
            byteOverwrite(a, la + j, abiStrGet(b, j))
            j = j - 1
        }
        return abiStrAppendMark(a, n, capBytes)
    }
}

/// Cold: an in-place append of more than one word.
fn abiStrAppendLong(a: *int, b: *int, la: int, lb: int, n: int, capBytes: int) -> *int {
    unsafe {
        memcpy(((a as int) + BYTES_WORD * 8 + la) as *int, ((b as int) + BYTES_WORD * 8) as *int, lb)
        return abiStrAppendMark(a, n, capBytes)
    }
}

/// Publish an in-place append: new length, capacity bits preserved, cached hash
/// dropped, and the bytes past the new end masked.
fn abiStrAppendMark(a: *int, n: int, capBytes: int) -> *int {
    unsafe {
        a[LEN_WORD] = n
        a[SIZE_WORD] = capBytes | FLAG_HEAP
        var rem = n & 7
        if (rem != 0) {
            var w = BYTES_WORD + (n >> 3)
            a[w] = a[w] & ((1 << (rem * 8)) - 1)
        }
        return a
    }
}

/// Cold: no private buffer with enough room, so copy both sides into a fresh
/// block with geometric growth.
fn abiStrAppendCopy(a: *int, b: *int, la: int, lb: int, n: int) -> *int {
    unsafe {
        var cap = n + (n >> 1) + 16
        var p = newStrCap(n, cap)
        var dst = (p as int) + BYTES_WORD * 8
        memcpy(dst as *int, ((a as int) + BYTES_WORD * 8) as *int, la)
        memcpy((dst + la) as *int, ((b as int) + BYTES_WORD * 8) as *int, lb)
        maskStrTail(p, n)
        return p
    }
}

/// Cold: copy all three pieces into one fresh block. Used when the first
/// argument is not privately owned or a piece is wider than one word.
fn abiStrAppendTwoCopy(a: *int, b: *int, c: *int, la: int, lb: int, lc: int, n: int) -> *int {
    unsafe {
        var cap = n + (n >> 1) + 16
        var p = newStrCap(n, cap)
        var dst = (p as int) + BYTES_WORD * 8
        memcpy(dst as *int, ((a as int) + BYTES_WORD * 8) as *int, la)
        memcpy((dst + la) as *int, ((b as int) + BYTES_WORD * 8) as *int, lb)
        memcpy((dst + la + lb) as *int, ((c as int) + BYTES_WORD * 8) as *int, lc)
        maskStrTail(p, n)
        return p
    }
}

/// In-place variant for pieces wider than one word. The caller has already
/// checked that the combined length fits `a`'s capacity (with the usual four
/// spare words) and that neither piece aliases `a`, so this is two `memcpy`s
/// and one header publish: exactly the bytes two sequential in-place appends
/// would produce, without the second capacity check. Keeping this path in
/// place matters for loops like `all = all + line + "\n"` - routing every wide
/// piece through the allocating copy path would make the accumulator quadratic.
fn abiStrAppendTwoLong(a: *int, b: *int, c: *int, la: int, lb: int, lc: int, n: int, capBytes: int) -> *int {
    unsafe {
        var dst = (a as int) + BYTES_WORD * 8
        memcpy((dst + la) as *int, ((b as int) + BYTES_WORD * 8) as *int, lb)
        memcpy((dst + la + lb) as *int, ((c as int) + BYTES_WORD * 8) as *int, lc)
        return abiStrAppendMark(a, n, capBytes)
    }
}

/// Append two pieces in one call: exactly
/// `abiStrAppendOwned(abiStrAppendOwned(a, b), c)`.
///
/// The backend fuses a two-link concat chain (`line + term + " "`) into this
/// symbol; the IR still declares both calls as `pickle_str_concat`. The fast
/// path packs both one-word pieces and publishes the header once, which is the
/// whole point of the fusion - two prologues, two capacity checks and two
/// length updates per token otherwise. An operand that aliases `a`, or a
/// shared/static first buffer, delegates to the sequential bodies, so the
/// observable result is exactly the two-call result. A piece wider than one
/// word skips the packed stores but still appends in place when the capacity
/// check above passed (see `abiStrAppendTwoLong`).
#[symbol("pickle_str_append_two")]
fn abiStrAppendTwo(a: *int, b: *int, c: *int) -> *int {
    unsafe {
        // An operand that aliases `a` must see the same intermediate buffer the
        // sequential calls would expose; fall back rather than copy over live
        // source bytes.
        if ((a as int) == (b as int) || (a as int) == (c as int)) {
            return abiStrAppendOwned(abiStrAppendOwned(a, b), c)
        }
        var la = a[LEN_WORD]
        var lb = b[LEN_WORD]
        var lc = c[LEN_WORD]
        var n = la + lb + lc
        var flags = a[SIZE_WORD]
        var capBytes = flags & (0 - 8)
        if ((flags & FLAG_HEAP) == 0 || (flags & FLAG_SHARED) != 0 || n > capBytes - BYTES_WORD * 8) {
            return abiStrAppendTwoCopy(a, b, c, la, lb, lc, n)
        }
        // A wide piece cannot use the packed word stores below, but the
        // capacity check above already proved both pieces fit, so it does not
        // need a fresh block either.
        if (lb > 8 || lc > 8) {
            return abiStrAppendTwoLong(a, b, c, la, lb, lc, n, capBytes)
        }
        // First piece. Same word-store rule as `abiStrAppendOwned`: keep the
        // destination's low `pos & 7` bytes, shift the piece in, and spill the
        // overflow byte into the next word when the piece crosses the boundary.
        var pos = la
        var wb = b[BYTES_WORD]
        var r = pos & 7
        var di = BYTES_WORD + (pos >> 3)
        if (r == 0) {
            a[di] = wb
        } else {
            var sh = r * 8
            a[di] = (a[di] & ((1 << sh) - 1)) | (wb << sh)
            if (r + lb > 8) {
                a[di + 1] = wb >> ((8 - r) * 8)
            }
        }
        // Second piece starts where the first ended; the header is published
        // only after both stores, so no intermediate length is observable.
        pos = la + lb
        var wc = c[BYTES_WORD]
        var r2 = pos & 7
        var di2 = BYTES_WORD + (pos >> 3)
        if (r2 == 0) {
            a[di2] = wc
        } else {
            var sh2 = r2 * 8
            a[di2] = (a[di2] & ((1 << sh2) - 1)) | (wc << sh2)
            if (r2 + lc > 8) {
                a[di2 + 1] = wc >> ((8 - r2) * 8)
            }
        }
        a[LEN_WORD] = n
        a[SIZE_WORD] = capBytes | FLAG_HEAP
        var rem = n & 7
        if (rem != 0) {
            var tw = BYTES_WORD + (n >> 3)
            a[tw] = a[tw] & ((1 << (rem * 8)) - 1)
        }
        return a
    }
}

/// Whether `s` begins with `prefix`, byte-for-byte.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no prefix/suffix predicate, so
/// this symbol exists only in the port. The comparison is over raw UTF-8 bytes,
/// which is the same equality the `contains` scan and `pickle_str_cmp` use; a
/// multi-byte prefix therefore matches only on a code-point boundary, exactly
/// like it would in Rust's `str::starts_with`. An empty prefix matches every
/// string (the empty run occurs at offset 0), and a prefix longer than `s`
/// cannot match.
#[symbol("pickle_str_starts_with")]
fn abiStrStartsWith(s: *int, prefix: *int) -> bool {
    var sn = abiStrLen(s)
    var pn = abiStrLen(prefix)
    if (pn > sn) {
        return false
    }
    var i = 0
    while (i < pn) {
        if (byteAt(s, i) != byteAt(prefix, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

/// Whether `s` ends with `suffix`, byte-for-byte. The mirror of
/// `abiStrStartsWith`, aligned at `len(s) - len(suffix)`.
///
/// BEYOND PARITY - see `abiStrStartsWith`. An empty suffix matches every
/// string, and a suffix longer than `s` cannot match.
#[symbol("pickle_str_ends_with")]
fn abiStrEndsWith(s: *int, suffix: *int) -> bool {
    var sn = abiStrLen(s)
    var xn = abiStrLen(suffix)
    if (xn > sn) {
        return false
    }
    var off = sn - xn
    var i = 0
    while (i < xn) {
        if (byteAt(s, off + i) != byteAt(suffix, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

/// `s` with `prefix` removed, or the null pointer when `s` does not start with
/// it.
///
/// BEYOND PARITY, mirroring Rust's `str::strip_prefix`: an empty prefix matches
/// and yields a fresh copy of `s`, a longer prefix cannot match, and a match
/// yields the remainder as a fresh string. The result is the compiler's
/// `string?` representation (a nullable managed pointer).
#[symbol("pickle_str_strip_prefix")]
fn abiStrStripPrefix(s: *int, prefix: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var p = abiStrLen(prefix)
        if (p > n) {
            return 0 as *int
        }
        var i = 0
        while (i < p) {
            if (byteAt(s, i) != byteAt(prefix, i)) {
                return 0 as *int
            }
            i = i + 1
        }
        return abiStrSubstring(s, p, n)
    }
}

/// `s` with `suffix` removed, or the null pointer when `s` does not end with
/// it. The trailing mirror of `abiStrStripPrefix` and Rust's
/// `str::strip_suffix`.
#[symbol("pickle_str_strip_suffix")]
fn abiStrStripSuffix(s: *int, suffix: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var m = abiStrLen(suffix)
        if (m > n) {
            return 0 as *int
        }
        var start = n - m
        var i = 0
        while (i < m) {
            if (byteAt(s, start + i) != byteAt(suffix, i)) {
                return 0 as *int
            }
            i = i + 1
        }
        return abiStrSubstring(s, 0, start)
    }
}

/// Whether the bytes of `needle` occur as a contiguous run starting at `off`.
/// The scan primitive `abiStrIndexOf` builds on.
fn strMatchAt(hay: *int, off: int, needle: *int, nn: int) -> bool {
    var j = 0
    while (j < nn) {
        if (byteAt(hay, off + j) != byteAt(needle, j)) {
            return false
        }
        j = j + 1
    }
    return true
}

/// Byte offset of the first occurrence of `needle` in `s`, boxed, or the null
/// pointer when absent.
///
/// BEYOND PARITY - `runtime/src/strings.rs` only exposes `pickle_str_contains`,
/// so this symbol exists only in the port. The scan is the same raw UTF-8 byte
/// run `contains` uses, so a multi-byte needle matches only on a code-point
/// boundary. An empty needle is found at offset 0. The boxed `int` result is the
/// compiler's `int?` representation (`pickle_box_i64`/`pickle_unbox_i64`), so
/// `s.indexOf(sub)` lowers with no extra wrapping.
#[symbol("pickle_str_index_of")]
fn abiStrIndexOf(s: *int, needle: *int) -> *int {
    var sn = abiStrLen(s)
    var nn = abiStrLen(needle)
    if (nn > sn) {
        return 0 as *int
    }
    var last = sn - nn
    var i = 0
    while (i <= last) {
        if (strMatchAt(s, i, needle, nn)) {
            return abiBoxI64(i)
        }
        i = i + 1
    }
    return 0 as *int
}

/// Last byte offset of `needle` in `s`, or the null pointer when absent.
///
/// BEYOND PARITY. Same raw UTF-8 byte match as `pickle_str_index_of`, but the
/// scan runs right to left from `len(s) - len(needle)`, so overlapping matches
/// still report the last starting offset. An empty needle is found at
/// `len(s)`, matching the empty-needle rule of `indexOf` at offset 0.
#[symbol("pickle_str_last_index_of")]
fn abiStrLastIndexOf(s: *int, needle: *int) -> *int {
    var sn = abiStrLen(s)
    var nn = abiStrLen(needle)
    if (nn > sn) {
        return 0 as *int
    }
    var i = sn - nn
    while (i >= 0) {
        if (strMatchAt(s, i, needle, nn)) {
            return abiBoxI64(i)
        }
        i = i - 1
    }
    return 0 as *int
}

/// Count non-overlapping occurrences of `needle` in `s`.
///
/// BEYOND PARITY. The scan advances by the needle length after a match, so
/// `"aaa".count("aa")` is 1, the same non-overlap rule `replace` uses. An empty
/// needle counts 0 - it has no width to advance the scan.
#[symbol("pickle_str_count")]
fn abiStrCount(s: *int, needle: *int) -> int {
    var sn = abiStrLen(s)
    var nn = abiStrLen(needle)
    if (nn < 1 || nn > sn) {
        return 0
    }
    var n = 0
    var i = 0
    var last = sn - nn
    while (i <= last) {
        if (strMatchAt(s, i, needle, nn)) {
            n = n + 1
            i = i + nn
        } else {
            i = i + 1
        }
    }
    return n
}

/// Copy `s` without leading/trailing ASCII whitespace (space, tab, LF, CR).
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no trim. The whitespace set is
/// the one `compiler.front`'s `stringTrim` helper already uses, so the language
/// member and the compiler's own source tooling agree. The scan is over raw
/// UTF-8 bytes and stops at the first non-whitespace byte, so a multi-byte
/// scalar is never split: only the four single-byte ASCII whitespace bytes are
/// stripped. A string with nothing to strip is returned unchanged.
#[symbol("pickle_str_trim")]
fn abiStrTrim(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var start = 0
        while (start < n) {
            var c = byteAt(s, start)
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                start = start + 1
            } else {
                break
            }
        }
        var end = n
        while (end > start) {
            var c = byteAt(s, end - 1)
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                end = end - 1
            } else {
                break
            }
        }
        if (start == 0 && end == n) {
            return s
        }
        var out = newStr(end - start)
        var i = start
        while (i < end) {
            byteInto(out, i - start, byteAt(s, i))
            i = i + 1
        }
        return out
    }
}

/// Copy `s` with leading ASCII whitespace removed.
///
/// BEYOND PARITY - the leading half of `abiStrTrim`. Only the four single-byte
/// ASCII whitespace bytes (space, tab, LF, CR) are stripped, so a multi-byte
/// scalar is never split. A string with nothing to strip is returned unchanged.
#[symbol("pickle_str_trim_start")]
fn abiStrTrimStart(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var start = 0
        while (start < n) {
            var c = byteAt(s, start)
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                start = start + 1
            } else {
                break
            }
        }
        if (start == 0) {
            return s
        }
        var out = newStr(n - start)
        var i = start
        while (i < n) {
            byteInto(out, i - start, byteAt(s, i))
            i = i + 1
        }
        return out
    }
}

/// Copy `s` with trailing ASCII whitespace removed. The trailing half of
/// `abiStrTrim`, with the same byte-oriented rule and unchanged fast path.
#[symbol("pickle_str_trim_end")]
fn abiStrTrimEnd(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var end = n
        while (end > 0) {
            var c = byteAt(s, end - 1)
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                end = end - 1
            } else {
                break
            }
        }
        if (end == n) {
            return s
        }
        var out = newStr(end)
        var i = 0
        while (i < end) {
            byteInto(out, i, byteAt(s, i))
            i = i + 1
        }
        return out
    }
}

/// Split `s` into lines at `\n`, treating `\r\n` as one line ending.
///
/// BEYOND PARITY, with the semantics of Rust's `str::lines`: the final line
/// ending is optional, so a trailing `\n` does not add an empty final line, and
/// an empty string yields an empty list. A `\r` is dropped only when it directly
/// precedes the `\n` that ends a line, so a lone trailing `\r` is preserved.
#[symbol("pickle_str_split_lines")]
fn abiStrSplitLines(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var out = abiListNew(0)
        if (n == 0) {
            return out
        }
        var start = 0
        var i = 0
        while (i < n) {
            if (byteAt(s, i) == 10) {
                var end = i
                if (end > start && byteAt(s, end - 1) == 13) {
                    end = end - 1
                }
                abiListPush(out, abiStrSubstring(s, start, end))
                start = i + 1
            }
            i = i + 1
        }
        if (start < n) {
            abiListPush(out, abiStrSubstring(s, start, n))
        }
        return out
    }
}

/// Whether `c` is one of the four ASCII whitespace bytes `trim` strips:
/// space, tab, line feed, carriage return.
fn isAsciiSpace(c: int) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

/// Word-at-a-time ASCII whitespace mask: bit 7 of each byte lane is set when
/// that byte is one of space, tab, LF, CR.
///
/// Each lane is tested with an exact per-lane zero test applied to the byte
/// XOR the target byte. `(lane & 0x7F) + 0x7F` cannot carry into the next lane
/// (the maximum is `0xFE`), and its high bit is clear exactly when the lane is
/// zero, so OR-ing the lane back in and complementing yields one clean flag
/// per lane. This matters because the mask is used to *locate* boundaries, not
/// merely to test for presence: the subtract-based `haszero` trick can borrow
/// across a zero lane and flag a non-zero neighbour.
fn wsMaskWord(w: int) -> int {
    let laneOnes = 0x0101010101010101
    let laneLows = 0x7F7F7F7F7F7F7F7F
    var t = w ^ 0x2020202020202020
    var zeroLanes = (((t & laneLows) + laneLows) | t)
    var m = zeroLanes ^ (0 - 1)
    t = w ^ 0x0909090909090909
    zeroLanes = (((t & laneLows) + laneLows) | t)
    m = m | (zeroLanes ^ (0 - 1))
    t = w ^ 0x0A0A0A0A0A0A0A0A
    zeroLanes = (((t & laneLows) + laneLows) | t)
    m = m | (zeroLanes ^ (0 - 1))
    t = w ^ 0x0D0D0D0D0D0D0D0D
    zeroLanes = (((t & laneLows) + laneLows) | t)
    m = m | (zeroLanes ^ (0 - 1))
    // 0x80 in every byte lane: `0x8080...` has no positive i64 literal, but
    // multiplying the per-lane ones mask by 128 sets exactly those bits with
    // no carries between lanes.
    return m & (laneOnes * 128)
}

/// Split `s` into fields at runs of ASCII whitespace.
///
/// BEYOND PARITY. The shape is Rust's `str::split_whitespace`, but the
/// whitespace set is the same four ASCII bytes `trim` strips (space, `\t`,
/// `\n`, `\r`): every maximal run is one separator, so leading, trailing, and
/// repeated whitespace contribute no empty fields. An empty or all-whitespace
/// string yields an empty list.
#[symbol("pickle_str_split_whitespace")]
fn abiStrSplitWhitespace(s: *int) -> *int {
    unsafe {
        var n = s[LEN_WORD]
        // Fields are non-empty and separated by at least one whitespace byte,
        // so count <= (n + 1) / 2: allocate that upper bound and fill in ONE
        // pass. The earlier shape counted first and then re-scanned, which cost
        // a second walk of every byte; growing from `INITIAL_CAP` instead would
        // pay three `requireCapacity` buffer copies on the 48-field line.
        var cap = (n + 1) / 2
        var out = abiListNew(cap)
        if (n == 0) {
            return out
        }
        // `abi_list.pkl` layout: len at word 3, element pointer at word 5. The
        // push is inlined because the upper-bound capacity cannot grow, so
        // `requireCapacity` would return immediately every time.
        var data = out[5] as *int
        // `byteAt` is expanded because it was two calls per scanned byte. The
        // whitespace predicate runs a word at a time: `wordWhitespace` caches
        // the four-byte mask for the word under the cursor, so each test is a
        // shift and a bit check instead of a payload reload and byte extract.
        // Field ends are located by a three-step binary split of that mask.
        var k = 0
        var i = 0
        var wordBase = 0
        var wordWhitespace = wsMaskWord(s[BYTES_WORD])
        if (n < 8) {
            wordWhitespace = wordWhitespace & ((1 << (n * 8)) - 1)
        }
        while (i < n) {
            // Skip the whitespace separator run. Usually one byte, so this
            // stays byte-at-a-time against the cached mask.
            while (i < n) {
                if (i >= wordBase + 8) {
                    wordBase = i & (0 - 8)
                    wordWhitespace = wsMaskWord(s[BYTES_WORD + (wordBase >> 3)])
                    var bytesLeft = n - wordBase
                    if (bytesLeft < 8) {
                        wordWhitespace = wordWhitespace & ((1 << (bytesLeft * 8)) - 1)
                    }
                }
                if (((wordWhitespace >> ((i & 7) * 8)) & 128) == 0) {
                    break
                }
                i = i + 1
            }
            if (i >= n) {
                break
            }
            let start = i
            // Find the next whitespace lane. With no lane set the field runs
            // through the rest of the word, so skip all eight bytes at once.
            while (i < n) {
                if (i >= wordBase + 8) {
                    wordBase = i & (0 - 8)
                    wordWhitespace = wsMaskWord(s[BYTES_WORD + (wordBase >> 3)])
                    var bytesLeft2 = n - wordBase
                    if (bytesLeft2 < 8) {
                        wordWhitespace = wordWhitespace & ((1 << (bytesLeft2 * 8)) - 1)
                    }
                }
                var remainingMask = wordWhitespace >> ((i & 7) * 8)
                if (remainingMask != 0) {
                    // Locate the lowest whitespace lane with three halving
                    // tests. The mask only ever carries bit 7 of each lane, so
                    // this needs no ctz instruction or lookup table.
                    var laneIndex = 0
                    if ((remainingMask & 0x00000000FFFFFFFF) == 0) {
                        remainingMask = remainingMask >> 32
                        laneIndex = 4
                    }
                    if ((remainingMask & 0xFFFF) == 0) {
                        remainingMask = remainingMask >> 16
                        laneIndex = laneIndex + 2
                    }
                    if ((remainingMask & 0xFF) == 0) {
                        laneIndex = laneIndex + 1
                    }
                    i = i + laneIndex
                    break
                }
                i = wordBase + 8
                if (i > n) {
                    i = n
                }
            }
            // One-word fields (every term in the benchmark) are built here
            // rather than through `strSubFast` -> `newStrRaw`: two calls and
            // two prologues per field dominate a 72k-field corpus. The bump
            // arithmetic, header and word copy below are exactly those two
            // bodies, with the always-5-word sizing folded in (`wordsFor`
            // returns 5 for any length in 1..8).
            let ln = i - start
            if (ln <= 8) {
                var r = start & 7
                var si = BYTES_WORD + (start >> 3)
                var v = 0
                if (r == 0) {
                    v = s[si]
                } else {
                    // Same sign-extension guard as `strSubFast`: the shift
                    // is arithmetic, so keep only the source bytes that
                    // actually belong to this span before adding the tail.
                    v = (s[si] >> (r * 8)) & ((1 << ((8 - r) * 8)) - 1)
                    if (r + ln > 8) {
                        v = v | (s[si + 1] << ((8 - r) * 8))
                    }
                }
                // Short fields are interned: the corpus vocabulary repeats
                // across documents, so this replaces one allocation per
                // token with one table probe, and every repeated token is
                // pointer-identical with its cached hash already written.
                // `shortInternWord` masks the padding bits itself.
                data[k] = shortInternWord(v, ln) as int
            } else {
                data[k] = strSubFast(s, start, i) as int
            }
            k = k + 1
        }
        out[3] = k
        return out
    }
}

/// Copy `s` with ASCII lower-case letters (`a`-`z`) upper-cased.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no case mapping. Full Unicode
/// case mapping needs tables, so the scope is deliberately ASCII: `a`-`z` lose
/// 32, and every other byte - including all bytes >= 0x80, so every UTF-8
/// continuation/lead byte - is copied unchanged. A multi-byte scalar is
/// therefore never split or corrupted. Always returns a fresh string, so
/// mutating the result cannot affect the receiver.
#[symbol("pickle_str_to_upper")]
fn abiStrToUpper(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var out = newStr(n)
        var i = 0
        while (i < n) {
            var c = byteAt(s, i)
            if (c >= 97 && c <= 122) {
                byteInto(out, i, c - 32)
            } else {
                byteInto(out, i, c)
            }
            i = i + 1
        }
        return out
    }
}

/// Copy `s` with ASCII upper-case letters (`A`-`Z`) lower-cased.
///
/// BEYOND PARITY - the mirror of `abiStrToUpper`. Only `A`-`Z` change (they
/// gain 32); every other byte passes through, so multi-byte scalars survive
/// byte-for-byte. Always returns a fresh string.
#[symbol("pickle_str_to_lower")]
fn abiStrToLower(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var out = newStr(n)
        var i = 0
        while (i < n) {
            var c = byteAt(s, i)
            if (c >= 65 && c <= 90) {
                byteInto(out, i, c + 32)
            } else {
                byteInto(out, i, c)
            }
            i = i + 1
        }
        return out
    }
}

/// Copy the `[start, end)` byte span of `s`.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no substring. The bounds follow
/// `List.slice` exactly: both clamp to `[0, len]` (negatives to 0, over-long to
/// `len`) and `end < start` yields an empty string, so the call is total.
/// Offsets are BYTE offsets - the same unit `s.indexOf` returns - so
/// `s.substring(i, i + needle.len())` extracts a match. A span that splits a
/// multi-byte scalar copies the raw bytes, so the result is not guaranteed to
/// be valid UTF-8; callers working with non-ASCII text must slice on scalar
/// boundaries. Always returns a fresh string.
#[symbol("pickle_str_substring")]
fn abiStrSubstring(s: *int, start: int, end: int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var a = start
        if (a < 0) {
            a = 0
        }
        if (a > n) {
            a = n
        }
        var b = end
        if (b < 0) {
            b = 0
        }
        if (b > n) {
            b = n
        }
        if (b < a) {
            b = a
        }
        // `strSubFast` skips the dead payload clear (`copyPayloadFrom` writes
        // every word) and re-reads the same length word.
        return strSubFast(s, a, b)
    }
}

/// Join a `List<string>` with `sep` between elements.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no join. The body measures every
/// element and the separators first, allocates exactly once, then copies the
/// bytes, so the result is one fresh string. An empty list yields an empty
/// string, a single element is copied without a separator, and an empty
/// separator simply concatenates. Elements are copied as raw bytes, so any
/// multi-byte scalars survive intact.
#[symbol("pickle_list_join")]
fn abiListJoin(list: *int, sep: *int) -> *int {
    unsafe {
        var n = abiListLen(list)
        var sn = abiStrLen(sep)
        var total = 0
        var i = 0
        while (i < n) {
            total = total + abiStrLen(abiListGet(list, i))
            if (i > 0) {
                total = total + sn
            }
            i = i + 1
        }
        var out = newStr(total)
        var pos = 0
        var j = 0
        while (j < n) {
            if (j > 0) {
                var k = 0
                while (k < sn) {
                    byteInto(out, pos, byteAt(sep, k))
                    pos = pos + 1
                    k = k + 1
                }
            }
            var s = abiListGet(list, j)
            var ln = abiStrLen(s)
            var m = 0
            while (m < ln) {
                byteInto(out, pos, byteAt(s, m))
                pos = pos + 1
                m = m + 1
            }
            j = j + 1
        }
        return out
    }
}

/// Split `s` on every non-overlapping occurrence of `sep`.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no split. The scan is the same
/// raw byte run `contains`/`indexOf` use, left to right, and matches do not
/// overlap (`"aaa".split("aa")` is `["", "a"]`). The field list always has at
/// least one element: no match yields the whole string, a leading/trailing
/// separator yields an empty leading/trailing field, and an empty `s` yields
/// `[""]`. An empty separator has no split point, so it yields `[s]` - a total
/// rule chosen over the native `str::split("")` char walk, which has no
/// byte-offset meaning here.
#[symbol("pickle_str_split")]
fn abiStrSplit(s: *int, sep: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var sn = abiStrLen(sep)
        var out = abiListNew(0)
        if (sn == 0) {
            abiListPush(out, abiStrSubstring(s, 0, n))
            return out
        }
        var start = 0
        var i = 0
        var last = n - sn
        while (i <= last) {
            if (strMatchAt(s, i, sep, sn)) {
                abiListPush(out, abiStrSubstring(s, start, i))
                i = i + sn
                start = i
            } else {
                i = i + 1
            }
        }
        abiListPush(out, abiStrSubstring(s, start, n))
        return out
    }
}

/// Replace every non-overlapping occurrence of `needle` in `s` with `repl`.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no replace. The scan is left to
/// right and non-overlapping, so `"aaa".replace("aa", "b")` is `"ba"`. The body
/// counts the matches first, allocates the exact result length, then copies -
/// one fresh string, no growth loop. An empty `needle` has no match, so the
/// result is a fresh copy of `s` (rather than the infinite insertion native
/// `str::replace` avoids by matching empty runs).
#[symbol("pickle_str_replace")]
fn abiStrReplace(s: *int, needle: *int, repl: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var fl = abiStrLen(needle)
        if (fl == 0) {
            return abiStrSubstring(s, 0, n)
        }
        var tl = abiStrLen(repl)
        var count = 0
        var i = 0
        var last = n - fl
        while (i <= last) {
            if (strMatchAt(s, i, needle, fl)) {
                count = count + 1
                i = i + fl
            } else {
                i = i + 1
            }
        }
        if (count == 0) {
            return abiStrSubstring(s, 0, n)
        }
        var out = newStr(n - count * fl + count * tl)
        var pos = 0
        var src = 0
        var j = 0
        while (j <= last) {
            if (strMatchAt(s, j, needle, fl)) {
                var a = src
                while (a < j) {
                    byteInto(out, pos, byteAt(s, a))
                    pos = pos + 1
                    a = a + 1
                }
                var k = 0
                while (k < tl) {
                    byteInto(out, pos, byteAt(repl, k))
                    pos = pos + 1
                    k = k + 1
                }
                j = j + fl
                src = j
            } else {
                j = j + 1
            }
        }
        var m = src
        while (m < n) {
            byteInto(out, pos, byteAt(s, m))
            pos = pos + 1
            m = m + 1
        }
        return out
    }
}

/// Copy `s` with the FIRST occurrence of `needle` replaced by `repl`.
///
/// BEYOND PARITY. The left-to-right scan matches `abiStrReplace`'s first hit
/// (non-overlapping by construction, since it stops there); a missing needle
/// and an empty needle both return a fresh copy of `s`, mirroring
/// `abiStrReplace`'s empty-needle rule. Always returns a fresh string.
#[symbol("pickle_str_replace_first")]
fn abiStrReplaceFirst(s: *int, needle: *int, repl: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var fl = abiStrLen(needle)
        if (fl == 0) {
            return abiStrSubstring(s, 0, n)
        }
        var tl = abiStrLen(repl)
        var at = 0 - 1
        var i = 0
        var last = n - fl
        while (i <= last) {
            if (strMatchAt(s, i, needle, fl)) {
                at = i
                break
            }
            i = i + 1
        }
        if (at < 0) {
            return abiStrSubstring(s, 0, n)
        }
        var out = newStr(n - fl + tl)
        var pos = 0
        var a = 0
        while (a < at) {
            byteInto(out, pos, byteAt(s, a))
            pos = pos + 1
            a = a + 1
        }
        var k = 0
        while (k < tl) {
            byteInto(out, pos, byteAt(repl, k))
            pos = pos + 1
            k = k + 1
        }
        var m = at + fl
        while (m < n) {
            byteInto(out, pos, byteAt(s, m))
            pos = pos + 1
            m = m + 1
        }
        return out
    }
}

/// Split `s` into one string per UTF-8 scalar.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no chars. The walk reads a lead
/// byte, derives the sequence length from its prefix (`0xxxxxxx`, `110xxxxx`,
/// `1110xxxx`, `11110xxx`), and clamps it to the remaining bytes, so the loop
/// always advances. A continuation byte or an over-long lead byte that does not
/// fit is therefore its own one-byte element instead of a stall - the result is
/// a partition of the input bytes, valid UTF-8 or not. An empty `s` yields an
/// empty list.
#[symbol("pickle_str_chars")]
fn abiStrChars(s: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var out = abiListNew(0)
        var i = 0
        while (i < n) {
            var b = byteAt(s, i)
            var k = 1
            if (b >= 192 && b < 224) {
                k = 2
            }
            if (b >= 224 && b < 240) {
                k = 3
            }
            if (b >= 240 && b < 248) {
                k = 4
            }
            if (i + k > n) {
                k = n - i
            }
            abiListPush(out, abiStrSubstring(s, i, i + k))
            i = i + k
        }
        return out
    }
}

/// Copy every byte of `s` into `out` starting at byte offset `off`.
/// The caller sizes `out`; this is the shared tail of the padding bodies.
fn copyInto(out: *int, off: int, s: *int) -> int {
    unsafe {
        var n = abiStrLen(s)
        var i = 0
        while (i < n) {
            byteInto(out, off + i, byteAt(s, i))
            i = i + 1
        }
        return 0
    }
}

/// Write `count` bytes of the repeating `pad` cycle into `out` starting at
/// byte offset `off`. `pad` must be non-empty; the caller checks that.
fn fillInto(out: *int, off: int, count: int, pad: *int) -> int {
    unsafe {
        var pn = abiStrLen(pad)
        var k = 0
        while (k < count) {
            byteInto(out, off + k, byteAt(pad, k % pn))
            k = k + 1
        }
        return 0
    }
}

/// Repeat `s` `n` times into a fresh string.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no repeat. The result is
/// exactly `max(0, n) * len(s)` bytes: a count of zero or less, or an empty
/// `s`, yields the empty string. The unit is the byte, matching `len`,
/// `substring`, and `slice`, so repeating multi-byte text keeps its bytes
/// intact.
#[symbol("pickle_str_repeat")]
fn abiStrRepeat(s: *int, n: int) -> *int {
    unsafe {
        var sn = abiStrLen(s)
        if (n < 1 || sn < 1) {
            return newStr(0)
        }
        var out = newStr(sn * n)
        var rep = 0
        var pos = 0
        while (rep < n) {
            copyInto(out, pos, s)
            pos = pos + sn
            rep = rep + 1
        }
        return out
    }
}

/// `s.padStart(width, pad)`: left-pad to `width` bytes with the repeating
/// `pad` cycle, truncated from the front.
///
/// BEYOND PARITY. When `s` is already at least `width` bytes long the result is
/// a fresh copy of `s`; an empty `pad` cannot add anything, so it also returns
/// a fresh copy. `"abc".padStart(6, "xy")` is `"xyxabc"`. Byte units again.
#[symbol("pickle_str_pad_start")]
fn abiStrPadStart(s: *int, width: int, pad: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var pn = abiStrLen(pad)
        if (width <= n || pn < 1) {
            return abiStrSubstring(s, 0, n)
        }
        var out = newStr(width)
        var fill = width - n
        fillInto(out, 0, fill, pad)
        copyInto(out, fill, s)
        return out
    }
}

/// `s.padEnd(width, pad)`: right-pad to `width` bytes with the repeating `pad`
/// cycle, truncated from the front.
///
/// BEYOND PARITY. Same copy rules as `padStart`; `"abc".padEnd(6, "xy")` is
/// `"abcxyx"`.
#[symbol("pickle_str_pad_end")]
fn abiStrPadEnd(s: *int, width: int, pad: *int) -> *int {
    unsafe {
        var n = abiStrLen(s)
        var pn = abiStrLen(pad)
        if (width <= n || pn < 1) {
            return abiStrSubstring(s, 0, n)
        }
        var out = newStr(width)
        copyInto(out, 0, s)
        fillInto(out, n, width - n, pad)
        return out
    }
}

/// Decimal text for an `i64`. Mirrors `strings.rs::int64_to_string`.
///
/// The reference takes the magnitude `unsigned_abs`, so `i64::MIN` is formatted
/// from `2^63` rather than from a negated `i64` (where `0 - n` would overflow
/// back to MIN and corrupt the digit loop). Pickle has no `u64`, so the MIN
/// magnitude is reached through the identity `2^63 = 10 * 922337203685477580 + 8`
/// - the quotient fits an `i64`, and its decimal digits are produced by the same
/// div-by-10 loop with `8` appended as the least-significant digit.
#[symbol("pickle_str_from_i64")]
fn abiStrFromI64(v: int) -> *int {
    unsafe {
        var MIN = 0 - 9223372036854775807 - 1
        if (v == MIN) {
            var p = newStr(20)
            var o = 20
            byteInto(p, o - 1, 48 + 8)
            o = o - 1
            var n = 922337203685477580
            while (n > 0) {
                var dig = n % 10
                o = o - 1
                byteInto(p, o, 48 + dig)
                n = n / 10
            }
            byteInto(p, 0, 45)
            return p
        }
        var neg = 0
        var m = v
        if (m < 0) {
            neg = 1
            m = 0 - m
        }
        // Fast path for the ids and counts the language emits constantly
        // (`str(int)` in generated names, logging, map diagnostics): one
        // allocation, one payload store, no digit-count loop and no `byteInto`
        // call per digit. |v| < 1000 covers 0-255 and small negatives; measured
        // 120ns -> ~55ns. Larger magnitudes fall through to the general loop.
        if (m < 1000) {
            // Interned small integers. `str(int)` is on the hot path for every
            // generated term name, log line and diagnostic; the same 1-4 byte
            // text was previously allocated and rebuilt each time. The cache is
            // a raw never-freed table (strings are unregistered, so it does not
            // move the GC counters), and entries are marked FLAG_SHARED so an
            // in-place append can never mutate them.
            var tab = internTab
            if (tab == 0) {
                tab = alloc(int, 2000) as int
                if (tab != 0) {
                    var z = 0
                    while (z < 2000) {
                        (tab as *int)[z] = 0
                        z = z + 1
                    }
                    internTab = tab
                }
            }
            if (tab != 0) {
                var hit = (tab as *int)[v + 1000]
                if (hit != 0) {
                    return hit as *int
                }
            }
            var nd = 1
            if (m >= 10) { nd = 2 }
            if (m >= 100) { nd = 3 }
            var total2 = nd
            var off = 0
            if (neg == 1) {
                total2 = nd + 1
                off = 8
            }
            var p = newStrRaw(total2)
            var wv = 0
            if (m < 10) {
                wv = (48 + m) << off
            } else if (m < 100) {
                wv = ((48 + (m / 10)) << off) | ((48 + (m % 10)) << (off + 8))
            } else {
                wv = ((48 + (m / 100)) << off) | ((48 + ((m / 10) % 10)) << (off + 8)) | ((48 + (m % 10)) << (off + 16))
            }
            if (neg == 1) {
                wv = wv | 45
            }
            p[BYTES_WORD] = wv
            if (tab != 0) {
                p[SIZE_WORD] = p[SIZE_WORD] | FLAG_SHARED
                (tab as *int)[v + 1000] = p as int
            }
            return p
        }
        var digits = 1
        var t = m
        while (t >= 10) {
            digits = digits + 1
            t = t / 10
        }
        var total = digits
        if (neg == 1) {
            total = digits + 1
        }
        var p2 = newStr(total)
        var o2 = total
        var d = m
        var i = 0
        while (i < digits) {
            var dig = d % 10
            o2 = o2 - 1
            byteInto(p2, o2, 48 + dig)
            d = d / 10
            i = i + 1
        }
        if (neg == 1) {
            byteInto(p2, 0, 45)
        }
        return p2
    }
}

/// Byte at `index` of a string, widened to the compiler's `byte` ABI (`int`).
///
/// GAP - out of range. Native `strings.rs::pickle_str_get` panics with
/// `pickle: string index {index} out of range (len {len})`; that goes through
/// `panic::pickle_panic_cstr`, which is a PRIVATE native (`pub fn`, no
/// `#[no_mangle]`), so a ported body cannot call it and Pickle has no panic
/// syntax. The reachable window is narrower than it looks: the checker only
/// requires the index to be an `int` (check.rs:3871-3875) and the emitter passes
/// the value through unclamped, so a *dynamic* index really can go out of range
/// in user code and native aborts while this returns 0. Restoring the branch
/// needs a first-class abort primitive, not a cleverer check.
#[symbol("pickle_str_get")]
fn abiStrGet(s: *int, index: int) -> int {
    unsafe {
        var len = s[LEN_WORD]
        if (index < 0) {
            return 0
        }
        if (index >= len) {
            return 0
        }
        return byteAt(s, index)
    }
}

/// Copy-on-write single-byte replacement. Mirrors `strings.rs::pickle_str_set`:
/// native allocates a FRESH string, copies the payload, overwrites one byte with
/// `v as u8` (a truncation, not a checked range), and returns the new object -
/// the emitter then stores it back into the original target.
///
/// Same out-of-range GAP as `abiStrGet`: native panics, this returns `s`
/// unchanged so the caller keeps a valid string instead of a corrupt one.
#[symbol("pickle_str_set")]
fn abiStrSet(s: *int, index: int, v: int) -> *int {
    unsafe {
        var len = s[LEN_WORD]
        if (index < 0) {
            return s
        }
        if (index >= len) {
            return s
        }
        var p = newStr(len)
        var i = 0
        while (i < len) {
            byteInto(p, i, byteAt(s, i))
            i = i + 1
        }
        byteOverwrite(p, index, v & 255)
        return p
    }
}

/// `"true"` / `"false"`. Mirrors `strings.rs::pickle_str_from_bool`, which picks
/// one of two literal byte blobs and passes it to `string_from_bytes`.
///
/// Built byte-by-byte rather than through a literal blob because Pickle has no
/// source syntax for a raw string-data address: `pkl_strdata_*` is reachable
/// only via the `IrConst::StrAddr` the emitter synthesises for its own
/// `pickle_str_from_bytes` call (emit.rs:4992). A `"true"` literal in this
/// module would therefore be routed back into the body being defined.
fn abiStrBytes(b0: int, b1: int, b2: int, b3: int, b4: int, n: int) -> *int {
    unsafe {
        var p = newStr(n)
        byteInto(p, 0, b0)
        if (n > 1) {
            byteInto(p, 1, b1)
        }
        if (n > 2) {
            byteInto(p, 2, b2)
        }
        if (n > 3) {
            byteInto(p, 3, b3)
        }
        if (n > 4) {
            byteInto(p, 4, b4)
        }
        return p
    }
}

#[symbol("pickle_str_from_bool")]
fn abiStrFromBool(v: bool) -> *int {
    unsafe {
        if (v) {
            return abiStrBytes(116, 114, 117, 101, 0, 4)
        }
        return abiStrBytes(102, 97, 108, 115, 101, 5)
    }
}

/// One-byte string holding `v as u8`. Mirrors `pickle_str_from_byte`, which
/// writes the byte RAW rather than re-encoding - see the native comment: a
/// re-encode would corrupt multi-byte text, because a `byte` in the checker is
/// already the leading byte of a UTF-8 sequence, not a code point.
#[symbol("pickle_str_from_byte")]
fn abiStrFromByte(v: int) -> *int {
    unsafe {
        var p = newStr(1)
        byteInto(p, 0, v & 255)
        return p
    }
}

/// Rust `char` (UCS-4 code point) to UTF-8, with the native replacement rule:
/// `char::from_u32(v).unwrap_or('\u{FFFD}')` turns every invalid code point -
/// surrogates, anything above U+10FFFF, and (via the i32 ABI) any negative
/// value - into U+FFFD, which encodes as the three bytes EF BF BD.
#[symbol("pickle_str_from_char")]
fn abiStrFromChar(v: int) -> *int {
    unsafe {
        var cp = v
        if (!isScalar(cp)) {
            cp = REPLACEMENT
        }
        var n = utf8Len(cp)
        var p = newStr(n)
        if (n == 1) {
            byteInto(p, 0, cp)
            return p
        }
        // `leadByte` needs the ORIGINAL code point, so keep `start` and let the
        // continuation loop consume `cp`.
        var start = cp
        var i = n
        while (i > 1) {
            i = i - 1
            byteInto(p, i, 128 + (cp & 63))
            cp = cp / 64
        }
        byteInto(p, 0, leadByte(n, start))
        return p
    }
}

/// Rust's `char::from_u32` accepts exactly the Unicode scalar values: 0..=10FFFF
/// minus the surrogate block D800..=DFFF.
fn isScalar(cp: int) -> bool {
    if (cp < 0) {
        return false
    }
    if (cp > 1114111) {
        return false
    }
    if (cp >= 55296) {
        if (cp <= 57343) {
            return false
        }
    }
    return true
}

/// Leading byte of an `n`-byte sequence: `1110xxxx` / `110xxxxx` / `10xxxxxx`
/// with the low `n-1` bits of the code point folded in. Split out so the shift
/// and mask stay parenthesised - `&` and `+` precedence in one expression is
/// exactly the kind of thing that is right by luck.
fn leadByte(n: int, cp: int) -> int {
    unsafe {
        var mask = 0
        if (n == 2) {
            mask = 31
        }
        if (n == 3) {
            mask = 15
        }
        if (n == 4) {
            mask = 7
        }
        var hi = 0
        if (n == 2) {
            hi = 192
        }
        if (n == 3) {
            hi = 224
        }
        if (n == 4) {
            hi = 240
        }
        return hi | ((cp >> (6 * (n - 1))) & mask)
    }
}

/// U+FFFD REPLACEMENT CHARACTER, native's `unwrap_or('\u{FFFD}')` fallback.
const REPLACEMENT: int = 65533

/// Byte length of a code point's UTF-8 encoding.
fn utf8Len(cp: int) -> int {
    if (cp < 128) {
        return 1
    }
    if (cp < 2048) {
        return 2
    }
    if (cp < 65536) {
        return 3
    }
    return 4
}

/// Snapshot a string's raw bytes as a fresh `List<byte>`, boxed per byte.
/// Mirrors `strings.rs::pickle_str_to_bytes`: `list_new(len)` then `len` pushes
/// of `pickle_box_i64(byte)`.
///
/// The native body takes a `gc.temp_lease` to keep the in-flight list rooted
/// across the per-byte box allocations, which can trigger a nested collection.
/// The port has no collection at all - `newBox` is raw `alloc` - so there is
/// nothing to keep alive, and the list stays a plain local.
#[symbol("pickle_str_to_bytes")]
fn abiStrToBytes(s: *int) -> *int {
    unsafe {
        var len = s[LEN_WORD]
        var out = abiListNew(len)
        var i = 0
        while (i < len) {
            abiListPush(out, abiBoxI64(byteAt(s, i)))
            i = i + 1
        }
        return out
    }
}

/// Build a `string` from a `List<byte>`, the inverse of `abiStrToBytes`.
/// Mirrors `strings.rs::pickle_str_from_list`, including its `len == 0` early
/// return of an empty string that never touches the data span.
///
/// GAP - the native range guard. Native panics `str(bytes): byte out of
/// 0..=255` via the private `pickle_panic_cstr`, unreachable from a ported body.
/// The branch is dead for CHECKED Pickle (a `byte` is 0..=255 by construction,
/// check.rs:768-770), but this module has no way to prove it, so the value is
/// truncated to a byte the way `pickle_str_from_byte` does. Silently accepting
/// a bad element is the wrong default, so this is recorded as a gap rather than
/// presented as parity.
#[symbol("pickle_str_from_list")]
fn abiStrFromList(list: *int) -> *int {
    unsafe {
        var len = abiListLen(list)
        if (len == 0) {
            return newStr(0)
        }
        var p = newStr(len)
        var i = 0
        while (i < len) {
            byteInto(p, i, abiUnboxI64(abiListGet(list, i)) & 255)
            i = i + 1
        }
        return p
    }
}

/// Lexicographic byte comparison returning -1 / 0 / 1. Mirrors
/// `strings.rs::string_cmp`: compare the common prefix, then order by length.
#[symbol("pickle_str_cmp")]
fn abiStrCmp(a: *int, b: *int) -> int {
    unsafe {
        var la = a[LEN_WORD]
        var lb = b[LEN_WORD]
        var n = la
        if (lb < n) {
            n = lb
        }
        var full = n >> 3
        var i = 0
        while (i < full) {
            var x = a[BYTES_WORD + i]
            var y = b[BYTES_WORD + i]
            if (x != y) {
                var j = 0
                while (j < 8) {
                    var sh = j * 8
                    var xb = (x >> sh) & 255
                    var yb = (y >> sh) & 255
                    if (xb != yb) {
                        if (xb < yb) {
                            return 0 - 1
                        }
                        return 1
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        var k = full * 8
        while (k < n) {
            var xb = byteAt(a, k)
            var yb = byteAt(b, k)
            if (xb != yb) {
                if (xb < yb) {
                    return 0 - 1
                }
                return 1
            }
            k = k + 1
        }
        if (la == lb) {
            return 0
        }
        if (la < lb) {
            return 0 - 1
        }
        return 1
    }
}

/// Substitute `%s` placeholders in `template` with the elements of `parts`, in
/// order, producing one fresh string.
///
/// BEYOND PARITY - `runtime/src/strings.rs` has no format. The compiler
/// stringifies every argument first (through the same `pickle_str_from_*`
/// helpers interpolation uses) and passes a `List<string>`, so this body only
/// has to splice text and parts.
///
/// Placeholder rules, chosen to stay total and byte-oriented:
///   * `%s` consumes the next part. With no part left, the two bytes are copied
///     literally, so `format("%s%s", "a")` is `"a%s"` rather than a panic.
///   * `%%` emits one `%`.
///   * Any other `%` (including a trailing one) is copied verbatim, so a lone
///     percent never swallows the next byte.
///   * Extra parts past the last placeholder are ignored.
///
/// The template is a RUNTIME string, so it is not subject to string-literal
/// interpolation; callers write `format("x = %s", x)`. A literal `%` is `%%`.
///
/// The scan splits the template into text runs and part strings, pushes them in
/// order onto a segment list, and reuses `abiListJoin` with an empty separator,
/// so the result is measured and allocated exactly once. `newStr(0)` supplies
/// the empty separator - a `""` literal here would route back through the body
/// being defined (see TRAP 3 on `abiStrFromBytes`).
#[symbol("pickle_str_format")]
fn abiStrFormat(template: *int, parts: *int) -> *int {
    unsafe {
        var tn = abiStrLen(template)
        var pn = abiListLen(parts)
        var segs = abiListNew(0)
        var start = 0
        var i = 0
        var pi = 0
        while (i < tn) {
            if (byteAt(template, i) == 37) {
                var pct = false
                var slot = false
                if (i + 1 < tn) {
                    var nb = byteAt(template, i + 1)
                    if (nb == 37) {
                        pct = true
                    }
                    if (nb == 115) {
                        slot = true
                    }
                }
                if (pct) {
                    if (i > start) {
                        abiListPush(segs, abiStrSubstring(template, start, i))
                    }
                    abiListPush(segs, abiStrSubstring(template, i, i + 1))
                    i = i + 2
                    start = i
                    continue
                }
                if (slot && pi < pn) {
                    if (i > start) {
                        abiListPush(segs, abiStrSubstring(template, start, i))
                    }
                    abiListPush(segs, abiListGet(parts, pi))
                    pi = pi + 1
                    i = i + 2
                    start = i
                    continue
                }
            }
            i = i + 1
        }
        if (tn > start) {
            abiListPush(segs, abiStrSubstring(template, start, tn))
        }
        return abiListJoin(segs, newStr(0))
    }
}
