module runtime.tuple_test

import { optNum, NONE_SENTINEL } from runtime.options
import { fieldAt, fieldOutOfBounds, MSG_FIELD_OOB } from runtime.tuple

test fn field_read_in_bounds() {
    var f = [1, 2, 3]
    expect(optNum(fieldAt(f, 0))).toBe(1)
    expect(optNum(fieldAt(f, 2))).toBe(3)
}

test fn field_read_out_of_bounds_is_none() {
    var f = [1, 2, 3]
    expect(optNum(fieldAt(f, 3))).toBe(NONE_SENTINEL)
    expect(optNum(fieldAt(f, -1))).toBe(NONE_SENTINEL)
    expect(optNum(fieldAt(f, 100))).toBe(NONE_SENTINEL)
    var empty = [0]
    empty.pop()
    expect(optNum(fieldAt(empty, 0))).toBe(NONE_SENTINEL)
}

test fn bounds_predicate() {
    expect(fieldOutOfBounds(0, 0)).toBe(true)
    expect(fieldOutOfBounds(-1, 3)).toBe(true)
    expect(fieldOutOfBounds(3, 3)).toBe(true)
    expect(fieldOutOfBounds(2, 3)).toBe(false)
    expect(fieldOutOfBounds(0, 1)).toBe(false)
}

test fn message_constant() {
    expect(MSG_FIELD_OOB).toBe("pickle: tuple field index out of bounds")
}