module runtime.object_test

import { PICKLE_CLASS_STRING, PICKLE_CLASS_LIST, PICKLE_CLASS_MAP, PICKLE_CLASS_ENUM, PICKLE_CLASS_STREAM, PICKLE_CLASS_USER_BASE, ClassRegistry } from runtime.object

fn freshReg() -> ClassRegistry {
    var r = ClassRegistry()
    r.reset()
    r
}

test fn builtin_ids_and_names() {
    expect(PICKLE_CLASS_STRING).toBe(0)
    expect(PICKLE_CLASS_LIST).toBe(1)
    expect(PICKLE_CLASS_MAP).toBe(2)
    expect(PICKLE_CLASS_ENUM).toBe(7)
    expect(PICKLE_CLASS_STREAM).toBe(9)
    expect(PICKLE_CLASS_USER_BASE).toBe(10)
    var r = freshReg()
    expect(r.className(0)).toBe("string")
    expect(r.className(1)).toBe("List")
    expect(r.className(2)).toBe("Map")
    expect(r.className(9)).toBe("stream")
    expect(r.className(10)).toBe(none)
}

test fn register_user_classes() {
    var r = freshReg()
    var vecId = r.register("Vec", 3, 0, PICKLE_CLASS_LIST)
    expect(vecId).toBe(10)
    expect(r.register("Vec2", 3, 0, PICKLE_CLASS_LIST)).toBe(11)
    expect(r.className(10)).toBe("Vec")
    expect(r.className(11)).toBe("Vec2")
    expect(r.parent(10)).toBe(PICKLE_CLASS_LIST)
    expect(r.parent(11)).toBe(PICKLE_CLASS_LIST)
}

test fn register_invalid_and_root() {
    var r = freshReg()
    expect(r.className(-1)).toBe(none)
    expect(r.parent(-1)).toBe(0)
    var root = r.register("Root", 0, 0, 0)
    expect(root).toBe(10)
    expect(r.parent(root)).toBe(0)
}

test fn class_is_walk() {
    var r = freshReg()
    var vecId = r.register("Vec", 3, 0, PICKLE_CLASS_LIST)
    var deepId = r.register("DeepVec", 3, 0, vecId)
    expect(r.isSub(vecId, PICKLE_CLASS_LIST)).toBe(true)
    expect(r.isSub(deepId, PICKLE_CLASS_LIST)).toBe(true)
    expect(r.isSub(deepId, vecId)).toBe(true)
    expect(r.isSub(deepId, PICKLE_CLASS_MAP)).toBe(false)
    expect(r.isSub(vecId, PICKLE_CLASS_MAP)).toBe(false)
    expect(r.isSub(PICKLE_CLASS_STRING, PICKLE_CLASS_LIST)).toBe(false)
    expect(r.isSub(deepId, deepId)).toBe(true)
    expect(r.isSub(PICKLE_CLASS_STRING, PICKLE_CLASS_STRING)).toBe(true)
}

test fn reset_restores_builtins() {
    var r = freshReg()
    r.register("Vec", 3, 0, PICKLE_CLASS_LIST)
    r.reset()
    expect(r.className(10)).toBe(none)
    expect(len(r.descs)).toBe(10)
}