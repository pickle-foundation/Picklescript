module runtime.map_test

import { INITIAL_CAP, MAX_LOAD, overLoadFactor, keysCompatible, keyHasBytesContent, isStructuralKind, keysSnapshot, KIND_STRING, KIND_BOX, KIND_ENUM, KIND_COMPOSITE } from runtime.map

test fn capacity_constants() {
    expect(INITIAL_CAP).toBe(16)
    expect(MAX_LOAD).toBe(7)
}

test fn load_factor_trigger() {
    expect(overLoadFactor(0, 16)).toBe(false)
    expect(overLoadFactor(11, 16)).toBe(false)
    expect(overLoadFactor(12, 16)).toBe(true)
    expect(overLoadFactor(16, 16)).toBe(true)
    expect(overLoadFactor(6, 10)).toBe(false)
    expect(overLoadFactor(7, 10)).toBe(true)
}

test fn key_kind_aliasing() {
    expect(keysCompatible(KIND_STRING, KIND_STRING)).toBe(true)
    expect(keysCompatible(KIND_BOX, KIND_BOX)).toBe(true)
    expect(keysCompatible(KIND_ENUM, KIND_ENUM)).toBe(true)
    expect(keysCompatible(KIND_COMPOSITE, KIND_COMPOSITE)).toBe(true)
    expect(keysCompatible(KIND_STRING, KIND_BOX)).toBe(false)
    expect(keysCompatible(KIND_STRING, KIND_ENUM)).toBe(false)
    expect(keysCompatible(KIND_BOX, KIND_ENUM)).toBe(false)
    expect(keysCompatible(KIND_BOX, KIND_COMPOSITE)).toBe(false)
}

test fn key_content_policy() {
    expect(keyHasBytesContent(KIND_STRING)).toBe(true)
    expect(keyHasBytesContent(KIND_BOX)).toBe(false)
    expect(isStructuralKind(KIND_COMPOSITE)).toBe(true)
    expect(isStructuralKind(KIND_STRING)).toBe(false)
    expect(isStructuralKind(KIND_ENUM)).toBe(false)
}

test fn snapshots_are_fresh_copies() {
    var s = [1, 2]
    var a = keysSnapshot(s)
    var b = keysSnapshot(s)
    expect(len(a)).toBe(2)
    a[0] = 99
    expect(a[0]).toBe(99)
    expect(b[0]).toBe(1)
    expect(s[0]).toBe(1)
}