module runtime.abi_sysno

/// The raw Linux syscall numbers and argument shapes for AArch64.
///
/// The generic AArch64 table has no `access`, `unlink`, `rmdir`, `mkdir`,
/// `fork` or `dup2`, so those six keep their POSIX meaning through the
/// `*at`/`clone`/`dup3` forms the architecture does provide. Everything else
/// is a number change. `runtime.abi_sys_posix` sees only the functions below.

/// The instruction set this body was selected for. The CLI reads it through
/// `runtime.abi_sys` to pick the default `build --target`.
const SYS_ARCH: string = "arm64"

const AT_FDCWD: int = -100
const AT_REMOVEDIR: int = 512
const SIGCHLD: int = 17

/// `open(2)` bit that requires a directory. AArch64 is asm-generic here, so
/// `O_DIRECTORY` is `0x4000`; `0x10000` is `O_DIRECT` and must not be used.
const O_DIRECTORY: int = 16384

fn sysnoRead(fd: int, buf: int, n: int) -> int {
    sys_syscall(63, fd, buf, n, 0, 0, 0)
}

fn sysnoWrite(fd: int, buf: int, n: int) -> int {
    sys_syscall(64, fd, buf, n, 0, 0, 0)
}

fn sysnoClose(fd: int) -> int {
    sys_syscall(57, fd, 0, 0, 0, 0, 0)
}

fn sysnoMmap(addr: int, len: int, prot: int, flags: int, fd: int, off: int) -> int {
    sys_syscall(222, addr, len, prot, flags, fd, off)
}

fn sysnoMunmap(addr: int, len: int) -> int {
    sys_syscall(215, addr, len, 0, 0, 0, 0)
}

fn sysnoFutex(addr: int, op: int, val: int, ts: int) -> int {
    sys_syscall(98, addr, op, val, ts, 0, 0)
}

fn sysnoExitGroup(code: int) {
    let _ = sys_syscall(94, code, 0, 0, 0, 0, 0)
}

fn sysnoGettid() -> int {
    sys_syscall(178, 0, 0, 0, 0, 0, 0)
}

fn sysnoClockGettime(clk: int, ts: int) -> int {
    sys_syscall(113, clk, ts, 0, 0, 0, 0)
}

fn sysnoNanosleep(ts: int, rem: int) -> int {
    sys_syscall(101, ts, rem, 0, 0, 0, 0)
}

fn sysnoSchedYield() -> int {
    sys_syscall(124, 0, 0, 0, 0, 0, 0)
}

fn sysnoOpenat(dirfd: int, path: int, flags: int, mode: int) -> int {
    sys_syscall(56, dirfd, path, flags, mode, 0, 0)
}

fn sysnoAccess(path: int, mode: int) -> int {
    sys_syscall(48, AT_FDCWD, path, mode, 0, 0, 0)
}

fn sysnoUnlink(path: int) -> int {
    sys_syscall(35, AT_FDCWD, path, 0, 0, 0, 0)
}

fn sysnoRmdir(path: int) -> int {
    sys_syscall(35, AT_FDCWD, path, AT_REMOVEDIR, 0, 0, 0)
}

fn sysnoMkdir(path: int, mode: int) -> int {
    sys_syscall(34, AT_FDCWD, path, mode, 0, 0, 0)
}

fn sysnoGetcwd(buf: int, size: int) -> int {
    sys_syscall(17, buf, size, 0, 0, 0, 0)
}

fn sysnoChdir(path: int) -> int {
    sys_syscall(49, path, 0, 0, 0, 0, 0)
}

fn sysnoPipe2(fds: int, flags: int) -> int {
    sys_syscall(59, fds, flags, 0, 0, 0, 0)
}

/// `clone(SIGCHLD, 0, ...)` is the AArch64 spelling of `fork`: the child gets
/// a copy-on-write view of the address space and shares nothing writable.
fn sysnoFork() -> int {
    sys_syscall(220, SIGCHLD, 0, 0, 0, 0, 0)
}

fn sysnoExecve(path: int, argv: int, envp: int) -> int {
    sys_syscall(221, path, argv, envp, 0, 0, 0)
}

fn sysnoExit(code: int) {
    let _ = sys_syscall(93, code, 0, 0, 0, 0, 0)
}

fn sysnoDup2(oldfd: int, newfd: int) -> int {
    // `dup3` rejects equal descriptors where `dup2` returns the descriptor.
    if (oldfd == newfd) {
        return newfd
    }
    sys_syscall(24, oldfd, newfd, 0, 0, 0, 0)
}

fn sysnoWait4(pid: int, status: int, options: int, rusage: int) -> int {
    sys_syscall(260, pid, status, options, rusage, 0, 0)
}

fn sysnoKill(pid: int, sig: int) -> int {
    sys_syscall(129, pid, sig, 0, 0, 0, 0)
}

fn sysnoFcntl(fd: int, cmd: int, arg: int) -> int {
    sys_syscall(25, fd, cmd, arg, 0, 0, 0)
}

fn sysnoGetdents64(fd: int, buf: int, n: int) -> int {
    sys_syscall(61, fd, buf, n, 0, 0, 0)
}
