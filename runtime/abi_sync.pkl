module runtime.abi_sync

/// Port of the observable contract of `runtime/src/sync.rs` as real `#[symbol]`
/// bodies: a handle table plus the five non-closure primitive families - mutex,
/// cond, semaphore, atomic, and channel.
///
/// WHAT THIS OWNS. Of `sync.rs`'s thirteen ABI symbols, these twenty-six:
///
///   mutex(4)  new lock trylock unlock
///   cond(4)   new signal broadcast wait
///   sem(4)    new acquire try_acquire release
///   atomic(5) new load store add cas
///   channel(9) new cap len send try_send recv try_recv close closed
///
/// WHAT STAYS NATIVE - and why this is a hard rule, not a convenience. The
/// `#[symbol]` override is activated per imported module, so a handle's
/// registry must be chosen whole. A ported `*_new` registers in the port's
/// handle table; the matching `*_op` bodies must therefore also be ported, or
/// the native op would index the native `OBJECTS` table for a port-created
/// handle and answer "not a <what>". So each family below is ported as a
/// complete set.
///
/// PER-OBJECT SYNCHRONIZATION (Phase 4). Every blocking state block carries its
/// own lock word and condition cell, taken through the platform-neutral seam in
/// `runtime.abi_world`:
///
///   mutex    [0 kind=1, 1 permits=1, 2 held, 3 lock, 4 cv]
///   cond     [0 kind=2, 1 permits=0, 2 parked, 3 lock, 4 cv]
///   sem      [0 kind=3, 1 permits,    2 parked, 3 lock, 4 cv]
///   atomic   [0 kind=4, 1 value,      2 lock]
///   channel  [0 kind=6, 1 cap, 2 head, 3 count, 4 closed, 5 buf, 6 lock, 7 cv]
///
/// A channel's `buf` word is the address of a separate `cap`-word block holding
/// the ring (values are raw scalars, boxed only by `pickle_channel_try_recv`'s
/// `abiBoxI64` hand-off, the same shape the native `recv` returns unboxed).
///
/// Every primitive is a predicate loop: take the object lock, re-test the
/// predicate, `parkOn(lock, cv)` (which releases the lock for the duration of
/// the sleep), repeat. The lock is what makes the test-then-sleep race-free,
/// and it replaces the world lock the pre-Phase-4 bodies relied on.
///
/// SERIALIZED MODE. `runtime.abi_world` turns the lock calls into no-ops when
/// `PKL_GIL=1` is set and parks on the world lock instead. The bodies below are
/// unchanged: a no-op object lock plus a world-lock park is exactly the old
/// behaviour.
///
/// WAKE RULES. `mutex_unlock` and `cond_signal` wake one; `cond_broadcast`,
/// `sem_release`, and every channel state change wake all. Waking all is
/// coarse but keeps the channel correct without two separate notifiers: a
/// channel has at most one kind of waiter at a time, and a closed channel must
/// release both kinds. Wakes happen while the object lock is held: the woken
/// waiter cannot consume the notification before the predicate change lands.
///
/// ATOMICS. `add` and `cas` are read-modify-write and take the object's lock.
/// `load` and `store` are a single aligned 8-byte access, which x86-64 performs
/// atomically; they do not take it, so a spin on `load` stays cheap. (Nothing
/// weaker than an aligned machine word is ever used: the value is one `int`
/// word.) A caller that mixes `load`/`store` with `add`/`cas` without its own
/// ordering already has a data race in the language's sharing model.
///
/// THE HANDLE TABLE. One flat raw word block of state-block addresses, handle =
/// index + 1 (0 is the null handle), entries leaked for the process lifetime.
/// `register` and `ofKind` take `syncRegLock` because growth reallocates the
/// table and frees the old block: an unlocked reader could look up a handle in
/// a block that a concurrent grow just freed.
///
/// THE FATAL PATH. Wrong-kind and channel-protocol failures reproduce native
/// `panic::fatal` byte-for-byte on stderr and exit 1 (the same three-write +
/// `win_exit` seam `abi_expect.pkl` keeps): `fatal: pickle: handle {n} is not
/// {what}\n`, `fatal: pickle: send on closed channel\n`, `fatal: pickle:
/// receive on a closed, empty channel\n`, and `fatal: pickle: channel capacity
/// must be at least 1, got {cap}\n` with `{cap}` formatted by `abiStrFromI64`.
/// Programs importing this module never exercise these in-process (see the
/// expect-slice note: a reachable `fatal` inside a ported module's own test
/// would end the whole `pickle-cli test` suite); they are verified by the
/// standalone probes.

import { abiBoxI64 } from runtime.abi_box
import { abiStrFromI64 } from runtime.abi_string
import { writeStderr } from runtime.abi_stdio
import { lockAcquire, lockRelease, parkOn, wakeOn, wakeAllOn } from runtime.abi_world
import { STR_BYTES_OFF } from runtime.layout

const KIND_MUTEX: int = 1
const KIND_COND: int = 2
const KIND_SEM: int = 3
const KIND_ATOMIC: int = 4
const KIND_CHANNEL: int = 6

/// Word indexes of the per-object lock and condition cell. The two words are
/// always adjacent and always last, so `wordAddr` gives both.
const MUTEX_PERMITS: int = 1
const MUTEX_HELD: int = 2
const MUTEX_LOCK: int = 3
const MUTEX_CV: int = 4
const MUTEX_WORDS: int = 5

const COND_PERMITS: int = 1
const COND_PARKED: int = 2
const COND_LOCK: int = 3
const COND_CV: int = 4
const COND_WORDS: int = 5

const SEM_PERMITS: int = 1
const SEM_PARKED: int = 2
const SEM_LOCK: int = 3
const SEM_CV: int = 4
const SEM_WORDS: int = 5

const ATOMIC_VALUE: int = 1
const ATOMIC_LOCK: int = 2
const ATOMIC_WORDS: int = 3

const CH_CAP: int = 1
const CH_HEAD: int = 2
const CH_COUNT: int = 3
const CH_CLOSED: int = 4
const CH_BUF: int = 5
const CH_LOCK: int = 6
const CH_CV: int = 7
const CH_WORDS: int = 8

/// The handle registry: a flat word block of state-block addresses.
var syncBase: int = 0
var syncCap: int = 0
var syncCount: int = 0
const SYNC_INITIAL: int = 16

/// Serialises `register` against `ofKind`. Growth frees the old block, so a
/// reader without the lock could index a freed table.
var syncRegLock: int = 0

/// The capacity a block reaches for `idx` items under doubling growth: the
/// first power-of-2 multiple of `initial` strictly above `idx` (or the input
/// cap when it already fits). Duplicate of `abi_gc::blockCapGrown` - importing
/// it would activate `abi_gc`'s symbols in every importing image.
fn blockCapGrown(cap: int, idx: int, initial: int) -> int {
    if (idx < cap) {
        return cap
    }
    var c = cap
    if (c == 0) {
        c = initial
    }
    while (idx >= c) {
        c = c * 2
    }
    return c
}

/// Grow `base`/`cap` so `idx` (a word index) is in range: allocate a fresh
/// block of the grown capacity, copy the old words, zero the new tail, release
/// the old block, and return the new base. Duplicate of `abi_gc::ensureBlock`.
fn ensureBlock(base: int, cap: int, idx: int, initial: int) -> int {
    var newCap = blockCapGrown(cap, idx, initial)
    if (newCap == cap) {
        return base
    }
    unsafe {
        var fresh = alloc(int, newCap)
        var j = 0
        while (j < cap) {
            fresh[j] = (base as *int)[j]
            j = j + 1
        }
        var k = cap
        while (k < newCap) {
            fresh[k] = 0
            k = k + 1
        }
        if (base != 0) {
            free(base as *int)
        }
        return fresh as int
    }
}

/// Register `state` in the handle table; returns its one-based handle (the
/// post-push length, `sync.rs::register`). The caller must not hold the object
/// lock of `state`: the registry lock is independent, but keeping the two
/// disjoint makes the order trivially acyclic.
fn register(state: int) -> int {
    unsafe {
        lockAcquire((&syncRegLock) as int)
        var idx = syncCount
        syncBase = ensureBlock(syncBase, syncCap, idx, SYNC_INITIAL)
        syncCap = blockCapGrown(syncCap, idx, SYNC_INITIAL)
        (syncBase as *int)[idx] = state
        syncCount = idx + 1
        lockRelease((&syncRegLock) as int)
        return idx + 1
    }
}

/// The state block for `handle`, or null when the handle names nothing. The
/// caller must hold `syncRegLock`.
fn entryBlockLocked(handle: int) -> *int {
    if (handle < 1) {
        return 0 as *int
    }
    if (handle > syncCount) {
        return 0 as *int
    }
    unsafe {
        return ((syncBase as *int)[handle - 1]) as *int
    }
}

/// The state block for `handle` when its kind is `kind`, else null. Mirrors the
/// native `*_of` dispatch. Takes the registry lock so a concurrent grow cannot
/// free the table under the lookup.
fn ofKind(handle: int, kind: int) -> *int {
    unsafe {
        lockAcquire((&syncRegLock) as int)
        var b = entryBlockLocked(handle)
        if (b != 0 as *int) {
            if (b[0] != kind) {
                b = 0 as *int
            }
        }
        lockRelease((&syncRegLock) as int)
        return b
    }
}

/// Byte address of word `idx` in a state block.
fn wordAddr(b: *int, idx: int) -> int {
    return (b as int) + idx * 8
}

/// ---------------------------------------------------------------------------
/// THE FATAL CHANNEL (stderr spellings of `panic.rs::fatal`, as in `abi_expect`)
/// ---------------------------------------------------------------------------

fn emitLit(lit: string) -> int {
    unsafe {
        var p = &lit
        let _ = writeStderr((p as int) + STR_BYTES_OFF, len(lit))
        return 0
    }
}

fn emitStr(s: *int) -> int {
    unsafe {
        let _ = writeStderr((s as int) + STR_BYTES_OFF, s[3])
        return 0
    }
}

fn fatalExit() -> int {
    win_exit(1)
    return 0
}

/// `fatal: pickle: handle {n} is not {what}\n`, then exit 1.
fn fatalIsNot(handle: int, what: string) -> int {
    emitLit("fatal: ")
    emitLit("pickle: handle ")
    emitStr(abiStrFromI64(handle))
    emitLit(" is not ")
    emitLit(what)
    emitLit("\n")
    fatalExit()
    return 0
}

/// A fixed-message channel fatal without a handle.
fn fatalLit(msg: string) -> int {
    emitLit("fatal: ")
    emitLit(msg)
    emitLit("\n")
    fatalExit()
    return 0
}

/// `fatal: pickle: channel capacity must be at least 1, got {cap}\n`.
fn fatalCap(cap: int) -> int {
    emitLit("fatal: ")
    emitLit("pickle: channel capacity must be at least 1, got ")
    emitStr(abiStrFromI64(cap))
    emitLit("\n")
    fatalExit()
    return 0
}

/// ---------------------------------------------------------------------------
/// MUTEX
/// ---------------------------------------------------------------------------

#[symbol("pickle_mutex_new")]
fn abiMutexNew() -> int {
    unsafe {
        var b = alloc(int, MUTEX_WORDS)
        b[MUTEX_PERMITS] = 1
        b[MUTEX_HELD] = 0
        b[MUTEX_LOCK] = 0
        b[MUTEX_CV] = 0
        b[0] = KIND_MUTEX
        return register(b as int)
    }
}

/// Take the mutex. A single permit is consumed; a second acquisition by the
/// same thread is not recursive (flat ownership, like the backend lock).
#[symbol("pickle_mutex_lock")]
fn abiMutexLock(handle: int) -> int {
    var m = ofKind(handle, KIND_MUTEX)
    if (m == 0 as *int) {
        fatalIsNot(handle, "a mutex")
    }
    unsafe {
        lockAcquire(wordAddr(m, MUTEX_LOCK))
        while (m[MUTEX_PERMITS] < 1) {
            parkOn(wordAddr(m, MUTEX_LOCK), wordAddr(m, MUTEX_CV))
        }
        m[MUTEX_PERMITS] = m[MUTEX_PERMITS] - 1
        m[MUTEX_HELD] = 1
        lockRelease(wordAddr(m, MUTEX_LOCK))
    }
    return 0
}

#[symbol("pickle_mutex_trylock")]
fn abiMutexTryLock(handle: int) -> bool {
    var m = ofKind(handle, KIND_MUTEX)
    if (m == 0 as *int) {
        fatalIsNot(handle, "a mutex")
    }
    var taken = false
    unsafe {
        lockAcquire(wordAddr(m, MUTEX_LOCK))
        if (m[MUTEX_PERMITS] >= 1) {
            m[MUTEX_PERMITS] = m[MUTEX_PERMITS] - 1
            m[MUTEX_HELD] = 1
            taken = true
        }
        lockRelease(wordAddr(m, MUTEX_LOCK))
    }
    return taken
}

/// Release the mutex. Unlocking a mutex that is not held is a no-op (`sync.rs`
/// tolerates it).
#[symbol("pickle_mutex_unlock")]
fn abiMutexUnlock(handle: int) -> int {
    var m = ofKind(handle, KIND_MUTEX)
    if (m == 0 as *int) {
        fatalIsNot(handle, "a mutex")
    }
    unsafe {
        lockAcquire(wordAddr(m, MUTEX_LOCK))
        if (m[MUTEX_HELD] != 0) {
            m[MUTEX_HELD] = 0
            m[MUTEX_PERMITS] = m[MUTEX_PERMITS] + 1
            wakeOn(wordAddr(m, MUTEX_CV))
        }
        lockRelease(wordAddr(m, MUTEX_LOCK))
    }
    return 0
}

/// ---------------------------------------------------------------------------
/// COND
/// ---------------------------------------------------------------------------

#[symbol("pickle_cond_new")]
fn abiCondNew() -> int {
    unsafe {
        var b = alloc(int, COND_WORDS)
        b[COND_PERMITS] = 0
        b[COND_PARKED] = 0
        b[COND_LOCK] = 0
        b[COND_CV] = 0
        b[0] = KIND_COND
        return register(b as int)
    }
}

/// Store one notification. A signal with no waiter is *remembered*: the next
/// wait consumes the permit and returns immediately, which is the pre-Phase-4
/// contract (and the reason a predicate loop is still required for loops that
/// wait more than once).
#[symbol("pickle_cond_signal")]
fn abiCondSignal(handle: int) -> int {
    var c = ofKind(handle, KIND_COND)
    if (c == 0 as *int) {
        fatalIsNot(handle, "a cond")
    }
    unsafe {
        lockAcquire(wordAddr(c, COND_LOCK))
        c[COND_PERMITS] = c[COND_PERMITS] + 1
        wakeOn(wordAddr(c, COND_CV))
        lockRelease(wordAddr(c, COND_LOCK))
    }
    return 0
}

/// Store one notification per thread parked at the moment of the call, then
/// wake them all. Remembering the count keeps a broadcast from being lost when
/// a waiter has not reached `parkOn` yet.
#[symbol("pickle_cond_broadcast")]
fn abiCondBroadcast(handle: int) -> int {
    var c = ofKind(handle, KIND_COND)
    if (c == 0 as *int) {
        fatalIsNot(handle, "a cond")
    }
    unsafe {
        lockAcquire(wordAddr(c, COND_LOCK))
        let parked = c[COND_PARKED]
        c[COND_PERMITS] = c[COND_PERMITS] + parked
        wakeAllOn(wordAddr(c, COND_CV))
        lockRelease(wordAddr(c, COND_LOCK))
    }
    return 0
}

/// Release `mutex`, wait on `cond`, retake `mutex`. A null mutex waits without
/// one.
///
/// The user mutex is released *after* the condition lock is dropped and
/// retaken *before* it is acquired again: taking the two in the opposite order
/// would be an ABBA deadlock against a signaller that holds the mutex while it
/// signals. Nothing is lost in the gap because the notification is a permit,
/// not a pending wake.
#[symbol("pickle_cond_wait")]
fn abiCondWait(cond: int, mutex: int) -> int {
    var c = ofKind(cond, KIND_COND)
    if (c == 0 as *int) {
        fatalIsNot(cond, "a cond")
    }
    var haveMutex = false
    if (ofKind(mutex, KIND_MUTEX) != 0 as *int) {
        haveMutex = true
    }
    unsafe {
        lockAcquire(wordAddr(c, COND_LOCK))
        c[COND_PARKED] = c[COND_PARKED] + 1
        if (c[COND_PERMITS] >= 1) {
            // A notification is already pending: consume it without sleeping.
            c[COND_PERMITS] = c[COND_PERMITS] - 1
            c[COND_PARKED] = c[COND_PARKED] - 1
            lockRelease(wordAddr(c, COND_LOCK))
            return 0
        }
        lockRelease(wordAddr(c, COND_LOCK))
    }
    if (haveMutex) {
        let _ = abiMutexUnlock(mutex)
    }
    unsafe {
        lockAcquire(wordAddr(c, COND_LOCK))
        while (c[COND_PERMITS] < 1) {
            parkOn(wordAddr(c, COND_LOCK), wordAddr(c, COND_CV))
        }
        c[COND_PERMITS] = c[COND_PERMITS] - 1
        c[COND_PARKED] = c[COND_PARKED] - 1
        lockRelease(wordAddr(c, COND_LOCK))
    }
    if (haveMutex) {
        let _ = abiMutexLock(mutex)
    }
    return 0
}

/// ---------------------------------------------------------------------------
/// SEM
/// ---------------------------------------------------------------------------

#[symbol("pickle_sem_new")]
fn abiSemNew(permits: int) -> int {
    unsafe {
        var p = permits
        if (p < 0) {
            p = 0
        }
        var b = alloc(int, SEM_WORDS)
        b[SEM_PERMITS] = p
        b[SEM_PARKED] = 0
        b[SEM_LOCK] = 0
        b[SEM_CV] = 0
        b[0] = KIND_SEM
        return register(b as int)
    }
}

#[symbol("pickle_sem_acquire")]
fn abiSemAcquire(handle: int, n: int) -> int {
    var s = ofKind(handle, KIND_SEM)
    if (s == 0 as *int) {
        fatalIsNot(handle, "a semaphore")
    }
    var count = n
    if (count < 1) {
        count = 1
    }
    unsafe {
        lockAcquire(wordAddr(s, SEM_LOCK))
        while (s[SEM_PERMITS] < count) {
            parkOn(wordAddr(s, SEM_LOCK), wordAddr(s, SEM_CV))
        }
        s[SEM_PERMITS] = s[SEM_PERMITS] - count
        lockRelease(wordAddr(s, SEM_LOCK))
    }
    return 0
}

#[symbol("pickle_sem_try_acquire")]
fn abiSemTryAcquire(handle: int, n: int) -> bool {
    var s = ofKind(handle, KIND_SEM)
    if (s == 0 as *int) {
        fatalIsNot(handle, "a semaphore")
    }
    var count = n
    if (count < 1) {
        count = 1
    }
    var taken = false
    unsafe {
        lockAcquire(wordAddr(s, SEM_LOCK))
        if (s[SEM_PERMITS] >= count) {
            s[SEM_PERMITS] = s[SEM_PERMITS] - count
            taken = true
        }
        lockRelease(wordAddr(s, SEM_LOCK))
    }
    return taken
}

#[symbol("pickle_sem_release")]
fn abiSemRelease(handle: int, n: int) -> int {
    var s = ofKind(handle, KIND_SEM)
    if (s == 0 as *int) {
        fatalIsNot(handle, "a semaphore")
    }
    var count = n
    if (count < 1) {
        count = 1
    }
    unsafe {
        lockAcquire(wordAddr(s, SEM_LOCK))
        s[SEM_PERMITS] = s[SEM_PERMITS] + count
        wakeAllOn(wordAddr(s, SEM_CV))
        lockRelease(wordAddr(s, SEM_LOCK))
    }
    return 0
}

/// ---------------------------------------------------------------------------
/// ATOMIC
/// ---------------------------------------------------------------------------

#[symbol("pickle_atomic_new")]
fn abiAtomicNew(value: int) -> int {
    unsafe {
        var b = alloc(int, ATOMIC_WORDS)
        b[ATOMIC_VALUE] = value
        b[ATOMIC_LOCK] = 0
        b[0] = KIND_ATOMIC
        return register(b as int)
    }
}

#[symbol("pickle_atomic_load")]
fn abiAtomicLoad(handle: int) -> int {
    var a = ofKind(handle, KIND_ATOMIC)
    if (a == 0 as *int) {
        fatalIsNot(handle, "an atomic")
    }
    unsafe {
        return a[ATOMIC_VALUE]
    }
}

#[symbol("pickle_atomic_store")]
fn abiAtomicStore(handle: int, value: int) -> int {
    var a = ofKind(handle, KIND_ATOMIC)
    if (a == 0 as *int) {
        fatalIsNot(handle, "an atomic")
    }
    unsafe {
        a[ATOMIC_VALUE] = value
    }
    return 0
}

/// `fetch_add`: returns the value from before the addition. The read and the
/// write are one critical section: with the GIL gone, two plain accesses would
/// lose updates.
#[symbol("pickle_atomic_add")]
fn abiAtomicAdd(handle: int, delta: int) -> int {
    var a = ofKind(handle, KIND_ATOMIC)
    if (a == 0 as *int) {
        fatalIsNot(handle, "an atomic")
    }
    var old = 0
    unsafe {
        lockAcquire(wordAddr(a, ATOMIC_LOCK))
        old = a[ATOMIC_VALUE]
        a[ATOMIC_VALUE] = old + delta
        lockRelease(wordAddr(a, ATOMIC_LOCK))
    }
    return old
}

#[symbol("pickle_atomic_cas")]
fn abiAtomicCas(handle: int, expected: int, value: int) -> bool {
    var a = ofKind(handle, KIND_ATOMIC)
    if (a == 0 as *int) {
        fatalIsNot(handle, "an atomic")
    }
    var swapped = false
    unsafe {
        lockAcquire(wordAddr(a, ATOMIC_LOCK))
        if (a[ATOMIC_VALUE] == expected) {
            a[ATOMIC_VALUE] = value
            swapped = true
        }
        lockRelease(wordAddr(a, ATOMIC_LOCK))
    }
    return swapped
}

/// ---------------------------------------------------------------------------
/// CHANNEL
/// ---------------------------------------------------------------------------

/// `!closed && count == cap` - a send is blocked until a slot frees or the
/// channel closes. The caller holds the channel lock.
fn channelFull(ch: *int) -> bool {
    unsafe {
        return ch[CH_CLOSED] == 0 && ch[CH_COUNT] == ch[CH_CAP]
    }
}

/// `!closed && count == 0` - a receive is blocked until a value arrives or the
/// channel closes. The caller holds the channel lock.
fn channelEmpty(ch: *int) -> bool {
    unsafe {
        return ch[CH_CLOSED] == 0 && ch[CH_COUNT] == 0
    }
}

#[symbol("pickle_channel_new")]
fn abiChannelNew(cap: int) -> int {
    if (cap < 1) {
        fatalCap(cap)
    }
    unsafe {
        var buf = alloc(int, cap)
        var i = 0
        while (i < cap) {
            buf[i] = 0
            i = i + 1
        }
        var b = alloc(int, CH_WORDS)
        b[CH_CAP] = cap
        b[CH_HEAD] = 0
        b[CH_COUNT] = 0
        b[CH_CLOSED] = 0
        b[CH_BUF] = buf as int
        b[CH_LOCK] = 0
        b[CH_CV] = 0
        b[0] = KIND_CHANNEL
        return register(b as int)
    }
}

#[symbol("pickle_channel_cap")]
fn abiChannelCap(handle: int) -> int {
    var ch = ofKind(handle, KIND_CHANNEL)
    if (ch == 0 as *int) {
        fatalIsNot(handle, "a channel")
    }
    unsafe {
        return ch[CH_CAP]
    }
}

/// A snapshot: the ring is only modified under the lock, and a single aligned
/// word load is atomic, so the count is never torn.
#[symbol("pickle_channel_len")]
fn abiChannelLen(handle: int) -> int {
    var ch = ofKind(handle, KIND_CHANNEL)
    if (ch == 0 as *int) {
        fatalIsNot(handle, "a channel")
    }
    unsafe {
        return ch[CH_COUNT]
    }
}

#[symbol("pickle_channel_send")]
fn abiChannelSend(handle: int, value: int) -> int {
    var ch = ofKind(handle, KIND_CHANNEL)
    if (ch == 0 as *int) {
        fatalIsNot(handle, "a channel")
    }
    unsafe {
        lockAcquire(wordAddr(ch, CH_LOCK))
        while (channelFull(ch)) {
            parkOn(wordAddr(ch, CH_LOCK), wordAddr(ch, CH_CV))
        }
        if (ch[CH_CLOSED] != 0) {
            fatalLit("pickle: send on closed channel")
        }
        var i = (ch[CH_HEAD] + ch[CH_COUNT]) % ch[CH_CAP]
        (ch[CH_BUF] as *int)[i] = value
        ch[CH_COUNT] = ch[CH_COUNT] + 1
        wakeAllOn(wordAddr(ch, CH_CV))
        lockRelease(wordAddr(ch, CH_LOCK))
        return 0
    }
}

#[symbol("pickle_channel_try_send")]
fn abiChannelTrySend(handle: int, value: int) -> bool {
    var ch = ofKind(handle, KIND_CHANNEL)
    if (ch == 0 as *int) {
        fatalIsNot(handle, "a channel")
    }
    var sent = false
    unsafe {
        lockAcquire(wordAddr(ch, CH_LOCK))
        if (ch[CH_CLOSED] != 0) {
            fatalLit("pickle: send on closed channel")
        }
        if (ch[CH_COUNT] != ch[CH_CAP]) {
            var i = (ch[CH_HEAD] + ch[CH_COUNT]) % ch[CH_CAP]
            (ch[CH_BUF] as *int)[i] = value
            ch[CH_COUNT] = ch[CH_COUNT] + 1
            wakeAllOn(wordAddr(ch, CH_CV))
            sent = true
        }
        lockRelease(wordAddr(ch, CH_LOCK))
    }
    return sent
}

#[symbol("pickle_channel_recv")]
fn abiChannelRecv(handle: int) -> int {
    var ch = ofKind(handle, KIND_CHANNEL)
    if (ch == 0 as *int) {
        fatalIsNot(handle, "a channel")
    }
    unsafe {
        lockAcquire(wordAddr(ch, CH_LOCK))
        while (channelEmpty(ch)) {
            parkOn(wordAddr(ch, CH_LOCK), wordAddr(ch, CH_CV))
        }
        if (ch[CH_COUNT] == 0) {
            fatalLit("pickle: receive on a closed, empty channel")
        }
        var i = ch[CH_HEAD]
        var v = (ch[CH_BUF] as *int)[i]
        ch[CH_HEAD] = (ch[CH_HEAD] + 1) % ch[CH_CAP]
        ch[CH_COUNT] = ch[CH_COUNT] - 1
        wakeAllOn(wordAddr(ch, CH_CV))
        lockRelease(wordAddr(ch, CH_LOCK))
        return v
    }
}

/// A value if one is buffered, boxed through the ported `pickle_box_i64`;
/// null when empty, whether or not the channel is closed. The box is built
/// after the lock is released: boxing allocates, and an allocation may collect.
#[symbol("pickle_channel_try_recv")]
fn abiChannelTryRecv(handle: int) -> *int {
    var ch = ofKind(handle, KIND_CHANNEL)
    if (ch == 0 as *int) {
        fatalIsNot(handle, "a channel")
    }
    var v = 0
    var have = false
    unsafe {
        lockAcquire(wordAddr(ch, CH_LOCK))
        if (ch[CH_COUNT] != 0) {
            var i = ch[CH_HEAD]
            v = (ch[CH_BUF] as *int)[i]
            ch[CH_HEAD] = (ch[CH_HEAD] + 1) % ch[CH_CAP]
            ch[CH_COUNT] = ch[CH_COUNT] - 1
            wakeAllOn(wordAddr(ch, CH_CV))
            have = true
        }
        lockRelease(wordAddr(ch, CH_LOCK))
    }
    if (!have) {
        return 0 as *int
    }
    return abiBoxI64(v)
}

#[symbol("pickle_channel_close")]
fn abiChannelClose(handle: int) -> int {
    var ch = ofKind(handle, KIND_CHANNEL)
    if (ch == 0 as *int) {
        fatalIsNot(handle, "a channel")
    }
    unsafe {
        lockAcquire(wordAddr(ch, CH_LOCK))
        ch[CH_CLOSED] = 1
        wakeAllOn(wordAddr(ch, CH_CV))
        lockRelease(wordAddr(ch, CH_LOCK))
    }
    return 0
}

#[symbol("pickle_channel_closed")]
fn abiChannelClosed(handle: int) -> bool {
    var ch = ofKind(handle, KIND_CHANNEL)
    if (ch == 0 as *int) {
        fatalIsNot(handle, "a channel")
    }
    unsafe {
        return ch[CH_CLOSED] != 0
    }
}
