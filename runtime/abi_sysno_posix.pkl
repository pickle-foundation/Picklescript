module runtime.abi_sysno

/// The raw Linux syscall numbers and argument shapes for x86-64.
///
/// `runtime.abi_sys_posix` calls only these functions, so every syscall
/// number in the runtime lives in exactly one file per architecture. The
/// AArch64 body is `abi_sysno_posix_arm64.pkl`; the loader tries
/// `<name>_<platform>_<arch>.pkl` first, so an ARM64 build picks it without
/// the POSIX runtime naming an instruction set.

/// The instruction set this body was selected for. The CLI reads it through
/// `runtime.abi_sys` to pick the default `build --target`.
const SYS_ARCH: string = "x64"

const AT_FDCWD: int = -100
const AT_REMOVEDIR: int = 512
const SIGCHLD: int = 17

/// `open(2)` bit that requires a directory. The value is architecture-specific:
/// x86-64 puts `O_DIRECTORY` at `0x10000`, where AArch64 puts `O_DIRECT`.
const O_DIRECTORY: int = 65536

fn sysnoRead(fd: int, buf: int, n: int) -> int {
    sys_syscall(0, fd, buf, n, 0, 0, 0)
}

fn sysnoWrite(fd: int, buf: int, n: int) -> int {
    sys_syscall(1, fd, buf, n, 0, 0, 0)
}

fn sysnoClose(fd: int) -> int {
    sys_syscall(3, fd, 0, 0, 0, 0, 0)
}

fn sysnoMmap(addr: int, len: int, prot: int, flags: int, fd: int, off: int) -> int {
    sys_syscall(9, addr, len, prot, flags, fd, off)
}

fn sysnoMunmap(addr: int, len: int) -> int {
    sys_syscall(11, addr, len, 0, 0, 0, 0)
}

fn sysnoFutex(addr: int, op: int, val: int, ts: int) -> int {
    sys_syscall(202, addr, op, val, ts, 0, 0)
}

fn sysnoExitGroup(code: int) {
    let _ = sys_syscall(231, code, 0, 0, 0, 0, 0)
}

fn sysnoGettid() -> int {
    sys_syscall(186, 0, 0, 0, 0, 0, 0)
}

fn sysnoClockGettime(clk: int, ts: int) -> int {
    sys_syscall(228, clk, ts, 0, 0, 0, 0)
}

fn sysnoNanosleep(ts: int, rem: int) -> int {
    sys_syscall(35, ts, rem, 0, 0, 0, 0)
}

fn sysnoSchedYield() -> int {
    sys_syscall(24, 0, 0, 0, 0, 0, 0)
}

fn sysnoOpenat(dirfd: int, path: int, flags: int, mode: int) -> int {
    sys_syscall(257, dirfd, path, flags, mode, 0, 0)
}

fn sysnoAccess(path: int, mode: int) -> int {
    sys_syscall(21, path, mode, 0, 0, 0, 0)
}

fn sysnoUnlink(path: int) -> int {
    sys_syscall(87, path, 0, 0, 0, 0, 0)
}

fn sysnoRmdir(path: int) -> int {
    sys_syscall(84, path, 0, 0, 0, 0, 0)
}

fn sysnoMkdir(path: int, mode: int) -> int {
    sys_syscall(83, path, mode, 0, 0, 0, 0)
}

fn sysnoGetcwd(buf: int, size: int) -> int {
    sys_syscall(79, buf, size, 0, 0, 0, 0)
}

fn sysnoChdir(path: int) -> int {
    sys_syscall(80, path, 0, 0, 0, 0, 0)
}

fn sysnoPipe2(fds: int, flags: int) -> int {
    sys_syscall(293, fds, flags, 0, 0, 0, 0)
}

fn sysnoFork() -> int {
    sys_syscall(57, 0, 0, 0, 0, 0, 0)
}

fn sysnoExecve(path: int, argv: int, envp: int) -> int {
    sys_syscall(59, path, argv, envp, 0, 0, 0)
}

fn sysnoExit(code: int) {
    let _ = sys_syscall(60, code, 0, 0, 0, 0, 0)
}

fn sysnoDup2(oldfd: int, newfd: int) -> int {
    sys_syscall(33, oldfd, newfd, 0, 0, 0, 0)
}

fn sysnoWait4(pid: int, status: int, options: int, rusage: int) -> int {
    sys_syscall(61, pid, status, options, rusage, 0, 0)
}

fn sysnoKill(pid: int, sig: int) -> int {
    sys_syscall(62, pid, sig, 0, 0, 0, 0)
}

fn sysnoFcntl(fd: int, cmd: int, arg: int) -> int {
    sys_syscall(72, fd, cmd, arg, 0, 0, 0)
}

fn sysnoGetdents64(fd: int, buf: int, n: int) -> int {
    sys_syscall(217, fd, buf, n, 0, 0, 0)
}
