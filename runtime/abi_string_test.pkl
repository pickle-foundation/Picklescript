module runtime.abi_string_test

import { wordsFor, abiStrLen, abiStrConcat, abiStrCmp, abiStrGet, abiStrSet, abiStrFromBool, abiStrFromByte, abiStrFromChar, abiStrToBytes, abiStrFromList, abiStrStartsWith, abiStrEndsWith, abiStrStripPrefix, abiStrStripSuffix, abiStrIndexOf, abiStrLastIndexOf, abiStrCount, abiStrTrim, abiStrTrimStart, abiStrTrimEnd, abiStrSplitLines, abiStrSplitWhitespace, abiStrToUpper, abiStrToLower, abiStrSubstring, abiStrSplit, abiStrReplace, abiStrReplaceFirst, abiStrChars, abiStrRepeat, abiStrPadStart, abiStrPadEnd, abiStrFormat, abiListJoin, isScalar, utf8Len, leadByte, abiStrFromI64, newStr, newStrCap, maskStrTail, byteInto, abiStrAppendOwned, abiStrAppendTwo, strSubFast, shortInternWord } from runtime.abi_string
import { abiListNew, abiListLen, abiListGet, abiListPush } from runtime.abi_list
import { abiBoxI64, abiUnboxI64 } from runtime.abi_box
import { keyHash } from runtime.abi_map

/// WHY THE TESTS BUILD STRINGS INSTEAD OF WRITING THEM.
///
/// The ABI bodies take the `*int` the IR carries, and Pickle has NO source-level
/// `string` -> `*int` conversion: E0363 rejects the cast and E0308 rejects the
/// argument. That is not an oversight to work around in each test - it is the
/// contract. The emitter never converts a string in Pickle code either; it hands
/// the pointer straight through (emit.rs:6548 maps `IrTy::Str` to the call
/// unchanged). A test that needs a string object therefore has to get it from a
/// body that already returns `*int`, which is exactly the path the compiler
/// takes. `pickle_str_from_byte` is the natural constructor: it is the one
/// native body whose input is a plain `int` byte.
fn bytes1(a: int) -> *int {
    return abiStrFromByte(a)
}

fn bytes2(a: int, b: int) -> *int {
    return abiStrConcat(abiStrFromByte(a), abiStrFromByte(b))
}

fn bytes3(a: int, b: int, c: int) -> *int {
    return abiStrConcat(bytes2(a, b), abiStrFromByte(c))
}

fn bytes4(a: int, b: int, c: int, d: int) -> *int {
    return abiStrConcat(bytes2(a, b), bytes2(c, d))
}

test fn wordsFor_rounds_up_to_whole_words() {
    expect(wordsFor(0)).toBe(4)
    expect(wordsFor(1)).toBe(5)
    expect(wordsFor(8)).toBe(5)
    expect(wordsFor(9)).toBe(6)
}

test fn wordsFor_always_reserves_header_and_len() {
    // 3 header words plus the length word, so even a 0-byte string has a
    // payload slot to zero.
    expect(wordsFor(0)).toBe(4)
    expect(wordsFor(32)).toBe(8)
}

test fn str_get_reads_bytes_by_index() {
    let x = bytes3(97, 98, 99)
    expect(abiStrLen(x)).toBe(3)
    expect(abiStrGet(x, 0)).toBe(97)
    expect(abiStrGet(x, 1)).toBe(98)
    expect(abiStrGet(x, 2)).toBe(99)
}

test fn str_get_reads_bytes_of_multibyte_text() {
    // "e-acute" is C3 A9: the port reads raw bytes, not code points.
    let x = bytes2(195, 169)
    expect(abiStrLen(x)).toBe(2)
    expect(abiStrGet(x, 0)).toBe(195)
    expect(abiStrGet(x, 1)).toBe(169)
}

test fn str_get_out_of_range_returns_zero() {
    // GAP: native panics. See the abiStrGet doc comment.
    let x = bytes2(97, 98)
    expect(abiStrGet(x, 2)).toBe(0)
    expect(abiStrGet(x, 0 - 1)).toBe(0)
    expect(abiStrGet(abiStrFromByte(0), 1)).toBe(0)
}

test fn str_set_is_copy_on_write_and_leaves_the_original_alone() {
    let x = bytes3(97, 98, 99)
    let t = abiStrSet(x, 1, 122)
    expect(abiStrLen(t)).toBe(3)
    expect(abiStrGet(t, 0)).toBe(97)
    expect(abiStrGet(t, 1)).toBe(122)
    expect(abiStrGet(t, 2)).toBe(99)
    // The original is untouched: native allocates a fresh string, it does not
    // mutate in place.
    expect(abiStrGet(x, 1)).toBe(98)
    expect((t as int) == (x as int)).toBe(false)
}

test fn str_set_truncates_the_value_to_a_byte() {
    // Native writes `v as u8`, so 321 is 0x41 = 'A'.
    let t = abiStrSet(bytes1(63), 0, 321)
    expect(abiStrGet(t, 0)).toBe(65)
    expect(abiStrLen(t)).toBe(1)
}

test fn str_set_out_of_range_returns_the_input_unchanged() {
    // GAP: native panics. See the abiStrGet doc comment.
    let x = bytes2(97, 98)
    expect((abiStrSet(x, 5, 65) as int) == (x as int)).toBe(true)
    expect((abiStrSet(x, 0 - 1, 65) as int) == (x as int)).toBe(true)
}

test fn str_from_bool_spellings() {
    expect(abiStrLen(abiStrFromBool(true))).toBe(4)
    expect(abiStrLen(abiStrFromBool(false))).toBe(5)
    // "true" is 74 72 75 65 and "false" is 66 61 6C 73 65.
    expect(abiStrGet(abiStrFromBool(true), 0)).toBe(116)
    expect(abiStrGet(abiStrFromBool(true), 3)).toBe(101)
    expect(abiStrGet(abiStrFromBool(false), 0)).toBe(102)
    expect(abiStrGet(abiStrFromBool(false), 4)).toBe(101)
}

test fn str_from_byte_is_one_raw_byte() {
    expect(abiStrLen(abiStrFromByte(65))).toBe(1)
    expect(abiStrGet(abiStrFromByte(65), 0)).toBe(65)
    // Raw, not re-encoded: 0xC3 stays a single byte, which is what makes the
    // multi-byte text model round-trip.
    expect(abiStrLen(abiStrFromByte(195))).toBe(1)
    // Truncation, matching native `v as u8`.
    expect(abiStrGet(abiStrFromByte(321), 0)).toBe(65)
    expect(abiStrLen(abiStrFromByte(0))).toBe(1)
}

test fn utf8_length_matches_the_encoding_width() {
    expect(utf8Len(0)).toBe(1)
    expect(utf8Len(127)).toBe(1)
    expect(utf8Len(128)).toBe(2)
    expect(utf8Len(2047)).toBe(2)
    expect(utf8Len(2048)).toBe(3)
    expect(utf8Len(65535)).toBe(3)
    expect(utf8Len(65536)).toBe(4)
    expect(utf8Len(1114111)).toBe(4)
}

test fn scalar_range_excludes_surrogates_and_overflow() {
    expect(isScalar(0)).toBe(true)
    expect(isScalar(65)).toBe(true)
    expect(isScalar(1114111)).toBe(true)
    // D800..=DFFF are not Unicode scalar values.
    expect(isScalar(55296)).toBe(false)
    expect(isScalar(57343)).toBe(false)
    expect(isScalar(55295)).toBe(true)
    expect(isScalar(57344)).toBe(true)
    // Above U+10FFFF, and below zero.
    expect(isScalar(1114112)).toBe(false)
    expect(isScalar(0 - 1)).toBe(false)
}

test fn lead_byte_masks_the_code_point() {
    expect(leadByte(2, 0)).toBe(192)
    expect(leadByte(3, 0)).toBe(224)
    expect(leadByte(4, 0)).toBe(240)
    // U+00E9 -> C3 A9, U+FFFD -> EF BF BD, U+1F600 -> F0 9F 98 80.
    expect(leadByte(2, 233)).toBe(195)
    expect(leadByte(3, 65533)).toBe(239)
    expect(leadByte(4, 128512)).toBe(240)
}

test fn str_from_char_encodes_one_two_three_and_four_byte_forms() {
    // 'A'
    let one = abiStrFromChar(65)
    expect(abiStrLen(one)).toBe(1)
    expect(abiStrGet(one, 0)).toBe(65)
    // U+00E9 -> C3 A9
    let two = abiStrFromChar(233)
    expect(abiStrLen(two)).toBe(2)
    expect(abiStrGet(two, 0)).toBe(195)
    expect(abiStrGet(two, 1)).toBe(169)
    // U+FFFD -> EF BF BD
    let three = abiStrFromChar(65533)
    expect(abiStrLen(three)).toBe(3)
    expect(abiStrGet(three, 0)).toBe(239)
    expect(abiStrGet(three, 1)).toBe(191)
    expect(abiStrGet(three, 2)).toBe(189)
    // U+1F600 -> F0 9F 98 80
    let four = abiStrFromChar(128512)
    expect(abiStrLen(four)).toBe(4)
    expect(abiStrGet(four, 0)).toBe(240)
    expect(abiStrGet(four, 1)).toBe(159)
    expect(abiStrGet(four, 2)).toBe(152)
    expect(abiStrGet(four, 3)).toBe(128)
}

test fn str_from_char_replaces_invalid_code_points() {
    // Native: char::from_u32(v).unwrap_or('\u{FFFD}').
    let want = abiStrFromChar(65533)
    expect(abiStrCmp(abiStrFromChar(55296), want)).toBe(0)
    expect(abiStrCmp(abiStrFromChar(57343), want)).toBe(0)
    expect(abiStrCmp(abiStrFromChar(1114112), want)).toBe(0)
    expect(abiStrCmp(abiStrFromChar(0 - 1), want)).toBe(0)
}

test fn str_to_bytes_boxes_every_byte() {
    let bs = abiStrToBytes(bytes3(97, 98, 99))
    expect(abiListLen(bs)).toBe(3)
    expect(abiUnboxI64(abiListGet(bs, 0))).toBe(97)
    expect(abiUnboxI64(abiListGet(bs, 1))).toBe(98)
    expect(abiUnboxI64(abiListGet(bs, 2))).toBe(99)
}

test fn str_to_bytes_of_an_empty_string_is_an_empty_list() {
    // The empty string has to come from `str_from_list`, since `from_byte`
    // always produces exactly one byte.
    let empty = abiStrFromList(abiListNew(0))
    expect(abiStrLen(empty)).toBe(0)
    expect(abiListLen(abiStrToBytes(empty))).toBe(0)
}

test fn str_to_bytes_preserves_multibyte_content() {
    // bytes()/str() must round-trip exactly, which is the whole point of the
    // std.text model: "e-acute" + "euro sign".
    let bs = abiStrToBytes(bytes3(195, 169, 226))
    expect(abiListLen(bs)).toBe(3)
    expect(abiUnboxI64(abiListGet(bs, 0))).toBe(195)
    expect(abiUnboxI64(abiListGet(bs, 1))).toBe(169)
    expect(abiUnboxI64(abiListGet(bs, 2))).toBe(226)
}

test fn str_from_list_reverses_str_to_bytes() {
    let x = bytes3(104, 233, 108)
    let bs = abiStrToBytes(x)
    let back = abiStrFromList(bs)
    expect(abiStrLen(back)).toBe(abiStrLen(x))
    expect(abiStrCmp(back, x)).toBe(0)
}

test fn str_from_list_of_an_empty_list_is_an_empty_string() {
    let empty = abiListNew(0)
    expect(abiStrLen(abiStrFromList(empty))).toBe(0)
}

test fn str_from_list_truncates_out_of_range_bytes() {
    // GAP: native panics via the private pickle_panic_cstr. See abiStrFromList.
    // The checker keeps a `byte` in 0..=255, so an out-of-range element has to
    // be built through the raw ABI.
    let bs = abiListNew(1)
    abiListPush(bs, abiBoxI64(321))
    expect(abiStrGet(abiStrFromList(bs), 0)).toBe(65)
}

test fn str_starts_with_matches_prefix_bytes() {
    let x = bytes3(97, 98, 99)
    expect(abiStrStartsWith(x, bytes2(97, 98))).toBe(true)
    expect(abiStrStartsWith(x, bytes1(97))).toBe(true)
    expect(abiStrStartsWith(x, x)).toBe(true)
    expect(abiStrStartsWith(x, bytes2(98, 99))).toBe(false)
    expect(abiStrStartsWith(x, bytes2(97, 99))).toBe(false)
}

test fn str_starts_with_handles_empty_and_longer_prefixes() {
    let x = bytes2(97, 98)
    let empty = abiStrFromList(abiListNew(0))
    // An empty prefix is a prefix of every string, including the empty one.
    expect(abiStrStartsWith(x, empty)).toBe(true)
    expect(abiStrStartsWith(empty, empty)).toBe(true)
    // A longer prefix cannot match, even when its head matches.
    expect(abiStrStartsWith(x, bytes3(97, 98, 99))).toBe(false)
    expect(abiStrStartsWith(empty, bytes1(97))).toBe(false)
}

test fn str_ends_with_matches_suffix_bytes() {
    let x = bytes3(97, 98, 99)
    expect(abiStrEndsWith(x, bytes2(98, 99))).toBe(true)
    expect(abiStrEndsWith(x, bytes1(99))).toBe(true)
    expect(abiStrEndsWith(x, x)).toBe(true)
    expect(abiStrEndsWith(x, bytes2(97, 98))).toBe(false)
    expect(abiStrEndsWith(x, bytes2(97, 99))).toBe(false)
}

test fn str_ends_with_handles_empty_and_longer_suffixes() {
    let x = bytes2(97, 98)
    let empty = abiStrFromList(abiListNew(0))
    expect(abiStrEndsWith(x, empty)).toBe(true)
    expect(abiStrEndsWith(empty, empty)).toBe(true)
    expect(abiStrEndsWith(x, bytes3(97, 98, 99))).toBe(false)
    expect(abiStrEndsWith(empty, bytes1(97))).toBe(false)
}

test fn str_prefix_and_suffix_predicates_are_byte_exact() {
    // "e-acute" is C3 A9. A prefix/suffix that splits the pair is a different
    // byte string, so it must not match.
    let e = bytes2(195, 169)
    expect(abiStrStartsWith(e, bytes1(195))).toBe(true)
    expect(abiStrStartsWith(e, bytes1(169))).toBe(false)
    expect(abiStrEndsWith(e, bytes1(169))).toBe(true)
    expect(abiStrEndsWith(e, bytes1(195))).toBe(false)
}

test fn str_index_of_finds_byte_runs() {
    let x = bytes3(97, 98, 99)
    expect(abiUnboxI64(abiStrIndexOf(x, bytes1(97)))).toBe(0)
    expect(abiUnboxI64(abiStrIndexOf(x, bytes2(98, 99)))).toBe(1)
    expect(abiUnboxI64(abiStrIndexOf(x, x))).toBe(0)
    expect(abiStrIndexOf(x, bytes2(97, 99)) as int).toBe(0)
}

test fn str_index_of_returns_the_first_occurrence() {
    // "banana"
    let b = abiStrConcat(bytes3(98, 97, 110), bytes3(97, 110, 97))
    expect(abiUnboxI64(abiStrIndexOf(b, bytes2(97, 110)))).toBe(1)
    expect(abiUnboxI64(abiStrIndexOf(b, bytes2(110, 97)))).toBe(2)
    expect(abiUnboxI64(abiStrIndexOf(b, bytes1(97)))).toBe(1)
    expect(abiUnboxI64(abiStrIndexOf(b, bytes1(110)))).toBe(2)
}

test fn str_index_of_handles_empty_and_longer_needles() {
    let x = bytes2(97, 98)
    let empty = abiStrFromList(abiListNew(0))
    expect(abiUnboxI64(abiStrIndexOf(x, empty))).toBe(0)
    expect(abiUnboxI64(abiStrIndexOf(empty, empty))).toBe(0)
    expect(abiStrIndexOf(x, bytes3(97, 98, 99)) as int).toBe(0)
    expect(abiStrIndexOf(empty, bytes1(97)) as int).toBe(0)
}

test fn str_index_of_is_byte_exact() {
    let e = bytes2(195, 169)
    expect(abiUnboxI64(abiStrIndexOf(e, bytes1(195)))).toBe(0)
    expect(abiUnboxI64(abiStrIndexOf(e, bytes1(169)))).toBe(1)
    expect(abiStrIndexOf(e, bytes2(169, 195)) as int).toBe(0)
}

test fn str_trim_strips_ascii_whitespace_on_both_ends() {
    // "  hi  "
    let padded = abiStrConcat(bytes2(32, 32), abiStrConcat(bytes2(104, 105), bytes2(32, 32)))
    expect(abiStrCmp(abiStrTrim(padded), bytes2(104, 105))).toBe(0)
    // "\t\nhi\r": tab, LF and CR are all in the set.
    let ctl = abiStrConcat(bytes2(9, 10), abiStrConcat(bytes2(104, 105), bytes1(13)))
    expect(abiStrCmp(abiStrTrim(ctl), bytes2(104, 105))).toBe(0)
}

test fn str_trim_keeps_interior_whitespace() {
    // " a b "
    let x = abiStrConcat(bytes1(32), abiStrConcat(bytes3(97, 32, 98), bytes1(32)))
    let t = abiStrTrim(x)
    expect(abiStrLen(t)).toBe(3)
    expect(abiStrCmp(t, bytes3(97, 32, 98))).toBe(0)
}

test fn str_trim_of_all_whitespace_is_empty() {
    // " \t\n\r"
    let x = abiStrConcat(bytes2(32, 9), bytes2(10, 13))
    expect(abiStrLen(abiStrTrim(x))).toBe(0)
}

test fn str_trim_without_whitespace_returns_the_receiver() {
    let x = bytes2(104, 105)
    expect(abiStrCmp(abiStrTrim(x), x)).toBe(0)
    // Nothing to strip: the body returns `s` rather than allocating a copy.
    expect((abiStrTrim(x) as int) == (x as int)).toBe(true)
}

test fn str_trim_leaves_multibyte_content_alone() {
    // NBSP (C2 A0) is not ASCII whitespace, so "  <nbsp>e-acute  " trims to
    // "<nbsp>e-acute" without splitting either multibyte sequence.
    let pad = bytes2(32, 32)
    let body = abiStrConcat(bytes2(194, 160), bytes2(195, 169))
    let x = abiStrConcat(pad, abiStrConcat(body, pad))
    let t = abiStrTrim(x)
    expect(abiStrLen(t)).toBe(4)
    expect(abiStrCmp(t, body)).toBe(0)
}

test fn str_to_upper_maps_ascii_lowercase() {
    // "hello" -> "HELLO"
    let x = abiStrConcat(bytes3(104, 101, 108), bytes2(108, 111))
    expect(abiStrCmp(abiStrToUpper(x), abiStrConcat(bytes3(72, 69, 76), bytes2(76, 79)))).toBe(0)
}

test fn str_to_upper_leaves_non_letters_and_multibyte_alone() {
    // "a1 Z<e-acute>!" -> "A1 Z<e-acute>!"
    let tail = abiStrConcat(bytes2(90, 195), bytes2(169, 33))
    let x = abiStrConcat(bytes3(97, 49, 32), tail)
    let want = abiStrConcat(bytes3(65, 49, 32), tail)
    let u = abiStrToUpper(x)
    expect(abiStrLen(u)).toBe(7)
    expect(abiStrCmp(u, want)).toBe(0)
}

test fn str_to_lower_maps_ascii_uppercase() {
    // "HeLLo" -> "hello"
    let x = abiStrConcat(bytes3(72, 101, 76), bytes2(76, 111))
    expect(abiStrCmp(abiStrToLower(x), abiStrConcat(bytes3(104, 101, 108), bytes2(108, 111)))).toBe(0)
}

test fn str_to_lower_leaves_non_letters_and_multibyte_alone() {
    // "A1 z<e-acute>!" -> "a1 z<e-acute>!"
    let tail = abiStrConcat(bytes2(122, 195), bytes2(169, 33))
    let x = abiStrConcat(bytes3(65, 49, 32), tail)
    let want = abiStrConcat(bytes3(97, 49, 32), tail)
    let l = abiStrToLower(x)
    expect(abiStrLen(l)).toBe(7)
    expect(abiStrCmp(l, want)).toBe(0)
}

test fn str_case_mapping_of_empty_is_empty() {
    let empty = abiStrFromList(abiListNew(0))
    expect(abiStrLen(abiStrToUpper(empty))).toBe(0)
    expect(abiStrLen(abiStrToLower(empty))).toBe(0)
}

test fn str_case_mapping_returns_a_fresh_string() {
    // Even when nothing changes, the result is a new object, so mutating it
    // cannot alias the receiver.
    let x = bytes2(97, 98)
    expect((abiStrToUpper(x) as int) == (x as int)).toBe(false)
    expect((abiStrToLower(x) as int) == (x as int)).toBe(false)
    let upper = bytes2(65, 66)
    expect((abiStrToUpper(upper) as int) == (upper as int)).toBe(false)
}

test fn str_case_mapping_is_idempotent() {
    // "aB" -> "AB" -> "AB"; "aB" -> "ab" -> "ab"
    let x = bytes2(97, 66)
    let up = abiStrToUpper(x)
    expect(abiStrCmp(abiStrToUpper(up), up)).toBe(0)
    let low = abiStrToLower(x)
    expect(abiStrCmp(abiStrToLower(low), low)).toBe(0)
}

test fn str_substring_extracts_a_byte_span() {
    // "hello"[1, 4) = "ell"
    let x = abiStrConcat(bytes3(104, 101, 108), bytes2(108, 111))
    expect(abiStrCmp(abiStrSubstring(x, 1, 4), bytes3(101, 108, 108))).toBe(0)
}

test fn str_substring_clamps_both_bounds() {
    // "hello"
    let x = abiStrConcat(bytes3(104, 101, 108), bytes2(108, 111))
    // Negative start clamps to 0, over-long end clamps to len.
    expect(abiStrCmp(abiStrSubstring(x, 0 - 5, 2), bytes2(104, 101))).toBe(0)
    expect(abiStrCmp(abiStrSubstring(x, 3, 99), bytes2(108, 111))).toBe(0)
    // Empty and inverted spans are empty.
    expect(abiStrLen(abiStrSubstring(x, 2, 2))).toBe(0)
    expect(abiStrLen(abiStrSubstring(x, 4, 2))).toBe(0)
    // A start past the end clamps too.
    expect(abiStrLen(abiStrSubstring(x, 99, 100))).toBe(0)
}

test fn str_substring_of_empty_is_empty() {
    let empty = abiStrFromList(abiListNew(0))
    expect(abiStrLen(abiStrSubstring(empty, 0, 0))).toBe(0)
    expect(abiStrLen(abiStrSubstring(empty, 3, 7))).toBe(0)
}

test fn str_substring_full_span_is_a_fresh_copy() {
    let x = bytes2(97, 98)
    let whole = abiStrSubstring(x, 0, 2)
    expect(abiStrCmp(whole, x)).toBe(0)
    expect((whole as int) == (x as int)).toBe(false)
}

test fn str_substring_uses_byte_offsets() {
    // "a<e-acute>" is 61 C3 A9; [1, 3) is the two-byte scalar.
    let x = abiStrConcat(bytes1(97), bytes2(195, 169))
    let tail = abiStrSubstring(x, 1, 3)
    expect(abiStrLen(tail)).toBe(2)
    expect(abiStrCmp(tail, bytes2(195, 169))).toBe(0)
}

/// A cross-word span whose source word has the sign bit set used to OR the
/// arithmetic shift's sign fill over the tail bytes. This is the byte-level
/// shape: six ASCII bytes, a separator, then C3 A9 starting at byte 7.
fn crossWordProbe() -> *int {
    let s = newStr(10)
    var i = 0
    while (i < 6) {
        byteInto(s, i, 97)
        i = i + 1
    }
    byteInto(s, 6, 32)
    byteInto(s, 7, 195)
    byteInto(s, 8, 169)
    byteInto(s, 9, 32)
    return s
}

test fn str_sub_fast_cross_word_span_keeps_high_bytes() {
    let s = crossWordProbe()
    let p = strSubFast(s, 7, 9)
    expect(abiStrLen(p)).toBe(2)
    expect(abiStrGet(p, 0)).toBe(195)
    expect(abiStrGet(p, 1)).toBe(169)
}

test fn split_whitespace_cross_word_field_keeps_high_bytes() {
    let ws = abiStrSplitWhitespace(crossWordProbe())
    expect(abiListLen(ws)).toBe(2)
    let w1 = abiListGet(ws, 1)
    expect(abiStrLen(w1)).toBe(2)
    expect(abiStrGet(w1, 0)).toBe(195)
    expect(abiStrGet(w1, 1)).toBe(169)
    // Two bytes is inside the interned range, so the high bytes must survive
    // the payload packing and a second split must return the same object.
    let ws2 = abiStrSplitWhitespace(crossWordProbe())
    expect(w1 as int).toBe(abiListGet(ws2, 1) as int)
    expect(abiStrGet(abiListGet(ws2, 1), 0)).toBe(195)
    expect(abiStrGet(abiListGet(ws2, 1), 1)).toBe(169)
}

// ---------------------------------------------------------------------------
// Short-string interning
// ---------------------------------------------------------------------------
//
// `abiStrSplitWhitespace` and the one-byte-prefix `abiStrConcat` shape share one
// table: the benchmark's generated text is `"w" + str(id)`, so a query term and
// the document field it is looked up against are now the same object. These
// tests pin the observable contract that makes that safe - equal text has equal
// bytes and equal hashes, identity is only reused for equal text, longer fields
// and unshared operands keep the fresh path, and the mutating helpers copy.

test fn short_split_fields_are_interned_across_calls() {
    // "w1 w2"
    let s = abiStrConcat(bytes3(119, 49, 32), bytes2(119, 50))
    let a = abiStrSplitWhitespace(s)
    let b = abiStrSplitWhitespace(s)
    expect(abiListLen(a)).toBe(2)
    let w1 = abiListGet(a, 0)
    let w2 = abiListGet(a, 1)
    // Equal text yields the same object on every split.
    expect(w1 as int).toBe(abiListGet(b, 0) as int)
    expect(w2 as int).toBe(abiListGet(b, 1) as int)
    // Different text still yields different objects, with the right bytes.
    expect((w1 as int) != (w2 as int)).toBe(true)
    expect(abiStrLen(w1)).toBe(2)
    expect(abiStrGet(w1, 0)).toBe(119)
    expect(abiStrGet(w1, 1)).toBe(49)
    expect(abiStrGet(w2, 1)).toBe(50)
}

test fn whitespace_runs_still_produce_interned_fields() {
    // "w1\tw2\nw3\r\nw4"
    let s = abiStrConcat(abiStrConcat(bytes3(119, 49, 9), bytes3(119, 50, 10)),
                         abiStrConcat(bytes4(119, 51, 13, 10), bytes2(119, 52)))
    let ws = abiStrSplitWhitespace(s)
    expect(abiListLen(ws)).toBe(4)
    var i = 0
    while (i < 4) {
        let w = abiListGet(ws, i)
        expect(abiStrLen(w)).toBe(2)
        expect(abiStrGet(w, 0)).toBe(119)
        expect(abiStrGet(w, 1)).toBe(49 + i)
        i = i + 1
    }
    let again = abiStrSplitWhitespace(s)
    i = 0
    while (i < 4) {
        expect(abiListGet(ws, i) as int).toBe(abiListGet(again, i) as int)
        i = i + 1
    }
}

test fn an_interned_split_field_hashes_like_fresh_equal_text() {
    let ws = abiStrSplitWhitespace(bytes3(119, 52, 50)) // "w42"
    let interned = abiListGet(ws, 0)
    // Built through the general path: the pieces are unshared, so no interning.
    let fresh = abiStrConcat(bytes2(119, 52), bytes1(50))
    expect((interned as int) != (fresh as int)).toBe(true)
    expect(abiStrCmp(interned, fresh)).toBe(0)
    // The cached hash must equal the reference FNV walk over the same bytes;
    // otherwise a map probe using this key would look in the wrong chain.
    expect(keyHash(interned)).toBe(keyHash(fresh))
}

test fn a_prefixed_small_integer_concat_is_interned_with_the_split_field() {
    let name = abiStrConcat(bytes1(119), abiStrFromI64(42))
    let again = abiStrConcat(bytes1(119), abiStrFromI64(42))
    let ws = abiStrSplitWhitespace(bytes3(119, 52, 50)) // "w42"
    expect(abiStrLen(name)).toBe(3)
    // Repeated builds agree...
    expect(name as int).toBe(again as int)
    // ...and agree with a split field of the same text, which is what turns
    // the benchmark's document-map lookups into identity hits.
    expect(name as int).toBe(abiListGet(ws, 0) as int)
}

test fn a_prefixed_negative_integer_concat_is_interned() {
    let name = abiStrConcat(bytes1(119), abiStrFromI64(0 - 7))
    let ws = abiStrSplitWhitespace(abiStrConcat(bytes2(119, 45), bytes1(55))) // "w-7"
    expect(abiStrLen(name)).toBe(3)
    expect(name as int).toBe(abiListGet(ws, 0) as int)
    expect(abiStrGet(name, 1)).toBe(45)
    expect(abiStrGet(name, 2)).toBe(55)
}

test fn a_concat_with_a_fresh_short_operand_stays_fresh() {
    // "ab" comes from the general concat path and is not shared, so "w" + "ab"
    // must not be interned. Interning is only safe for operands whose
    // immutability is already proven.
    let tail = abiStrConcat(bytes1(97), bytes1(98))
    let joined = abiStrConcat(bytes1(119), tail)
    let ws = abiStrSplitWhitespace(bytes3(119, 97, 98)) // "wab"
    expect(abiStrLen(joined)).toBe(3)
    expect(abiStrCmp(joined, abiListGet(ws, 0))).toBe(0)
    expect((joined as int) != (abiListGet(ws, 0) as int)).toBe(true)
}

test fn a_two_byte_prefix_concat_stays_fresh() {
    let joined = abiStrConcat(bytes2(97, 98), abiStrFromI64(7)) // "ab7"
    let ws = abiStrSplitWhitespace(bytes3(97, 98, 55))
    expect(abiStrLen(joined)).toBe(3)
    expect(abiStrCmp(joined, abiListGet(ws, 0))).toBe(0)
    expect((joined as int) != (abiListGet(ws, 0) as int)).toBe(true)
}

test fn a_five_thousand_concat_stays_fresh() {
    // `str(int)` only interns -999..999. "5000" is a normal heap string, so the
    // prefix interning path must fall through rather than trust it.
    let tail = abiStrFromI64(5000)
    let joined = abiStrConcat(bytes1(119), tail) // "w5000"
    let ws = abiStrSplitWhitespace(abiStrConcat(bytes3(119, 53, 48), bytes2(48, 48)))
    expect(abiStrLen(joined)).toBe(5)
    expect(abiStrCmp(joined, abiListGet(ws, 0))).toBe(0)
    expect((joined as int) != (abiListGet(ws, 0) as int)).toBe(true)
}

test fn long_split_fields_are_not_interned() {
    // Nine bytes is one past the interned range; every split allocates.
    let nine = abiStrRepeat(bytes1(97), 9)
    let a = abiStrSplitWhitespace(nine)
    let b = abiStrSplitWhitespace(nine)
    expect(abiStrLen(abiListGet(a, 0))).toBe(9)
    expect((abiListGet(a, 0) as int) != (abiListGet(b, 0) as int)).toBe(true)
}

test fn appending_to_an_interned_split_field_does_not_mutate_it() {
    let ws = abiStrSplitWhitespace(bytes2(119, 49)) // "w1"
    let w = abiListGet(ws, 0)
    let longer = abiStrAppendOwned(w, bytes1(33))
    expect(abiStrLen(longer)).toBe(3)
    expect(abiStrGet(longer, 2)).toBe(33)
    // The shared interned object keeps its original length and bytes, so a
    // later split of "w1" still sees "w1".
    expect(abiStrLen(w)).toBe(2)
    let ws2 = abiStrSplitWhitespace(bytes2(119, 49))
    expect(abiStrLen(abiListGet(ws2, 0))).toBe(2)
    expect(abiStrGet(abiListGet(ws2, 0), 1)).toBe(49)
}

fn strList(items: List<*int>) -> *int {
    var l = abiListNew(0)
    for (it in items) {
        abiListPush(l, it)
    }
    return l
}

test fn list_join_of_an_empty_list_is_empty() {
    let empty = abiListNew(0)
    let sep = bytes1(44)
    expect(abiStrLen(abiListJoin(empty, sep))).toBe(0)
}

test fn list_join_inserts_the_separator() {
    // ["a", "b", "c"] joined with "," = "a,b,c"
    let l = strList([bytes1(97), bytes1(98), bytes1(99)])
    let j = abiListJoin(l, bytes1(44))
    expect(abiStrLen(j)).toBe(5)
    expect(abiStrCmp(j, abiStrConcat(bytes3(97, 44, 98), bytes2(44, 99)))).toBe(0)
}

test fn list_join_of_one_element_has_no_separator() {
    let l = strList([bytes2(104, 105)])
    let j = abiListJoin(l, bytes1(44))
    expect(abiStrCmp(j, bytes2(104, 105))).toBe(0)
    // A fresh string, not the element itself.
    expect((j as int) == (abiListGet(l, 0) as int)).toBe(false)
}

test fn list_join_with_an_empty_separator_concatenates() {
    let l = strList([bytes1(97), bytes1(98), bytes1(99)])
    let empty = abiStrFromList(abiListNew(0))
    expect(abiStrCmp(abiListJoin(l, empty), bytes3(97, 98, 99))).toBe(0)
}

test fn list_join_keeps_empty_elements() {
    // ["", ""] joined with "," = ","
    let empty = abiStrFromList(abiListNew(0))
    let l = strList([empty, empty])
    let j = abiListJoin(l, bytes1(44))
    expect(abiStrLen(j)).toBe(1)
    expect(abiStrCmp(j, bytes1(44))).toBe(0)
}

test fn list_join_copies_multibyte_elements_and_separator() {
    // "<e-acute>|<u-umlaut>" = C3 A9 7C C3 BC
    let l = strList([bytes2(195, 169), bytes2(195, 188)])
    let j = abiListJoin(l, bytes1(124))
    expect(abiStrLen(j)).toBe(5)
    expect(abiStrCmp(j, abiStrConcat(bytes2(195, 169), abiStrConcat(bytes1(124), bytes2(195, 188))))).toBe(0)
}

fn fieldAt(l: *int, i: int) -> *int {
    return abiListGet(l, i)
}

test fn str_split_returns_the_fields() {
    // "a,b,c" split on ","
    let s = abiStrConcat(abiStrConcat(bytes2(97, 44), bytes2(98, 44)), bytes1(99))
    let f = abiStrSplit(s, bytes1(44))
    expect(abiListLen(f)).toBe(3)
    expect(abiStrCmp(fieldAt(f, 0), bytes1(97))).toBe(0)
    expect(abiStrCmp(fieldAt(f, 1), bytes1(98))).toBe(0)
    expect(abiStrCmp(fieldAt(f, 2), bytes1(99))).toBe(0)
}

test fn str_split_keeps_empty_fields() {
    // ",a,," has four fields: "", "a", "", ""
    let s = abiStrConcat(bytes2(44, 97), bytes2(44, 44))
    let f = abiStrSplit(s, bytes1(44))
    expect(abiListLen(f)).toBe(4)
    expect(abiStrLen(fieldAt(f, 0))).toBe(0)
    expect(abiStrCmp(fieldAt(f, 1), bytes1(97))).toBe(0)
    expect(abiStrLen(fieldAt(f, 2))).toBe(0)
    expect(abiStrLen(fieldAt(f, 3))).toBe(0)
}

test fn str_split_without_a_match_is_the_whole_string() {
    let f = abiStrSplit(bytes3(97, 98, 99), bytes1(44))
    expect(abiListLen(f)).toBe(1)
    expect(abiStrCmp(fieldAt(f, 0), bytes3(97, 98, 99))).toBe(0)
}

test fn str_split_of_empty_is_one_empty_field() {
    let empty = abiStrFromList(abiListNew(0))
    let f = abiStrSplit(empty, bytes1(44))
    expect(abiListLen(f)).toBe(1)
    expect(abiStrLen(fieldAt(f, 0))).toBe(0)
}

test fn str_split_with_empty_separator_is_the_whole_string() {
    let f = abiStrSplit(bytes3(97, 98, 99), abiStrFromList(abiListNew(0)))
    expect(abiListLen(f)).toBe(1)
    expect(abiStrCmp(fieldAt(f, 0), bytes3(97, 98, 99))).toBe(0)
}

test fn str_split_matches_do_not_overlap() {
    // "aaa" split on "aa" is ["", "a"]
    let f = abiStrSplit(bytes3(97, 97, 97), bytes2(97, 97))
    expect(abiListLen(f)).toBe(2)
    expect(abiStrLen(fieldAt(f, 0))).toBe(0)
    expect(abiStrCmp(fieldAt(f, 1), bytes1(97))).toBe(0)
}

test fn str_split_keeps_multibyte_fields_intact() {
    // "<e-acute>,<u-umlaut>"
    let s = abiStrConcat(bytes2(195, 169), abiStrConcat(bytes1(44), bytes2(195, 188)))
    let f = abiStrSplit(s, bytes1(44))
    expect(abiListLen(f)).toBe(2)
    expect(abiStrCmp(fieldAt(f, 0), bytes2(195, 169))).toBe(0)
    expect(abiStrCmp(fieldAt(f, 1), bytes2(195, 188))).toBe(0)
}

test fn str_replace_replaces_every_match() {
    // "a-b-c" -> "a+b+c"
    let s = abiStrConcat(abiStrConcat(bytes2(97, 45), bytes2(98, 45)), bytes1(99))
    let r = abiStrReplace(s, bytes1(45), bytes1(43))
    expect(abiStrLen(r)).toBe(5)
    expect(abiStrCmp(r, abiStrConcat(abiStrConcat(bytes2(97, 43), bytes2(98, 43)), bytes1(99)))).toBe(0)
}

test fn str_replace_without_a_match_is_a_fresh_copy() {
    let s = bytes3(97, 98, 99)
    let r = abiStrReplace(s, bytes1(120), bytes1(121))
    expect(abiStrCmp(r, s)).toBe(0)
    expect((r as int) == (s as int)).toBe(false)
}

test fn str_replace_handles_longer_and_empty_replacements() {
    // "a.b" -> "a::b"
    let s = bytes3(97, 46, 98)
    let r = abiStrReplace(s, bytes1(46), bytes2(58, 58))
    expect(abiStrCmp(r, abiStrConcat(bytes2(97, 58), bytes2(58, 98)))).toBe(0)
    // "abc" -> "ac"
    let d = abiStrReplace(bytes3(97, 98, 99), bytes1(98), abiStrFromList(abiListNew(0)))
    expect(abiStrCmp(d, bytes2(97, 99))).toBe(0)
}

test fn str_replace_with_empty_from_is_unchanged() {
    let s = bytes3(97, 98, 99)
    let r = abiStrReplace(s, abiStrFromList(abiListNew(0)), bytes1(88))
    expect(abiStrCmp(r, s)).toBe(0)
    expect((r as int) == (s as int)).toBe(false)
}

test fn str_replace_matches_do_not_overlap() {
    // "aaa" replacing "aa" with "b" is "ba"
    let r = abiStrReplace(bytes3(97, 97, 97), bytes2(97, 97), bytes1(98))
    expect(abiStrCmp(r, bytes2(98, 97))).toBe(0)
}

test fn str_chars_splits_ascii() {
    let c = abiStrChars(bytes3(97, 98, 99))
    expect(abiListLen(c)).toBe(3)
    expect(abiStrCmp(fieldAt(c, 0), bytes1(97))).toBe(0)
    expect(abiStrCmp(fieldAt(c, 2), bytes1(99))).toBe(0)
}

test fn str_chars_keeps_multibyte_scalars_whole() {
    // "a<e-acute>" -> "a", C3 A9
    let c = abiStrChars(abiStrConcat(bytes1(97), bytes2(195, 169)))
    expect(abiListLen(c)).toBe(2)
    expect(abiStrCmp(fieldAt(c, 0), bytes1(97))).toBe(0)
    expect(abiStrLen(fieldAt(c, 1))).toBe(2)
    expect(abiStrCmp(fieldAt(c, 1), bytes2(195, 169))).toBe(0)
}

test fn str_chars_of_empty_is_empty() {
    let c = abiStrChars(abiStrFromList(abiListNew(0)))
    expect(abiListLen(c)).toBe(0)
}

test fn str_chars_treats_a_lone_continuation_byte_as_one_element() {
    let c = abiStrChars(bytes1(169))
    expect(abiListLen(c)).toBe(1)
    expect(abiStrLen(fieldAt(c, 0))).toBe(1)
    expect(abiStrCmp(fieldAt(c, 0), bytes1(169))).toBe(0)
}

test fn str_chars_clamps_a_truncated_sequence() {
    // A two-byte lead with no continuation still makes progress.
    let c = abiStrChars(bytes1(195))
    expect(abiListLen(c)).toBe(1)
    expect(abiStrLen(fieldAt(c, 0))).toBe(1)
}

test fn str_format_substitutes_one_slot() {
    // "a%s" with ["b"] = "ab"
    let f = abiStrFormat(bytes3(97, 37, 115), strList([bytes1(98)]))
    expect(abiStrCmp(f, bytes2(97, 98))).toBe(0)
}

test fn str_format_joins_multiple_slots() {
    // "%s%s" with ["a", "b"] = "ab"
    let f = abiStrFormat(bytes4(37, 115, 37, 115), strList([bytes1(97), bytes1(98)]))
    expect(abiStrCmp(f, bytes2(97, 98))).toBe(0)
}

test fn str_format_keeps_text_around_slots() {
    // "a%sb" with ["-"] = "a-b"
    let f = abiStrFormat(bytes4(97, 37, 115, 98), strList([bytes1(45)]))
    expect(abiStrCmp(f, bytes3(97, 45, 98))).toBe(0)
}

test fn str_format_escapes_a_percent() {
    // "100%%" = "100%"
    let t = abiStrConcat(bytes3(49, 48, 48), bytes2(37, 37))
    let f = abiStrFormat(t, abiListNew(0))
    expect(abiStrCmp(f, bytes4(49, 48, 48, 37))).toBe(0)
}

test fn str_format_copies_unknown_percent_sequences() {
    // "%x" is not a slot, so it survives unchanged.
    let f = abiStrFormat(bytes2(37, 120), abiListNew(0))
    expect(abiStrCmp(f, bytes2(37, 120))).toBe(0)
}

test fn str_format_leaves_missing_slots_literal() {
    // "%s%s" with ["a"] = "a%s"
    let f = abiStrFormat(bytes4(37, 115, 37, 115), strList([bytes1(97)]))
    expect(abiStrCmp(f, bytes3(97, 37, 115))).toBe(0)
    expect(abiStrLen(f)).toBe(3)
}

test fn str_format_ignores_extra_parts() {
    // "%s" with ["a", "b"] = "a"
    let f = abiStrFormat(bytes2(37, 115), strList([bytes1(97), bytes1(98)]))
    expect(abiStrCmp(f, bytes1(97))).toBe(0)
}

test fn str_format_of_a_template_without_slots_copies_it() {
    let f = abiStrFormat(bytes2(104, 105), strList([bytes1(97)]))
    expect(abiStrCmp(f, bytes2(104, 105))).toBe(0)
}
test fn str_repeat_copies_the_whole_string() {
    let s = bytes2(97, 98)
    let r = abiStrRepeat(s, 3)
    expect(abiStrLen(r)).toBe(6)
    expect(abiStrCmp(r, abiStrConcat(abiStrConcat(bytes2(97, 98), bytes2(97, 98)), bytes2(97, 98)))).toBe(0)
}

test fn str_repeat_of_zero_or_less_is_empty() {
    let s = bytes2(97, 98)
    expect(abiStrLen(abiStrRepeat(s, 0))).toBe(0)
    expect(abiStrLen(abiStrRepeat(s, -3))).toBe(0)
    expect(abiStrLen(abiStrRepeat(abiStrRepeat(s, 0), 4))).toBe(0)
}

test fn str_pad_start_fills_from_the_cycle() {
    // "abc".padStart(6, "xy") == "xyxabc"
    let r = abiStrPadStart(bytes3(97, 98, 99), 6, bytes2(120, 121))
    expect(abiStrLen(r)).toBe(6)
    expect(abiStrCmp(r, abiStrConcat(bytes3(120, 121, 120), bytes3(97, 98, 99)))).toBe(0)
}

test fn str_pad_start_never_truncates() {
    let s = bytes3(97, 98, 99)
    let pad = bytes2(120, 121)
    expect(abiStrCmp(abiStrPadStart(s, 3, pad), s)).toBe(0)
    expect(abiStrCmp(abiStrPadStart(s, 2, pad), s)).toBe(0)
    expect(abiStrCmp(abiStrPadStart(s, -1, pad), s)).toBe(0)
}

test fn str_pad_end_fills_from_the_cycle() {
    // "abc".padEnd(6, "xy") == "abcxyx"
    let r = abiStrPadEnd(bytes3(97, 98, 99), 6, bytes2(120, 121))
    expect(abiStrLen(r)).toBe(6)
    expect(abiStrCmp(r, abiStrConcat(bytes3(97, 98, 99), bytes3(120, 121, 120)))).toBe(0)
}

test fn str_pad_end_never_truncates() {
    let s = bytes3(97, 98, 99)
    let pad = bytes2(120, 121)
    expect(abiStrCmp(abiStrPadEnd(s, 3, pad), s)).toBe(0)
    expect(abiStrCmp(abiStrPadEnd(s, 2, pad), s)).toBe(0)
}

test fn str_padding_with_an_empty_pad_is_a_copy() {
    let s = bytes3(97, 98, 99)
    let empty = abiStrRepeat(bytes1(0), 0)
    expect(abiStrCmp(abiStrPadStart(s, 6, empty), s)).toBe(0)
    expect(abiStrCmp(abiStrPadEnd(s, 6, empty), s)).toBe(0)
}

test fn str_padding_can_fill_a_completely_empty_string() {
    let empty = abiStrRepeat(bytes1(0), 0)
    let r = abiStrPadStart(empty, 4, bytes2(97, 98))
    expect(abiStrLen(r)).toBe(4)
    expect(abiStrCmp(r, bytes4(97, 98, 97, 98))).toBe(0)
    let q = abiStrPadEnd(empty, 4, bytes2(97, 98))
    expect(abiStrCmp(q, bytes4(97, 98, 97, 98))).toBe(0)
}

test fn str_last_index_of_finds_the_final_match() {
    // "abcabc": the last "bc" starts at byte 4, the last "a" at 3.
    let s = abiStrConcat(bytes3(97, 98, 99), bytes3(97, 98, 99))
    expect(abiUnboxI64(abiStrLastIndexOf(s, bytes2(98, 99)))).toBe(4)
    expect(abiUnboxI64(abiStrLastIndexOf(s, bytes1(97)))).toBe(3)
}

test fn str_last_index_of_absent_is_null() {
    let s = bytes3(97, 98, 99)
    expect(abiStrLastIndexOf(s, bytes1(122)) as int).toBe(0)
    expect(abiStrLastIndexOf(s, bytes4(97, 98, 99, 100)) as int).toBe(0)
}

test fn str_last_index_of_empty_needle_is_the_end() {
    let s = bytes3(97, 98, 99)
    expect(abiUnboxI64(abiStrLastIndexOf(s, abiStrRepeat(bytes1(0), 0)))).toBe(3)
}

test fn str_count_tallies_non_overlapping_matches() {
    let s = bytes3(97, 97, 97)
    expect(abiStrCount(s, bytes1(97))).toBe(3)
    expect(abiStrCount(s, bytes2(97, 97))).toBe(1)
    expect(abiStrCount(s, bytes1(122))).toBe(0)
    expect(abiStrCount(s, abiStrRepeat(bytes1(0), 0))).toBe(0)
}

test fn str_trim_start_strips_leading_whitespace_only() {
    // "  hi" -> "hi"
    expect(abiStrCmp(abiStrTrimStart(bytes4(32, 32, 104, 105)), bytes2(104, 105))).toBe(0)
    // "\t\r\n hi" -> "hi"
    let mixed = abiStrConcat(bytes4(9, 13, 10, 32), bytes2(104, 105))
    expect(abiStrCmp(abiStrTrimStart(mixed), bytes2(104, 105))).toBe(0)
    // Trailing whitespace is untouched.
    expect(abiStrLen(abiStrTrimStart(bytes2(104, 32)))).toBe(2)
}

test fn str_trim_start_returns_the_input_when_nothing_strips() {
    let x = bytes2(104, 105)
    expect((abiStrTrimStart(x) as int) == (x as int)).toBe(true)
    // All-whitespace input strips to the empty string.
    expect(abiStrLen(abiStrTrimStart(bytes1(32)))).toBe(0)
}

test fn str_trim_end_strips_trailing_whitespace_only() {
    // "hi  " -> "hi"
    expect(abiStrCmp(abiStrTrimEnd(bytes4(104, 105, 32, 32)), bytes2(104, 105))).toBe(0)
    // "hi \n\r\t" -> "hi"
    let mixed = abiStrConcat(bytes2(104, 105), bytes4(32, 10, 13, 9))
    expect(abiStrCmp(abiStrTrimEnd(mixed), bytes2(104, 105))).toBe(0)
    // Leading whitespace is untouched.
    expect(abiStrLen(abiStrTrimEnd(bytes2(32, 104)))).toBe(2)
}

test fn str_trim_end_returns_the_input_when_nothing_strips() {
    let x = bytes2(104, 105)
    expect((abiStrTrimEnd(x) as int) == (x as int)).toBe(true)
    expect(abiStrLen(abiStrTrimEnd(bytes1(32)))).toBe(0)
}

test fn str_split_lines_splits_on_newline() {
    // "a\nb\nc"
    let s = abiStrConcat(bytes4(97, 10, 98, 10), bytes1(99))
    let ls = abiStrSplitLines(s)
    expect(abiListLen(ls)).toBe(3)
    expect(abiStrCmp(fieldAt(ls, 0), bytes1(97))).toBe(0)
    expect(abiStrCmp(fieldAt(ls, 1), bytes1(98))).toBe(0)
    expect(abiStrCmp(fieldAt(ls, 2), bytes1(99))).toBe(0)
}

test fn str_split_lines_treats_crlf_as_one_ending_and_drops_a_final_one() {
    // "a\r\nb\n" -> ["a", "b"]
    let s = abiStrConcat(bytes4(97, 13, 10, 98), bytes1(10))
    let ls = abiStrSplitLines(s)
    expect(abiListLen(ls)).toBe(2)
    expect(abiStrCmp(fieldAt(ls, 0), bytes1(97))).toBe(0)
    expect(abiStrCmp(fieldAt(ls, 1), bytes1(98))).toBe(0)
}

test fn str_split_lines_keeps_interior_empty_lines_and_a_lone_cr() {
    // "a\n\nb\r" -> ["a", "", "b\r"]
    let s = abiStrConcat(bytes4(97, 10, 10, 98), bytes1(13))
    let ls = abiStrSplitLines(s)
    expect(abiListLen(ls)).toBe(3)
    expect(abiStrCmp(fieldAt(ls, 0), bytes1(97))).toBe(0)
    expect(abiStrLen(fieldAt(ls, 1))).toBe(0)
    expect(abiStrCmp(fieldAt(ls, 2), bytes2(98, 13))).toBe(0)
}

test fn str_split_lines_of_empty_and_ending_only_strings() {
    expect(abiListLen(abiStrSplitLines(abiStrRepeat(bytes1(0), 0)))).toBe(0)
    // "\n" is one empty line; "\r\n" is the same one empty line.
    let onlyNl = abiStrSplitLines(bytes1(10))
    expect(abiListLen(onlyNl)).toBe(1)
    expect(abiStrLen(fieldAt(onlyNl, 0))).toBe(0)
    let onlyCrLf = abiStrSplitLines(bytes2(13, 10))
    expect(abiListLen(onlyCrLf)).toBe(1)
    expect(abiStrLen(fieldAt(onlyCrLf, 0))).toBe(0)
}

test fn str_strip_prefix_removes_a_match() {
    // "abcd" with "ab" -> "cd"
    let s = bytes4(97, 98, 99, 100)
    expect(abiStrCmp(abiStrStripPrefix(s, bytes2(97, 98)), bytes2(99, 100))).toBe(0)
    // A non-matching prefix and an over-long one are null.
    expect(abiStrStripPrefix(s, bytes2(98, 99)) as int).toBe(0)
    let tooLong = abiStrConcat(bytes4(97, 98, 99, 100), bytes1(101))
    expect(abiStrStripPrefix(s, tooLong) as int).toBe(0)
}

test fn str_strip_prefix_empty_and_whole() {
    let s = bytes2(97, 98)
    let empty = abiStrRepeat(bytes1(0), 0)
    expect(abiStrCmp(abiStrStripPrefix(s, empty), s)).toBe(0)
    expect(abiStrLen(abiStrStripPrefix(s, s))).toBe(0)
}

test fn str_strip_suffix_removes_a_match() {
    // "abcd" with "cd" -> "ab"
    let s = bytes4(97, 98, 99, 100)
    expect(abiStrCmp(abiStrStripSuffix(s, bytes2(99, 100)), bytes2(97, 98))).toBe(0)
    expect(abiStrStripSuffix(s, bytes2(97, 98)) as int).toBe(0)
    let tooLong = abiStrConcat(bytes4(97, 98, 99, 100), bytes1(101))
    expect(abiStrStripSuffix(s, tooLong) as int).toBe(0)
    expect(abiStrLen(abiStrStripSuffix(s, s))).toBe(0)
    let empty = abiStrRepeat(bytes1(0), 0)
    expect(abiStrCmp(abiStrStripSuffix(s, empty), s)).toBe(0)
}

test fn str_split_whitespace_collapses_runs() {
    // "  a \t b " -> ["a", "b"]
    let s = abiStrConcat(bytes4(32, 32, 97, 32), bytes4(9, 32, 98, 32))
    let ws = abiStrSplitWhitespace(s)
    expect(abiListLen(ws)).toBe(2)
    expect(abiStrCmp(fieldAt(ws, 0), bytes1(97))).toBe(0)
    expect(abiStrCmp(fieldAt(ws, 1), bytes1(98))).toBe(0)
}

test fn str_split_whitespace_of_empty_and_space_only() {
    expect(abiListLen(abiStrSplitWhitespace(abiStrRepeat(bytes1(0), 0)))).toBe(0)
    // " \t\r\n"
    let s = bytes4(32, 9, 13, 10)
    expect(abiListLen(abiStrSplitWhitespace(s))).toBe(0)
}

test fn str_split_whitespace_does_not_split_punctuation() {
    // "a,,b c" -> ["a,,b", "c"]
    let s = abiStrConcat(bytes4(97, 44, 44, 98), bytes2(32, 99))
    let ws = abiStrSplitWhitespace(s)
    expect(abiListLen(ws)).toBe(2)
    expect(abiStrCmp(fieldAt(ws, 0), bytes4(97, 44, 44, 98))).toBe(0)
    expect(abiStrCmp(fieldAt(ws, 1), bytes1(99))).toBe(0)
}

test fn str_replace_first_replaces_only_the_first_match() {
    // "abcabc" with "ab" -> "Xcabc"
    let s = abiStrConcat(bytes4(97, 98, 99, 97), bytes2(98, 99))
    let r = abiStrReplaceFirst(s, bytes2(97, 98), bytes1(88))
    expect(abiStrCmp(r, abiStrConcat(bytes4(88, 99, 97, 98), bytes1(99)))).toBe(0)
}

test fn str_replace_first_with_a_longer_replacement() {
    // "abc" with "ab" -> "xyc"
    let s = bytes3(97, 98, 99)
    expect(abiStrCmp(abiStrReplaceFirst(s, bytes2(97, 98), bytes2(120, 121)), bytes3(120, 121, 99))).toBe(0)
}

test fn str_replace_first_without_a_match_is_a_fresh_copy() {
    let s = bytes4(97, 98, 99, 100)
    let r = abiStrReplaceFirst(s, bytes2(120, 121), bytes1(122))
    expect(abiStrCmp(r, s)).toBe(0)
    expect((r as int) == (s as int)).toBe(false)
}

test fn str_replace_first_empty_needle_is_a_fresh_copy() {
    let s = bytes2(97, 98)
    let r = abiStrReplaceFirst(s, abiStrRepeat(bytes1(0), 0), bytes1(122))
    expect(abiStrCmp(r, s)).toBe(0)
}
// ------------------------------------------------- short-concat differential
// Build an `n`-byte heap string with a deterministic, non-repeating byte
// pattern, so an off-by-one in the word/shift merge changes the bytes.
fn mkPattern(n: int, seed: int) -> *int {
    let p = newStr(n)
    var i = 0
    while (i < n) {
        byteInto(p, i, (seed + i * 37) & 255)
        i = i + 1
    }
    return p
}

/// Independent concatenation: one byte at a time through the public getter.
/// Deliberately does not share code with `abiStrConcat`, so the comparison is a
/// reference implementation rather than the implementation agreeing with itself.
fn refConcat(a: *int, b: *int) -> *int {
    let la = abiStrLen(a)
    let lb = abiStrLen(b)
    let p = newStr(la + lb)
    var i = 0
    while (i < la) {
        byteInto(p, i, abiStrGet(a, i))
        i = i + 1
    }
    i = 0
    while (i < lb) {
        byteInto(p, la + i, abiStrGet(b, i))
        i = i + 1
    }
    return p
}

test fn concat_short_word_path_matches_byte_reference() {
    // Every length pair through the 32-byte word path, plus a few just past the
    // cutoff where the memcpy path takes over. This covers start offsets 0-7,
    // carry words, empty operands and the final-word mask.
    var la = 0
    while (la <= 40) {
        var lb = 0
        while (lb <= 40) {
            if (la + lb <= 48) {
                let a = mkPattern(la, la * 7 + 3)
                let b = mkPattern(lb, lb * 11 + 5)
                let got = abiStrConcat(a, b)
                let want = refConcat(a, b)
                expect(abiStrLen(got)).toBe(la + lb)
                var i = 0
                while (i < la + lb) {
                    expect(abiStrGet(got, i)).toBe(abiStrGet(want, i))
                    i = i + 1
                }
            }
            lb = lb + 1
        }
        la = la + 1
    }
}

test fn concat_does_not_share_the_destination_with_an_operand() {
    let a = mkPattern(12, 1)
    let b = mkPattern(9, 2)
    let got = abiStrConcat(a, b)
    expect((got as int) == (a as int)).toBe(false)
    expect((got as int) == (b as int)).toBe(false)
    // Mutating the result through the copy-on-write setter must not touch the
    // operands, because the append path is allowed to reuse a private buffer.
    let t = abiStrSet(got, 0, 90)
    expect(abiStrGet(a, 0)).toBe(1)
    expect(abiStrGet(got, 0)).toBe(1)
    expect(abiStrGet(t, 0)).toBe(90)
}

// ------------------------------------------------------ str(int) interning
test fn str_from_i64_interns_small_values_safely() {
    let a = abiStrFromI64(123)
    let b = abiStrFromI64(123)
    expect((a as int) == (b as int)).toBe(true)
    expect(abiStrCmp(a, bytes3(49, 50, 51))).toBe(0)
    unsafe {
        expect((a[2] & 4) != 0).toBe(true)
    }
    let n = abiStrFromI64(0 - 9)
    expect((n as int) == (abiStrFromI64(0 - 9) as int)).toBe(true)
    expect(abiStrCmp(n, bytes2(45, 57))).toBe(0)
    // Out of range: every call allocates a fresh string.
    let big1 = abiStrFromI64(1000)
    let big2 = abiStrFromI64(1000)
    expect((big1 as int) == (big2 as int)).toBe(false)
    expect(abiStrLen(big1)).toBe(4)
    expect(abiStrCmp(big1, bytes4(49, 48, 48, 48))).toBe(0)
}

test fn str_set_does_not_mutate_an_interned_value() {
    let s = abiStrFromI64(7)
    let t = abiStrSet(s, 0, 56)
    expect(abiStrGet(s, 0)).toBe(55)
    expect(abiStrGet(t, 0)).toBe(56)
    // The intern table still hands out the original text.
    expect(abiStrGet(abiStrFromI64(7), 0)).toBe(55)
}

// ------------------------------------------------ in-place append contract

/// Deterministic byte pattern: seed + i*37 truncated to a byte, so lengths and
/// offsets are distinguishable without relying on string literals.
fn makeCapString(n: int, seed: int, cap: int) -> *int {
    let s = newStrCap(n, cap)
    var i = 0
    while (i < n) {
        byteInto(s, i, (seed + i * 37) & 255)
        i = i + 1
    }
    maskStrTail(s, n)
    s
}

fn expectSameBytes(a: *int, b: *int) {
    expect(abiStrLen(a)).toBe(abiStrLen(b))
    var i = 0
    while (i < abiStrLen(a)) {
        expect(abiStrGet(a, i)).toBe(abiStrGet(b, i))
        i = i + 1
    }
}

/// Differential against `abiStrConcat`: every length 0..8 in both directions,
/// once with no spare capacity (copy branch) and once with spare capacity
/// (in-place branch). The in-place branch must also return the same pointer.
test fn append_owned_matches_concat_across_lengths_and_capacities() {
    var la = 0
    while (la <= 8) {
        var lb = 0
        while (lb <= 8) {
            let b = makeCapString(lb, 31, lb)
            let tight = makeCapString(la, 7, la)
            let spare = makeCapString(la, 7, la + 8)
            let refa = makeCapString(la, 7, la)
            let want = abiStrConcat(refa, b)
            let gotTight = abiStrAppendOwned(tight, b)
            let gotSpare = abiStrAppendOwned(spare, b)
            expectSameBytes(gotTight, want)
            expectSameBytes(gotSpare, want)
            expect((gotSpare as int) == (spare as int)).toBe(true)
            lb = lb + 1
        }
        la = la + 1
    }
}

/// `s = s + s` must duplicate, not smear: the runtime uses memmove for the
/// in-place copy. The final word is masked so no stale padding leaks into
/// equality or hashing.
test fn append_owned_handles_self_append_and_masks_the_tail() {
    let n = 5
    let a = makeCapString(n, 3, 64)
    let refa = makeCapString(n, 3, n)
    let r = abiStrAppendOwned(a, a)
    expect((r as int) == (a as int)).toBe(true)
    expect(abiStrLen(r)).toBe(n + n)
    var i = 0
    while (i < n) {
        expect(abiStrGet(r, i)).toBe(abiStrGet(refa, i))
        expect(abiStrGet(r, n + i)).toBe(abiStrGet(refa, i))
        i = i + 1
    }
    // 10 bytes occupy one full word plus 2 bytes. The upper 48 bits of the
    // final word must be zero after masking.
    let tailWord = (abiStrGet(r, 8) as int) | ((abiStrGet(r, 9) as int) << 8)
    unsafe {
        expect(r[4 + 1]).toBe(tailWord)
    }
}

/// A tight buffer must grow geometrically, and the grown buffer must then be
/// reusable in place.
test fn append_owned_grows_and_then_reuses_the_new_capacity() {
    let a = makeCapString(8, 1, 8)
    let b = makeCapString(2, 80, 2)
    let want = abiStrConcat(makeCapString(8, 1, 8), b)
    let r = abiStrAppendOwned(a, b)
    expect((r as int) == (a as int)).toBe(false)
    expectSameBytes(r, want)
    unsafe {
        // Heap bit set, cached-hash and shared bits clear.
        expect((r[2] & 7)).toBe(1)
    }
    let r2 = abiStrAppendOwned(r, bytes1(33))
    expect((r2 as int) == (r as int)).toBe(true)
    expect(abiStrLen(r2)).toBe(11)
    expect(abiStrGet(r2, 10)).toBe(33)
}

/// Shared (interned) and non-heap (static descriptor style) strings must be
/// copied, never mutated. The original contents and the intern table survive.
test fn append_owned_copies_shared_and_static_style_strings() {
    let interned = abiStrFromI64(7)
    unsafe {
        expect((interned[2] & 4) != 0).toBe(true)
    }
    let r = abiStrAppendOwned(interned, bytes1(56))
    expect((r as int) == (interned as int)).toBe(false)
    expect(abiStrLen(r)).toBe(2)
    expect(abiStrGet(r, 0)).toBe(55)
    expect(abiStrGet(r, 1)).toBe(56)
    expect(abiStrGet(abiStrFromI64(7), 0)).toBe(55)
    expect(abiStrLen(abiStrFromI64(7))).toBe(1)

    // Clear FLAG_HEAP to mimic a `.rdata` descriptor.
    let stat = bytes1(65)
    unsafe {
        stat[2] = stat[2] & (0 - 2)
    }
    let r2 = abiStrAppendOwned(stat, bytes1(66))
    expect((r2 as int) == (stat as int)).toBe(false)
    expect(abiStrLen(r2)).toBe(2)
    expect(abiStrGet(r2, 0)).toBe(65)
    expect(abiStrGet(r2, 1)).toBe(66)
    expect(abiStrLen(stat)).toBe(1)
    expect(abiStrGet(stat, 0)).toBe(65)
}

/// Appending must invalidate the cached FNV-1a hash. Compute the hash first (so
/// FLAG_HASH is set), append, then compare against an independently built
/// reference; a stale cache would return the old hash and fail.
test fn append_owned_invalidates_the_cached_hash() {
    let a = makeCapString(2, 9, 64)
    let h0 = keyHash(a)
    unsafe {
        expect((a[2] & 2) != 0).toBe(true)
    }
    let r = abiStrAppendOwned(a, bytes1(90))
    expect((r as int) == (a as int)).toBe(true)
    unsafe {
        expect((r[2] & 2)).toBe(0)
    }
    let want = abiStrConcat(makeCapString(2, 9, 2), bytes1(90))
    expect(keyHash(r)).toBe(keyHash(want))
    expect(keyHash(r) != h0).toBe(true)
}

// ---------------------------------------------------------------------------
// Fused two-piece append
// ---------------------------------------------------------------------------
//
// The backend rewrites `a + b + c` into one `pickle_str_append_two` call. That
// is only sound if the helper is byte-for-byte the two sequential appends, so
// these tests are differential: for every length combination and both capacity
// shapes, compare against `abiStrAppendOwned(abiStrAppendOwned(...))`.

/// Every short length combination, once forced to copy (tight) and once with
/// room for both pieces (in place). The in-place result must reuse `a`.
test fn append_two_matches_two_appends_across_lengths() {
    var la = 0
    while (la <= 8) {
        var lb = 0
        while (lb <= 8) {
            var lc = 0
            while (lc <= 8) {
                let b = makeCapString(lb, 41, lb)
                let c = makeCapString(lc, 83, lc)
                let tight = makeCapString(la, 7, la)
                let spare = makeCapString(la, 7, la + 16)
                let refa = makeCapString(la, 7, la)
                let want = abiStrAppendOwned(abiStrAppendOwned(refa, b), c)
                let gotTight = abiStrAppendTwo(tight, b, c)
                let gotSpare = abiStrAppendTwo(spare, b, c)
                expectSameBytes(gotTight, want)
                expectSameBytes(gotSpare, want)
                expect((gotSpare as int) == (spare as int)).toBe(true)
                lc = lc + 1
            }
            lb = lb + 1
        }
        la = la + 1
    }
}

/// An operand that aliases `a` must reproduce the intermediate buffer the two
/// sequential calls expose, not read source bytes that the first store already
/// overwrote.
test fn append_two_preserves_alias_semantics() {
    // a == b: `s = s + s + tail`.
    let a = makeCapString(5, 3, 64)
    let tail = bytes1(33)
    let want = abiStrAppendOwned(abiStrAppendOwned(makeCapString(5, 3, 5), makeCapString(5, 3, 5)), tail)
    let got = abiStrAppendTwo(a, a, tail)
    expectSameBytes(got, want)
    expect(abiStrLen(got)).toBe(11)

    // a == c: the second append sees the buffer after the first append. With a
    // private buffer that is the mutated `a` itself.
    let own = makeCapString(3, 9, 64)
    let mid = bytes1(33)
    let want2 = abiStrAppendOwned(abiStrAppendOwned(makeCapString(3, 9, 3), mid),
                                  abiStrAppendOwned(makeCapString(3, 9, 3), mid))
    let got2 = abiStrAppendTwo(own, mid, own)
    expectSameBytes(got2, want2)
}

/// A shared (interned) first argument must be copied; a shared second or third
/// argument is a source only. The interned object keeps its old bytes.
test fn append_two_copies_a_shared_first() {
    let shared = abiStrFromI64(42)
    let r = abiStrAppendTwo(shared, bytes1(33), bytes1(63))
    expect((r as int) == (shared as int)).toBe(false)
    expect(abiStrLen(r)).toBe(4)
    expect(abiStrGet(r, 0)).toBe(52)
    expect(abiStrGet(r, 1)).toBe(50)
    expect(abiStrGet(r, 2)).toBe(33)
    expect(abiStrGet(r, 3)).toBe(63)
    // The source is untouched and still say "42".
    expect(abiStrLen(abiStrFromI64(42))).toBe(2)
    expect(abiStrGet(shared, 0)).toBe(52)

    // Shared operands as pieces are fine: source bytes never change.
    let own = makeCapString(2, 5, 64)
    let r2 = abiStrAppendTwo(own, shared, shared)
    expect(abiStrLen(r2)).toBe(6)
    expect(abiStrGet(r2, 2)).toBe(52)
    expect(abiStrGet(r2, 3)).toBe(50)
    expect(abiStrGet(r2, 4)).toBe(52)
    expect(abiStrGet(r2, 5)).toBe(50)
}

/// After the copy path the new buffer must be reusable in place, and the second
/// fused append must not need another allocation.
test fn append_two_grows_then_reuses_the_new_capacity() {
    let a = makeCapString(8, 1, 8)
    let b = makeCapString(2, 80, 2)
    let c = bytes1(33)
    let want = abiStrAppendOwned(abiStrAppendOwned(makeCapString(8, 1, 8), b), c)
    let r = abiStrAppendTwo(a, b, c)
    expect((r as int) == (a as int)).toBe(false)
    expectSameBytes(r, want)
    let r2 = abiStrAppendTwo(r, bytes1(63), bytes1(33))
    expect((r2 as int) == (r as int)).toBe(true)
    expect(abiStrLen(r2)).toBe(13)
    expect(abiStrGet(r2, 11)).toBe(63)
    expect(abiStrGet(r2, 12)).toBe(33)
}

/// The splitter is differential-tested against an independent per-byte
/// scanner rather than against itself: `byteAt`-style `abiStrGet` walks the
/// same bytes and builds the expected field boundaries directly. The corpus
/// cycles every length through 0..=80 (so every start/end offset modulo 8 is
/// covered), mixes the four whitespace bytes with runs, near-whitespace bytes,
/// NUL, high bytes, and long non-space runs. This is what catches a word-mask
/// lane that flags a neighbour or a partial-last-word overrun.
fn isSplitSpace(c: int) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn nextSplitByte(state: *int) -> int {
    unsafe {
        state[0] = (state[0] * 1664525 + 1013904223) % 2147483648
        return (state[0] / 65536) & 255
    }
}

test fn split_whitespace_matches_naive_scanner_on_random_bytes() {
    unsafe {
        let state = alloc(int, 1)
        state[0] = 246813579
        var caseIndex = 0
        while (caseIndex < 520) {
            let length = caseIndex % 81
            let bytes = abiListNew(0)
            var i = 0
            while (i < length) {
                var b = 97
                let shape = caseIndex % 8
                if (shape == 0) {
                    // Long non-space run: exercises whole-word skipping.
                    b = 97 + (i % 26)
                } else if (shape == 1) {
                    // Whitespace run: one separator, never empty fields.
                    b = 32
                } else if (shape == 2) {
                    // Alternating field/separator: every offset alignment.
                    if (i % 2 == 0) {
                        b = 97 + (i % 26)
                    } else {
                        b = 32
                    }
                } else {
                    let pick = nextSplitByte(state)
                    if (pick < 18) {
                        b = 32
                    } else if (pick < 26) {
                        b = 9
                    } else if (pick < 34) {
                        b = 10
                    } else if (pick < 42) {
                        b = 13
                    } else if (pick < 50) {
                        // Bytes adjacent to the whitespace values, plus NUL
                        // and the high-bit lane, must never be separators.
                        b = pick
                    } else {
                        b = nextSplitByte(state)
                    }
                }
                abiListPush(bytes, abiBoxI64(b))
                i = i + 1
            }
            let s = abiStrFromList(bytes)
            let fields = abiStrSplitWhitespace(s)

            var expectedCount = 0
            var pos = 0
            while (pos < length) {
                while (pos < length && isSplitSpace(abiStrGet(s, pos))) {
                    pos = pos + 1
                }
                if (pos >= length) {
                    break
                }
                let start = pos
                while (pos < length && !isSplitSpace(abiStrGet(s, pos))) {
                    pos = pos + 1
                }
                if (expectedCount >= abiListLen(fields)) {
                    expect(expectedCount + 1).toBe(abiListLen(fields))
                }
                let field = abiListGet(fields, expectedCount)
                expect(abiStrLen(field)).toBe(pos - start)
                var q = 0
                while (q < pos - start) {
                    expect(abiStrGet(field, q)).toBe(abiStrGet(s, start + q))
                    q = q + 1
                }
                expectedCount = expectedCount + 1
            }
            expect(abiListLen(fields)).toBe(expectedCount)
            caseIndex = caseIndex + 1
        }
    }
}

/// A piece wider than one word delegates to the sequential bodies; the result
/// must still be exact.
test fn append_two_handles_wide_pieces() {
    let a = makeCapString(3, 1, 64)
    let wide = makeCapString(11, 17, 11)
    let c = bytes1(33)
    let want = abiStrAppendOwned(abiStrAppendOwned(makeCapString(3, 1, 3), wide), c)
    let got = abiStrAppendTwo(a, wide, c)
    expectSameBytes(got, want)
    expect(abiStrLen(got)).toBe(15)
}

/// The header update is shared with append: capacity bits survive, the heap bit
/// is set, and the cached hash is cleared.
test fn append_two_invalidates_the_cached_hash() {
    let a = makeCapString(2, 9, 64)
    let h0 = keyHash(a)
    let r = abiStrAppendTwo(a, bytes1(90), bytes1(33))
    unsafe {
        expect((r[2] & 7)).toBe(1)
    }
    let want = abiStrConcat(abiStrConcat(makeCapString(2, 9, 2), bytes1(90)), bytes1(33))
    expect(abiStrLen(r)).toBe(4)
    expect(keyHash(r)).toBe(keyHash(want))
    expect(keyHash(r) != h0).toBe(true)
}


/// The intern helper is the one place where a backend inline reimplements a
/// payload-placement mix: `(payload ^ (len * K1)) * K2`, arithmetic shift right
/// by 33, mask to capacity. Every magic constant there is a 64-bit wrapping
/// value, so a transcription error would still return *a* string and only show
/// up as a missed slot (duplicate object, or a stale pointer after growth).
/// These two tests exercise the observable contract instead of the spelling:
/// padding above the payload never changes the identity, a returned object
/// always carries exactly the low `len` bytes, and 1,300 distinct 8-byte
/// payloads survive a table growth and still return their original pointers.
test fn intern_word_masks_padding_bits_and_is_idempotent() {
    unsafe {
        var ln = 1
        while (ln <= 8) {
            var sample = 0
            while (sample < 32) {
                var low = 0
                var k = 0
                while (k < ln) {
                    low = low | (((sample * 37 + k * 53 + 11) & 255) << (k * 8))
                    k = k + 1
                }
                // Junk in every lane above the payload must be ignored. The
                // mask keeps only bits at or above `ln * 8`; for ln == 8 there
                // are none and the shift is skipped (a shift by 64 is not a
                // valid way to build that mask).
                var junk = 0
                if (ln < 8) {
                    let highMask = 0 - (1 << (ln * 8))
                    junk = (sample * 2654435761 + 97) & highMask
                }
                let padded = low | junk
                let first = shortInternWord(padded, ln)
                let second = shortInternWord(low, ln)
                expect(first as int).toBe(second as int)
                expect(abiStrLen(first)).toBe(ln)
                var q = 0
                while (q < ln) {
                    expect(abiStrGet(first, q)).toBe((low >> (q * 8)) & 255)
                    q = q + 1
                }
                sample = sample + 1
            }
            ln = ln + 1
        }
    }
}

test fn intern_word_stays_consistent_across_table_growth() {
    unsafe {
        let count = 1300
        let stored = alloc(int, count)
        var i = 0
        // Each value packs `i` into four 16-bit fields, so all 1,300 payloads
        // are distinct 8-byte words and the table crosses its 0.7 load factor.
        while (i < count) {
            let v = i | (i << 16) | (i << 32) | (i << 48)
            stored[i] = shortInternWord(v, 8) as int
            i = i + 1
        }
        i = 0
        while (i < count) {
            let v = i | (i << 16) | (i << 32) | (i << 48)
            let again = shortInternWord(v, 8)
            expect(again as int).toBe(stored[i])
            expect(abiStrLen(again)).toBe(8)
            var q = 0
            while (q < 8) {
                expect(abiStrGet(again, q)).toBe((v >> (q * 8)) & 255)
                q = q + 1
            }
            i = i + 1
        }
    }
}
