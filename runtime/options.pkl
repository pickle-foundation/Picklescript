module runtime.options

/// Option-value helpers for tests.
///
/// `expect(v).toBe(n)` panics natively when `v` is a `some`-wrapped integer
/// (`PickleObject` Option vs int bucket mismatch in the assertion builtin).
/// Tests assert optional-int results by unwrapping to this sentinel value
/// instead of comparing the option directly.

/// Sentinel returned by `optNum` when the option is `none`.
const NONE_SENTINEL: int = -2147483647

/// Unwraps an optional int to `NONE_SENTINEL` when absent.
fn optNum(v: int?) -> int {
    if (let some(n) = v) {
        n
    } else {
        NONE_SENTINEL
    }
}