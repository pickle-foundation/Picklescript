module runtime.abi_gcengine

/// The ported mark-and-sweep collector, ITS automatic trigger, and the
/// allocation-event seam - hosted in one leaf module so the trigger (called
/// from the register moment) and the sweep can share state without an import
/// cycle.
///
/// WHY THIS MODULE EXISTS. Native runs a collection from inside `Gc::alloc`
/// (`maybe_collect`, gc.rs:474): the allocation that crosses `AUTO_THRESHOLD`
/// (or the `PKL_GC_THRESHOLD` override) triggers a sweep, with the fresh object
/// pinned across its own collection. In the port, that moment is
/// `abiRegisterObject`, which lives with the sweepability registry in
/// `abi_raw`; the sweep lives in `abi_gc`, which imports `abi_raw`. Putting the
/// trigger in `abiRegisterObject` therefore needs the collect engine reachable
/// from the register path - and a direct `abi_raw` -> `abi_gc` import would be
/// the reverse edge of an existing `abi_gc` -> `abi_raw` import (a cycle).
///
/// This module breaks the cycle in the only way the language permits: the
/// registers, the counters, the sweep and the trigger all live together in a
/// LEAF (it imports only `abi_shadow`, itself a leaf), and the two old homes
/// keep their public names as thin delegating wrappers - `abi_raw` for
/// `abiRegisterObject`/`abiUnregisterObject`/`abiRegistered*` and the seam
/// counters (so every maker that already imports them from `abi_raw` is
/// unchanged), `abi_gc` for the `#[symbol]` surface. Neither `abi_raw` nor any
/// maker ever imports `abi_gc`, so the graph stays acyclic:
///     makers -> abi_raw -> abi_gcengine <- abi_gc <- program
///
/// WHICH PORTED SEMANTICS LIVE HERE (moved from `abi_gc`/`abi_raw` unchanged):
/// the reclamation sweep (`abiEngineCollect`), the shadow/root/manual mark
/// seeds, the builtin-container walk, the sweepability registry, and the
/// counters. ADDED here: the threshold trigger (`abiEngineRegister`) and the
/// one-time environment read it consults (`abiEngineInitFromEnv`).
///
/// THE ENVIRONMENT READ MATCHES NATIVE'S PIN. Native reads `PKL_NO_AUTO_GC`
/// (presence suppresses every automatic collection, even a pinned threshold)
/// and `PKL_GC_THRESHOLD` (a valid positive value pins the threshold and
/// disables adaptation) ONCE, and it does so lazily on the first allocation
/// that reaches `maybe_collect`. The parity battery bakes `PKL_NO_AUTO_GC=1`
/// into every oracle artifact and inherits it into every ported run, so a port
/// that ignored the flag would auto-collect where native would not and diverge
/// on any program that allocates past the threshold. This module reads the
/// same two variables out of `GetEnvironmentStringsW` (the intrinsic already
/// used by `abi_process`) so the two agree in both the pinned and unpinned
/// case. The scan is deliberately minimal: entry-start key match, ASCII
/// case-insensitive (Rust's `env` is case-insensitive on Windows), integer
/// parse for the threshold.
///
/// NAMING. Internal helpers carry the `ge` prefix (`geMarkedNow`,
/// `geEnqueue`, ...) because the linker resolves non-`#[symbol]` functions by
/// BARE NAME across the linked image (see `abi_raw`'s deliberate
/// `regCapGrown` vs `abi_gc`'s `blockCapGrown`), so a helper reused across
/// modules would collide. Public entry points are `abiEngine*`.

import { shadowRegistryLockAcquire, shadowRegistryLockRelease, abiShadowRegistryHead, abiShadowSelf, abiShadowSelfIfRegistered, shadowCriticalEnter, shadowCriticalExit, SHADOW_W_NEXT, SHADOW_W_REG_BASE, SHADOW_W_REG_COUNT, SHADOW_W_REG_CAP, SHADOW_W_ALLOC_BYTES, SHADOW_W_ALLOC_COUNT, SHADOW_W_REG_BYTES, SHADOW_W_STATE, SHADOW_W_PARK, SHADOW_W_PARK_LOCK, SHADOW_W_CRITICAL, SHADOW_W_TEMP_BASE, SHADOW_W_TEMP_COUNT, SHADOW_W_TEMP_CAP, SHADOW_STATE_RUNNING, SHADOW_STATE_PARKED, SHADOW_STATE_NATIVE, SHADOW_STATE_COLLECTING } from runtime.abi_shadow
import { abiClassOwnedMaskOf, abiClassFinalizerOf } from runtime.abi_classwords
import { abiManagedRelease, abiRawParallelMode } from runtime.abi_raw
import { winLockAcquire, winLockRelease, winParkOn, winWakeOn, winWakeAllOn } from runtime.abi_world_win
import { MAP_BLOOM_OFF } from runtime.layout

/// Managed class ids on object words (mirror of `runtime/object` labels).
/// Word 1 carries the id; string's id is 0 (see `abi_raw`'s note on word 0's
/// string flag). Spelled out rather than imported so this leaf drags in no
/// type definitions.
const CLA_STRING: int = 0
const CLA_LIST: int = 1
const CLA_MAP: int = 2
const CLA_BOX_INT: int = 3
const CLA_BOX_FLOAT: int = 4
const CLA_BOX_BOOL: int = 5
const CLA_BOX_CHAR: int = 6
const CLA_ENUM: int = 7
const CLA_TUPLE: int = 8
const CLA_STREAM: int = 9

/// Object word layout: 24-byte header + payload words.
const HEADER_BYTES: int = 24
const WO_CLASS: int = 1
const WO_SIZE: int = 2
const WO_LIST_LEN: int = 3
const WO_LIST_CAP: int = 4
const WO_LIST_DATA: int = 5
const WO_MAP_LEN: int = 3
const WO_MAP_CAP: int = 4
const WO_MAP_OCCUPIED: int = 5
const WO_MAP_ENTRIES: int = 6
const WO_TUPLE_LEN: int = 3
const WO_PAYLOAD: int = 4
/// Word 0 of the payload region for user classes: slots at `HEADER + 8*sl`.
const WO_CLASS_PAYLOAD: int = 3

/// Transient mark stamp (word 0) written into reachable registered objects
/// during a collect and cleared on survivors.
const MARK_SENTINEL: int = 1
/// A newly registered object whose constructor has not published it yet. It is
/// kept across a cycle even when no root reaches it, and the pin is cleared
/// only once a trace actually marks it (`geEnqueue` overwrites the word with
/// `MARK_SENTINEL`). This is what lets a collection run on another thread
/// between a maker's `register` and its `return` without sweeping the value
/// the maker is about to hand back.
const MARK_PINNED: int = 2

/// `DEFAULT_AUTO_COLLECT_THRESHOLD` in object bytes (runtime/src/gc.rs:137),
/// spelled out for image initialisation of `threshold`.
const DEFAULT_AUTO_COLLECT_THRESHOLD: int = 8388608
/// Adaptive threshold cap: `next.min(1 << 30)` (gc.rs:470).
const GC_THRESHOLD_CAP: int = 1073741824

// ---------------------------------------------------------------- counters
// The allocation-event seam (moved from `abi_raw`): bumped by the register
// moment for MANAGED objects only, exactly as native's `Gc::alloc` bumps its
// `ALLOC_SINCE_GC`/`BYTES_SINCE_GC` - never by the raw allocator.
var rawAllocCount: int = 0
var rawAllocBytes: int = 0

fn abiEngineAllocCount() -> int {
    var total = rawAllocCount
    var node = abiShadowRegistryHead()
    while (node != 0) {
        unsafe {
            total = total + ((node as *int)[SHADOW_W_ALLOC_COUNT])
            node = (node as *int)[SHADOW_W_NEXT]
        }
    }
    return total
}

fn abiEngineAllocBytes() -> int {
    var total = rawAllocBytes
    var node = abiShadowRegistryHead()
    while (node != 0) {
        unsafe {
            total = total + ((node as *int)[SHADOW_W_ALLOC_BYTES])
            node = (node as *int)[SHADOW_W_NEXT]
        }
    }
    return total
}

fn abiEngineResetCounters() {
    rawAllocCount = 0
    rawAllocBytes = 0
    var node = abiShadowRegistryHead()
    while (node != 0) {
        unsafe {
            (node as *int)[SHADOW_W_ALLOC_COUNT] = 0
            (node as *int)[SHADOW_W_ALLOC_BYTES] = 0
            node = (node as *int)[SHADOW_W_NEXT]
        }
    }
}

// ------------------------------------------------------------------- state
var collections: int = 0
var threshold: int = 8388608
var thresholdManual: int = 0
var overrideThreshold: int = 0
var noAutoGc: int = 0
/// `PKL_STRESS_GC`: collect at every trigger instead of on a byte threshold.
/// Under the current execution model the trigger is registration, so this is
/// "collect after every managed allocation" - the harshest root test available
/// before safepoints exist. Phase 3 re-points it at the safepoint poll.
var stressGc: int = 0
/// Environment-config state machine: 0 = not started, 1 = a thread is reading
/// the block, 2 = every field is published. The hot path is one load and no
/// lock. The initializer writes the fields outside `envLock`, then stores 2
/// under it and wakes `envCv`; a waiter parks on the cv, which atomically
/// releases the lock, so the publish cannot be missed. x64 TSO keeps the field
/// writes ordered before the state-2 store, and the waiter re-reads the fields
/// only after that store becomes visible.
var envInited: int = 0
var envLock: int = 0
var envCv: int = 0
var liveBytes: int = 0
var collecting: int = 0

/// The mark worklist: a raw word block of object addresses enqueued for
/// tracing this cycle. Capacity is the registered count at mark start; freed at
/// cycle end. Pointer + length live as image data so the trace helpers mutate
/// them without pointer-to-local plumbing.
var markPending: int = 0
var markPendingLen: int = 0

/// The membership set for one cycle: an open-addressing table of registered
/// object addresses, sized to the next power of two at or above twice the
/// registered count and ZEROED (the raw `alloc` is unzeroed), built once at the
/// top of `abiEngineCollect` and freed at its end. The conservative user-class
/// walk hands `geEnqueue` raw payload words that may be scalars, so membership
/// must be answered WITHOUT dereferencing the candidate (native's exact
/// managed-mask walk tests the candidate's own mark word instead). A linear
/// scan over the registry made that test O(regCount) inside an O(edges) walk -
/// quadratic on the multi-hundred-thousand-object graphs the self-hosted
/// compiler builds, and the reason auto-collection had to be pinned off. Empty
/// slots hold 0, which no live object address can be.
var regSetBase: int = 0
var regSetCap: int = 0

/// The static-root registry: flat word block of `*mut PickleObject` cell
/// addresses. Grown by doubling.
var rootsBase: int = 0
var rootsCap: int = 0
var rootsCount: int = 0
const ROOTS_INITIAL: int = 16

/// The manual-object registry: flat word block of adopted object addresses.
var manBase: int = 0
var manCap: int = 0
var manCount: int = 0
const MAN_INITIAL: int = 16

/// The temp-root registry: flat word block of liveness leases. A runtime
/// helper that is mid-build - an object that exists, is registered, but has
/// not yet been published to a frame slot, a root cell, or a parent's slot -
/// holds a lease here so any collection the helper's OWN next allocation may
/// trigger (or an explicit `pickle_gc_collect` racing it) cannot sweep the
/// half-built value. Mirrors `gc.rs`'s `temp_root`/`temp_unroot`, which seed
/// `trace::trace_from_roots` the same way. Unlike the manual registry the
/// flag word is untouched: a lease is purely liveness, never an adopt.
var teBase: int = 0
var teCap: int = 0
var teCount: int = 0
const TE_INITIAL: int = 16

/// Serialize the three shared registries below against concurrent mutators.
///
/// They are runtime metadata, not user containers: two threads may spawn at the
/// same time, call `pickle_manual_adopt`, or register a static root, and the
/// grow-and-append is not atomic. Each list has its own lock so a long walk of
/// one never blocks the other. The collector reads the lists only while the
/// world is stopped, so no reader takes these locks.
///
/// `teLock` is on the spawn path and is taken twice per task; it is cold enough
/// that nothing more clever is warranted.
var teLock: int = 0
var manLock: int = 0
var rootsLock: int = 0

/// The sweep's deferred-dead list: flat word block of object addresses whose
/// death needs post-sweep work before the block is freed. Native sweeps pick
/// these out with the `should_defer` predicate (gc.rs collect, line 402): a
/// dead USER class (ids 0-9 are list/map/string and never deferred) whose
/// descriptor carries a `deinit` finalizer or a non-zero `#[manualAlloc]`
/// owned-slot mask. The baseline sweep free is skipped for them - a finalizer
/// must be able to touch its object, and owned fields are released AFTER the
/// holder's death is fixed - so the blocks ride out the sweep here and are
/// finalized, field-released, and freed after `regBytes` is fixed up and while
/// `collecting` is still 1 (a finalizer that allocates cannot re-enter).
/// Mirrors the `deferred` vector and the post-sweep loops in gc.rs (lines
/// 440-456).
var defBase: int = 0
var defCap: int = 0
var defCount: int = 0
const DEF_INITIAL: int = 16

// --------------------------------------------------------- block growth
/// The capacity a block reaches for `idx` items under doubling growth: the
/// first power-of-2 multiple of `initial` strictly above `idx` (or the input
/// cap when it already fits).
fn geCapGrown(cap: int, idx: int, initial: int) -> int {
    if (idx < cap) {
        return cap
    }
    var c = cap
    if (c == 0) {
        c = initial
    }
    while (idx >= c) {
        c = c * 2
    }
    return c
}

/// Grow `base`/`cap` so word index `idx` is in range: allocate a fresh block of
/// the grown capacity (unzeroed, like every `alloc`), copy the old words, zero
/// the new tail, release the old block, return the new base. Returns `base`
/// unchanged when no growth is needed.
fn geGrow(base: int, cap: int, idx: int, initial: int) -> int {
    var newCap = geCapGrown(cap, idx, initial)
    if (newCap == cap) {
        return base
    }
    unsafe {
        var fresh = alloc(int, newCap)
        var j = 0
        while (j < cap) {
            fresh[j] = (base as *int)[j]
            j = j + 1
        }
        var k = cap
        while (k < newCap) {
            fresh[k] = 0
            k = k + 1
        }
        if (base != 0) {
            free(base as *int)
        }
        return fresh as int
    }
}

// --------------------------------------------------- sweepability registry
/// THE PORT-OWNED SWEEPABILITY REGISTRY (moved here from `abi_raw`). A flat set
/// of managed-object addresses, one per created object, with class and byte
/// size read from the object's own header (word 1 / word 2). Only managed
/// objects are registered; raw spans backing them are covered by their owner.
var regBase: int = 0
var regCap: int = 0
var regCount: int = 0
var regBytes: int = 0
const REG_INITIAL: int = 16

fn geRegCapGrown(cap: int, idx: int) -> int {
    if (idx < cap) {
        return cap
    }
    var c = cap
    if (c == 0) {
        c = REG_INITIAL
    }
    while (idx >= c) {
        c = c * 2
    }
    return c
}

fn geRegGrow(base: int, cap: int, idx: int) -> int {
    var newCap = geRegCapGrown(cap, idx)
    if (newCap == cap) {
        return base
    }
    unsafe {
        var fresh = alloc(int, newCap)
        var j = 0
        while (j < cap) {
            fresh[j] = (base as *int)[j]
            j = j + 1
        }
        var k = cap
        while (k < newCap) {
            fresh[k] = 0
            k = k + 1
        }
        if (base != 0) {
            free(base as *int)
        }
        return fresh as int
    }
}

fn abiEngineRegisteredCount() -> int {
    var total = regCount
    var node = abiShadowRegistryHead()
    while (node != 0) {
        unsafe {
            total = total + ((node as *int)[SHADOW_W_REG_COUNT])
            node = (node as *int)[SHADOW_W_NEXT]
        }
    }
    return total
}

fn abiEngineRegisteredAt(i: int) -> int {
    if (i < 0) {
        return 0
    }
    if (i < regCount) {
        unsafe {
            return (regBase as *int)[i]
        }
    }
    var left = i - regCount
    var node = abiShadowRegistryHead()
    while (node != 0) {
        unsafe {
            let count = (node as *int)[SHADOW_W_REG_COUNT]
            if (left < count) {
                return ((node as *int)[SHADOW_W_REG_BASE] as *int)[left]
            }
            left = left - count
            node = (node as *int)[SHADOW_W_NEXT]
        }
    }
    return 0
}

fn abiEngineRegisteredBytes() -> int {
    var total = regBytes
    var node = abiShadowRegistryHead()
    while (node != 0) {
        unsafe {
            total = total + ((node as *int)[SHADOW_W_REG_BYTES])
            node = (node as *int)[SHADOW_W_NEXT]
        }
    }
    return total
}

/// Drop an object from the live population - swap-with-last, tail nulled, size
/// un-counted the same way it was counted. Null and an unknown address are both
/// no-ops. The block itself is not freed here.
fn abiEngineUnregister(obj: *int) {
    if ((obj as int) == 0) {
        return
    }
    var i = 0
    var found = false
    while (i < regCount && !found) {
        unsafe {
            if ((regBase as *int)[i] == (obj as int)) {
                found = true
            }
        }
        if (!found) {
            i = i + 1
        }
    }
    if (!found) {
        // Parallel mode: the object lives in its allocating thread's block.
        var owner = 0
        var node = abiShadowRegistryHead()
        while (node != 0 && !found) {
            unsafe {
                let base = (node as *int)[SHADOW_W_REG_BASE] as *int
                let count = (node as *int)[SHADOW_W_REG_COUNT]
                var j = 0
                while (j < count && !found) {
                    if (base[j] == (obj as int)) {
                        base[j] = base[count - 1]
                        base[count - 1] = 0
                        (node as *int)[SHADOW_W_REG_COUNT] = count - 1
                        owner = node
                        found = true
                    }
                    j = j + 1
                }
                node = (node as *int)[SHADOW_W_NEXT]
            }
        }
        if (found) {
            var psize = 0
            unsafe {
                // Fold the owner's pending bytes first: this object's size is
                // in that word until a collection flushes it. Without this the
                // subtraction below would come out of other threads' bytes.
                regBytes = regBytes + ((owner as *int)[SHADOW_W_REG_BYTES])
                (owner as *int)[SHADOW_W_REG_BYTES] = 0
                psize = obj[2]
            }
            regBytes = regBytes - psize
        }
        return
    }
    unsafe {
        (regBase as *int)[i] = (regBase as *int)[regCount - 1]
        (regBase as *int)[regCount - 1] = 0
    }
    var size = 0
    unsafe {
        size = obj[2]
    }
    regCount = regCount - 1
    regBytes = regBytes - size
}

// --------------------------------------------------------------- env read
/// Mask for one UTF-16 code unit packed four-to-a-64-bit-word.
const GE_WCHAR_MASK: int = 65535

/// Read unit `i` of a packed UTF-16 buffer: four units share a 64-bit word.
/// (The `abi_fs` helper of the same shape lives there and cannot be imported -
/// `abi_fs` imports `abi_raw`, which imports this leaf: a cycle.)
fn geUnitAt(w: *int, i: int) -> int {
    unsafe {
        return (w[i >> 2] >> ((i & 3) * 16)) & GE_WCHAR_MASK
    }
}

/// ASCII lower-case of a code unit already known to be <= 0x7F.
fn geLowerAscii(c: int) -> int {
    if (c >= 65 && c <= 90) {
        return c + 32
    }
    return c
}

/// Whether the NUL-terminated entry starting at unit `start` is `pkl_no_auto_gc=`
/// or `pkl_gc_threshold=`, ASCII case-insensitively: the unit at each offset is
/// lowered and compared against the key byte spelled out as a constant. These
/// are the only two keys the engine reads, so the byte values are hardcoded -
/// a `bytes()` scan would box every char of every entry into managed boxes,
/// inflating the allocation count seen by the first collection (native's
/// `gc.rs::env_init` allocates nothing, so our env-init must not either).
fn geEntryNoAutoGc(w: *int, start: int) -> bool {
    if (geLowerAscii(geUnitAt(w, start + 0)) != 112) { return false }
    if (geLowerAscii(geUnitAt(w, start + 1)) != 107) { return false }
    if (geLowerAscii(geUnitAt(w, start + 2)) != 108) { return false }
    if (geLowerAscii(geUnitAt(w, start + 3)) != 95) { return false }
    if (geLowerAscii(geUnitAt(w, start + 4)) != 110) { return false }
    if (geLowerAscii(geUnitAt(w, start + 5)) != 111) { return false }
    if (geLowerAscii(geUnitAt(w, start + 6)) != 95) { return false }
    if (geLowerAscii(geUnitAt(w, start + 7)) != 97) { return false }
    if (geLowerAscii(geUnitAt(w, start + 8)) != 117) { return false }
    if (geLowerAscii(geUnitAt(w, start + 9)) != 116) { return false }
    if (geLowerAscii(geUnitAt(w, start + 10)) != 111) { return false }
    if (geLowerAscii(geUnitAt(w, start + 11)) != 95) { return false }
    if (geLowerAscii(geUnitAt(w, start + 12)) != 103) { return false }
    if (geLowerAscii(geUnitAt(w, start + 13)) != 99) { return false }
    return geUnitAt(w, start + 14) == 61
}

/// `PKL_STRESS_GC`: force a collection at every trigger.
fn geEntryStressGc(w: *int, start: int) -> bool {
    if (geLowerAscii(geUnitAt(w, start + 0)) != 112) { return false }
    if (geLowerAscii(geUnitAt(w, start + 1)) != 107) { return false }
    if (geLowerAscii(geUnitAt(w, start + 2)) != 108) { return false }
    if (geLowerAscii(geUnitAt(w, start + 3)) != 95) { return false }
    if (geLowerAscii(geUnitAt(w, start + 4)) != 115) { return false }
    if (geLowerAscii(geUnitAt(w, start + 5)) != 116) { return false }
    if (geLowerAscii(geUnitAt(w, start + 6)) != 114) { return false }
    if (geLowerAscii(geUnitAt(w, start + 7)) != 101) { return false }
    if (geLowerAscii(geUnitAt(w, start + 8)) != 115) { return false }
    if (geLowerAscii(geUnitAt(w, start + 9)) != 115) { return false }
    if (geLowerAscii(geUnitAt(w, start + 10)) != 95) { return false }
    if (geLowerAscii(geUnitAt(w, start + 11)) != 103) { return false }
    if (geLowerAscii(geUnitAt(w, start + 12)) != 99) { return false }
    return geUnitAt(w, start + 13) == 61
}

fn geEntryThreshold(w: *int, start: int) -> bool {
    if (geLowerAscii(geUnitAt(w, start + 0)) != 112) { return false }
    if (geLowerAscii(geUnitAt(w, start + 1)) != 107) { return false }
    if (geLowerAscii(geUnitAt(w, start + 2)) != 108) { return false }
    if (geLowerAscii(geUnitAt(w, start + 3)) != 95) { return false }
    if (geLowerAscii(geUnitAt(w, start + 4)) != 103) { return false }
    if (geLowerAscii(geUnitAt(w, start + 5)) != 99) { return false }
    if (geLowerAscii(geUnitAt(w, start + 6)) != 95) { return false }
    if (geLowerAscii(geUnitAt(w, start + 7)) != 116) { return false }
    if (geLowerAscii(geUnitAt(w, start + 8)) != 104) { return false }
    if (geLowerAscii(geUnitAt(w, start + 9)) != 114) { return false }
    if (geLowerAscii(geUnitAt(w, start + 10)) != 101) { return false }
    if (geLowerAscii(geUnitAt(w, start + 11)) != 115) { return false }
    if (geLowerAscii(geUnitAt(w, start + 12)) != 104) { return false }
    if (geLowerAscii(geUnitAt(w, start + 13)) != 111) { return false }
    if (geLowerAscii(geUnitAt(w, start + 14)) != 108) { return false }
    if (geLowerAscii(geUnitAt(w, start + 15)) != 100) { return false }
    return geUnitAt(w, start + 16) == 61
}

/// Unit index of `keySel`'s value in the environment block, or -1 when the key
/// is absent. Walks NUL-terminated entries until the empty terminating entry.
/// `keySel` selects the hardcoded matcher (0 = no-auto-gc, 1 = threshold).
fn geEnvFind(w: *int, keySel: int) -> int {
    var start = 0
    var guard = 0
    while (guard < 1048576) {
        var u = 0
        while (geUnitAt(w, start + u) != 0) {
            u = u + 1
        }
        if (u == 0) {
            return -1
        }
        if (keySel == 0) {
            if (geEntryNoAutoGc(w, start)) {
                return start + 14 + 1
            }
        } else if (keySel == 1) {
            if (geEntryThreshold(w, start)) {
                return start + 16 + 1
            }
        } else if (keySel == 2) {
            if (geEntryStressGc(w, start)) {
                return start + 13 + 1
            }
        }
        start = start + u + 1
        guard = guard + 1
    }
    return -1
}

/// Decimal value of the NUL-terminated run at unit `start`, or -1 when it holds
/// no digits. Leading and trailing non-digits are ignored (native `.trim()`s
/// before parsing); the value saturates so a runaway run cannot spin.
fn geEnvIntAt(w: *int, start: int) -> int {
    var i = start
    // Skip leading whitespace.
    while (true) {
        var cu = geUnitAt(w, i)
        if (cu == 32 || cu == 9) {
            i = i + 1
        } else {
            break
        }
    }
    var v = 0
    var any = false
    while (true) {
        var c = geUnitAt(w, i)
        if (c < 48 || c > 57) {
            break
        }
        if (v < 1000000000) {
            v = v * 10 + (c - 48)
        }
        any = true
        i = i + 1
    }
    if (!any) {
        return -1
    }
    return v
}

/// One-time read of `PKL_NO_AUTO_GC` (presence suppresses auto-collection),
/// `PKL_GC_THRESHOLD` (a positive value pins the threshold and disables
/// adaptation) and `PKL_STRESS_GC` - the port's `gc.rs::env_init`. Also called
/// from the register path so the read is lazy exactly like native's
/// `ENV_INIT` `Once`.
///
/// Three-state handshake, not a bare flag: a thread that finds state 1 waits
/// for state 2 instead of racing ahead with half-written fields. No loop here
/// may hold `envLock` across its header: every loop header carries a safepoint,
/// and a waiter that parked while holding this lock would block the
/// initializer's publish while the collector waits for both. The scan therefore
/// runs unlocked, and the wait loop releases the lock before its next
/// iteration. Nothing here allocates, so the scan cannot re-enter register.
fn abiEngineInitFromEnv() {
    if (envInited == 2) {
        return
    }
    unsafe {
        winLockAcquire((&envLock) as int)
    }
    if (envInited == 2) {
        unsafe {
            winLockRelease((&envLock) as int)
        }
        return
    }
    if (envInited == 1) {
        unsafe {
            winLockRelease((&envLock) as int)
        }
        while (envInited != 2) {
            unsafe {
                winLockAcquire((&envLock) as int)
                if (envInited != 2) {
                    winParkOn((&envLock) as int, (&envCv) as int)
                }
                winLockRelease((&envLock) as int)
            }
        }
        return
    }
    envInited = 1
    unsafe {
        winLockRelease((&envLock) as int)
    }
    var block = win_get_environment_strings_w()
    if (block != 0) {
        if (geEnvFind(block as *int, 0) >= 0) {
            noAutoGc = 1
        }
        var tstart = geEnvFind(block as *int, 1)
        if (tstart >= 0) {
            var n = geEnvIntAt(block as *int, tstart)
            if (n > 0) {
                overrideThreshold = n
                thresholdManual = 1
            }
        }
        if (geEnvFind(block as *int, 2) >= 0) {
            stressGc = 1
        }
        let _ = win_free_environment_strings_w(block)
    }
    unsafe {
        winLockAcquire((&envLock) as int)
    }
    envInited = 2
    unsafe {
        winWakeAllOn((&envCv) as int)
        winLockRelease((&envLock) as int)
    }
}

// ------------------------------------------------------------- the trigger
/// Register a managed object and run the automatic-collection trigger - the
/// port's `Gc::alloc` moment. Called by every maker (through `abi_raw`'s
/// delegating wrapper). Bumps the seam counters from the object's own size word,
/// then mirrors `maybe_collect`: on a crossed threshold (with `PKL_NO_AUTO_GC`
/// absent) collects, pinning `obj` across its own cycle so a not-yet-reachable
/// object is not swept by the collection it triggered.
///
/// Header access goes through the `geReg*` helpers below on purpose. The backend
/// gives every managed temp a shadow cell, and `Ptr` is managed, so a single
/// `objAddr as *int` written here would put a shadow cell - and therefore a
/// push/pop shadow frame - back on the path every allocation runs. Converting at
/// each use inside a helper that cannot collect keeps this function int-only
/// (zero managed temps), so it needs no frame at all.
fn geRegObjSize(objAddr: int) -> int {
    var size = 0
    unsafe {
        size = (objAddr as *int)[2]
    }
    return size
}

/// Set the in-flight mark. Called before the growth/env-init section (and the
/// possible collect at the end) so an object the constructor has not published
/// yet survives the cycle it triggers - native `Gc::alloc`'s mark. Cleared by
/// `geRegUnpin` on both exits.
fn geRegPin(objAddr: int) {
    unsafe {
        (objAddr as *int)[0] = MARK_PINNED
    }
}

fn geRegUnpin(objAddr: int) {
    unsafe {
        (objAddr as *int)[0] = 0
    }
}

/// Append to the calling thread's private registry block. The block is touched
/// only by its owner, so the append needs no lock; growth is a raw realloc and
/// copy. Returns 1 when the object was pinned (auto-GC armed), so the caller
/// knows whether an uncollected registration still needs its pin cleared.
fn geRegParallel(objAddr: int, size: int) -> int {
    // The thread's node is created by its first shadow push, which precedes any
    // allocation in a Pickle frame, so the lock-free lookup answers here. The
    // locking form stays for a caller that registers before its first frame.
    var self = abiShadowSelfIfRegistered()
    if (self == 0) {
        self = abiShadowSelf()
    }
    let rec = self as *int
    var pinning = 0
    if (noAutoGc == 0) {
        geRegPin(objAddr)
        pinning = 1
    }
    var count = 0
    var cap = 0
    unsafe {
        count = rec[SHADOW_W_REG_COUNT]
        cap = rec[SHADOW_W_REG_CAP]
    }
    if (count >= cap) {
        unsafe {
            rec[SHADOW_W_REG_BASE] = geRegGrow(rec[SHADOW_W_REG_BASE], cap, count)
            rec[SHADOW_W_REG_CAP] = geRegCapGrown(cap, count)
        }
    }
    unsafe {
        ((rec[SHADOW_W_REG_BASE]) as *int)[count] = objAddr
        rec[SHADOW_W_REG_COUNT] = count + 1
        rec[SHADOW_W_ALLOC_BYTES] = rec[SHADOW_W_ALLOC_BYTES] + size
        rec[SHADOW_W_ALLOC_COUNT] = rec[SHADOW_W_ALLOC_COUNT] + 1
        rec[SHADOW_W_REG_BYTES] = rec[SHADOW_W_REG_BYTES] + size
    }
    // No process-wide write here: every worker updating `regBytes`,
    // `rawAllocCount` and `rawAllocBytes` made all 16 threads serialise on one
    // cache line (measured: 16-thread par_alloc 1092 -> 375 ms without it).
    // The collector folds these pending words in `geSweepBlock`.
    return pinning
}

/// The calling thread's allocation bytes since its last collection. A tiny
/// unsafe helper so the register path can stay out of `unsafe`.
fn geAllocBytesOf(rec: *int) -> int {
    unsafe {
        return rec[SHADOW_W_ALLOC_BYTES]
    }
}

/// Turn off the emitter's inline global-registry append. `abiRawSetParallel`
/// calls this under the world lock when the process gains its second thread.
/// Zeroing `regCap` makes the emitted fast path's existing `regCount < regCap`
/// check fail, so every later registration reaches `abiEngineRegister`, whose
/// parallel branch appends to the calling thread's private block. In parallel
/// mode nothing writes the global registry again, so its capacity is dead -
/// the pre-flip population in `regBase` is still swept and read by count.
fn abiEngineParallelOn() {
    regCap = 0
    // Idempotent: a worker may spawn, and the flip must not reset a live
    // barrier. The first flip establishes the main thread's count.
    if (gcParallel != 0) {
        return
    }
    gcParallel = 1
    gcRequested = 0
    gcRunningCount = 1
}

fn abiEngineRegister(objAddr: int) {
    if (objAddr == 0) {
        return
    }
    var size = geRegObjSize(objAddr)
    // Read the environment first, and only once. `PKL_NO_AUTO_GC` and
    // `PKL_GC_THRESHOLD` are fixed after this block, so the pin decision below
    // can use the final value instead of reading the global a second time on
    // every registration. A thread that finds init in progress waits for the
    // published state instead of proceeding with half-written fields. Nothing
    // in the init path allocates managed memory, so it cannot re-enter here.
    if (envInited != 2) {
        abiEngineInitFromEnv()
    }
    var noGc = noAutoGc
    // Parallel mode: a private block per thread, no shared registry line. The
    // collection trigger still runs here for now (the world lock is still the
    // execution model); Phase 3 moves it to an emitted safepoint.
    if (abiRawParallelMode() != 0) {
        let pinning = geRegParallel(objAddr, size)
        if (noGc != 0) {
            return
        }
        let rec = abiShadowSelf() as *int
        var th = threshold
        if (overrideThreshold != 0) {
            th = overrideThreshold
        }
        if (stressGc != 0 || geAllocBytesOf(rec) >= th) {
            abiEngineCollect(false)
            return
        }
        if (pinning != 0) {
            geRegUnpin(objAddr)
        }
        return
    }
    // Only pay for the pin when a collection is possible. With
    // `PKL_NO_AUTO_GC` set the trigger section below is unreachable, so the
    // mark would be written and cleared untouched - two stores and two calls
    // per allocation for nothing. Benchmarks run with it set.
    var pinning = 0
    if (noGc == 0) {
        geRegPin(objAddr)
        pinning = 1
    }
    // HOT PATH. Growing used to run both helpers on *every* registration, which
    // is two calls per allocated object; the capacity check is the whole
    // condition they compute, so guard the pair here and call them only on the
    // geometric growth boundary. Measured on micro9: register_only 210ns
    // before, ~90ns after. `count` is read once and reused for the store and
    // the increment: the emitter has no global CSE, so each `regCount` mention
    // used to be its own `movabs`+load.
    var count = regCount
    if (count >= regCap) {
        regBase = geRegGrow(regBase, regCap, count)
        regCap = geRegCapGrown(regCap, count)
    }
    unsafe {
        (regBase as *int)[count] = objAddr
    }
    regCount = count + 1
    regBytes = regBytes + size
    rawAllocCount = rawAllocCount + 1
    rawAllocBytes = rawAllocBytes + size
    // The pin (when armed) covers the rest of the register: a threshold
    // crossing runs inside this function, and it cannot see an object the
    // constructor has not yet published to a frame slot or a root cell. Native
    // `Gc::alloc` does mark -> maybe_collect -> unmark, so an in-flight value
    // always survives the cycle it triggers.
    if (noGc != 0) {
        return
    }
    var th = threshold
    if (overrideThreshold != 0) {
        th = overrideThreshold
    }
    if (stressGc != 0 || rawAllocBytes >= th) {
        abiEngineCollect(false)
    }
    // Clear the register pin unconditionally - native clears the mark even when
    // no collection ran (a surviving sweep also clears, making this a no-op).
    if (pinning != 0) {
        geRegUnpin(objAddr)
    }
}

// ------------------------------------------------------------- the sweep
/// The adaptive post-cycle target: the larger of the default threshold and
/// twice the surviving live bytes, capped at 1 << 30 (`gc.rs:467-470`).
fn geAdaptiveNext(live: int) -> int {
    var next = DEFAULT_AUTO_COLLECT_THRESHOLD
    if (live * 2 > next) {
        next = live * 2
    }
    if (next > GC_THRESHOLD_CAP) {
        next = GC_THRESHOLD_CAP
    }
    return next
}

/// A power-of-two capacity that holds `count` addresses at a load factor below
/// one half, so linear probing stays short.
fn geSetCapFor(count: int) -> int {
    var cap = 16
    while (cap < count * 2) {
        cap = cap * 2
    }
    return cap
}

/// Insert `address` into the cycle's membership set (open addressing, linear
/// probing; address 0 is the empty marker). Idempotent.
fn geSetInsert(address: int) {
    var mask = regSetCap - 1
    var h = (address >> 3) & mask
    while (true) {
        var slot = 0
        unsafe {
            slot = (regSetBase as *int)[h]
        }
        if (slot == 0 || slot == address) {
            unsafe {
                (regSetBase as *int)[h] = address
            }
            return
        }
        h = (h + 1) & mask
    }
}

/// Whether `candidate` is a registered object this cycle. Never dereferences the
/// candidate, so it is safe on a raw payload word that is a scalar. O(1) on
/// average instead of the old O(regCount) registry scan.
fn geSetHas(candidate: int) -> bool {
    var mask = regSetCap - 1
    var h = (candidate >> 3) & mask
    while (true) {
        var slot = 0
        unsafe {
            slot = (regSetBase as *int)[h]
        }
        if (slot == 0) {
            return false
        }
        if (slot == candidate) {
            return true
        }
        h = (h + 1) & mask
    }
}

/// Build the cycle's membership set from the current registry: allocate a
/// zeroed table and insert every registered address. O(regCount).
fn geSetBuild() {
    let total = abiEngineRegisteredCount()
    regSetCap = geSetCapFor(total)
    unsafe {
        regSetBase = alloc(int, regSetCap) as int
    }
    var i = 0
    while (i < regSetCap) {
        unsafe {
            (regSetBase as *int)[i] = 0
        }
        i = i + 1
    }
    i = 0
    while (i < total) {
        geSetInsert(abiEngineRegisteredAt(i))
        i = i + 1
    }
}

/// True iff `object` carries the cycle's transient mark (word 0 = 1).
fn geMarkedNow(object: int) -> bool {
    unsafe {
        return ((object as int) as *int)[0] == MARK_SENTINEL
    }
}

/// True iff `object` is still pinned from its registration (word 0 = 2).
fn gePinnedNow(object: int) -> bool {
    unsafe {
        return ((object as int) as *int)[0] == MARK_PINNED
    }
}

/// Enqueue `candidate` for tracing if it is a registered, unmarked object. It
/// is stamped here so a cycle never re-enqueues it.
fn geEnqueue(candidate: int) {
    if (candidate == 0) {
        return
    }
    if (!geSetHas(candidate)) {
        return
    }
    if (geMarkedNow(candidate)) {
        return
    }
    unsafe {
        (markPending as *int)[markPendingLen] = candidate
        (candidate as *int)[0] = MARK_SENTINEL
    }
    markPendingLen = markPendingLen + 1
}

/// Seed the worklist from the current thread's shadow stack: walk every frame
/// in the chain and enqueue each spilled managed local. Frame layout is the
/// reference's `ShadowFrame`: `frame[0]` is `prev`, `frame[1]` the masked
/// 32-bit `slot_count`, slots follow at `frame[2 + i]`. Only REGISTERED
/// addresses are edges.
fn geMarkFromShadow(head: int) {
    var frame = head
    while (frame != 0) {
        unsafe {
            var slots = frame as *int
            var count = slots[1] & 0xFFFFFFFF
            var slot = 0
            while (slot < count) {
                geEnqueue(slots[2 + slot])
                slot = slot + 1
            }
            frame = slots[0]
        }
    }
}

/// Trace one object: enqueue every payload word that can reference another
/// registered object. Exact for builtin containers, conservative for user
/// classes.
fn geTrace(object: int) {
    var classId = 0
    var size = 0
    unsafe {
        var header = object as *int
        classId = header[WO_CLASS]
        size = header[WO_SIZE]
    }
    if (classId == CLA_LIST) {
        unsafe {
            var header = object as *int
            var length = header[WO_LIST_LEN]
            var data = header[WO_LIST_DATA] as *int
            if ((data as int) != 0) {
                var element = 0
                while (element < length) {
                    geEnqueue(data[element])
                    element = element + 1
                }
            }
        }
        return
    }
    if (classId == CLA_MAP) {
        unsafe {
            var header = object as *int
            var capacity = header[WO_MAP_CAP]
            var entries = header[WO_MAP_ENTRIES] as *int
            if ((entries as int) != 0) {
                var slot = 0
                while (slot < capacity) {
                    // Open addressing: key/value word pairs; the marker
                    // integers (0/1/2) are skipped so a marker is never walked.
                    var key = entries[slot * 2]
                    if (key > 2) {
                        geEnqueue(key)
                    }
                    geEnqueue(entries[slot * 2 + 1])
                    slot = slot + 1
                }
            }
        }
        return
    }
    if (classId == CLA_ENUM) {
        var slotCount = 0
        if (size > HEADER_BYTES + 8) {
            slotCount = (size - HEADER_BYTES - 8) / 8
        }
        unsafe {
            var header = object as *int
            var slot = 0
            while (slot < slotCount) {
                geEnqueue(header[WO_PAYLOAD + slot])
                slot = slot + 1
            }
        }
        return
    }
    if (classId == CLA_TUPLE) {
        unsafe {
            var header = object as *int
            var length = header[WO_TUPLE_LEN]
            var slot = 0
            while (slot < length) {
                geEnqueue(header[WO_PAYLOAD + slot])
                slot = slot + 1
            }
        }
        return
    }
    // Strings (0), boxes (3/4/5/6), streams (9): neither traced.
    if (classId <= CLA_STREAM) {
        return
    }
    // User class (>= 10): walk every payload word conservatively.
    var slotCount = 0
    if (size > HEADER_BYTES) {
        slotCount = (size - HEADER_BYTES) / 8
    }
    unsafe {
        var header = object as *int
        var slot = 0
        while (slot < slotCount) {
            geEnqueue(header[WO_CLASS_PAYLOAD + slot])
            slot = slot + 1
        }
    }
}

/// Seed the worklist from the port's root set (static-root cells + manual
/// registry + in-flight temp leases), the shadow chain, then drain it.
fn geMarkFromRoots() {
    markPendingLen = 0
    var root = 0
    while (root < rootsCount) {
        unsafe {
            var cell = (rootsBase as *int)[root]
            if (cell != 0) {
                geEnqueue(((cell as *int)[0]) as int)
            }
        }
        root = root + 1
    }
    var manual = 0
    while (manual < manCount) {
        unsafe {
            geEnqueue((manBase as *int)[manual])
        }
        manual = manual + 1
    }
    var temp = 0
    while (temp < teCount) {
        unsafe {
            geEnqueue((teBase as *int)[temp])
        }
        temp = temp + 1
    }
    /// Every registered thread's frame chain is a root set, walked under the
    /// registry lock the way native's trace holds `lock_registry()` over
    /// `all_threads()` (gc.rs). In the single-thread contract there is exactly
    /// one node, so this is the same set the per-thread head walk covered.
    shadowRegistryLockAcquire()
    var threadNode = abiShadowRegistryHead()
    while (threadNode != 0) {
        unsafe {
            geMarkFromShadow((threadNode as *int)[0])
            // Per-thread temp-root leases. The node is parked (or is the
            // collector) while this runs, so the array cannot be growing.
            var tb = (threadNode as *int)[SHADOW_W_TEMP_BASE]
            var tc = (threadNode as *int)[SHADOW_W_TEMP_COUNT]
            var ti = 0
            while (ti < tc) {
                geEnqueue((tb as *int)[ti])
                ti = ti + 1
            }
            threadNode = (threadNode as *int)[SHADOW_W_NEXT]
        }
    }
    shadowRegistryLockRelease()
    while (markPendingLen > 0) {
        markPendingLen = markPendingLen - 1
        var object = 0
        unsafe {
            object = (markPending as *int)[markPendingLen]
        }
        geTrace(object)
    }
}

/// Free an object's out-of-line backing span, if any: a list's element block or
/// a map's entry table (both at word 5/6). A map stores an INTERIOR pointer -
/// its table starts `MAP_BLOOM_OFF` bytes into the block - so the block base is
/// recovered before the release. That matters as soon as the span is too large
/// for the managed arena: `abiManagedRelease` can only free a raw block at its
/// base, and handing it `base + MAP_BLOOM_OFF` is a `HeapFree` of an interior
/// pointer (heap corruption). Arena spans would tolerate either address, which
/// is why this only surfaced for maps whose capacity crossed the bump limit.
fn geReleaseOutOfLine(object: int) {
    unsafe {
        var header = object as *int
        var classId = header[WO_CLASS]
        var span = 0
        if (classId == CLA_LIST) {
            span = header[WO_LIST_DATA]
        } else if (classId == CLA_MAP) {
            span = header[WO_MAP_ENTRIES]
            if (span != 0) {
                span = span - MAP_BLOOM_OFF
            }
        }
        if (span != 0) {
            abiManagedRelease(span)
        }
    }
}

/// Invoke a registered `deinit` finalizer. The engine stores finalizers as
/// plain function ADDRESSES (the emitter passes the compiled `pkl_<T>_deinit`
/// address to `pickle_class_register`, and the abi_classwords leaf keeps it as
/// an int word so the sweep can compare against 0 without a callable value).
/// Casting the address back to a callable is the int-to-fn word cast the
/// compiler allows for exactly this ABI use (native transmutes the same word
/// in `class_register`, gc.rs lines 175-183). A zero address is the no-desc
/// case and is skipped - native's `builtin_nop_finalizer` equivalent.
fn geRunFinalizer(fin: int, object: int) {
    if (fin == 0) {
        return
    }
    unsafe {
        var f = fin as fn (*int) -> void
        f(object as *int)
    }
}

/// Release every `#[manualAlloc]` field of a dead (deferred) object, following
/// the class descriptor's owned-slot mask: child payload slots named by set
/// bits are handed to `abiEngineManualFree` WHEN they are still registered as
/// manual - a child that was already released, or never was a manual object,
/// is skipped. Recursion into `abiEngineManualFree` re-reads the child's own
/// mask and deregisters it FIRST, so ownership cycles terminate instead of
/// looping (native `free_owned_fields`, gc.rs lines 274-288, whose manual
/// registry `contains` check this mirrors). Owned slots join the payload at
/// `WO_CLASS_PAYLOAD`, like every user-class slot.
fn geFreeOwnedFields(object: int) {
    var classId = 0
    unsafe {
        classId = (object as *int)[WO_CLASS]
    }
    var owned = abiClassOwnedMaskOf(classId)
    if (owned == 0) {
        return
    }
    var bit = 0
    while (bit < 64) {
        if ((owned & (1 << bit)) != 0) {
            var child = 0
            unsafe {
                child = (object as *int)[WO_CLASS_PAYLOAD + bit]
            }
            if (child != 0) {
                abiEngineManualFree(child as *int)
            }
        }
        bit = bit + 1
    }
}

/// One sweep decision. Returns 1 when `address` survives, 0 when it was
/// released or deferred. A pinned object survives without being cleared: its
/// maker may still be about to return it, so the pin is dropped only once a
/// trace reaches the object (`geEnqueue` turns the pin into `MARK_SENTINEL`).
fn geSweepCandidate(address: int) -> int {
    if (gePinnedNow(address)) {
        return 1
    }
    if (geMarkedNow(address)) {
        unsafe {
            ((address as int) as *int)[0] = 0
        }
        return 1
    }
    var classId = 0
    unsafe {
        classId = (address as *int)[WO_CLASS]
    }
    var deferIt = 0
    if (classId >= 10) {
        if (abiClassOwnedMaskOf(classId) != 0 || abiClassFinalizerOf(classId) != 0) {
            deferIt = 1
        }
    }
    if (deferIt == 1) {
        defBase = geGrow(defBase, defCap, defCount, DEF_INITIAL)
        defCap = geCapGrown(defCap, defCount, DEF_INITIAL)
        unsafe {
            (defBase as *int)[defCount] = address
        }
        defCount = defCount + 1
        return 0
    }
    geReleaseOutOfLine(address)
    // Read the size before freeing: `free` may overwrite the header.
    var size = 0
    unsafe {
        size = (address as *int)[2]
    }
    regBytes = regBytes - size
    abiManagedRelease(address)
    return 0
}

/// Compact one thread's private registry block in place, exactly like the
/// legacy global block, then reset the thread's allocation counter.
fn geSweepBlock(rec: *int) {
    var baseAddr = 0
    var count = 0
    unsafe {
        baseAddr = rec[SHADOW_W_REG_BASE]
        count = rec[SHADOW_W_REG_COUNT]
    }
    // Fold this thread's pending registration statistics into the
    // process-wide counters before the sweep subtracts freed sizes from
    // `regBytes`. The collector is the only writer here (all mutators are
    // parked), so these are ordinary stores. `ALLOC_BYTES`/`ALLOC_COUNT` are
    // the since-GC words the accessors read; they are zeroed at the end of the
    // block, together with the trigger counter.
    unsafe {
        regBytes = regBytes + rec[SHADOW_W_REG_BYTES]
        rec[SHADOW_W_REG_BYTES] = 0
    }
    if (baseAddr != 0 && count > 0) {
        let base = baseAddr as *int
        var w = 0
        var r = 0
        while (r < count) {
            var address = 0
            unsafe {
                address = base[r]
            }
            if (geSweepCandidate(address) == 1) {
                if (w != r) {
                    unsafe {
                        base[w] = address
                    }
                }
                w = w + 1
            }
            r = r + 1
        }
        unsafe {
            rec[SHADOW_W_REG_COUNT] = w
            rec[SHADOW_W_ALLOC_BYTES] = 0
            rec[SHADOW_W_ALLOC_COUNT] = 0
        }
    } else {
        unsafe {
            rec[SHADOW_W_ALLOC_BYTES] = 0
            rec[SHADOW_W_ALLOC_COUNT] = 0
        }
    }
}

// ------------------------------------------------------------- safepoints
//
// PHASE 3: stop-the-world collection. The world lock still serialises Pickle
// execution today, so these paths mostly observe one running thread; they are
// the contract Phase 4 removes the lock against. The invariant they build is:
//
//   - every thread that can touch the managed heap is counted in
//     `gcRunningCount` while it is RUNNING;
//   - before it mutates the heap it passes a safepoint (`abiGcPoll`), which
//     parks it when `gcRequested` is set;
//   - a thread in a blocking OS call is NATIVE and not counted;
//   - the collector sets `gcRequested`, excludes itself, and waits for the
//     count to reach zero before it marks or sweeps.
//
// The count and the collector's wait share `gcCountLock`; each thread parks on
// its own node's `parkLock`/`parkCv` pair. Lock order is parkLock ->
// gcCountLock; the collector's wake walk takes only parkLock and its wait
// takes only gcCountLock, so the graph is acyclic.
const GE_WORD_BYTES: int = 8

/// 0 until the process gains its second thread. Mirrors the allocator's
/// `parallelMode`, but lives here so the poll and the collector share one
/// switch and `abi_gcengine` stays a leaf of `abi_raw`.
var gcParallel: int = 0

/// 0 when no collection is in progress; 1 while a collector is stopping the
/// world and running mark/sweep. Written by the collector, read by every poll.
var gcRequested: int = 0

/// Threads that are RUNNING, plus threads parked at a safepoint until the
/// poll's decrement lands. Excludes NATIVE threads and the collector.
var gcRunningCount: int = 0

/// Serialises updates to `gcRunningCount` and guards the collector's wait.
var gcCountLock: int = 0

/// One collector at a time. Held only across the request/claim transition.
var gcStartLock: int = 0

/// The collector's condition variable, paired with `gcCountLock`.
var gcCollectorCv: int = 0

/// Address of a word inside a raw node.
fn geNodeWord(base: int, word: int) -> int {
    return base + GE_WORD_BYTES * word
}

/// Addresses of the safepoint's own synchronization words, for the
/// `abi_world_win` seam. A zero-initialized `SRWLOCK`/`CONDITION_VARIABLE` is
/// the Win32 unlocked/empty state, so no explicit initialisation is needed.
fn geCountLockAddr() -> int {
    var p = 0
    unsafe {
        p = (&gcCountLock) as int
    }
    return p
}

fn geStartLockAddr() -> int {
    var p = 0
    unsafe {
        p = (&gcStartLock) as int
    }
    return p
}

fn geCollectorCvAddr() -> int {
    var p = 0
    unsafe {
        p = (&gcCollectorCv) as int
    }
    return p
}

/// The safepoint. Every thread that can mutate the managed heap passes this
/// before the mutation: allocation entry, loop back-edges, and the return from
/// a native section. It is one load and a not-taken branch when no collection
/// is pending, which is the common case.
///
/// The park protocol is the classic condition-variable one: the thread owns its
/// `parkLock` across the predicate check and the atomic release inside
/// `winParkOn`, so the collector cannot clear `gcRequested` between the check
/// and the sleep without first taking `parkLock` - which it can only do after
/// the sleeper has released it.
#[symbol("pickle_gc_poll")]
fn abiGcPoll() {
    if (gcRequested == 0) {
        return
    }
    var self = abiShadowSelfIfRegistered()
    if (self == 0) {
        // No lock, no registration: a poll can run inside `pickle_shadow_push`
        // before the thread's TLS slot is published, and `abiShadowSelf` would
        // take the non-reentrant `shadowLock` that push already holds. A poll
        // on a thread the collector cannot see is also meaningless - the
        // collector only waits for counted threads, and registration happens
        // before the first heap mutation.
        return
    }
    let node = self as *int
    let lockAddr = geNodeWord(self, SHADOW_W_PARK_LOCK)
    let cvAddr = geNodeWord(self, SHADOW_W_PARK)
    unsafe {
        // A finalizer running on the collector thread must never park on the
        // collection it is part of.
        if (node[SHADOW_W_STATE] == SHADOW_STATE_COLLECTING) {
            return
        }
        // Runtime-internal critical section: a peer may be blocked on the
        // lock this thread holds (with `winLockAcquire`, so it is counted and
        // cannot park). Parking here would stall the collector's barrier
        // forever. The thread parks at its next poll outside the section.
        if (node[SHADOW_W_CRITICAL] != 0) {
            return
        }
        winLockAcquire(lockAddr)
        if (gcRequested != 0) {
            node[SHADOW_W_STATE] = SHADOW_STATE_PARKED
            winLockAcquire(geCountLockAddr())
            gcRunningCount = gcRunningCount - 1
            winWakeOn(geCollectorCvAddr())
            winLockRelease(geCountLockAddr())
            while (gcRequested != 0) {
                winParkOn(lockAddr, cvAddr)
            }
            node[SHADOW_W_STATE] = SHADOW_STATE_RUNNING
            winLockAcquire(geCountLockAddr())
            gcRunningCount = gcRunningCount + 1
            winLockRelease(geCountLockAddr())
        }
        winLockRelease(lockAddr)
    }
}

/// Mark this thread as blocked in an OS call: it will not touch the managed
/// heap until `abiGcLeaveNative`, so the collector must not wait for it.
/// Idempotent, and a no-op on the collector thread (already excluded).
fn abiGcEnterNative() {
    if (gcParallel == 0) {
        return
    }
    var self = abiShadowSelfIfRegistered()
    if (self == 0) {
        self = abiShadowSelf()
    }
    let node = self as *int
    unsafe {
        let state = node[SHADOW_W_STATE]
        if (state == SHADOW_STATE_NATIVE || state == SHADOW_STATE_COLLECTING) {
            return
        }
        node[SHADOW_W_STATE] = SHADOW_STATE_NATIVE
    }
    winLockAcquire(geCountLockAddr())
    gcRunningCount = gcRunningCount - 1
    // Wake the collector while the count lock is still held: a collector that
    // has already decided to wait must not miss this decrement. A wake after
    // the release can arrive between the predicate check and the sleep.
    winWakeOn(geCollectorCvAddr())
    winLockRelease(geCountLockAddr())
}

/// Return from a native section: count the thread again, then run a safepoint
/// before it can touch the heap. The poll may park; the count is restored
/// first so the collector's barrier already covers this thread.
fn abiGcLeaveNative() {
    if (gcParallel == 0) {
        return
    }
    var self = abiShadowSelfIfRegistered()
    if (self == 0) {
        return
    }
    let node = self as *int
    unsafe {
        if (node[SHADOW_W_STATE] != SHADOW_STATE_NATIVE) {
            return
        }
        node[SHADOW_W_STATE] = SHADOW_STATE_RUNNING
    }
    winLockAcquire(geCountLockAddr())
    gcRunningCount = gcRunningCount + 1
    winLockRelease(geCountLockAddr())
    abiGcPoll()
}

/// Count a thread that is about to be created. The spawner calls this before
/// `CreateThread`, so the child is covered from before its first instruction; a
/// failed create must call `abiGcThreadExited`.
fn abiGcThreadStarting() {
    if (gcParallel == 0) {
        return
    }
    winLockAcquire(geCountLockAddr())
    gcRunningCount = gcRunningCount + 1
    winLockRelease(geCountLockAddr())
}

/// Uncount a thread that has left Pickle code. Called after the last heap
/// mutation and before the OS thread exits.
fn abiGcThreadExited() {
    if (gcParallel == 0) {
        return
    }
    // A thread that exits while it is still in a native section was already
    // uncounted by `abiGcEnterNative`; decrementing here would corrupt the
    // barrier count for every later collection.
    var self = abiShadowSelfIfRegistered()
    if (self != 0) {
        unsafe {
            // The thread is gone; its leases are no longer roots. Zeroing here
            // also keeps a throw that unwound past a helper from retaining
            // objects forever.
            (self as *int)[SHADOW_W_TEMP_COUNT] = 0
            if ((self as *int)[SHADOW_W_STATE] == SHADOW_STATE_NATIVE) {
                return
            }
        }
    }
    winLockAcquire(geCountLockAddr())
    gcRunningCount = gcRunningCount - 1
    winWakeOn(geCollectorCvAddr())
    winLockRelease(geCountLockAddr())
}

/// One collection cycle: mark from the port's roots, sweep the unmarked
/// registered population back to the OS heap (list/map spans included), refresh
/// the live figure, zero the seam counters, then adapt the threshold unless a
/// `set_threshold` (or a `PKL_GC_THRESHOLD` override) pinned it. `force` is
/// accepted and ignored - native v1 always collects.
fn abiEngineCollect(force: bool) {
    let parallel = gcParallel
    if (parallel != 0 && gcRequested != 0) {
        // Another thread owns the collection. A finalizer nested inside it
        // (state COLLECTING) must not park on the collection it is part of;
        // the `collecting` guard below is its answer.
        var self = abiShadowSelfIfRegistered()
        if (self != 0) {
            unsafe {
                if ((self as *int)[SHADOW_W_STATE] == SHADOW_STATE_COLLECTING) {
                    return
                }
            }
        }
        abiGcPoll()
        return
    }
    if (parallel == 0 && collecting != 0) {
        return
    }
    var collectorNode = 0
    if (parallel != 0) {
        // The collector token is `collecting`, and it is held until the
        // epilogue has restored this thread's count and state. `gcRequested`
        // is only the mutator-park flag; the epilogue clears it earlier, to
        // release the barrier, so it cannot double as the token. Clearing the
        // token before the restore let a thread entering here claim a second
        // collection with this one still excluded (count 0), drive the count
        // negative, and sleep forever on the collector CV because the restore
        // no longer matched its decrement.
        winLockAcquire(geStartLockAddr())
        if (gcRequested != 0) {
            winLockRelease(geStartLockAddr())
            abiGcPoll()
            return
        }
        if (collecting != 0) {
            // Epilogue window: the collection is over, only the bookkeeping
            // is left. Return without collecting; the caller's next allocation
            // polls normally.
            winLockRelease(geStartLockAddr())
            return
        }
        collecting = 1
        gcRequested = 1
        winLockRelease(geStartLockAddr())
        collectorNode = abiShadowSelfIfRegistered()
        if (collectorNode != 0) {
            unsafe {
                (collectorNode as *int)[SHADOW_W_STATE] = SHADOW_STATE_COLLECTING
            }
        }
        // Exclude the collector from the barrier, then wait for every other
        // RUNNING thread to park. A thread that is NATIVE is not counted.
        winLockAcquire(geCountLockAddr())
        gcRunningCount = gcRunningCount - 1
        while (gcRunningCount != 0) {
            winParkOn(geCountLockAddr(), geCollectorCvAddr())
        }
        winLockRelease(geCountLockAddr())
    } else {
        collecting = 1
    }
    collections = collections + 1
    var workCount = abiEngineRegisteredCount()
    if (workCount < 1) {
        workCount = 1
    }
    unsafe {
        markPending = alloc(int, workCount) as int
    }
    markPendingLen = 0
    geSetBuild()
    geMarkFromRoots()
    unsafe {
        free(regSetBase as *int)
    }
    regSetBase = 0
    regSetCap = 0
    // Compact sweep: one O(regCount) pass. Live objects are kept (mark cleared)
    // and packed toward the front; dead objects release their out-of-line span
    // and are freed, their bytes un-counted. This replaces a per-dead
    // swap-with-last `abiEngineUnregister`, whose linear registry scan made the
    // sweep quadratic. `write <= read` always, so packing never clobbers a slot
    // that has not been read yet.
    //
    // Deferral: a dead USER class whose descriptor carries a `deinit` finalizer
    // or a non-zero owned-slot mask is NOT freed here - its block is parked on
    // the deferred list so the post-sweep phase below can run the finalizer and
    // release owned fields while the block still exists (native's
    // `should_defer` arm, gc.rs lines 422-436). Builtins are never deferred:
    // list/map/string spans are released inline below like every other dead
    // object.
    var write = 0
    var read = 0
    while (read < regCount) {
        var address = abiEngineRegisteredAt(read)
        if (geSweepCandidate(address) == 1) {
            if (write != read) {
                unsafe {
                    (regBase as *int)[write] = address
                }
            }
            write = write + 1
        }
        read = read + 1
    }
    regCount = write
    // Parallel-mode registries: each thread's block is private, so it needs no
    // lock while it allocates. The sweep is the one place that touches them
    // from another thread; the shadow registry lock keeps the node list and
    // the block pointers stable.
    //
    // INVARIANT: no function called between this acquire and the release may
    // own a managed home and be may-GC. Such a function pushes a shadow frame in
    // its prologue, which re-enters this non-recursive SRW lock and deadlocks
    // the collector against itself. `geSweepBlock`/`geSweepCandidate` are
    // deliberately kept free of that shape (the SRW imports are in
    // `externMayCollect`'s cannot-collect list).
    shadowRegistryLockAcquire()
    var tnode = abiShadowRegistryHead()
    while (tnode != 0) {
        unsafe {
            geSweepBlock(tnode as *int)
            tnode = (tnode as *int)[SHADOW_W_NEXT]
        }
    }
    shadowRegistryLockRelease()
    unsafe {
        free(markPending as *int)
    }
    markPending = 0
    markPendingLen = 0
    liveBytes = regBytes
    // Post-sweep finalizer phase, with `collecting` still 1 so a finalizer that
    // allocates cannot start a nested collection (native gc.rs runs its two
    // passes inside the same guard). Pass one runs finalizers and releases
    // owned fields recursively; pass two frees the blocks and un-counts their
    // bytes. Owned-field release deregisters children from the manual registry
    // before recursing, so ownership cycles terminate.
    var di = 0
    while (di < defCount) {
        var obj = 0
        unsafe {
            obj = (defBase as *int)[di]
        }
        var classId = 0
        unsafe {
            classId = (obj as *int)[WO_CLASS]
        }
        var fin = abiClassFinalizerOf(classId)
        if (fin != 0) {
            geRunFinalizer(fin, obj)
        }
        geFreeOwnedFields(obj)
        di = di + 1
    }
    di = 0
    while (di < defCount) {
        var obj = 0
        unsafe {
            obj = (defBase as *int)[di]
        }
        // Read the size before freeing: `free` may overwrite the header.
        var size = 0
        unsafe {
            size = (obj as *int)[2]
        }
        regBytes = regBytes - size
        abiManagedRelease(obj)
        di = di + 1
    }
    defCount = 0
    rawAllocCount = 0
    rawAllocBytes = 0
    if (thresholdManual == 0) {
        threshold = geAdaptiveNext(liveBytes)
    }
    if (parallel != 0) {
        // Release the mutators. The flag is cleared before the walk, so a
        // thread that reaches the poll now simply returns; a thread already
        // inside the park protocol is serialised by its own park lock.
        gcRequested = 0
        shadowRegistryLockAcquire()
        var wakeNode = abiShadowRegistryHead()
        while (wakeNode != 0) {
            let lockAddr = geNodeWord(wakeNode, SHADOW_W_PARK_LOCK)
            let cvAddr = geNodeWord(wakeNode, SHADOW_W_PARK)
            winLockAcquire(lockAddr)
            winWakeAllOn(cvAddr)
            winLockRelease(lockAddr)
            unsafe {
                wakeNode = (wakeNode as *int)[SHADOW_W_NEXT]
            }
        }
        shadowRegistryLockRelease()
        winLockAcquire(geCountLockAddr())
        gcRunningCount = gcRunningCount + 1
        winLockRelease(geCountLockAddr())
        if (collectorNode != 0) {
            unsafe {
                (collectorNode as *int)[SHADOW_W_STATE] = SHADOW_STATE_RUNNING
            }
        }
        // Only now, with this thread counted again and its state restored, is
        // the token free: a new collector that claims it will observe a
        // consistent count and cannot wait for a barrier this collection has
        // already satisfied.
        winLockAcquire(geStartLockAddr())
        collecting = 0
        winLockRelease(geStartLockAddr())
    } else {
        collecting = 0
    }
}

// ------------------------------------------------------------- accessors
fn abiEngineCollectionCount() -> int {
    return collections
}

/// Threads the collector currently counts as RUNNING, the collector itself
/// included. In single-thread mode it stays 0 (no thread was ever counted).
/// Exported for the Phase 3 gate: after any spawn/join/collect cycle it must
/// return to exactly 1, which is the only cheap way to catch an unbalanced
/// native/leave-native transition - the failure mode that turns into a hang
/// much later, under load.
fn abiEngineRunningCount() -> int {
    return gcRunningCount
}

/// Is the process in the multi-thread collection regime? Exported for the gate
/// so a test can assert it is exercising the STW path rather than the
/// single-thread one.
fn abiEngineParallelNow() -> int {
    return gcParallel
}

fn abiEngineSetThreshold(bytes: int) {
    threshold = bytes
    thresholdManual = 1
}

fn abiEngineThresholdNow() -> int {
    return threshold
}

fn abiEngineLiveBytesNow() -> int {
    return liveBytes
}

fn abiEngineRootCount() -> int {
    return rootsCount
}

fn abiEngineManualCount() -> int {
    return manCount
}

/// Acquire one of the collector's own registry locks (temp roots, manual
/// roots, static roots). The section is marked critical so a loop-header poll
/// inside it cannot park the holder: a peer blocked on the same lock is
/// counted and cannot reach a safepoint, so a parked holder would hang the
/// collector's barrier. `abiGcPoll` returns early while the depth is non-zero.
fn geLock(cell: int) {
    shadowCriticalEnter()
    winLockAcquire(cell)
}

/// Release a lock taken by `geLock`, leaving the critical section only after
/// the lock is free.
fn geUnlock(cell: int) {
    winLockRelease(cell)
    shadowCriticalExit()
}

/// Register a static root cell (the address of a `*mut PickleObject` slot).
/// Returns the cell address (emitted callers discard it).
///
/// The emitted `pickle_gc_root_add` calls all run in `main`'s entry block, so
/// contention is theoretical; the lock exists because the append is a
/// grow-and-store and a second thread calling `pickle_gc_root_add` directly
/// must not be able to lose an entry.
fn abiEngineRootAdd(cell: int) -> int {
    unsafe {
        geLock((&rootsLock) as int)
        rootsBase = geGrow(rootsBase, rootsCap, rootsCount, ROOTS_INITIAL)
        rootsCap = geCapGrown(rootsCap, rootsCount, ROOTS_INITIAL)
        (rootsBase as *int)[rootsCount] = cell
        rootsCount = rootsCount + 1
        geUnlock((&rootsLock) as int)
    }
    return cell
}

/// Temporarily root `obj` while a helper is still building it. Unlike
/// `abiEngineManualAdopt` the flag word is untouched: this is purely a
/// liveness lease, so a nested collection inside the helper cannot sweep the
/// not-yet-published value. The helper must call `abiEngineTempUnroot` before
/// returning a value that has been published to a slot/frame/root. Null is
/// ignored and re-rooting is idempotent - mirrors `gc.rs::temp_root`, whose
/// `contains` guard this is.
fn abiEngineTempRoot(obj: *int) {
    if ((obj as int) == 0) {
        return
    }
    unsafe {
        // Fast path: the lease lives on this thread's shadow node, so root and
        // unroot need no lock. The collector reaches it through the same
        // registry walk that already visits the frame chain.
        let node = abiShadowSelfIfRegistered()
        if (node != 0) {
            // No lock, but the append still has to be atomic with respect to a
            // collection: the object is not reachable from any frame yet, and
            // the dedupe loop carries a loop-header poll. Parking (or becoming
            // the collector) between the probe and the store would let sweep
            // reclaim a live object. The critical section makes `abiGcPoll`
            // return early until the lease is published.
            shadowCriticalEnter()
            var base = (node as *int)[SHADOW_W_TEMP_BASE]
            var count = (node as *int)[SHADOW_W_TEMP_COUNT]
            var cap = (node as *int)[SHADOW_W_TEMP_CAP]
            var i = 0
            var found = false
            while (i < count) {
                if ((base as *int)[i] == (obj as int)) {
                    found = true
                    break
                }
                i = i + 1
            }
            if (!found) {
                let newCap = geCapGrown(cap, count, TE_INITIAL)
                if (newCap != cap) {
                    base = geGrow(base, cap, count, TE_INITIAL)
                    cap = newCap
                    (node as *int)[SHADOW_W_TEMP_BASE] = base
                    (node as *int)[SHADOW_W_TEMP_CAP] = cap
                }
                (base as *int)[count] = obj as int
                (node as *int)[SHADOW_W_TEMP_COUNT] = count + 1
            }
            shadowCriticalExit()
            return
        }
        // A thread that has not registered yet (runtime init, the pre-prologue
        // window of a spawn) falls back to the process list. This is cold.
        abiEngineTempRootShared(obj)
    }
}

/// Root `obj` on the process-wide lease list instead of this thread's node.
/// The `spawn` handoff needs this shape: the parent roots the entry/body
/// closures, but the *child* releases them once its prologue has run, so the
/// lease must be visible across threads. Runtime helpers stay on the lock-free
/// per-thread path above.
fn abiEngineTempRootShared(obj: *int) {
    if ((obj as int) == 0) {
        return
    }
    unsafe {
        geLock((&teLock) as int)
        var found = false
        var i = 0
        while (i < teCount) {
            if ((teBase as *int)[i] == (obj as int)) {
                found = true
                break
            }
            i = i + 1
        }
        if (found) {
            geUnlock((&teLock) as int)
            return
        }
        teBase = geGrow(teBase, teCap, teCount, TE_INITIAL)
        teCap = geCapGrown(teCap, teCount, TE_INITIAL)
        (teBase as *int)[teCount] = obj as int
        teCount = teCount + 1
        geUnlock((&teLock) as int)
    }
}

/// Release a lease taken by `abiEngineTempRootShared`. Cross-thread by design,
/// so it takes the process list lock even when called from a registered child.
fn abiEngineTempUnrootShared(obj: *int) {
    unsafe {
        geLock((&teLock) as int)
        var i = 0
        while (i < teCount) {
            if ((teBase as *int)[i] == (obj as int)) {
                (teBase as *int)[i] = (teBase as *int)[teCount - 1]
                (teBase as *int)[teCount - 1] = 0
                teCount = teCount - 1
                geUnlock((&teLock) as int)
                return
            }
            i = i + 1
        }
        geUnlock((&teLock) as int)
    }
}

/// Release the liveness lease on `obj` taken by `abiEngineTempRoot`. An
/// address that holds no lease is ignored - mirrors `gc.rs::temp_unroot`'s
/// `retain` becoming a no-op for absent entries.
fn abiEngineTempUnroot(obj: *int) {
    unsafe {
        let node = abiShadowSelfIfRegistered()
        if (node != 0) {
            let base = (node as *int)[SHADOW_W_TEMP_BASE]
            let count = (node as *int)[SHADOW_W_TEMP_COUNT]
            var i = 0
            while (i < count) {
                if ((base as *int)[i] == (obj as int)) {
                    (base as *int)[i] = (base as *int)[count - 1]
                    (base as *int)[count - 1] = 0
                    (node as *int)[SHADOW_W_TEMP_COUNT] = count - 1
                    return
                }
                i = i + 1
            }
            return
        }
        abiEngineTempUnrootShared(obj)
    }
}

/// Number of registered temp-root leases - exported for tests.
/// Total temp-root leases across every registered thread. Nodes are never
/// retired today, so the walk is lock-free: the collector only mutates counts
/// with word-sized stores, and a node is zeroed before it is linked. Taking
/// `shadowRegistryLock` here would put this poll-bearing loop under the lock,
/// letting a collection park the walker with the lock held.
fn abiEngineTempCount() -> int {
    var total = teCount
    var node = abiShadowRegistryHead()
    while (node != 0) {
        unsafe {
            total = total + (node as *int)[SHADOW_W_TEMP_COUNT]
            node = (node as *int)[SHADOW_W_NEXT]
        }
    }
    return total
}

/// Adopt `obj` as a programmer-owned allocation: register it unless already
/// present, and return it for chaining. Null is returned unchanged.
fn abiEngineManualAdopt(obj: *int) -> *int {
    if ((obj as int) == 0) {
        return obj
    }
    unsafe {
        geLock((&manLock) as int)
        var found = false
        var i = 0
        while (i < manCount) {
            if ((manBase as *int)[i] == (obj as int)) {
                found = true
                break
            }
            i = i + 1
        }
        if (found) {
            geUnlock((&manLock) as int)
            return obj
        }
        manBase = geGrow(manBase, manCap, manCount, MAN_INITIAL)
        manCap = geCapGrown(manCap, manCount, MAN_INITIAL)
        (manBase as *int)[manCount] = obj as int
        manCount = manCount + 1
        geUnlock((&manLock) as int)
    }
    return obj
}

/// Release an object adopted with `abiEngineManualAdopt`: remove it from the
/// manual registry (swap-with-last), release its sweepability entry, run its
/// `deinit` finalizer, release owned fields recursively, free the list-map
/// span, and return the block itself to the heap. Null and an unknown address
/// are ignored (the caller-side `manual-registered` assert of native
/// `manual_free`, gc.rs line 537, stays a silent no-op here - the ABI's free
/// has no trap path in the port). Deregistering FIRST keeps a finalizer that
/// allocates from ever seeing a half-freed manual object.
fn abiEngineManualFree(obj: *int) {
    if ((obj as int) == 0) {
        return
    }
    var found = false
    unsafe {
        // Remove from the registry under the lock, then release it before the
        // teardown below: a finalizer may allocate (and therefore collect), and
        // the collector must never see this lock held by a parked thread.
        geLock((&manLock) as int)
        var i = 0
        while (i < manCount && !found) {
            if ((manBase as *int)[i] == (obj as int)) {
                (manBase as *int)[i] = (manBase as *int)[manCount - 1]
                (manBase as *int)[manCount - 1] = 0
                manCount = manCount - 1
                found = true
            } else {
                i = i + 1
            }
        }
        geUnlock((&manLock) as int)
    }
    if (!found) {
        return
    }
    abiEngineUnregister(obj)
    var classId = 0
    unsafe {
        classId = (obj as int as *int)[WO_CLASS]
    }
    var fin = abiClassFinalizerOf(classId)
    if (fin != 0) {
        geRunFinalizer(fin, obj as int)
    }
    geFreeOwnedFields(obj as int)
    geReleaseOutOfLine(obj as int)
    // Registry bookkeeping already happened inside `abiEngineUnregister`
    // (count + bytes), so this is only the block release.
    abiManagedRelease(obj as int)
}
