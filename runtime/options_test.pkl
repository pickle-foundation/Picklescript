module runtime.options_test

import { optNum, NONE_SENTINEL } from runtime.options

test fn some_unwraps_to_value() {
    var v: int? = 42
    expect(optNum(v)).toBe(42)
}

test fn none_maps_to_sentinel() {
    var v: int? = none
    expect(optNum(v)).toBe(NONE_SENTINEL)
}

test fn sentinel_value() {
    expect(NONE_SENTINEL).toBe(-2147483647)
}