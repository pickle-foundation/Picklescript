module runtime.abi_math_test

// Exercises `runtime.abi_math` through the ported test driver (GATE10): the
// `**` and `in` operators lower to these `#[symbol]` bodies, so importing the
// module binds them and every expression below runs the PORTED body, not the
// Rust archive's.
//
// The float rows are deliberately bit-sensitive: `pickle_float_pow` mirrors
// `math.rs` operation for operation (exact by-squaring for an integral
// exponent, `2^(exp*log2(base))` otherwise), so these decimal literals are the
// exact results the native routine produces - a platform `pow` would answer
// differently.

import { abiIntPow, abiFloatPow, abiListIndexOf, abiListLastIndexOf, abiListSumI64, abiListSumF64, abiListMin, abiListMax } from runtime.abi_math
import { listNew, abiListPush } from runtime.abi_list
import { abiBoxI64, abiUnboxI64, abiBoxF64, abiUnboxF64 } from runtime.abi_box
import { abiStrFromByte } from runtime.abi_string

test fn int_pow_matches_repeated_multiplication() {
    expect(abiIntPow(2, 10)).toBe(1024)
    expect(2 ** 10).toBe(1024)
    expect(3 ** 0).toBe(1)
    expect(0 ** 0).toBe(1)
    expect((0 - 2) ** 3).toBe(0 - 8)
    expect((0 - 2) ** 4).toBe(16)
    expect(5 ** 1).toBe(5)
}

test fn int_pow_negative_exponent_rounds_toward_zero() {
    expect(1 ** (0 - 5)).toBe(1)
    expect((0 - 1) ** (0 - 5)).toBe(0 - 1)
    expect((0 - 1) ** (0 - 4)).toBe(1)
    expect(2 ** (0 - 3)).toBe(0)
}

test fn int_pow_wraps_like_mul() {
    var base = 1000000000000000007
    var want = 1
    var i = 0
    while (i < 5) {
        want = want * base
        i = i + 1
    }
    expect(abiIntPow(base, 5)).toBe(want)
}

test fn float_pow_integral_is_exact() {
    expect(abiFloatPow(2.0, 10.0)).toBe(1024.0)
    expect(2.0 ** 10.0).toBe(1024.0)
    expect(1.5 ** (0 - 2)).toBe(0.4444444444444444)
    expect((0 - 2.0) ** 3.0).toBe(0.0 - 8.0)
    expect(2.0 ** 0.0).toBe(1.0)
    expect(1.0 ** 123.0).toBe(1.0)
    expect((0 - 1.5) ** 2.0).toBe(2.25)
}

test fn float_pow_non_integral_matches_the_mirrored_algorithm() {
    expect(2.0 ** 0.5).toBe(1.414213562373095)
    expect(9.0 ** 0.5).toBe(2.9999999999999996)
}

test fn float_pow_specials() {
    var a = abiFloatPow(0.0 - 2.0, 0.5)
    expect(a != a).toBe(true)
    var b = 0.0 / 0.0
    expect(abiFloatPow(b, 2.0) != abiFloatPow(1.0, 1.0)).toBe(true)
    expect(2.0 ** (0 - 1.0)).toBe(0.5)
}

test fn in_list_matches_structurally() {
    var xs = [1, 2, 3]
    expect(2 in xs).toBe(true)
    expect(9 in xs).toBe(false)
    var ss = ["alpha", "beta"]
    expect("beta" in ss).toBe(true)
    expect("gamma" in ss).toBe(false)
    var empty = [1]
    expect(1 in empty).toBe(true)
}

test fn in_map_tests_keys() {
    var m = {"a": 1, "b": 2}
    expect("a" in m).toBe(true)
    expect("z" in m).toBe(false)
}

test fn in_string_finds_byte_runs() {
    expect("ell" in "hello").toBe(true)
    expect("hello" in "hello").toBe(true)
    expect("" in "hello").toBe(true)
    expect("xyz" in "hello").toBe(false)
    expect("hellos" in "hello").toBe(false)
    expect("ol" in "hello").toBe(false)
}

test fn list_index_of_returns_the_first_match() {
    var xs = listNew(0)
    abiListPush(xs, abiBoxI64(5))
    abiListPush(xs, abiBoxI64(6))
    abiListPush(xs, abiBoxI64(7))
    abiListPush(xs, abiBoxI64(6))
    expect(abiUnboxI64(abiListIndexOf(xs, abiBoxI64(5)))).toBe(0)
    expect(abiUnboxI64(abiListIndexOf(xs, abiBoxI64(7)))).toBe(2)
    // Duplicates report the first occurrence, like a forward scan.
    expect(abiUnboxI64(abiListIndexOf(xs, abiBoxI64(6)))).toBe(1)
}

test fn list_index_of_returns_null_when_absent_or_empty() {
    var xs = listNew(0)
    abiListPush(xs, abiBoxI64(1))
    abiListPush(xs, abiBoxI64(2))
    abiListPush(xs, abiBoxI64(3))
    expect(abiListIndexOf(xs, abiBoxI64(9)) as int).toBe(0)
    var empty = listNew(0)
    expect(abiListIndexOf(empty, abiBoxI64(1)) as int).toBe(0)
}

test fn list_index_of_compares_structurally() {
    var a = listNew(0)
    abiListPush(a, abiBoxI64(1))
    abiListPush(a, abiBoxI64(2))
    var b = listNew(0)
    abiListPush(b, abiBoxI64(3))
    abiListPush(b, abiBoxI64(4))
    var outer = listNew(0)
    abiListPush(outer, a)
    abiListPush(outer, b)
    var probe = listNew(0)
    abiListPush(probe, abiBoxI64(3))
    abiListPush(probe, abiBoxI64(4))
    expect(abiUnboxI64(abiListIndexOf(outer, probe))).toBe(1)
}

test fn list_last_index_of_returns_the_final_match() {
    var xs = listNew(0)
    abiListPush(xs, abiBoxI64(5))
    abiListPush(xs, abiBoxI64(6))
    abiListPush(xs, abiBoxI64(7))
    abiListPush(xs, abiBoxI64(6))
    expect(abiUnboxI64(abiListLastIndexOf(xs, abiBoxI64(5)))).toBe(0)
    expect(abiUnboxI64(abiListLastIndexOf(xs, abiBoxI64(7)))).toBe(2)
    // Duplicates report the final occurrence, the mirror of `indexOf`.
    expect(abiUnboxI64(abiListLastIndexOf(xs, abiBoxI64(6)))).toBe(3)
}

test fn list_last_index_of_returns_null_when_absent_or_empty() {
    var xs = listNew(0)
    abiListPush(xs, abiBoxI64(1))
    abiListPush(xs, abiBoxI64(2))
    expect(abiListLastIndexOf(xs, abiBoxI64(9)) as int).toBe(0)
    var empty = listNew(0)
    expect(abiListLastIndexOf(empty, abiBoxI64(1)) as int).toBe(0)
}

test fn list_sum_adds_every_element() {
    var xs = listNew(0)
    // The empty sum is the additive identity, not a null.
    expect(abiListSumI64(xs)).toBe(0)
    abiListPush(xs, abiBoxI64(3))
    abiListPush(xs, abiBoxI64(0 - 4))
    abiListPush(xs, abiBoxI64(10))
    expect(abiListSumI64(xs)).toBe(9)
}

test fn list_sum_f64_adds_floats() {
    var xs = listNew(0)
    expect(abiListSumF64(xs)).toBe(0.0)
    abiListPush(xs, abiBoxF64(1.5))
    abiListPush(xs, abiBoxF64(0.0 - 0.25))
    abiListPush(xs, abiBoxF64(2.0))
    expect(abiListSumF64(xs)).toBe(3.25)
}

test fn list_min_max_pick_the_extremes() {
    var xs = listNew(0)
    expect(abiListMin(xs, 0) as int).toBe(0)
    expect(abiListMax(xs, 0) as int).toBe(0)
    abiListPush(xs, abiBoxI64(4))
    abiListPush(xs, abiBoxI64(0 - 2))
    abiListPush(xs, abiBoxI64(9))
    expect(abiUnboxI64(abiListMin(xs, 0))).toBe(0 - 2)
    expect(abiUnboxI64(abiListMax(xs, 0))).toBe(9)
}

test fn list_min_max_order_floats() {
    var xs = listNew(0)
    abiListPush(xs, abiBoxF64(0.5))
    abiListPush(xs, abiBoxF64(0.0 - 1.5))
    abiListPush(xs, abiBoxF64(2.25))
    expect(abiUnboxF64(abiListMin(xs, 1))).toBe(0.0 - 1.5)
    expect(abiUnboxF64(abiListMax(xs, 1))).toBe(2.25)
}

test fn list_min_max_compare_strings_by_bytes() {
    var xs = listNew(0)
    let a = abiStrFromByte(97)
    let b = abiStrFromByte(98)
    abiListPush(xs, b)
    abiListPush(xs, a)
    expect((abiListMin(xs, 2) as int) == (a as int)).toBe(true)
    expect((abiListMax(xs, 2) as int) == (b as int)).toBe(true)
}
