/// `abi_stream`'s close hook. A proc inner cannot exist while `run_spawn` has
/// no POSIX body, so there is nothing to reap; the file-stream arms never call
/// this.
fn abiProcClose(inner: *int) -> bool {
    return false
}

// ------------------------------------------------------------ args

/// `pickle_args`: the process arguments, excluding the program name, read
/// from the kernel's own argv block.
#[symbol("pickle_args")]
fn abiArgs() -> List<string> {
    unsafe {
        var out = noArgs()
        let c = cstrOf("/proc/self/cmdline")
        worldRelease()
        let fd = posix_open(c, O_RDONLY, 0)
        worldAcquire()
        free(c)
        if (fd < 0) {
            return out
        }
        // `/proc` files report size 0, so the loop grows the buffer by one
        // chunk at a time. A command line beyond 64 KiB is not a thing the
        // compiler can be asked to build.
        var cap = 65536
        var buf = alloc(int, cap / 8)
        var used = 0
        let chunk = alloc(int, DRAIN_WORDS)
        var done = false
        while (!done) {
            worldRelease()
            let n = posix_read(fd, chunk, DRAIN_BYTES)
            worldAcquire()
            if (n <= 0) {
                done = true
            } else {
                var b = 0
                while (b < n && used < cap) {
                    putRawByte(buf, used, rawByteAt(chunk, b))
                    used = used + 1
                    b = b + 1
                }
            }
        }
        free(chunk)
        let _ = posix_close(fd)
        // NUL-separated words; word 0 is the program name.
        var start = 0
        var i = 0
        var index = 0
        while (i < used) {
            if (rawByteAt(buf, i) == 0) {
                if (index > 0) {
                    out.push(strOfBytes(((buf as int) + start) as *int, i - start))
                }
                index = index + 1
                start = i + 1
            }
            i = i + 1
        }
        free(buf)
        return out
    }
}
