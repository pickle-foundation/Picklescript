module runtime.abi_threads

/// Port of the observable thread contract of `runtime/src/threads.rs` as real
/// `#[symbol]` bodies: all eight ABI symbols - spawn, join, finished,
/// panic_message, count, current, sleep_ms, yield.
///
/// WHAT THIS OWNS:
///
///   thread(8) spawn join finished panic_message count current sleep_ms yield
///
/// The 17.1 slice closes the other wall `abi_sync.pkl`'s header documented.
/// That header reserved thread because `pickle_thread_spawn` has the same
/// closure wall as once, and because join/finished/count index the native
/// `TASKS` registry that only a real spawn population keeps coherent. Both
/// halves are gone: a `#[symbol]` body can call a function-typed parameter
/// directly (no closure seam, as in `abi_once.pkl`), and the port keeps its
/// own spawn registry below. So the whole family is ported as one coherent
/// set, matching the all-or-nothing rule.
///
/// THE REFERENCE. The freestanding (nostd) build the parity battery links has
/// no tasks: `TASKS` is std-only (`threads.rs:92`), `spawn`/`join` do not
/// exist, and the observable surface is
///
///   finished        false for every handle
///   panic_message   null for every handle
///   count           0 (no task was ever spawned)
///   current         this thread's id in the collector's registry
///   sleep_ms        Sleep(clamp(ms, 0, 60000))     (`nostd.rs::sleep_ms`)
///   yield           no-op                          (`threads.rs:386`)
///
/// The six of those a freestanding program can call are mirrored below 1:1.
/// spawn/join are ported too so the family stays whole on the std build where
/// the native reference has them; they follow the single-thread contract below.
///
/// THE SINGLE-THREAD DIVERGENCE. The port runs the same "no peer" world as
/// the freestanding slice, so a spawn cannot start an OS thread: it runs its
/// body inline and returns a handle that is already finished. `spawn`'s handle
/// numbering follows the native std convention (`threads.rs:134`): the
/// post-push index, so the first spawn is 0. All the tasks-only answers are
/// derived from one counter, `thrSpawned`, so an importing program sees a
/// coherent story instead of a cross-registry fatal:
///
///   spawn   run body inline, return its 0-based handle (0 = first spawn)
///   join    true for every handle (nothing is ever running)
///   finished true for a handle that names a spawn that ran (all of them),
///            false otherwise - the string with the nostd answer
///   count   the number of spawns (0 when nothing spawned: the nostd answer)
///   current 0, the one divergence: the collector registry id is assigned
///            inside native `shadow::current_thread`, invisible to a `pkl`
///            body. 0 is the truthful "never registered" answer the native
///            registry yields before registration.
///   panic_message null, as the nostd build reports (a task body cannot record
///            a failure here)
///
/// No fatal path exists in this family: the native bodies never report a
/// wrong-kind or unknown handle, so neither do the ported ones.

/// How many bodies this port has run inline. Handles are the pre-increment
/// counter value (0-based, like `threads.rs:134`).
var thrSpawned: int = 0

/// Run `body` on a new OS thread and return its task handle; here the body
/// runs inline - there is no peer thread in this image (`threads.rs:387`
/// documents the same world for the freestanding yield) - and finishes before
/// returning.
#[symbol("pickle_thread_spawn")]
fn abiThreadSpawn(body: fn () -> void) -> int {
    body()
    var h = thrSpawned
    thrSpawned = thrSpawned + 1
    return h
}

/// Wait for task `handle` to finish. Returns 1 when the body ran without
/// recording a failure, 0 when it panicked. An unknown handle reports success
/// (`threads.rs:266`). In this image a spawned body has already run and cannot
/// have recorded a failure, so every answer is success.
#[symbol("pickle_thread_join")]
fn abiThreadJoin(handle: int) -> bool {
    return true
}

/// Whether task `handle` has finished. Never blocks. The std build answers
/// false for an unknown handle too (`threads.rs:280`), so the one honest
/// distinction in the port is "does this handle name a spawn": yes = true (it
/// ran inline), no = false. Matches the nostd answer for every freestanding
/// program, which never spawns.
#[symbol("pickle_thread_finished")]
fn abiThreadFinished(handle: int) -> bool {
    if (handle < 0) {
        return false
    }
    if (handle >= thrSpawned) {
        return false
    }
    return true
}

/// The failure message task `handle` recorded, as a `string` object, or null
/// when the task is still running or finished cleanly. `threads.rs:318` (the
/// nostd build, and the std build for a running/clean task) always answers
/// null: a body that runs inside the single thread cannot record a failure.
#[symbol("pickle_thread_panic_message")]
fn abiThreadPanicMessage(handle: int) -> *int {
    return 0 as *int
}

/// How many tasks have been spawned in this process. The nostd build always
/// answers 0 (`threads.rs:344`); the port answers how many bodies it ran
/// inline, which is 0 until a program that imports this module spawns.
#[symbol("pickle_thread_count")]
fn abiThreadCount() -> int {
    return thrSpawned
}

/// This thread's id in the collector's registry. Divergence: the registry id
/// is assigned inside native `shadow::current_thread` and is not readable from
/// a `pkl` body, so the port answers 0 - the value the native registry yields
/// for a thread that was never registered.
#[symbol("pickle_thread_current")]
fn abiThreadCurrent() -> int {
    return 0
}

/// Pause this task for `ms` milliseconds. The clamp is the same as the native
/// builds (`threads.rs:354` and `:364`): negative or absurd values become a
/// bounded wait, never an unbounded one. Sleep is a KERNEL32 import reached
/// through `win_sleep` (`VOID Sleep(DWORD)`).
#[symbol("pickle_thread_sleep_ms")]
fn abiThreadSleepMs(ms: int) -> int {
    var m = ms
    if (m < 0) {
        m = 0
    }
    if (m > 60000) {
        m = 60000
    }
    win_sleep(m)
    return 0
}

/// Hand the world lock to a runnable peer, then take it back. No peer exists
/// here, so this is a no-op, exactly as the freestanding build defines it
/// (`threads.rs:386`).
#[symbol("pickle_thread_yield")]
fn abiThreadYield() -> int {
    return 0
}