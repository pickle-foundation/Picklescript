module runtime.os_test

import { EXIT_CODE_MIN, EXIT_CODE_MAX, exitCodeOf, snapshotStrings } from runtime.os

fn freshStrs(items: List<string>) -> List<string> {
    var out = ["x"]
    out.pop()
    var i = 0
    while (i < len(items)) {
        out.push(items[i])
        i = i + 1
    }
    out
}

test fn exit_code_clamps_to_i32() {
    expect(exitCodeOf(0)).toBe(0)
    expect(exitCodeOf(42)).toBe(42)
    expect(exitCodeOf(-1)).toBe(-1)
    expect(exitCodeOf(EXIT_CODE_MIN)).toBe(EXIT_CODE_MIN)
    expect(exitCodeOf(EXIT_CODE_MAX)).toBe(EXIT_CODE_MAX)
    expect(exitCodeOf(2147483648)).toBe(EXIT_CODE_MAX)
    expect(exitCodeOf(-2147483649)).toBe(EXIT_CODE_MIN)
    expect(exitCodeOf(99999999999)).toBe(EXIT_CODE_MAX)
    expect(exitCodeOf(-99999999999)).toBe(EXIT_CODE_MIN)
}

fn emptyStrs() -> List<string> {
    var out = ["x"]
    out.pop()
    out
}

test fn snapshot_is_an_independent_fresh_copy() {
    var store = freshStrs(["a", "b"])
    var snap = snapshotStrings(store)
    expect(len(snap)).toBe(2)
    expect(snap[0]).toBe("a")
    snap.push("c")
    snap.pop()
    snap.pop()
    expect(len(store)).toBe(2)
    expect(store[0]).toBe("a")
}

test fn snapshot_of_empty_is_empty() {
    expect(len(snapshotStrings(emptyStrs()))).toBe(0)
}

test fn repeated_snapshots_are_independent() {
    var store = freshStrs(["a", "b"])
    var s1 = snapshotStrings(store)
    var s2 = snapshotStrings(store)
    s1.push("x")
    expect(len(s2)).toBe(2)
    expect(len(store)).toBe(2)
}