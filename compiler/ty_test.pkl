module compiler.ty_test

import { Ty, isPrimitive, isNumeric, elem, optOf, isOption, innerOption, tyEq, tyListEq, emptyTys } from compiler.ty

test fn primitives_and_numerics() {
    expect(isPrimitive(Ty.Int)).toBe(true)
    expect(isPrimitive(Ty.Bool)).toBe(true)
    expect(isPrimitive(Ty.List(Ty.Int))).toBe(false)
    expect(isNumeric(Ty.Int)).toBe(true)
    expect(isNumeric(Ty.Byte)).toBe(true)
    expect(isNumeric(Ty.Float)).toBe(true)
    expect(isNumeric(Ty.String)).toBe(false)
}

test fn elem_on_wrapped() {
    let l = elem(Ty.List(Ty.Int))
    expect(l).toExist()
    match (l) {
        case some(e) -> expect(tyEq(e, Ty.Int)).toBe(true)
        case none -> expect(false).toBe(true)
    }
    let m = elem(Ty.Map(Ty.String, Ty.Int))
    match (m) {
        case some(e) -> expect(tyEq(e, Ty.Int)).toBe(true)
        case none -> expect(false).toBe(true)
    }
    expect(elem(Ty.Bool)).not().toExist()
}

test fn options_roundtrip() {
    let o = optOf(Ty.Int)
    expect(isOption(o)).toBe(true)
    let inner = innerOption(o)
    match (inner) {
        case some(t) -> expect(tyEq(t, Ty.Int)).toBe(true)
        case none -> expect(false).toBe(true)
    }
    expect(isOption(Ty.Int)).toBe(false)
}

test fn ty_eq_structure() {
    expect(tyEq(Ty.Int, Ty.Int)).toBe(true)
    expect(tyEq(Ty.Int, Ty.Float)).toBe(false)
    expect(tyEq(Ty.List(Ty.Int), Ty.List(Ty.Int))).toBe(true)
    expect(tyEq(Ty.List(Ty.Int), Ty.List(Ty.Float))).toBe(false)
    expect(tyEq(Ty.Option(Ty.String), Ty.Option(Ty.String))).toBe(true)
}

test fn empty_tys_helper() {
    var l = emptyTys()
    expect(len(l)).toBe(0)
    l.push(Ty.Int)
    expect(len(l)).toBe(1)
}