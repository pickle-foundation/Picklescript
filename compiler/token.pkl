fn isTriviaKind(k: Tok) -> bool {
    match (k) {
        case Tok.Newline -> true
        case Tok.Eof -> true
        case _ -> false
    }
}

fn docSuffix(t: LexedToken) -> string {
    match (t.data.doc) {
        case some(d) -> " doc=" + canonEsc(d)
        case none -> ""
    }
}

fn canonEsc(s: string) -> string {
    var out = "\""
    let bs = bytes(s)
    var i = 0
    while (i < len(bs)) {
        let cp = decodeCp(bs, i)
        i = i + cpLen(bs[i] as int)
        if (cp == ('\\' as int)) {
            out += "\\\\"
        } else if (cp == ('"' as int)) {
            out += "\\\""
        } else if (cp == ('\n' as int)) {
            out += "\\n"
        } else if (cp == ('\r' as int)) {
            out += "\\r"
        } else if (cp == ('\t' as int)) {
            out += "\\t"
        } else if (cp == ('\0' as int)) {
            out += "\\0"
        } else {
            out += "{cp as char}"
        }
    }
    out + "\""
}

fn canonEscChar(c: char) -> string {
    var out = "'"
    let cp = c as int
    if (cp == ('\\' as int)) {
        out += "\\\\"
    } else if (cp == ('\'' as int)) {
        out += "\\'"
    } else if (cp == ('\n' as int)) {
        out += "\\n"
    } else if (cp == ('\r' as int)) {
        out += "\\r"
    } else if (cp == ('\t' as int)) {
        out += "\\t"
    } else if (cp == ('\0' as int)) {
        out += "\\0"
    } else {
        out += "{c}"
    }
    out + "'"
}

fn canonNumber(t: LexedToken) -> string {
    var o = " text=" + canonEsc(t.data.text) + " suf="
    match (t.data.suf) {
        case some(s) -> o += canonEsc(s)
        case none -> o += "-"
    }
    o += " isf="
    if (t.data.isf) {
        o += "1"
    } else {
        o += "0"
    }
    o += " int="
    match (t.data.ival) {
        case some(v) -> o += str(v)
        case none -> o += "-"
    }
    o
}

fn canonChar(c: char, t: LexedToken) -> string {
    var o = " ch=" + canonEscChar(c) + " int="
    match (t.data.ival) {
        case some(v) -> o += str(v)
        case none -> o += "-"
    }
    o
}

fn exprListStr(toks: List<LexedToken>) -> string {
    var o = "E["
    var i = 0
    for (t in toks) {
        if (i > 0) {
            o += "; "
        }
        o += canonTok(t)
        i = i + 1
    }
    o + "]"
}

fn canonSeg(seg: StrSeg) -> string {
    match (seg) {
        case StrSeg.Text(t) -> "T(" + canonEsc(t) + ")"
        case StrSeg.Expr(toks) -> exprListStr(toks)
    }
}

fn canonStrSegs(lit: StrLit) -> string {
    var o = ""
    for (seg in lit.segments) {
        o += " " + canonSeg(seg)
    }
    o
}

fn canonTok(t: LexedToken) -> string {
    match (t.token.kind) {
        case Tok.Ident(n) -> "Ident " + str(t.token.span.start) + ":" + str(t.token.span.end) + " text=" + canonEsc(n) + docSuffix(t)
        case Tok.Number -> "Number " + str(t.token.span.start) + ":" + str(t.token.span.end) + canonNumber(t) + docSuffix(t)
        case Tok.Char(c) -> "Char " + str(t.token.span.start) + ":" + str(t.token.span.end) + canonChar(c, t) + docSuffix(t)
        case Tok.Str(lit) -> "Str " + str(t.token.span.start) + ":" + str(t.token.span.end) + canonStrSegs(lit) + docSuffix(t)
        case _ -> kindName(t.token.kind) + " " + str(t.token.span.start) + ":" + str(t.token.span.end) + docSuffix(t)
    }
}
fn isDigitCp(cp: int) -> bool => cp >= ('0' as int) && cp <= ('9' as int)

fn isAlphaCp(cp: int) -> bool => (cp >= ('a' as int) && cp <= ('z' as int)) || (cp >= ('A' as int) && cp <= ('Z' as int))

fn isAlnumCp(cp: int) -> bool => isDigitCp(cp) || isAlphaCp(cp)

fn isHexCp(cp: int) -> bool => isDigitCp(cp) || (cp >= ('a' as int) && cp <= ('f' as int)) || (cp >= ('A' as int) && cp <= ('F' as int))

fn hexValCp(cp: int) -> int {
    if (cp >= ('0' as int) && cp <= ('9' as int)) {
        return cp - ('0' as int)
    }
    if (cp >= ('a' as int) && cp <= ('f' as int)) {
        return cp - ('a' as int) + 10
    }
    if (cp >= ('A' as int) && cp <= ('F' as int)) {
        return cp - ('A' as int) + 10
    }
    return -1
}

fn cpLen(b0: int) -> int {
    if (b0 < 0x80) {
        return 1
    }
    if (b0 <= 0xDF) {
        return 2
    }
    if (b0 <= 0xEF) {
        return 3
    }
    4
}

fn decodeCp(bs: List<byte>, i: int) -> int {
    let b0 = bs[i] as int
    let l = cpLen(b0)
    if (l == 1) {
        return b0
    }
    if (l == 2) {
        return ((b0 & 0x1F) << 6) | ((bs[i + 1] as int) & 0x3F)
    }
    if (l == 3) {
        return ((b0 & 0x0F) << 12) | (((bs[i + 1] as int) & 0x3F) << 6) | ((bs[i + 2] as int) & 0x3F)
    }
    ((b0 & 0x07) << 18) | (((bs[i + 1] as int) & 0x3F) << 12) | (((bs[i + 2] as int) & 0x3F) << 6) | ((bs[i + 3] as int) & 0x3F)
}

fn parseHexStr(h: string) -> int? {
    if (len(h) == 0) {
        return none
    }
    var v = 0
    for (b in bytes(h)) {
        let hv = hexValCp(b as int)
        if (0 > hv || v > (0x10FFFF - hv) / 16) {
            return none
        }
        v = v * 16 + hv
    }
    if (v >= 0xD800 && v <= 0xDFFF) {
        return none
    }
    v
}

fn parseIntLiteral(text: string) -> int? {
    var clean = ""
    for (b in bytes(text)) {
        if (b == ('_' as int)) {
            continue
        }
        clean += "{b as char}"
    }
    let cb = bytes(clean)
    var i = 0
    var neg = false
    if (len(cb) > i && cb[0] == ('-' as int)) {
        neg = true
        i = 1
    }
    var radix = 10
    var body = i
    if (len(cb) > i + 1 && cb[i] == ('0' as int)) {
        let p = cb[i + 1] as int
        if (p == ('x' as int) || p == ('X' as int)) {
            radix = 16
            body = i + 2
        } else if (p == ('b' as int) || p == ('B' as int)) {
            radix = 2
            body = i + 2
        } else if (p == ('o' as int) || p == ('O' as int)) {
            radix = 8
            body = i + 2
        }
    }
    if (body >= len(cb)) {
        return none
    }
    var v = 0
    var k = body
    while (k < len(cb)) {
        let hv = hexValCp(cb[k] as int)
        if (0 > hv || hv >= radix) {
            return none
        }
        if (v > (9223372036854775807 - hv) / radix) {
            return none
        }
        v = v * radix + hv
        k = k + 1
    }
    if (neg) {
        v * -1
    } else {
        v
    }
}

/// True when `text` is a well-formed integer literal whose value does not fit
  /// i64. `parseIntLiteral` returns `none` both for overflow and for malformed
  /// digits, so its callers cannot tell the two apart; only the first is an
  /// error, because the Rust front end also yields 0 for `0xZZ`. Mirrors
  /// `parseIntLiteral`'s sign/radix walk, so the two agree on every literal.
  fn intLiteralOverflows(text: string) -> bool {
      var clean = ""
      for (b in bytes(text)) {
          if (b == ('_' as int)) {
              continue
          }
          clean += "{b as char}"
      }
      let cb = bytes(clean)
      var i = 0
      if (len(cb) > i && cb[0] == ('-' as int)) {
          i = 1
      }
      var radix = 10
      var body = i
      if (len(cb) > i + 1 && cb[i] == ('0' as int)) {
          let p = cb[i + 1] as int
          if (p == ('x' as int) || p == ('X' as int)) {
              radix = 16
              body = i + 2
          } else if (p == ('b' as int) || p == ('B' as int)) {
              radix = 2
              body = i + 2
          } else if (p == ('o' as int) || p == ('O' as int)) {
              radix = 8
              body = i + 2
          }
      }
      if (body >= len(cb)) {
          return false
      }
      var v = 0
      var k = body
      while (k < len(cb)) {
          let hv = hexValCp(cb[k] as int)
          if (0 > hv || hv >= radix) {
              return false
          }
          if (v > (9223372036854775807 - hv) / radix) {
              return true
          }
          v = v * radix + hv
          k = k + 1
      }
      false
  }

  fn containsDotE(s: string) -> bool {
    for (b in bytes(s)) {
        let v = b as int
        if (v == ('.' as int) || v == ('e' as int) || v == ('E' as int)) {
            return true
        }
    }
    false
}

fn stripLeadSpace(s: string) -> string {
    let bs = bytes(s)
    if (len(bs) > 0 && bs[0] == (' ' as int)) {
        return dropFirstStr(s)
    }
    s
}

fn trimEndStr(s: string) -> string {
    let bs = bytes(s)
    var last = len(bs)
    while (last > 0) {
        let b = bs[last - 1] as int
        if (b == (' ' as int) || b == ('\t' as int) || b == ('\n' as int) || b == ('\r' as int) || b == 0x0B || b == 0x0C) {
            last = last - 1
        } else {
            break
        }
    }
    if (last == len(bs)) {
        return s
    }
    var out = ""
    var i = 0
    while (i < last) {
        out += "{bs[i] as char}"
        i = i + 1
    }
    out
}

fn dropFirstStr(s: string) -> string {
    let bs = bytes(s)
    if (len(bs) == 0) {
        return s
    }
    var skip = cpLen(bs[0] as int)
    var out = ""
    while (skip < len(bs)) {
        out += "{bs[skip] as char}"
        skip = skip + 1
    }
    out
}