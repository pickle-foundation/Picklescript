module compiler.token

import { Span } from compiler.diag

class StrLit {
    var segments: List<StrSeg>
}

enum StrSeg {
    Text(t: string)
    Expr(toks: List<LexedToken>)
}

class TokenData {
    var text: string
    var ival: int?
    var isf: bool
    var suf: string?
    var doc: string?

    constructor(text: string, ival: int?, isf: bool, suf: string?, doc: string?) {
        this.text = text
        this.ival = ival
        this.isf = isf
        this.suf = suf
        this.doc = doc
    }
}

class Token {
    var kind: Tok
    var span: Span

    constructor(kind: Tok, span: Span) {
        this.kind = kind
        this.span = span
    }
}

class LexedToken {
    var token: Token
    var data: TokenData

    constructor(token: Token, data: TokenData) {
        this.token = token
        this.data = data
    }
}

fn plainTok(kind: Tok, span: Span) -> LexedToken {
    LexedToken(Token(kind, span), TokenData("", none, false, none, none))
}

fn emptyToks() -> List<LexedToken> {
    var l = [plainTok(Tok.Eof, Span(0, 0))]
    l.pop()
    l
}

fn emptySegs() -> List<StrSeg> {
    var l = [StrSeg.Text("")]
    l.pop()
    l
}

