fn keywordTok(w: string) -> Tok? {
    match (w) {
        case "module" -> Tok.Module
        case "import" -> Tok.Import
        case "class" -> Tok.Class
        case "struct" -> Tok.Struct
        case "enum" -> Tok.Enum
        case "interface" -> Tok.Interface
        case "fn" -> Tok.Fn
        case "constructor" -> Tok.Constructor
        case "property" -> Tok.Property
        case "get" -> Tok.Get
        case "set" -> Tok.Set
        case "static" -> Tok.Static
        case "override" -> Tok.Override
        case "let" -> Tok.Let
        case "var" -> Tok.Var
        case "const" -> Tok.Const
        case "public" -> Tok.Public
        case "private" -> Tok.Private
        case "protected" -> Tok.Protected
        case "if" -> Tok.If
        case "else" -> Tok.Else
        case "while" -> Tok.While
        case "for" -> Tok.For
        case "in" -> Tok.In
        case "break" -> Tok.Break
        case "continue" -> Tok.Continue
        case "return" -> Tok.Return
        case "match" -> Tok.Match
        case "case" -> Tok.Case
        case "true" -> Tok.True
        case "false" -> Tok.False
        case "none" -> Tok.None
        case "async" -> Tok.Async
        case "await" -> Tok.Await
        case "task" -> Tok.Task
        case "channel" -> Tok.Channel
        case "unsafe" -> Tok.Unsafe
        case "extends" -> Tok.Extends
        case "implements" -> Tok.Implements
        case "is" -> Tok.Is
        case "as" -> Tok.As
        case "from" -> Tok.From
        case "this" -> Tok.This
        case "super" -> Tok.Super
        case "init" -> Tok.Init
        case "deinit" -> Tok.Deinit
        case "operator" -> Tok.Operator
        case "try" -> Tok.Try
        case "catch" -> Tok.Catch
        case "finally" -> Tok.Finally
        case "throw" -> Tok.Throw
        case _ -> none
    }
}

