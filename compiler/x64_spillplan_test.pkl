module compiler.x64_spillplan_test

import { IrTy, IrConst, IrInstr, IrTerm, IrBlock, IrFunc, IrModule, IrExtern, Callee, emptyIrTys, emptyIrParams, emptyIrGlobals } from compiler.ir
import { FnPlan, analyze, computeMayGC } from compiler.x64
import { DiagnosticSink } from compiler.diag

fn emptyInstrs() -> List<IrInstr> {
    var l = [IrInstr.Const(0, IrConst.Int(0))]
    l.pop()
    l
}

fn emptyInts() -> List<int> {
    var l = [0]
    l.pop()
    l
}

fn emptyBlocks() -> List<IrBlock> {
    var l = [IrBlock(0, emptyInstrs(), IrTerm.Unreachable)]
    l.pop()
    l
}

fn emptyTags() -> List<string> {
    var l = [""]
    l.pop()
    l
}

fn mkExtern(ret: IrTy) -> IrExtern {
    IrExtern("pickle_support_tick", emptyIrTys(), ret)
}

fn mkFunc(slots: List<IrTy>, body: List<IrInstr>) -> IrFunc {
    let blocks = [IrBlock(0, body, IrTerm.Return(none))]
    IrFunc("f", "call_site", emptyIrParams(), IrTy.Unit, slots, 0, blocks, false, false, emptyTags())
}

fn planOf(slots: List<IrTy>, body: List<IrInstr>, ret: IrTy) -> FnPlan {
    var fs = [IrFunc("seed", "", emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyBlocks(), false, false, emptyTags())]
    fs.pop()
    fs.push(mkFunc(slots, body))
    var es = [mkExtern(ret)]
    var bn = {"s": 0}
    bn.remove("s")
    var ss = [[0]]
    ss.pop()
    let m = IrModule(fs, es, bn, ss, emptyIrGlobals())
    analyze(m, m.funcs[0], computeMayGC(m))
}

fn homeOf(plan: FnPlan, s: int, which: int) -> int {
    var h = 0
    if (which == 0) {
        match (plan.slotHome(s)) {
            case some(k) -> h = k
            case none -> expect(false).toBe(true)
        }
    } else {
        match (plan.tempHome(s)) {
            case some(k) -> h = k
            case none -> expect(false).toBe(true)
        }
    }
    h
}

describe("spill plan metadata coverage", {
    test("every managed home gets a dense ordered cell", {
        let slots = [IrTy.Str, IrTy.Str, IrTy.Int]
        let body = [IrInstr.Call(3, Callee.Extern(0), emptyInts()), IrInstr.Call(4, Callee.Extern(0), emptyInts())]
        let p = planOf(slots, body, IrTy.Str)
        expect(p.ncells).toBe(4)
        expect(p.shadowed).toBe(true)
        expect(homeOf(p, 0, 0) - homeOf(p, 1, 0)).toBe(8)
        expect(homeOf(p, 1, 0) - homeOf(p, 3, 1)).toBe(8)
        expect(homeOf(p, 3, 1) - homeOf(p, 4, 1)).toBe(8)
    })

    test("unmanaged homes sit strictly above the shadow frame", {
        let slots = [IrTy.Str, IrTy.Int]
        let body = [IrInstr.Const(2, IrConst.Int(7)), IrInstr.Call(3, Callee.Extern(0), emptyInts())]
        let p = planOf(slots, body, IrTy.Str)
        expect(p.ncells).toBe(2)
        expect(p.shadowed).toBe(true)
        expect(homeOf(p, 1, 0) > p.shadowBytes).toBe(true)
        expect(homeOf(p, 2, 1) > p.shadowBytes).toBe(true)
        expect(p.totalK > p.shadowBytes).toBe(true)
    })

    test("unmanaged-only plan has an empty frame", {
        let slots = [IrTy.Int]
        let body = [IrInstr.Const(0, IrConst.Int(1))]
        let p = planOf(slots, body, IrTy.Unit)
        expect(p.ncells).toBe(0)
        expect(p.shadowed).toBe(false)
        expect(p.shadowBytes).toBe(16)
        expect(homeOf(p, 0, 0) > 16).toBe(true)
    })

    test("ptr homes are rooted like str homes", {
        let slots = [IrTy.Ptr]
        let body = [IrInstr.Call(none, Callee.Extern(0), emptyInts())]
        let p = planOf(slots, body, IrTy.Ptr)
        expect(p.ncells).toBe(1)
        expect(p.shadowed).toBe(true)
    })
})
