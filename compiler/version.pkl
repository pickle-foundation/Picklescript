module compiler.version

/// The single source of truth for the toolchain version.
///
/// Semantic Versioning 2.0.0: `MAJOR.MINOR.PATCH[-prerelease][+build]`.
/// This tree is the unreleased 0.2 line, so the version carries a `dev.N`
/// pre-release identifier. A release drops the suffix, and only a release is
/// tagged `v<version>`; development builds are not tagged.
const VERSION: string = "0.2.0-dev.1"
