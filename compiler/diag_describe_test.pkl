module compiler.diag_describe_test

import { Span, Diagnostic, Severity, DiagnosticSink } from compiler.diag

class DiagCounter {
    static var hooks: int = 0
}

beforeAll({
    DiagCounter.hooks = DiagCounter.hooks + 1
})

beforeEach({
    DiagCounter.hooks = DiagCounter.hooks + 1
})

afterEach({
    DiagCounter.hooks = DiagCounter.hooks + 1
})

afterAll({
    DiagCounter.hooks = DiagCounter.hooks + 1
})

describe("diagnostic severity", {
    test("warn is not an error", {
        let d = Diagnostic.warnAt(Span(0, 1), "w")
        expect(d.severity == Severity.Warning).toBe(true)
    })

    test("via it() alias", {
        let d = Diagnostic.error("e")
        expect(d.message).toBe("e")
    })

    describe("nested sink", {
        beforeEach({
            DiagCounter.hooks = DiagCounter.hooks + 1
        })

        test("sink counts errors only", {
            let s = DiagnosticSink()
            s.emit(Diagnostic.errorAt(Span(0, 1), "x"))
            s.emit(Diagnostic.warnAt(Span(0, 1), "y"))
            expect(s.errorCount()).toBe(1)
            expect(s.anyError()).toBe(true)
        })
    })
})