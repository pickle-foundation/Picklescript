// PickleScript compiler: the lowering core.
// Every former `class Emitter` method as a free fn over the emitter value.
// Family modules (emitmatch, emitspread, ...) are carved out of this file
// bottom-up in later batches; call style is already fn(em, ...) everywhere.
module compiler.emitcore

import * from compiler.ast
import { Span, Diagnostic, DiagnosticSink } from compiler.diag
import { IrBlock, IrFunc, IrGlobal, IrModule, IrParam, IrTy, emptyIrBlocks, emptyIrGlobals, emptyIrParams, emptyIrTys, emptyModule, irTyStr, irxParseFloat } from compiler.ir
import { CallableInfo, ClassTable, CtorInfo, EnumTable, FieldInfo, ParamInfo, PropertyInfo, ResolvedProgram, TypeTableEntry, entryGenerics } from compiler.resolve
import { collectExprTypes, containsStr, isNoneStr, spanKey } from compiler.check
import * from compiler.ty
import { f64ToBits } from compiler.x64
import * from compiler.emitutil

import { Emitter } from compiler.emittypes
import * from compiler.emitprim
import * from compiler.emitreadsglobal


    /// Record the initializer of a top-level `const`. Void so the arm of the
    /// registration match stays unit-typed.
fn recordConstInit(em: Emitter, name: string, value: Expr) {
   em.constsInits[name] = value
   }

   /// Allocate global ids in source order and push one `IrGlobal` per top-level
   /// `var`. Globals have no body, so this only has to validate the type and
   /// reduce the initializer; failures are recorded and reported once every
   /// body is built, so one bad global does not mask unrelated problems.
   ///
   /// `resolved.globals` is already in source order and carries the resolved
   /// type; `globalDecls` supplies the initializer expression, which the
   /// resolver deliberately does not keep (it is not part of the type surface).
fn registerGlobals(em: Emitter) {
   var next = 0
   for (info in em.resolved.globals) {
   let name = info.name
   if (em.globalIds.has(name)) {
   em.globalFailures.push(GlobalFailure(name, info.span, "top-level `var " + name + "` is declared more than once"))
   continue
   }
   var slot: IrTy? = none
   if (let some(t) = globalIrTy(info.ty)) {
   slot = t
   } else {
   em.globalFailures.push(GlobalFailure(name, info.span, "top-level `var " + name + "` has type `" + tyDbg(em, info.ty) + "`, which has no global lowering yet"))
   continue
   }
   var decl: GlobalDecl? = none
   if (em.globalDecls.has(name)) {
   decl = em.globalDecls[name]
   }
   if (let some(d) = decl) {
   if (let some(ity) = slot) {
   var res = globalInitBytes(d.value, ity, name)
if (res.err != "") {
    em.globalFailures.push(GlobalFailure(name, info.span, res.err))
    continue
}
let gid = next
     next += 1
     em.globalIds[name] = gid
     em.irModule.globals.push(IrGlobal(globalSymbol(name), ity, hasTypeExpr(d.ty), res.bytes))
if (ity == IrTy.Str || ity == IrTy.Ptr) {
    // A managed initializer is real run-time code, so it may call and allocate,
    // but it may not read another global. `pkl_globals_init` roots every slot
    // before it evaluates any initializer, so every slot is still null while
    // initializers run; reject the read here rather than hand back a null
    // dereference.
    //
    // The slot and its id are registered above, before this check, exactly as on
    // the native path. A rejected global is still a declared global, so a later
    // read of it must not turn into a second, misleading "not lowered yet"
    // diagnostic -- only the root cause should be reported.
    if (let some(other) = globalInitReadsGlobal(em, d.value)) {
        em.globalFailures.push(GlobalFailure(name, info.span,
            "the initializer of top-level `var " + name + "` reads `" + other + "`, but global initializers run after every slot is rooted and before any is filled, so it would read a null value"))
        continue
    }
        em.managedGlobalInits.push(ManagedGlobalInit(gid, ity, d.value))
     }
   }
   } else {
   em.globalFailures.push(GlobalFailure(name, info.span, "top-level `var " + name + "` has no initializer"))
   continue
   }
   }
   }
fn recordFnDecl(em: Emitter, name: string, f: FnDecl) {
        em.fnDecls[name] = f
    }

fn recordClassDecl(em: Emitter, name: string, c: ClassDecl) {
        em.classDecls[name] = c
    }

    /// Register functions, classes, structs, and enums in source order, and
    /// then build all their bodies. Mirrors `Emitter::emit()` in emit.rs.
fn emit(em: Emitter) {
             // A well-formed integer literal that does not fit i64. Parsing
             // degrades such a literal to 0, so this is the only thing standing
             // between an out-of-range literal and a silently wrong constant.
             // The Rust emitter rejects it in `lit`, where the literal's own span
             // is out of reach, hence the zero span; bail before emitting anything
             // so a rejected module never reaches the linker.
             if (em.prog.intLiteralOverflow) {
                 bad(em, Span(0, 0), "integer literal out of range for i64")
                 return
             }
             for (item in em.prog.items) {
               match (item.kind) {
                   case ItemKind.Global(g) -> em.globalDecls[g.name] = g
                   case _ -> {}
               }
           }
           registerGlobals(em)
           for (item in em.prog.items) {
               match (item.kind) {
                   case ItemKind.Const(c) -> recordConstInit(em, c.name, c.value)
                   case ItemKind.Fn(f) -> recordFnDecl(em, f.name, f)
                   case ItemKind.Test(f) -> recordFnDecl(em, f.name, f)
                   case ItemKind.Class(c) -> recordClassDecl(em, c.name, c)
                   case _ -> {}
               }
           }
        for (item in em.prog.items) {
            var itName = "?"
            match (item.kind) {
                case ItemKind.Fn(f) -> {
                    itName = f.name
                    registerFn(em, f, false, item.attrs)
                }
                case ItemKind.Test(f) -> {
                    itName = f.name
                    registerFn(em, f, true, item.attrs)
                }
                case ItemKind.Class(c) -> {
                    itName = c.name
                    registerClassByName(em, c.name)
                }
                case ItemKind.Struct(s) -> registerStructItem(em, s)
                case _ -> {}
            }
            if (em.failed) {
                break
            }
        }
        // Every class is now registered. Discover which instance methods are
        // overridden so calls through ancestor-typed receivers can route them
        // on the runtime class id.
        buildVirtualDispatch(em)
        // Static fields are initialized once at program start. Register the
        // initializer only after every class id is assigned.
        if (!(len(em.staticInits) == 0)) {
            var inits = em.staticInits
em.staticInits = emptyStaticInitEntries()
            em.staticInitId = pushClassFunc(em, "static.init", "pkl_static_init", FnSource.StaticInit(inits))
        }
        // Managed top-level `var`s have no static bytes. Register every slot as a
        // GC root first, then store each initializer, because an initializer is
        // the first code that can allocate.
        if (!(len(em.managedGlobalInits) == 0)) {
            var ginits = em.managedGlobalInits
            em.managedGlobalInits = emptyManagedGlobalInits()
            em.globalsInitId = pushClassFunc(em, "globals.init", "pkl_globals_init", FnSource.GlobalsInit(ginits))
        }
        // Test modules have no `main`, so the class-registration preamble
        // cannot ride on one; synthesize `pkl_test_setup` when there is
        // anything to set up.
        var hasTests = false
        for (item in em.prog.items) {
            match (item.kind) {
                case ItemKind.Test(_) -> hasTests = true
                case _ -> {}
            }
        }
        if (hasTests && (!(len(em.classes) == 0) || isSomeInt(em.staticInitId) || isSomeInt(em.globalsInitId))) {
            em.testSetupId = pushClassFunc(em, "test.setup", "pkl_test_setup", FnSource.TestSetup)
        }
        // A split-linked module (a runtime member with no `main`) still needs
        // its registration/globals/static preamble callable from the linking
        // program. The symbol is created even when there is nothing to set up
        // so references to it always bind; the body early-returns empty.
        if (!(em.moduleSetupSymbol == "")) {
            pushClassFunc(em, "module.setup", em.moduleSetupSymbol, FnSource.TestSetup)
        }
        registerLambdas(em)
        // Instantiated generic functions are registered lazily while their
        // callers compile, so keep consuming newly-appended function ids.
        //
        // Pass 1: lower every body with the propagation checks suppressed, purely
        // to record which function calls which and which bodies contain a `throw`
        // of their own. Pass 2 re-runs the same loop for real. `buildFunc`
        // replaces each function entry wholesale and every cache that hands out a
        // `FuncId` is keyed, so re-running over the same ids overwrites pass 1
        // cleanly instead of appending to it.
        em.analyzing = true
        buildAll(em)
        em.analyzing = false
        if (em.failed) {
            // Nothing to re-lower: report what the analysis pass found.
            for (d in em.suppressed) {
                em.diags.emit(d)
            }
            em.suppressed = emptyDiagnostics()
            return
        }
        em.suppressed = emptyDiagnostics()
        em.progMayThrow = len(em.directThrow.keys()) > 0
        if (em.progMayThrow) {
            solveMayThrow(em)
        }
        buildAll(em)
    }

    /// Lower every registered function body, including any registered lazily by
    /// an earlier one.
fn buildAll(em: Emitter) {
        var ix = 0
        while (ix < len(em.fidList)) {
            var fid = em.fidList[ix]
            buildFunc(em, fid)
            ix = ix + 1
        }
    }

    // ---- registration ----

    /// Record one instance/static method definition, first-wins (mirrors the
    /// `or_insert` used for `method_ids` in Rust), and append the walked method
    /// table so `build_virtual_dispatch` can iterate every receiver entry.
fn methodDef(em: Emitter, cid: int, mname: string, fid: int, isStatic: bool) {
        var key = pairKey(str(cid), mname)
        if (!em.methodIds.has(key)) {
            em.methodIds[key] = MethodRef(fid, isStatic)
            em.methodSeq.push(MethodEntry(cid, mname, fid, isStatic))
        }
    }

    /// Register a top-level function (or test) that has an unambiguous user
    /// callable and fully low-level parameter/return types. Mirrors
    /// `register_fn` in emit.rs.
fn registerFn(em: Emitter, f: FnDecl, isTest: bool, attrs: List<Attribute>) -> bool {
        if (!(len(f.generics) == 0)) {
            return false
        }
        var hasDefaultOrRest = false
        for (p in f.params) {
            if (p.rest) {
                hasDefaultOrRest = true
            } else if (let none = p.default) {
                // no default value
            } else {
                hasDefaultOrRest = true
            }
        }
        if (hasDefaultOrRest) {
            return false
        }
        if (let some(info) = userCallable(em, f.name)) {
            var okParams = true
            for (p in info.params) {
                if (let none = mapTy(em, p.ty, f.span)) {
                    okParams = false
                }
            }
            var okRet = true
            if (let none = mapTy(em, info.ret, f.span)) {
                okRet = false
            }
            if (!okParams || !okRet) {
                return false
            }
            if (f.isAsync) {
                registerAsyncFn(em, f, isTest, attrs, info)
                return true
            }
            var fid = len(em.irModule.funcs)
            var symbol = symbolForAttrs(em, f.name, isTest, attrs)
            em.irModule.funcsByName[f.name] = fid
            em.irModule.funcs.push(IrFunc(f.name, symbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), !isTest && f.name == "main", isTest, itemTags(attrs)))
            em.fidList.push(fid)
            em.fsource[fid] = FnSource.TopLevel(f)
            em.finfo[fid] = info
            var stys = emptyTys()
            for (p in info.params) {
                stys.push(p.ty)
            }
            em.srcParamTys[fid] = stys
            return true
        }
        false
    }

    /// Register an `async fn` as two lowerable functions:
    ///
    ///   * the hidden future body Ã¢â‚¬â€ a 0-arg hoisted body with the lambda ABI
    ///     (`env` = closure object), whose closure slots 1..N snapshot each of
    ///     the async fn's parameters under its own name; and
    ///   * the visible wrapper Ã¢â‚¬â€ a normal module function with the async fn's
    ///     real ABI that allocates that closure and returns it. Calling it runs
    ///     no user code; the body runs only when `await` drives the future's
    ///     0-arg call.
    ///
    /// The hidden entry is registered first so the wrapper can name it.
    /// Mirrors `register_async_fn` in emit.rs.
fn registerAsyncFn(em: Emitter, f: FnDecl, isTest: bool, attrs: List<Attribute>, info: CallableInfo) {
        var symbol = symbolForAttrs(em, f.name, isTest, attrs)
        var hiddenName = f.name + "__future"
        var hiddenSymbol = symbol + "__future"
        var hidden = len(em.irModule.funcs)
        em.irModule.funcsByName[hiddenName] = hidden
        em.irModule.funcs.push(IrFunc(hiddenName, hiddenSymbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), false, false, emptyStrs()))
        em.fidList.push(hidden)
        var htys = emptyTys()
        for (p in info.params) {
            htys.push(p.ty)
        }
        em.fsource[hidden] = FnSource.AsyncBody(f, htys, info.ret)
        var hiddenInfo = CallableInfo(info.name, info.span, info.visibility, info.isAsync, info.isStatic, info.isOverride, info.isAbstract, info.operator, info.generics, emptyParamInfos(), info.ret)
        em.finfo[hidden] = hiddenInfo
        var wfid = len(em.irModule.funcs)
        em.irModule.funcsByName[f.name] = wfid
        em.irModule.funcs.push(IrFunc(f.name, symbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), !isTest && f.name == "main", isTest, itemTags(attrs)))
        em.fidList.push(wfid)
        em.fsource[wfid] = FnSource.AsyncFn(f, hidden)
        em.finfo[wfid] = info
        var stys = emptyTys()
        for (p in info.params) {
            stys.push(p.ty)
        }
        em.srcParamTys[wfid] = stys
    }

    /// Register an `async` method as two lowerable functions, mirroring
    /// `register_async_fn` for methods:
    ///
    ///   * the hidden future body, whose closure slots hold the receiver
    ///     (`this`, instance methods) followed by the parameters; and
    ///   * the visible wrapper Ã¢â‚¬â€ the method itself Ã¢â‚¬â€ with the method's real ABI
    ///     (receiver-first for instance methods), allocating that closure and
    ///     returning it. `methodIds` maps the method name to the wrapper, so
    ///     instance/static calls and (via inheritance + virtual dispatch)
    ///     overrides dispatch exactly like regular methods.
    ///
    /// `thisTy` is the instantiated receiver type (`None` for static), `suffix`
    /// disambiguates generic-class instantiation symbols, and `map` carries the
    /// substitution when the receiver class is a generic instantiation.
    /// Mirrors `register_async_method` in emit.rs.
fn registerAsyncMethod(em: Emitter, cname: string, table: ClassTable, md: MethodDecl, info: CallableInfo, cid: int, args: List<Ty>, isStruct: bool, suffix: string, map: Map<string, Ty>?) {
        var thisTy: Ty? = none
        if (!info.isStatic) {
            if (isStruct) {
                thisTy = Ty.Struct(cname, args)
            } else {
                thisTy = Ty.Class(cname, args)
            }
        }
        var pty = emptyTys()
        if (let some(t) = thisTy) {
            pty.push(t)
        }
        for (p in info.params) {
            pty.push(p.ty)
        }
        var stem = ""
        if (info.isStatic) {
            stem = "pkl_" + cname + "_sm_" + md.name
        } else {
            stem = "pkl_" + cname + "_" + md.name
        }
        var hidden = pushClassFunc(em, cname + "." + md.name + ".future", stem + suffix + "__future", FnSource.AsyncMethodBody(table, md, pty, info.ret, info.isStatic))
        var hiddenInfo = CallableInfo(info.name, info.span, info.visibility, info.isAsync, info.isStatic, info.isOverride, info.isAbstract, info.operator, info.generics, emptyParamInfos(), info.ret)
        em.finfo[hidden] = hiddenInfo
        em.fidOwner[hidden] = cid
        if (let some(s) = map) {
            em.instantonSubst[hidden] = s
            em.fidGenerics[hidden] = table.generics
        }
        var wfid = pushClassFunc(em, cname + "." + md.name, stem + suffix, FnSource.AsyncMethod(table, md, hidden, info.isStatic, thisTy))
        em.finfo[wfid] = info
        var stys = emptyTys()
        for (p in info.params) {
            stys.push(p.ty)
        }
        em.srcParamTys[wfid] = stys
        methodDef(em, cid, md.name, wfid, info.isStatic)
        em.fidOwner[wfid] = cid
        if (let some(s) = map) {
            em.instantonSubst[wfid] = s
            em.fidGenerics[wfid] = table.generics
        }
    }


    /// Register a class and, first, its ancestors, so a superclass always has a
    /// lower class id than its subclasses. Mirrors `register_class_by_name`.
fn registerClassByName(em: Emitter, name: string) -> bool {
        if (hasStr(em.classAttempted, name)) {
            return false
        }
        em.classAttempted.push(name)
        if (let some(decl) = em.classDecls.get(name)) {
            if (let some(table) = classEntry(em, name)) {
                if (let some(ext) = table.extends) {
                    if (let some(p) = named(ext)) {
                        if (em.classDecls.has(p)) {
                            registerClassByName(em, p)
                        }
                    }
                }
                maybeRegisterClass(em, name, decl.members, table, decl.span)
                return true
            }
        }
        false
    }

    /// The resolver's `ClassTable` for a class name (classes only, not
    /// structs ???????? the caller has already looked the decl up).
fn classEntry(em: Emitter, name: string) -> ClassTable? {
        if (let some(entry) = em.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    return t
                }
                case _ -> {}
            }
        }
        none
    }

    /// Register a struct (structs have no inheritance, so no ancestor walk).
    /// Mirrors `register_struct_item` in emit.rs.
fn registerStructItem(em: Emitter, s: StructDecl) -> bool {
        em.structMembers[s.name] = s.members
        if (let some(entry) = em.resolved.types.get(s.name)) {
            match (entry) {
                case TypeTableEntry.Struct(t) -> maybeRegisterClass(em, s.name, s.members, t, s.span)
                case _ -> {}
            }
        }
        true
    }

    /// Build the class/struct table for `name` from the resolver, or from the
    /// emitter's own tables for synthetic/generic plans. Mirrors `table_of`.
fn tableOf(em: Emitter, name: string) -> ClassTable? {
        if (let some(entry) = em.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    return t
                }
                case TypeTableEntry.Struct(t) -> {
                    return t
                }
                case _ -> {}
            }
        }
        for (p in em.classes) {
            if (p.name == name) {
                return p.table
            }
        }
        if (em.closureTables.has(name)) {
            return em.closureTables.get(name)
        }
        none
    }

    /// The superclass name of `name`, when it extends another class.
fn parentName(em: Emitter, name: string) -> string? {
        if (let some(t) = tableOf(em, name)) {
            if (let some(ext) = t.extends) {
                return named(ext)
            }
        }
        none
    }

    /// Ancestry from the rootmost superclass down to `name` inclusive.
fn ancestry(em: Emitter, name: string) -> List<string> {
        var chain = [name]
        var cur = name
        var guard = 0
        while (guard < 64) {
            guard = guard + 1
            if (let some(p) = parentName(em, cur)) {
                chain.push(p)
                cur = p
            } else {
                break
            }
        }
        var reversed = emptyStrs()
        var i = len(chain) - 1
        while (i >= 0) {
            reversed.push(chain[i])
            i = i - 1
        }
        reversed
    }

    /// True when `anc` is `desc` itself or one of its ancestors.
fn isAncestor(em: Emitter, anc: string, desc: string) -> bool {
        var chain = ancestry(em, desc)
        var i = 0
        while (i < len(chain)) {
            if (chain[i] == anc) {
                return true
            }
            i = i + 1
        }
        false
    }




    /// Discover every instance method overridden somewhere in the program and
    /// record, per static receiver class, the descendant classes that provide a
    /// different implementation (deepest-derived first). Mirrors
    /// `build_virtual_dispatch` in emit.rs.
fn buildVirtualDispatch(em: Emitter) {
        var visible: Map<int, List<NamedFid>> = emptyNamedFidMap()
        for (me in em.methodSeq) {
            if (!me.isStatic) {
                if (let some(l) = visible.get(me.cid)) {
                    l.push(NamedFid(me.name, me.fid))
                } else {
                    var nf = [NamedFid(me.name, me.fid)]
                    visible[me.cid] = nf
                }
            }
        }
        var mixedCname = ""
        var mixedMname = ""
        for (p in em.classes) {
            if (let none = visible.get(p.classId)) {
                continue
            }
            if (let some(names) = visible.get(p.classId)) {
                for (nm in names) {
                    var branches = emptyDispatchDepths()
                    for (d in em.classes) {
                        if (d.classId == p.classId) {
                            continue
                        }
                        if (!isAncestor(em, p.name, d.name)) {
                            continue
                        }
                        if (let some(dt) = tableOf(em, d.name)) {
                            if (hasMethodName(dt, nm.name)) {
                                if (let some(mr) = em.methodIds.get(pairKey(str(d.classId), nm.name))) {
                                    if (mr.isStatic) {
                                        if (mixedCname == "") {
                                            mixedCname = d.name
                                            mixedMname = nm.name
                                        }
                                    } else if (!(mr.fid == nm.fid)) {
                                        var depth = chainDepth(ancestry(em, d.name), p.name)
                                        branches.push(DispatchBranchDepth(d.classId, depth, mr.fid))
                                    }
                                }
                            }
                        }
                    }
                    if (len(branches) == 0) {
                        continue
                    }
                    sortBranches(branches)
                    var db = emptyDispatchBranches()
                    for (b in branches) {
                        db.push(DispatchBranch(b.dcid, b.dfid))
                    }
                    em.virtualDispatch[pairKey(str(p.classId), nm.name)] = db
                }
            }
        }
        if (!(mixedCname == "")) {
            if (let some(sp) = em.classDecls.get(mixedCname)) {
                bad(em, sp.span, "`override` mixing static and instance methods (`" + mixedCname + "." + mixedMname + "`) is not lowered yet")
            } else {
                bad(em, Span(0, 0), "`override` mixing static and instance methods (`" + mixedCname + "." + mixedMname + "`) is not lowered yet")
            }
        }
    }

    /// Record one property-accessor definition (instanced), first-wins, and
    /// append it to the walked table so superclass slots can be inherited.
fn propDef(em: Emitter, cid: int, name: string, isSet: bool, fid: int) {
        var key = tripleKey(str(cid), name, str(isSet))
        if (!em.propertyIds.has(key)) {
            em.propertyIds[key] = fid
            em.propertySeq.push(PropertyEntry(cid, name, isSet, fid))
        }
    }

    /// Record one static property-accessor definition, first-wins, and append
    /// it to the walked table.
fn staticPropDef(em: Emitter, cid: int, name: string, isSet: bool, fid: int) {
        var key = tripleKey(str(cid), name, str(isSet))
        if (!em.staticPropertyIds.has(key)) {
            em.staticPropertyIds[key] = fid
            em.staticPropSeq.push(PropertyEntry(cid, name, isSet, fid))
        }
    }

    /// A class/struct's own (non-inherited) instance fields.
fn ownInstanceFields(em: Emitter, name: string) -> List<FieldInfo> {
        if (let some(t) = tableOf(em, name)) {
            var out = emptyFieldInfos()
            for (f in t.fields) {
                if (!f.isStatic) {
                    out.push(f)
                }
            }
            out
        } else {
            emptyFieldInfos()
        }
    }


    /// Instance-field initializers for `name` and its ancestors, root first,
    /// recorded at absolute slot numbers.
fn collectInstanceInits(em: Emitter, name: string) -> List<SlotInit> {
        var out = emptySlotInits()
        var base = 0
        for (cname in ancestry(em, name)) {
            var own = ownInstanceFields(em, cname)
            var decl = planName(cname)
            var members: List<ClassMember>? = none
            if (let some(d) = em.classDecls.get(decl)) {
                members = d.members
            } else if (em.structMembers.has(decl)) {
                members = em.structMembers.get(decl)
            }
            if (let some(ms) = members) {
                for (m in ms) {
                    match (m) {
                        case ClassMember.Field(fname, ty, init, vis, isSt, isCn, attrs, fspan) -> {
                            if (!isSt) {
                                if (let some(x) = init) {
                                    var i = 0
                                    var found = false
                                    while (i < len(own)) {
                                        if (own[i].name == fname) {
                                            found = true
                                            break
                                        }
                                        i = i + 1
                                    }
                                    if (found) {
                                        out.push(SlotInit(base + i, x))
                                    }
                                }
                            }
                        }
                        case _ -> {}
                    }
                }
            }
            base = base + len(own)
        }
        out
    }

    /// `init` blocks for `name` and its ancestors, root first.
fn collectInitBlocks(em: Emitter, name: string) -> List<Block> {
        var out = emptyBlocks()
        for (cname in ancestry(em, name)) {
            var decl = planName(cname)
            var members: List<ClassMember>? = none
            if (let some(d) = em.classDecls.get(decl)) {
                members = d.members
            } else if (em.structMembers.has(decl)) {
                members = em.structMembers.get(decl)
            }
            if (let some(ms) = members) {
                for (m in ms) {
                    match (m) {
                        case ClassMember.Init(b) -> out.push(b)
                        case _ -> {}
                    }
                }
            }
        }
        out
    }

    /// Resolve an interface instantiation `name<args>` to its runtime id,
    /// assigning a fresh one on first use and recording its member plan.
fn ifaceIdFor(em: Emitter, name: string, args: List<Ty>, span: Span) -> int? {
        var key = instKey(name, args)
        if (let some(id) = em.ifaceInstIds.get(key)) {
            return id
        }
        var iface: InterfaceTable? = none
        if (let some(entry) = em.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Interface(t) -> iface = t
                case _ -> {}
            }
        }
        if (let some(t) = iface) {
            var id = em.nextIfaceId
            em.nextIfaceId = em.nextIfaceId + 1
            if (!em.ifaceMembers.has(id)) {
                var plan = emptyIfaceMemberList()
                var mi = 0
                for (m in t.members) {
                    if (!m.isProperty) {
                        plan.push(IfaceMember(m.name, mi))
                        mi = mi + 1
                    }
                }
                em.ifaceMembers[id] = plan
            }
            em.ifaceInstIds[key] = id
            return id
        }
        bad(em, span, "`" + name + "` is not an interface")
        none
    }

    /// Record a class's own `implements` declarations into its runtime bucket.
fn registerImplements(em: Emitter, cname: string, cid: int, ifaces: List<Ty>, span: Span) -> bool {
        for (t in ifaces) {
            if (let some(ir) = ifaceOf(t)) {
                if (let some(id) = ifaceIdFor(em, ir.name, ir.args, span)) {
                    var slots = emptyDispatchBranches()
                    var members = em.ifaceMembers.get(id)
                    if (let some(ms) = members) {
                        for (m in ms) {
                            if (let some(mr) = em.methodIds.get(pairKey(str(cid), m.name))) {
                                if (mr.isStatic) {
                                    bad(em, span, "interface method `" + m.name + "` must be an instance method on `" + cname + "`")
                                    return false
                                }
                                slots.push(DispatchBranch(m.index, mr.fid))
                            } else {
                                bad(em, span, "`" + cname + "` implements `" + ir.name + "` but has no method `" + m.name + "`")
                                return false
                            }
                        }
                    }
                    if (let some(b) = em.classIfaceBuckets.get(cid)) {
                        b.push(IfaceBucket(id, slots))
                    } else {
                        em.classIfaceBuckets[cid] = [IfaceBucket(id, slots)]
                    }
                } else {
                    return false
                }
            } else {
                bad(em, span, "`" + cname + "` declares `implements` on a non-interface type `" + bareName(t) + "`")
                return false
            }
        }
        true
    }

    /// Lower a class/struct into a `ClassPlan`, recursively building its
    /// constructors, methods, and property accessors. Mirrors
    /// `maybe_register_class` in emit.rs.
fn maybeRegisterClass(em: Emitter, name: string, members: List<ClassMember>, table: ClassTable, span: Span) -> bool {
        if (!(len(table.generics) == 0)) {
            em.genericTypeMembers[name] = members
            return true
        }
        var parent: string? = none
        if (let some(ext) = table.extends) {
            if (let some(nm) = named(ext)) {
                parent = nm
            }
        }
        var parentCid: int? = none
        if (let some(p) = parent) {
            if (let some(pcid) = em.classByName.get(p)) {
                parentCid = pcid
            } else {
                return true
            }
        }
        var parentMsg = ""
        if (let some(p) = parent) {
            parentMsg = p
        }
        var ctorDecl: ConstructorDecl? = none
        for (m in members) {
            match (m) {
                case ClassMember.Constructor(c) -> {
                    if (let none = c.name) {
                        ctorDecl = c
                    }
                }
                case _ -> {}
            }
        }
        var parentExplicit = false
        if (let some(p) = parent) {
            if (let some(pt) = tableOf(em, p)) {
                if (let some(_) = pt.ctor) {
                    parentExplicit = true
                }
            }
        }
        if (let some(cd) = ctorDecl) {
            if (parentExplicit) {
                if (let none = ctorSuperDelegation(cd.body)) {
                    bad(em, cd.span, "`" + name + "` constructor must call `super(...)` first to chain into `" + parentMsg + "`")
                    return false
                }
            }
        }
        var inits = collectInstanceInits(em, name)
        var initBlocks = collectInitBlocks(em, name)
        var deinitBlock: Block? = none
        for (m in members) {
            match (m) {
                case ClassMember.Deinit(b) -> deinitBlock = b
                case _ -> {}
            }
        }
        var statics = emptyStaticSlotInits()
        for (f in table.fields) {
            if (f.isStatic) {
                if (let some(slot) = staticFieldSlot(table, f.name)) {
                    var init: Expr? = none
                    for (m in members) {
                        match (m) {
                            case ClassMember.Field(fname, ty, finit, vis, isSt, isCn, attrs, fspan) -> {
                                if (isSt && fname == f.name) {
                                    init = finit
                                }
                            }
                            case _ -> {}
                        }
                    }
                    statics.push(StaticSlotInit(slot, init))
                }
            }
        }
        var cid = PICKLE_CLASS_USER_BASE + em.cidSalt + len(em.classes)
        for (si in statics) {
            em.staticInits.push(StaticInitEntry(cid, si.slot, si.value))
        }
        for (f in table.consts) {
            var value: Expr? = none
            for (m in members) {
                match (m) {
                    case ClassMember.Const(cname, cvis, cty, cvalue, cspan) -> {
                        if (cname == f.name) {
                            value = cvalue
                        }
                    }
                    case _ -> {}
                }
            }
            if (let some(v) = value) {
                em.classConsts[pairKey(str(cid), f.name)] = ClassConst(f, v)
            }
        }
        var ctorFid = pushClassFunc(em, name + ".new", "pkl_" + name + "_new", FnSource.Ctor(table, inits, initBlocks, ctorDecl))
        em.ctorIds[cid] = ctorFid
        var ctorParams = emptyTys()
        if (let some(c) = table.ctor) {
            for (p in c.params) {
                ctorParams.push(p.ty)
            }
        }
        em.srcParamTys[ctorFid] = ctorParams
        for (m in members) {
            match (m) {
                case ClassMember.Constructor(c) -> {
                    if (let some(cname) = c.name) {
                        var fid = pushClassFunc(em, name + "." + cname, "pkl_" + name + "_nc_" + cname, FnSource.NamedCtor(table, c))
                        em.namedCtorIds[pairKey(str(cid), cname)] = fid
                        var ncinfo: NamedCtorInfo? = none
                        for (nc in table.namedCtors) {
                            if (nc.name == cname) {
                                ncinfo = nc
                            }
                        }
                        var ps = emptyTys()
                        if (let some(cinfo) = ncinfo) {
                            for (p in cinfo.ctor.params) {
                                ps.push(p.ty)
                            }
                        }
                        em.srcParamTys[fid] = ps
                    }
                }
                case _ -> {}
            }
        }
        if (let some(body) = deinitBlock) {
            var fid = pushClassFunc(em, name + ".deinit", "pkl_" + name + "_deinit", FnSource.Deinit(table, body))
            em.deinitIds[cid] = fid
        }
        for (m in members) {
            match (m) {
                case ClassMember.Method(md) -> {
                    var noBody = false
                    if (let none = md.body) {
                        noBody = true
                    }
                    if (noBody || !(len(md.generics) == 0)) {
                        continue
                    }
                    var info: CallableInfo? = none
                    for (i in table.methods) {
                        if (i.name == md.name) {
                            info = i
                        }
                    }
                    if (let none = info) {
                        continue
                    }
                    if (let some(inf) = info) {
                        var skip = false
                        for (p in inf.params) {
                            if (p.hasDefault || p.rest) {
                                skip = true
                            }
                        }
                        if (skip) {
                            continue
                        }
                        if (md.isAsync) {
                            registerAsyncMethod(em, name, table, md, inf, cid, emptyTys(), false, "", none)
                            continue
                        }
                        var symbol = ""
                        if (inf.isStatic) {
                            symbol = "pkl_" + name + "_sm_" + md.name
                        } else {
                            symbol = "pkl_" + name + "_" + md.name
                        }
                        var mid = pushClassFunc(em, name + "." + md.name, symbol, FnSource.Method(table, md))
                        em.finfo[mid] = inf
                        var ps = emptyTys()
                        for (p in inf.params) {
                            ps.push(p.ty)
                        }
                        em.srcParamTys[mid] = ps
                        methodDef(em, cid, md.name, mid, inf.isStatic)
                    }
                }
                case _ -> {}
            }
        }
        for (m in members) {
            match (m) {
                case ClassMember.Property(pd) -> {
                    var info: PropertyInfo? = none
                    for (i in table.properties) {
                        if (i.name == pd.name) {
                            info = i
                        }
                    }
                    if (let none = info) {
                        continue
                    }
                    if (let some(pinf) = info) {
                        var stem = ""
                        if (pd.isStatic) {
                            stem = "pkl_" + name + "_sm_" + pd.name + "_"
                        } else {
                            stem = "pkl_" + name + "_" + pd.name + "_"
                        }
                        if (pinf.hasGet) {
                            var fid = pushClassFunc(em, name + "." + pd.name + ".get", stem + "get", FnSource.Property(table, pd, pinf, false, pd.isStatic))
                            if (pd.isStatic) {
                                staticPropDef(em, cid, pd.name, false, fid)
                            } else {
                                propDef(em, cid, pd.name, false, fid)
                            }
                        }
                        if (pinf.hasSet) {
                            var fid2 = pushClassFunc(em, name + "." + pd.name + ".set", stem + "set", FnSource.Property(table, pd, pinf, true, pd.isStatic))
                            if (pd.isStatic) {
                                staticPropDef(em, cid, pd.name, true, fid2)
                            } else {
                                propDef(em, cid, pd.name, true, fid2)
                            }
                        }
                    }
                }
                case _ -> {}
            }
        }
        if (let some(pcid) = parentCid) {
            for (me in em.methodSeq) {
                if (me.cid == pcid) {
                    methodDef(em, cid, me.name, me.fid, me.isStatic)
                }
            }
            for (pe in em.propertySeq) {
                if (pe.cid == pcid) {
                    propDef(em, cid, pe.name, pe.isSet, pe.fid)
                }
            }
            for (pe in em.staticPropSeq) {
                if (pe.cid == pcid) {
                    staticPropDef(em, cid, pe.name, pe.isSet, pe.fid)
                }
            }
        }
        var implements = table.implements
        em.classes.push(ClassPlan(name, cid, parentCid, table))
        em.classByName[name] = cid
        if (!(len(implements) == 0)) {
            registerImplements(em, name, cid, implements, span)
        }
        true
    }

fn registerLambdas(em: Emitter) {
        for (item in em.prog.items) {
            var fnItem: FnDecl? = none
            match (item.kind) {
                case ItemKind.Fn(f) -> fnItem = f
                case ItemKind.Test(f) -> fnItem = f
                case ItemKind.Class(c) -> walkClassMembers(em, c.members, c.name)
                case ItemKind.Struct(s) -> walkClassMembers(em, s.members, s.name)
case ItemKind.Const(c) -> {
                        var scope = emptyScopeMaps()
                        var acc = emptyNameRefs()
                        walkExpr(em, c.value, none, none, 0, scope, acc)
                    }
                    // A managed global's initializer is real code evaluated by
                    // `pkl_globals_init`, so a lambda in it needs its hoisted body
                    // and closure class registered exactly like one in a function
                    // body. Scalar globals fold to bytes and cannot contain one.
                    case ItemKind.Global(g) -> {
                        var scope = emptyScopeMaps()
                        var acc = emptyNameRefs()
                        walkExpr(em, g.value, none, none, 0, scope, acc)
                    }
                case _ -> {}
            }
            if (let some(f) = fnItem) {
                var scope = emptyScopeMaps()
                var acc = emptyNameRefs()
                if (let some(b) = f.body) {
                    var generic = !(len(f.generics) == 0)
                    var saved = em.genericFnCtx
                    if (generic) {
                        em.genericFnCtx = f.name
                    }
                    walkFnBody(em, b, none, none, 0, scope, acc)
                    em.genericFnCtx = saved
                }
            }
        }
    }

    /// Whether `cls` is a generic class/struct whose member bodies carry `Var`s
    /// that only an instantiation can substitute (lambdas inside them are
    /// rejected loudly).
fn genericClassCtx(em: Emitter, cls: string) -> bool {
        if (let some(entry) = em.resolved.types.get(cls)) {
            match (entry) {
                case TypeTableEntry.Class(c) -> { return !(len(c.generics) == 0) }
                case TypeTableEntry.Struct(s) -> { return !(len(s.generics) == 0) }
                case _ -> { return false }
            }
        }
        false
    }

    /// Walk every lambda-holding member body of a class/struct with the class
    /// as owner (so statics/consts/fields resolve through it). Generics carry
    /// `Var`s, so a lambda inside a generic class is rejected by `walk_expr`.
fn walkClassMembers(em: Emitter, members: List<ClassMember>, cls: string) {
        var genericCtx = genericClassCtx(em, cls)
        var savedCtx = em.genericCtxName
        if (genericCtx) {
            em.genericCtxName = cls
        }
        var ocid: int? = em.classByName.get(cls)
        for (m in members) {
            var scope = emptyScopeMaps()
            var acc = emptyNameRefs()
            match (m) {
                case ClassMember.Field(fname, _, finit, _, _, _, _, _) -> {
                    if (let some(e) = finit) {
                        walkExpr(em, e, ocid, cls, 0, scope, acc)
                    }
                }
                case ClassMember.Field(_, _, _, _, _, _, _, _) | ClassMember.Constructor(_) -> {}
                case ClassMember.Method(md) -> {
                    if (let some(b) = md.body) {
                        walkFnBody(em, b, ocid, cls, 0, scope, acc)
                    }
                }
                case ClassMember.Property(pd) -> {
                    if (let some(a) = pd.get) {
                        walkAccessor(em, a, ocid, cls)
                    }
                    if (let some(a2) = pd.set) {
                        walkAccessor(em, a2, ocid, cls)
                    }
                }
                case ClassMember.Init(b2) -> walkBlock(em, b2, ocid, cls, 0, scope, acc)
                case ClassMember.Deinit(b2) -> walkBlock(em, b2, ocid, cls, 0, scope, acc)
                case ClassMember.Const(_, _, _, cvalue, _) -> walkExpr(em, cvalue, ocid, cls, 0, scope, acc)
            }
        }
        for (m in members) {
            match (m) {
                case ClassMember.Constructor(cd) -> {
                    var scope = emptyScopeMaps()
                    var acc = emptyNameRefs()
                    walkBlock(em, cd.body, ocid, cls, 0, scope, acc)
                }
                case _ -> {}
            }
        }
        em.genericCtxName = savedCtx
    }

fn walkAccessor(em: Emitter, a: PropertyAccessor, ownerCid: int?, ownerName: string?) {
        var scope = emptyScopeMaps()
        var acc = emptyNameRefs()
        match (a) {
            case PropertyAccessor.Expr(e) -> walkExpr(em, e, ownerCid, ownerName, 0, scope, acc)
            case PropertyAccessor.Block(b) -> walkBlock(em, b, ownerCid, ownerName, 0, scope, acc)
        }
    }

fn walkFnBody(em: Emitter, fb: FnBody, ownerCid: int?, ownerName: string?, lmark: int, scope: List<Map<string, bool>>, acc: List<NameRef>) {
        match (fb) {
            case FnBody.Block(b) -> walkBlock(em, b, ownerCid, ownerName, lmark, scope, acc)
            case FnBody.Expr(e) -> walkExpr(em, e, ownerCid, ownerName, lmark, scope, acc)
        }
    }

fn walkBlock(em: Emitter, b: Block, ownerCid: int?, ownerName: string?, lmark: int, scope: List<Map<string, bool>>, acc: List<NameRef>) {
        for (s in b.stmts) {
            walkStmt(em, s, ownerCid, ownerName, lmark, scope, acc)
        }
        if (let some(e) = b.expr) {
            walkExpr(em, e, ownerCid, ownerName, lmark, scope, acc)
        }
    }

fn walkStmt(em: Emitter, s: Stmt, ownerCid: int?, ownerName: string?, lmark: int, scope: List<Map<string, bool>>, acc: List<NameRef>) {
        match (s) {
            case Stmt.Let(pattern, _, init, _, _, _) -> {
                if (let some(e) = init) {
                    walkExpr(em, e, ownerCid, ownerName, lmark, scope, acc)
                }
                for (n in patternBinds(pattern)) {
                    scopeBind(scope, n)
                }
            }
            case Stmt.Const(cname, _, cvalue, _) -> {
                walkExpr(em, cvalue, ownerCid, ownerName, lmark, scope, acc)
                scopeBind(scope, cname)
            }
            case Stmt.Return(value, _) -> {
                if (let some(e) = value) {
                    walkExpr(em, e, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case Stmt.Return(_, _) | Stmt.Break(_) | Stmt.Continue(_) | Stmt.Empty(_) -> {}
            case Stmt.Throw(value, _) -> walkExpr(em, value, ownerCid, ownerName, lmark, scope, acc)
            case Stmt.Try(body4, binder, handler, fin, _) -> {
                // Each block gets its own scope, so a name bound inside a `try`
                // body, handler, or `finally` never leaks out of it -- and the
                // catch binder is only in scope for the handler body.
                scope.push(emptyScopeMap())
                walkBlock(em, body4, ownerCid, ownerName, lmark, scope, acc)
                scope.pop()
                if (let some(h) = handler) {
                    scope.push(emptyScopeMap())
                    if (let some(name) = binder) {
                        scopeBind(scope, name)
                    }
                    walkBlock(em, h, ownerCid, ownerName, lmark, scope, acc)
                    scope.pop()
                }
                if (let some(f) = fin) {
                    scope.push(emptyScopeMap())
                    walkBlock(em, f, ownerCid, ownerName, lmark, scope, acc)
                    scope.pop()
                }
            }
            case Stmt.Expr(e) -> walkExpr(em, e, ownerCid, ownerName, lmark, scope, acc)
            case Stmt.While(cond, body2, _) -> {
                walkExpr(em, cond, ownerCid, ownerName, lmark, scope, acc)
                scope.push(emptyScopeMap())
                walkBlock(em, body2, ownerCid, ownerName, lmark, scope, acc)
                scope.pop()
            }
            case Stmt.For(header, body3, _) -> {
                match (header) {
                    case ForHeader.In(pattern, sequence) -> {
                        walkExpr(em, sequence, ownerCid, ownerName, lmark, scope, acc)
                        scope.push(emptyScopeMap())
                        for (n in patternBinds(pattern)) {
                            scopeBind(scope, n)
                        }
                        walkBlock(em, body3, ownerCid, ownerName, lmark, scope, acc)
                        scope.pop()
                    }
                    case ForHeader.Range(init, cond, step) -> {
                        scope.push(emptyScopeMap())
                        walkStmt(em, init, ownerCid, ownerName, lmark, scope, acc)
                        walkExpr(em, cond, ownerCid, ownerName, lmark, scope, acc)
                        walkExpr(em, step, ownerCid, ownerName, lmark, scope, acc)
                        walkBlock(em, body3, ownerCid, ownerName, lmark, scope, acc)
                        scope.pop()
                    }
                }
            }
        }
    }

fn walkExpr(em: Emitter, e: Expr, ownerCid: int?, ownerName: string?, lmark: int, scope: List<Map<string, bool>>, acc: List<NameRef>) {
        match (e.kind) {
            case ExprKind.Ident(name) -> {
                if (em.collectWrites) {
                    return
                }
                if (!scopeContainsFrom(scope, lmark, name)) {
                    acc.push(NameRef(name, e.span))
                }
                var shadowed = false
                if (len(scope) >= 1) {
                    shadowed = scope[len(scope) - 1].has(name)
                }
                if (!shadowed && em.irModule.funcsByName.has(name) && isFnTy(em, e.span)) {
                    registerTrampoline(em, e.span, name)
                }
            }
            case ExprKind.This -> acc.push(NameRef("this", e.span))
            case ExprKind.Super -> acc.push(NameRef("__super", e.span))
            case ExprKind.Lit(_) | ExprKind.GenericCall(_, _) -> {}
            case ExprKind.Call(callee, args) -> {
                walkExpr(em, callee, ownerCid, ownerName, lmark, scope, acc)
                for (ca in args) {
                    walkExpr(em, ca.value, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case ExprKind.Member(object, name) -> {
                walkExpr(em, object, ownerCid, ownerName, lmark, scope, acc)
                var ot: Ty? = em.types.get(spanKey(object.span))
                if (let some(otv) = ot) {
                    var isCs = false
                    match (otv) {
                        case Ty.Class(_, _) -> isCs = true
                        case Ty.Struct(_, _) -> isCs = true
                        case _ -> {}
                    }
                    if (isCs) {
                        var cidOpt: int? = classIdOf(em, otv, object.span)
                        if (let some(cid) = cidOpt) {
                            var mrOpt: MethodRef? = em.methodIds.get(pairKey(str(cid), name))
                            if (let some(mr) = mrOpt) {
                                if (!mr.isStatic && isFnTy(em, e.span)) {
                                    registerMethodTrampoline(em, e.span, mr.fid, cid, name)
                                }
                            }
                        }
                    }
                }
            }
            case ExprKind.Index(object, index) -> {
                walkExpr(em, object, ownerCid, ownerName, lmark, scope, acc)
                walkExpr(em, index, ownerCid, ownerName, lmark, scope, acc)
            }
            case ExprKind.Binary(_, lhs, rhs) -> {
                walkExpr(em, lhs, ownerCid, ownerName, lmark, scope, acc)
                walkExpr(em, rhs, ownerCid, ownerName, lmark, scope, acc)
            }
            case ExprKind.Unary(_, operand) -> walkExpr(em, operand, ownerCid, ownerName, lmark, scope, acc)
            case ExprKind.Assign(target, _, value) -> {
                if (em.collectWrites) {
                    var tgtIsIdent = false
                    var tgtName = ""
                    match (target.kind) {
                        case ExprKind.Ident(n) -> {
                            tgtIsIdent = true
                            tgtName = n
                        }
                        case _ -> {}
                    }
                    if (tgtIsIdent) {
                        if (!scopeContainsFrom(scope, lmark, tgtName)) {
                            acc.push(NameRef(tgtName, target.span))
                        }
                    }
                    return
                }
                walkExpr(em, target, ownerCid, ownerName, lmark, scope, acc)
                walkExpr(em, value, ownerCid, ownerName, lmark, scope, acc)
            }
            case ExprKind.Lambda(lparams, _, isAsync, lbody) -> {
                if (em.collectWrites) {
                    return
                }
                if (let some(cls2) = em.genericCtxName) {
                    bad(em, e.span, "a lambda inside the generic class/struct `" + cls2 + "` is not lowered yet")
                    return
                }
                if (isAsync) {
                    bad(em, e.span, "async lambdas are not lowered yet")
                    return
                }
                for (p in lparams) {
                    var pBad = false
                    if (let some(_) = p.default) {
                        pBad = true
                    }
                    if (p.rest || pBad) {
                        bad(em, p.span, "lambda parameters cannot have defaults or rest markers")
                        return
                    }
                }
                var childMarker = len(scope)
                var before = len(acc)
                scope.push(boundParams(lparams))
                walkFnBody(em, lbody, ownerCid, ownerName, childMarker, scope, acc)
                var freeNames = splitOff(acc, before)
                var before2 = len(acc)
                em.collectWrites = true
                walkFnBody(em, lbody, ownerCid, ownerName, childMarker, scope, acc)
                em.collectWrites = false
                var written = splitOff(acc, before2)
                for (w in written) {
                    if (isEnclosingGlobal(em, w.name)) {
                        continue
                    }
                    var skipWrite = false
                    if (let some(cid) = ownerCid) {
                        var isField = false
                        if (let some(_) = instanceFieldIndex(em, cid, w.name)) {
                            isField = true
                        }
                        var isProp = em.propertyIds.has(tripleKey(str(cid), w.name, "false"))
                        var isStaticF = false
                        if (let some(_) = staticField(em, cid, w.name)) {
                            isStaticF = true
                        }
                        if (isField || isProp || isStaticF || classConstDefined(em, cid, w.name)) {
                            skipWrite = true
                        }
                    }
                    if (skipWrite) {
                        continue
                    }
                    bad(em, w.span, "assigning to `" + w.name + "` inside a lambda is not lowered yet: it is captured by value, and a hoisted body cannot mutate the enclosing binding (assign through a captured object's field instead)")
                    return
                }
                scope.pop()
                var capsOpt: List<Capture>? = decideCaptures(em, freeNames, ownerCid, ownerName, e.span)
                var chosen: List<Capture> = emptyCaptures()
                if (let some(c2) = capsOpt) {
                    chosen = c2
                } else {
                    return
                }
                if (let some(_) = em.genericFnCtx) {
                    em.lambdaCaps[lambdaKey(none, e.span)] = chosen
                    em.lambdaOwners[spanKey(e.span)] = ownerCid
                    em.lambdaExprs[spanKey(e.span)] = e
                } else {
                    registerLambda(em, e, chosen, ownerCid)
                }
                for (n in freeNames) {
                    if (!scopeContainsFrom(scope, lmark, n.name)) {
                        acc.push(NameRef(n.name, n.span))
                    }
                }
            }
            case ExprKind.If(cond, then, elseElse) -> {
match (cond) {
                    case IfCond.Cond(c) -> {
                        walkExpr(em, c, ownerCid, ownerName, lmark, scope, acc)
                        walkBlock(em, then, ownerCid, ownerName, lmark, scope, acc)
                    }
                    case IfCond.Binding(pattern, value) -> {
                        walkExpr(em, value, ownerCid, ownerName, lmark, scope, acc)
                        scope.push(emptyScopeMap())
                        for (n in patternBinds(pattern)) {
                            scopeBind(scope, n)
                        }
                        walkBlock(em, then, ownerCid, ownerName, lmark, scope, acc)
                        scope.pop()
                    }
                }
                if (let some(ee) = elseElse) {
                    walkExpr(em, ee, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case ExprKind.Match(scrutinee, arms) -> {
                walkExpr(em, scrutinee, ownerCid, ownerName, lmark, scope, acc)
                for (arm in arms) {
                    scope.push(emptyScopeMap())
                    for (n in patternBinds(arm.pattern)) {
                        scopeBind(scope, n)
                    }
                    if (let some(g) = arm.guard) {
                        walkExpr(em, g, ownerCid, ownerName, lmark, scope, acc)
                    }
                    walkExpr(em, arm.body, ownerCid, ownerName, lmark, scope, acc)
                    scope.pop()
                }
            }
            case ExprKind.Await(x) -> walkExpr(em, x, ownerCid, ownerName, lmark, scope, acc)
            case ExprKind.Cast(expr, _, _) -> walkExpr(em, expr, ownerCid, ownerName, lmark, scope, acc)
            case ExprKind.Unsafe(b) -> {
                scope.push(emptyScopeMap())
                walkBlock(em, b, ownerCid, ownerName, lmark, scope, acc)
                scope.pop()
            }
            case ExprKind.Block(b) -> {
                scope.push(emptyScopeMap())
                walkBlock(em, b, ownerCid, ownerName, lmark, scope, acc)
                scope.pop()
            }
            case ExprKind.Tuple(parts) -> {
                for (x in parts) {
                    walkExpr(em, x, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case ExprKind.Array(parts) -> {
                for (x in parts) {
                    walkExpr(em, x, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case ExprKind.Map(entries) -> {
                for (kv in entries) {
                    walkExpr(em, kv.key, ownerCid, ownerName, lmark, scope, acc)
                    walkExpr(em, kv.value, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case ExprKind.OptAccess(object, _) -> walkExpr(em, object, ownerCid, ownerName, lmark, scope, acc)
            case ExprKind.OptUnwrap(inner) -> walkExpr(em, inner, ownerCid, ownerName, lmark, scope, acc)
            case ExprKind.Range(start, end, _) -> {
                walkExpr(em, start, ownerCid, ownerName, lmark, scope, acc)
                walkExpr(em, end, ownerCid, ownerName, lmark, scope, acc)
            }
        }
    }

    /// Whether the type inferred for `span` is a function type.
fn isFnTy(em: Emitter, span: Span) -> bool {
        if (let some(t) = em.types.get(spanKey(span))) {
            match (t) {
                case Ty.Fn(_, _) -> { return true }
                case _ -> { return false }
            }
        }
        false
    }

    /// Decide which free names a lambda really captures (globals and the
    /// owner class's statics/consts resolve statically; instance members ride
    /// along as `this`), sorted deterministically for slot assignment.
fn decideCaptures(em: Emitter, free: List<NameRef>, ownerCid: int?, ownerName: string?, span: Span) -> List<Capture>? {
        var seen = emptyScopeMap()
        var caps = emptyCaptures()
        var needsThis = false
        for (fr in free) {
            if (fr.name == "__super") {
                bad(em, fr.span, "`super` inside a lambda is not lowered yet")
                return none
            }
            if (seen.has(fr.name)) {
                continue
            }
            seen[fr.name] = true
            if (isEnclosingGlobal(em, fr.name)) {
                continue
            }
            if (let some(cid) = ownerCid) {
                var isField = false
                if (let some(_) = instanceFieldIndex(em, cid, fr.name)) {
                    isField = true
                }
                var isProp = em.propertyIds.has(tripleKey(str(cid), fr.name, "false"))
                var isMethod = false
                var mvO2 = em.methodIds.get(pairKey(str(cid), fr.name))
                if (let some(mv2) = mvO2) {
                    if (!(mv2.isStatic)) {
                        isMethod = true
                    }
                }
                if (isField || isProp || isMethod) {
                    needsThis = true
                    continue
                }
                var isStaticF = false
                if (let some(_) = staticField(em, cid, fr.name)) {
                    isStaticF = true
                }
                if (isStaticF || classConstDefined(em, cid, fr.name)) {
                    continue
                }
            }
            var ty: Ty = Ty.Unknown
            if (let some(t2) = em.types.get(spanKey(fr.span))) {
                ty = t2
            } else {
                bad(em, fr.span, "cannot infer the type of captured `" + fr.name + "`")
                return none
            }
            caps.push(Capture(fr.name, ty, fr.span))
        }
        if (needsThis) {
            var oname = ""
            if (let some(on) = ownerName) {
                oname = on
            }
            if (oname == "") {
                bad(em, span, "internal: owner member with no owner name")
                return none
            }
            caps.push(Capture("this", Ty.Class(oname, emptyTys()), span))
        }
        var i = 1
        while (i < len(caps)) {
            var j = i
            while (j >= 1 && strLess(caps[j].name, caps[j - 1].name)) {
                var tmp = caps[j]
                caps[j] = caps[j - 1]
                caps[j - 1] = tmp
                j = j - 1
            }
            i = i + 1
        }
        if (len(caps) > MAX_LAMBDA_CAPTURES) {
            bad(em, span, "this lambda captures " + str(len(caps)) + " values, more than the supported limit of " + str(MAX_LAMBDA_CAPTURES))
            return none
        }
        caps
    }

fn isEnclosingGlobal(em: Emitter, name: string) -> bool {
        if (em.irModule.funcsByName.has(name) || em.classDecls.has(name) || em.constsInits.has(name)) {
            return true
        }
        match (name) {
            case "print" -> true
            case "println" -> true
            case "len" -> true
            case "alloc" -> true
            case "free" -> true
            case "view" -> true
            case "assert" -> true
            case "expect" -> true
            case "abs" -> true
            case "range" -> true
            case "min" -> true
            case "max" -> true
            case "clamp" -> true
            case "str" -> true
            case "bytes" -> true
            case "read_file" -> true
            case "write_file" -> true
            case "file_exists" -> true
            case "delete" -> true
            case "list_dir" -> true
            case "mkdir" -> true
            case "stream_open_read" -> true
            case "stream_open_write" -> true
            case "stream_open_append" -> true
case "stdout_stream" -> true
            case "stderr_stream" -> true
            case "args" -> true
            case "exit" -> true
            case "run_cmd" -> true
            case "run_spawn" -> true
            case "proc_wait" -> true
            case "proc_running" -> true
            case "proc_code" -> true
            case "proc_kill" -> true
            case "proc_out_read" -> true
            case "proc_err_read" -> true
            case "proc_in_write" -> true
            case "proc_in_close" -> true
            case "current_dir" -> true
            case "captureBegin" -> true
            case "captureTake" -> true
            case "thread_spawn" -> true
            case "thread_join" -> true
            case "thread_finished" -> true
            case "thread_message" -> true
            case "thread_count" -> true
            case "thread_current" -> true
            case "sleep_ms" -> true
            case "thread_yield" -> true
            case "mutex_new" -> true
            case "mutex_lock" -> true
            case "mutex_trylock" -> true
            case "mutex_unlock" -> true
            case "cond_new" -> true
            case "cond_signal" -> true
            case "cond_broadcast" -> true
            case "cond_wait" -> true
            case "sem_new" -> true
            case "sem_acquire" -> true
            case "sem_try_acquire" -> true
            case "sem_release" -> true
            case "atomic_new" -> true
            case "atomic_load" -> true
            case "atomic_store" -> true
            case "atomic_add" -> true
            case "atomic_cas" -> true
            case "once_new" -> true
            case "once_done" -> true
            case "once_run" -> true
            case "channel_new" -> true
            case "channel_cap" -> true
            case "channel_len" -> true
            case "channel_send" -> true
            case "channel_try_send" -> true
            case "channel_recv" -> true
            case "channel_try_recv" -> true
            case "channel_close" -> true
            case "channel_closed" -> true
            case "gcCollect" -> true
            case _ -> false
        }
    }

    /// A lambda body's inferred return type: its trailing expression, or unit
    /// when none (checked annotations win first, in `registerLambdaAt`).
fn inferLambdaRet(em: Emitter, body: FnBody) -> Ty {
        match (body) {
            case FnBody.Expr(e) -> {
                if (let some(t) = em.types.get(spanKey(e.span))) {
                    return t
                }
                Ty.Unknown
            }
            case FnBody.Block(b) -> {
                match (b.expr) {
                    case some(e2) -> {
                        if (let some(t) = em.types.get(spanKey(e2.span))) {
                            return t
                        }
                        Ty.Empty
                    }
                    case none -> Ty.Empty
                }
            }
        }
    }

    /// Register a lambda's hoisted body and its closure class.
fn registerLambda(em: Emitter, lambda: Expr, captures: List<Capture>, ownerCid: int?) {
        registerLambdaAt(em, lambda, captures, ownerCid, emptyStringTyMap(), none)
    }

    /// Register a hoisted lambda body under the (enclosing function, span) key,
    /// substituting `smap` into the signature, captures, and return type.
fn registerLambdaAt(em: Emitter, lambda: Expr, captures: List<Capture>, ownerCid: int?, smap: Map<string, Ty>, base: int?) -> int? {
        var lbody: FnBody = FnBody.Block(Block(emptyStmts(), none, Span(0, 0)))
        match (lambda.kind) {
            case ExprKind.Lambda(_, _, _, b) -> lbody = b
            case _ -> { return none }
        }
        registerClosureClass(em, len(captures), lambda.span)
        var fnty: Ty = Ty.Unknown
        if (let some(t) = em.types.get(spanKey(lambda.span))) {
            fnty = t
        }
        var pts: List<Ty> = emptyTys()
        var isFnTy = false
        match (fnty) {
            case Ty.Fn(pts0, _) -> {
                pts = pts0
                isFnTy = true
            }
            case _ -> {}
        }
        if (!isFnTy) {
            return none
        }
        if (paramsLen(lambda) != len(pts)) {
            return none
        }
        var subbedPts = emptyTys()
        for (pt in pts) {
            subbedPts.push(subst(pt, smap))
        }
        var anyBad = false
        for (pt in subbedPts) {
            if (let none = mapTy(em, pt, lambda.span)) {
                anyBad = true
                break
            }
        }
        if (anyBad) {
            return none
        }
        var ret: Ty = Ty.Unknown
        var isKnown = false
        match (fnty) {
            case Ty.Fn(_, r) -> {
                var rIsUnknown = false
                match (r) {
                    case Ty.Unknown -> rIsUnknown = true
                    case _ -> {}
                }
                if (!rIsUnknown) {
                    ret = r
                    isKnown = true
                }
            }
            case _ -> {}
        }
        if (!isKnown) {
            ret = inferLambdaRet(em, lbody)
        }
        var retIsUnknown = false
        match (ret) {
            case Ty.Unknown -> retIsUnknown = true
            case _ -> {}
        }
        if (retIsUnknown) {
            ret = inferLambdaRet(em, lbody)
        }
        var subbedRet = subst(ret, smap)
        if (let none = mapTy(em, subbedRet, lambda.span)) {
            return none
        }
        var subbedCaps = emptyCaptures()
        for (c in captures) {
            subbedCaps.push(Capture(c.name, subst(c.ty, smap), c.span))
        }
        var fid = pushClassFunc(em, "lambda", "pkl_closure_" + str(em.nextClosure), FnSource.Lambda(lambda, subbedCaps, subbedPts, subbedRet, ownerCid))
        em.nextClosure = em.nextClosure + 1
        em.instantonSubst[fid] = smap
        em.lambdaFids[lambdaKey(base, lambda.span)] = fid
        em.lambdaCaps[lambdaKey(base, lambda.span)] = subbedCaps
        fid
    }

    /// Register the synthetic `__closure_N` class (or return its id). Slot 0
    /// holds the hoisted body's code address; slots 1..N the captured values.
fn registerClosureClass(em: Emitter, captureCount: int, span: Span) -> int? {
        if (captureCount > MAX_LAMBDA_CAPTURES) {
            bad(em, span, "this lambda captures " + str(captureCount) + " values, more than the supported limit of " + str(MAX_LAMBDA_CAPTURES))
            return none
        }
        var name2 = CLOSURE_CLASS_PREFIX + str(captureCount)
        if (let some(cid) = em.classByName.get(name2)) {
            return cid
        }
        var fields = emptyFieldInfos()
        var fl = 0
        while (fl <= captureCount) {
            var fname = ""
            if (fl == CLOSURE_FN_SLOT) {
                fname = "__fn"
            } else {
                fname = "__c" + str(fl - 1)
            }
            fields.push(FieldInfo(fname, Visibility.Private, false, false, false, false, Ty.Int, span))
            fl = fl + 1
        }
        var table = ClassTable(name2, span, Visibility.Private, emptyStrs(), none, emptyTys(), fields, emptyCallableInfos(), emptyPropertyInfos(), none, emptyNamedCtorInfos(), emptyFieldInfos())
        var cid2 = PICKLE_CLASS_USER_BASE + em.cidSalt + len(em.classes)
        em.closureTables[name2] = table
        em.classByName[name2] = cid2
        em.classes.push(ClassPlan(name2, cid2, none, table))
        cid2
    }

    /// Register the forwarder letting a top-level function be called through a
    /// closure object, keyed so every value-use site maps to the same trampoline.
fn registerTrampoline(em: Emitter, span: Span, fnName: string) {
        var fidOpt: int? = em.irModule.funcsByName.get(fnName)
        if (let none = fidOpt) {
            return
        }
        var fid = 0
        if (let some(fv) = fidOpt) {
            fid = fv
        }
        var pty: List<Ty> = emptyTys()
        var ret: Ty = Ty.Unknown
        var hasFn = false
        if (let some(t) = em.types.get(spanKey(span))) {
            match (t) {
                case Ty.Fn(pts, r) -> {
                    pty = pts
                    ret = r
                    hasFn = true
                }
                case _ -> {}
            }
        }
        if (!hasFn) {
            return
        }
        var anyBad = false
        for (pt in pty) {
            if (let none = mapTy(em, pt, span)) {
                anyBad = true
                break
            }
        }
        if (anyBad) {
            return
        }
        if (let none = mapTy(em, ret, span)) {
            return
        }
        var tramp = 0
        if (let some(t) = em.trampFids.get(fid)) {
            tramp = t
        } else {
            tramp = pushClassFunc(em, "fn.value", "pkl_tramp_" + str(fid), FnSource.Trampoline(span, fid, pty, ret))
            em.trampFids[fid] = tramp
        }
        em.fnTramp[spanKey(span)] = tramp
    }

    /// Register the forwarder letting an instance method bound to a receiver
    /// be used as a value; dispatches on the receiver's runtime class when the
    /// receiver class records overrides for the method.
fn registerMethodTrampoline(em: Emitter, span: Span, fid: int, cid: int, name: string) {
        var pty: List<Ty> = emptyTys()
        var ret: Ty = Ty.Unknown
        var hasFn = false
        if (let some(t) = em.types.get(spanKey(span))) {
            match (t) {
                case Ty.Fn(pts, r) -> {
                    pty = pts
                    ret = r
                    hasFn = true
                }
                case _ -> {}
            }
        }
        if (!hasFn) {
            return
        }
        var anyBad = false
        for (pt in pty) {
            if (let none = mapTy(em, pt, span)) {
                anyBad = true
                break
            }
        }
        if (anyBad) {
            return
        }
        if (let none = mapTy(em, ret, span)) {
            return
        }
        var branches = emptyDispatchBranches()
        if (let some(b) = em.virtualDispatch.get(pairKey(str(cid), name))) {
            branches = b
        }
        var key = tripleKey(str(cid), name, str(fid))
        var tramp = 0
        if (let some(t) = em.methodTrampFids.get(key)) {
            tramp = t
        } else {
            tramp = pushClassFunc(em, "fn.method.value", "pkl_mtramp_" + str(cid) + "_" + name + "_" + str(fid), FnSource.MethodTrampoline(span, fid, pty, ret, branches))
            em.methodTrampFids[key] = tramp
        }
        em.fnTramp[spanKey(span)] = tramp
    }

    /// The runtime slot of instance field `name` on class `cid`, following the
    /// parent-first layout, when registered.
fn instanceFieldIndex(em: Emitter, cid: int, name: string) -> int? {
        var plan: ClassPlan? = none
        for (p in em.classes) {
            if (p.classId == cid) {
                plan = p
                break
            }
        }
        if (let none = plan) {
            return none
        }
        var pname = ""
        if (let some(p) = plan) {
            pname = p.name
        }
        absInstanceFieldSlot(em, pname, name)
    }

    /// Absolute (parent-first) slot of instance field `field` reachable from
    /// `cname`, whether declared on it or inherited.
fn absInstanceFieldSlot(em: Emitter, cname: string, field: string) -> int? {
        var base = 0
        for (a in ancestry(em, cname)) {
            var own = ownInstanceFields(em, a)
            var i = 0
            var found = false
            while (i < len(own)) {
                if (own[i].name == field) {
                    found = true
                    break
                }
                i = i + 1
            }
            if (found) {
                return base + i
            }
            base = base + len(own)
        }
        none
    }

    /// The static slot of static field `name` on class `cid`, with its declared
    /// type and the *declaring* class's id, when registered. Own declarations
    /// win, then up the ancestry.
fn staticField(em: Emitter, cid: int, name: string) -> StaticFieldLoc? {
        var plan: ClassPlan? = none
        for (p in em.classes) {
            if (p.classId == cid) {
                plan = p
                break
            }
        }
        if (let none = plan) {
            return none
        }
        var pname = ""
        if (let some(p) = plan) {
            pname = p.name
        }
        var chain = ancestry(em, pname)
        var ci = len(chain)
        while (ci >= 1) {
            ci = ci - 1
            var cn = chain[ci]
            if (let some(tb) = tableOf(em, cn)) {
                var slot: int? = staticFieldSlot(tb, name)
                if (let some(sl) = slot) {
                    var info: FieldInfo? = staticFieldInfo(tb, name)
                    if (let some(inf) = info) {
                        var dcid: int? = em.classByName.get(cn)
                        if (let some(dc) = dcid) {
                            return StaticFieldLoc(dc, sl, inf)
                        }
                    }
                }
            }
        }
        none
    }

    /// Whether `name` is a `const` declared on `cid` or any ancestor.
fn classConstDefined(em: Emitter, cid: int, name: string) -> bool {
        var plan: ClassPlan? = none
        for (p in em.classes) {
            if (p.classId == cid) {
                plan = p
                break
            }
        }
        if (let none = plan) {
            return false
        }
        var pname = ""
        if (let some(p) = plan) {
            pname = p.name
        }
        var chain = ancestry(em, pname)
        var ci = len(chain)
        while (ci >= 1) {
            ci = ci - 1
            var cn = chain[ci]
            if (let some(dc) = em.classByName.get(cn)) {
                if (em.classConsts.has(pairKey(str(dc), name))) {
                    return true
                }
            }
        }
        false
    }

    /// The registered runtime class id of a resolved class/struct type.
    /// Non-generic types resolve through `classByName`; a generic type with
    /// concrete arguments materializes its instantiation on first use.
fn classIdOf(em: Emitter, ty: Ty, span: Span) -> int? {
        var n = ""
        var args = emptyTys()
        var isTy = false
        match (ty) {
            case Ty.Class(nm, a) -> {
                n = nm
                args = a
                isTy = true
            }
            case Ty.Struct(nm, a) -> {
                n = nm
                args = a
                isTy = true
            }
            case _ -> {}
        }
        if (!isTy) {
            return none
        }
        for (a in args) {
            if (hasVar(a)) {
                return none
            }
        }
        if (len(args) == 0) {
            return em.classByName.get(n)
        }
        var tableGenerics = -1
        if (let some(entry) = em.resolved.types.get(n)) {
            match (entry) {
                case TypeTableEntry.Class(c) -> tableGenerics = len(c.generics)
                case TypeTableEntry.Struct(s) -> tableGenerics = len(s.generics)
                case _ -> {}
            }
        }
        if (tableGenerics == -1) {
            return none
        }
        if (tableGenerics != len(args)) {
            return none
        }
        if (let some(cid) = em.classInstByArgs.get(instKey(n, args))) {
            return cid
        }
        registerClassInstantiation(em, n, args, span)
    }

    /// Materialize one concrete instantiation of a generic class/struct under
    /// its mangled display name, registering its ctor and instance methods.
fn registerClassInstantiation(em: Emitter, name: string, args: List<Ty>, span: Span) -> int? {
        if (let some(cid0) = em.classInstByArgs.get(instKey(name, args))) {
            return cid0
        }
        var table = seedClassTable()
        var isTable = false
        if (let some(entry) = em.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Class(c) -> {
                    table = c
                    isTable = true
                }
                case TypeTableEntry.Struct(s) -> {
                    table = s
                    isTable = true
                }
                case _ -> {}
            }
        }
        if (!isTable) {
            bad(em, span, "`" + name + "` is not a class or struct")
            return none
        }
        if (len(table.generics) != len(args)) {
            bad(em, span, "`" + name + "` takes " + str(len(table.generics)) + " type argument(s), found " + str(len(args)))
            return none
        }
        var members2: List<ClassMember>? = none
        if (let some(gm) = em.genericTypeMembers.get(name)) {
            members2 = gm
        }
        if (let none = members2) {
            bad(em, span, "`" + name + "` is not lowerable")
            return none
        }
        var ms = emptyClassMembers()
        if (let some(x) = members2) {
            ms = x
        }
        if (let some(_) = table.extends) {
            bad(em, span, "`" + name + "` with `extends` is not lowered yet")
            return none
        }
        var hasOverride = false
        for (m in ms) {
            match (m) {
                case ClassMember.Method(md) -> {
                    if (md.isOverride) {
                        hasOverride = true
                    }
                }
                case _ -> {}
            }
        }
        if (hasOverride) {
            bad(em, span, "`" + name + "` uses `override`, which is not lowered yet")
            return none
        }
        var hasNamedCtor = false
        for (m in ms) {
            match (m) {
                case ClassMember.Constructor(cd2) -> {
                    if (let some(_) = cd2.name) {
                        hasNamedCtor = true
                    }
                }
                case _ -> {}
            }
        }
        if (hasNamedCtor) {
            bad(em, span, "`" + name + "` uses named constructors, which are not lowered yet")
            return none
        }
        var hasDeinit = false
        for (m in ms) {
            match (m) {
                case ClassMember.Deinit(_) -> hasDeinit = true
                case _ -> {}
            }
        }
        if (hasDeinit) {
            bad(em, span, "`" + name + "` uses `deinit`, which is not lowered yet for generic classes/structs")
            return none
        }
        var hasProp = false
        for (m in ms) {
            match (m) {
                case ClassMember.Property(_) -> hasProp = true
                case _ -> {}
            }
        }
        if (hasProp) {
            bad(em, span, "`" + name + "` uses properties, which are not lowered yet for generic classes/structs")
            return none
        }
        var hasStatic = !(len(table.consts) == 0)
        for (f in table.fields) {
            if (f.isStatic) {
                hasStatic = true
            }
        }
        if (hasStatic) {
            bad(em, span, "`" + name + "` uses static state, which is not lowered yet for generic classes/structs")
            return none
        }
        var map = emptyStringTyMap()
        var gi = 0
        while (gi < len(table.generics) && gi < len(args)) {
            map[table.generics[gi]] = args[gi]
            gi = gi + 1
        }
        var implements = emptyTys()
        for (t in table.implements) {
            implements.push(subst(t, map))
        }
        var suffix = ""
        var fi = 0
        for (a in args) {
            if (fi > 0) {
                suffix = suffix + "_"
            }
            suffix = suffix + sanitizeSymbol(bareName(a))
            fi = fi + 1
        }
        var display = name + "<"
        var di = 0
        for (a in args) {
            if (di > 0) {
                display = display + ", "
            }
            display = display + bareName(a)
            di = di + 1
        }
        display = display + ">"
        var stabFields = emptyFieldInfos()
        for (f in table.fields) {
            var fsub = subst(f.ty, map)
            stabFields.push(FieldInfo(f.name, f.visibility, f.isStatic, f.mutable, f.const_, f.manual, fsub, f.span))
        }
        var stabMethods = emptyCallableInfos()
        for (m in table.methods) {
            var nps = emptyParamInfos()
            for (p in m.params) {
                nps.push(ParamInfo(p.name, subst(p.ty, map), p.hasDefault, p.rest, p.span))
            }
            stabMethods.push(CallableInfo(m.name, m.span, m.visibility, m.isAsync, m.isStatic, m.isOverride, m.isAbstract, m.operator, m.generics, nps, subst(m.ret, map)))
        }
        var stabCtor: CtorInfo? = none
        if (let some(c) = table.ctor) {
            var nps2 = emptyParamInfos()
            for (p in c.params) {
                nps2.push(ParamInfo(p.name, subst(p.ty, map), p.hasDefault, p.rest, p.span))
            }
            stabCtor = CtorInfo(c.span, c.visibility, nps2)
        }
        var stable = ClassTable(display, table.span, table.visibility, table.generics, none, emptyTys(), stabFields, stabMethods, emptyPropertyInfos(), stabCtor, emptyNamedCtorInfos(), emptyFieldInfos())
        var ctorDecl: ConstructorDecl? = none
        for (m in ms) {
            match (m) {
                case ClassMember.Constructor(cd) -> {
                    if (let none = cd.name) {
                        ctorDecl = cd
                        break
                    }
                }
                case _ -> {}
            }
        }
        var inits = collectInstanceInits(em, name)
        var initBlocks = collectInitBlocks(em, name)
        var cid = PICKLE_CLASS_USER_BASE + em.cidSalt + len(em.classes)
        var ctorSymbol = uniqSymbol(em, "pkl_" + name + "_new__" + suffix)
        var ctorFid = pushClassFunc(em, display + ".new", ctorSymbol, FnSource.Ctor(stable, inits, initBlocks, ctorDecl))
        em.ctorIds[cid] = ctorFid
        var sps = emptyParamInfos()
        if (let some(c) = stable.ctor) {
            sps = c.params
        }
        var srctys = emptyTys()
        for (p in sps) {
            srctys.push(p.ty)
        }
        em.srcParamTys[ctorFid] = srctys
        em.instantonSubst[ctorFid] = map
        em.fidOwner[ctorFid] = cid
        em.fidGenerics[ctorFid] = table.generics
        for (m in ms) {
            match (m) {
                case ClassMember.Method(md) -> {
                    if (md.isOverride || !(len(md.generics) == 0)) {
                        continue
                    }
                    if (let none = md.body) {
                        continue
                    }
                    var minfo: CallableInfo? = none
                    for (mm in stable.methods) {
                        if (mm.name == md.name) {
                            minfo = mm
                        }
                    }
                    if (let none = minfo) {
                        continue
                    }
var m2 = seedCallableInfo()
                    if (let some(x) = minfo) {
                        m2 = x
                    }
                    var hasDefRest = false
                    for (p in m2.params) {
                        if (p.hasDefault || p.rest) {
                            hasDefRest = true
                        }
                    }
                    if (hasDefRest) {
                        continue
                    }
                    if (md.isAsync) {
                        var isStruct = false
                        if (let some(entry) = em.resolved.types.get(name)) {
                            match (entry) {
                                case TypeTableEntry.Struct(_) -> isStruct = true
                                case _ -> {}
                            }
                        }
                        registerAsyncMethod(em, display, stable, md, m2, cid, args, isStruct, "_" + suffix, map)
                        continue
                    }
                    var tref = "pkl_" + name + "_" + md.name + "_" + suffix
                    if (m2.isStatic) {
                        tref = "pkl_" + name + "_sm_" + md.name + "_" + suffix
                    }
                    var symbol = uniqSymbol(em, tref)
                    var mid = pushClassFunc(em, display + "." + md.name, symbol, FnSource.Method(stable, md))
                    em.finfo[mid] = m2
                    var mtys = emptyTys()
                    for (p in m2.params) {
                        mtys.push(p.ty)
                    }
                    em.srcParamTys[mid] = mtys
                    em.methodIds[pairKey(str(cid), md.name)] = MethodRef(mid, m2.isStatic)
                    em.instantonSubst[mid] = map
                    em.fidOwner[mid] = cid
                    em.fidGenerics[mid] = table.generics
                }
                case _ -> {}
            }
        }
        em.classes.push(ClassPlan(display, cid, none, stable))
        em.classInstByArgs[instKey(name, args)] = cid
        em.classInstSubst[cid] = map
        if (!(len(implements) == 0)) {
            registerImplements(em, display, cid, implements, span)
        }
        cid
    }
fn buildFunc(em: Emitter, fid: int) {
        em.fname = em.irModule.funcs[fid].name
        em.symbol = em.irModule.funcs[fid].symbol
        em.fparams = emptyIrParams()
        em.fslots = emptyIrTys()
        em.env = emptyIntScopeMap()
        em.env.push(seedIntScopeMap())
        em.manualEnv = emptyScopeMaps()
        em.manualEnv.push(seedScopeMap())
        em.blocks = emptyIrBlocks()
        em.blocks.push(IrBlock(0, emptyIrInstrs(), IrTerm.Unreachable))
        em.nextBlock = 1
        em.nextTemp = 0
        em.loops = emptyLoopCtxs()
        em.cur = 0
        // Reset the exception context per function alongside `loops`. Both stacks
        // balance themselves on a clean lowering, but a pass that bailed out
        // early can leave them dirty -- and the two-pass driver re-runs this
        // function, so pass 2 must not inherit that.
        em.finallys = emptyBlocks()
        em.handlers = emptyHandlerCtxs()
        em.inThrowTransfer = false
        em.owner = none
        em.currentFid = fid
        em.iceDepth = 0
        em.icePath = emptyStrs()
        em.iceSeq = emptyStrs()

        if (let some(s) = em.instantonSubst.get(fid)) {
            em.currentSubst = s
        } else {
            em.currentSubst = emptyStringTyMap()
        }
        var fg = emptyStrs()
        if (let some(g) = em.fidGenerics.get(fid)) {
            fg = g
        } else {
            if (let some(s) = em.fsource.get(fid)) {
                var tl: FnDecl? = none
                match (s) {
                    case FnSource.TopLevel(f) -> tl = f
                    case _ -> {}
                }
                if (let some(t) = tl) {
                    for (g in t.generics) {
                        fg.push(g.name)
                    }
                }
            }
        }
        em.fnGenerics = fg

var isMain = em.irModule.funcs[fid].isMain
        if (let some(src) = em.fsource.get(fid)) {
            match (src) {
                case FnSource.TopLevel(f) -> {
                    var infoOpt: CallableInfo? = none
                    if (let some(i) = em.finfo.get(fid)) {
                        infoOpt = i
                    }
                    if (let none = infoOpt) {
                        return
                    }
                    var info = seedCallableInfo()
                    if (let some(i) = infoOpt) {
                        info = i
                    }
                    declareParams(em, info.params)
                    adoptManualParams(em, f.params)
                    var m = mapTy(em, info.ret, f.span)
                    if (let some(r) = m) {
                        em.fret = r
                    } else {
                        em.fret = IrTy.Unit
                    }
                    emitBody(em, f.body)
                }
                case FnSource.Lambda(lambda, caps, pts, rt, owner) -> buildLambdaBody(em, lambda, caps, pts, rt, owner, fid)
                case FnSource.Trampoline(span, target, pts, rt) -> {
                    em.owner = none
                    buildTrampoline(em, span, target, pts, rt)
                }
case FnSource.MethodTrampoline(span, target, pts, rt, branches) -> {
                    em.owner = none
                    buildMethodTrampoline(em, span, target, pts, rt, branches)
                }
                case FnSource.SpreadTrampoline(span, target, pts, rt, recv) -> {
                    em.owner = none
                    buildSpreadTrampoline(em, span, target, pts, rt, recv)
                }
                case FnSource.Ctor(table, inits, initBlocks, cd) -> {
                    em.owner = ownerFor(em, fid, table.name)
                    buildCtorBody(em, table, inits, initBlocks, cd)
                }
                case FnSource.NamedCtor(table, cd) -> {
                    em.owner = ownerFor(em, fid, table.name)
                    buildNamedCtor(em, table, cd)
                }
                case FnSource.Deinit(table, body) -> {
                    em.owner = ownerFor(em, fid, table.name)
                    buildDeinitBody(em, table, body)
                }
                case FnSource.Method(table, md) -> {
                    var infoOpt2: CallableInfo? = none
                    if (let some(i) = em.finfo.get(fid)) {
                        infoOpt2 = i
                    }
                    if (let none = infoOpt2) {
                        return
                    }
                    var info2 = seedCallableInfo()
                    if (let some(i) = infoOpt2) {
                        info2 = i
                    }
                    em.owner = ownerFor(em, fid, table.name)
                    buildMethodBody(em, table, md, info2)
                }
                case FnSource.AsyncFn(f, hidden) -> {
                    var infoOpt3: CallableInfo? = none
                    if (let some(i) = em.finfo.get(fid)) {
                        infoOpt3 = i
                    }
                    if (let none = infoOpt3) {
                        return
                    }
                    var info3 = seedCallableInfo()
                    if (let some(i) = infoOpt3) {
                        info3 = i
                    }
                    declareParams(em, info3.params)
                    adoptManualParams(em, f.params)
                    // The wrapper returns the future: a closure snapshotting
                    // each parameter under its own name (slot 0 is the hidden
                    // body). Runs no user code.
                    em.fret = IrTy.Ptr
                    var captures = emptyCaptures()
                    for (p in info3.params) {
                        captures.push(Capture(p.name, p.ty, p.span))
                    }
                    if (let some(obj) = closureObj(em, Expr(f.span, ExprKind.Ident("")), hidden, captures)) {
                        term(em, IrTerm.Return(obj))
                    }
                }
                case FnSource.AsyncBody(f, pts, rt) -> buildAsyncBody(em, f, pts, rt)
                case FnSource.AsyncMethod(table, md, hidden, isStatic, thisTy) -> {
                    var infoOpt4: CallableInfo? = none
                    if (let some(i) = em.finfo.get(fid)) {
                        infoOpt4 = i
                    }
                    if (let none = infoOpt4) {
                        return
                    }
                    var info4 = seedCallableInfo()
                    if (let some(i) = infoOpt4) {
                        info4 = i
                    }
                    em.owner = ownerFor(em, fid, table.name)
                    buildAsyncMethodWrapper(em, md, info4, hidden, isStatic, thisTy)
                }
                case FnSource.AsyncMethodBody(table, md, pts, rt, isStatic) -> {
                    em.owner = ownerFor(em, fid, table.name)
                    buildAsyncMethodBody(em, md, pts, rt, isStatic)
                }
                case FnSource.Property(table, pd, pinfo, isSet, isStatic) -> {
                    em.owner = ownerFor(em, fid, table.name)
                    buildPropertyBody(em, table, pd, pinfo, isSet, isStatic)
                }
                case FnSource.StaticInit(inits) -> buildStaticInit(em, inits)
                case FnSource.GlobalsInit(inits) -> buildGlobalsInit(em, inits)
                case FnSource.TestSetup -> {
                    em.fret = IrTy.Unit
                    injectClassRegistrations(em)
                    term(em, IrTerm.Return(none))
                }
            }
        }
        if (em.failed) {
            return
        }

        var isFirstTest = !(isSomeInt(em.testSetupId)) && em.irModule.funcs[fid].isTest
        if (isFirstTest) {
            var k = 0
            while (k < fid) {
                if (em.irModule.funcs[k].isTest) {
                    isFirstTest = false
                    break
                }
                k = k + 1
            }
        }
        if (isMain || isFirstTest) {
            injectClassRegistrations(em)
        }

        var rname = em.irModule.funcs[fid].name
        var rsym = em.irModule.funcs[fid].symbol
        var rmain = em.irModule.funcs[fid].isMain
        var rtest = em.irModule.funcs[fid].isTest
        var rtags = em.irModule.funcs[fid].tags
        em.irModule.funcs[fid] = IrFunc(em.fname, em.symbol, em.fparams, em.fret, em.fslots, 0, em.blocks, rmain, rtest, rtags)
    }

    /// The owner class/struct id of a class-level function, resolved from the
    /// recorded owner, falling back to the class name. Mirrors the
    /// `fid_owner.get().or_else(class_by_name)` chain in `build_func`.
fn ownerFor(em: Emitter, fid: int, cname: string) -> int? {
        if (let some(o) = em.fidOwner.get(fid)) {
            return o
        }
        if (let some(o2) = em.classByName.get(cname)) {
            return o2
        }
        none
    }

    // ---- function registration helpers ----

    /// Append a class-level function (ctor, method, property accessor,
    /// `static.init`, `test.setup`, ...) to the module and record its source.
fn pushClassFunc(em: Emitter, name: string, symbol: string, src: FnSource) -> int {
        var fid = len(em.irModule.funcs)
        em.irModule.funcs.push(IrFunc(name, symbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), false, false, emptyStrs()))
        em.fidList.push(fid)
        em.fsource[fid] = src
        fid
    }


    /// The runtime symbol for a top-level callable, honoring an
    /// `#[symbol("...")]` attribute override so a function can claim an exact ABI
    /// symbol (e.g. a ported runtime's `pickle_str_len`).
fn symbolForAttrs(em: Emitter, name: string, isTest: bool, attrs: List<Attribute>) -> string {
        if (let some(s) = itemSymbol(attrs)) {
            em.overrides.push(s)
            return s
        }
        symbolFor(name, isTest)
    }


    /// The single user (non-builtin, non-overloaded) callable for `name`.
fn userCallable(em: Emitter, name: string) -> CallableInfo? {
        if (let some(infos) = em.resolved.fns.get(name)) {
            var users = emptyCallableInfos()
            for (c in infos) {
                if (!(c.span.start == 0 && c.span.end == 0)) {
                    users.push(c)
                }
            }
            if (len(users) == 1) {
                return users[0]
            }
        }
        none
    }

    // ---- diagnostics & type lowering ----
    /// Lower an explicit type annotation to its IR type. Mirrors `annot_ty`
    /// in emit.rs.
fn annotTy(em: Emitter, ty: TypeExpr?, span: Span) -> IrTy? {
        if (let some(te) = ty) {
            match (te.kind) {
                case TypeExprKind.Path(parts) -> {
                    if (len(parts) == 1) {
                        match (parts[0]) {
                            case "Int" -> IrTy.Int
                            case "Float" -> IrTy.Float
                            case "Bool" -> IrTy.Bool
                            case "Char" -> IrTy.Char
                            case "String" -> IrTy.Str
                            case _ -> IrTy.Ptr
                        }
                    } else {
                        IrTy.Ptr
                    }
                }
                case TypeExprKind.Pointer(inner) -> refAnnot(em, inner, span)
                case TypeExprKind.Ref(inner) -> refAnnot(em, inner, span)
                case _ -> {
                    bad(em, span, "this type annotation is not lowered yet")
                    none
                }
            }
        } else {
            bad(em, span, "`let` requires an initializer or a type annotation")
            none
        }
    }

fn refAnnot(em: Emitter, inner: TypeExpr, span: Span) -> IrTy? {
        var opt: TypeExpr? = inner
        var base = annotTy(em, opt, span)
        match (base) {
            case some(_) -> IrTy.Ptr
            case none -> none
        }
    }
    // ---- allocation helpers ----
    /// Record `name` as a `#[manualAlloc]` binding in the current scope.
fn declareManual(em: Emitter, name: string) {
        var scope = em.manualEnv[len(em.manualEnv) - 1]
        scope[name] = true
    }

    /// Is `name` a `#[manualAlloc]` binding in any enclosing scope?
fn isManual(em: Emitter, name: string) -> bool {
        var i = len(em.manualEnv) - 1
        while (i >= 0) {
            if (em.manualEnv[i].has(name)) {
                return true
            }
            i = i - 1
        }
        false
    }

    /// Walk the build environment scopes (innermost first) for a name's slot.
fn lookup(em: Emitter, name: string) -> int? {
        var i = len(em.env) - 1
        while (i >= 0) {
            if (em.env[i].has(name)) {
                return em.env[i][name]
            }
            i = i - 1
        }
        none
    }

    /// Bind the resolved parameter list at function entry. Slots are the
    /// parameter indices (0-based), matching the callee ABI.
fn declareParams(em: Emitter, params: List<ParamInfo>) {
        var i = 0
        while (i < len(params)) {
            var p = params[i]
            var m = mapTy(em, p.ty, p.span)
            var ir = IrTy.Ptr
            if (let some(r) = m) {
                ir = r
            }
            var slot = i
            em.fslots.push(ir)
            em.fparams.push(IrParam(p.name, ir))
            declare(em, p.name, slot)
            i = i + 1
        }
    }

    /// Adopt every `#[manualAlloc]` parameter at function entry so the callee
    /// owns (and is responsible for freeing) the incoming allocation.
fn adoptManualParams(em: Emitter, params: List<Param>) {
        for (p in params) {
            var hasManual = false
            for (a in p.attrs) {
                if (a.name == "manualAlloc") {
                    hasManual = true
                }
            }
            if (!hasManual) {
                continue
            }
            if (let none = lookup(em, p.name)) {
                continue
            }
            var slot = 0
            if (let some(s) = lookup(em, p.name)) {
                slot = s
            }
            var v = load(em, slot)
            var a2 = externCallT1(em, "pickle_manual_adopt", [IrTy.Ptr], IrTy.Ptr, [v])
            instr(em, IrInstr.StoreSlot(slot, a2))
            declareManual(em, p.name)
        }
    }
    /// Mirror of `boxForStore` for boundaries that are not list/map element
    /// slots: when the destination representation is `Ptr`, a scalar source
    /// (e.g. `let m: int? = 5`) must be lifted via `optionWrap` first.
fn packForPointerBoundary(em: Emitter, rep: ElemRep, v: int, vt: Ty, span: Span) -> int? {
        if (rep.isPtr) {
            optionWrap(em, v, vt, span)
        } else {
            v
        }
    }
/// The lowered parameter types of `fid` (empty before the callee's body is
    /// emitted). Mirrors reading `src_param_tys` from `emit.rs`.
fn srcParamList(em: Emitter, fid: int) -> List<Ty> {
        var p = emptyTys()
        if (let some(v) = em.srcParamTys.get(fid)) {
            p = v
        }
        p
    }

    /// The resolved return type of `fid`.
fn callRetFor(em: Emitter, fid: int) -> Ty {
        var ret = Ty.Unknown
        if (let some(i) = em.finfo.get(fid)) {
            ret = i.ret
        }
        ret
    }
    /// How a `Map<K, ...>` key is represented at the runtime boundary. Mirrors
    /// `key_rep` in emit.rs.
fn keyRep(em: Emitter, kty: Ty, span: Span) -> ElemRep? {
        match (kty) {
            case Ty.String -> ElemRep.ptr()
            case Ty.Int -> ElemRep.scalar("pickle_box_i64", "pickle_unbox_i64", IrTy.Int)
            case Ty.Float -> ElemRep.scalar("pickle_box_f64", "pickle_unbox_f64", IrTy.Float)
            case Ty.Bool -> ElemRep.scalar("pickle_box_bool", "pickle_unbox_bool", IrTy.Bool)
            case Ty.Byte -> ElemRep.scalar("pickle_box_i64", "pickle_unbox_i64", IrTy.Int)
            case Ty.Char -> ElemRep.scalar("pickle_box_char", "pickle_unbox_char", IrTy.Char)
case Ty.List(_) | Ty.Map(_, _) | Ty.Class(_, _) | Ty.Struct(_, _) | Ty.Enum(_, _) | Ty.Interface(_, _) | Ty.Range(_) | Ty.Option(_) | Ty.Tuple(_) -> ElemRep.ptr()
            case Ty.Stream -> {
                bad(em, span, "`Stream` map keys are not lowered yet")
                none
            }
            case Ty.Ref(_) -> {
                bad(em, span, "`&T` map keys are not lowered yet")
                none
            }
            case Ty.None | Ty.Empty -> {
                bad(em, span, "a map key of type `none` is impossible")
                none
            }
            case Ty.Unknown -> {
                bad(em, span, "map key type is not statically known")
                none
            }
            case Ty.Var(_) -> {
                bad(em, span, "generic map key types are not lowered yet")
                none
            }
            case Ty.Ptr(_) -> {
                bad(em, span, "`T*` map keys are not lowered yet")
                none
            }
            case Ty.Fn(_, _) -> {
                bad(em, span, "function map keys are not lowered yet")
                none
            }
        }
    }

/// The element type `T` of an `Iterable<T>` value (mirror of the
    /// checker's rule): either the interface type `Iterable<int>` directly, or
    /// a class/struct that transitively declares `implements Iterable<...>`
    /// with its own generic args substituted (so `MyList<string>` yields
    /// `string`). `none` when the value is not iterable via the protocol.
    /// Mirrors `iterable_elem` in emit.rs.
fn iterableElem(em: Emitter, ty: Ty) -> Ty? {
        match (ty) {
            case Ty.Interface(n, args) -> {
                if (n == "Iterable") {
                    if (len(args) > 0) {
                        return args[0]
                    }
                    return Ty.Unknown
                }
                return none
            }
            case _ -> {}
        }
        var name = ""
        var args = emptyTys()
        match (ty) {
            case Ty.Class(n, a) -> {
                name = n
                args = a
            }
            case Ty.Struct(n, a) -> {
                name = n
                args = a
            }
            case _ -> {
                return none
            }
        }
        var argsMap = emptyStringTyMap()
        if (let some(entry) = em.resolved.types.get(name)) {
            var gs = entryGenerics(entry)
            var i = 0
            while (i < len(gs)) {
                if (i < len(args)) {
                    argsMap[gs[i]] = args[i]
                } else {
                    argsMap[gs[i]] = Ty.Unknown
                }
                i = i + 1
            }
        }
        var chain = emptyStrs()
        var seen = emptyStrs()
        chain.push(name)
        while (len(chain) > 0) {
            var cname = chain[len(chain) - 1]
            chain.pop()
            if (strListHas(seen, cname)) {
                continue
            }
            seen.push(cname)
            var table: ClassTable? = none
            match (em.resolved.types.get(cname)) {
                case some(TypeTableEntry.Class(t)) -> table = t
                case some(TypeTableEntry.Struct(t)) -> table = t
                case _ -> {}
            }
            if (let none = table) {
                continue
            }
            if (let some(t) = table) {
                for (i2 in t.implements) {
                    match (i2) {
                        case Ty.Interface(iname, iargs) -> {
                            if (iname == "Iterable") {
                                var el = Ty.Unknown
                                if (len(iargs) > 0) {
                                    el = iargs[0]
                                }
                                return subst(el, argsMap)
                            }
                        }
                        case _ -> {}
                    }
                }
                if (let some(p) = t.extends) {
                    if (let some(nm) = named(p)) {
                        chain.push(nm)
                    }
                }
            }
        }
        none
    }

    /// Read one field slot of a managed object: `pickle_obj_slot_get` (mdv-63
    /// `mdv_09 slot`), unboxed when the field carries a scalar boundary type.
fn fieldRead(em: Emitter, span: Span, obj: int, fieldTy: Ty, slot: int) -> int? {
        var rep = ElemRep.ptr()
        if (let some(r) = elemRep(em, fieldTy, span)) {
            rep = r
        } else {
            return none
        }
        var idx = intConst(em, slot)
        var raw = externCallT1(em, "pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idx])
        if (rep.isPtr) {
            return raw
        }
        externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
    }

    /// Push a `break`/`continue` target pair for a loop.
fn pushLoop(em: Emitter, bt: int, ct: int) {
        em.loops.push(LoopCtx(ct, bt))
    }

    /// The innermost loop's `break` target, if inside a loop.
fn loopBreakTarget(em: Emitter) -> int? {
        if (len(em.loops) == 0) {
            return none
        }
        em.loops[len(em.loops) - 1].breakTarget
    }

    /// The innermost loop's `continue` target, if inside a loop.
fn loopContinueTarget(em: Emitter) -> int? {
        if (len(em.loops) == 0) {
            return none
        }
        em.loops[len(em.loops) - 1].continueTarget
    }
    /// Report a non-exhaustive enum match that fell through the whole chain.
fn panicNoMatchAt(em: Emitter, span: Span, sv: int) {
        externCallVoid(em, "pickle_panic_no_match", emptyIrTys(), emptyInts())
    }


    /// Fold a string temp list with `pickle_str_concat`. Mirrors `concat_strs`.
fn concatStr(em: Emitter, parts: List<int>) -> int? {
        if (len(parts) == 0) {
            return strConst(em, "")
        }
        var acc = parts[0]
        var i = 1
        while (i < len(parts)) {
            acc = externCallT1(em, "pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [acc, parts[i]])
            i = i + 1
        }
        acc
    }

    /// Lower a string literal: plain text becomes a `Const Str` temp;
    /// interpolated sub-expressions are stringified with the `pickle_str_from_*`
    /// helpers and concatenated. Mirrors `string_literal` in emit.rs.
fn stringLiteral(em: Emitter, parts: List<StrPart>) -> int? {
        var acc = -1
        var hasAcc = false
        for (part in parts) {
            var v = -1
            match (part) {
                case StrPart.Text(text) -> {
                    var t = temp(em)
                    instr(em, IrInstr.Const(t, IrConst.Str(internString(em, text))))
                    v = t
                }
                case StrPart.Expr(e) -> {
                    var vx = -1
                    if (let some(te) = expr(em, e)) {
                        vx = te
                    } else {
                        return none
                    }
                    var isByte = false
                    if (let some(bt) = tyOf(em, e.span)) {
                        match (bt) {
                            case Ty.Byte -> isByte = true
                            case _ -> {}
                        }
                    }
                    if (isByte) {
                        vx = externCallT1(em, "pickle_str_from_byte", [IrTy.Int], IrTy.Str, [vx])
                    } else {
                        var kind = -1
                        if (let some(it) = irty(em, e.span)) {
                            kind = irTyTag(it)
                        } else {
                            return none
                        }
                        if (kind == irTyTag(IrTy.Int)) {
                            vx = externCallT1(em, "pickle_str_from_i64", [IrTy.Int], IrTy.Str, [vx])
                        } else if (kind == irTyTag(IrTy.Float)) {
                            vx = externCallT1(em, "pickle_str_from_f64", [IrTy.Float], IrTy.Str, [vx])
                        } else if (kind == irTyTag(IrTy.Bool)) {
                            vx = externCallT1(em, "pickle_str_from_bool", [IrTy.Bool], IrTy.Str, [vx])
                        } else if (kind == irTyTag(IrTy.Char)) {
                            vx = externCallT1(em, "pickle_str_from_char", [IrTy.Char], IrTy.Str, [vx])
                        } else if (kind != irTyTag(IrTy.Str)) {
                            bad(em, e.span, "interpolation of this IR type is not lowered yet")
                            return none
                        }
                    }
                    v = vx
                }
            }
            if (!hasAcc) {
                acc = v
            } else {
                acc = externCallT1(em, "pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [acc, v])
            }
            hasAcc = true
        }
        if (!hasAcc) {
            var t2 = temp(em)
            instr(em, IrInstr.Const(t2, IrConst.Str(internString(em, ""))))
            return t2
        }
        acc
    }

    /// Lower a literal expression. Float literals defer to a pure text-to-float
    /// conversion (`floatVal`).
fn lit(em: Emitter, l: Lit) -> int? {
        match (l) {
            case Lit.Int(value) -> intConst(em, value)
            case Lit.Float(text) -> floatConst(em, floatVal(text))
            case Lit.Bool(b) -> boolConst(em, b)
            case Lit.Char(c) -> charConst(em, c as int)
            case Lit.String(parts) -> {
                var ph = temp(em)
                stringLiteral(em, parts)
            }
case Lit.None -> {
                var ph = temp(em)
                nullTemp(em)
            }
        }
    }

    // ---- expression hub ----

    /// The expression lowering hub (mirror of `expr` in emit.rs). Kinds whose
    /// lowering lives in later sub-slices (calls, binary/unary/assign, if/let,
/// Ice guard: deep recursion without `TRICK_COUNT` pops means the ported
    /// emitter re-entered a cycle. Report the tail of the route taken.
fn icePathTail(em: Emitter) -> string {
        var tail = ""
        var n = len(em.icePath)
        var start = 0
        if (n > 24) {
            start = n - 24
        }
        var k = start
        while (k < n) {
            tail += em.icePath[k] + " -> "
            k = k + 1
        }
        tail
    }

    /// Catches an unwrapped recursion cycle by looking for a short repeating
    /// period in the monotonic ledger of hot lowering-function entries. Pk's
    /// explicit-return style defeats entry/exit bookkeeping, so this uses the
    /// repetition itself: a runaway loop prints itself within a few laps,
    /// well before the native stack bottoms out.
fn icePoke(em: Emitter, g: string) -> bool {
        if (len(em.iceSeq) > 1000) {
            var nxt = emptyStrs()
            var start = len(em.iceSeq) - 400
            var i = start
            while (i < len(em.iceSeq)) {
                nxt.push(em.iceSeq[i])
                i = i + 1
            }
            em.iceSeq = nxt
        }
        em.iceSeq.push(g)
        var n = len(em.iceSeq)
        var maxP = 60
        var minLaps = 100000
        if (n <= maxP * 2) {
            return true
        }
        var p = 2
        while (p <= maxP) {
            var ok = true
            var j = 0
            while (j < p) {
                if (em.iceSeq[n - p - 1 - j] != em.iceSeq[n - 1 - j]) {
                    ok = false
                    j = p
                }
                j = j + 1
            }
            if (ok) {
                var laps = 1
                var back = 2 * p
                while (back + p <= n) {
                    var still = true
                    var m = 0
                    while (m < p) {
                        if (em.iceSeq[n - back - m] != em.iceSeq[n - back + p - m]) {
                            still = false
                            m = p
                        }
                        m = m + 1
                    }
                    if (!(still)) {
                        back = n + p
                    } else {
                        laps = laps + 1
                        back = back + p
                    }
                }
                if (laps >= minLaps) {
                    return false
                }
            }
            p = p + 1
        }
        true
    }

fn expr(em: Emitter, e: Expr) -> int? {
        if (em.iceDepth > 150) {
            return none
        }
        em.iceDepth = em.iceDepth + 1
        em.icePath.push("expr")
        var r = expr1(em, e)
        em.iceDepth = em.iceDepth - 1
        r
    }

fn expr1(em: Emitter, e: Expr) -> int? {
        if (!icePoke(em, "expr1")) {
            return none
        }
        if (let none = irty(em, e.span)) {
            return none
        }
        match (e.kind) {
            case ExprKind.Lit(l) -> lit(em, l)
            case ExprKind.Ident(name) -> identExpr(em, e, name)
            case ExprKind.Call(callee, args) -> call(em, e, callee, args)
            case ExprKind.Binary(op, lhs, rhs) -> binary(em, e, op, lhs, rhs)
            case ExprKind.Unary(op, operand) -> unary(em, e, op, operand)
            case ExprKind.Assign(target, op, value) -> assign(em, e, target, op, value)
            case ExprKind.If(cond, then, elseElse) -> ifExpr(em, e, cond, then, elseElse)
            case ExprKind.Block(b) -> {
                pushScope(em)
                var r = blockValue(em, b)
                popScope(em)
                r
            }
            case ExprKind.This -> thisValue(em, e)
            case ExprKind.Super -> thisValue(em, e)
            case ExprKind.Member(object, name) -> memberValue(em, e, object, name)
            case ExprKind.Index(object, index) -> indexRead(em, e, object, index)
            case ExprKind.OptAccess(object, name) -> optAccess(em, e, object, name)
            case ExprKind.OptUnwrap(inner) -> optUnwrap(em, e, inner)
            case ExprKind.Lambda(_p, _r, _a, _b) -> lambdaValue(em, e)
            case ExprKind.Match(scrutinee, arms) -> matchExpr(em, e, scrutinee, arms)
            case ExprKind.Await(inner) -> {
                var t0: Ty? = none
                if (let some(t) = tyOf(em, inner.span)) {
                    t0 = t
                }
                // A future is a captured zero-argument closure (`() -> R`):
                // drive it by calling it with no arguments.
                var emptyFn = false
                var prt = Ty.None
                match (t0) {
                    case some(Ty.Fn(ps, r)) -> {
                        if (len(ps) == 0) {
                            emptyFn = true
                            prt = r
                        }
                    }
                    case _ -> {}
                }
                if (emptyFn) {
                    var obj = 0
                    if (let some(o) = expr(em, inner)) {
                        obj = o
                    } else {
                        return none
                    }
                    return fnValueCallFrom(em, e, obj, Ty.Fn(emptyTyList(), prt), emptyCallArgs())
                }
                match (t0) {
                    case some(Ty.Unknown) -> {
                        bad(em, inner.span, "cannot `await` a value whose type is unknown; an `async fn` call returns a `() -> T` future")
                    }
                    case some(Ty.Fn(_, _)) -> {
                        bad(em, inner.span, "a function taking arguments; a future is a zero-argument function")
                    }
                    case some(t2) -> {
                        bad(em, inner.span, "cannot `await` a value of type `{bareName(t2)}`; a future is the `() -> T` value returned by an `async fn`")
                    }
                    case none -> {
                        bad(em, inner.span, "an untyped value")
                    }
                }
                none
            }
            case ExprKind.GenericCall(name, typeArgs) -> genericFnValue(em, e, name, typeArgs)
            case ExprKind.Cast(ex, ty, k) -> cast(em, e, ex, ty, k)
            case ExprKind.Unsafe(b) -> {
                pushScope(em)
                var r = blockValue(em, b)
                popScope(em)
                r
            }
            case ExprKind.Tuple(items) -> tupleLiteral(em, e, items)
            case ExprKind.Array(items) -> arrayLiteral(em, e, items)
            case ExprKind.Map(entries) -> mapLiteral(em, e, entries)
            case ExprKind.Range(_s, _e, _i) -> {
                bad(em, e.span, "range values are not lowered yet")
                none
            }
        }
    }

    /// `this` / bare-name locals in instance context: read a bare field; the
    /// getter for a bare property; a static field of the enclosing class; or a
    /// class constant of the enclosing class. Mirrors `ident_expr` in emit.rs.
fn identExpr(em: Emitter, e: Expr, name: string) -> int? {
   if (let some(slot) = lookup(em, name)) {
   return load(em, slot)
   }
   // A top-level `var` is a real data slot: read it. This must be checked
   // *before* the const inline so a global is never mistaken for a value.
   if (em.globalIds.has(name)) {
   var gid: int? = none
   gid = em.globalIds[name]
   if (let some(id) = gid) {
   var ty = em.irModule.globals[id].ty
   var dst = temp(em)
   instr(em, IrInstr.LoadGlobal(dst, id, ty))
   return dst
   }
   }
   if (em.constsInits.has(name)) {
            if (strListHas(em.constInlining, name)) {
                bad(em, e.span, "cyclic `const` initialization of `" + name + "`")
                return none
            }
            em.constInlining.push(name)
            var ini = em.constsInits.get(name)
            if (let some(ini) = ini) {
                var t = expr(em, ini)
                em.constInlining.pop()
                return t
            }
            em.constInlining.pop()
            return none
        }
        if (let some(cid) = em.owner) {
            if (let some(slot) = instanceFieldIndex(em, cid, name)) {
                var fieldTy = fieldAt(em, cid, slot).ty
                var tv = thisValue(em, e)
                if (let some(tv) = tv) {
                    return fieldRead(em, e.span, tv, fieldTy, slot)
                }
                return none
            }
            if (let some(fid) = em.propertyIds.get(tripleKey(str(cid), name, str(false)))) {
                var tthis = thisValue(em, e)
                if (let some(tthis) = tthis) {
                    return callMethod(em, e, fid, emptyCallArgs(), tthis)
                }
                return none
            }
            if (let some(sf) = staticField(em, cid, name)) {
                return staticRead(em, e.span, sf.dcid, sf.slot, sf.info.ty)
            }
            if (let some(r) = readClassConst(em, e.span, cid, name)) {
                return r
            }
        }
        if (let some(fid) = em.irModule.funcsByName.get(name)) {
            return fnValueClosure(em, e, fid)
        }
        if (genericUserFn(em, name)) {
            bad(em, e.span, "using the generic function `" + name + "` as a value is not lowered yet; call it with explicit type arguments instead")
            return none
        }
        bad(em, e.span, "using `" + name + "` as a value is not lowered yet")
        none
    }

    /// The current receiver `this`, when available. Mirrors `this_value`.
fn thisValue(em: Emitter, e: Expr) -> int? {
        if (let some(slot) = lookup(em, "this")) {
            return load(em, slot)
        }
        bad(em, e.span, "`this` is not available here")
        none
    }

    /// `object.name`: enum variants, class/struct instance fields, instance
    /// properties (deferred), bound methods (deferred), and `Type.member`
    /// static reads/class consts. Mirrors `member_value` in emit.rs.
fn memberValue(em: Emitter, e: Expr, object: Expr, name: string) -> int? {
        if (let some(en) = exprKindIdentName(object)) {
            if (let some(entry) = em.resolved.types.get(en)) {
                match (entry) {
                    case TypeTableEntry.Enum(t) -> {
                        var vix = -1
                        var found = false
                        var hasPayload = false
                        var i = 0
                        for (v in t.variants) {
                            if (v.name == name) {
                                vix = i
                                found = true
                                hasPayload = len(v.fields) > 0
                                break
                            }
                            i = i + 1
                        }
                        if (!found) {
                            bad(em, e.span, "enum `" + t.name + "` has no variant `" + name + "`")
                            return none
                        }
                        if (hasPayload) {
                            bad(em, e.span, "variant `" + name + "` carries " + str(len(t.variants[vix].fields)) + " payload field(s) and needs `" + name + "(...)`")
                            return none
                        }
                        var tag = intConst(em, vix)
                        var zero = intConst(em, 0)
                        return externCallT1(em, "pickle_enum_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [tag, zero])
                    }
                    case _ -> {}
                }
            }
        }
        var ot = tyOf(em, object.span)
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Ptr(iner) -> ot = iner
                case Ty.Ref(iner) -> ot = iner
                case _ -> {}
            }
        }
        var cid: int? = none
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Class(_, _) -> cid = classIdOf(em, pt, e.span)
                case Ty.Struct(_, _) -> cid = classIdOf(em, pt, e.span)
                case _ -> {}
            }
        }
        if (let some(cc) = cid) {
            if (let some(slot) = instanceFieldIndex(em, cc, name)) {
                var fieldTy = fieldAt(em, cc, slot).ty
                var obj = expr(em, object)
                if (let some(obj) = obj) {
                    return fieldRead(em, e.span, obj, fieldTy, slot)
                }
                return none
            }
            if (let some(fid) = em.propertyIds.get(tripleKey(str(cc), name, str(false)))) {
                var obj = expr(em, object)
                if (let some(obj) = obj) {
                    return callMethod(em, e, fid, emptyCallArgs(), obj)
                }
                return none
            }
            if (let some(mref) = em.methodIds.get(pairKey(str(cc), name))) {
                if (mref.isStatic) {
                    bad(em, e.span, "static method `" + name + "` cannot be used as a value")
                    return none
                }
                return boundMethodValue(em, e, object)
            }
            bad(em, e.span, "method `" + name + "` of `" + classOfName(em, cc) + "` cannot be used as a value")
            return none
        }
        if (let some(tname) = exprKindIdentName(object)) {
            if (let some(cx) = em.classByName.get(tname)) {
                if (let some(fid) = em.staticPropertyIds.get(tripleKey(str(cx), name, str(false)))) {
                    return callMethod(em, e, fid, emptyCallArgs(), none)
                }
                if (let some(sf) = staticField(em, cx, name)) {
                    return staticRead(em, e.span, sf.dcid, sf.slot, sf.info.ty)
                }
                if (let some(r) = readClassConst(em, e.span, cx, name)) {
                    return r
                }
                bad(em, e.span, "static member `" + name + "` on `" + tname + "` is not lowered yet")
                return none
            }
        }
        bad(em, e.span, "member access is not lowered yet")
        none
    }

    // ---- option expressions ----

    /// `p != null`: whether an option pointer is present.
fn optIsPresent(em: Emitter, p: int) -> int? {
        var nul = nullTemp(em)
        if (let some(n) = nul) {
            var dst = temp(em)
            instr(em, IrInstr.BinOp(dst, IrBinOp.Ne, p, n))
            return dst
        }
        none
    }

    /// Resolve a present option pointer to its inner value: scalars are
    /// unboxed to the element IR type; managed values pass through. Mirrors
    /// `opt_resolve` in emit.rs.
fn optResolve(em: Emitter, p: int, inner: Ty, span: Span) -> int? {
        var ir = mapTy(em, inner, span)
        if (let some(ir) = ir) {
            if (irTyTag(ir) == irTyTag(IrTy.Int)) {
                return externCallT1(em, "pickle_unbox_i64", [IrTy.Ptr], IrTy.Int, [p])
            } else if (irTyTag(ir) == irTyTag(IrTy.Float)) {
                return externCallT1(em, "pickle_unbox_f64", [IrTy.Ptr], IrTy.Float, [p])
            } else if (irTyTag(ir) == irTyTag(IrTy.Bool)) {
                return externCallT1(em, "pickle_unbox_bool", [IrTy.Ptr], IrTy.Bool, [p])
            } else if (irTyTag(ir) == irTyTag(IrTy.Char)) {
                return externCallT1(em, "pickle_unbox_char", [IrTy.Ptr], IrTy.Char, [p])
            }
            return p
        }
        none
    }

    /// `a ?? b`: yield the unwrapped `a` when present, else `b`. Mirrors
    /// `null_coalesce` in emit.rs.
fn nullCoalesce(em: Emitter, e: Expr, lhs: Expr, rhs: Expr) -> int? {
        var innerTy = Ty.Unknown
        var got = false
        if (let some(t) = tyOf(em, lhs.span)) {
            if (let some(i) = innerOption(t)) {
                innerTy = i
                got = true
            }
        }
        if (!got) {
            bad(em, e.span, "left side of `??` is not an option")
            return none
        }
        var resIr0 = mapTy(em, innerTy, e.span)
        if (let none = resIr0) {
            return none
        }
        var resIr = IrTy.Unit
        if (let some(x) = resIr0) {
            resIr = x
        }
        var resSlot = newSlot(em, resIr)
        var a0 = expr(em, lhs)
        if (let none = a0) {
            return none
        }
        var a = 0
        if (let some(v) = a0) {
            a = v
        }
        var present0 = optIsPresent(em, a)
        if (let none = present0) {
            return none
        }
        var present = 0
        if (let some(p) = present0) {
            present = p
        }
        var someId = newBlock(em)
        var rhsId = newBlock(em)
        var join = newBlock(em)
        term(em, IrTerm.BranchIf(present, someId, rhsId))
        em.cur = someId
        var av0 = optResolve(em, a, innerTy, e.span)
        if (let none = av0) {
            return none
        }
        var av = 0
        if (let some(v) = av0) {
            av = v
        }
        instr(em, IrInstr.StoreSlot(resSlot, av))
        term(em, IrTerm.Branch(join))
        em.cur = rhsId
        var bv = expr(em, rhs)
        if (let none = bv) {
            return none
        }
        var b = 0
        if (let some(v) = bv) {
            b = v
        }
        if (irTyTag(resIr) == irTyTag(IrTy.Ptr)) {
            var vt = Ty.Unknown
            if (let some(gt) = tyOf(em, rhs.span)) {
                vt = gt
            }
            var wv = optionWrap(em, b, vt, rhs.span)
            if (let none = wv) {
                return none
            }
            if (let some(w) = wv) {
                b = w
            }
        }
        instr(em, IrInstr.StoreSlot(resSlot, b))
        term(em, IrTerm.Branch(join))
        em.cur = join
        return load(em, resSlot)
    }

    /// `a?`: unwrap `a` to its inner value, panicking on `none`. Mirrors
    /// `opt_unwrap`.

fn optUnwrap(em: Emitter, e: Expr, operand: Expr) -> int? {
        var innerTy = Ty.Unknown
        var got = false
        if (let some(t) = tyOf(em, operand.span)) {
            if (let some(i) = innerOption(t)) {
                innerTy = i
                got = true
            }
        }
        if (!got) {
            bad(em, e.span, "`?` operand is not an option")
            return none
        }
        var p = expr(em, operand)
        if (let some(p) = p) {
            return optUnwrapVal(em, e.span, p, innerTy)
        }
        none
    }

    /// Unwrap an already-evaluated option pointer `p` to its inner value,
    /// panicking on `none`. Mirrors `opt_unwrap_val`.
fn optUnwrapVal(em: Emitter, span: Span, p: int, inner: Ty) -> int? {
        var resIr0 = mapTy(em, inner, span)
        if (let some(resIr) = resIr0) {
            var resSlot = newSlot(em, resIr)
            var present = optIsPresent(em, p)
            if (let some(present) = present) {
                var someId = newBlock(em)
                var noneId = newBlock(em)
                var join = newBlock(em)
                term(em, IrTerm.BranchIf(present, someId, noneId))
                em.cur = noneId
                externCallVoid(em, "pickle_panic_none_unwrap", emptyIrTys(), emptyInts())
                term(em, IrTerm.Branch(join))
                em.cur = someId
                var v = optResolve(em, p, inner, span)
                if (let some(v) = v) {
                    instr(em, IrInstr.StoreSlot(resSlot, v))
                    term(em, IrTerm.Branch(join))
                    em.cur = join
                    return load(em, resSlot)
                }
                return none
            }
            return none
        }
        none
    }

    /// `a?.name`: when `a` is present, read `name` off the receiver and lift it
    /// to `T?`; when it is `none`, the result is `none`. Mirrors `opt_access`.
fn optAccess(em: Emitter, e: Expr, object: Expr, name: string) -> int? {
        var innerTy = Ty.Unknown
        var got = false
        if (let some(t) = tyOf(em, object.span)) {
            if (let some(i) = innerOption(t)) {
                innerTy = i
                got = true
            }
        }
        if (!got) {
            bad(em, e.span, "`?.` requires an option receiver")
            return none
        }
        var o = expr(em, object)
        if (let some(o) = o) {
            var resSlot = newSlot(em, IrTy.Ptr)
            var present = optIsPresent(em, o)
            if (let some(present) = present) {
                var someId = newBlock(em)
                var noneId = newBlock(em)
                var join = newBlock(em)
                term(em, IrTerm.BranchIf(present, someId, noneId))
                em.cur = noneId
                var n = nullTemp(em)
                if (let some(n) = n) {
                    instr(em, IrInstr.StoreSlot(resSlot, n))
                    term(em, IrTerm.Branch(join))
                    em.cur = someId
                    var mr = optMemberRead(em, e, o, innerTy, name)
                    if (let some(mr) = mr) {
                        var wrapper = optionWrap(em, mr.v, mr.ty, e.span)
                        if (let some(w) = wrapper) {
                            instr(em, IrInstr.StoreSlot(resSlot, w))
                            term(em, IrTerm.Branch(join))
                            em.cur = join
                            return load(em, resSlot)
                        }
                        return none
                    }
                    return none
                }
                return none
            }
            return none
        }
        none
    }

    /// Read field `name` (or dispatch the getter for property `name`) from an
    /// already-evaluated class/struct receiver (property getters deferred).
    /// Mirrors `opt_member_read`.
fn optMemberRead(em: Emitter, e: Expr, obj: int, recvTy: Ty, name: string) -> OptMemberVal? {
        var cid: int? = none
        var cname = ""
        match (recvTy) {
            case Ty.Class(cn, _) -> {
                cid = classIdOf(em, recvTy, e.span)
                cname = cn
            }
            case Ty.Struct(cn, _) -> {
                cid = classIdOf(em, recvTy, e.span)
                cname = cn
            }
            case _ -> {}
        }
if (let some(cc) = cid) {
            if (let some(slot) = instanceFieldIndex(em, cc, name)) {
                var fieldTy = fieldAt(em, cc, slot).ty
                var v = fieldRead(em, e.span, obj, fieldTy, slot)
                if (let some(v) = v) {
                    return OptMemberVal(fieldTy, v)
                }
                return none
            }
            if (let some(fid) = em.propertyIds.get(tripleKey(str(cc), name, str(false)))) {
                var pty = propertyTyOf(em, cname, name)
                var v = callMethod(em, e, fid, emptyCallArgs(), obj)
                if (let some(v) = v) {
                    return OptMemberVal(pty, v)
                }
                return none
            }
        }
        bad(em, e.span, "no field or property `" + name + "` for optional access")
        none
    }

    /// The declared type of property `name` on class `cname`.
fn propertyTyOf(em: Emitter, cname: string, name: string) -> Ty {
        if (let some(entry) = em.resolved.types.get(cname)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    for (p in t.properties) {
                        if (p.name == name) {
                            return p.ty
                        }
                    }
                    return Ty.Unknown
                }
                case TypeTableEntry.Struct(t) -> {
                    for (p in t.properties) {
                        if (p.name == name) {
                            return p.ty
                        }
                    }
                    return Ty.Unknown
                }
                case _ -> {}
            }
        }
        Ty.Unknown
    }

    // ---- unary / binary / logic / casts / assigns --------------------------

    /// The class id of a non-generic `Ty::Class(n, [])`, or `none` when `ty`
    /// is not such a type (mirrors `user_class_id`).
fn userClassId(em: Emitter, ty: Ty) -> UserClassRef? {
        match (ty) {
            case Ty.Class(n, args) -> {
                if (len(args) == 0) {
                    var cidO = em.classByName.get(n)
                    if (let some(cid) = cidO) {
                        return UserClassRef(n, cid)
                    }
                }
                none
            }
            case _ -> none
        }
    }

    /// An ASCII `char` literal re-read as the `int` it represents, or `none`
    /// for anything else. Used so a `byte` compared against an ASCII `char`
    /// literal shares the `i64` ABI (mirrors the `ascii_lit_int` closure).
fn asciiLitInt(em: Emitter, x: Expr) -> int? {
        match (x.kind) {
            case ExprKind.Lit(Lit.Char(c)) -> {
                if ((c as int) <= 0x7F) {
                    return intConst(em, c as int)
                }
                none
            }
            case _ -> none
        }
    }

    /// `-x` / `~x` / `!x` / `*p` / `&x`. Mirrors `unary` in emit.rs.
fn unary(em: Emitter, e: Expr, op: UnOp, operand: Expr) -> int? {
        match (op) {
            case UnOp.Neg | UnOp.BitNot -> {
                var v = expr(em, operand)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dst = temp(em)
                if (op == UnOp.Neg) {
                    instr(em, IrInstr.UnOp(dst, IrUnOp.Neg, vId))
                } else {
                    instr(em, IrInstr.UnOp(dst, IrUnOp.BitNot, vId))
                }
                dst
            }
            case UnOp.Not -> {
                var v = expr(em, operand)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dst = temp(em)
                instr(em, IrInstr.UnOp(dst, IrUnOp.Not, vId))
                dst
            }
            case UnOp.Deref -> {
                var scalar: IrTy? = none
                if (let some(t) = tyOf(em, operand.span)) {
                    match (t) {
                        case Ty.Ptr(pr) -> scalar = scalarIr(pr)
                        case Ty.Ref(pr) -> scalar = scalarIr(pr)
                        case _ -> {}
                    }
                }
                if (let some(ty) = scalar) {
                    var addr = expr(em, operand)
                    if (let none = addr) {
                        return none
                    }
                    var addrId = 0
                    if (let some(aa) = addr) {
                        addrId = aa
                    }
                    var dst = temp(em)
                    instr(em, IrInstr.LoadRaw(dst, addrId, ty))
                    return dst
                }
                expr(em, operand)
            }
            case UnOp.AddrOf -> {
                var t = tyOf(em, operand.span)
                var tScalar = false
                if (let some(tt) = t) {
                    if (let some(_) = scalarIr(tt)) {
                        tScalar = true
                    }
                }
                if (tScalar) {
                    var nameO = exprKindIdentName(operand)
                    if (let none = nameO) {
                        bad(em, e.span, "`&` of a scalar requires a local variable")
                        return none
                    }
                    var name = ""
                    if (let some(n) = nameO) {
                        name = n
                    }
                    var slotO = lookup(em, name)
                    if (let some(s) = slotO) {
                        var dst = temp(em)
                        instr(em, IrInstr.LocalAddr(dst, s))
                        return dst
                    }
                    // A top-level `var` is addressable too: the cell lives in the
                    // image's `.data`, so `&g` is the address of that symbol and a
                    // write through it lands in the global, not a copy. This is
                    // what lets a ported runtime pass a mutable cell to an extern
                    // (e.g. a per-thread frame head) instead of returning a value.
                    if (em.globalIds.has(name)) {
                        var gidO = em.globalIds.get(name)
                        if (let some(gid) = gidO) {
                            var dst2 = temp(em)
                            instr(em, IrInstr.GlobalAddr(dst2, gid))
                            return dst2
                        }
                    }
                    bad(em, e.span, "`&` of an unknown local")
                    return none
                }
                var ok = false
                if (let some(tt) = t) {
                    match (tt) {
                        case Ty.Class(_, _) -> ok = true
                        case Ty.Struct(_, _) -> ok = true
                        case Ty.Ptr(_) -> ok = true
                        // The checker already types `&str` as `*string`
                        // (see `check.pkl`), so the emitter has to lower it
                        // the same way: the value *is* the object pointer.
                        case Ty.String -> ok = true
                        case _ -> {}
                    }
                }
                if (ok) {
                    return expr(em, operand)
                }
                bad(em, e.span, "`&` currently only supports class, struct, pointer, and scalar local variables")
                none
            }
        }
    }

    /// Binary arithmetic/comparison/boolean expressions. Mirrors `binary` in
    /// emit.rs (order matters: string/enum special cases first, then the Itof
    /// promotion pair, then the ASCII-byte trick, then the defensive check).
fn binary(em: Emitter, e: Expr, op: BinOp, lhs: Expr, rhs: Expr) -> int? {
        var lt = tyOf(em, lhs.span)
        var rt = tyOf(em, rhs.span)
        var bothStr = false
        if (let some(l) = lt) {
            if (let some(r) = rt) {
                if (l == Ty.String && r == Ty.String) {
                    bothStr = true
                }
            }
        }
        var bothEnum = false
        if (let some(l) = lt) {
            match (l) {
                case Ty.Enum(_, _) -> {
                    if (let some(r) = rt) {
                        match (r) {
                            case Ty.Enum(_, _) -> bothEnum = true
                            case _ -> {}
                        }
                    }
                }
                case _ -> {}
            }
        }
        match (op) {
            case BinOp.And | BinOp.Or -> {
                return logic(em, e, op, lhs, rhs)
            }
            case BinOp.NullCoalesce -> {
                return nullCoalesce(em, e, lhs, rhs)
            }
case BinOp.Range | BinOp.RangeIncl -> {
                if (!ensureInt(em, lhs)) {
                    return none
                }
                if (!ensureInt(em, rhs)) {
                    return none
                }
                var start = expr(em, lhs)
                if (let none = start) {
                    return none
                }
                var end = expr(em, rhs)
                if (let none = end) {
                    return none
                }
                var startV = 0
                if (let some(v) = start) {
                    startV = v
                }
                var endV = 0
                if (let some(v) = end) {
                    endV = v
                }
                var one = intConst(em, 1)
                if (op == BinOp.Range) {
                    return externCallT1(em, "pickle_range", [IrTy.Int, IrTy.Int, IrTy.Int], IrTy.Ptr, [startV, endV, one])
                }
                var end1 = temp(em)
                instr(em, IrInstr.BinOp(end1, IrBinOp.Add, endV, one))
                return externCallT1(em, "pickle_range", [IrTy.Int, IrTy.Int, IrTy.Int], IrTy.Ptr, [startV, end1, one])
            }
            case BinOp.Pow -> {
                return emitPow(em, e, lhs, rhs)
            }
            case BinOp.In -> {
                return emitIn(em, e, lhs, rhs)
            }
            case BinOp.Send -> {
                return emitSend(em, lhs, rhs)
            }
            case BinOp.Is -> {
                bad(em, e.span, "the `is` operator is not lowered yet")
                return none
            }
            case BinOp.Add -> {
                if (bothStr) {
                    var a = expr(em, lhs)
                    if (let none = a) {
                        return none
                    }
                    var b = expr(em, rhs)
                    if (let none = b) {
                        return none
                    }
                    var aId = 0
                    if (let some(v) = a) {
                        aId = v
                    }
                    var bId = 0
                    if (let some(v) = b) {
                        bId = v
                    }
                    return externCallT1(em, "pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [aId, bId])
                }
            }
            case BinOp.Eq | BinOp.Ne -> {
                if (bothStr) {
                    var a = expr(em, lhs)
                    if (let none = a) {
                        return none
                    }
                    var b = expr(em, rhs)
                    if (let none = b) {
                        return none
                    }
                    var aId = 0
                    if (let some(v) = a) {
                        aId = v
                    }
                    var bId = 0
                    if (let some(v) = b) {
                        bId = v
                    }
                    var cmp = externCallT1(em, "pickle_str_cmp", [IrTy.Str, IrTy.Str], IrTy.Int, [aId, bId])
                    var zero = temp(em)
                    instr(em, IrInstr.Const(zero, IrConst.Int(0)))
                    var dst = temp(em)
                    var eqOp = IrBinOp.Eq
                    if (op == BinOp.Ne) {
                        eqOp = IrBinOp.Ne
                    }
                    instr(em, IrInstr.BinOp(dst, eqOp, cmp, zero))
                    return dst
                }
                if (bothEnum) {
                    var a = expr(em, lhs)
                    if (let none = a) {
                        return none
                    }
                    var b = expr(em, rhs)
                    if (let none = b) {
                        return none
                    }
                    var aId = 0
                    if (let some(v) = a) {
                        aId = v
                    }
                    var bId = 0
                    if (let some(v) = b) {
                        bId = v
                    }
                    var eq = externCallT1(em, "pickle_enum_eq", [IrTy.Ptr, IrTy.Ptr], IrTy.Bool, [aId, bId])
                    if (op == BinOp.Eq) {
                        return eq
                    }
                    var dst = temp(em)
                    instr(em, IrInstr.UnOp(dst, IrUnOp.Not, eq))
                    return dst
                }
            }
            case _ -> {}
        }
        var a = expr(em, lhs)
        if (let none = a) {
            return none
        }
        var b = expr(em, rhs)
        if (let none = b) {
            return none
        }
        var aId = 0
        if (let some(v) = a) {
            aId = v
        }
        var bId = 0
        if (let some(v) = b) {
            bId = v
        }
        var aty = irty(em, lhs.span)
        var bty = irty(em, rhs.span)
        var aFloat = false
        var bInt = false
        if (let some(t) = aty) {
            if (t == IrTy.Float) {
                aFloat = true
            }
        }
        if (let some(t) = bty) {
            if (t == IrTy.Int) {
                bInt = true
            }
        }
        if (aFloat && bInt) {
            var t = temp(em)
            instr(em, IrInstr.Itof(t, bId))
            bId = t
        } else {
            var aInt = false
            var bFloat = false
            if (let some(t) = aty) {
                if (t == IrTy.Int) {
                    aInt = true
                }
            }
            if (let some(t) = bty) {
                if (t == IrTy.Float) {
                    bFloat = true
                }
            }
            if (aInt && bFloat) {
                var t = temp(em)
                instr(em, IrInstr.Itof(t, aId))
                aId = t
            }
        }
        var aByte = false
        if (let some(t) = lt) {
            if (t == Ty.Byte) {
                aByte = true
            }
        }
        var bByte = false
        if (let some(t) = rt) {
            if (t == Ty.Byte) {
                bByte = true
            }
        }
        if (aByte || bByte) {
            if (aByte) {
                var asciiB = asciiLitInt(em, rhs)
                if (let some(t) = asciiB) {
                    bId = t
                    bty = IrTy.Int
                }
            } else {
                var asciiA = asciiLitInt(em, lhs)
                if (let some(t) = asciiA) {
                    aId = t
                    aty = IrTy.Int
                }
            }
        }
        var isCmp = false
        match (op) {
            case BinOp.Lt | BinOp.Le | BinOp.Gt | BinOp.Ge | BinOp.Eq | BinOp.Ne -> isCmp = true
            case _ -> {}
        }
        if (isCmp) {
            var aTag = -1
            var bTag = -1
            if (let some(t) = aty) {
                aTag = irTyTag(t)
            }
            if (let some(t) = bty) {
                bTag = irTyTag(t)
            }
            if (!cmpTypesCompatible(aTag, bTag)) {
                bad(em, e.span, "comparison `" + binOpName(op) + "` with incompatible operand types is not lowered yet")
                return none
            }
        }
        var dst = temp(em)
        instr(em, IrInstr.BinOp(dst, binaryOpcode(op), aId, bId))
        dst
    }

    /// Short-circuit `&&` / `||` through a result slot. Mirrors `logic` in
    /// emit.rs.
fn logic(em: Emitter, e: Expr, op: BinOp, lhs: Expr, rhs: Expr) -> int? {
        var res = newSlot(em, IrTy.Bool)
        var isAnd = op == BinOp.And
        var a = expr(em, lhs)
        if (let none = a) {
            return none
        }
        var aId = 0
        if (let some(v) = a) {
            aId = v
        }
        var rhsId = newBlock(em)
        var shortId = newBlock(em)
        var join = newBlock(em)
        if (isAnd) {
            term(em, IrTerm.BranchIf(aId, rhsId, shortId))
        } else {
            term(em, IrTerm.BranchIf(aId, shortId, rhsId))
        }
        em.cur = rhsId
        var b = expr(em, rhs)
        if (let none = b) {
            return none
        }
        var bId = 0
        if (let some(v) = b) {
            bId = v
        }
        instr(em, IrInstr.StoreSlot(res, bId))
        term(em, IrTerm.Branch(join))
        em.cur = shortId
        var sv = temp(em)
        instr(em, IrInstr.Const(sv, IrConst.Bool(!isAnd)))
        instr(em, IrInstr.StoreSlot(res, sv))
        term(em, IrTerm.Branch(join))
        em.cur = join
        load(em, res)
    }

    /// Combine two boolean temps (`&&` when `isAnd`, otherwise `||`) into one
    /// `Bool` temp. Mirrors `combine_cond` in emit.rs.
fn combineCond(em: Emitter, isAnd: bool, a: int, b: int) -> int {
        var res = newSlot(em, IrTy.Bool)
        var rhsId = newBlock(em)
        var shortId = newBlock(em)
        var join = newBlock(em)
        if (isAnd) {
            term(em, IrTerm.BranchIf(a, rhsId, shortId))
        } else {
            term(em, IrTerm.BranchIf(a, shortId, rhsId))
        }
        em.cur = rhsId
        instr(em, IrInstr.StoreSlot(res, b))
        term(em, IrTerm.Branch(join))
        em.cur = shortId
        var sv = temp(em)
        instr(em, IrInstr.Const(sv, IrConst.Bool(!isAnd)))
        instr(em, IrInstr.StoreSlot(res, sv))
        term(em, IrTerm.Branch(join))
        em.cur = join
        load(em, res)
    }

    // ---- casts ----

    /// `x is T` / `x as T` / `x as? T`. The result stays in the typed IR value
    /// domain: `is` -> bool, `as` -> `T`, `as?` -> `T?` (a pointer). Mirrors
    /// `cast` in emit.rs.
fn cast(em: Emitter, e: Expr, operand: Expr, ty: TypeExpr, kind: CastKind) -> int? {
        var src = Ty.Unknown
        if (let some(t) = tyOf(em, operand.span)) {
            src = t
        }
        var dst = em.resolved.resolveTy(ty, emptyStrs(), em.diags)
        match (kind) {
            case CastKind.Is -> castIs(em, e, operand, src, dst)
            case CastKind.As -> castAs(em, e, operand, src, dst)
            case CastKind.TryAs -> {
                var v = expr(em, operand)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var inner = dst
                if (let some(i) = innerOption(dst)) {
                    inner = i
                }
                castToOption(em, e.span, vId, src, inner)
            }
        }
    }

    /// `x is T`: compare underlying (option-stripped) types. Mirrors `cast_is`.
fn castIs(em: Emitter, e: Expr, operand: Expr, src: Ty, dst: Ty) -> int? {
        var srcOpt = innerOption(src)
        var dstOpt = innerOption(dst)
        var baseSrc = src
        var baseDst = dst
        if (let some(s) = srcOpt) {
            baseSrc = s
        }
        if (let some(d) = dstOpt) {
            baseDst = d
        }
        var v = expr(em, operand)
        if (let none = v) {
            return none
        }
        var vId = 0
        if (let some(vv) = v) {
            vId = vv
        }
        if (tyEq(baseSrc, baseDst)) {
            var srcIsOpt = true
            var dstIsOpt = true
            if (let none = srcOpt) {
                srcIsOpt = false
            }
            if (let none = dstOpt) {
                dstIsOpt = false
            }
            if (srcIsOpt && !dstIsOpt) {
                return optIsPresent(em, vId)
            }
            return boolConst(em, true)
        }
        if (isNumeric(baseSrc) && isNumeric(baseDst)) {
            return boolConst(em, false)
        }
        var srcRef = userClassId(em, baseSrc)
        var dstRef = userClassId(em, baseDst)
        if (let some(sr) = srcRef) {
            if (let some(dr) = dstRef) {
                if (isAncestor(em, dr.name, sr.name)) {
                    return boolConst(em, true)
                }
                if (isAncestor(em, sr.name, dr.name)) {
                    var dc = intConst(em, dr.id)
                    return externCallT1(em, "pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [vId, dc])
                }
                return boolConst(em, false)
            }
        }
        var dstIf = ifaceOf(baseDst)
        if (let some(di) = dstIf) {
            var ifaceId = ifaceIdFor(em, di.name, di.args, e.span)
            if (let some(id) = ifaceId) {
                var dc = intConst(em, id)
                return externCallT1(em, "pickle_class_implements", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [vId, dc])
            }
            return none
        }
        if (let some(_) = ifaceOf(baseSrc)) {
            var dRef = userClassId(em, baseDst)
            if (let none = dRef) {
                bad(em, e.span, "`" + bareName(src) + " is " + bareName(dst) + "` is not lowered yet")
                return none
            }
            var drId = 0
            if (let some(dr2) = dRef) {
                drId = dr2.id
            }
            var dc = intConst(em, drId)
            return externCallT1(em, "pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [vId, dc])
        }
        bad(em, e.span, "`" + bareName(src) + " is " + bareName(dst) + "` is not lowered yet (class/interface tests need inheritance)")
        none
    }

    /// `x as T`: unpreserving, but `T?` targets never panic. Mirrors `cast_as`.
fn castAs(em: Emitter, e: Expr, operand: Expr, src: Ty, dst: Ty) -> int? {
        var v = expr(em, operand)
        if (let none = v) {
            return none
        }
        var vId = 0
        if (let some(vv) = v) {
            vId = vv
        }
        if (let some(inner) = innerOption(dst)) {
            return castToOption(em, e.span, vId, src, inner)
        }
        if (let some(si) = innerOption(src)) {
            var ival = optUnwrapVal(em, e.span, vId, si)
            if (let none = ival) {
                return none
            }
            var iv = 0
            if (let some(ivv) = ival) {
                iv = ivv
            }
            return convert(em, e.span, iv, si, dst)
        }
        convert(em, e.span, vId, src, dst)
    }

    /// Produce the option `inner?` from an already-evaluated `v` of type `src`.
    /// A managed source passes through; scalars are boxed. When `src` is itself
    /// an option, `none` is preserved and the present value is converted.
    /// Mirrors `cast_to_option`.
fn castToOption(em: Emitter, span: Span, v: int, src: Ty, inner: Ty) -> int? {
        if (let some(si) = innerOption(src)) {
            if (tyEq(si, inner)) {
                return v
            }
            if (!(isNumeric(si) && isNumeric(inner))) {
                bad(em, span, "`" + bareName(src) + " as? " + bareName(inner) + "` is not lowered yet")
                return none
            }
            var resSlot = newSlot(em, IrTy.Ptr)
            var present = optIsPresent(em, v)
            if (let none = present) {
                return none
            }
            var presentId = 0
            if (let some(p) = present) {
                presentId = p
            }
            var someId = newBlock(em)
            var noneId = newBlock(em)
            var join = newBlock(em)
            term(em, IrTerm.BranchIf(presentId, someId, noneId))
            em.cur = noneId
            var n = nullTemp(em)
            if (let none = n) {
                return none
            }
            var nId = 0
            if (let some(nn) = n) {
                nId = nn
            }
            instr(em, IrInstr.StoreSlot(resSlot, nId))
            term(em, IrTerm.Branch(join))
            em.cur = someId
            var iv = optResolve(em, v, si, span)
            if (let none = iv) {
                return none
            }
            var ivId = 0
            if (let some(ivv) = iv) {
                ivId = ivv
            }
            var cv = convert(em, span, ivId, si, inner)
            if (let none = cv) {
                return none
            }
            var cvId = 0
            if (let some(c) = cv) {
                cvId = c
            }
            var wrapped = optionWrap(em, cvId, inner, span)
            if (let none = wrapped) {
                return none
            }
            var wId = 0
            if (let some(w) = wrapped) {
                wId = w
            }
            instr(em, IrInstr.StoreSlot(resSlot, wId))
            term(em, IrTerm.Branch(join))
            em.cur = join
            return load(em, resSlot)
        }
        var cv = convert(em, span, v, src, inner)
        if (let none = cv) {
            return none
        }
        var cvId = 0
        if (let some(c) = cv) {
            cvId = c
        }
        optionWrap(em, cvId, inner, span)
    }

    /// Convert a non-option value between related (non-option) types. Identity
    /// and numeric conversions are supported; anything else bails. Mirrors
    /// `convert` in emit.rs.
fn convert(em: Emitter, span: Span, v: int, src: Ty, to: Ty) -> int? {
if (tyEq(src, to)) {
                  return v
              }
              // `*T` and `int` are the same machine word. `castRelated` allows the
              // pair so container ABI bodies can store an object address in a word
              // slot; the move is a plain register copy, with no trap value and no
              // new representation.
              if ((isPtr(src) && to == Ty.Int) || (src == Ty.Int && isPtr(to))) {
                  return v
              }
              // A function value is a raw 64-bit code address in the IR domain
              // - the same word `IrConst::FuncAddr` bakes into
              // `pickle_class_register` calls. Moving the word between an `fn`
              // value and an `int` slot is a plain register copy; the GC engine
              // stores `deinit` addresses as int words and casts them back to
              // callables only at invocation.
              if ((isFnValue(src) && to == Ty.Int) || (src == Ty.Int && isFnValue(to))) {
                  return v
              }
        if (isNumeric(src) && isNumeric(to)) {
            if ((src == Ty.Int || src == Ty.Byte) && (to == Ty.Int || to == Ty.Byte)) {
                return v
            }
            if (src == Ty.Int && to == Ty.Float) {
                var dst = temp(em)
                instr(em, IrInstr.Itof(dst, v))
                return dst
            }
            if (src == Ty.Float && to == Ty.Int) {
                var dst = temp(em)
                instr(em, IrInstr.Ftoi(dst, v))
                return dst
            }
            bad(em, span, "cannot cast `" + bareName(src) + "` to `" + bareName(to) + "`")
            return none
        }
        if (src == Ty.Char && (to == Ty.Int || to == Ty.Byte)) {
            var dst = temp(em)
            instr(em, IrInstr.Chartoi(dst, v))
            return dst
        }
        if ((src == Ty.Int || src == Ty.Byte) && to == Ty.Char) {
            var dst = temp(em)
            instr(em, IrInstr.Itochar(dst, v))
            return dst
        }
        var fromRef = userClassId(em, src)
        var toRef = userClassId(em, to)
        if (let some(fr) = fromRef) {
            if (let some(tr) = toRef) {
                if (isAncestor(em, tr.name, fr.name)) {
                    return v
                }
                var dc = intConst(em, tr.id)
                return externCallT1(em, "pickle_class_cast", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [v, dc])
            }
        }
        var toIf = ifaceOf(to)
        if (let some(ti) = toIf) {
            var ifaceId = ifaceIdFor(em, ti.name, ti.args, span)
            if (let some(id) = ifaceId) {
                var dc = intConst(em, id)
                return externCallT1(em, "pickle_iface_cast", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [v, dc])
            }
            return none
        }
        if (let some(_) = ifaceOf(src)) {
            var toCid = userClassId(em, to)
            if (let none = toCid) {
                bad(em, span, "`" + bareName(src) + " as " + bareName(to) + "` is not lowered yet")
                return none
            }
            var tcId = 0
            if (let some(tc) = toCid) {
                tcId = tc.id
            }
            var dc = intConst(em, tcId)
            return externCallT1(em, "pickle_class_cast", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [v, dc])
        }
        bad(em, span, "`" + bareName(src) + " as " + bareName(to) + "` is not lowered yet (class/interface casts need inheritance)")
        none
    }

    // ---- assignments ----

    /// `target = value`, `target op= value`, `*p = value`, `xs[i] ... = value`,
    /// `obj.field ... = value`. Mirrors `assign` in emit.rs.
fn assign(em: Emitter, e: Expr, target: Expr, op: AssignOp, value: Expr) -> int? {
        var span = target.span
        var derefOperand: Expr? = none
        match (target.kind) {
            case ExprKind.Unary(UnOp.Deref, operand) -> derefOperand = operand
            case _ -> {}
        }
if (let some(operand) = derefOperand) {
            var pt = Ty.Unknown
            if (let some(t) = tyOf(em, operand.span)) {
                pt = t
            }
            var scalar: IrTy? = none
            match (pt) {
                case Ty.Ptr(pr) -> scalar = scalarIr(pr)
                case _ -> {}
            }
            if (let some(ty) = scalar) {
                var addr = expr(em, operand)
                if (let none = addr) {
                    return none
                }
                var addrId = 0
                if (let some(aa) = addr) {
                    addrId = aa
                }
                if (op == AssignOp.Assign) {
                    var v = expr(em, value)
                    if (let none = v) {
                        return none
                    }
                    var vId = 0
                    if (let some(vv) = v) {
                        vId = vv
                    }
                    instr(em, IrInstr.StoreRaw(addrId, vId, ty))
                    return vId
                }
                // `*p op= v`: read-modify-write on the dereferenced cell.
                var cur = temp(em)
                instr(em, IrInstr.LoadRaw(cur, addrId, ty))
                var v = expr(em, value)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dst = temp(em)
                instr(em, IrInstr.BinOp(dst, assignOpcode(op), cur, vId))
                instr(em, IrInstr.StoreRaw(addrId, dst, ty))
                return dst
            }
            if (op != AssignOp.Assign) {
                bad(em, span, "compound assignment through a raw pointer is not lowered yet")
                return none
            }
            match (pt) {
                case Ty.Class(_, _) -> {
                    return assign(em, e, operand, op, value)
                }
                case Ty.Struct(_, _) -> {
                    return assign(em, e, operand, op, value)
                }
                case Ty.Ptr(_) -> {
                    return assign(em, e, operand, op, value)
                }
                case Ty.Ref(_) -> {
                    bad(em, span, "cannot write through an immutable reference (`&T`)")
                    return none
                }
                case _ -> {
                    bad(em, span, "assignment through a raw pointer is only supported for class, struct, pointer, and scalar values")
                    return none
                }
            }
        }
        match (target.kind) {
            case ExprKind.Index(object, index) -> {
                return indexAssign(em, e, op, object, index, value)
            }
            case _ -> {}
        }
        match (target.kind) {
            case ExprKind.Member(object, name) -> {
                return memberAssign(em, e, op, object, name, value)
            }
            case _ -> {}
        }
        var name = ""
        match (target.kind) {
            case ExprKind.Ident(n) -> name = n
            case _ -> {
                bad(em, span, "assignment targets other than names are not lowered yet")
                return none
            }
        }
        var v = expr(em, value)
        if (let none = v) {
            return none
        }
        var vId = 0
        if (let some(vv) = v) {
            vId = vv
        }
        var vt = Ty.Unknown
        if (let some(t) = tyOf(em, value.span)) {
            vt = t
        }
        var slotO = lookup(em, name)
        if (let some(slot) = slotO) {
            if (op == AssignOp.Assign) {
                var sv = vId
                if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                    var w = optionWrap(em, vId, vt, value.span)
                    if (let none = w) {
                        return none
                    }
                    if (let some(wv) = w) {
                        sv = wv
                    }
                }
                instr(em, IrInstr.StoreSlot(slot, sv))
                return vId
            }
            var cur = load(em, slot)
            var dst = 0
            if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Str)) {
                dst = externCallT1(em, "pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [cur, vId])
            } else {
                var t = temp(em)
                instr(em, IrInstr.BinOp(t, assignOpcode(op), cur, vId))
                dst = t
            }
            instr(em, IrInstr.StoreSlot(slot, dst))
            return dst
        }
        // A top-level `var` write goes to the data symbol. Compound forms
        // are read-modify-write against the slot, so `g += 1` is a load then
        // a store, never a blind store of `v`.
        if (em.globalIds.has(name)) {
            var gid: int? = none
            gid = em.globalIds[name]
            if (let some(id) = gid) {
                var ty = em.irModule.globals[id].ty
                var stored = vId
                if (op != AssignOp.Assign) {
                    var cur = temp(em)
                    instr(em, IrInstr.LoadGlobal(cur, id, ty))
                    if (irTyTag(ty) == irTyTag(IrTy.Str)) {
                        var cc = externCallT1(em, "pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [cur, vId])
                        stored = cc
                    } else {
                        var t = temp(em)
                        instr(em, IrInstr.BinOp(t, assignOpcode(op), cur, vId))
                        stored = t
                    }
                }
                instr(em, IrInstr.StoreGlobal(id, stored, ty))
                return stored
            }
        }
        if (let some(cid) = em.owner) {
            var idxO = instanceFieldIndex(em, cid, name)
            if (let some(idx) = idxO) {
                var fieldTy = fieldAt(em, cid, idx).ty
                var owned = fieldAt(em, cid, idx).manual
                var thO = thisValue(em, e)
                if (let none = thO) {
                    return none
                }
                var th = 0
                if (let some(thv) = thO) {
                    th = thv
                }
                return fieldAssign(em, e.span, op, th, fieldTy, idx, vId, vt, owned)
            }
            var sfo = staticField(em, cid, name)
            if (let some(sf) = sfo) {
                if (!sf.info.mutable) {
                    bad(em, span, "cannot assign to immutable static field `" + name + "`")
                    return none
                }
                return staticAssign(em, span, op, sf.dcid, sf.slot, sf.info.ty, vId, vt)
            }
        }
bad(em, span, "cannot assign to `" + name + "`")
        none
    }

/// `obj.field` and `obj.field op= value` on class/struct instances.
    /// Mirrors `member_assign` in emit.rs.
fn tyDbg(em: Emitter, t: Ty?) -> string {
        var out = "<none>"
        if (let some(tt) = t) {
            match (tt) {
                case Ty.Ptr(pr) -> out = "<ptr:" + tyDbg(em, pr) + ">"
                case Ty.Class(n, a) -> out = "<class:" + n + ":" + str(len(a)) + ">"
                case Ty.Struct(n, a) -> out = "<struct:" + n + ":" + str(len(a)) + ">"
                case Ty.Var(n) -> out = "<var:" + n + ">"
                case _ -> out = "<other>"
            }
        }
        out
    }

fn memberAssign(em: Emitter, e: Expr, op: AssignOp, object: Expr, name: string, value: Expr) -> int? {
        // `Type.staticProperty = v` dispatches the receiver-less setter.
        var tname = ""
        var isType = false
        match (object.kind) {
            case ExprKind.Ident(n) -> {
                tname = n
                isType = true
            }
            case _ -> {}
        }
        if (isType) {
            var cidO = em.classByName.get(tname)
            if (let some(cid) = cidO) {
var fidO = em.staticPropertyIds.get(tripleKey(str(cid), name, str(true)))
                if (let some(fid) = fidO) {
                    if (op != AssignOp.Assign) {
                        // `Type.prop op= value`: read through the getter,
                        // combine, call the setter with the result.
                        var getFidO = em.staticPropertyIds.get(tripleKey(str(cid), name, str(false)))
                        if (let none = getFidO) {
                            bad(em, e.span, "static property `" + name + "` has no getter")
                            return none
                        }
                        var getFid = 0
                        if (let some(g) = getFidO) {
                            getFid = g
                        }
                        var ptyTy = propertyTyOf(em, tname, name)
                        var curO = callMethod(em, e, getFid, emptyCallArgs(), none)
                        if (let none = curO) {
                            return none
                        }
                        var cur = 0
                        if (let some(c) = curO) {
                            cur = c
                        }
                        var v = expr(em, value)
                        if (let none = v) {
                            return none
                        }
                        var vId = 0
                        if (let some(vv) = v) {
                            vId = vv
                        }
                        var dstO = combineCompound(em, e.span, op, ptyTy, cur, vId, "static property")
                        if (let none = dstO) {
                            return none
                        }
                        var dst = 0
                        if (let some(d) = dstO) {
                            dst = d
                        }
                        var packed = dst
                        if (irTyTag(em.irModule.funcs[fid].params[0].ty) == irTyTag(IrTy.Ptr)) {
                            var w = optionWrap(em, dst, ptyTy, value.span)
                            if (let none = w) {
                                return none
                            }
                            if (let some(wv) = w) {
                                packed = wv
                            }
                        }
                            var dsti = temp(em)
                            instr(em, IrInstr.Call(dsti, Callee.Func(fid), [packed]))
                            // `Type.prop = v`: same as the instance case, the setter
                            // is a call that can throw. Nothing reads `dsti` here, but
                            // the pending check still has to fire before the next
                            // statement.
                            guardPropagation(em, fid)
                            return dst
                    }
                    var v = expr(em, value)
                    if (let none = v) {
                        return none
                    }
                    var vId = 0
                    if (let some(vv) = v) {
                        vId = vv
                    }
                    var vt = Ty.Unknown
                    if (let some(t) = tyOf(em, value.span)) {
                        vt = t
                    }
                    var packed = vId
                    if (irTyTag(em.irModule.funcs[fid].params[0].ty) == irTyTag(IrTy.Ptr)) {
                        var w = optionWrap(em, vId, vt, value.span)
                        if (let none = w) {
                            return none
                        }
                        if (let some(wv) = w) {
                            packed = wv
                        }
                    }
                        var dst = temp(em)
                        instr(em, IrInstr.Call(dst, Callee.Func(fid), [packed]))
                        // As with the static setter: a throwing accessor has to
                        // leave before the compound assignment is considered done.
                        guardPropagation(em, fid)
                        return vId
                }
                var sfo = staticField(em, cid, name)
                if (let some(sf) = sfo) {
                    if (!sf.info.mutable) {
                        bad(em, e.span, "cannot assign to immutable static field `" + name + "`")
                        return none
                    }
                    var v = expr(em, value)
                    if (let none = v) {
                        return none
                    }
                    var vId = 0
                    if (let some(vv) = v) {
                        vId = vv
                    }
                    var vt = Ty.Unknown
                    if (let some(t) = tyOf(em, value.span)) {
                        vt = t
                    }
                    return staticAssign(em, e.span, op, sf.dcid, sf.slot, sf.info.ty, vId, vt)
                }
                bad(em, e.span, "`" + tname + "` has no settable static member `" + name + "`")
                return none
            }
        }
var ot = tyOf(em, object.span)
        var o2: Ty? = none
        if (let some(tt) = ot) {
            match (tt) {
                case Ty.Ptr(pr) -> o2 = pr
                case _ -> o2 = tt
            }
        }
        var cidVal = -1
        if (let some(oo) = o2) {
            match (oo) {
                case Ty.Class(_, _) -> {
                    var co = classIdOf(em, oo, e.span)
                    if (let some(c) = co) {
                        cidVal = c
                    }
                }
                case Ty.Struct(_, _) -> {
                    var co = classIdOf(em, oo, e.span)
                    if (let some(c) = co) {
                        cidVal = c
                    }
                }
                case _ -> {}
            }
        }
if (cidVal < 0) {
            bad(em, e.span, "assignment over this member type is not lowered yet")
            return none
        }
        var idxO = instanceFieldIndex(em, cidVal, name)
        if (let some(idx) = idxO) {
            var fieldTy = fieldAt(em, cidVal, idx).ty
            var owned = fieldAt(em, cidVal, idx).manual
            var v = expr(em, value)
            if (let none = v) {
                return none
            }
            var vId = 0
            if (let some(vv) = v) {
                vId = vv
            }
            var vvt = Ty.Unknown
            if (let some(t) = tyOf(em, value.span)) {
                vvt = t
            }
            var obj = expr(em, object)
            if (let none = obj) {
                return none
            }
            var objId = 0
            if (let some(o) = obj) {
                objId = o
            }
            return fieldAssign(em, e.span, op, objId, fieldTy, idx, vId, vvt, owned)
        }
// `obj.prop = value` dispatches the property's setter.
        var fidO = em.propertyIds.get(tripleKey(str(cidVal), name, str(true)))
        if (let some(fid) = fidO) {
            if (op != AssignOp.Assign) {
                // `obj.prop op= value`: read through the getter, combine,
                // call the setter with the result.
                var getFidO = em.propertyIds.get(tripleKey(str(cidVal), name, str(false)))
                if (let none = getFidO) {
                    bad(em, e.span, "property `" + name + "` has no getter")
                    return none
                }
                var getFid = 0
                if (let some(g) = getFidO) {
                    getFid = g
                }
                var obj = expr(em, object)
                if (let none = obj) {
                    return none
                }
                var objId = 0
                if (let some(o) = obj) {
                    objId = o
                }
                var ptyTy = propertyTyOf(em, classOfName(em, cidVal), name)
                var curO = callMethod(em, e, getFid, emptyCallArgs(), objId)
                if (let none = curO) {
                    return none
                }
                var cur = 0
                if (let some(c) = curO) {
                    cur = c
                }
                var v = expr(em, value)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dstO = combineCompound(em, e.span, op, ptyTy, cur, vId, "property")
                if (let none = dstO) {
                    return none
                }
                var dst = 0
                if (let some(d) = dstO) {
                    dst = d
                }
                var packed = dst
                if (irTyTag(em.irModule.funcs[fid].params[1].ty) == irTyTag(IrTy.Ptr)) {
                    var w = optionWrap(em, dst, ptyTy, value.span)
                    if (let none = w) {
                        return none
                    }
                    if (let some(wv) = w) {
                        packed = wv
                    }
                }
                var dsti = temp(em)
                instr(em, IrInstr.Call(dsti, Callee.Func(fid), [objId, packed]))
                // A property setter is a real call: a throwing accessor leaves the
                // flag set, and the assignment's result is meaningless until we
                // have left.
                guardPropagation(em, fid)
                return dst
            }
            var obj = expr(em, object)
            if (let none = obj) {
                return none
            }
            var objId = 0
            if (let some(o) = obj) {
                objId = o
            }
            var v = expr(em, value)
            if (let none = v) {
                return none
            }
            var vId = 0
            if (let some(vv) = v) {
                vId = vv
            }
            var vt = Ty.Unknown
            if (let some(t) = tyOf(em, value.span)) {
                vt = t
            }
            var packed = vId
            if (irTyTag(em.irModule.funcs[fid].params[1].ty) == irTyTag(IrTy.Ptr)) {
                var w = optionWrap(em, vId, vt, value.span)
                if (let none = w) {
                    return none
                }
                if (let some(wv) = w) {
                    packed = wv
                }
            }
            var dst = temp(em)
            instr(em, IrInstr.Call(dst, Callee.Func(fid), [objId, packed]))
            // Same for the compound form: the read-modify-write calls a setter,
            // which is where the read-modify-write result comes back through.
            guardPropagation(em, fid)
            return vId
        }
        bad(em, e.span, "`" + name + "` is not a field or settable property of this `" + classOfName(em, cidVal) + "`")
        none
    }

    /// Read-modify-write/plain store of one field slot. Mirrors `field_assign`.
fn fieldAssign(em: Emitter, span: Span, op: AssignOp, obj: int, fieldTy: Ty, slot: int, v: int, vt: Ty, owned: bool) -> int? {
        var repO = elemRep(em, fieldTy, span)
        if (let none = repO) {
            return none
        }
        var rep = ElemRep.ptr()
        if (let some(r) = repO) {
            rep = r
        }
        if (op == AssignOp.Assign) {
            if (owned) {
                var idxc = intConst(em, slot)
                var old = externCallT1(em, "pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idxc])
                var vOwn = externCallT1(em, "pickle_manual_adopt", [IrTy.Ptr], IrTy.Ptr, [v])
                var packed = packForPointerBoundary(em, rep, vOwn, vt, span)
                if (let none = packed) {
                    return none
                }
                var packedId = 0
                if (let some(p) = packed) {
                    packedId = p
                }
                var boxed = boxForStore(em, rep, packedId, elemIr(fieldTy))
                var storeId = 0
                if (let some(b) = boxed) {
                    storeId = b
                } else {
                    return none
                }
                fieldStore(em, obj, slot, fieldTy, storeId)
                externCallVoid(em, "pickle_manual_free", [IrTy.Ptr], [old])
                return vOwn
            }
            var packed = packForPointerBoundary(em, rep, v, vt, span)
            if (let none = packed) {
                return none
            }
            var packedId = 0
            if (let some(p) = packed) {
                packedId = p
            }
            var boxed = boxForStore(em, rep, packedId, elemIr(fieldTy))
            var storeId = 0
            if (let some(b) = boxed) {
                storeId = b
            } else {
                return none
            }
            fieldStore(em, obj, slot, fieldTy, storeId)
            return v
        }
if (rep.isPtr) {
            if (fieldTy != Ty.String) {
                bad(em, span, "compound assignment to a non-scalar field is not lowered yet")
                return none
            }
            // String field: read the current string, concatenate, store back.
            var idxc = intConst(em, slot)
            var cur = externCallT1(em, "pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idxc])
            var dstO = combineCompound(em, span, op, fieldTy, cur, v, "field")
            if (let none = dstO) {
                return none
            }
            var dst = 0
            if (let some(d) = dstO) {
                dst = d
            }
            var boxed = boxForStore(em, rep, dst, elemIr(fieldTy))
            var storeId = 0
            if (let some(b) = boxed) {
                storeId = b
            } else {
                return none
            }
            fieldStore(em, obj, slot, fieldTy, storeId)
            return dst
        }
        var idxc = intConst(em, slot)
        var raw = externCallT1(em, "pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idxc])
        var cur = externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
        var dst = temp(em)
        instr(em, IrInstr.BinOp(dst, assignOpcode(op), cur, v))
        var boxed = boxForStore(em, rep, dst, elemIr(fieldTy))
        var storeId = 0
        if (let some(b) = boxed) {
            storeId = b
        } else {
            return none
        }
        fieldStore(em, obj, slot, fieldTy, storeId)
        dst
    }

/// Emit `pickle_obj_slot_set(obj, slot, boxed)`. Mirrors `field_store`.
fn fieldStore(em: Emitter, obj: int, slot: int, fieldTy: Ty, boxed: int) {
        var idx = intConst(em, slot)
        externCallVoid(em, "pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, idx, boxed])
        let _ = fieldTy
    }

    /// Combine the current value `cur` of a compound-assignment target with the
    /// RHS `v` for operator `op`, where the target's declared type is `ty`.
    /// Scalar targets use the arithmetic binary op; `string` targets
    /// concatenate (`pickle_str_concat`), gated on `+=` because the checker
    /// does not validate compound operators, so any other operator on a string
    /// bails instead of being silently interpreted as concatenation. Other
    /// pointer-shape targets (`Option`, `List`, class instances, ...) have no
    /// compound operator and keep bailing. `what` names the target for the
    /// not-lowered diagnostic. Mirrors `combine_compound` in emit.rs.
fn combineCompound(em: Emitter, span: Span, op: AssignOp, ty: Ty, cur: int, v: int, what: string) -> int? {
        match (ty) {
            case Ty.String -> {
                if (op != AssignOp.Add) {
                    bad(em, span, "compound assignment on this string only supports `+=`")
                    return none
                }
                return externCallT1(em, "pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [cur, v])
            }
            case _ -> {}
        }
        var scalar = scalarIr(ty)
        if (let some(_) = scalar) {
            var dst = temp(em)
            instr(em, IrInstr.BinOp(dst, assignOpcode(op), cur, v))
            return dst
        }
        bad(em, span, "compound assignment to a non-scalar " + what + " is not lowered yet")
        none
    }

    /// Declared info of the static field at static slot `slot` of class `cid`.
    /// Mirrors `static_field_at`.
fn staticFieldAt(em: Emitter, cid: int, slot: int) -> FieldInfo? {
        for (p in em.classes) {
            if (p.classId == cid) {
                var count = 0
                for (f in p.table.fields) {
                    if (f.isStatic) {
                        if (count == slot) {
                            return f
                        }
                        count = count + 1
                    }
                }
                return none
            }
        }
        none
    }

    /// Plain or compound (`op=`) store of one static field cell. Mirrors
    /// `static_assign`.
fn staticAssign(em: Emitter, span: Span, op: AssignOp, cid: int, slot: int, fieldTy: Ty, v: int, vt: Ty) -> int? {
        var repO = elemRep(em, fieldTy, span)
        if (let none = repO) {
            return none
        }
        var rep = ElemRep.ptr()
        if (let some(r) = repO) {
            rep = r
        }
        if (op == AssignOp.Assign) {
            var packed = packForPointerBoundary(em, rep, v, vt, span)
            if (let none = packed) {
                return none
            }
            var packedId = 0
            if (let some(p) = packed) {
                packedId = p
            }
            var boxed = boxForStore(em, rep, packedId, elemIr(fieldTy))
            var storeId = 0
            if (let some(b) = boxed) {
                storeId = b
            } else {
                return none
            }
            staticStore(em, cid, slot, storeId)
            return v
        }
if (rep.isPtr) {
            if (fieldTy != Ty.String) {
                bad(em, span, "compound assignment to a non-scalar static field is not lowered yet")
                return none
            }
            // String static field: read the current string, concatenate, store back.
            var c = intConst(em, cid)
            var s = intConst(em, slot)
            var cur = externCallT1(em, "pickle_static_get", [IrTy.Int, IrTy.Int], IrTy.Ptr, [c, s])
            var dstO = combineCompound(em, span, op, fieldTy, cur, v, "static field")
            if (let none = dstO) {
                return none
            }
            var dst = 0
            if (let some(d) = dstO) {
                dst = d
            }
            var boxed = boxForStore(em, rep, dst, elemIr(fieldTy))
            var storeId = 0
            if (let some(b) = boxed) {
                storeId = b
            } else {
                return none
            }
            staticStore(em, cid, slot, storeId)
            return dst
        }
        var c = intConst(em, cid)
        var s = intConst(em, slot)
        var raw = externCallT1(em, "pickle_static_get", [IrTy.Int, IrTy.Int], IrTy.Ptr, [c, s])
        var cur = externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
        var dst = temp(em)
        instr(em, IrInstr.BinOp(dst, assignOpcode(op), cur, v))
        var boxed = boxForStore(em, rep, dst, elemIr(fieldTy))
        var storeId = 0
        if (let some(b) = boxed) {
            storeId = b
        } else {
            return none
        }
        staticStore(em, cid, slot, storeId)
        dst
    }

    // ---- index assignment ----

    /// `xs[i] = v` / `xs[i] op= v` over lists, maps, string-typed targets and
    /// raw pointer elements. Mirrors `index_assign` in emit.rs.
fn indexAssign(em: Emitter, e: Expr, op: AssignOp, object: Expr, index: Expr, value: Expr) -> int? {
        var ot = tyOf(em, object.span)
        if (let some(t) = ot) {
            match (t) {
                case Ty.Map(k, v) -> {
                    return mapIndexAssign(em, op, object, index, value, k, v)
                }
                case _ -> {}
            }
        }
        var elemOpt: Ty? = none
        if (let some(t) = ot) {
            match (t) {
                case Ty.Ptr(pr) -> {
                    var scalarO = scalarIr(pr)
                    if (let none = scalarO) {
                        bad(em, e.span, "storing through a pointer to a managed value is not lowered yet")
                        return none
                    }
                    var ty = IrTy.Int
                    if (let some(s) = scalarO) {
                        ty = s
                    }
                    var baseO = expr(em, object)
                    if (let none = baseO) {
                        return none
                    }
                    var base = 0
                    if (let some(v) = baseO) {
                        base = v
                    }
                    var idxO = expr(em, index)
                    if (let none = idxO) {
                        return none
                    }
                    var idx = 0
                    if (let some(v) = idxO) {
                        idx = v
                    }
                    var addrO = ptrElementAddr(em, base, idx, ty, e.span)
                    if (let none = addrO) {
                        return none
                    }
                    var addr = 0
                    if (let some(v) = addrO) {
                        addr = v
                    }
                    if (op == AssignOp.Assign) {
                        var vO = expr(em, value)
                        if (let none = vO) {
                            return none
                        }
                        var v = 0
                        if (let some(vv) = vO) {
                            v = vv
                        }
                        instr(em, IrInstr.StoreRaw(addr, v, ty))
                        return v
                    }
                    var cur = temp(em)
                    instr(em, IrInstr.LoadRaw(cur, addr, ty))
                    var vO = expr(em, value)
                    if (let none = vO) {
                        return none
                    }
                    var v = 0
                    if (let some(vv) = vO) {
                        v = vv
                    }
                    var dst = temp(em)
                    instr(em, IrInstr.BinOp(dst, assignOpcode(op), cur, v))
                    instr(em, IrInstr.StoreRaw(addr, dst, ty))
                    return dst
                }
                case Ty.Ref(_) -> {
                    bad(em, e.span, "cannot write through an immutable reference (`&T`)")
                    return none
                }
                case Ty.String -> {
                    return strIndexAssign(em, e, op, object, index, value)
                }
                case Ty.List(pr) -> elemOpt = pr
                case _ -> {
                    bad(em, e.span, "index assignment over this type is not lowered yet")
                    return none
                }
            }
        }
        if (let none = elemOpt) {
            bad(em, e.span, "index assignment over this type is not lowered yet")
            return none
        }
        var elem = Ty.Unknown
        if (let some(x) = elemOpt) {
            elem = x
        }
        var repO = elemRep(em, elem, e.span)
        if (let none = repO) {
            return none
        }
        var rep = ElemRep.ptr()
        if (let some(r) = repO) {
            rep = r
        }
        var objO = expr(em, object)
        if (let none = objO) {
            return none
        }
        var obj = 0
        if (let some(v) = objO) {
            obj = v
        }
        var idxO = expr(em, index)
        if (let none = idxO) {
            return none
        }
        var idx = 0
        if (let some(v) = idxO) {
            idx = v
        }
        if (op == AssignOp.Assign) {
            var vO = expr(em, value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var ok = listStore(em, obj, idx, rep, elem, v)
            if (let none = ok) {
                return none
            }
            return v
        }
if (rep.isPtr) {
            if (elem != Ty.String) {
                bad(em, e.span, "compound assignment to a non-scalar list element is not lowered yet")
                return none
            }
            // String element: read the current string, concatenate, store back.
            var cur = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idx])
            var vO = expr(em, value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var dstO = combineCompound(em, e.span, op, elem, cur, v, "list element")
            if (let none = dstO) {
                return none
            }
            var dst = 0
            if (let some(d) = dstO) {
                dst = d
            }
            var ok = listStore(em, obj, idx, rep, elem, dst)
            if (let none = ok) {
                return none
            }
            return dst
        }
        var cur = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idx])
        var curV = externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [cur])
        var vO = expr(em, value)
        if (let none = vO) {
            return none
        }
        var v = 0
        if (let some(vv) = vO) {
            v = vv
        }
        var dst = temp(em)
        instr(em, IrInstr.BinOp(dst, assignOpcode(op), curV, v))
        var ok = listStore(em, obj, idx, rep, elem, dst)
        if (let none = ok) {
            return none
        }
        dst
    }

    /// `pickle_list_set(obj, idx, boxed)`: boxes a scalar element first.
    /// Mirrors `list_store`.
fn listStore(em: Emitter, obj: int, idx: int, rep: ElemRep, elem: Ty, v: int) -> int? {
        var boxed = 0
        if (rep.isPtr) {
            boxed = v
        } else {
            boxed = externCallT1(em, rep.boxSym, [elemIr(elem)], IrTy.Ptr, [v])
        }
        externCallVoid(em, "pickle_list_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, idx, boxed])
        0
    }

    /// `m[k] = v` / `m[k] op= v` over a `Map<K, V>`. Mirrors `map_index_assign`.
fn mapIndexAssign(em: Emitter, op: AssignOp, object: Expr, index: Expr, value: Expr, kty: Ty, vty: Ty) -> int? {
        var krepO = keyRep(em, kty, index.span)
        if (let none = krepO) {
            return none
        }
        var krep = ElemRep.ptr()
        if (let some(r) = krepO) {
            krep = r
        }
        var vrepO = elemRep(em, vty, object.span)
        if (let none = vrepO) {
            return none
        }
        var vrep = ElemRep.ptr()
        if (let some(r) = vrepO) {
            vrep = r
        }
        var objO = expr(em, object)
        if (let none = objO) {
            return none
        }
        var obj = 0
        if (let some(v) = objO) {
            obj = v
        }
        var kO = expr(em, index)
        if (let none = kO) {
            return none
        }
        var k = 0
        if (let some(v) = kO) {
            k = v
        }
var kTy = kty
        var kTyO = tyOf(em, index.span)
        if (let some(t) = kTyO) {
            kTy = t
        }
        var keyO = packMapKey(em, krep, k, kTy, index.span)
        if (let none = keyO) {
            return none
        }
        var key = 0
        if (let some(kk) = keyO) {
            key = kk
        }
        if (op == AssignOp.Assign) {
            var vO = expr(em, value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var vTy = IrTy.Int
            if (let some(t) = irty(em, value.span)) {
                vTy = t
            }
            var boxedO = boxForStore(em, vrep, v, vTy)
            if (let none = boxedO) {
                return none
            }
            var boxed = 0
            if (let some(b) = boxedO) {
                boxed = b
            }
            externCallVoid(em, "pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [obj, key, boxed])
            return v
        }
if (vrep.isPtr) {
            if (vty != Ty.String) {
                bad(em, object.span, "compound assignment to a non-scalar map value is not lowered yet")
                return none
            }
            // String value: an absent key reads as `""`, then the current
            // string is concatenated with the RHS and stored back.
            var defaultO = stringLiteral(em, emptyStrParts())
            if (let none = defaultO) {
                return none
            }
            var default = 0
            if (let some(d) = defaultO) {
                default = d
            }
            var cur = externCallT1(em, "pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, default])
            var vO = expr(em, value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var dstO = combineCompound(em, object.span, op, vty, cur, v, "map value")
            if (let none = dstO) {
                return none
            }
            var dst = 0
            if (let some(d) = dstO) {
                dst = d
            }
            externCallVoid(em, "pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [obj, key, dst])
            return dst
        }
        var zero = zeroScalar(em, vrep.ir, object.span)
        if (let none = zero) {
            return none
        }
        var zeroId = 0
        if (let some(z) = zero) {
            zeroId = z
        }
        var default = externCallT1(em, vrep.boxSym, [vrep.ir], IrTy.Ptr, [zeroId])
        var curPtr = externCallT1(em, "pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, default])
        var cur = externCallT1(em, vrep.unboxSym, [IrTy.Ptr], vrep.ir, [curPtr])
        var vO = expr(em, value)
        if (let none = vO) {
            return none
        }
        var v = 0
        if (let some(vv) = vO) {
            v = vv
        }
        var dst = temp(em)
        instr(em, IrInstr.BinOp(dst, assignOpcode(op), cur, v))
        var boxed = externCallT1(em, vrep.boxSym, [vrep.ir], IrTy.Ptr, [dst])
        externCallVoid(em, "pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [obj, key, boxed])
        dst
    }

    /// `s[i] = v` / `s[i] op= v` over a string: copy-on-write through
    /// `pickle_str_set`, storing back into the name/field the string came from.
    /// Mirrors `str_index_assign`.
fn strIndexAssign(em: Emitter, e: Expr, op: AssignOp, object: Expr, index: Expr, value: Expr) -> int? {
        match (object.kind) {
            case ExprKind.Ident(name) -> {
                var sO = expr(em, object)
                if (let none = sO) {
                    return none
                }
                var s = 0
                if (let some(v) = sO) {
                    s = v
                }
                var iO = expr(em, index)
                if (let none = iO) {
                    return none
                }
                var i = 0
                if (let some(v) = iO) {
                    i = v
                }
                var vO = byteRhs(em, value)
                if (let none = vO) {
                    return none
                }
                var v = 0
                if (let some(vv) = vO) {
                    v = vv
                }
                var byte = strIndexByte(em, op, s, i, v)
                var nsO = externCallT1(em, "pickle_str_set", [IrTy.Ptr, IrTy.Int, IrTy.Int], IrTy.Str, [s, i, byte])
                var ns = nsO
                var slotO = lookup(em, name)
                if (let some(slot) = slotO) {
                    instr(em, IrInstr.StoreSlot(slot, ns))
                    return ns
                }
                if (let some(cid) = em.owner) {
                    var idxO = instanceFieldIndex(em, cid, name)
                    if (let some(idx) = idxO) {
                        var fieldTy = fieldAt(em, cid, idx).ty
                        var owned = fieldAt(em, cid, idx).manual
                        var thO = thisValue(em, e)
                        if (let none = thO) {
                            return none
                        }
                        var th = 0
                        if (let some(thv) = thO) {
                            th = thv
                        }
                        var vt = Ty.String
                        if (let some(t) = tyOf(em, object.span)) {
                            vt = t
                        }
                        return fieldAssign(em, e.span, AssignOp.Assign, th, fieldTy, idx, ns, vt, owned)
                    }
                    var sfo = staticField(em, cid, name)
                    if (let some(sf) = sfo) {
                        if (!sf.info.mutable) {
                            bad(em, e.span, "cannot assign to immutable static field `" + name + "`")
                            return none
                        }
                        var vt = Ty.String
                        if (let some(t) = tyOf(em, object.span)) {
                            vt = t
                        }
                        return staticAssign(em, e.span, AssignOp.Assign, sf.dcid, sf.slot, sf.info.ty, ns, vt)
                    }
                }
                bad(em, e.span, "cannot assign to `" + name + "`")
                none
            }
case ExprKind.Member(mobj, mname) -> {
                var ot = tyOf(em, mobj.span)
                var o2: Ty? = ot
                if (let some(tt) = ot) {
                    match (tt) {
                        case Ty.Ptr(pr) -> o2 = pr
                        case _ -> {}
                    }
                }
                var cidVal = -1
                if (let some(oo) = o2) {
                    match (oo) {
                        case Ty.Class(_, _) -> {
                            var co = classIdOf(em, oo, e.span)
                            if (let some(c) = co) {
                                cidVal = c
                            }
                        }
                        case Ty.Struct(_, _) -> {
                            var co = classIdOf(em, oo, e.span)
                            if (let some(c) = co) {
                                cidVal = c
                            }
                        }
                        case _ -> {}
                    }
                }
                if (cidVal < 0) {
                    bad(em, e.span, "string index assignment over this member type is not lowered yet")
                    return none
                }
                var idxO = instanceFieldIndex(em, cidVal, mname)
                if (let none = idxO) {
                    bad(em, e.span, "`" + mname + "` is not a field of this `" + classOfName(em, cidVal) + "`")
                    return none
                }
                var idx = 0
                if (let some(v) = idxO) {
                    idx = v
                }
                var fieldTy = fieldAt(em, cidVal, idx).ty
                var owned = fieldAt(em, cidVal, idx).manual
                var moO = expr(em, mobj)
                if (let none = moO) {
                    return none
                }
                var mo = 0
                if (let some(v) = moO) {
                    mo = v
                }
                var idxc = intConst(em, idx)
                var raw = externCallT1(em, "pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [mo, idxc])
                var iO = expr(em, index)
                if (let none = iO) {
                    return none
                }
                var i = 0
                if (let some(v) = iO) {
                    i = v
                }
                var vO = byteRhs(em, value)
                if (let none = vO) {
                    return none
                }
                var v = 0
                if (let some(vv) = vO) {
                    v = vv
                }
                var byte = strIndexByte(em, op, raw, i, v)
                var ns = externCallT1(em, "pickle_str_set", [IrTy.Ptr, IrTy.Int, IrTy.Int], IrTy.Str, [raw, i, byte])
                var vt = Ty.String
                if (let some(t) = tyOf(em, object.span)) {
                    vt = t
                }
                return fieldAssign(em, e.span, AssignOp.Assign, mo, fieldTy, idx, ns, vt, owned)
            }
            case _ -> {
                bad(em, e.span, "string index assignment over a non-variable target is not lowered yet (strings are copy-on-write)")
                none
            }
        }
    }

    /// The byte (int ABI) to write into the string: an ASCII `char` literal
    /// lowers directly to its 0..=255 value; anything else lowers as its own
    /// value expression. Mirrors `byte_rhs`.
fn byteRhs(em: Emitter, value: Expr) -> int? {
        match (value.kind) {
            case ExprKind.Lit(Lit.Char(c)) -> {
                if ((c as int) <= 0x7F) {
                    return intConst(em, c as int)
                }
                expr(em, value)
            }
            case _ -> expr(em, value)
        }
    }

    /// The byte to write back for `s[i] op= v`: `v` itself for a plain store,
    /// or the current byte combined with `v` for a compound operator. Mirrors
    /// `str_index_byte`.
fn strIndexByte(em: Emitter, op: AssignOp, s: int, i: int, v: int) -> int {
        if (op == AssignOp.Assign) {
            return v
        }
        var cur = externCallT1(em, "pickle_str_get", [IrTy.Ptr, IrTy.Int], IrTy.Int, [s, i])
        var dst = temp(em)
        instr(em, IrInstr.BinOp(dst, assignOpcode(op), cur, v))
        dst
    }


    /// Lower `if (cond) { then } else { other }`. A binding condition
    /// delegates to `if_let_expr`; otherwise the condition branches between
    /// the then-block and the else side (or the join when no else exists), and
    /// the matching side stores its value into `res_slot`. Mirrors `if_expr`
    /// in emit.rs.
fn ifExpr(em: Emitter, e: Expr, cond: IfCond, then: Block, elseElse: Expr?) -> int? {
        match (cond) {
            case IfCond.Binding(pattern, value) -> ifLetExpr(em, e, pattern, value, then, elseElse)
            case IfCond.Cond(c) -> {
                var condT = expr(em, c)
                if (let none = condT) {
                    return none
                }
                var condTV = 0
                if (let some(v) = condT) {
                    condTV = v
                }
                var resTy = irty(em, e.span)
                var needSlot = false
                if (matchResultNeedsSlot(resTy)) {
                    if (let some(_) = elseElse) {
                        needSlot = true
                    }
                }
                var resSlot: int? = none
                if (needSlot) {
                    var rt = IrTy.Unit
                    if (let some(x) = resTy) {
                        rt = x
                    }
                    resSlot = newSlot(em, rt)
                }
                var thenId = newBlock(em)
                var elseId: int? = none
                if (let some(_) = elseElse) {
                    elseId = newBlock(em)
                }
                var join = newBlock(em)
                var eid = join
                if (let some(x) = elseId) {
                    eid = x
                }
                term(em, IrTerm.BranchIf(condTV, thenId, eid))
                em.cur = thenId
                pushScope(em)
                if (!(blockIntoSlot(em, then, resSlot))) {
                    popScope(em)
                    return none
                }
                popScope(em)
                term(em, IrTerm.Branch(join))
                if (let some(ee) = elseElse) {
                    var els = join
                    if (let some(x) = elseId) {
                        els = x
                    }
                    em.cur = els
                    if (let some(slot) = resSlot) {
                        var t = expr(em, ee)
                        if (let none = t) {
                            return none
                        }
                        var tv = 0
                        if (let some(x) = t) {
                            tv = x
                        }
                        var isPtrSlot = false
                        if (slot < len(em.fslots)) {
                            if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                                isPtrSlot = true
                            }
                        }
                        if (isPtrSlot) {
                            var ty = Ty.Unknown
                            if (let some(gt) = tyOf(em, ee.span)) {
                                ty = gt
                            }
                            var wv = optionWrap(em, tv, ty, ee.span)
                            if (let none = wv) {
                                return none
                            }
                            var vv = 0
                            if (let some(x) = wv) {
                                vv = x
                            }
                            instr(em, IrInstr.StoreSlot(slot, vv))
                        } else {
                            instr(em, IrInstr.StoreSlot(slot, tv))
                        }
                    } else {
                        if (let none = expr(em, ee)) {
                            return none
                        }
                    }
                    term(em, IrTerm.Branch(join))
                }
                em.cur = join
                if (let some(slot) = resSlot) {
                    return load(em, slot)
                }
                unitTemp(em)
            }
        }
    }

    /// Lower `if (let pattern = value) { then } [else ...]`: the value is
    /// evaluated once into a slot, `pattern_test_cond` gates the then-block
    /// (always-true binding/wildcard patterns need no branch), and bindings
    /// are scoped to the then-block only. Mirrors `if_let_expr` in emit.rs.
fn ifLetExpr(em: Emitter, e: Expr, pattern: Pattern, value: Expr, then: Block, elseElse: Expr?) -> int? {
        var st = Ty.Unknown
        if (let some(t) = tyOf(em, value.span)) {
            st = t
        }
        var sIr = matchScrutineeIr(em, st)
        var sIrV = IrTy.Ptr
        if (let some(x) = sIr) {
            sIrV = x
        }
        var v = expr(em, value)
        if (let none = v) {
            return none
        }
        var vv = 0
        if (let some(x) = v) {
            vv = x
        }
        var sSlot = newSlot(em, sIrV)
        instr(em, IrInstr.StoreSlot(sSlot, vv))
        var resTy = irty(em, e.span)
        var needSlot = false
        if (matchResultNeedsSlot(resTy)) {
            if (let some(_) = elseElse) {
                needSlot = true
            }
        }
        var resSlot: int? = none
        if (needSlot) {
            var rt = IrTy.Unit
            if (let some(x) = resTy) {
                rt = x
            }
            resSlot = newSlot(em, rt)
        }
        var always = false
        match (pattern) {
            case Pattern.Binding(_, _) -> always = true
            case Pattern.Wildcard -> always = true
            case _ -> {}
        }
        var thenId = newBlock(em)
        var elseId: int? = none
        if (let some(_) = elseElse) {
            elseId = newBlock(em)
        }
        var join = newBlock(em)
        if (always) {
            term(em, IrTerm.Branch(thenId))
            em.cur = thenId
            pushScope(em)
            var bv = load(em, sSlot)
            if (!(bindMatchValue(em, pattern, st, bv, value.span))) {
                popScope(em)
                return none
            }
            if (!(blockIntoSlot(em, then, resSlot))) {
                popScope(em)
                return none
            }
            popScope(em)
            term(em, IrTerm.Branch(join))
        } else {
            var sv = load(em, sSlot)
            var cond = patternTestCond(em, pattern, st, sv, value.span)
            if (let none = cond) {
                return none
            }
            var condV = 0
            if (let some(c) = cond) {
                condV = c
            }
            var eid = join
            if (let some(x) = elseId) {
                eid = x
            }
            term(em, IrTerm.BranchIf(condV, thenId, eid))
            em.cur = thenId
            pushScope(em)
            var bv = load(em, sSlot)
            if (!(bindMatchValue(em, pattern, st, bv, value.span))) {
                popScope(em)
                return none
            }
            if (!(blockIntoSlot(em, then, resSlot))) {
                popScope(em)
                return none
            }
            popScope(em)
            term(em, IrTerm.Branch(join))
        }
        if (let some(ee) = elseElse) {
            var els = join
            if (let some(x) = elseId) {
                els = x
            }
            em.cur = els
            if (let some(slot) = resSlot) {
                var t = expr(em, ee)
                if (let none = t) {
                    return none
                }
                var tv = 0
                if (let some(x) = t) {
                    tv = x
                }
                var isPtrSlot = false
                if (slot < len(em.fslots)) {
                    if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                        isPtrSlot = true
                    }
                }
                if (isPtrSlot) {
                    var ty = Ty.Unknown
                    if (let some(gt) = tyOf(em, ee.span)) {
                        ty = gt
                    }
                    var wv = optionWrap(em, tv, ty, ee.span)
                    if (let none = wv) {
                        return none
                    }
                    var vv = 0
                    if (let some(x) = wv) {
                        vv = x
                    }
                    instr(em, IrInstr.StoreSlot(slot, vv))
                } else {
                    instr(em, IrInstr.StoreSlot(slot, tv))
                }
            } else {
                if (let none = expr(em, ee)) {
                    return none
                }
            }
            term(em, IrTerm.Branch(join))
        }
        em.cur = join
        if (let some(slot) = resSlot) {
            return load(em, slot)
        }
        unitTemp(em)
    }

    /// Lower `match` over any scrutinee. Enum scrutinees use tag equality to
    /// route each `Enum.Variant(..)`/or-pattern arm; everything else delegates
    /// to `lower_generic_match`. A non-exhaustive chain panics at runtime.
    /// Mirrors `match_expr` in emit.rs.
fn matchExpr(em: Emitter, e: Expr, scrutinee: Expr, arms: List<MatchArm>) -> int? {
        var st0 = tyOf(em, scrutinee.span)
        if (let none = st0) {
            bad(em, e.span, "matching over non-enum values is not lowered yet")
            return none
        }
        var st = Ty.Unknown
        if (let some(s) = st0) {
            st = s
        }
        var isEnum = false
        match (st) {
            case Ty.Enum(_, _) -> isEnum = true
            case _ -> {}
        }
        if (!isEnum) {
            return lowerGenericMatch(em, e, scrutinee, arms, st)
        }
        var enumName = ""
        match (st) {
            case Ty.Enum(en, _) -> enumName = en
            case _ -> {}
        }
        var tableO: EnumTable? = none
        if (let some(entry) = em.resolved.types.get(enumName)) {
            match (entry) {
                case TypeTableEntry.Enum(t) -> tableO = t
                case _ -> {}
            }
        }
        if (let none = tableO) {
            bad(em, e.span, "unknown enum type `" + enumName + "`")
            return none
        }
        if (let some(t) = tableO) {
            return lowerEnumMatchTable(em, e, scrutinee, arms, enumName, t)
        }
        none
    }

    /// The enum-tag `match` lowering (Rust `match_expr` with the `ty_of` /
    /// table lookup already resolved). The scrutinee lives in a `Ptr` slot;
    /// arms branch on `pickle_enum_tag` equality, bind payloads, and join at
    /// a common block.
fn lowerEnumMatchTable(em: Emitter, e: Expr, scrutinee: Expr, arms: List<MatchArm>, enumName: string, table: EnumTable) -> int? {
        var s = expr(em, scrutinee)
        if (let none = s) {
            return none
        }
        var sV = 0
        if (let some(x) = s) {
            sV = x
        }
        var sSlot = newSlot(em, IrTy.Ptr)
        instr(em, IrInstr.StoreSlot(sSlot, sV))
        var resTy = irty(em, e.span)
        var resSlot: int? = none
        if (matchResultNeedsSlot(resTy)) {
            var rt = IrTy.Unit
            if (let some(x) = resTy) {
                rt = x
            }
            resSlot = newSlot(em, rt)
        }
        var sv = load(em, sSlot)
        var tag = externCallT1(em, "pickle_enum_tag", [IrTy.Ptr], IrTy.Int, [sv])
        var join = newBlock(em)
        var cur = em.cur
        var chainLive = true
        for (arm in arms) {
            var body = newBlock(em)
            var guard = arm.guard
            var hasPayloadCond = false
            match (arm.pattern) {
                case Pattern.Variant(_, pl) -> {
                    for (plp in pl) {
                        var isPlSimple = false
                        match (plp) {
                            case Pattern.Wildcard -> isPlSimple = true
                            case Pattern.Binding(_, _) -> isPlSimple = true
                            case _ -> {}
                        }
                        if (!isPlSimple) {
                            hasPayloadCond = true
                        }
                    }
                }
                case _ -> {}
            }
            var guardIn = body
            if (let some(_) = guard) {
                guardIn = newBlock(em)
            } else {
                if (hasPayloadCond) {
                    guardIn = newBlock(em)
                }
            }
            var isCatchAll = false
            var bindName: string? = none
            match (arm.pattern) {
                case Pattern.Wildcard -> isCatchAll = true
                case Pattern.Binding(nm, _) -> {
                    bindName = nm
                    isCatchAll = true
                }
                case _ -> {}
            }
            if (isCatchAll) {
                if (let some(g) = guard) {
                    if (chainLive) {
                        em.cur = cur
                        term(em, IrTerm.Branch(guardIn))
                        cur = newBlock(em)
                        em.cur = guardIn
                        pushScope(em)
                        if (let some(nm) = bindName) {
                            var slot = newSlot(em, IrTy.Ptr)
                            var bv = load(em, sSlot)
                            instr(em, IrInstr.StoreSlot(slot, bv))
                            declare(em, nm, slot)
                        }
                        var cond = expr(em, g)
                        if (let none = cond) {
                            popScope(em)
                            return none
                        }
                        var condV = 0
                        if (let some(x) = cond) {
                            condV = x
                        }
                        term(em, IrTerm.BranchIf(condV, body, cur))
                        em.cur = body
                        if (!(matchArmBody(em, arm.body, resSlot))) {
                            popScope(em)
                            return none
                        }
                        popScope(em)
                        term(em, IrTerm.Branch(join))
                    } else {
                        em.cur = guardIn
                        pushScope(em)
                        if (let some(nm) = bindName) {
                            var slot = newSlot(em, IrTy.Ptr)
                            var bv = load(em, sSlot)
                            instr(em, IrInstr.StoreSlot(slot, bv))
                            declare(em, nm, slot)
                        }
                        var cond = expr(em, g)
                        if (let none = cond) {
                            popScope(em)
                            return none
                        }
                        var condV = 0
                        if (let some(x) = cond) {
                            condV = x
                        }
                        term(em, IrTerm.BranchIf(condV, body, join))
                        em.cur = body
                        if (!(matchArmBody(em, arm.body, resSlot))) {
                            popScope(em)
                            return none
                        }
                        popScope(em)
                        term(em, IrTerm.Branch(join))
                    }
                    continue
                }
                if (chainLive) {
                    em.cur = cur
                    term(em, IrTerm.Branch(body))
                    chainLive = false
                }
                em.cur = body
                pushScope(em)
                if (let some(nm) = bindName) {
                    var slot = newSlot(em, IrTy.Ptr)
                    var bv = load(em, sSlot)
                    instr(em, IrInstr.StoreSlot(slot, bv))
                    declare(em, nm, slot)
                }
                if (!(matchArmBody(em, arm.body, resSlot))) {
                    popScope(em)
                    return none
                }
                popScope(em)
                term(em, IrTerm.Branch(join))
            } else {
                match (arm.pattern) {
                    case Pattern.Variant(path, payloads) -> {
                        var vname = ""
                        var isPath = false
                        if (len(path) == 2) {
                            vname = path[1]
                            isPath = true
                        }
                        if (len(path) == 1) {
                            vname = path[0]
                            isPath = true
                        }
                        if (!isPath) {
                            bad(em, arm.span, "invalid enum variant pattern")
                            return none
                        }
                        var vi = -1
                        var vfound = false
                        var vii = 0
                        for (v in table.variants) {
                            if (v.name == vname) {
                                vi = vii
                                vfound = true
                                break
                            }
                            vii = vii + 1
                        }
                        if (!vfound) {
                            bad(em, arm.span, "enum `" + enumName + "` has no variant `" + vname + "`")
                            return none
                        }
                        if (chainLive) {
                            em.cur = cur
                            var viT = temp(em)
                            instr(em, IrInstr.Const(viT, IrConst.Int(vi)))
                            var c = temp(em)
                            instr(em, IrInstr.BinOp(c, IrBinOp.Eq, tag, viT))
                            var next = newBlock(em)
                            term(em, IrTerm.BranchIf(c, guardIn, next))
                            cur = next
                        }
                        em.cur = guardIn
                        pushScope(em)
                        var payloadCond = bindEnumPayloads(em, arm.span, table, vi, payloads, sSlot)
                        if (let none = payloadCond) {
                            popScope(em)
                            return none
                        }
                        var cf = -1
                        if (let some(pc) = payloadCond) {
                            cf = pc
                        }
                        if (let some(g) = guard) {
                            var cond = expr(em, g)
                            if (let none = cond) {
                                popScope(em)
                                return none
                            }
                            var condV = 0
                            if (let some(x) = cond) {
                                condV = x
                            }
                            if (cf == -1) {
                                cf = condV
                            } else {
                                cf = combineCond(em, true, cf, condV)
                            }
                        }
                        if (!(cf == -1)) {
                            var fall = join
                            if (chainLive) {
                                fall = cur
                            }
                            term(em, IrTerm.BranchIf(cf, body, fall))
                            em.cur = body
                        }
                        if (!(matchArmBody(em, arm.body, resSlot))) {
                            popScope(em)
                            return none
                        }
                        popScope(em)
                        term(em, IrTerm.Branch(join))
                    }
                    case Pattern.Or(alts) -> {
                        if (chainLive) {
                            em.cur = cur
                        }
                        var tagTest: int? = none
                        for (alt in alts) {
                            match (alt) {
                                case Pattern.Variant(p, pl) -> {
                                    for (pla in pl) {
                                        match (pla) {
                                            case Pattern.Wildcard -> {}
                                            case _ -> {
                                                bad(em, arm.span, "enum or-pattern alternatives may only use `_` payloads")
                                                return none
                                            }
                                        }
                                    }
                                    var ovn = ""
                                    var ois = false
                                    if (len(p) == 2) {
                                        ovn = p[1]
                                        ois = true
                                    }
                                    if (len(p) == 1) {
                                        ovn = p[0]
                                        ois = true
                                    }
                                    if (!ois) {
                                        bad(em, arm.span, "invalid enum variant pattern")
                                        return none
                                    }
                                    var ovi = -1
                                    var ofound = false
                                    var oi = 0
                                    for (v in table.variants) {
                                        if (v.name == ovn) {
                                            ovi = oi
                                            ofound = true
                                            break
                                        }
                                        oi = oi + 1
                                    }
                                    if (!ofound) {
                                        bad(em, arm.span, "enum `" + enumName + "` has no variant `" + ovn + "`")
                                        return none
                                    }
                                    var viT = constTemp(em, IrConst.Int(ovi))
                                    var c = temp(em)
                                    instr(em, IrInstr.BinOp(c, IrBinOp.Eq, tag, viT))
                                    if (let some(prev) = tagTest) {
                                        tagTest = combineCond(em, false, prev, c)
                                    } else {
                                        tagTest = c
                                    }
                                }
                                case _ -> {
                                    bad(em, arm.span, "enum or-pattern alternatives must be variant patterns")
                                    return none
                                }
                            }
                        }
                        var condV = 0
                        if (let some(cv) = tagTest) {
                            condV = cv
                        } else {
                            bad(em, arm.span, "an or-pattern has no alternatives")
                            return none
                        }
                        if (chainLive) {
                            var next = newBlock(em)
                            term(em, IrTerm.BranchIf(condV, guardIn, next))
                            cur = next
                        }
                        em.cur = guardIn
                        pushScope(em)
                        if (let some(g) = guard) {
                            var cond = expr(em, g)
                            if (let none = cond) {
                                popScope(em)
                                return none
                            }
                            var cv2 = 0
                            if (let some(x) = cond) {
                                cv2 = x
                            }
                            var fall = join
                            if (chainLive) {
                                fall = cur
                            }
                            term(em, IrTerm.BranchIf(cv2, body, fall))
                            em.cur = body
                        }
                        if (!(matchArmBody(em, arm.body, resSlot))) {
                            popScope(em)
                            return none
                        }
                        popScope(em)
                        term(em, IrTerm.Branch(join))
                    }
                    case _ -> {
                        bad(em, arm.span, "this match pattern is not lowered yet")
                        return none
                    }
                }
            }
        }
        if (chainLive) {
            em.cur = cur
            panicNoMatchAt(em, e.span, sv)
            term(em, IrTerm.Branch(join))
        }
        em.cur = join
        if (let some(slot) = resSlot) {
            return load(em, slot)
        }
        unitTemp(em)
    }

    /// Lower `match` over non-enum scrutinees: numeric scalars, `bool`,
    /// `char`, `byte`, `string`, and options (`some(v)`/`none`). Literal
    /// patterns become equality tests against the scrutinee slot; a
    /// binding/wildcard arm catches everything that reaches it. A
    /// non-exhaustive chain fails loudly at runtime. Mirrors
    /// `lower_generic_match` in emit.rs.
fn lowerGenericMatch(em: Emitter, e: Expr, scrutinee: Expr, arms: List<MatchArm>, st: Ty) -> int? {
        var sIr = matchScrutineeIr(em, st)
        if (let none = sIr) {
            bad(em, e.span, "matching over `" + bareName(st) + "` values is not lowered yet")
            return none
        }
        var sIrV = IrTy.Unit
        if (let some(x) = sIr) {
            sIrV = x
        }
        var s = expr(em, scrutinee)
        if (let none = s) {
            return none
        }
        var sV = 0
        if (let some(x) = s) {
            sV = x
        }
        var sSlot = newSlot(em, sIrV)
        instr(em, IrInstr.StoreSlot(sSlot, sV))
        var resTy = irty(em, e.span)
        var resSlot: int? = none
        if (matchResultNeedsSlot(resTy)) {
            var rt = IrTy.Unit
            if (let some(x) = resTy) {
                rt = x
            }
            resSlot = newSlot(em, rt)
        }
        var join = newBlock(em)
        var cur = em.cur
        var chainLive = true
for (arm in arms) {
            var body = newBlock(em)
            var guard = arm.guard
            var guardIn = body
            if (let some(_) = guard) {
                guardIn = newBlock(em)
            }
            var testable: Pattern? = none
            match (arm.pattern) {
                case Pattern.Wildcard -> {}
                case Pattern.Binding(_, _) -> {}
                case other -> testable = other
            }
            if (let some(p) = testable) {
                if (chainLive) {
                    em.cur = cur
                    var sv = load(em, sSlot)
                    var cond = patternTestCond(em, p, st, sv, arm.span)
                    if (let none = cond) {
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    var next = newBlock(em)
                    term(em, IrTerm.BranchIf(condV, guardIn, next))
                    cur = next
                }
                em.cur = guardIn
                pushScope(em)
                var bv = load(em, sSlot)
                if (!(bindMatchValue(em, arm.pattern, st, bv, arm.span))) {
                    popScope(em)
                    return none
                }
                if (let some(g) = guard) {
                    var cond = expr(em, g)
                    if (let none = cond) {
                        popScope(em)
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    var fall = join
                    if (chainLive) {
                        fall = cur
                    }
                    term(em, IrTerm.BranchIf(condV, body, fall))
                    em.cur = body
                }
                if (!(matchArmBody(em, arm.body, resSlot))) {
                    popScope(em)
                    return none
                }
                popScope(em)
                term(em, IrTerm.Branch(join))
                continue
            }
            if (let some(g) = guard) {
                if (chainLive) {
                    em.cur = cur
                    term(em, IrTerm.Branch(guardIn))
                    cur = newBlock(em)
                    em.cur = guardIn
                    pushScope(em)
                    var bv = load(em, sSlot)
                    if (!(bindMatchValue(em, arm.pattern, st, bv, arm.span))) {
                        popScope(em)
                        return none
                    }
                    var cond = expr(em, g)
                    if (let none = cond) {
                        popScope(em)
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    term(em, IrTerm.BranchIf(condV, body, cur))
                    em.cur = body
                    if (!(matchArmBody(em, arm.body, resSlot))) {
                        popScope(em)
                        return none
                    }
                    popScope(em)
                    term(em, IrTerm.Branch(join))
                } else {
                    em.cur = guardIn
                    pushScope(em)
                    var bv = load(em, sSlot)
                    if (!(bindMatchValue(em, arm.pattern, st, bv, arm.span))) {
                        popScope(em)
                        return none
                    }
                    var cond = expr(em, g)
                    if (let none = cond) {
                        popScope(em)
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    term(em, IrTerm.BranchIf(condV, body, join))
                    em.cur = body
                    if (!(matchArmBody(em, arm.body, resSlot))) {
                        popScope(em)
                        return none
                    }
                    popScope(em)
                    term(em, IrTerm.Branch(join))
                }
                continue
            }
            if (chainLive) {
                em.cur = cur
                term(em, IrTerm.Branch(body))
                chainLive = false
            }
            em.cur = body
            pushScope(em)
            var bv = load(em, sSlot)
            if (!(bindMatchValue(em, arm.pattern, st, bv, arm.span))) {
                popScope(em)
                return none
            }
            if (!(matchArmBody(em, arm.body, resSlot))) {
                popScope(em)
                return none
            }
            popScope(em)
            term(em, IrTerm.Branch(join))
        }
        if (chainLive) {
            em.cur = cur
            externCallVoid(em, "pickle_panic_no_match", emptyIrTys(), emptyInts())
            term(em, IrTerm.Branch(join))
        }
        em.cur = join
        if (let some(slot) = resSlot) {
            return load(em, slot)
        }
        unitTemp(em)
    }

    /// The branch condition under which `p` matches the scrutinee value `a`
    /// (already loaded): `none` tests absence; `some(payload)` tests presence
    /// (recursing for nested payload patterns); tuple patterns AND each
    /// element; `a | b` ORs alternatives; literal patterns test equality.
    /// Mirrors `pattern_test_cond` in emit.rs.
fn patternTestCond(em: Emitter, p: Pattern, st: Ty, a: int, span: Span) -> int? {
        match (p) {
            case Pattern.Literal(lit) -> {
                var noneLit = false
                match (lit) {
                    case Lit.None -> noneLit = true
                    case _ -> {}
                }
                if (noneLit && isOption(st)) {
                    var present = optIsPresent(em, a)
                    if (let none = present) {
                        return none
                    }
                    var pv = 0
                    if (let some(x) = present) {
                        pv = x
                    }
                    var f = constTemp(em, IrConst.Bool(false))
                    var dst = temp(em)
                    instr(em, IrInstr.BinOp(dst, IrBinOp.Eq, pv, f))
                    return dst
                }
                var isStr = false
                match (st) {
                    case Ty.String -> isStr = true
                    case _ -> {}
                }
                if (isStr) {
                    var text = ""
                    var stringOk = true
                    match (lit) {
                        case Lit.String(parts) -> {
                            for (part in parts) {
                                match (part) {
                                    case StrPart.Text(t) -> text = text + t
                                    case StrPart.Expr(_) -> {
                                        bad(em, span, "string match patterns may not interpolate")
                                        return none
                                    }
                                }
                            }
                        }
                        case _ -> {
                            bad(em, span, "this match pattern is not lowered yet")
                            return none
                        }
                    }
                    let _ = stringOk
                    var b = strConst(em, text)
                    var cmp = externCallT1(em, "pickle_str_cmp", [IrTy.Str, IrTy.Str], IrTy.Int, [a, b])
                    var zero = intConst(em, 0)
                    var dst = temp(em)
                    instr(em, IrInstr.BinOp(dst, IrBinOp.Eq, cmp, zero))
                    return dst
                }
                var lb = patternLiteralTemp(em, lit, st, span)
                if (let none = lb) {
                    return none
                }
                var lbV = 0
                if (let some(x) = lb) {
                    lbV = x
                }
                var dst = temp(em)
                instr(em, IrInstr.BinOp(dst, IrBinOp.Eq, a, lbV))
                return dst
            }
            case Pattern.Variant(path, payloads) -> {
                var isSomeOpt = false
                if (len(path) == 1) {
                    if (path[0] == "some" && isOption(st)) {
                        isSomeOpt = true
                    }
                }
                if (!isSomeOpt) {
                    var isEnumTy = false
                    match (st) {
                        case Ty.Enum(_, _) -> isEnumTy = true
                        case _ -> {}
                    }
                    if (isEnumTy) {
                        return enumVariantCond(em, p, st, a, span)
                    }
                    bad(em, span, "this match pattern is not lowered yet")
                    return none
                }
                var inner = Ty.Unknown
                if (let some(i) = innerOption(st)) {
                    inner = i
                }
                var present = optIsPresent(em, a)
                if (let none = present) {
                    return none
                }
                var presentV = 0
                if (let some(x) = present) {
                    presentV = x
                }
                var needsNested = false
                var payloadP = Pattern.Wildcard
                if (len(payloads) >= 1) {
                    var pl = payloads[0]
                    var simple = false
                    match (pl) {
                        case Pattern.Wildcard -> simple = true
                        case Pattern.Binding(_, _) -> simple = true
                        case _ -> {}
                    }
                    payloadP = pl
                    needsNested = !(simple)
                }
                if (!needsNested) {
                    return presentV
                }
                var resSlot = newSlot(em, IrTy.Bool)
                var onPresent = newBlock(em)
                var onAbsent = newBlock(em)
                var bjoin = newBlock(em)
                term(em, IrTerm.BranchIf(presentV, onPresent, onAbsent))
                em.cur = onPresent
                var resolved = optResolve(em, a, inner, span)
                if (let none = resolved) {
                    return none
                }
                var resolvedV = 0
                if (let some(x) = resolved) {
                    resolvedV = x
                }
                var innerCond = patternTestCond(em, payloadP, inner, resolvedV, span)
                if (let none = innerCond) {
                    return none
                }
                var icv = 0
                if (let some(x) = innerCond) {
                    icv = x
                }
                instr(em, IrInstr.StoreSlot(resSlot, icv))
                term(em, IrTerm.Branch(bjoin))
                em.cur = onAbsent
                var f = constTemp(em, IrConst.Bool(false))
                instr(em, IrInstr.StoreSlot(resSlot, f))
                term(em, IrTerm.Branch(bjoin))
                em.cur = bjoin
                return load(em, resSlot)
            }
            case Pattern.Tuple(parts) -> {
                var tupleTys: List<Ty> = emptyTys()
                match (st) {
                    case Ty.Tuple(tt) -> tupleTys = tt
                    case _ -> {
                        bad(em, span, "a tuple pattern requires a tuple scrutinee")
                        return none
                    }
                }
                if (len(tupleTys) != len(parts)) {
                    bad(em, span, "tuple pattern arity does not match the scrutinee type")
                    return none
                }
var acc: int? = none
                var i = 0
                while (i < len(parts)) {
                    var c = tuplePartCond(em, parts[i], tupleTys[i], a, i, span)
                    if (let some(cv) = c) {
                        if (let some(prev) = acc) {
                            acc = combineCond(em, true, prev, cv)
                        } else {
                            acc = cv
                        }
                    }
                    i = i + 1
                }
                if (let some(v) = acc) {
                    return v
                }
                constTemp(em, IrConst.Bool(true))
            }
            case Pattern.Or(alts) -> {
                var acc: int? = none
                for (alt in alts) {
                    var c = patternTestCond(em, alt, st, a, span)
                    if (let none = c) {
                        return none
                    }
                    var cv = 0
                    if (let some(x) = c) {
                        cv = x
                    }
                    if (let some(prev) = acc) {
                        acc = combineCond(em, false, prev, cv)
                    } else {
                        acc = cv
                    }
                }
                if (let some(v) = acc) {
                    return v
                }
                bad(em, span, "an or-pattern has no alternatives")
                none
            }
            case _ -> {
                bad(em, span, "this match pattern is not lowered yet")
                none
            }
        }
    }

    /// The match condition contributed by tuple element `i` (read from the
    /// tuple pointer `a`): bindings/wildcards are always true; a testable
    /// nested pattern is unboxed to the element's IR domain and recursed.
    /// Mirrors `tuple_part_cond` in emit.rs.
fn tuplePartCond(em: Emitter, part: Pattern, elem: Ty, a: int, i: int, span: Span) -> int? {
        var isSimple = false
        match (part) {
            case Pattern.Binding(_, _) -> isSimple = true
            case Pattern.Wildcard -> isSimple = true
            case _ -> {}
        }
        if (isSimple) {
            return none
        }
        var idx = constTemp(em, IrConst.Int(i))
        var rep = elemRep(em, elem, span)
        if (let none = rep) {
            return none
        }
        var repV = ElemRep.ptr()
        if (let some(r) = rep) {
            repV = r
        }
        var raw = externCallT1(em, "pickle_tuple_field", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [a, idx])
        var un = raw
        if (!(repV.isPtr)) {
            un = externCallT1(em, repV.unboxSym, [IrTy.Ptr], repV.ir, [raw])
        }
        patternTestCond(em, part, elem, un, span)
    }

    /// Build a constant in the scrutinee's domain for a literal pattern. A
    /// float scrutinee widens integer literals; a byte scrutinee accepts
    /// ASCII char literals. Mirrors `pattern_literal_temp` in emit.rs (the
    /// float-to-int path uses a truncate-and-round-trip check because Pk
    /// floats expose no `trunc`).
fn patternLiteralTemp(em: Emitter, lit: Lit, st: Ty, span: Span) -> int? {
        match (lit) {
            case Lit.Int(value) -> {
                var isFloat = false
                match (st) {
                    case Ty.Float -> isFloat = true
                    case _ -> {}
                }
                if (isFloat) {
                    var i = constTemp(em, IrConst.Int(value))
                    var d = temp(em)
                    instr(em, IrInstr.Itof(d, i))
                    return d
                }
                constTemp(em, IrConst.Int(value))
            }
            case Lit.Float(text) -> {
                var isIntOrByte = false
                match (st) {
                    case Ty.Int -> isIntOrByte = true
                    case Ty.Byte -> isIntOrByte = true
                    case _ -> {}
                }
                var value = floatVal(text)
                if (isIntOrByte) {
                    var iv = value as int
                    var back = iv as float
                    if (back == value) {
                        return constTemp(em, IrConst.Int(iv))
                    }
                    bad(em, span, "float pattern does not represent an integer")
                    return none
                }
                constTemp(em, IrConst.Float(value))
            }
            case Lit.Bool(b) -> {
                var isBool = false
                match (st) {
                    case Ty.Bool -> isBool = true
                    case _ -> {}
                }
                if (isBool) {
                    return constTemp(em, IrConst.Bool(b))
                }
                bad(em, span, "this match pattern is not lowered yet")
                none
            }
            case Lit.Char(c) -> {
                var isChar = false
                var isByte = false
                match (st) {
                    case Ty.Char -> isChar = true
                    case Ty.Byte -> isByte = true
                    case _ -> {}
                }
                if (isChar) {
                    return constTemp(em, IrConst.Char(c))
                }
                if (isByte) {
                    if ((c as int) <= 0x7F) {
                        return constTemp(em, IrConst.Int(c as int))
                    }
                    bad(em, span, "a non-ASCII char pattern has no `byte` value")
                    return none
                }
                bad(em, span, "this match pattern is not lowered yet")
                none
            }
            case _ -> {
                bad(em, span, "this match pattern is not lowered yet")
                none
            }
        }
    }


    /// The IR domain a match scrutinee (`match`/`if let`) is kept in: scalars
    /// as themselves, strings as `Str` foreign pointers, and every composite
    /// (option/list/map/class/struct/enum/interface/tuple/range) as a managed
    /// `Ptr`. Mirrors `match_scrutinee_ir` in emit.rs.
fn matchScrutineeIr(em: Emitter, st: Ty) -> IrTy? {
        match (st) {
            case Ty.Int -> scalarIrOf(st)
            case Ty.Byte -> scalarIrOf(st)
            case Ty.Float -> scalarIrOf(st)
            case Ty.Bool -> scalarIrOf(st)
            case Ty.Char -> scalarIrOf(st)
            case Ty.String -> IrTy.Str
            case Ty.Option(_) -> IrTy.Ptr
            case Ty.Class(_, _) -> IrTy.Ptr
            case Ty.Struct(_, _) -> IrTy.Ptr
            case Ty.Enum(_, _) -> IrTy.Ptr
            case Ty.Interface(_, _) -> IrTy.Ptr
            case Ty.List(_) -> IrTy.Ptr
            case Ty.Map(_, _) -> IrTy.Ptr
            case Ty.Tuple(_) -> IrTy.Ptr
            case Ty.Range(_) -> IrTy.Ptr
            case _ -> none
        }
    }

    /// Bind the names an arm pattern introduces to the scrutinee value `v`
    /// (already loaded, of type `st`) in the current block. Bindings declare
    /// under `map_ty`; `some(v)` unboxes the present option; tuple patterns
    /// unbox each element; or-patterns bind nothing (the checker only admits
    /// name-free or-patterns); `_`/literals bind nothing. Mirrors
    /// `bind_match_value` in emit.rs.
fn bindMatchValue(em: Emitter, p: Pattern, st: Ty, v: int, span: Span) -> bool {
        match (p) {
            case Pattern.Wildcard -> true
            case Pattern.Literal(_) -> true
            case Pattern.Binding(name, _) -> {
                var ir = IrTy.Str
                match (st) {
                    case Ty.String -> {}
                    case _ -> {
                        var m = mapTy(em, st, span)
                        if (let none = m) {
                            return false
                        }
                        if (let some(mv) = m) {
                            ir = mv
                        }
                    }
                }
                declareBinding(em, name, ir, v)
                true
            }
            case Pattern.Variant(path, payloads) -> {
                var isSomeOpt = false
                if (len(path) == 1) {
                    if (path[0] == "some" && isOption(st)) {
                        isSomeOpt = true
                    }
                }
                if (!isSomeOpt) {
                    var isEnumTy = false
                    match (st) {
                        case Ty.Enum(_, _) -> isEnumTy = true
                        case _ -> {}
                    }
                    if (!isEnumTy) {
                        bad(em, span, "this match pattern is not lowered yet")
                        return false
                    }
                    var ename = ""
                    match (st) {
                        case Ty.Enum(en, _) -> ename = en
                        case _ -> {}
                    }
                    var tableO: EnumTable? = none
                    if (let some(entry) = em.resolved.types.get(ename)) {
                        match (entry) {
                            case TypeTableEntry.Enum(t) -> tableO = t
                            case _ -> {}
                        }
                    }
                    if (let none = tableO) {
                        bad(em, span, "unknown enum type `" + ename + "`")
                        return false
                    }
                    if (let some(table) = tableO) {
                        var vname = ""
                        var valid = false
                        if (len(path) == 2) {
                            vname = path[1]
                            valid = true
                        }
                        if (len(path) == 1) {
                            vname = path[0]
                            valid = true
                        }
                        if (!valid) {
                            bad(em, span, "invalid enum variant pattern")
                            return false
                        }
                        var vi = -1
                        var found = false
                        var ix = 0
                        for (variant in table.variants) {
                            if (variant.name == vname) {
                                vi = ix
                                found = true
                                break
                            }
                            ix = ix + 1
                        }
                        if (!found) {
                            bad(em, span, "enum `" + ename + "` has no variant `" + vname + "`")
                            return false
                        }
                        var ftypes = table.variants[vi].fields
                        var pi = 0
                        while (pi < len(payloads)) {
                            var ft = Ty.Unknown
                            if (pi < len(ftypes)) {
                                ft = ftypes[pi]
                            }
                            var idx = constTemp(em, IrConst.Int(pi))
                            var raw = externCallT1(em, "pickle_enum_field", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [v, idx])
                            var pv = raw
                            var rep = elemRep(em, ft, span)
                            if (let none = rep) {
                                return false
                            }
                            var repV = ElemRep.ptr()
                            if (let some(r) = rep) {
                                repV = r
                            }
                            if (!(repV.isPtr)) {
                                pv = externCallT1(em, repV.unboxSym, [IrTy.Ptr], repV.ir, [raw])
                            }
                            if (!(bindPatternValue(em, payloads[pi], ft, pv, span))) {
                                return false
                            }
                            pi = pi + 1
                        }
                        return true
                    }
                    return false
                }
                var inner = Ty.Unknown
                if (let some(i) = innerOption(st)) {
                    inner = i
                }
                var resolved = optResolve(em, v, inner, span)
                if (let none = resolved) {
                    return false
                }
                var resolvedV = 0
                if (let some(x) = resolved) {
                    resolvedV = x
                }
                if (len(payloads) == 0) {
                    return true
                }
                bindPatternValue(em, payloads[0], inner, resolvedV, span)
            }
            case Pattern.Tuple(parts) -> {
                var tupleTys: List<Ty> = emptyTys()
                match (st) {
                    case Ty.Tuple(tt) -> tupleTys = tt
                    case _ -> {
                        bad(em, span, "a tuple pattern requires a tuple scrutinee")
                        return false
                    }
                }
                if (len(tupleTys) != len(parts)) {
                    bad(em, span, "tuple pattern arity does not match the scrutinee type")
                    return false
                }
                var i = 0
                while (i < len(parts)) {
                    var idx = constTemp(em, IrConst.Int(i))
                    var raw = externCallT1(em, "pickle_tuple_field", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [v, idx])
                    var pv = raw
                    var rep = elemRep(em, tupleTys[i], span)
                    if (let none = rep) {
                        return false
                    }
                    var repV = ElemRep.ptr()
                    if (let some(r) = rep) {
                        repV = r
                    }
                    if (!(repV.isPtr)) {
                        pv = externCallT1(em, repV.unboxSym, [IrTy.Ptr], repV.ir, [raw])
                    }
                    if (!(bindPatternValue(em, parts[i], tupleTys[i], pv, span))) {
                        return false
                    }
                    i = i + 1
                }
                true
            }
            case Pattern.Or(_) -> true
        }
    }

    /// Bind a nested pattern to a value `v` of type `ty` already in IR form
    /// (a `some` payload or a tuple element). Mirrors `bind_pattern_value`
    /// in emit.rs.
fn bindPatternValue(em: Emitter, p: Pattern, ty: Ty, v: int, span: Span) -> bool {
        bindMatchValue(em, p, ty, v, span)
    }
    /// Store an arm body's value into the match's result slot, lifting scalar
    /// values when the slot is a `Ptr` (an option-typed result). Mirrors
    /// `match_arm_body` in emit.rs.
fn matchArmBody(em: Emitter, body: Expr, resSlot: int?) -> bool {
        var bt = expr(em, body)
        if (let none = bt) {
            return false
        }
        var btv = 0
        if (let some(x) = bt) {
            btv = x
        }
        if (let some(slot) = resSlot) {
            var isPtrSlot = false
            if (slot < len(em.fslots)) {
                if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                    isPtrSlot = true
                }
            }
            if (isPtrSlot) {
                var btTy = Ty.Unknown
                if (let some(t) = tyOf(em, body.span)) {
                    btTy = t
                }
                var wv = optionWrap(em, btv, btTy, body.span)
                if (let none = wv) {
                    return false
                }
                var wvv = 0
                if (let some(x) = wv) {
                    wvv = x
                }
                instr(em, IrInstr.StoreSlot(slot, wvv))
            } else {
                instr(em, IrInstr.StoreSlot(slot, btv))
            }
        }
        true
    }

    /// Bind the payload fields of variant `vi` of `table` into fresh slots for
    /// `Color.Rgb(r, g, b)` patterns, and return the folded match condition
    /// contributed by any nested (non-binding) payload patterns. A `-1`
    /// return means no condition (every payload bound a name or `_`); `none`
    /// reports an emission error. Fields are boxed in the object, so each is
    /// unboxed to its element IR type; nested patterns bind the names they
    /// introduce and contribute a condition. Mirrors `bind_enum_payloads` in
    /// emit.rs.
fn bindEnumPayloads(em: Emitter, span: Span, table: EnumTable, vi: int, payloads: List<Pattern>, sSlot: int) -> int? {
        var ftypes = table.variants[vi].fields
var acc: int? = none
        var pi = 0
        while (pi < len(payloads)) {
            var p = payloads[pi]
            var ft = Ty.Unknown
            if (pi < len(ftypes)) {
                ft = ftypes[pi]
            }
            var rep = elemRep(em, ft, span)
            if (let none = rep) {
                return none
            }
            var repV = ElemRep.ptr()
            if (let some(r) = rep) {
                repV = r
            }
            var idx = temp(em)
            instr(em, IrInstr.Const(idx, IrConst.Int(pi)))
            var sv = load(em, sSlot)
            var raw = externCallT1(em, "pickle_enum_field", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [sv, idx])
            var ir = IrTy.Ptr
            var val = raw
            if (!(repV.isPtr)) {
                val = externCallT1(em, repV.unboxSym, [IrTy.Ptr], repV.ir, [raw])
                ir = repV.ir
            }
            match (p) {
                case Pattern.Wildcard -> {}
                case Pattern.Binding(name, _) -> {
                    var slot = newSlot(em, ir)
                    instr(em, IrInstr.StoreSlot(slot, val))
                    declare(em, name, slot)
                }
                case _ -> {
                    if (!(bindPatternValue(em, p, ft, val, span))) {
                        return none
                    }
                    var root = newSlot(em, IrTy.Ptr)
                    instr(em, IrInstr.StoreSlot(root, val))
var rv = load(em, root)
                    var c = patternTestCond(em, p, ft, rv, span)
                    if (let none = c) {
                        return none
                    }
                    var cv = 0
                    if (let some(x) = c) {
                        cv = x
                    }
                    if (let some(prev) = acc) {
                        acc = combineCond(em, true, prev, cv)
                    } else {
                        acc = cv
                    }
                }
            }
            pi = pi + 1
        }
        if (let some(v) = acc) {
            return v
        }
        -1
    }

    /// The match condition for an enum variant pattern: the scrutinee value
    /// `v` (of enum type `st`) must carry the variant's tag, and nested
    /// payload conditions are folded in. Payload fields are read only inside a
    /// block guarded by the tag equality, so a mismatched variant is never
    /// dereferenced. Mirrors `enum_variant_cond` in emit.rs.
fn enumVariantCond(em: Emitter, p: Pattern, st: Ty, v: int, span: Span) -> int? {
        var path: List<string> = emptyStrs()
        var payloads: List<Pattern> = emptyPatterns()
        match (p) {
            case Pattern.Variant(pa, pl) -> {
                path = pa
                payloads = pl
            }
            case _ -> {
                bad(em, span, "this match pattern is not lowered yet")
                return none
            }
        }
        var isEnumTy = false
        match (st) {
            case Ty.Enum(_, _) -> isEnumTy = true
            case _ -> {}
        }
        if (!isEnumTy) {
            bad(em, span, "this match pattern is not lowered yet")
            return none
        }
        var ename = ""
        match (st) {
            case Ty.Enum(en, _) -> ename = en
            case _ -> {}
        }
        var tableO: EnumTable? = none
        if (let some(entry) = em.resolved.types.get(ename)) {
            match (entry) {
                case TypeTableEntry.Enum(t) -> tableO = t
                case _ -> {}
            }
        }
        if (let none = tableO) {
            bad(em, span, "unknown enum type `" + ename + "`")
            return none
        }
        if (let some(table) = tableO) {
            var vname = ""
            var valid = false
            if (len(path) == 2) {
                vname = path[1]
                valid = true
            }
            if (len(path) == 1) {
                vname = path[0]
                valid = true
            }
            if (!valid) {
                bad(em, span, "invalid enum variant pattern")
                return none
            }
            var vi = -1
            var found = false
            var ix = 0
            for (variant in table.variants) {
                if (variant.name == vname) {
                    vi = ix
                    found = true
                    break
                }
                ix = ix + 1
            }
            if (!found) {
                bad(em, span, "enum `" + ename + "` has no variant `" + vname + "`")
                return none
            }
            var tag = externCallT1(em, "pickle_enum_tag", [IrTy.Ptr], IrTy.Int, [v])
            var viT = constTemp(em, IrConst.Int(vi))
            var eq = temp(em)
            instr(em, IrInstr.BinOp(eq, IrBinOp.Eq, tag, viT))
            var testable = false
            for (pl in payloads) {
                var simple = false
                match (pl) {
                    case Pattern.Binding(_, _) -> simple = true
                    case Pattern.Wildcard -> simple = true
                    case _ -> {}
                }
                if (!simple) {
                    testable = true
                    break
                }
            }
            if (!testable) {
                return eq
            }
            var root = newSlot(em, IrTy.Ptr)
            instr(em, IrInstr.StoreSlot(root, v))
            var resSlot = newSlot(em, IrTy.Bool)
            var onMatch = newBlock(em)
            var onOther = newBlock(em)
            var bjoin = newBlock(em)
            term(em, IrTerm.BranchIf(eq, onMatch, onOther))
            em.cur = onMatch
            var innerConds = bindEnumPayloadCond(em, span, table, vi, payloads, root)
            if (let none = innerConds) {
                return none
            }
            var val = constTemp(em, IrConst.Bool(true))
            if (let some(ic) = innerConds) {
                val = ic
            }
            instr(em, IrInstr.StoreSlot(resSlot, val))
            term(em, IrTerm.Branch(bjoin))
            em.cur = onOther
            var f = constTemp(em, IrConst.Bool(false))
            instr(em, IrInstr.StoreSlot(resSlot, f))
            term(em, IrTerm.Branch(bjoin))
            em.cur = bjoin
            return load(em, resSlot)
        }
        none
    }

    /// Fold the extra match conditions contributed by the nested (non-binding)
    /// payload patterns of enum variant `vi`, whose object pointer sits in the
    /// rooted slot `vSlot`. Binding names are declared separately by
    /// `bindEnumPayloads`; a `-1` return means every payload was a name or
    /// `_`. Mirrors `bind_enum_payload_cond` in emit.rs.
fn bindEnumPayloadCond(em: Emitter, span: Span, table: EnumTable, vi: int, payloads: List<Pattern>, vSlot: int) -> int? {
        var ftypes = table.variants[vi].fields
        var acc: int? = none
        var pi = 0
        while (pi < len(payloads)) {
            var p = payloads[pi]
            var simple = false
            match (p) {
                case Pattern.Binding(_, _) -> simple = true
                case Pattern.Wildcard -> simple = true
                case _ -> {}
            }
            if (simple) {
                pi = pi + 1
                continue
            }
            var ft = Ty.Unknown
            if (pi < len(ftypes)) {
                ft = ftypes[pi]
            }
            var idx = constTemp(em, IrConst.Int(pi))
            var sv = load(em, vSlot)
            var raw = externCallT1(em, "pickle_enum_field", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [sv, idx])
            var pv = raw
            var rep = elemRep(em, ft, span)
            if (let none = rep) {
                return none
            }
            var repV = ElemRep.ptr()
            if (let some(r) = rep) {
                repV = r
            }
            if (!(repV.isPtr)) {
                pv = externCallT1(em, repV.unboxSym, [IrTy.Ptr], repV.ir, [raw])
            }
            var root = newSlot(em, IrTy.Ptr)
            instr(em, IrInstr.StoreSlot(root, pv))
            var rv = load(em, root)
            var isEnumAndVariant = false
            match (ft) {
                case Ty.Enum(_, _) -> {
                    var isVariant = false
                    match (p) {
                        case Pattern.Variant(_, _) -> isVariant = true
                        case _ -> {}
                    }
                    if (isVariant) {
                        isEnumAndVariant = true
                    }
                }
                case _ -> {}
            }
            var c = patternTestCond(em, p, ft, rv, span)
            if (isEnumAndVariant) {
                c = enumVariantCond(em, p, ft, rv, span)
            }
            if (let none = c) {
                return none
            }
            var cv = 0
            if (let some(x) = c) {
                cv = x
            }
            if (let some(prev) = acc) {
                acc = combineCond(em, true, prev, cv)
            } else {
                acc = cv
            }
            pi = pi + 1
        }
        if (let some(v) = acc) {
            return v
        }
        -1
    }

    // ---- calls ----

    /// The first user (non-builtin, non-overloaded) callable for `name`.
    /// Rust's `infos.iter().find(|c| !(c.span.file.0 == 0 && c.span.end == 0))`.
fn userCallableFirst(em: Emitter, name: string) -> CallableInfo? {
        if (let some(infos) = em.resolved.fns.get(name)) {
            for (c in infos) {
                if (!(c.span.start == 0 && c.span.end == 0)) {
                    return c
                }
            }
        }
        none
    }

    /// Is `callee` a general function-typed expression (as opposed to a plain
    /// named user/ctor/builtin call, which has its own static paths)? Mirrors
    /// `is_fn_dispatchable` in emit.rs.
fn isFnDispatchable(em: Emitter, callee: Expr) -> bool {
        match (callee.kind) {
            case ExprKind.Ident(name) -> {
                if (em.irModule.funcsByName.has(name)) {
                    return false
                }
                if (em.classByName.has(name)) {
                    return false
                }
                if (strListHas(["print", "println", "len", "alloc", "free", "view", "assert", "expect", "abs", "range", "min", "max", "clamp", "str", "bytes", "read_file", "write_file", "file_exists", "delete", "list_dir", "mkdir", "stream_open_read", "stream_open_write", "stream_open_append", "stdout_stream", "stderr_stream", "args", "exit", "run_cmd", "run_spawn", "proc_wait", "proc_running", "proc_code", "proc_kill", "proc_out_read", "proc_err_read", "proc_in_write", "proc_in_close", "current_dir", "captureBegin", "captureTake", "gcCollect", "gcAllocationsSinceGc", "gcBytesSinceGc", "gcCollectionCount", "gcSetThreshold"], name)) {
                    return false
                }
            }
            case ExprKind.GenericCall(_, _) -> {
                return false
            }
            case _ -> {}
        }
        var isFn = false
        if (let some(t) = em.types.get(spanKey(callee.span))) {
            match (t) {
                case Ty.Fn(_, _) -> isFn = true
                case _ -> {}
            }
        }
        isFn
    }

    /// The value argument of the outermost `expect(...)` in an assertion chain,
    /// plus whether a `.not()` flips the expectation. Mirrors `peel_expect`.
fn peelExpect(em: Emitter, e: Expr) -> ExpectPeel? {
        match (e.kind) {
            case ExprKind.Call(callee, args) -> {
                var unnamed = false
                if (len(args) == 1) {
                    if (let none = args[0].name) {
                        unnamed = true
                    }
                }
                if (len(args) == 1 && !(args[0].spread) && unnamed) {
                    var calledExpect = false
                    match (callee.kind) {
                        case ExprKind.Ident(n) -> {
                            if (n == "expect") {
                                calledExpect = true
                            }
                        }
                        case _ -> {}
                    }
                    if (calledExpect) {
                        return ExpectPeel(args[0].value, false)
                    }
                }
                if (len(args) == 0) {
                    match (callee.kind) {
                        case ExprKind.Member(object, name) -> {
                            if (name == "not") {
                                var p = peelExpect(em, object)
                                if (let some(pp) = p) {
                                    return ExpectPeel(pp.value, !(pp.negated))
                                }
                            }
                        }
                        case _ -> {}
                    }
                }
                none
            }
            case _ -> none
        }
    }

    /// The value argument of a positional-only one-arg expectation method, or
    /// `none` after emitting a diagnostic. Mirrors `expect_single_arg`.
fn expectSingleArg(em: Emitter, e: Expr, method: string, args: List<CallArg>) -> CallArg? {
        if (!(len(args) == 1)) {
            bad(em, e.span, "`.`" + method + "(expected)` takes exactly one argument")
            return none
        }
        var named = false
        if (let some(_) = args[0].name) {
            named = true
        }
        if (named || args[0].spread) {
            bad(em, args[0].span, "`.`" + method + "()` takes a plain positional argument")
            return none
        }
        args[0]
    }

    /// Reject any argument list for a zero-arg expectation method. Returns
    /// `false` (after a diagnostic) when the list is non-empty.
fn expectNoArgs(em: Emitter, e: Expr, method: string, args: List<CallArg>) -> bool {
        if (len(args) == 0) {
            return true
        }
        bad(em, e.span, "`.`" + method + "()` takes no arguments")
        false
    }
    /// Hash-identity or structural equality condition for `toBe`/`toEqual`.
    /// Mirrors `expect_eq_cond`.
fn expectEqCond(em: Emitter, v: int, it: IrTy, w: int, wit: IrTy, negated: bool, span: Span) -> int? {
        if (managedIr(it) || managedIr(wit)) {
            var res = externCallT1(em, "pickle_expect_obj_eq", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, w])
            return cmpZero(em, res, IrBinOp.Ne, negated)
        }
        var vf = v
        var wf = w
        var unFloat = irTyTag(it) == irTyTag(IrTy.Float) || irTyTag(wit) == irTyTag(IrTy.Float)
        if (unFloat) {
            if (!(irTyTag(it) == irTyTag(IrTy.Float))) {
                if (let some(f) = floatCast(em, v)) {
                    vf = f
                } else {
                    return none
                }
            }
            if (!(irTyTag(wit) == irTyTag(IrTy.Float))) {
                if (let some(f) = floatCast(em, w)) {
                    wf = f
                } else {
                    return none
                }
            }
        }
        var dst = temp(em)
        instr(em, IrInstr.BinOp(dst, flipCmp(IrBinOp.Eq, negated), vf, wf))
        dst
    }

    /// `int` -> `float` promotion (the IR `Itof`). Mirrors `float_cast`.
fn floatCast(em: Emitter, v: int) -> int? {
        var dst = temp(em)
        instr(em, IrInstr.Itof(dst, v))
        dst
    }

    /// Promote `v` to `float` unless its IR type is already `Float`. Mirrors
    /// `emit.rs::coerce_to_float`.
fn coerceToFloat(em: Emitter, v: int, ty: IrTy?) -> int {
        var isFloat = false
        if (let some(t) = ty) {
            match (t) {
                case IrTy.Float -> isFloat = true
                case _ -> {}
            }
        }
        if (isFloat) {
            return v
        }
        var d = floatCast(em, v)
        if (let some(x) = d) {
            return x
        }
        return v
    }

    /// `**`: integer operands stay integral (`pickle_int_pow`); a float on
    /// either side routes through `pickle_float_pow`, promoting the other
    /// operand with an `Itof`. Mirrors `emit.rs` `AstBinOp::Pow`.
fn emitPow(em: Emitter, e: Expr, lhs: Expr, rhs: Expr) -> int? {
        var aO = expr(em, lhs)
        if (let none = aO) {
            return none
        }
        var bO = expr(em, rhs)
        if (let none = bO) {
            return none
        }
        var a = 0
        if (let some(v) = aO) {
            a = v
        }
        var b = 0
        if (let some(v) = bO) {
            b = v
        }
        var aT = irty(em, lhs.span)
        var bT = irty(em, rhs.span)
        var useFloat = false
        if (let some(t) = aT) {
            match (t) {
                case IrTy.Float -> useFloat = true
                case _ -> {}
            }
        }
        if (let some(t) = bT) {
            match (t) {
                case IrTy.Float -> useFloat = true
                case _ -> {}
            }
        }
        if (useFloat) {
            var af = coerceToFloat(em, a, aT)
            var bf = coerceToFloat(em, b, bT)
            return externCallT1(em, "pickle_float_pow", [IrTy.Float, IrTy.Float], IrTy.Float, [af, bf])
        }
        return externCallT1(em, "pickle_int_pow", [IrTy.Int, IrTy.Int], IrTy.Int, [a, b])
    }

    /// `in`: the right operand selects the container. Mirrors `emit.rs`
    /// `AstBinOp::In` - a `Map` keys through `pickle_map_has`, a `List` routes
    /// through `pickle_list_contains`, a `string` through `pickle_str_contains`.
fn emitIn(em: Emitter, e: Expr, lhs: Expr, rhs: Expr) -> int? {
        if (let some(t) = tyOf(em, rhs.span)) {
            match (t) {
                case Ty.Map(k, _) -> {
                    if (let some(krep) = keyRep(em, k, rhs.span)) {
                        return emitInContains(em, e, lhs, rhs, krep, k, "pickle_map_has")
                    }
                    return none
                }
                case Ty.List(el) -> {
                    if (let some(erep) = elemRep(em, el, rhs.span)) {
                        return emitInContains(em, e, lhs, rhs, erep, el, "pickle_list_contains")
                    }
                    return none
                }
                case Ty.String -> {
                    var needle = expr(em, lhs)
                    if (let some(nv) = needle) {
                        var hay = expr(em, rhs)
                        if (let some(hv) = hay) {
                            return externCallT1(em, "pickle_str_contains", [IrTy.Str, IrTy.Str], IrTy.Bool, [hv, nv])
                        }
                    }
                    return none
                }
                case _ -> {}
            }
        }
        bad(em, e.span, "`in` requires a `List`, `Map`, or `string` on the right")
        return none
    }

    /// Shared tail of the `Map`/`List` `in` arms: evaluate the needle and the
    /// container, box the needle to the container's element representation, and
    /// emit the containment call.
fn emitInContains(em: Emitter, e: Expr, lhs: Expr, rhs: Expr, rep: ElemRep, elemTy: Ty, symbol: string) -> int? {
        var needle = expr(em, lhs)
        if (let none = needle) {
            return none
        }
        var coll = expr(em, rhs)
        if (let none = coll) {
            return none
        }
        var nv = 0
        if (let some(v) = needle) {
            nv = v
        }
        var cv = 0
        if (let some(v) = coll) {
            cv = v
        }
        var nTy = elemTy
        if (let some(x) = tyOf(em, lhs.span)) {
            nTy = x
        }
        if (let some(key) = packMapKey(em, rep, nv, nTy, lhs.span)) {
            return externCallT1(em, symbol, [IrTy.Ptr, IrTy.Ptr], IrTy.Bool, [cv, key])
        }
        return none
    }

    /// `<-`: a channel send, a statement with a unit result. The compiler
    /// yields the value-typed `0` so an expression position stays well-formed.
    /// Mirrors `emit.rs` `AstBinOp::Send`.
fn emitSend(em: Emitter, lhs: Expr, rhs: Expr) -> int? {
        var ch = expr(em, lhs)
        if (let none = ch) {
            return none
        }
        var v = expr(em, rhs)
        if (let none = v) {
            return none
        }
        var chV = 0
        if (let some(x) = ch) {
            chV = x
        }
        var vV = 0
        if (let some(x) = v) {
            vV = x
        }
        externCallVoid(em, "pickle_channel_send", [IrTy.Int, IrTy.Int], [chV, vV])
        return intConst(em, 0)
    }

    /// Truthiness as a branchable condition of a raw value temp. `need` is
    /// `true` when a truthy value passes (folded through `.not()`). Mirrors
    /// `expect_truthy`.
fn expectTruthy(em: Emitter, v: int, it: IrTy, need: bool, span: Span) -> int? {
        match (it) {
            case IrTy.Bool -> {
                var dst = temp(em)
                var z = boolConst(em, false)
                instr(em, IrInstr.BinOp(dst, flipCmp(IrBinOp.Ne, !need), v, z))
                dst
            }
            case IrTy.Char -> {
                var dst = temp(em)
                var z = charConst(em, 0)
                instr(em, IrInstr.BinOp(dst, flipCmp(IrBinOp.Ne, !need), v, z))
                dst
            }
            case IrTy.Int -> {
                var dst = temp(em)
                var zero = intConst(em, 0)
                instr(em, IrInstr.BinOp(dst, flipCmp(IrBinOp.Ne, !need), v, zero))
                dst
            }
            case IrTy.Float -> {
                var dst = temp(em)
                var z = floatConst(em, 0.0)
                instr(em, IrInstr.BinOp(dst, flipCmp(IrBinOp.Ne, !need), v, z))
                dst
            }
            case IrTy.Str | IrTy.Ptr -> {
                var lenv = externCallT1(em, "pickle_str_len", [IrTy.Ptr], IrTy.Int, [v])
                cmpZero(em, lenv, IrBinOp.Ne, !need)
            }
            case IrTy.Unit -> cmpZero(em, intConst(em, 0), IrBinOp.Ne, !need)
        }
    }

    /// Render a value temp as text for an `Expected:`/`Received:` line.
    /// Mirrors `expect_str`.
fn expectStr(em: Emitter, t: int, it: IrTy, span: Span) -> int? {
        match (it) {
            case IrTy.Int -> externCallT1(em, "pickle_str_from_i64", [IrTy.Int], IrTy.Str, [t])
            case IrTy.Float -> externCallT1(em, "pickle_str_from_f64", [IrTy.Float], IrTy.Str, [t])
            case IrTy.Bool -> externCallT1(em, "pickle_str_from_bool", [IrTy.Bool], IrTy.Str, [t])
            case IrTy.Char -> externCallT1(em, "pickle_str_from_char", [IrTy.Char], IrTy.Str, [t])
            case IrTy.Str | IrTy.Ptr -> externCallT1(em, "pickle_expect_display", [IrTy.Ptr], IrTy.Str, [t])
            case IrTy.Unit -> strConst(em, "none")
        }
    }

    /// Lower one `expect(...)` assertion: the `(ok, expected, received)` triple
    /// decoded by the method name, a `pickle_test_fail_obj(msg)` failure branch,
    /// and the "Expected:/Received:" message rendering. Mirrors `expect_assert`.
fn expectAssert(em: Emitter, e: Expr, value: Expr, method: string, args: List<CallArg>, negated: bool) -> int? {
        if (!icePoke(em, "expectAssert")) {
            return none
        }
for (a in args) {
            var named = false
            if (let some(_) = a.name) {
                named = true
            }
            if (a.spread || named) {
                bad(em, e.span, "expectation methods take plain positional arguments")
                return none
            }
        }
        var vt = Ty.Unknown
        if (let some(t) = tyOf(em, value.span)) {
            vt = t
        }
        var it = IrTy.Unit
        if (let some(iv) = irty(em, value.span)) {
            it = iv
        } else {
            return none
        }
        var v = -1
        if (let some(vv) = expr(em, value)) {
            v = vv
        } else {
            return none
        }
        var ok = -1
        var expected = -1
        var received = -1
        var badMethod = ""
        match (method) {
            case "toBe" | "toEqual" -> {
                var av = expectSingleArg(em, e, method, args)
                if (let some(arg) = av) {
                    var at = -1
                    if (let some(avt) = expr(em, arg.value)) {
                        at = avt
                    } else {
                        return none
                    }
                    var aIt = IrTy.Unit
                    if (let some(iv) = irty(em, arg.value.span)) {
                        aIt = iv
                    } else {
                        return none
                    }
                    var ev = -1
                    if (let some(x) = expectStr(em, at, aIt, arg.value.span)) {
                        ev = x
                    } else {
                        return none
                    }
                    var rv = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rv = x
                    } else {
                        return none
                    }
                    var okv = expectEqCond(em, v, it, at, aIt, negated, e.span)
                    if (let some(o) = okv) {
                        ok = o
                    } else {
                        return none
                    }
                    expected = ev
                    received = rv
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toBeTruthy" | "toBeFalsy" -> {
                if (expectNoArgs(em, e, method, args)) {
                    var rvT = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rvT = x
                    } else {
                        return none
                    }
                    var wantTruthy = method == "toBeTruthy"
                    var need = (wantTruthy && !(negated)) || (!(wantTruthy) && negated)
                    var okT = expectTruthy(em, v, it, need, e.span)
                    if (let some(o) = okT) {
                        ok = o
                    } else {
                        return none
                    }
                    if (wantTruthy) {
                        expected = strConst(em, "true")
                    } else {
                        expected = strConst(em, "false")
                    }
                    received = rvT
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toBeNull" -> {
                if (expectNoArgs(em, e, method, args)) {
                    var rvN = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rvN = x
                    } else {
                        return none
                    }
                    var nul = nullTemp(em)
                    if (let some(n) = nul) {
                        var res = externCallT1(em, "pickle_expect_obj_eq", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, n])
                        var okN = cmpZero(em, res, IrBinOp.Ne, negated)
                        if (let some(o) = okN) {
                            ok = o
                        } else {
                            return none
                        }
                        expected = strConst(em, "none")
                        received = rvN
                    } else {
                        return none
                    }
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toExist" -> {
                if (expectNoArgs(em, e, method, args)) {
                    var rvE = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rvE = x
                    } else {
                        return none
                    }
                    var nul = nullTemp(em)
                    if (let some(n) = nul) {
                        var res = externCallT1(em, "pickle_expect_obj_eq", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, n])
                        var okE = cmpZero(em, res, IrBinOp.Eq, negated)
                        if (let some(o) = okE) {
                            ok = o
                        } else {
                            return none
                        }
                        expected = strConst(em, "a non-none value")
                        received = rvE
                    } else {
                        return none
                    }
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toHaveLength" -> {
                var avL = expectSingleArg(em, e, method, args)
                if (let some(arg) = avL) {
                    var n = -1
                    if (let some(nv) = expr(em, arg.value)) {
                        n = nv
                    } else {
                        return none
                    }
                    var nIt = IrTy.Unit
                    if (let some(iv) = irty(em, arg.value.span)) {
                        nIt = iv
                    } else {
                        return none
                    }
                    var lenT = -1
                    var badLen = false
                    match (vt) {
                        case Ty.String -> lenT = externCallT1(em, "pickle_str_len", [IrTy.Str], IrTy.Int, [v])
                        case Ty.List(_) -> lenT = externCallT1(em, "pickle_list_len", [IrTy.Ptr], IrTy.Int, [v])
                        case Ty.Map(_, _) -> lenT = externCallT1(em, "pickle_map_len", [IrTy.Ptr], IrTy.Int, [v])
                        case _ -> {
                            badLen = true
                            lenT = lenT
                        }
                    }
                    if (badLen) {
                        bad(em, value.span, "`.toHaveLength()` needs a string, list, or map value")
                        return none
                    }
                    var eq = temp(em)
                    instr(em, IrInstr.BinOp(eq, flipCmp(IrBinOp.Eq, negated), lenT, n))
                    ok = eq
                    var evL = -1
                    if (let some(x) = expectStr(em, n, nIt, arg.value.span)) {
                        evL = x
                    } else {
                        return none
                    }
                    var rvL = -1
                    if (let some(x) = expectStr(em, lenT, IrTy.Int, value.span)) {
                        rvL = x
                    } else {
                        return none
                    }
                    expected = evL
                    received = rvL
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toContain" -> {
                var avC = expectSingleArg(em, e, method, args)
                if (let some(arg) = avC) {
                    var needle = -1
                    if (let some(nv) = expr(em, arg.value)) {
                        needle = nv
                    } else {
                        return none
                    }
                    var needleIt = IrTy.Unit
                    if (let some(iv) = irty(em, arg.value.span)) {
                        needleIt = iv
                    } else {
                        return none
                    }
                    var res = -1
                    var badContain = false
                    match (vt) {
                        case Ty.String -> res = externCallT1(em, "pickle_expect_str_contains", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, needle])
                        case Ty.List(_) -> {
                            var nty = Ty.Unknown
                            if (let some(gt) = tyOf(em, arg.value.span)) {
                                nty = gt
                            }
                            var nd = -1
                            if (let some(w) = optionWrap(em, needle, nty, arg.value.span)) {
                                nd = w
                            } else {
                                return none
                            }
                            res = externCallT1(em, "pickle_expect_list_contains", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, nd])
                        }
                        case _ -> {
                            badContain = true
                            res = res
                        }
                    }
                    if (badContain) {
                        bad(em, value.span, "`.toContain()` needs a string or list value")
                        return none
                    }
                    var okC = cmpZero(em, res, IrBinOp.Ne, negated)
                    if (let some(o) = okC) {
                        ok = o
                    } else {
                        return none
                    }
                    var evC = -1
                    if (let some(x) = expectStr(em, needle, needleIt, arg.value.span)) {
                        evC = x
                    } else {
                        return none
                    }
                    var rvC = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rvC = x
                    } else {
                        return none
                    }
                    expected = evC
                    received = rvC
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toBeGreaterThan" | "toBeLessThan" -> {
                var avG = expectSingleArg(em, e, method, args)
                if (let some(arg) = avG) {
                    var at = -1
                    if (let some(av) = expr(em, arg.value)) {
                        at = av
                    } else {
                        return none
                    }
                    var aIt = IrTy.Unit
                    if (let some(iv) = irty(em, arg.value.span)) {
                        aIt = iv
                    } else {
                        return none
                    }
                    var vf = v
                    var af = at
                    var unFloat = irTyTag(it) == irTyTag(IrTy.Float) || irTyTag(aIt) == irTyTag(IrTy.Float)
                    if (unFloat) {
                        if (!(irTyTag(it) == irTyTag(IrTy.Float))) {
                            if (let some(f) = floatCast(em, v)) {
                                vf = f
                            } else {
                                return none
                            }
                        }
                        if (!(irTyTag(aIt) == irTyTag(IrTy.Float))) {
                            if (let some(f) = floatCast(em, at)) {
                                af = f
                            } else {
                                return none
                            }
                        }
                    }
                    var cmp = temp(em)
                    var cmpOp = IrBinOp.Gt
                    if (method == "toBeLessThan") {
                        cmpOp = IrBinOp.Lt
                    }
                    instr(em, IrInstr.BinOp(cmp, flipCmp(cmpOp, negated), vf, af))
                    var opTxt = -1
                    if (method == "toBeGreaterThan") {
                        opTxt = strConst(em, "> ")
                    } else {
                        opTxt = strConst(em, "< ")
                    }
                    var dv = -1
                    if (let some(x) = expectStr(em, at, aIt, arg.value.span)) {
                        dv = x
                    } else {
                        return none
                    }
                    var evG = -1
                    if (let some(x) = concatStr(em, [opTxt, dv])) {
                        evG = x
                    } else {
                        return none
                    }
                    var rvG = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rvG = x
                    } else {
                        return none
                    }
                    ok = cmp
                    expected = evG
                    received = rvG
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case other -> {
                bad(em, e.span, "unknown expectation method `.`" + other + "()`")
                badMethod = other
            }
        }
        if (len(badMethod) > 0) {
            return none
        }
        var head = strConst(em, "Expected:\n")
        var mid = strConst(em, "\n\nReceived:\n")
        var tail = strConst(em, "\n")
        var msg = -1
        if (let some(mv) = concatStr(em, [head, expected, mid, received, tail])) {
            msg = mv
        } else {
            return none
        }
        var cont = newBlock(em)
        var fail = newBlock(em)
        term(em, IrTerm.BranchIf(ok, cont, fail))
        em.cur = fail
        externCallVoid(em, "pickle_test_fail_obj", [IrTy.Ptr], [msg])
        term(em, IrTerm.Branch(cont))
        em.cur = cont
        return unitTemp(em)
    }

    /// The argument of a call into a `&T` parameter slot: an explicit/expected
    /// reference is passed by identity (managed) or by address (scalar local),
    /// anything else by value. Mirrors `borrow_arg` in emit.rs.
fn borrowArg(em: Emitter, src: Ty?, a: CallArg) -> int? {
        if (!icePoke(em, "borrowArg")) {
            return none
        }
        if (let some(hint) = src) {
            var isFn = false
            match (hint) {
                case Ty.Fn(_, _) -> isFn = true
                case _ -> {}
            }
            if (isFn) {
                var gv = genericFnArgValue(em, a.value, hint)
                if (let some(vv) = gv) {
                    return vv
                }
            }
        }
        if (let some(rf) = src) {
            var inner = Ty.Unknown
            var isRef = false
            match (rf) {
                case Ty.Ref(iner) -> {
                    inner = iner
                    isRef = true
                }
                case _ -> {}
            }
            if (isRef) {
                var at = tyOf(em, a.value.span)
                if (let some(at2) = at) {
                    if (tyEq(at2, inner)) {
                        if (let none = scalarIr(inner)) {
                            return expr(em, a.value)
                        }
                        match (a.value.kind) {
                            case ExprKind.Ident(name) -> {
                                var slotO = lookup(em, name)
                                if (let some(slot) = slotO) {
                                    var dst = temp(em)
                                    instr(em, IrInstr.LocalAddr(dst, slot))
                                    return dst
                                }
                                bad(em, a.value.span, "cannot borrow unknown `" + name + "`")
                                return none
                            }
                            case _ -> {
                                bad(em, a.value.span, "implicitly borrowing a scalar needs a plain local variable")
                                return none
                            }
                        }
                    }
                }
            }
        }
        expr(em, a.value)
    }

/// Lower a call whose arguments include a spread (`...list`): build the
    /// boxed argument list, check the spread element count at runtime, and
    /// call the shared spread trampoline of the target. Mirrors
    /// `spread_static_call` in emit.rs.
fn spreadStaticCall(em: Emitter, e: Expr, span: Span, fid: int, pty: List<Ty>, ret: Ty, receiver: int?, args: List<CallArg>) -> int? {
        var refParam = false
        for (t in pty) {
            match (t) {
                case Ty.Ref(_) -> refParam = true
                case _ -> {}
            }
        }
        if (refParam) {
            bad(em, span, "spreading into a `&T` parameter is not lowered yet")
            return none
        }
        var fs = em.fsource.get(fid)
        if (let some(src) = fs) {
            var tl: FnDecl? = none
            match (src) {
                case FnSource.TopLevel(f) -> tl = f
                case _ -> {}
            }
            if (let some(f) = tl) {
                var hasDef = false
                for (p in f.params) {
                    if (let some(_) = p.default) {
                        hasDef = true
                    }
                }
                if (hasDef) {
                    bad(em, span, "spreading into a parameter with a default value is not lowered yet")
                    return none
                }
            }
        }
        var finf = em.finfo.get(fid)
        if (let some(info) = finf) {
            var hasRest = false
            for (p in info.params) {
                if (p.rest) {
                    hasRest = true
                }
            }
            if (hasRest) {
                bad(em, span, "spreading into a rest parameter is only lowered for `println`")
                return none
            }
        }
        var m = 0
        while (m < len(args) && !args[m].spread) {
            m = m + 1
        }
        if (m > len(pty)) {
            bad(em, span, "too many arguments for this call")
            return none
        }
        var spArgO: CallArg? = none
        if (m < len(args)) {
            spArgO = args[m]
        }
        var foundSpread = false
        if (let some(sa) = spArgO) {
            if (sa.spread) {
                foundSpread = true
            }
        }
        if (!foundSpread) {
            bad(em, span, "internal error: missing spread argument")
            return none
        }
        var spArg = CallArg(none, Expr(span, ExprKind.Ident("")), true, span)
        if (let some(sa) = spArgO) {
            spArg = sa
        }
        var matchedList = false
        var elemTy = Ty.Unknown
        if (let some(t) = tyOf(em, spArg.value.span)) {
            match (t) {
                case Ty.List(inner) -> {
                    matchedList = true
                    elemTy = inner
                }
                case _ -> {}
            }
        }
        if (!matchedList) {
            bad(em, spArg.span, "a spread argument must be a `List`")
            return none
        }
        var erepO = elemRep(em, elemTy, spArg.span)
        if (let none = erepO) {
            return none
        }
        var erep = ElemRep.ptr()
        if (let some(re) = erepO) {
            erep = re
        }
        var j = m
        while (j < len(pty)) {
            var pre = elemRep(em, pty[j], spArg.span)
            if (let none = pre) {
                return none
            }
            var prev = ElemRep.ptr()
            if (let some(re) = pre) {
                prev = re
            }
            if (!elemRepSame(prev, erep)) {
                bad(em, span, "spreading over parameters with mixed element representations is not lowered yet")
                return none
            }
            j = j + 1
        }
        var retM = mapTy(em, ret, span)
        if (let none = retM) {
            bad(em, span, "spread call return type is not lowered yet")
            return none
        }
        var retIr = IrTy.Unit
        if (let some(r) = retM) {
            retIr = r
        }
        var tramp = 0
        var trampO = em.spreadTramps.get(fid)
        if (let some(t) = trampO) {
            tramp = t
        } else {
            var recvFlag = false
            if (let some(_) = receiver) {
                recvFlag = true
            }
            tramp = pushClassFunc(em, "fn.spread", "pkl_sptramp_" + str(fid), FnSource.SpreadTrampoline(span, fid, pty, ret, recvFlag))
            em.spreadTramps[fid] = tramp
        }
        var resSlot = newSlot(em, retIr)
        var cap = intConst(em, len(pty))
        var xs = externCallT1(em, "pickle_list_new", [IrTy.Int], IrTy.Ptr, [cap])
        var base = 0
        if (let some(_) = receiver) {
            base = 1
        }
        var fparams = em.irModule.funcs[fid].params
        var i = 0
        while (i < m) {
            var a = args[i]
            var srcO: Ty? = none
            if (let some(v) = em.srcParamTys.get(fid)) {
                if (i < len(v)) {
                    srcO = v[i]
                }
            }
            var t = -1
            if (let some(tv) = borrowArg(em, srcO, a)) {
                t = tv
            } else {
                return none
            }
            var fparamTy: IrTy? = none
            if (base + i < len(fparams)) {
                fparamTy = fparams[base + i].ty
            } else {
                if (let some(s) = srcO) {
                    fparamTy = mapTy(em, s, a.value.span)
                }
            }
            var isRef2 = false
            if (let some(sr) = srcO) {
                match (sr) {
                    case Ty.Ref(_) -> isRef2 = true
                    case _ -> {}
                }
            }
            var srcVal = t
            if (!isRef2) {
                var fparamIsPtr = false
                if (let some(ft) = fparamTy) {
                    if (irTyTag(ft) == irTyTag(IrTy.Ptr)) {
                        fparamIsPtr = true
                    }
                }
                if (fparamIsPtr) {
                    var vt = Ty.Unknown
                    if (let some(gt) = tyOf(em, a.value.span)) {
                        vt = gt
                    }
                    var w = optionWrap(em, t, vt, a.value.span)
                    if (let some(wv) = w) {
                        srcVal = wv
                    } else {
                        return none
                    }
                }
            }
            var repI = elemRep(em, pty[i], a.value.span)
            if (let none = repI) {
                return none
            }
            var repV = ElemRep.ptr()
            if (let some(re) = repI) {
                repV = re
            }
            if (repV.isPtr) {
                externCallVoid(em, "pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [xs, srcVal])
            } else {
                var bx = externCallT1(em, repV.boxSym, [repV.ir], IrTy.Ptr, [srcVal])
                externCallVoid(em, "pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [xs, bx])
            }
            i = i + 1
        }
        var sp = expr(em, spArg.value)
        if (let none = sp) {
            return none
        }
        var spV = 0
        if (let some(sv) = sp) {
            spV = sv
        }
        var n = externCallT1(em, "pickle_list_len", [IrTy.Ptr], IrTy.Int, [spV])
        var r = intConst(em, len(pty) - m)
        var ok = temp(em)
        instr(em, IrInstr.BinOp(ok, IrBinOp.Eq, n, r))
        var rOk = newBlock(em)
        var rPanic = newBlock(em)
        var join = newBlock(em)
        term(em, IrTerm.BranchIf(ok, rOk, rPanic))
        em.cur = rPanic
        externCallVoid(em, "pickle_panic_arity_diff", emptyIrTys(), emptyInts())
        term(em, IrTerm.Branch(join))
        em.cur = rOk
        var rMissing = len(pty) - m
        var k = 0
        while (k < rMissing) {
            var idx = intConst(em, k)
            var raw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [spV, idx])
            externCallVoid(em, "pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [xs, raw])
            k = k + 1
        }
        var callArgs = emptyInts()
        if (let some(recv) = receiver) {
            callArgs.push(recv)
        }
        callArgs.push(xs)
        var dst = temp(em)
        instr(em, IrInstr.Call(dst, Callee.Func(tramp), callArgs))
        // The trampoline tail-calls the target, so a throw from the callee comes
        // back with the flag set on *this* function, and the store below would
        // otherwise write a garbage result into the slot.
        guardPropagation(em, tramp)
        instr(em, IrInstr.StoreSlot(resSlot, dst))
        term(em, IrTerm.Branch(join))
        em.cur = join
        load(em, resSlot)
    }

    /// `...xs` as a `print`/`println` operand: emit a runtime loop that
    /// prints every element individually, unboxing scalar element reps and
    /// passing managed elements straight to `pickle_print_obj`. An empty
    /// spread prints nothing. Mirrors `print_spread_list` in emit.rs.
fn printSpreadList(em: Emitter, span: Span, sp: int, elem: Ty) -> bool {
        var sym = "pickle_print_obj"
        var printIr = IrTy.Ptr
        match (elem) {
            case Ty.Int -> {
                sym = "pickle_print_i64"
                printIr = IrTy.Int
            }
            case Ty.Float -> {
                sym = "pickle_print_f64"
                printIr = IrTy.Float
            }
            case Ty.Bool -> {
                sym = "pickle_print_bool"
                printIr = IrTy.Bool
            }
            case Ty.Byte -> {
                sym = "pickle_print_byte"
                printIr = IrTy.Int
            }
            case Ty.Char -> {
                sym = "pickle_print_char"
                printIr = IrTy.Char
            }
            case _ -> {}
        }
        var repO = elemRep(em, elem, span)
        if (let none = repO) {
            return false
        }
        var rep = ElemRep.ptr()
        if (let some(re) = repO) {
            rep = re
        }
        var seqSlot = newSlot(em, IrTy.Ptr)
        var idxSlot = newSlot(em, IrTy.Int)
        var lenSlot = newSlot(em, IrTy.Int)
        instr(em, IrInstr.StoreSlot(seqSlot, sp))
        var zero = temp(em)
        instr(em, IrInstr.Const(zero, IrConst.Int(0)))
        instr(em, IrInstr.StoreSlot(idxSlot, zero))
        var seqL = load(em, seqSlot)
        var lenT = externCallT1(em, "pickle_list_len", [IrTy.Ptr], IrTy.Int, [seqL])
        instr(em, IrInstr.StoreSlot(lenSlot, lenT))
        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var nextId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var curT = load(em, idxSlot)
        var endL = load(em, lenSlot)
        var cmp = temp(em)
        instr(em, IrInstr.BinOp(cmp, IrBinOp.Lt, curT, endL))
        term(em, IrTerm.BranchIf(cmp, bodyId, endId))
        em.cur = bodyId
        var curI = load(em, idxSlot)
        var seqL2 = load(em, seqSlot)
        var raw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [seqL2, curI])
        var isScalarElem = false
        match (elem) {
            case Ty.Int | Ty.Float | Ty.Bool | Ty.Byte | Ty.Char -> isScalarElem = true
            case _ -> {}
        }
        var v = raw
        if (!rep.isPtr && isScalarElem) {
            v = externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
        }
        externCallVoid(em, sym, [printIr], [v])
        term(em, IrTerm.Branch(nextId))
        em.cur = nextId
        var c = load(em, idxSlot)
        var one = temp(em)
        instr(em, IrInstr.Const(one, IrConst.Int(1)))
        var nxt = temp(em)
        instr(em, IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        instr(em, IrInstr.StoreSlot(idxSlot, nxt))
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// The call-lowering hub. Mirrors `call` in emit.rs: expect-method
    /// dispatch, `.free()` on `#[manualAlloc]`, `Enum.Variant(...)` ctors,
    /// plain member calls, generic calls (explicit and inferred), fn-value
    /// dispatch, plain user functions, class/struct ctors, then the builtins.
fn call(em: Emitter, e: Expr, callee: Expr, args: List<CallArg>) -> int? {
        if (em.iceDepth > 150) {
            return none
        }
        em.iceDepth = em.iceDepth + 1
        em.icePath.push("call")
        var r = call1(em, e, callee, args)
        em.iceDepth = em.iceDepth - 1
        r
    }

fn call1(em: Emitter, e: Expr, callee: Expr, args: List<CallArg>) -> int? {
        if (!icePoke(em, "call1")) {
            return none
        }
        match (callee.kind) {
            case ExprKind.Member(object, name) -> {
                if (isExpectMethod(name)) {
                    var p = peelExpect(em, object)
                    if (let some(pe) = p) {
                        return expectAssert(em, e, pe.value, name, args, pe.negated)
                    }
                }
                if (name == "free") {
                    match (object.kind) {
                        case ExprKind.Ident(id) -> {
                            if (isManual(em, id)) {
                                if (!(len(args) == 0)) {
                                    bad(em, e.span, "`free()` takes no arguments")
                                    return none
                                }
                                var obj = -1
                                if (let some(ov) = expr(em, object)) {
                                    obj = ov
                                } else {
                                    return none
                                }
                                externCallVoid(em, "pickle_manual_free", [IrTy.Ptr], [obj])
                                return unitTemp(em)
                            }
                        }
                        case _ -> {}
                    }
                }
                var enO = exprKindIdentName(object)
                if (let some(enumName) = enO) {
                    if (let some(entry) = em.resolved.types.get(enumName)) {
                        match (entry) {
                            case TypeTableEntry.Enum(t) -> {
                                return enumCtor(em, e, t, name, args)
                            }
                            case _ -> {}
                        }
                    }
                }
                return methodCall(em, e, object, name, args)
            }
            case ExprKind.GenericCall(name2, typeArgs) -> {
                return genericCall(em, e, name2, typeArgs, args)
            }
            case ExprKind.Ident(cname) -> {
                var inf = userCallableFirst(em, cname)
                if (let some(info) = inf) {
                    if (!(len(info.generics) == 0)) {
                        var argTys = inferGenericFnArgs(em, e.span, info, args)
                        if (let some(aa) = argTys) {
                            return genericFnCall(em, e, info, aa, args)
                        }
                        return none
                    }
                }
            }
            case _ -> {}
        }
        if (let some(cid) = em.owner) {
            var enM = exprKindIdentName(callee)
            if (let some(mname) = enM) {
                var mvO = em.methodIds.get(pairKey(str(cid), mname))
                if (let some(mv) = mvO) {
                    if (mv.isStatic) {
                        return callMethod(em, e, mv.fid, args, none)
                    }
                    var th = thisValue(em, e)
                    if (let none = th) {
                        return none
                    }
                    var thV = 0
                    if (let some(t) = th) {
                        thV = t
                    }
                    var vb = em.virtualDispatch.get(pairKey(str(cid), mname))
                    if (let some(branches) = vb) {
                        if (!(len(branches) == 0)) {
                            return virtualMethodCall(em, e, mv.fid, args, thV, branches)
                        }
                    }
                    return callMethod(em, e, mv.fid, args, thV)
                }
            }
        }
        if (isFnDispatchable(em, callee)) {
            return fnValueCall(em, e, callee, args)
        }
        var enO2 = exprKindIdentName(callee)
        if (let none = enO2) {
            bad(em, e.span, "only plain function calls are lowered yet")
            return none
        }
        var name = ""
        if (let some(nm) = enO2) {
            name = nm
        }
var fidO = em.irModule.funcsByName.get(name)
        if (let some(fid) = fidO) {
            if (anySpread(args)) {
                var pty = srcParamList(em, fid)
                var rt = callRetFor(em, fid)
                return spreadStaticCall(em, e, e.span, fid, pty, rt, none, args)
            }
            var fparams = em.irModule.funcs[fid].params
            var argTemps = emptyInts()
            var i = 0
            while (i < len(args)) {
                var a = args[i]
                var srcO: Ty? = none
                if (let some(v) = em.srcParamTys.get(fid)) {
                    if (i < len(v)) {
                        srcO = v[i]
                    }
                }
                var isRef = false
                if (let some(sr) = srcO) {
                    match (sr) {
                        case Ty.Ref(_) -> isRef = true
                        case _ -> {}
                    }
                }
                var t = -1
                if (let some(tv) = borrowArg(em, srcO, a)) {
                    t = tv
                } else {
                    return none
                }
                var fparamIsPtr = false
                if (i < len(fparams)) {
                    if (irTyTag(fparams[i].ty) == irTyTag(IrTy.Ptr)) {
                        fparamIsPtr = true
                    }
                }
                var finalT = t
                if (!isRef && fparamIsPtr) {
                    var vt = Ty.Unknown
                    if (let some(gt) = tyOf(em, a.value.span)) {
                        vt = gt
                    }
                    if (let some(w) = optionWrap(em, t, vt, a.value.span)) {
                        finalT = w
                    } else {
                        return none
                    }
                }
                argTemps.push(finalT)
                i = i + 1
            }
            var dst = temp(em)
            instr(em, IrInstr.Call(dst, Callee.Func(fid), argTemps))
            guardPropagation(em, fid)
            return dst
        }
var cidO = em.classByName.get(name)
        if (let some(cid) = cidO) {
            var ctorO = em.ctorIds.get(cid)
            if (let some(fid) = ctorO) {
                if (anySpread(args)) {
                    var pty = srcParamList(em, fid)
                    return spreadStaticCall(em, e, e.span, fid, pty, Ty.Class(name, emptyTys()), none, args)
                }
                var fparams = em.irModule.funcs[fid].params
                var argTemps = emptyInts()
                var i = 0
                while (i < len(args)) {
                    var a = args[i]
                    var srcO: Ty? = none
                    if (let some(v) = em.srcParamTys.get(fid)) {
                        if (i < len(v)) {
                            srcO = v[i]
                        }
                    }
                    var isRef = false
                    if (let some(sr) = srcO) {
                        match (sr) {
                            case Ty.Ref(_) -> isRef = true
                            case _ -> {}
                        }
                    }
                    var t = -1
                    if (let some(tv) = borrowArg(em, srcO, a)) {
                        t = tv
                    } else {
                        return none
                    }
                    var fparamIsPtr = false
                    if (i < len(fparams)) {
                        if (irTyTag(fparams[i].ty) == irTyTag(IrTy.Ptr)) {
                            fparamIsPtr = true
                        }
                    }
                    var finalT = t
                    if (!isRef && fparamIsPtr) {
                        var vt = Ty.Unknown
                        if (let some(gt) = tyOf(em, a.value.span)) {
                            vt = gt
                        }
                        if (let some(w) = optionWrap(em, t, vt, a.value.span)) {
                            finalT = w
                        } else {
                            return none
                        }
                    }
                    argTemps.push(finalT)
                    i = i + 1
                }
                var dst = temp(em)
                instr(em, IrInstr.Call(dst, Callee.Func(fid), argTemps))
                guardPropagation(em, fid)
                return dst
            }
            bad(em, e.span, "`" + name + "` has no constructor")
            return none
        }
        match (name) {
            case "assert" -> {
                if (len(args) == 0 || len(args) > 2) {
                    bad(em, e.span, "`assert(cond, msg?)` takes a condition and an optional message")
                    return none
                }
                var cond = -1
                if (let some(cv) = expr(em, args[0].value)) {
                    cond = cv
                } else {
                    return none
                }
                var cont = newBlock(em)
                var fail = newBlock(em)
                term(em, IrTerm.BranchIf(cond, cont, fail))
                em.cur = fail
                var msg = -1
                if (len(args) == 2) {
                    if (let some(mv) = expr(em, args[1].value)) {
                        msg = mv
                    } else {
                        return none
                    }
                } else {
                    if (let some(nv) = nullTemp(em)) {
                        msg = nv
                    } else {
                        return none
                    }
                }
                externCallVoid(em, "pickle_test_fail_obj", [IrTy.Ptr], [msg])
                term(em, IrTerm.Branch(cont))
                em.cur = cont
                return unitTemp(em)
            }
            case "expect" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`expect(value)` takes exactly one value")
                    return none
                }
                var namedE = false
                if (let some(_) = args[0].name) {
                    namedE = true
                }
                if (namedE || args[0].spread) {
                    bad(em, e.span, "`expect(value)` takes exactly one value")
                    return none
                }
                return expr(em, args[0].value)
            }
case "print" | "println" -> {
                var newline = name == "println"
                for (a in args) {
                    if (a.spread) {
                        var listMatched = false
                        var elemT = Ty.Unknown
                        if (let some(gt) = tyOf(em, a.value.span)) {
                            match (gt) {
                                case Ty.List(inner) -> {
                                    listMatched = true
                                    elemT = inner
                                }
                                case _ -> {}
                            }
                        }
                        if (!listMatched) {
                            bad(em, a.span, "spread argument in `print` must be a `List`")
                            return none
                        }
                        var spv = -1
                        if (let some(sv) = expr(em, a.value)) {
                            spv = sv
                        } else {
                            return none
                        }
                        if (!printSpreadList(em, a.span, spv, elemT)) {
                            return none
                        }
                    } else {
                    var t = -1
                    if (let some(tv) = expr(em, a.value)) {
                        t = tv
                    } else {
                        return none
                    }
                    var sym = ""
                    var pty = IrTy.Ptr
                    var unsupported = false
                    if (let some(gt) = tyOf(em, a.value.span)) {
                        match (gt) {
                            case Ty.Int -> {
                                sym = "pickle_print_i64"
                                pty = IrTy.Int
                            }
                            case Ty.Float -> {
                                sym = "pickle_print_f64"
                                pty = IrTy.Float
                            }
                            case Ty.Bool -> {
                                sym = "pickle_print_bool"
                                pty = IrTy.Bool
                            }
                            case Ty.Byte -> {
                                sym = "pickle_print_byte"
                                pty = IrTy.Int
                            }
                            case Ty.Char -> {
                                sym = "pickle_print_char"
                                pty = IrTy.Char
                            }
                            case Ty.String | Ty.List(_) | Ty.Map(_, _) | Ty.Enum(_, _, _) | Ty.Class(_, _) | Ty.Struct(_, _) -> {
                                sym = "pickle_print_obj"
                                pty = IrTy.Ptr
                            }
                            case _ -> {
                                unsupported = true
                                pty = pty
                            }
                        }
                    } else {
                        unsupported = true
                        pty = pty
                    }
                    if (unsupported) {
                        bad(em, a.value.span, "unsupported `print` argument type")
                        return none
                    }
                    externCallVoid(em, sym, [pty], [t])
                    }
                }
                if (newline) {
                    externCallVoid(em, "pickle_print_newline", emptyIrTys(), emptyInts())
                }
                return unitTemp(em)
            }
            case "alloc" -> {
                if (!(len(args) == 2)) {
                    bad(em, e.span, "`alloc(T, count)` takes two arguments")
                    return none
                }
                var stride = 0
                var badAlloc = false
                if (let some(gt) = tyOf(em, args[0].value.span)) {
                    match (gt) {
                        case Ty.Int | Ty.Float -> stride = 8
                        case Ty.Char -> stride = 4
                        case Ty.Bool -> stride = 1
                        case _ -> {
                            badAlloc = true
                            stride = stride
                        }
                    }
                } else {
                    badAlloc = true
                    stride = stride
                }
                if (badAlloc) {
                    bad(em, args[0].span, "`alloc` currently only supports scalar element types (int, float, bool, char)")
                    return none
                }
                var count = -1
                if (let some(cv) = expr(em, args[1].value)) {
                    count = cv
                } else {
                    return none
                }
                var s = intConst(em, stride)
                var size = temp(em)
                instr(em, IrInstr.BinOp(size, IrBinOp.Mul, count, s))
                return externCallT1(em, "pickle_raw_alloc", [IrTy.Int], IrTy.Int, [size])
            }
            case "view" -> {
                if (len(args) != 1) {
                    bad(em, e.span, "`view(obj)` takes one argument")
                    return none
                }
                var v = 0
                if (let some(pv) = expr(em, args[0].value)) {
                    v = pv
                } else {
                    return none
                }
                // A managed value already evaluates to its object address in
                // IR; the form simply re-types it as a raw `*int` for the
                // caller. No runtime call, no copy.
                return v
            }
            case "free" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`free(p)` takes one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                externCallVoid(em, "pickle_raw_free", [IrTy.Int], [p])
                return unitTemp(em)
            }
            case "len" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`len` takes one argument")
                    return none
                }
                var t = -1
                if (let some(tv) = expr(em, args[0].value)) {
                    t = tv
                } else {
                    return none
                }
                if (let some(gt) = tyOf(em, args[0].value.span)) {
                    match (gt) {
                        case Ty.String -> { return externCallT1(em, "pickle_str_len", [IrTy.Str], IrTy.Int, [t]) }
                        case Ty.List(_) -> { return externCallT1(em, "pickle_list_len", [IrTy.Ptr], IrTy.Int, [t]) }
                        case Ty.Map(_, _) -> { return externCallT1(em, "pickle_map_len", [IrTy.Ptr], IrTy.Int, [t]) }
                        case _ -> {}
                    }
                }
                bad(em, e.span, "`len` over this type is not lowered yet")
                none
            }
            case "abs" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`abs(x)` takes exactly one argument")
                    return none
                }
                var namedA = false
                if (let some(_) = args[0].name) {
                    namedA = true
                }
                if (namedA || args[0].spread) {
                    bad(em, e.span, "`abs(x)` takes exactly one argument")
                    return none
                }
                var v = -1
                if (let some(vv) = expr(em, args[0].value)) {
                    v = vv
                } else {
                    return none
                }
                var vit = IrTy.Unit
                if (let some(iv) = irty(em, args[0].value.span)) {
                    vit = iv
                } else {
                    return none
                }
                var zero = -1
                var badAbs = false
                match (vit) {
                    case IrTy.Int -> zero = intConst(em, 0)
                    case IrTy.Float -> zero = floatConst(em, 0.0)
                    case _ -> {
                        badAbs = true
                        zero = zero
                    }
                }
                if (badAbs) {
                    bad(em, args[0].value.span, "`abs` requires an `int` or `float` argument")
                    return none
                }
                var isNeg = temp(em)
                instr(em, IrInstr.BinOp(isNeg, IrBinOp.Lt, v, zero))
                var negV = temp(em)
                instr(em, IrInstr.UnOp(negV, IrUnOp.Neg, v))
                var resSlot = newSlot(em, vit)
                var negB = newBlock(em)
                var posB = newBlock(em)
                var join = newBlock(em)
                term(em, IrTerm.BranchIf(isNeg, negB, posB))
                em.cur = negB
                instr(em, IrInstr.StoreSlot(resSlot, negV))
                term(em, IrTerm.Branch(join))
                em.cur = posB
                instr(em, IrInstr.StoreSlot(resSlot, v))
                term(em, IrTerm.Branch(join))
                em.cur = join
                return load(em, resSlot)
            }
            case "min" | "max" -> {
                if (!(len(args) == 2)) {
                    bad(em, e.span, "`" + name + "(a, b)` takes exactly two arguments")
                    return none
                }
                var namedM0 = false
                if (let some(_) = args[0].name) {
                    namedM0 = true
                }
                var namedM1 = false
                if (let some(_) = args[1].name) {
                    namedM1 = true
                }
                if (namedM0 || args[0].spread || namedM1 || args[1].spread) {
                    bad(em, e.span, "`" + name + "(a, b)` takes exactly two arguments")
                    return none
                }
                var it = IrTy.Unit
                if (let some(iv) = irty(em, args[0].value.span)) {
                    it = iv
                } else {
                    return none
                }
                var badMinMax = false
                if (!(irTyTag(it) == irTyTag(IrTy.Int)) && !(irTyTag(it) == irTyTag(IrTy.Float))) {
                    badMinMax = true
                }
                if (badMinMax) {
                    bad(em, e.span, "`min`/`max` requires `int` or `float` arguments")
                    return none
                }
                var a = -1
                if (let some(av) = expr(em, args[0].value)) {
                    a = av
                } else {
                    return none
                }
                var b = -1
                if (let some(bv) = expr(em, args[1].value)) {
                    b = bv
                } else {
                    return none
                }
                var pickA = temp(em)
                var op = IrBinOp.Gt
                if (name == "min") {
                    op = IrBinOp.Lt
                }
                instr(em, IrInstr.BinOp(pickA, op, a, b))
                var resSlot = newSlot(em, it)
                var aB = newBlock(em)
                var bB = newBlock(em)
                var join = newBlock(em)
                term(em, IrTerm.BranchIf(pickA, aB, bB))
                em.cur = aB
                instr(em, IrInstr.StoreSlot(resSlot, a))
                term(em, IrTerm.Branch(join))
                em.cur = bB
                instr(em, IrInstr.StoreSlot(resSlot, b))
                term(em, IrTerm.Branch(join))
                em.cur = join
                return load(em, resSlot)
            }
            case "clamp" -> {
                if (!(len(args) == 3)) {
                    bad(em, e.span, "`clamp(x, lo, hi)` takes exactly three arguments")
                    return none
                }
                var badClamp = false
                for (a in args) {
                    var named = false
                    if (let some(_) = a.name) {
                        named = true
                    }
                    if (named || a.spread) {
                        badClamp = true
                    }
                }
                if (badClamp) {
                    bad(em, e.span, "`clamp(x, lo, hi)` takes exactly three arguments")
                    return none
                }
                var it = IrTy.Unit
                if (let some(iv) = irty(em, args[0].value.span)) {
                    it = iv
                } else {
                    return none
                }
                var badType = false
                if (!(irTyTag(it) == irTyTag(IrTy.Int)) && !(irTyTag(it) == irTyTag(IrTy.Float))) {
                    badType = true
                }
                if (badType) {
                    bad(em, e.span, "`clamp` requires `int` or `float` arguments")
                    return none
                }
                var x = -1
                if (let some(xv) = expr(em, args[0].value)) {
                    x = xv
                } else {
                    return none
                }
                var lo = -1
                if (let some(lv) = expr(em, args[1].value)) {
                    lo = lv
                } else {
                    return none
                }
                var hi = -1
                if (let some(hv) = expr(em, args[2].value)) {
                    hi = hv
                } else {
                    return none
                }
                var maxCond = temp(em)
                instr(em, IrInstr.BinOp(maxCond, IrBinOp.Gt, x, lo))
                var mid = newSlot(em, it)
                var takeX = newBlock(em)
                var takeLo = newBlock(em)
                var maxJoin = newBlock(em)
                term(em, IrTerm.BranchIf(maxCond, takeX, takeLo))
                em.cur = takeX
                instr(em, IrInstr.StoreSlot(mid, x))
                term(em, IrTerm.Branch(maxJoin))
                em.cur = takeLo
                instr(em, IrInstr.StoreSlot(mid, lo))
                term(em, IrTerm.Branch(maxJoin))
                em.cur = maxJoin
                var maxv = load(em, mid)
                var minCond = temp(em)
                instr(em, IrInstr.BinOp(minCond, IrBinOp.Lt, maxv, hi))
                var resSlot = newSlot(em, it)
                var takeMax = newBlock(em)
                var takeHi = newBlock(em)
                var join = newBlock(em)
                term(em, IrTerm.BranchIf(minCond, takeMax, takeHi))
                em.cur = takeMax
                instr(em, IrInstr.StoreSlot(resSlot, maxv))
                term(em, IrTerm.Branch(join))
                em.cur = takeHi
                instr(em, IrInstr.StoreSlot(resSlot, hi))
                term(em, IrTerm.Branch(join))
                em.cur = join
                return load(em, resSlot)
            }
            case "str" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`str(x)` takes exactly one argument")
                    return none
                }
                var namedS = false
                if (let some(_) = args[0].name) {
                    namedS = true
                }
                if (namedS || args[0].spread) {
                    bad(em, e.span, "`str(x)` takes exactly one argument")
                    return none
                }
                var v = -1
                if (let some(vv) = expr(em, args[0].value)) {
                    v = vv
                } else {
                    return none
                }
                var isByteList = false
                if (let some(gt) = tyOf(em, args[0].value.span)) {
                    match (gt) {
                        case Ty.List(inner) -> {
                            match (inner) {
                                case Ty.Byte -> isByteList = true
                                case _ -> {}
                            }
                        }
                        case _ -> {}
                    }
                }
                if (isByteList) {
                    return externCallT1(em, "pickle_str_from_list", [IrTy.Ptr], IrTy.Str, [v])
                }
                if (let some(iv) = irty(em, args[0].value.span)) {
                    match (iv) {
case IrTy.Int -> { return externCallT1(em, "pickle_str_from_i64", [IrTy.Int], IrTy.Str, [v]) }
                    case IrTy.Float -> { return externCallT1(em, "pickle_str_from_f64", [IrTy.Float], IrTy.Str, [v]) }
                    case IrTy.Bool -> { return externCallT1(em, "pickle_str_from_bool", [IrTy.Bool], IrTy.Str, [v]) }
                    case IrTy.Char -> { return externCallT1(em, "pickle_str_from_char", [IrTy.Char], IrTy.Str, [v]) }
                        case _ -> {}
                    }
                }
                bad(em, e.span, "`str` requires an `int`, `float`, `bool`, `char`, or `List<byte>`")
                none
            }
            case "bytes" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`bytes(s)` takes exactly one argument")
                    return none
                }
                var namedB = false
                if (let some(_) = args[0].name) {
                    namedB = true
                }
                if (namedB || args[0].spread) {
                    bad(em, e.span, "`bytes(s)` takes exactly one argument")
                    return none
                }
                var v = -1
                if (let some(vv) = expr(em, args[0].value)) {
                    v = vv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_str_to_bytes", [IrTy.Str], IrTy.Ptr, [v])
            }
            case "range" -> {
                if (len(args) == 0 || len(args) > 3) {
                    bad(em, e.span, "`range(end)`, `range(start, end)`, or `range(start, end, step)` expected")
                    return none
                }
                for (a in args) {
                    var named = false
                    if (let some(_) = a.name) {
                        named = true
                    }
                    if (named || a.spread) {
                        bad(em, a.span, "`range` takes only plain positional arguments")
                        return none
                    }
                }
                var int0 = intConst(em, 0)
                var int1 = intConst(em, 1)
                var start = int0
                var end = -1
                var step = int1
                if (len(args) == 1) {
                    if (let some(x) = expr(em, args[0].value)) {
                        end = x
                    } else {
                        return none
                    }
                } else if (len(args) == 2) {
                    if (let some(x) = expr(em, args[0].value)) {
                        start = x
                    } else {
                        return none
                    }
                    if (let some(x) = expr(em, args[1].value)) {
                        end = x
                    } else {
                        return none
                    }
                } else {
                    if (let some(x) = expr(em, args[0].value)) {
                        start = x
                    } else {
                        return none
                    }
                    if (let some(x) = expr(em, args[1].value)) {
                        end = x
                    } else {
                        return none
                    }
                    if (let some(x) = expr(em, args[2].value)) {
                        step = x
                    } else {
                        return none
                    }
                }
                return externCallT1(em, "pickle_range", [IrTy.Int, IrTy.Int, IrTy.Int], IrTy.Ptr, [start, end, step])
            }
            case "read_file" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`read_file(path)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`read_file(path)` takes exactly one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_read_file", [IrTy.Str], IrTy.Ptr, [p])
            }
            case "write_file" -> {
                if (!(len(args) == 2)) {
                    bad(em, e.span, "`write_file(path, text)` takes exactly two arguments")
                    return none
                }
                var badNamed = false
                for (a in args) {
                    var named = false
                    if (let some(_) = a.name) {
                        named = true
                    }
                    if (named || a.spread) {
                        badNamed = true
                    }
                }
                if (badNamed) {
                    bad(em, e.span, "`write_file(path, text)` takes exactly two arguments")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                var t = -1
                if (let some(tv) = expr(em, args[1].value)) {
                    t = tv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_write_file", [IrTy.Str, IrTy.Str], IrTy.Bool, [p, t])
            }
            case "file_exists" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`file_exists(path)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`file_exists(path)` takes exactly one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_file_exists", [IrTy.Str], IrTy.Bool, [p])
            }
            case "delete" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`delete(path)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`delete(path)` takes exactly one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_delete", [IrTy.Str], IrTy.Bool, [p])
            }
            case "mkdir" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`mkdir(path)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`mkdir(path)` takes exactly one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_mkdir", [IrTy.Str], IrTy.Bool, [p])
            }
            case "list_dir" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`list_dir(path)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`list_dir(path)` takes exactly one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_list_dir", [IrTy.Str], IrTy.Ptr, [p])
            }
            case "stream_open_read" | "stream_open_write" | "stream_open_append" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`" + name + "(path)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`" + name + "(path)` takes exactly one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                var sym = "pickle_stream_open_append"
                if (name == "stream_open_read") {
                    sym = "pickle_stream_open_read"
                } else if (name == "stream_open_write") {
                    sym = "pickle_stream_open_write"
                }
                return externCallT1(em, sym, [IrTy.Str], IrTy.Ptr, [p])
            }
case "stdout_stream" | "stderr_stream" -> {
                if (!(len(args) == 0)) {
                    bad(em, e.span, "`" + name + "()` takes no arguments")
                    return none
                }
                var sym = "pickle_stderr_stream"
                if (name == "stdout_stream") {
                    sym = "pickle_stdout_stream"
                }
                return externCallT1(em, sym, emptyIrTys(), IrTy.Ptr, emptyInts())
            }
            case "args" -> {
                if (!(len(args) == 0)) {
                    bad(em, e.span, "`args()` takes no arguments")
                    return none
                }
                // Returns a `List<string>` of the program's command-line
                // arguments, excluding the program name.
                return externCallT1(em, "pickle_args", emptyIrTys(), IrTy.Ptr, emptyInts())
            }
            case "exit" -> {
                if (len(args) != 1) {
                    bad(em, e.span, "`exit(code)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`exit(code)` takes exactly one argument")
                    return none
                }
                if (let some(codeSlot) = expr(em, args[0].value)) {
                    externCallVoid(em, "pickle_exit", [IrTy.Int], [codeSlot])
                    return unitTemp(em)
                } else {
                    return none
                }
            }
            case "run_cmd" -> {
                var special = false
                for (a in args) {
                    if (let some(_) = a.name) {
                        special = true
                    }
                    if (a.spread) {
                        special = true
                    }
                }
                if (len(args) != 8 || special) {
                    bad(em, e.span, "`run_cmd(argv, cwd, envs, env_removes, stdin_bytes, max_out, timeout_ms, inherit_io)` takes exactly eight arguments")
                    return none
                }
                var temps = emptyInts()
                for (a in args) {
                    if (let some(t) = expr(em, a.value)) {
                        var tt = t
                        if (let some(ty) = tyOf(em, a.value.span)) {
                            match (ty) {
                                case Ty.Int -> { tt = externCallT1(em, "pickle_box_i64", [IrTy.Int], IrTy.Ptr, [tt]) }
                                case _ -> {}
                            }
                        }
                        temps.push(tt)
                    } else {
                        return none
                    }
                }
                return externCallT1(em, "pickle_run_cmd", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Bool], IrTy.Ptr, temps)
            }
            case "run_spawn" -> {
                var special = false
                for (a in args) {
                    if (let some(_) = a.name) {
                        special = true
                    }
                    if (a.spread) {
                        special = true
                    }
                }
                if (len(args) != 5 || special) {
                    bad(em, e.span, "`run_spawn(argv, cwd, envs, env_removes, max_out)` takes exactly five arguments")
                    return none
                }
                var temps = emptyInts()
                for (a in args) {
                    if (let some(t) = expr(em, a.value)) {
                        var tt = t
                        if (let some(ty) = tyOf(em, a.value.span)) {
                            match (ty) {
                                case Ty.Int -> { tt = externCallT1(em, "pickle_box_i64", [IrTy.Int], IrTy.Ptr, [tt]) }
                                case _ -> {}
                            }
                        }
                        temps.push(tt)
                    } else {
                        return none
                    }
                }
                return externCallT1(em, "pickle_run_spawn", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, temps)
            }
            case "proc_wait" | "proc_running" | "proc_code" | "proc_kill" | "proc_in_close" -> {
                var hNamed = false
                if (let some(_) = args[0].name) {
                    hNamed = true
                }
                if (len(args) != 1 || hNamed || args[0].spread) {
                    bad(em, e.span, "`" + name + "(handle)` takes exactly one argument")
                    return none
                }
                if (let some(h) = expr(em, args[0].value)) {
                    var sym = "pickle_proc_code"
                    if (name == "proc_wait") {
                        sym = "pickle_proc_wait"
                    } else if (name == "proc_running") {
                        sym = "pickle_proc_running"
                    } else if (name == "proc_kill") {
                        sym = "pickle_proc_kill"
                    } else if (name == "proc_in_close") {
                        sym = "pickle_proc_in_close"
                    }
                    var ret = IrTy.Bool
                    if (name == "proc_code") {
                        ret = IrTy.Ptr
                    }
                    return externCallT1(em, sym, [IrTy.Ptr], ret, [h])
                } else {
                    return none
                }
            }
            case "proc_out_read" | "proc_err_read" -> {
                var special = false
                for (a in args) {
                    if (let some(_) = a.name) {
                        special = true
                    }
                    if (a.spread) {
                        special = true
                    }
                }
                if (len(args) != 2 || special) {
                    bad(em, e.span, "`" + name + "(handle, n)` takes exactly two arguments")
                    return none
                }
                if (let some(h) = expr(em, args[0].value)) {
                    if (let some(n) = expr(em, args[1].value)) {
                        var sym = "pickle_proc_err_read"
                        if (name == "proc_out_read") {
                            sym = "pickle_proc_out_read"
                        }
                        return externCallT1(em, sym, [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [h, n])
                    } else {
                        return none
                    }
                } else {
                    return none
                }
            }
            case "proc_in_write" -> {
                var special = false
                for (a in args) {
                    if (let some(_) = a.name) {
                        special = true
                    }
                    if (a.spread) {
                        special = true
                    }
                }
                if (len(args) != 2 || special) {
                    bad(em, e.span, "`proc_in_write(handle, b)` takes exactly two arguments")
                    return none
                }
                if (let some(h) = expr(em, args[0].value)) {
                    if (let some(b) = expr(em, args[1].value)) {
                        return externCallT1(em, "pickle_proc_in_write", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [h, b])
                    } else {
                        return none
                    }
                } else {
                    return none
                }
            }
            case "current_dir" -> {
                if (!(len(args) == 0)) {
                    bad(em, e.span, "`current_dir()` takes no arguments")
                    return none
                }
                return externCallT1(em, "pickle_current_dir", emptyIrTys(), IrTy.Ptr, emptyInts())
            }
            case "captureBegin" -> {
                if (!(len(args) == 0)) {
                    bad(em, e.span, "`captureBegin()` takes no arguments")
                    return none
                }
                externCallVoid(em, "pickle_test_capture_begin", emptyIrTys(), emptyInts())
                return unitTemp(em)
            }
            case "captureTake" -> {
                if (!(len(args) == 0)) {
                    bad(em, e.span, "`captureTake()` takes no arguments")
                    return none
                }
                // Returns the captured failure message as a `string` object, or
                // `null` (`none`) when there is none.
                return externCallT1(em, "pickle_test_capture_take", emptyIrTys(), IrTy.Ptr, emptyInts())
            }
            case _ -> {
                if (let some(fb) = flatBuiltin(name)) {
                    match (fb) {
                        case (sym, params, returns, ret, pnames) -> {
                            if (let some(ts) = positionalArgs(em, e, name, args, pnames)) {
                                if (returns) {
                                    return externCallT1(em, sym, params, ret, ts)
                                } else {
                                    externCallVoid(em, sym, params, ts)
                                    return unitTemp(em)
                                }
                            } else {
                                return none
                            }
                        }
                        case _ -> { return none }
                    }
                }
                if (genericUserFn(em, name)) {
                    bad(em, e.span, "calls to the generic function `" + name + "` must specify their type arguments (`" + name + "<T,...>(...)`); argument type inference is not lowered yet")
                    return none
                }
                bad(em, e.span, "`" + name + "` is not lowered yet")
                none
            }
        }
    }


    /// Check a fixed-arity builtin's arguments and evaluate them left to
    /// right. Mirrors `positional_args` in emit.rs.
fn positionalArgs(em: Emitter, e: Expr, name: string, args: List<CallArg>, params: List<string>) -> List<int>? {
        var special = false
        for (a in args) {
            if (let some(_) = a.name) {
                special = true
            }
            if (a.spread) {
                special = true
            }
        }
        if (!(len(args) == len(params)) || special) {
            var word = "arguments"
            if (len(params) == 1) {
                word = "argument"
            }
            var shown = ""
            var first = true
            for (p in params) {
                if (first) {
                    first = false
                    shown = p
                } else {
                    shown = shown + ", " + p
                }
            }
            bad(em, e.span, "`" + name + "(" + shown + ")` takes exactly " + str(len(params)) + " " + word)
            return none
        }
        var temps = emptyInts()
        for (a in args) {
            if (let some(t) = expr(em, a.value)) {
                temps.push(t)
            } else {
                return none
            }
        }
        temps
    }

    /// Whether `name` resolves to a top-level generic user function (as opposed
    /// to a builtin or a non-generic overridden callable). Mirrors
    /// `generic_user_fn` in emit.rs.
fn genericUserFn(em: Emitter, name: string) -> bool {
        if (let some(infos) = em.resolved.fns.get(name)) {
            for (c in infos) {
                if (!(c.span.start == 0 && c.span.end == 0)) {
                    return len(c.generics) > 0
                }
            }
        }
        false
    }

    /// The name of the generic class/struct whose instantiated member body is
    /// currently being built (materialized generics contain the `<` type
    /// argument separator), or `none`. Mirrors `generic_owner` in emit.rs.
fn genericOwner(em: Emitter) -> string? {
        if (let some(cid) = em.owner) {
            var name = classOfName(em, cid)
            if (containsStr(name, "<")) {
                return name
            }
        }
        none
    }

    /// `Enum.Variant(...)`: an attributed enum constructor call. Payload
    /// scalars are boxed exactly like list elements; the value is a managed
    /// object whose tag is the variant index and whose fields are the boxed
    /// args. Mirrors `enum_ctor` in emit.rs.
fn enumCtor(em: Emitter, e: Expr, t: EnumTable, name: string, args: List<CallArg>) -> int? {
        for (a in args) {
            if (a.spread) {
                bad(em, e.span, "spread arguments are not lowered yet")
                return none
            }
        }
        var vi = -1
        var ftypes = emptyTys()
        var found = false
        var i = 0
        for (v in t.variants) {
            if (v.name == name) {
                vi = i
                ftypes = v.fields
                found = true
                break
            }
            i = i + 1
        }
        if (!found) {
            bad(em, e.span, "enum `" + t.name + "` has no variant `" + name + "`")
            return none
        }
        var n = len(ftypes)
        if (!(len(args) == n)) {
            bad(em, e.span, "`" + name + "` takes " + str(n) + " argument(s), got " + str(len(args)))
            return none
        }
        var tag = temp(em)
        instr(em, IrInstr.Const(tag, IrConst.Int(vi)))
        var count = temp(em)
        instr(em, IrInstr.Const(count, IrConst.Int(n)))
        var obj = externCallT1(em, "pickle_enum_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [tag, count])
        var i2 = 0
        for (a in args) {
            var ft = ftypes[i2]
            var rp = elemRep(em, ft, e.span)
            if (let some(rep) = rp) {
                var v = expr(em, a.value)
                if (let some(v) = v) {
                    var vt = Ty.Unknown
                    if (let some(vt2) = tyOf(em, a.value.span)) {
                        vt = vt2
                    }
                    var packed = packForPointerBoundary(em, rep, v, vt, e.span)
                    if (let some(packed) = packed) {
                        var boxed = boxForStore(em, rep, packed, elemIr(ft))
                        if (let some(boxed) = boxed) {
                            var idx = temp(em)
                            instr(em, IrInstr.Const(idx, IrConst.Int(i2)))
                            externCallVoid(em, "pickle_enum_set_field", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, idx, boxed])
                        } else {
                            return none
                        }
                    } else {
                        return none
                    }
                } else {
                    return none
                }
            } else {
                return none
            }
            i2 = i2 + 1
        }
        obj
    }

    /// `xs.push(v)` and `xs.pop()` for `List<T>` receivers. The full method
    /// call tower: `Type.staticMethod(...)`, instance methods (virtual when
    /// overridden somewhere), fn-typed fields, interface dispatch, and the
    /// `Map`/`List`/`Stream` methods. Mirrors `method_call` in emit.rs.
fn methodCall(em: Emitter, e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        if (em.iceDepth > 150) {
            return none
        }
        em.iceDepth = em.iceDepth + 1
        em.icePath.push("methodCall")
        var r = methodCall1(em, e, object, name, args)
        em.iceDepth = em.iceDepth - 1
        r
    }

fn methodCall1(em: Emitter, e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        if (!icePoke(em, "methodCall1")) {
            return none
        }
        var ot = tyOf(em, object.span)
        var tnameO = exprKindIdentName(object)
        if (let some(tname) = tnameO) {
            var cidO = em.classByName.get(tname)
            if (let some(cid) = cidO) {
                var ncO = em.namedCtorIds.get(pairKey(str(cid), name))
                if (let some(fid) = ncO) {
                    if (anySpread(args)) {
                        bad(em, e.span, "spreading into a named constructor is not lowered yet")
                        return none
                    }
                    return callMethod(em, e, fid, args, none)
                }
                var mrO = em.methodIds.get(pairKey(str(cid), name))
                if (let some(mr) = mrO) {
                    if (!mr.isStatic) {
                        bad(em, e.span, "instance method `" + name + "` must be called on an instance of `" + tname + "`")
                        return none
                    }
                    if (anySpread(args)) {
                        var pty = srcParamList(em, mr.fid)
                        var rt = callRetFor(em, mr.fid)
                        return spreadStaticCall(em, e, e.span, mr.fid, pty, rt, none, args)
                    }
                    return callMethod(em, e, mr.fid, args, none)
                }
                bad(em, e.span, "`" + tname + "` has no static method `" + name + "`")
                return none
            }
        }
        var cid: int? = none
        if (let some(pt) = ot) {
            var isCS = false
            match (pt) {
                case Ty.Class(_, _) -> isCS = true
                case Ty.Struct(_, _) -> isCS = true
                case _ -> {}
            }
            if (isCS) {
                cid = classIdOf(em, pt, e.span)
            } else {
                var inner: Ty? = none
                match (pt) {
                    case Ty.Ref(iner) -> inner = iner
                    case _ -> {}
                }
                if (let some(iner) = inner) {
                    var isCS2 = false
                    match (iner) {
                        case Ty.Class(_, _) -> isCS2 = true
                        case Ty.Struct(_, _) -> isCS2 = true
                        case _ -> {}
                    }
                    if (isCS2) {
                        cid = classIdOf(em, iner, e.span)
                    }
                }
            }
        }
        if (let some(cc) = cid) {
            var mrO = em.methodIds.get(pairKey(str(cc), name))
            if (let some(mr) = mrO) {
                if (mr.isStatic) {
                    bad(em, e.span, "static method `" + name + "` must be called on the type, not an instance")
                    return none
                }
var receiverOpt = expr(em, object)
                if (let some(receiver) = receiverOpt) {
                    var isSuper = false
                    match (object.kind) {
                        case ExprKind.Super -> isSuper = true
                        case _ -> {}
                    }
                    var vb: List<DispatchBranch>? = none
                    if (!isSuper) {
                        vb = em.virtualDispatch.get(pairKey(str(cc), name))
                    }
                    if (let some(branches) = vb) {
                        if (len(branches) > 0) {
                            return virtualMethodCall(em, e, mr.fid, args, receiver, branches)
                        }
                    }
                    var mfid = mr.fid
                    return callMethod(em, e, mfid, args, receiver)
                }
                return none
            }
            var slotO = instanceFieldIndex(em, cc, name)
            if (let some(slot) = slotO) {
                var ft = fieldAt(em, cc, slot).ty
                var isFn = false
                match (ft) {
                    case Ty.Fn(_, _) -> isFn = true
                    case _ -> {}
                }
                if (isFn) {
                    var owner = expr(em, object)
                    if (let some(owner) = owner) {
                        var fv = fieldRead(em, e.span, owner, ft, slot)
                        if (let some(fv) = fv) {
                            return fnValueCallFrom(em, e, fv, ft, args)
                        }
                        return none
                    }
                    return none
                }
                bad(em, e.span, "field `" + name + "` of `" + classOfName(em, cc) + "` is not callable")
                return none
            }
bad(em, e.span, "`" + classOfName(em, cc) + "` has no method `" + name + "`")
            return none
        }

        // Receive-receiver (interface/list/map/stream/...) methods reject
        // spreads: only class/struct methods are wired through
        // `spreadStaticCall`. Mirrors emit.rs `method_call`.
        if (anySpread(args)) {
            bad(em, e.span, "spread arguments are not lowered for this receiver")
            return none
        }
        var hasIface = false
        if (let some(pt) = ot) {
            if (let some(_) = ifaceOf(pt)) {
                hasIface = true
            }
        }
        if (hasIface) {
            if (let some(pt) = ot) {
                return interfaceMethodCall(em, e, pt, object, name, args)
            }
            return none
        }
        var isMap = false
        var mapK = Ty.Unknown
        var mapV = Ty.Unknown
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Map(k, v) -> {
                    mapK = k
                    mapV = v
                    isMap = true
                }
                case _ -> {}
            }
        }
        if (isMap) {
            var kr = keyRep(em, mapK, object.span)
            if (let some(krep) = kr) {
                var vr = elemRep(em, mapV, e.span)
                if (let none = vr) {
                    return none
                }
                var obj = expr(em, object)
                if (let some(obj) = obj) {
                    match (name) {
                        case "has" -> {
                            if (!(len(args) == 1)) {
                                bad(em, e.span, "`has` takes one argument")
                                return none
                            }
var kt = expr(em, args[0].value)
                            if (let some(kt) = kt) {
                                var aTy = mapK
                                var aTyO = tyOf(em, args[0].value.span)
                                if (let some(t) = aTyO) {
                                    aTy = t
                                }
                                var keyO = packMapKey(em, krep, kt, aTy, args[0].value.span)
                                if (let some(key) = keyO) {
                                    return externCallT1(em, "pickle_map_has", [IrTy.Ptr, IrTy.Ptr], IrTy.Bool, [obj, key])
                                }
                                return none
                            }
                            return none
                        }
                        case "get" -> {
                            if (!(len(args) == 1)) {
                                bad(em, e.span, "`get` takes one argument (a key)")
                                return none
                            }
var k = expr(em, args[0].value)
                            if (let some(k) = k) {
                                var aTy = mapK
                                var aTyO = tyOf(em, args[0].value.span)
                                if (let some(t) = aTyO) {
                                    aTy = t
                                }
                                var keyO = packMapKey(em, krep, k, aTy, args[0].value.span)
                                if (let some(key) = keyO) {
                                    return externCallT1(em, "pickle_map_get", [IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key])
                                }
                                return none
                            }
                            return none
                        }
                        case "remove" -> {
                            if (!(len(args) == 1)) {
                                bad(em, e.span, "`remove` takes one argument (a key)")
                                return none
                            }
var k = expr(em, args[0].value)
                            if (let some(k) = k) {
                                var aTy = mapK
                                var aTyO = tyOf(em, args[0].value.span)
                                if (let some(t) = aTyO) {
                                    aTy = t
                                }
                                var keyO = packMapKey(em, krep, k, aTy, args[0].value.span)
                                if (let some(key) = keyO) {
                                    return externCallT1(em, "pickle_map_remove", [IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key])
                                }
                                return none
                            }
                            return none
                        }
                        case "keys" -> {
                            if (!(len(args) == 0)) {
                                bad(em, e.span, "`keys` takes no arguments")
                                return none
                            }
                            return externCallT1(em, "pickle_map_keys", [IrTy.Ptr], IrTy.Ptr, [obj])
                        }
                        case "values" -> {
                            if (!(len(args) == 0)) {
                                bad(em, e.span, "`values` takes no arguments")
                                return none
                            }
                            return externCallT1(em, "pickle_map_values", [IrTy.Ptr], IrTy.Ptr, [obj])
                        }
                        case _ -> {
                            bad(em, e.span, "`" + name + "` method on `Map` is not lowered yet")
                            return none
                        }
                    }
                }
                return none
            }
            return none
        }
        var isList = false
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.List(_) -> isList = true
                case _ -> {}
            }
        }
        if (isList) {
            return listMethodCall(em, e, object, name, args)
        }
        var isStream = false
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Stream -> isStream = true
                case _ -> {}
            }
        }
        if (isStream) {
            return streamMethodCall(em, e, object, name, args)
        }
        bad(em, e.span, "method calls on this type are not lowered yet")
        none
    }

    /// Emit a call to a class method function, passing the receiver first for
    /// instance methods. Mirrors `call_method` in emit.rs.
fn callMethod(em: Emitter, e: Expr, fid: int, args: List<CallArg>, receiver: int?) -> int? {
        if (!icePoke(em, "callMethod")) {
            return none
        }
        if (anySpread(args)) {
            var pty = srcParamList(em, fid)
            var rt = callRetFor(em, fid)
            return spreadStaticCall(em, e, e.span, fid, pty, rt, receiver, args)
        }
var callArgs = emptyInts()
        var ca = marshalMethodArgs(em, e, fid, args, receiver)
        if (let some(c) = ca) {
            callArgs = c
        } else {
            return none
        }
        emitCallTo(em, fid, callArgs, e)
    }

    /// Marshal a method call's receiver (first for instance methods) and
    /// argument values into the callee's calling-convention temp list. A
    /// parameter declared `T` with a `T?` option-typed callee slot gets its
    /// scalar lifted via `option_wrap`. Mirrors `marshal_method_args`.
fn marshalMethodArgs(em: Emitter, e: Expr, fid: int, args: List<CallArg>, receiver: int?) -> List<int>? {
        if (!icePoke(em, "marshalMethodArgs")) {
            return none
        }
        let _ = e
        var fparams = em.irModule.funcs[fid].params
        var callArgs = emptyInts()
        if (let some(r) = receiver) {
            callArgs.push(r)
        }
        var base = len(callArgs)
        var i = 0
        for (a in args) {
var src: Ty? = none
            if (let some(sps) = em.srcParamTys.get(fid)) {
                if (i < len(sps)) {
                    src = sps[i]
                }
            }
            var isRef = false
            if (let some(s) = src) {
                match (s) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
var t = borrowArg(em, src, a)
            if (let some(t) = t) {
                var fparamTy: IrTy? = none
                if (base + i < len(fparams)) {
                    fparamTy = fparams[base + i].ty
                } else {
                    if (let some(s) = src) {
                        fparamTy = mapTy(em, s, a.value.span)
                    }
                }
                var wantsWrap = false
                if (!isRef) {
                    if (let some(ft) = fparamTy) {
                        if (irTyTag(ft) == irTyTag(IrTy.Ptr)) {
                            wantsWrap = true
                        }
                    }
                }
                if (wantsWrap) {
                    var vt = Ty.Unknown
                    if (let some(v) = tyOf(em, a.value.span)) {
                        vt = v
                    }
                    var ov = optionWrap(em, t, vt, a.value.span)
                    if (let some(o) = ov) {
                        callArgs.push(o)
                    } else {
                        return none
                    }
                } else {
                    callArgs.push(t)
                }
            } else {
                return none
            }
            i = i + 1
        }
        callArgs
    }

    /// Emit the `Call` instruction of an already-marshaled method call.
fn emitCallTo(em: Emitter, fid: int, callArgs: List<int>, e: Expr) -> int {
        let _ = e
        var dst = temp(em)
        instr(em, IrInstr.Call(dst, Callee.Func(fid), callArgs))
        // A Pickle-level `throw` is cooperative: the callee returns normally
        // with the pending flag set instead of unwinding, so the call site has
        // to notice and leave before anyone reads `dst`.
        guardPropagation(em, fid)
        dst
    }

    /// Emit the pending check after a call to `fid`, if that call can propagate.
    /// After a call that may leave a throw pending, either record the edge (on
    /// the analysis pass) or emit the check (on the real one).
    ///
    /// Recording happens even when the enclosing function will turn out not to
    /// need a check at all: the call really is a call, so it really is an edge.
    /// Keeping every edge is what makes the fixed point safe, since the answer
    /// is only ever used to *remove* a check.
fn guardPropagation(em: Emitter, fid: int) {
        if (em.analyzing) {
            if (let some(caller) = em.currentFid) {
                match (em.callEdges.get(caller)) {
                    case some(callees) -> callees.push(fid)
                    case none -> em.callEdges[caller] = [fid]
                }
            }
            return
        }
        if (checkPropagates(em, fid)) {
            checkPending(em)
        }
    }

    /// Can a call to `fid` leave a throw pending?
    ///
    /// A program with no `throw` anywhere cannot propagate one, so it skips
    /// every check. Otherwise this is the fixed point from `solveMayThrow`, and
    /// anything it does not know -- a function the analysis pass could not reach
    /// -- is assumed to propagate. That direction only ever costs a predictable
    /// branch, whereas guessing "no" would lose a throw.
fn checkPropagates(em: Emitter, fid: int) -> bool {
        if (!em.progMayThrow) {
            return false
        }
        // A `finally` running on a throw path already has the flag set; a check
        // there would see the throw we are transferring on, not a new one.
        if (em.inThrowTransfer) {
            return false
        }
        if (let some(v) = em.mayThrow.get(fid)) {
            v
        } else {
            true
        }
    }

    /// After a call that may have thrown, branch to the innermost `catch` in
    /// this function or out of it. The flag stays set until someone consumes it.
fn checkPending(em: Emitter) {
        let pending = externCallT1(em, EXC_PENDING, emptyIrTys(), IrTy.Bool, emptyInts())
        let thrown = newBlock(em)
        let resume = newBlock(em)
        term(em, IrTerm.BranchIf(pending, thrown, resume))
        em.cur = thrown
        transferToHandlerOrPropagate(em)
        em.cur = resume
    }

    /// Compute the transitive may-throw answer for every function the analysis
    /// pass lowered.
    ///
    /// `directThrow` seeds the set with the functions containing a `throw` of
    /// their own; `callEdges` then carries that backwards along every recorded
    /// call, to a fixed point.
    ///
    /// The result records an answer for *every* function the analysis pass
    /// lowered, including the ones that came out `false`. That is the whole
    /// point: `checkPropagates` treats an absent id as propagating, so recording
    /// only the throwing set would leave every safe callee looking unknown and
    /// every call site checked. Only a function the pass never reached stays
    /// absent, and that can only cost a branch.
fn solveMayThrow(em: Emitter) {
        var throws = emptyIntBoolMap()
        for (fid in em.directThrow.keys()) {
            throws[fid] = true
        }
        var changed = true
        while (changed) {
            changed = false
            for (caller in em.callEdges.keys()) {
                var alreadyThrows = false
                if (let some(already) = throws.get(caller)) {
                    alreadyThrows = already
                }
                if (alreadyThrows) {
                    continue
                }
                if (let some(callees) = em.callEdges.get(caller)) {
                    for (callee in callees) {
                        var calleeThrows = false
                        if (let some(c) = throws.get(callee)) {
                            calleeThrows = c
                        }
                        if (calleeThrows) {
                            throws[caller] = true
                            changed = true
                        }
                    }
                }
            }
        }
        var result = emptyIntBoolMap()
        for (fid in em.fidList) {
            var v = false
            if (let some(hit) = throws.get(fid)) {
                v = hit
            }
            result[fid] = v
        }
        em.mayThrow = result
    }
    /// The exit itself, once every `finally` has run.
fn performExit(em: Emitter, exit: Exit) {
        match (exit) {
            case Exit.Return(v) -> {
                term(em, IrTerm.Return(v))
            }
            case Exit.Branch(target) -> {
                term(em, IrTerm.Branch(target))
            }
            case Exit.Propagate -> {
                var v: int? = none
                if (irTyTag(em.fret) == irTyTag(IrTy.Unit)) {
                    v = none
                } else if (irTyTag(em.fret) == irTyTag(IrTy.Ptr)) {
                    v = nullTemp(em)
                } else {
                    v = exitZero(em)
                }
                term(em, IrTerm.Return(v))
            }
        }
        em.cur = newBlock(em)
    }

    /// Run every `finally` still owed on the way out, innermost first, then take
    /// the exit itself.
fn exitThroughFinallys(em: Emitter, exit: Exit) {
        if (len(em.finallys) == 0) {
            performExit(em, exit)
            return
        }
        let chain = em.finallys
        em.finallys = emptyBlocks()
        // The flag is set on every path that reaches here through a throw, so the
        // `finally` bodies run with propagation checks suppressed.
        let saved = em.inThrowTransfer
        em.inThrowTransfer = true
        var i = len(chain) - 1
        while (i >= 0) {
            // One copy of the `finally` per level, then on to the next level.
            let after = newBlock(em)
            pushScope(em)
            blockBodyOnly(em, chain[i])
            popScope(em)
            term(em, IrTerm.Branch(after))
            em.cur = after
            i = i - 1
        }
        em.inThrowTransfer = saved
        em.finallys = chain
        performExit(em, exit)
    }

    /// Leave the current block for the innermost `catch` in this function, or out
    /// of the function when there is none.
    ///
    /// The `finally`s still owed on the way are only the ones from *inside* the
    /// handler's own `try`, and they run innermost first. The handler's own
    /// `finally` is deliberately left on the stack: `tryStmt` emits it once, after
    /// the handler body, on the path this branch takes.
    ///
    /// This only *emits*; it never mutates the `handlers`/`finallys` stacks. Both
    /// callers lower a path that does not necessarily commit -- a `checkPending`
    /// guard resumes into the same handler scope afterwards, and a `throw`
    /// statement is only one of several statements still to be emitted -- so a
    /// transfer that consumed the enclosing context would strand every later
    /// `throw` in the same body. `tryStmt` balances its own push once, when the
    /// body and the handler are both fully emitted.
fn transferToHandlerOrPropagate(em: Emitter) {
        if (len(em.handlers) == 0) {
            exitThroughFinallys(em, Exit.Propagate)
            return
        }
        let handler = em.handlers[len(em.handlers) - 1]
        let chain = em.finallys
        em.finallys = emptyBlocks()
        // The `try` emits its own `finally` after the handler body, not before,
        // so the first `finally` still owed on the way is one past it when the
        // owning `try` has one of its own, and exactly at the base when it does
        // not -- an inner `try`'s `finally` then occupies the base itself.
        var innerBase = handler.finBase
        if (handler.ownFinally) {
            innerBase = innerBase + 1
        }
        // The flag is still set here, so the inner `finally` bodies run with
        // propagation checks suppressed: a check would see the throw we are
        // transferring on and divert straight to the handler, skipping the
        // remaining `finally`s.
        let saved = em.inThrowTransfer
        em.inThrowTransfer = true
        var i = len(chain) - 1
        while (i >= innerBase) {
            let after = newBlock(em)
            pushScope(em)
            blockBodyOnly(em, chain[i])
            popScope(em)
            term(em, IrTerm.Branch(after))
            em.cur = after
            i = i - 1
        }
        em.inThrowTransfer = saved
        // The whole chain goes back, including the handler's own `finally`: the
        // handler body is emitted with it live, so a `return` inside the handler
        // still runs it.
        em.finallys = chain
        term(em, IrTerm.Branch(handler.target))
        em.cur = newBlock(em)
    }

    /// `throw EXPR`. The parser stays permissive about the operand's type, so the
    /// value here is a temp of whatever `expr` produced; the checker has already
    /// established that it is a `string`.
fn throwStmt(em: Emitter, value: Expr, _span: Span) -> bool {
        if (let some(t) = expr(em, value)) {
            var payload = t
            if (irTyTag(em.fret) == irTyTag(IrTy.Ptr)) {
                var vt = Ty.Unknown
                if (let some(gt) = tyOf(em, value.span)) {
                    vt = gt
                }
                if (let some(w) = optionWrap(em, payload, vt, value.span)) {
                    payload = w
                } else {
                    return false
                }
            }
            throwWith(em, payload)
            true
        } else {
            false
        }
    }

    /// Publish `payload` and transfer control.
    ///
    /// With an enclosing `catch` in this function, control branches straight to it
    /// after running any `finally` from *inside* that `catch`'s own `try`, so a
    /// local `throw` costs no flag round-trip. The payload still goes through
    /// `pickle_exc_throw`, which roots it in the GC for the jump and lets the
    /// handler's `pickle_exc_take` release it. With no `catch` here the flag
    /// stays set and the caller observes it after the call.
fn throwWith(em: Emitter, payload: int) {
        if (em.analyzing) {
            // A `throw` in this body is the seed for its own fixed point; the
            // transfer that follows is pass 2's problem.
            if (let some(fid) = em.currentFid) {
                em.directThrow[fid] = true
            }
            return
        }
        externCallVoid(em, EXC_THROW, [IrTy.Ptr], [payload])
        transferToHandlerOrPropagate(em)
    }

    /// `try BODY catch (BINDER)? BLOCK finally BLOCK?`
    ///
    /// `body` is emitted inline. The end of `body` checks the pending flag and
    /// either falls through to `finally` or enters the handler, which consumes
    /// the flag and binds the payload to a frame slot (the IR has no block
    /// parameters, so the `logic` idiom of a `Slot` written in one block and read
    /// in another is what carries the value across the branch). A `throw` written
    /// inside `body` skips the flag and branches to the handler directly.
    ///
    /// All three ways out -- body normal, handler, and a propagating throw -- run
    /// `fin`, so `fin` is emitted once per way out. The owning `try`'s `finally`
    /// is on the `finallys` stack while `body` and the handler are emitted, so a
    /// `return` inside either runs it; a single pop then balances it before the
    /// fall-through copies are emitted, so those copies cannot re-enter it.
fn tryStmt(em: Emitter, body: Block, binder: string?, handler: Block?, fin: Block?, _span: Span, res: int?) -> bool {
        let afterBody = newBlock(em)
        let handlerId = newBlock(em)
        let handlerFinId = newBlock(em)
        let endId = newBlock(em)
        var hasHandler = false
        var hasFinally = false
        if (let some(_) = handler) {
            hasHandler = true
        }
        if (let some(_) = fin) {
            hasFinally = true
        }

        // A `throw` in the body targets the handler directly, so its context must
        // be in scope while the body is emitted.
        let finBase = len(em.finallys)
        if (let some(f) = fin) {
            em.finallys.push(f)
        }
        if (hasHandler) {
            em.handlers.push(HandlerCtx(handlerId, finBase, hasFinally))
        }

        pushScope(em)
        if (!(blockIntoSlot(em, body, res))) {
            popScope(em)
            return false
        }
        popScope(em)

        if (hasHandler) {
            // A call in the body may have thrown: hand over to the handler.
            let pending = externCallT1(em, EXC_PENDING, emptyIrTys(), IrTy.Bool, emptyInts())
            term(em, IrTerm.BranchIf(pending, handlerId, afterBody))
        } else {
            term(em, IrTerm.Branch(afterBody))
        }

        // The body can no longer `throw` to this handler, so a `throw` in the
        // handler propagates outward instead. Only the context this `try` pushed
        // goes away: a `try` with no `catch` of its own must leave an enclosing
        // handler in scope for the code that follows it.
        if (hasHandler) {
            em.handlers.pop()
        }

        em.cur = handlerId
        if (let some(h) = handler) {
            // Consume the throw: this both clears the flag and yields the payload,
            // and it is the only thing that unroots the payload.
            let payload = externCallT1(em, EXC_TAKE, emptyIrTys(), IrTy.Ptr, emptyInts())
            pushScope(em)
            if (let some(name) = binder) {
                let slot = newSlot(em, IrTy.Ptr)
                instr(em, IrInstr.StoreSlot(slot, payload))
                declare(em, name, slot)
            }
            if (!(blockIntoSlot(em, h, res))) {
                popScope(em)
                return false
            }
            popScope(em)
        }

        if (let some(f) = fin) {
            // A single compile-time pop balances the push from before the body.
            // The handler's fall-through copy and the body's fall-through copy are
            // two emissions of the *same* `finally`, so the stack is already
            // balanced by the time the body copy is emitted.
            em.finallys.pop()
            if (hasHandler) {
                term(em, IrTerm.Branch(handlerFinId))
                em.cur = handlerFinId
                pushScope(em)
                blockBodyOnly(em, f)
                popScope(em)
            }
        }
        term(em, IrTerm.Branch(endId))

        em.cur = afterBody
        if (let some(f) = fin) {
            pushScope(em)
            blockBodyOnly(em, f)
            popScope(em)
        }
        term(em, IrTerm.Branch(endId))
        em.cur = endId
        true
    }

    /// Lower an instance call to a method overridden somewhere in the program:
    /// `pickle_class_is(receiver, D_cid)` checks deepest-derived-first, each
    /// branching to that descendant's own implementation and joining on a
    /// result slot; a receiver that is an instance of no overriding descendant
    /// falls through to the statically-resolved `fallback_fid`. Mirrors
    /// `virtual_method_call`.
fn virtualMethodCall(em: Emitter, e: Expr, fallbackFid: int, args: List<CallArg>, receiver: int, branches: List<DispatchBranch>) -> int? {
        if (anySpread(args)) {
            bad(em, e.span, "spread arguments cannot dispatch virtually (the method is overridden)")
            return none
        }
        var rt = IrTy.Unit
        if (let some(r) = irty(em, e.span)) {
            rt = r
        } else {
            return none
        }
        var retSlot = newSlot(em, rt)
        var join = newBlock(em)
        for (b in branches) {
            var cb = newBlock(em)
            var next = newBlock(em)
            var dc = intConst(em, b.cid)
            var found = externCallT1(em, "pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [receiver, dc])
            term(em, IrTerm.BranchIf(found, cb, next))
            em.cur = cb
            var callArgs = emptyInts()
            var ca1 = marshalMethodArgs(em, e, b.fid, args, receiver)
            if (let some(c1) = ca1) {
                callArgs = c1
            } else {
                return none
            }
            var val = emitCallTo(em, b.fid, callArgs, e)
            instr(em, IrInstr.StoreSlot(retSlot, val))
            term(em, IrTerm.Branch(join))
            em.cur = next
        }
        var fallbackArgs = emptyInts()
        var caf = marshalMethodArgs(em, e, fallbackFid, args, receiver)
        if (let some(cf) = caf) {
            fallbackArgs = cf
        } else {
            return none
        }
        var val = emitCallTo(em, fallbackFid, fallbackArgs, e)
        instr(em, IrInstr.StoreSlot(retSlot, val))
        term(em, IrTerm.Branch(join))
        em.cur = join
        var dst = temp(em)
        instr(em, IrInstr.LoadSlot(dst, retSlot))
        dst
    }

    /// Lower `object.name(...)` where the receiver's static type is an
    /// interface. The dispatch core is shared with the `Iterable`/`Iterator`
    /// protocol calls; see `interfaceDispatch`. Mirrors `interface_method_call`.
fn interfaceMethodCall(em: Emitter, e: Expr, ift: Ty, object: Expr, name: string, args: List<CallArg>) -> int? {
        var receiver = expr(em, object)
        if (let some(receiver) = receiver) {
            var rt = IrTy.Unit
            if (let some(r) = irty(em, e.span)) {
                rt = r
            } else {
                return none
            }
            return interfaceDispatch(em, e, e.span, ift, receiver, name, args, rt)
        }
        none
    }

    /// Shared core of an interface-dispatched `.name(args)` call against an
    /// already-lowered receiver. A compile-time chain of
    /// `pickle_class_is(receiver, D_cid)` checks over every registered class
    /// that transitively implements the interface, deepest-derived-first, each
    /// branching to that class's own resolved implementation and joining on a
    /// result slot; a runtime fallback `pickle_iface_method(receiver,
    /// iface_id, m_idx)` reads the receiver's own class's method-table entry
    /// and indirect-calls it. Mirrors `interface_dispatch`.
fn interfaceDispatch(em: Emitter, e: Expr, span2: Span, ift: Ty, receiver: int, name: string, args: List<CallArg>, retTy: IrTy) -> int? {
        var ifaceName = ""
        var ifaceArgs = emptyTys()
        var isIface = false
        if (let some(ir) = ifaceOf(ift)) {
            ifaceName = ir.name
            ifaceArgs = ir.args
            isIface = true
        }
        if (!isIface) {
            bad(em, span2, "receiver type is not an interface")
            return none
        }
        var ifaceId = 0
        if (let some(id) = ifaceIdFor(em, ifaceName, ifaceArgs, span2)) {
            ifaceId = id
        } else {
            return none
        }
        var mIdx = -1
        var foundM = false
        var msO = em.ifaceMembers.get(ifaceId)
        if (let some(members) = msO) {
            for (m in members) {
                if (m.name == name) {
                    mIdx = m.index
                    foundM = true
                    break
                }
            }
        }
        if (!foundM) {
            bad(em, span2, "`" + ifaceName + "` has no method `" + name + "`")
            return none
        }
        var branches = emptyIfaceDepths()
        for (p in em.classes) {
            if (!classImplementsIface(em, p.classId, ifaceId)) {
                continue
            }
            var mrO = em.methodIds.get(pairKey(str(p.classId), name))
            if (let none = mrO) {
                continue
            }
            if (let some(mr) = mrO) {
                if (mr.isStatic) {
                    bad(em, span2, "interface method `" + name + "` is static on `" + p.name + "`")
                    return none
                }
                var depth = len(ancestry(em, p.name))
                branches.push(IfaceDepthBranch(depth, p.classId, mr.fid))
            }
        }
        if (len(branches) == 0) {
            bad(em, span2, "`" + ifaceName + "." + name + "` is implemented by no class in this program")
            return none
        }
        sortIfaceBranches(branches)
        var retSlot = newSlot(em, retTy)
        var join = newBlock(em)
        for (b in branches) {
            var cb = newBlock(em)
            var next = newBlock(em)
            var dc = intConst(em, b.cid)
            var found = externCallT1(em, "pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [receiver, dc])
            term(em, IrTerm.BranchIf(found, cb, next))
            em.cur = cb
            var callArgs2 = emptyInts()
            var ca2 = marshalMethodArgs(em, e, b.fid, args, receiver)
            if (let some(c2) = ca2) {
                callArgs2 = c2
            } else {
                return none
            }
            var val = emitCallTo(em, b.fid, callArgs2, e)
            instr(em, IrInstr.StoreSlot(retSlot, val))
            term(em, IrTerm.Branch(join))
            em.cur = next
        }
        var iid = intConst(em, ifaceId)
        var midx = intConst(em, mIdx)
        var fp = externCallT1(em, "pickle_iface_method", [IrTy.Ptr, IrTy.Int, IrTy.Int], IrTy.Int, [receiver, iid, midx])
        var isZeroO = cmpZero(em, fp, IrBinOp.Eq, false)
        var isZero = -1
        if (let some(z) = isZeroO) {
            isZero = z
        } else {
            return none
        }
        var ok = newBlock(em)
        var guard = newBlock(em)
        term(em, IrTerm.BranchIf(isZero, guard, ok))
        em.cur = guard
        externCallVoid(em, "pickle_panic_no_iface_method", emptyIrTys(), emptyInts())
        term(em, IrTerm.Branch(join))
        em.cur = ok
        var prototype = branches[0].fid
        var protoArgs = emptyInts()
        var cap = marshalMethodArgs(em, e, prototype, args, receiver)
        if (let some(cp) = cap) {
            protoArgs = cp
        } else {
            return none
        }
        var params = emptyIrTys()
        params.push(IrTy.Ptr)
        var spsO = em.srcParamTys.get(prototype)
        if (let some(src) = spsO) {
            for (t in src) {
                var mt = mapTy(em, t, span2)
                if (let some(m) = mt) {
                    params.push(m)
                } else {
                    params.push(IrTy.Ptr)
                }
            }
        }
        var dst = temp(em)
        instr(em, IrInstr.CallInd(dst, fp, params, retTy, protoArgs))
        instr(em, IrInstr.StoreSlot(retSlot, dst))
        term(em, IrTerm.Branch(join))
        em.cur = join
        var out = temp(em)
        instr(em, IrInstr.LoadSlot(out, retSlot))
        out
    }


    /// A zero-argument interface call against an already-lowered receiver,
    /// used by the `Iterable`/`Iterator` protocol surface in `for_in_protocol`.
    /// Mirrors `interface_zero_arg_call` in emit.rs.
fn interfaceZeroArgCall(em: Emitter, span2: Span, ift: Ty, rec: int, name: string, retTy: IrTy) -> int? {
        var dummy = Expr(span2, ExprKind.Ident(""))
        interfaceDispatch(em, dummy, span2, ift, rec, name, emptyCallArgs(), retTy)
    }

    /// `xs.push(v)` and `xs.pop()` for `List<T>` receivers. Mirrors
    /// `list_method_call` in emit.rs.
fn listMethodCall(em: Emitter, e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        var elem = Ty.Unknown
        var isList = false
        if (let some(pt) = tyOf(em, object.span)) {
            match (pt) {
                case Ty.List(inner) -> {
                    elem = inner
                    isList = true
                }
                case _ -> {}
            }
        }
        if (!isList) {
            bad(em, e.span, "receiver is not a `List`")
            return none
        }
        var obj = expr(em, object)
        if (let some(obj) = obj) {
            match (name) {
                case "push" -> {
                    if (!(len(args) == 1)) {
                        bad(em, e.span, "`push` takes one argument")
                        return none
                    }
                    var rp = elemRep(em, elem, e.span)
                    if (let some(rep) = rp) {
                        var v = expr(em, args[0].value)
                        if (let some(v) = v) {
                            var pushV = v
                            if (!(rep.isPtr)) {
                                var vt = irty(em, args[0].value.span)
                                if (let some(vt) = vt) {
                                    pushV = externCallT1(em, rep.boxSym, [vt], IrTy.Ptr, [v])
                                } else {
                                    return none
                                }
                            }
                            externCallVoid(em, "pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [obj, pushV])
                            return unitTemp(em)
                        }
                        return none
                    }
                    return none
                }
                case "pop" -> {
                    if (!(len(args) == 0)) {
                        bad(em, e.span, "`pop` takes no arguments")
                        return none
                    }
                    var rp = elemRep(em, elem, e.span)
                    if (let some(rep) = rp) {
                        var raw = externCallT1(em, "pickle_list_pop", [IrTy.Ptr], IrTy.Ptr, [obj])
                        if (rep.isPtr) {
                            return raw
                        }
                        return externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
                    }
                    return none
                }
                case "remove" -> {
                    if (!(len(args) == 1)) {
                        bad(em, e.span, "`remove` takes one argument (an index)")
                        return none
                    }
                    var rp = elemRep(em, elem, e.span)
                    if (let some(rep) = rp) {
                        var index = expr(em, args[0].value)
                        if (let some(index) = index) {
                            var raw = externCallT1(em, "pickle_list_remove", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, index])
                            if (rep.isPtr) {
                                return raw
                            }
                            return externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
                        }
                        return none
                    }
                    return none
                }
                case "insert" -> {
                    if (!(len(args) == 2)) {
                        bad(em, e.span, "`insert` takes an index and a value")
                        return none
                    }
                    var rp = elemRep(em, elem, e.span)
                    if (let some(rep) = rp) {
                        var index = expr(em, args[0].value)
                        if (let some(index) = index) {
                            var v = expr(em, args[1].value)
                            if (let some(v) = v) {
                                var insV = v
                                if (!(rep.isPtr)) {
                                    var vt = irty(em, args[1].value.span)
                                    if (let some(vt) = vt) {
                                        insV = externCallT1(em, rep.boxSym, [vt], IrTy.Ptr, [v])
                                    } else {
                                        return none
                                    }
                                }
                                externCallVoid(em, "pickle_list_insert", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, index, insV])
                                return unitTemp(em)
                            }
                            return none
                        }
                        return none
                    }
                    return none
                }
                case "sort" -> {
                    if (!(len(args) == 0)) {
                        bad(em, e.span, "`sort` takes no arguments")
                        return none
                    }
                    var kv = sortKind(em, elem, e.span)
                    if (let some(kind) = kv) {
                        externCallVoid(em, "pickle_list_sort", [IrTy.Ptr, IrTy.Int], [obj, kind])
                        return unitTemp(em)
                    }
                    return none
                }
                case _ -> {
                    bad(em, e.span, "`" + name + "` method on `List` is not lowered yet")
                    return none
                }
            }
        }
        none
    }

    /// Comparison kind for `pickle_list_sort`: 0 = int/byte/char/bool boxed
    /// payloads, 1 = float bits, 2 = string bytes. Mirrors `sort_kind`.
fn sortKind(em: Emitter, elem: Ty, span: Span) -> int? {
        var kind = -1
        var ok = true
        match (elem) {
            case Ty.Int | Ty.Byte | Ty.Char | Ty.Bool -> {
                kind = 0
                ok = true
            }
            case Ty.Float -> {
                kind = 1
                ok = true
            }
            case Ty.String -> {
                kind = 2
                ok = true
            }
            case _ -> ok = false
        }
        if (!ok) {
            bad(em, span, "`sort` is not lowered for `List<" + bareName(elem) + ">`")
            return none
        }
        constTemp(em, IrConst.Int(kind))
    }

    /// Lower a `Stream` method call. `Stream` is carried at the ABI as a raw
    /// object pointer; every method takes that pointer as its receiver. Mirrors
    /// `stream_method_call` in emit.rs.
fn streamMethodCall(em: Emitter, e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        var obj = expr(em, object)
        if (let some(obj) = obj) {
            match (name) {
                case "read" -> {
                    if (!(len(args) == 1)) {
                        bad(em, e.span, "`read` takes one argument (a byte count)")
                        return none
                    }
                    var n = expr(em, args[0].value)
                    if (let some(n) = n) {
                        return externCallT1(em, "pickle_stream_read", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, n])
                    }
                    return none
                }
                case "write" -> {
                    if (!(len(args) == 1)) {
                        bad(em, e.span, "`write` takes one argument (a `List<byte>`)")
                        return none
                    }
                    var bytes = expr(em, args[0].value)
                    if (let some(bytes) = bytes) {
                        return externCallT1(em, "pickle_stream_write", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [obj, bytes])
                    }
                    return none
                }
                case "flush" -> {
                    if (!(len(args) == 0)) {
                        bad(em, e.span, "`flush` takes no arguments")
                        return none
                    }
                    return externCallT1(em, "pickle_stream_flush", [IrTy.Ptr], IrTy.Bool, [obj])
                }
                case "close" -> {
                    if (!(len(args) == 0)) {
                        bad(em, e.span, "`close` takes no arguments")
                        return none
                    }
                    return externCallT1(em, "pickle_stream_close", [IrTy.Ptr], IrTy.Bool, [obj])
                }
                case _ -> {
                    bad(em, e.span, "`" + name + "` method on `Stream` is not lowered yet")
                    return none
                }
            }
        }
        none
    }

    /// Whether a registered class (or one of its ancestors) directly declared
    /// `implements` for `iface_id`. Mirrors `class_implements_iface`.
fn classImplementsIface(em: Emitter, cid: int, ifaceId: int) -> bool {
        var cur: int? = cid
        var guard = 0
        while (guard < 64) {
            guard = guard + 1
            if (let none = cur) {
                return false
            }
            if (let some(c) = cur) {
                var bucketsO = em.classIfaceBuckets.get(c)
                if (let some(buckets) = bucketsO) {
                    for (b in buckets) {
                        if (b.ifaceId == ifaceId) {
                            return true
                        }
                    }
                }
                cur = none
                for (p in em.classes) {
                    if (p.classId == c) {
                        cur = p.parent
                        break
                    }
                }
            }
        }
        false
    }

    /// `name<Type,...>(args)`: an explicit generic user-function (or generic
    /// class/struct ctor) call. The call is monomorphized: the generic callee
    /// is instantiated over the resolved type arguments (substituted under the
    /// enclosing instantiation, if any), and the call is emitted as a static
    /// call to that concrete function. Mirrors `generic_call` in emit.rs.
fn genericCall(em: Emitter, e: Expr, name: string, typeArgs: List<TypeExpr>, args: List<CallArg>) -> int? {
        // `Box<int>(...)`: a generic class/struct constructor call. The name
        // shares the generic-call surface with generic functions, but
        // resolves through the type table.
        var table = seedClassTable()
        var isEntry = false
        if (let some(entry) = em.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    table = t
                    isEntry = true
                }
                case TypeTableEntry.Struct(t) -> {
                    table = t
                    isEntry = true
                }
                case _ -> {}
            }
        }
        if (isEntry) {
            return genericClassCall(em, e, name, table, typeArgs, args)
        }
        var info = userCallableFirst(em, name)
        if (let none = info) {
            bad(em, e.span, "unknown generic function `" + name + "`")
            return none
        }
        var inf = seedCallableInfo()
        if (let some(x) = info) {
            inf = x
        }
        var argTys = emptyTys()
        for (te in typeArgs) {
            var t = em.resolved.resolveTy(te, em.fnGenerics, em.diags)
            argTys.push(substTy(em, t))
        }
        if (!(len(argTys) == len(inf.generics))) {
            bad(em, e.span, "`" + name + "` takes " + str(len(inf.generics)) + " type argument(s), found " + str(len(argTys)))
            return none
        }
        genericFnCall(em, e, inf, argTys, args)
    }

    /// Core of a monomorphized generic-function call, shared by the explicit
    /// `name<T,...>(args)` form and the argument-driven `name(args)` form.
    /// Mirrors `generic_fn_call` in emit.rs.
fn genericFnCall(em: Emitter, e: Expr, info: CallableInfo, argTys: List<Ty>, args: List<CallArg>) -> int? {
        var name = info.name
        if (anyHasVar(argTys)) {
            bad(em, e.span, "cannot instantiate `" + name + "` with unresolved type arguments; specify them explicitly like `" + name + "<...>(...)`")
            return none
        }
        var map = emptyStringTyMap()
        var zi = 0
        while (zi < len(info.generics) && zi < len(argTys)) {
            map[info.generics[zi]] = argTys[zi]
            zi = zi + 1
        }
        var key2 = instKey(name, argTys)
        var fid = 0
        var fidO = em.instantiations.get(key2)
        if (let some(f) = fidO) {
            fid = f
        } else {
            var ifg = instantiateGenericFn(em, e.span, info, name, argTys, map)
            if (let some(f2) = ifg) {
                fid = f2
            } else {
                return none
            }
        }
// Mirror the plain user-function call: borrow `&T` reference params,
        // wrap optional params, and store the result.
        if (anySpread(args)) {
            var pty = srcParamList(em, fid)
            var rt = callRetFor(em, fid)
            return spreadStaticCall(em, e, e.span, fid, pty, rt, none, args)
        }
        var argTemps = emptyInts()
        var i = 0
        while (i < len(args)) {
            var a = args[i]
            var srcO: Ty? = none
            if (let some(v) = em.srcParamTys.get(fid)) {
                if (i < len(v)) {
                    srcO = v[i]
                }
            }
            var isRef = false
            if (let some(sr) = srcO) {
                match (sr) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
            var isOpt = false
            if (let some(sr2) = srcO) {
                match (sr2) {
                    case Ty.Option(_) -> isOpt = true
                    case Ty.None -> isOpt = true
                    case _ -> {}
                }
            }
            var t = -1
            if (let some(tv) = borrowArg(em, srcO, a)) {
                t = tv
            } else {
                return none
            }
            var finalT = t
            if (!isRef && isOpt) {
                var vt = Ty.Unknown
                if (let some(gvt) = tyOf(em, a.value.span)) {
                    vt = gvt
                }
                var tw = optionWrap(em, t, vt, a.value.span)
                if (let some(twc) = tw) {
                    finalT = twc
                } else {
                    return none
                }
            }
            argTemps.push(finalT)
            i = i + 1
        }
        var dst = temp(em)
        instr(em, IrInstr.Call(dst, Callee.Func(fid), argTemps))
        guardPropagation(em, fid)
        dst
    }

    /// Lower `name<Type,...>` used as a VALUE (not called): the explicit type
    /// arguments pick the concrete instantiation, which is wrapped in the same
    /// zero-capture closure a plain function value gets, so it can be stored,
    /// passed around, and called through the regular dynamic call convention.
    /// Mirrors `generic_fn_value` in emit.rs.
fn genericFnValue(em: Emitter, e: Expr, name: string, typeArgs: List<TypeExpr>) -> int? {
        var info = userCallableFirst(em, name)
        if (let none = info) {
            bad(em, e.span, "unknown generic function `" + name + "`")
            return none
        }
        var inf = seedCallableInfo()
        if (let some(x) = info) {
            inf = x
        }
        var argTys = emptyTys()
        for (te in typeArgs) {
            var t = em.resolved.resolveTy(te, em.fnGenerics, em.diags)
            argTys.push(substTy(em, t))
        }
        if (!(len(argTys) == len(inf.generics))) {
            bad(em, e.span, "`" + name + "` takes " + str(len(inf.generics)) + " type argument(s), found " + str(len(argTys)))
            return none
        }
        genericFnValueFor(em, e, inf, argTys)
    }

    /// Materialize a generic function as a value over concrete `arg_tys`:
    /// create (or reuse) the instantiation, wrap it in a zero-capture closure
    /// whose slot 0 holds a forwarder trampoline's address, and return the
    /// closure object. Mirrors `generic_fn_value_for` in emit.rs.
fn genericFnValueFor(em: Emitter, e: Expr, info: CallableInfo, argTys: List<Ty>) -> int? {
        if (anyHasVar(argTys)) {
            bad(em, e.span, "cannot use the generic function `" + info.name + "` as a value with unresolved type arguments")
            return none
        }
        var name = info.name
        var map = emptyStringTyMap()
        var zi = 0
        while (zi < len(info.generics) && zi < len(argTys)) {
            map[info.generics[zi]] = argTys[zi]
            zi = zi + 1
        }
        var key2 = instKey(name, argTys)
        var fid = 0
        var fidO = em.instantiations.get(key2)
        if (let some(f) = fidO) {
            fid = f
        } else {
            var ifg = instantiateGenericFn(em, e.span, info, name, argTys, map)
            if (let some(f2) = ifg) {
                fid = f2
            } else {
                return none
            }
        }
        var tramp = 0
        var tg = valueTrampoline(em, e.span, fid)
        if (let some(t) = tg) {
            tramp = t
        } else {
            return none
        }
        closureObj(em, e, tramp, emptyCaptures())
    }

    /// The forwarder trampoline a generic instantiation value is wrapped in:
    /// one per target instantiation, always forwarding the concrete
    /// substituted signature recorded in `finfo`. Mirrors `value_trampoline`
    /// in emit.rs.
fn valueTrampoline(em: Emitter, span: Span, target: int) -> int? {
        if (let some(t) = em.trampFids.get(target)) {
            return t
        }
        var info = seedCallableInfo()
        var infO = em.finfo.get(target)
        if (let none = infO) {
            bad(em, span, "no signature recorded for instantiated function FuncId(" + str(target) + ")")
            return none
        }
        if (let some(x) = infO) {
            info = x
        }
        var pty = emptyTys()
        for (p in info.params) {
            pty.push(p.ty)
        }
        var ret = info.ret
        var anyBad = false
        for (pt in pty) {
            if (let none = mapTy(em, pt, span)) {
                anyBad = true
            }
        }
        if (anyBad) {
            bad(em, span, "cannot map an instantiated function value's parameters")
            return none
        }
        if (let none = mapTy(em, ret, span)) {
            bad(em, span, "cannot map an instantiated function value's return type")
            return none
        }
        var t = pushClassFunc(em, "fn.value", "pkl_tramp_" + str(target), FnSource.Trampoline(span, target, pty, ret))
        em.trampFids[target] = t
        t
    }

    /// Infer the type arguments of a generic user function `name(args)` from
    /// the argument expressions' recorded types, exactly as the checker does
    /// (`ty::infer_from`). Every generic parameter must be pinned by at least
    /// one argument; an unpinned one bails with a message mirroring the
    /// checker's. Clean programs never reach this failure (the checker
    /// reports it), so the message is a defensive fallback. Mirrors
    /// `infer_generic_fn_args` in emit.rs.
fn inferGenericFnArgs(em: Emitter, span: Span, info: CallableInfo, args: List<CallArg>) -> List<Ty>? {
        var map = emptyStringTyMap()
        var i = 0
        while (i < len(args)) {
            var a = args[i]
            if (a.spread) {
                bad(em, a.span, "spread arguments are not lowered yet")
                return none
            }
            if (let none = a.name) {
                if (i < len(info.params)) {
                    var want = info.params[i]
                    var got = Ty.Unknown
                    if (let some(t) = tyOf(em, a.value.span)) {
                        got = t
                    }
                    inferFrom(want.ty, got, map)
                }
            }
            i = i + 1
        }
        var missing = emptyStrs()
        for (g in info.generics) {
            if (!(map.has(g))) {
                missing.push(g)
            }
        }
        if (!(len(missing) == 0)) {
            var plural = ""
            if (len(missing) == 1) {
                plural = ""
            } else {
                plural = "s"
            }
            var names = ""
            var mi = 0
            for (g in missing) {
                if (mi > 0) {
                    names = names + ", "
                }
                names = names + "`" + g + "`"
                mi = mi + 1
            }
            bad(em, span, "cannot infer the type argument" + plural + " " + names + " for `" + info.name + "`; specify them explicitly like `" + info.name + "<...>(...)`")
            return none
        }
        var out = emptyTys()
        for (g in info.generics) {
            var got = Ty.Unknown
            if (let some(t) = map.get(g)) {
                got = t
            }
            out.push(got)
        }
        out
    }

    /// A generic class/struct constructor call `Box<int>(arg, ...)`. Resolves
    /// the concrete type arguments, materializes the instantiation plan, and
    /// calls its implicit constructor exactly like a plain `TypeName(arg)`
    /// call. Mirrors `generic_class_call` in emit.rs.
fn genericClassCall(em: Emitter, e: Expr, name: string, cls: ClassTable, typeArgs: List<TypeExpr>, args: List<CallArg>) -> int? {
        var argTys = emptyTys()
        for (te in typeArgs) {
            var t = em.resolved.resolveTy(te, em.fnGenerics, em.diags)
            argTys.push(substTy(em, t))
        }
        if (!(len(argTys) == len(cls.generics))) {
            bad(em, e.span, "`" + name + "` takes " + str(len(cls.generics)) + " type argument(s), found " + str(len(argTys)))
            return none
        }
        var key2 = instKey(name, argTys)
        var cid = 0
        var cidO = em.classInstByArgs.get(key2)
        if (let some(c) = cidO) {
            cid = c
        } else {
            var cg = registerClassInstantiation(em, name, argTys, e.span)
            if (let some(c2) = cg) {
                cid = c2
            } else {
                return none
            }
        }
        var fid = 0
        var fO = em.ctorIds.get(cid)
        if (let none = fO) {
            return none
        }
        if (let some(f2) = fO) {
            fid = f2
        }
        // Mirror the plain class-constructor call: borrow `&T` reference
        // parameters, wrap optional parameters, and store the result.
        var fparams = em.irModule.funcs[fid].params
        var argTemps = emptyInts()
        var i = 0
        while (i < len(args)) {
            var a = args[i]
            if (a.spread) {
                bad(em, a.span, "spread arguments are not lowered yet")
                return none
            }
            var srcO: Ty? = none
            if (let some(v) = em.srcParamTys.get(fid)) {
                if (i < len(v)) {
                    srcO = v[i]
                }
            }
            var isRef = false
            if (let some(sr) = srcO) {
                match (sr) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
            var t = -1
            if (let some(tv) = borrowArg(em, srcO, a)) {
                t = tv
            } else {
                return none
            }
            var fparamIsPtr = false
            if (i < len(fparams)) {
                if (irTyTag(fparams[i].ty) == irTyTag(IrTy.Ptr)) {
                    fparamIsPtr = true
                }
            }
            var finalT = t
            if (!isRef && fparamIsPtr) {
                var vt = Ty.Unknown
                if (let some(gt) = tyOf(em, a.value.span)) {
                    vt = gt
                }
                if (let some(w) = optionWrap(em, t, vt, a.value.span)) {
                    finalT = w
                } else {
                    return none
                }
            }
            argTemps.push(finalT)
            i = i + 1
        }
        var dst = temp(em)
        instr(em, IrInstr.Call(dst, Callee.Func(fid), argTemps))
        guardPropagation(em, fid)
        dst
    }

    /// Create the concrete instantiation of a generic function over `map`
    /// (generic parameter -> concrete type), registering its signature under
    /// `key`, and return its function id. Later calls with the same key reuse
    /// the existing function. Mirrors `instantiate_generic_fn` in emit.rs.
fn instantiateGenericFn(em: Emitter, span: Span, info: CallableInfo, keyName: string, keyTys: List<Ty>, map: Map<string, Ty>) -> int? {
        var name = info.name
        var fO = em.fnDecls.get(name)
        if (let none = fO) {
            bad(em, span, "no declaration for generic function `" + name + "`")
            return none
        }
        var f = seedFnDecl()
        if (let some(d) = fO) {
            f = d
        }
        var hasDefRest = false
        for (p in f.params) {
            if (p.rest) {
                hasDefRest = true
            }
            if (let some(_) = p.default) {
                hasDefRest = true
            }
        }
        if (hasDefRest) {
            bad(em, span, "generic function `" + name + "` with default or rest parameters is not lowered yet")
            return none
        }
        var params = emptyParamInfos()
        for (p in info.params) {
            params.push(ParamInfo(p.name, subst(p.ty, map), p.hasDefault, p.rest, p.span))
        }
        var ret = subst(info.ret, map)
        var symbol = "pkl_" + name + "__"
        var si = 0
        for (t in keyTys) {
            if (si > 0) {
                symbol = symbol + "_"
            }
            symbol = symbol + sanitizeSymbol(bareName(t))
            si = si + 1
        }
        var n = 0
        var symTaken = false
        var fj = 0
        while (fj < len(em.irModule.funcs)) {
            if (em.irModule.funcs[fj].symbol == symbol) {
                symTaken = true
                break
            }
            fj = fj + 1
        }
        while (symTaken) {
            n = n + 1
            symbol = symbol + "_v" + str(n)
            symTaken = false
            var fk = 0
            while (fk < len(em.irModule.funcs)) {
                if (em.irModule.funcs[fk].symbol == symbol) {
                    symTaken = true
                    break
                }
                fk = fk + 1
            }
        }
        if (f.isAsync) {
            // The instantiation is the wrapper; a hidden future body (with the
            // lambda ABI) is registered first so the wrapper can name it. Both
            // carry the substitution, mirroring the non-generic pair.
            var hiddenSymbol = symbol + "__future"
            var hidden = len(em.irModule.funcs)
            em.irModule.funcs.push(IrFunc(name + "__future", hiddenSymbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), false, false, emptyStrs()))
            em.fidList.push(hidden)
            var htys = emptyTys()
            for (p in params) {
                htys.push(p.ty)
            }
            em.fsource[hidden] = FnSource.AsyncBody(f, htys, ret)
            var hiddenInfo = CallableInfo(info.name, info.span, info.visibility, info.isAsync, info.isStatic, info.isOverride, info.isAbstract, info.operator, info.generics, emptyParamInfos(), info.ret)
            em.finfo[hidden] = hiddenInfo
            em.instantonSubst[hidden] = map
            var hg = emptyStrs()
            for (g in f.generics) {
                hg.push(g.name)
            }
            em.fidGenerics[hidden] = hg
            var wfid = len(em.irModule.funcs)
            em.irModule.funcs.push(IrFunc(name, symbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), false, false, emptyStrs()))
            em.fidList.push(wfid)
            em.fsource[wfid] = FnSource.AsyncFn(f, hidden)
            em.finfo[wfid] = CallableInfo(info.name, info.span, info.visibility, info.isAsync, info.isStatic, info.isOverride, info.isAbstract, info.operator, info.generics, params, ret)
            var stys = emptyTys()
            for (p in params) {
                stys.push(p.ty)
            }
            em.srcParamTys[wfid] = stys
            em.instantonSubst[wfid] = map
            var wg = emptyStrs()
            for (g in f.generics) {
                wg.push(g.name)
            }
            em.fidGenerics[wfid] = wg
            em.instantiations[instKey(keyName, keyTys)] = wfid
            return wfid
        }
        var fid = len(em.irModule.funcs)
        em.irModule.funcs.push(IrFunc(name, symbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), false, false, emptyStrs()))
        em.fidList.push(fid)
        em.fsource[fid] = FnSource.TopLevel(f)
        em.finfo[fid] = CallableInfo(info.name, info.span, info.visibility, info.isAsync, info.isStatic, info.isOverride, info.isAbstract, info.operator, info.generics, params, ret)
        var stys = emptyTys()
        for (p in info.params) {
            stys.push(subst(p.ty, map))
        }
        em.srcParamTys[fid] = stys
        em.instantonSubst[fid] = map
        em.instantiations[instKey(keyName, keyTys)] = fid
        fid
    }

    /// A closure-valued callee: evaluate it, check its `fn` signature, then
    /// dispatch indirectly. Mirrors `fn_value_call` in emit.rs.
fn fnValueCall(em: Emitter, e: Expr, callee: Expr, args: List<CallArg>) -> int? {
        var fnty = Ty.Unknown
        if (let some(t) = tyOf(em, callee.span)) {
            fnty = t
        }
        var isFn = false
        match (fnty) {
            case Ty.Fn(_, _) -> isFn = true
            case _ -> {}
        }
        if (!isFn) {
            bad(em, callee.span, "function-valued call has no signature")
            return none
        }
        var obj = 0
        if (let some(o) = expr(em, callee)) {
            obj = o
        } else {
            return none
        }
        fnValueCallFrom(em, e, obj, fnty, args)
    }

    /// Core dynamic dispatch for a closure-valued callee whose object was
    /// already evaluated (`fv`) together with its `fn` type: load the hoisted
    /// body address out of closure slot 0 and call it indirectly with the
    /// closure object first, then the real arguments. Mirrors
    /// `fn_value_call_from` in emit.rs.
fn fnValueCallFrom(em: Emitter, e: Expr, fv: int, fty: Ty, args: List<CallArg>) -> int? {
        var pty = emptyTys()
        var prt = Ty.None
        var isFn = false
        match (fty) {
            case Ty.Fn(pts, r) -> {
                pty = pts
                prt = r
                isFn = true
            }
            case _ -> {}
        }
        if (!isFn) {
            bad(em, e.span, "function-valued call has no signature")
            return none
        }
        var zero = intConst(em, 0)
        var addrBoxed = externCallT1(em, "pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [fv, zero])
        var fnAddr = externCallT1(em, "pickle_unbox_i64", [IrTy.Ptr], IrTy.Int, [addrBoxed])
        var irParams = [IrTy.Ptr]
        var iargs = [fv]
        var i = 0
        while (i < len(args)) {
            var a = args[i]
            if (a.spread) {
                bad(em, a.span, "spread arguments are not lowered yet")
                return none
            }
            var src: Ty? = none
            if (i < len(pty)) {
                src = pty[i]
            }
            var isRef = false
            if (let some(st) = src) {
                match (st) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
            var t = 0
            var bt = borrowArg(em, src, a)
            if (let some(tv) = bt) {
                t = tv
            } else {
                return none
            }
            var mapsPtr = false
            if (let some(st) = src) {
                var mir = mapTy(em, st, a.span)
                if (let some(ir) = mir) {
                    if (irTyTag(ir) == irTyTag(IrTy.Ptr)) {
                        mapsPtr = true
                    }
                }
            }
            if (!isRef && mapsPtr) {
                var vt = Ty.Unknown
                if (let some(v) = tyOf(em, a.value.span)) {
                    vt = v
                }
                var tw = optionWrap(em, t, vt, a.value.span)
                if (let some(twc) = tw) {
                    t = twc
                } else {
                    return none
                }
            }
            var ir = IrTy.Ptr
            if (let some(st) = src) {
                var mir = mapTy(em, st, a.span)
                if (let some(ir2) = mir) {
                    ir = ir2
                }
            }
            irParams.push(ir)
            iargs.push(t)
            i = i + 1
        }
        var irRet = IrTy.Unit
        var mret = mapTy(em, prt, e.span)
        if (let some(ir) = mret) {
            irRet = ir
        }
        var dst = temp(em)
        instr(em, IrInstr.CallInd(dst, fnAddr, irParams, irRet, iargs))
        dst
    }

    /// A closure object holding `fid`'s code address (boxed) in slot 0 and the
    /// given captures (boxed like list elements) in slots 1..N; the slot layout
    /// must match the hoisted body's reads. Mirrors `closure_obj` in emit.rs.
fn closureObj(em: Emitter, e: Expr, fid: int, captures: List<Capture>) -> int? {
        var cid = 0
        if (let some(c) = registerClosureClass(em, len(captures), e.span)) {
            cid = c
        } else {
            return none
        }
        var cidT = intConst(em, cid)
        var nT = intConst(em, len(captures) + 1)
        var obj = externCallT1(em, "pickle_class_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [cidT, nT])
        var addr = temp(em)
        instr(em, IrInstr.Const(addr, IrConst.FuncAddr(fid)))
        var boxed = externCallT1(em, "pickle_box_i64", [IrTy.Int], IrTy.Ptr, [addr])
        var zero = intConst(em, 0)
        externCallVoid(em, "pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, zero, boxed])
        var i = 0
        while (i < len(captures)) {
            var cap = captures[i]
            var slot = -1
            if (let some(s) = lookup(em, cap.name)) {
                slot = s
            } else {
                bad(em, cap.span, "cannot capture `" + cap.name + "` (not in scope here)")
                return none
            }
            var v = load(em, slot)
            var vt = cap.ty
            if (let some(t) = tyOf(em, cap.span)) {
                vt = t
            }
            var rep = ElemRep.ptr()
            if (let some(r) = elemRep(em, cap.ty, cap.span)) {
                rep = r
            } else {
                return none
            }
            var packed = 0
            var pf = packForPointerBoundary(em, rep, v, vt, cap.span)
            if (let some(p) = pf) {
                packed = p
            } else {
                return none
            }
            var boxed2 = 0
            var bf = boxForStore(em, rep, packed, elemIr(cap.ty))
            if (let some(b) = bf) {
                boxed2 = b
            } else {
                return none
            }
            var idx = intConst(em, 1 + i)
            externCallVoid(em, "pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, idx, boxed2])
            i = i + 1
        }
        obj
    }

    /// Lower a lambda expression to a closure object whose slot 0 holds the
    /// address of its pre-registered hoisted body. A lambda inside a generic
    /// function body registers a per-instantiation copy under that enclosing
    /// function id (substituting the instantiation into the signature,
    /// captures, and return type). Mirrors `lambda_value` in emit.rs.
fn lambdaValue(em: Emitter, e: Expr) -> int? {
        var baseKey = lambdaKey(none, e.span)
        var hasInst = false
        if (let some(_) = em.currentFid) {
            hasInst = true
        }
        var instKeyStr = baseKey
        if (hasInst) {
            instKeyStr = lambdaKey(em.currentFid, e.span)
        }
        var fid: int? = none
        if (hasInst) {
            var f1 = em.lambdaFids.get(instKeyStr)
            if (let some(v) = f1) {
                fid = v
            }
        }
        if (let none = fid) {
            var f2 = em.lambdaFids.get(baseKey)
            if (let some(v) = f2) {
                fid = v
            }
        }
        if (let none = fid) {
            if (let some(cls) = genericOwner(em)) {
                bad(em, e.span, "a lambda inside the generic class/struct `" + cls + "` is not lowered yet")
                return none
            }
            var inst = 0
            var instOk = false
            if (let some(i) = em.currentFid) {
                if (len(em.currentSubst) == 0) {
                    instOk = instOk
                } else {
                    inst = i
                    instOk = true
                }
            }
            if (!instOk) {
                bad(em, e.span, "this lambda was not registered for lowering")
                return none
            }
            var caps0 = emptyCaptures()
            var cg = em.lambdaCaps.get(baseKey)
            if (let some(c) = cg) {
                caps0 = c
            }
            var owner: int? = none
            var og = em.lambdaOwners.get(spanKey(e.span))
            if (let some(o) = og) {
                owner = o
            }
            var sub = emptyStringTyMap()
            var sg = em.instantonSubst.get(inst)
            if (let some(s) = sg) {
                sub = s
            }
            var le2 = Expr(Span(0, 0), ExprKind.This)
            var lg = em.lambdaExprs.get(spanKey(e.span))
            if (let some(l) = lg) {
                le2 = l
            } else {
                bad(em, e.span, "this lambda was not registered for lowering")
                return none
            }
            var base: int? = none
            base = inst
            fid = registerLambdaAt(em, le2, caps0, owner, sub, base)
        }
        if (let none = fid) {
            bad(em, e.span, "this lambda was not registered for lowering")
            return none
        }
        var caps = emptyCaptures()
        var gotCaps = false
        if (hasInst) {
            var c1 = em.lambdaCaps.get(instKeyStr)
            if (let some(c) = c1) {
                caps = c
                gotCaps = true
            }
        }
        if (!gotCaps) {
            var c2 = em.lambdaCaps.get(baseKey)
            if (let some(c) = c2) {
                caps = c
            }
        }
        var fidV = 0
        if (let some(f) = fid) {
            fidV = f
        } else {
            bad(em, e.span, "this lambda was not registered for lowering")
            return none
        }
        closureObj(em, e, fidV, caps)
    }

    /// A top-level function referenced as a value: wrap its forwarder trampoline
    /// (not the function itself) in a zero-capture closure object, so the
    /// dynamic-call convention -- closure object first, then the real
    /// arguments -- applies to module functions exactly as to hoisted lambda
    /// bodies. Mirrors `fn_value_closure` in emit.rs.
fn fnValueClosure(em: Emitter, e: Expr, fid: int) -> int? {
        let _ = fid
        var tramp = 0
        var tg = em.fnTramp.get(spanKey(e.span))
        if (let some(t) = tg) {
            tramp = t
        } else {
            bad(em, e.span, "function value was not registered for dynamic dispatch")
            return none
        }
        return closureObj(em, e, tramp, emptyCaptures())
    }

    /// When a call argument is a *generic user function* given bare (no type
    /// arguments) and the expected parameter type is `fn`, infer the function's
    /// type arguments from that fn type and materialize the concrete
    /// instantiation as a value. `some(t)` means materialized; `none` lets the
    /// regular argument path handle it (a `funcs_by_name` member, or the clean
    /// "as a value is not lowered yet" diagnostic). Mirrors
    /// `generic_fn_arg_value` in emit.rs.
fn genericFnArgValue(em: Emitter, v: Expr, hint: Ty) -> int? {
        var name = ""
        var isIdent = false
        match (v.kind) {
            case ExprKind.Ident(n) -> {
                name = n
                isIdent = true
            }
            case _ -> {}
        }
        if (!isIdent) {
            return none
        }
        var info = userCallableFirst(em, name)
        if (let none = info) {
            return none
        }
        var inf = seedCallableInfo()
        if (let some(x) = info) {
            inf = x
        }
        if (len(inf.generics) == 0) {
            return none
        }
        var pty = emptyTys()
        for (p in inf.params) {
            pty.push(p.ty)
        }
        var sig = Ty.Fn(pty, inf.ret)
        var map = emptyStringTyMap()
        inferFrom(sig, hint, map)
        var argTys = emptyTys()
        for (g in inf.generics) {
            var got = Ty.Unknown
            if (let some(t) = map.get(g)) {
                got = t
            }
            argTys.push(got)
        }
        var hasBadArg = false
        for (at in argTys) {
            var badKind = false
            match (at) {
                case Ty.Unknown -> badKind = true
                case Ty.Var(_) -> badKind = true
                case _ -> {}
            }
            if (hasVar(at) || badKind) {
                hasBadArg = true
            }
        }
        if (hasBadArg) {
            return none
        }
        genericFnValueFor(em, v, inf, argTys)
    }

    /// An instance method bound to a receiver, used as a value: a one-capture
    /// closure object whose slot 0 is the method trampoline and whose slot 1 is
    /// the receiver object, so `fn_value_call` dispatches through it exactly
    /// like a lambda capture. Mirrors `bound_method_value` in emit.rs.
fn boundMethodValue(em: Emitter, e: Expr, object: Expr) -> int? {
        var tramp = 0
        var tg = em.fnTramp.get(spanKey(e.span))
        if (let some(t) = tg) {
            tramp = t
        } else {
            bad(em, e.span, "bound method was not registered for dynamic dispatch")
            return none
        }
        var cid = 0
        if (let some(c) = registerClosureClass(em, 1, e.span)) {
            cid = c
        } else {
            return none
        }
        var cidT = intConst(em, cid)
        var nT = intConst(em, 2)
        var obj = externCallT1(em, "pickle_class_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [cidT, nT])
        var addr = temp(em)
        instr(em, IrInstr.Const(addr, IrConst.FuncAddr(tramp)))
        var boxed = externCallT1(em, "pickle_box_i64", [IrTy.Int], IrTy.Ptr, [addr])
        var zero = intConst(em, 0)
        externCallVoid(em, "pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, zero, boxed])
        var recv = 0
        if (let some(r) = expr(em, object)) {
            recv = r
        } else {
            return none
        }
        var recvTy = Ty.Unknown
        if (let some(t) = tyOf(em, object.span)) {
            recvTy = t
        }
        var packed = 0
        var pf = packForPointerBoundary(em, ElemRep.ptr(), recv, recvTy, e.span)
        if (let some(p) = pf) {
            packed = p
        } else {
            return none
        }
        var one = intConst(em, 1)
        externCallVoid(em, "pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, one, packed])
        obj
    }

    // ---- literals: tuple / array / map ----

    /// `(a, b, c)` tuple literal: allocate a tuple and set each field, boxing
    /// scalars. Mirrors `tuple_literal` in emit.rs.
fn tupleLiteral(em: Emitter, e: Expr, items: List<Expr>) -> int? {
        var tys = emptyTys()
        var isTuple = false
        if (let some(t) = tyOf(em, e.span)) {
            match (t) {
                case Ty.Tuple(parts) -> {
                    tys = parts
                    isTuple = true
                }
                case _ -> {}
            }
        }
        if (!isTuple) {
            bad(em, e.span, "tuple literal does not have a `Tuple` type")
            return none
        }
        if (len(items) == 0) {
            bad(em, e.span, "empty tuple values are not lowered yet")
            return none
        }
        if (len(tys) != len(items)) {
            bad(em, e.span, "tuple literal element/type count mismatch")
            return none
        }
        var nn = intConst(em, len(items))
        var tv = externCallT1(em, "pickle_tuple_new", [IrTy.Int], IrTy.Ptr, [nn])
        var i = 0
        for (it in items) {
            var v = expr(em, it)
            if (let some(v) = v) {
                var rp = elemRep(em, tys[i], e.span)
                if (let some(rep) = rp) {
                    var storeV = v
                    if (!(rep.isPtr)) {
                        var vTy = irty(em, it.span)
                        if (let some(vTy) = vTy) {
                            storeV = externCallT1(em, rep.boxSym, [vTy], IrTy.Ptr, [v])
                        } else {
                            return none
                        }
                    }
                    var idx = intConst(em, i)
                    externCallVoid(em, "pickle_tuple_set_field", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [tv, idx, storeV])
                } else {
                    return none
                }
            } else {
                return none
            }
            i = i + 1
        }
        tv
    }

    /// `[a, b, c]` array literal: build a `List` by pushing each element,
    /// boxing scalars. Mirrors `array_literal`.
fn arrayLiteral(em: Emitter, e: Expr, items: List<Expr>) -> int? {
        var elemTy = Ty.Unknown
        var isList = false
        if (let some(t) = tyOf(em, e.span)) {
            match (t) {
                case Ty.List(inner) -> {
                    elemTy = inner
                    isList = true
                }
                case _ -> {}
            }
        }
        if (!isList) {
            bad(em, e.span, "array literal does not have a `List` type")
            return none
        }
        if (len(items) == 0) {
            bad(em, e.span, "empty array literal cannot be typed; add an element to infer `List<T>`")
            return none
        }
        var rp = elemRep(em, elemTy, e.span)
        if (let some(rep) = rp) {
            var cap = intConst(em, len(items))
            var list = externCallT1(em, "pickle_list_new", [IrTy.Int], IrTy.Ptr, [cap])
            for (it in items) {
                var v = expr(em, it)
                if (let some(v) = v) {
                    var pushV = v
                    if (!(rep.isPtr)) {
                        var vTy = irty(em, it.span)
                        if (let some(vTy) = vTy) {
                            pushV = externCallT1(em, rep.boxSym, [vTy], IrTy.Ptr, [v])
                        } else {
                            return none
                        }
                    }
                    externCallVoid(em, "pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [list, pushV])
                } else {
                    return none
                }
            }
            return list
        }
        none
    }

    /// `{ "k": v, ... }` map literal: build a `Map` by inserting each entry,
    /// boxing scalar values and scalar keys. Mirrors `map_literal`.
fn mapLiteral(em: Emitter, e: Expr, entries: List<MapEntry>) -> int? {
        var kty = Ty.Unknown
        var vty = Ty.Unknown
        var isMap = false
        if (let some(t) = tyOf(em, e.span)) {
            match (t) {
                case Ty.Map(k, v) -> {
                    kty = k
                    vty = v
                    isMap = true
                }
                case _ -> {}
            }
        }
        if (!isMap) {
            bad(em, e.span, "map literal does not have a `Map` type")
            return none
        }
        var kp = keyRep(em, kty, e.span)
        var vp = elemRep(em, vty, e.span)
        if (let some(krep) = kp) {
            if (let some(vrep) = vp) {
                var cap = intConst(em, 0)
                var mp = externCallT1(em, "pickle_map_new", [IrTy.Int], IrTy.Ptr, [cap])
for (entry in entries) {
                    var k = expr(em, entry.key)
                    if (let some(k) = k) {
                        var kTy = kty
                        var kTyO = tyOf(em, entry.key.span)
                        if (let some(t) = kTyO) {
                            kTy = t
                        }
                        var keyO = packMapKey(em, krep, k, kTy, entry.key.span)
                        if (let some(key) = keyO) {
                            var vt = expr(em, entry.value)
                                if (let some(vt) = vt) {
                                    var boxed = vt
                                    if (!(vrep.isPtr)) {
                                        var vTy = irty(em, entry.value.span)
                                        if (let some(vTy) = vTy) {
                                            boxed = externCallT1(em, vrep.boxSym, [vTy], IrTy.Ptr, [vt])
                                        } else {
                                            return none
                                        }
                                    }
                                    externCallVoid(em, "pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [mp, key, boxed])
} else {
                                    return none
                                }
                            } else {
                                return none
                            }
                    } else {
                        return none
                    }
                }
                return mp
            }
            return none
        }
        none
    }

/// Box a scalar so it can be stored in a List/Map, or pass a pointer type
    /// through untouched. Mirrors `box_for_store`.
fn boxForStore(em: Emitter, rep: ElemRep, v: int, vTy: IrTy) -> int? {
        if (rep.isPtr) {
            return v
        }
        externCallT1(em, rep.boxSym, [vTy], IrTy.Ptr, [v])
    }

    /// The `key` operand for a map op. Scalar keys are boxed; `Ptr` keys
    /// (option/tuple/composite/string) pass through as the managed pointer,
    /// except a raw scalar operand that must be lifted to its canonical
    /// `Option<T>` pointer form first (e.g. `m[5]` on a `Map<int?, V>`).
    /// Mirrors `pack_map_key` in emit.rs.
fn packMapKey(em: Emitter, rep: ElemRep, v: int, vt: Ty, span: Span) -> int? {
        if (rep.isPtr) {
            optionWrap(em, v, vt, span)
        } else {
            var vIrO = mapTy(em, vt, span)
            if (let none = vIrO) {
                return none
            }
            var vIr = IrTy.Int
            if (let some(t) = vIrO) {
                vIr = t
            }
            externCallT1(em, rep.boxSym, [vIr], IrTy.Ptr, [v])
        }
    }

    // ---- indexes ----

    /// `a[i]` reads: `Map<K, V>`, `&Map`, scalar `&T`/`T&` raw loads, `List<T>`
    /// and `&List`, and `String`. Mirrors `index_read`/`map_index_read`.
fn indexRead(em: Emitter, e: Expr, object: Expr, index: Expr) -> int? {
        if (let some(t) = tyOf(em, object.span)) {
            match (t) {
                case Ty.Map(k, v) -> {
                    return mapIndexRead(em, e, object, index, k, v)
                }
                case _ -> {}
            }
        }
        if (let some(t) = tyOf(em, object.span)) {
            match (t) {
                case Ty.Ref(iner) -> {
                    match (iner) {
                        case Ty.Map(k, v) -> {
                        return mapIndexRead(em, e, object, index, k, v)
                    }
                        case _ -> {}
                    }
                }
                case _ -> {}
            }
        }
        var elemTy = Ty.Unknown
        var didList = false
        var ot = tyOf(em, object.span)
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Ptr(iner) -> {
                    if (let some(el) = scalarIr(iner)) {
                        var base = expr(em, object)
                        if (let some(base) = base) {
                            var idx = expr(em, index)
                            if (let some(idx) = idx) {
                                var addr = ptrElementAddr(em, base, idx, el, e.span)
                                if (let some(addr) = addr) {
                                    var dst = temp(em)
                                    instr(em, IrInstr.LoadRaw(dst, addr, el))
                                    return dst
                                }
                                return none
                            }
                            return none
                        }
                        return none
                    }
                }
                case Ty.Ref(iner) -> {
                    if (let some(el) = scalarIr(iner)) {
                        var base = expr(em, object)
                        if (let some(base) = base) {
                            var idx = expr(em, index)
                            if (let some(idx) = idx) {
                                var addr = ptrElementAddr(em, base, idx, el, e.span)
                                if (let some(addr) = addr) {
                                    var dst = temp(em)
                                    instr(em, IrInstr.LoadRaw(dst, addr, el))
                                    return dst
                                }
                                return none
                            }
                            return none
                        }
                        return none
                    }
                }
                case Ty.List(iner) -> {
                    elemTy = iner
                    didList = true
                }
                case Ty.String -> {
                    var obj = expr(em, object)
                    if (let some(obj) = obj) {
                        var idx = expr(em, index)
                        if (let some(idx) = idx) {
                            return externCallT1(em, "pickle_str_get", [IrTy.Ptr, IrTy.Int], IrTy.Int, [obj, idx])
                        }
                        return none
                    }
                    return none
                }
                case _ -> {}
            }
        }
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Ref(iner) -> {
                    match (iner) {
                        case Ty.List(el) -> {
                            elemTy = el
                            didList = true
                        }
                        case Ty.String -> {
                            var obj = expr(em, object)
                            if (let some(obj) = obj) {
                                var idx = expr(em, index)
                                if (let some(idx) = idx) {
                                    return externCallT1(em, "pickle_str_get", [IrTy.Ptr, IrTy.Int], IrTy.Int, [obj, idx])
                                }
                                return none
                            }
                            return none
                        }
                        case _ -> {}
                    }
                }
                case _ -> {}
            }
        }
        if (!didList) {
            bad(em, e.span, "indexing this type is not lowered yet")
            return none
        }
        var rp = elemRep(em, elemTy, e.span)
        if (let some(rep) = rp) {
            var obj = expr(em, object)
            if (let some(obj) = obj) {
                var idx = expr(em, index)
                if (let some(idx) = idx) {
                    var raw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idx])
                    if (rep.isPtr) {
                        return raw
                    }
                    return externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
                }
                return none
            }
            return none
        }
        none
    }

    /// `m[k]` read for a `Map<K, V>` / scalar-keyed map. Absent keys yield the
    /// value type's default via the runtime's boxed get. Mirrors
    /// `map_index_read`.
fn mapIndexRead(em: Emitter, e: Expr, object: Expr, index: Expr, kty: Ty, vty: Ty) -> int? {
        var kp = keyRep(em, kty, index.span)
        var vp = elemRep(em, vty, e.span)
        if (let some(krep) = kp) {
            if (let some(vrep) = vp) {
var obj = expr(em, object)
                if (let some(obj) = obj) {
                    var k = expr(em, index)
                    if (let some(k) = k) {
                        var kTy = kty
                        var kTyO = tyOf(em, index.span)
                        if (let some(t) = kTyO) {
                            kTy = t
                        }
                        var keyO = packMapKey(em, krep, k, kTy, index.span)
                        if (let some(key) = keyO) {
                                var defaultVal = 0
                                var haveDefault = false
                                if (!(vrep.isPtr)) {
                                    var zero = zeroScalar(em, vrep.ir, index.span)
                                    if (let some(zero) = zero) {
                                        defaultVal = externCallT1(em, vrep.boxSym, [vrep.ir], IrTy.Ptr, [zero])
                                        haveDefault = true
                                    } else {
                                        return none
                                    }
                                } else if (vty == Ty.String) {
                                    var sl = stringLiteral(em, emptyStrParts())
                                    if (let some(sl) = sl) {
                                        defaultVal = sl
                                        haveDefault = true
                                    } else {
                                        return none
                                    }
                                } else {
                                    var nul = nullTemp(em)
                                    if (let some(nul) = nul) {
                                        defaultVal = externCallT1(em, "pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, nul])
                                        haveDefault = true
                                    } else {
                                        return none
                                    }
                                }
                                if (haveDefault) {
                                    var raw = externCallT1(em, "pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, defaultVal])
                                    if (vrep.isPtr) {
                                        return raw
                                    }
                                    return externCallT1(em, vrep.unboxSym, [IrTy.Ptr], vrep.ir, [raw])
                                }
                                return none
                            }
                            return none
                        }
                        return none
                    }
                    return none
}
                return none
            }
            none
    }

    /// `base + idx * stride` ???????? the address of element `idx` of a raw pointer to
    /// a scalar `element`. Mirrors `ptr_element_addr`.
fn ptrElementAddr(em: Emitter, base: int, idx: int, elem: IrTy, span: Span) -> int? {
        var stride = -1
        if (irTyTag(elem) == irTyTag(IrTy.Bool)) {
            stride = 1
        } else if (irTyTag(elem) == irTyTag(IrTy.Char)) {
            stride = 4
        } else if (irTyTag(elem) == irTyTag(IrTy.Int)) {
            stride = 8
        } else if (irTyTag(elem) == irTyTag(IrTy.Float)) {
            stride = 8
        }
        if (stride < 0) {
            bad(em, span, "this pointee type is not indexed yet")
            return none
        }
        var s = intConst(em, stride)
        var off = temp(em)
        instr(em, IrInstr.BinOp(off, IrBinOp.Mul, idx, s))
        var addr = temp(em)
        instr(em, IrInstr.BinOp(addr, IrBinOp.Add, base, off))
        addr
    }

    // ---- static fields / class consts ----

    /// Read a static field cell: box scalars are unboxed after
    /// `pickle_static_get(cid, slot, v)`. Mirrors `static_read`.
fn staticRead(em: Emitter, span: Span, cid: int, slot: int, fieldTy: Ty) -> int? {
        var rp = elemRep(em, fieldTy, span)
        if (let some(rep) = rp) {
            var c = intConst(em, cid)
            var s = intConst(em, slot)
            var raw = externCallT1(em, "pickle_static_get", [IrTy.Int, IrTy.Int], IrTy.Ptr, [c, s])
            if (rep.isPtr) {
                return raw
            }
            return externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
        }
        none
    }

    /// Static-field store: box scalars, then `pickle_static_set(cid, slot, v)`.
fn staticStore(em: Emitter, cid: int, slot: int, boxed: int) {
        var c = intConst(em, cid)
        var s = intConst(em, slot)
        externCallVoid(em, "pickle_static_set", [IrTy.Int, IrTy.Int, IrTy.Ptr], [c, s, boxed])
    }

    /// Inline a class constant's initializer at a use site. Returns `none`
    /// when `name` is not a constant of class `cid` (or an ancestor). Mirrors
    /// `read_class_const`.
fn readClassConst(em: Emitter, span: Span, cid: int, name: string) -> int? {
        var plan: ClassPlan? = none
        for (p in em.classes) {
            if (p.classId == cid) {
                plan = p
                break
            }
        }
        if (let none = plan) {
            return none
        }
        var pname = ""
        if (let some(p) = plan) {
            pname = p.name
        }
        var chain = ancestry(em, pname)
        var ci = len(chain)
        while (ci >= 1) {
            ci = ci - 1
            var cn = chain[ci]
            var dcO = em.classByName.get(cn)
            if (let some(dc) = dcO) {
                var k = pairKey(str(dc), name)
                if (em.classConsts.has(k)) {
                    var key = classOfName(em, dc) + "." + name
                    if (strListHas(em.constInlining, key)) {
                        bad(em, span, "cyclic `const` initialization of `" + key + "`")
                        return none
                    }
                    em.constInlining.push(key)
                    var savedOwner = em.owner
                    em.owner = dc
                    var ccO = em.classConsts.get(k)
                    if (let some(cc) = ccO) {
                        var tv = expr(em, cc.init)
                        em.owner = savedOwner
                        em.constInlining.pop()
                        return tv
                    }
                    em.owner = savedOwner
                    em.constInlining.pop()
                    return none
                }
            }
        }
        none
    }

    /// Parent-first run of `cname`'s instance fields including inherited ones.
    /// Mirrors `all_instance_fields`.
fn allInstanceFields(em: Emitter, cname: string) -> List<FieldInfo> {
        var out = emptyFieldInfos()
        for (cn in ancestry(em, cname)) {
            var own = ownInstanceFields(em, cn)
            for (f in own) {
                out.push(f)
            }
        }
        out
    }

    /// The `FieldInfo` for instance field slot `idx` of class `cid` (parent-
    /// first layout).
fn fieldAt(em: Emitter, cid: int, idx: int) -> FieldInfo {
        for (p in em.classes) {
            if (p.classId == cid) {
                var all = allInstanceFields(em, p.name)
                if (idx < len(all)) {
                    return all[idx]
                }
                return seedFieldInfo()
            }
        }
        seedFieldInfo()
    }

    /// The display name of a registered class id.
fn classOfName(em: Emitter, cid: int) -> string {
        for (p in em.classes) {
            if (p.classId == cid) {
                return p.name
            }
        }
        "class#" + str(cid)
    }

    // ---- statements ----

    /// Lower one statement into the current block. `true` on success; hard
    /// errors set `this.failed` through `bad` and return `false`.
fn stmt(em: Emitter, s: Stmt) -> bool {
        if (em.iceDepth > 150) {
            return false
        }
        em.iceDepth = em.iceDepth + 1
        em.icePath.push("stmt")
        var r = stmt1(em, s)
        em.iceDepth = em.iceDepth - 1
        r
    }

fn stmt1(em: Emitter, s: Stmt) -> bool {
        if (!icePoke(em, "stmt1")) {
            return false
        }
        match (s) {
            case Stmt.Let(pattern, ty, init, _mutable, attrs, span) -> {
                var manual = false
                for (a in attrs) {
                    if (a.name == "manualAlloc") {
                        manual = true
                    }
                }
                match (pattern) {
                    case Pattern.Binding(nm, patTy) -> {
                        var annot = ty
                        if (let some(pt) = patTy) {
                            annot = pt
                        }
                        var annOption = false
                        if (let some(at) = annot) {
                            match (at.kind) {
                                case TypeExprKind.Option(_) -> annOption = true
                                case _ -> {}
                            }
                        }
                        var slotTy = IrTy.Ptr
                        if (annOption) {
                            slotTy = IrTy.Ptr
                        } else {
                            if (let some(i) = init) {
                                if (let some(it) = irty(em, i.span)) {
                                    slotTy = it
                                } else {
                                    return false
                                }
                            } else {
                                if (let none = annotTy(em, annot, span)) {
                                    return false
                                }
                                if (let some(at2) = annotTy(em, annot, span)) {
                                    slotTy = at2
                                }
                            }
                        }
                        var slot = newSlot(em, slotTy)
                        if (let some(e) = init) {
                            var t = -1
                            if (let some(tv) = expr(em, e)) {
                                t = tv
                            } else {
                                return false
                            }
                            var v = t
                            if (irTyTag(slotTy) == irTyTag(IrTy.Ptr)) {
                                var vt = Ty.Unknown
                                if (let some(gt) = tyOf(em, e.span)) {
                                    vt = gt
                                }
                                if (let some(w) = optionWrap(em, v, vt, e.span)) {
                                    v = w
                                } else {
                                    return false
                                }
                            }
                            if (manual) {
                                v = externCallT1(em, "pickle_manual_adopt", [IrTy.Ptr], IrTy.Ptr, [v])
                            }
                            instr(em, IrInstr.StoreSlot(slot, v))
                        }
                        declare(em, nm, slot)
                        if (manual) {
                            declareManual(em, nm)
                        }
                        true
                    }
                    case Pattern.Wildcard -> {
                        if (let some(e) = init) {
                            if (let none = expr(em, e)) {
                                return false
                            }
                        }
                        true
                    }
case Pattern.Tuple(_) -> {
                        if (let none = init) {
                            bad(em, span, "destructuring patterns require an initializer")
                            return false
                        }
                        var st = Ty.Unknown
                        if (let some(it) = init) {
                            if (let some(gt) = tyOf(em, it.span)) {
                                st = gt
                            }
                        }
                        if (let some(e) = init) {
                            var v = -1
                            if (let some(t) = expr(em, e)) {
                                v = t
                            } else {
                                return false
                            }
                            if (!(bindMatchValue(em, pattern, st, v, e.span))) {
                                return false
                            }
                        }
                        true
                    }
                    case _ -> {
                        bad(em, span, "destructuring patterns are not lowered yet")
                        false
                    }
                }
            }
            case Stmt.Const(name, _ty, value, _span) -> {
                var t = -1
                if (let some(tv) = expr(em, value)) {
                    t = tv
                } else {
                    return false
                }
                var ty2 = IrTy.Ptr
                if (let some(it) = irty(em, value.span)) {
                    ty2 = it
                } else {
                    return false
                }
                var slot = newSlot(em, ty2)
                var v = t
                if (irTyTag(ty2) == irTyTag(IrTy.Ptr)) {
                    var vt = Ty.Unknown
                    if (let some(gt) = tyOf(em, value.span)) {
                        vt = gt
                    }
                    if (let some(w) = optionWrap(em, v, vt, value.span)) {
                        v = w
                    } else {
                        return false
                    }
                }
                instr(em, IrInstr.StoreSlot(slot, v))
                declare(em, name, slot)
                true
            }
            case Stmt.Return(value, _span) -> {
                var v: int? = none
                if (let some(e) = value) {
                    var t = -1
                    if (let some(tv) = expr(em, e)) {
                        t = tv
                    } else {
                        return false
                    }
                    if (irTyTag(em.fret) == irTyTag(IrTy.Ptr)) {
                        var vt = Ty.Unknown
                        if (let some(gt) = tyOf(em, e.span)) {
                            vt = gt
                        }
                        if (let some(w) = optionWrap(em, t, vt, e.span)) {
                            v = w
                        } else {
                            return false
                        }
                    } else {
                        v = t
                    }
                }
                exitThroughFinallys(em, Exit.Return(v))
                true
            }
            case Stmt.Break(_span) -> {
                if (let none = loopBreakTarget(em)) {
                    badSpanNote(em, "unbalanced `break`")
                    return false
                }
                var target = -1
                if (let some(t) = loopBreakTarget(em)) {
                    target = t
                }
                exitThroughFinallys(em, Exit.Branch(target))
                true
            }
            case Stmt.Continue(_span) -> {
                if (let none = loopContinueTarget(em)) {
                    badSpanNote(em, "unbalanced `continue`")
                    return false
                }
                var target = -1
                if (let some(t) = loopContinueTarget(em)) {
                    target = t
                }
                exitThroughFinallys(em, Exit.Branch(target))
                true
            }
            case Stmt.While(cond, body, span) -> whileStmt(em, cond, body, span)
            case Stmt.For(header, body, span) -> forStmt(em, header, body, span)
            case Stmt.Try(body, binder, handler, fin, span) -> tryStmt(em, body, binder, handler, fin, span, none)
            case Stmt.Throw(value, span) -> throwStmt(em, value, span)
            case Stmt.Expr(e) -> {
                if (let none = expr(em, e)) {
                    return false
                }
                true
            }
            case Stmt.Empty(_span) -> true
        }
    }

    /// `while (cond)` lowering: the `cond` block branches into the body, which
    /// back-edges to `cond`.
fn whileStmt(em: Emitter, cond: Expr, body: Block, span: Span) -> bool {
        let _ = span
        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var c = -1
        if (let some(cv) = expr(em, cond)) {
            c = cv
        } else {
            return false
        }
        term(em, IrTerm.BranchIf(c, bodyId, endId))
        em.cur = bodyId
        pushLoop(em, endId, condId)
        pushScope(em)
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// `for` loops: header initialization, a condition block, a body, and a
    /// step block (`continue` targets the step so it still runs).
fn forStmt(em: Emitter, header: ForHeader, body: Block, span: Span) -> bool {
        match (header) {
            case ForHeader.Range(init, cond, step) -> {
                if (!(stmt(em, init))) {
                    return false
                }
                var condId = newBlock(em)
                var bodyId = newBlock(em)
                var stepId = newBlock(em)
                var endId = newBlock(em)
                term(em, IrTerm.Branch(condId))
                em.cur = condId
                var c = -1
                if (let some(cv) = expr(em, cond)) {
                    c = cv
                } else {
                    return false
                }
                term(em, IrTerm.BranchIf(c, bodyId, endId))
                em.cur = bodyId
                pushLoop(em, endId, stepId)
                pushScope(em)
                if (!(blockBodyOnly(em, body))) {
                    popScope(em)
                    em.loops.pop()
                    return false
                }
                popScope(em)
                em.loops.pop()
                term(em, IrTerm.Branch(stepId))
                em.cur = stepId
                if (let none = expr(em, step)) {
                    return false
                }
                term(em, IrTerm.Branch(condId))
                em.cur = endId
                true
            }
case ForHeader.In(pattern, seq) -> forIn(em, pattern, seq, body, span)
        }
    }

    /// `for (x in seq)` / `for ((k, v) in m)`: dispatch on the sequence type,
    /// mirroring `for_in` in emit.rs. A `List` iterates by index; a `String`
    /// iterates bytes; a `Map` with a `(k, v)` binding iterates map entries
    /// (in lockstep key/value snapshots) and otherwise iterates its values; an
    /// `Iterable<T>` falls back to the protocol loop; integer ranges lower to
    /// an index loop with an inclusive/exclusive bound.
fn forIn(em: Emitter, pattern: Pattern, sequence: Expr, body: Block, span: Span) -> bool {
        var seqOt = forInSeqTy(em, sequence.span)
        if (let some(ot) = seqOt) {
            match (ot) {
                case Ty.Map(k, v) -> {
                    match (pattern) {
                        case Pattern.Tuple(parts) -> {
                            if (!(len(parts) == 2)) {
                                return bad(em, span, "map entries pattern must bind exactly two names `(k, v)`")
                            }
                            var kname = ""
                            match (parts[0]) {
                                case Pattern.Binding(nm, _) -> kname = nm
                                case _ -> {
                                    return bad(em, span, "map entries sub-patterns must be plain names")
                                }
                            }
                            var vname = ""
                            match (parts[1]) {
                                case Pattern.Binding(nm, _) -> vname = nm
                                case _ -> {
                                    return bad(em, span, "map entries sub-patterns must be plain names")
                                }
                            }
                            var mapT = -1
                            if (let some(mt) = expr(em, sequence)) {
                                mapT = mt
                            } else {
                                return false
                            }
                            return forInMapEntries(em, kname, vname, mapT, k, v, body, span)
                        }
                        case _ -> {}
                    }
                }
                case _ -> {}
            }
        }
        var seqOt2 = forInSeqTy(em, sequence.span)
        if (let some(ot) = seqOt2) {
            match (ot) {
                case Ty.String -> {
                    var nm = ""
                    match (pattern) {
                        case Pattern.Binding(nm2, _) -> nm = nm2
                        case _ -> {
                            return bad(em, span, "iteration patterns other than a binding are not lowered yet")
                        }
                    }
                    var seqT = -1
                    if (let some(st) = expr(em, sequence)) {
                        seqT = st
                    } else {
                        return false
                    }
                    return forInString(em, nm, seqT, body)
                }
                case Ty.List(inner) -> {
                    var elemT = inner
                    var seqT = -1
                    if (let some(st) = expr(em, sequence)) {
                        seqT = st
                    } else {
                        return false
                    }
                    return forInValues(em, pattern, seqT, elemT, body, span)
                }
                case Ty.Range(inner) -> {
                    var elemT = inner
                    var seqT = -1
                    if (let some(st) = expr(em, sequence)) {
                        seqT = st
                    } else {
                        return false
                    }
                    return forInValues(em, pattern, seqT, elemT, body, span)
                }
                case Ty.Map(_, v) -> {
                    var isBind = false
                    match (pattern) {
                        case Pattern.Binding(_, _) -> isBind = true
                        case _ -> {}
                    }
                    if (!isBind) {
                        return bad(em, span, "iteration patterns other than a binding are not lowered yet")
                    }
                    var mapT = -1
                    if (let some(mt) = expr(em, sequence)) {
                        mapT = mt
                    } else {
                        return false
                    }
                    var vals = externCallT1(em, "pickle_map_values", [IrTy.Ptr], IrTy.Ptr, [mapT])
                    return forInValues(em, pattern, vals, v, body, span)
                }
                case _ -> {}
            }
        }
        var iterElemTy = Ty.Unknown
        if (let some(ot) = seqOt2) {
            iterElemTy = ot
        }
        if (let some(el) = iterableElem(em, iterElemTy)) {
            var seqT = -1
            if (let some(st) = expr(em, sequence)) {
                seqT = st
            } else {
                return false
            }
            return forInProtocol(em, pattern, el, seqT, body, span)
        }
        var start: Expr? = none
        var end: Expr? = none
        var incl = false
        var isRange = false
        match (sequence.kind) {
            case ExprKind.Binary(op, lhs, rhs) -> {
                if (op == BinOp.Range) {
                    start = lhs
                    end = rhs
                    isRange = true
                }
                if (op == BinOp.RangeIncl) {
                    start = lhs
                    end = rhs
                    incl = true
                    isRange = true
                }
            }
            case _ -> {}
        }
        if (!isRange) {
            return bad(em, sequence.span, "`for (x in ...)` over non-range, non-list sequences is not lowered yet")
        }
        if (let none = start) {
            return bad(em, sequence.span, "`for (x in ...)` over non-range, non-list sequences is not lowered yet")
        }
        if (let none = end) {
            return bad(em, sequence.span, "`for (x in ...)` over non-range, non-list sequences is not lowered yet")
        }
        var startE: Expr? = start
        var endE: Expr? = end
        if (let some(s) = startE) {
            if (!(ensureInt(em, s))) {
                return false
            }
        }
        if (let some(e) = endE) {
            if (!(ensureInt(em, e))) {
                return false
            }
        }
        var startT = -1
        var endT = -1
        if (let some(s) = startE) {
            if (let some(st) = expr(em, s)) {
                startT = st
            } else {
                return false
            }
        }
        if (let some(e) = endE) {
            if (let some(et) = expr(em, e)) {
                endT = et
            } else {
                return false
            }
        }
        var idx = newSlot(em, IrTy.Int)
        var endSlot = newSlot(em, IrTy.Int)
        instr(em, IrInstr.StoreSlot(idx, startT))
        instr(em, IrInstr.StoreSlot(endSlot, endT))

        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var nextId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var curT = load(em, idx)
        var endL = load(em, endSlot)
        var cmpOp = IrBinOp.Lt
        if (incl) {
            cmpOp = IrBinOp.Le
        }
        var cmp = temp(em)
        instr(em, IrInstr.BinOp(cmp, cmpOp, curT, endL))
        term(em, IrTerm.BranchIf(cmp, bodyId, endId))
        em.cur = bodyId
        pushLoop(em, endId, nextId)
        pushScope(em)
        var nm2 = ""
        match (pattern) {
            case Pattern.Binding(nm3, _) -> nm2 = nm3
            case _ -> {
                return bad(em, span, "iteration patterns other than a binding are not lowered yet")
            }
        }
        declare(em, nm2, idx)
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(nextId))
        em.cur = nextId
        var c = load(em, idx)
        var one = temp(em)
        instr(em, IrInstr.Const(one, IrConst.Int(1)))
        var nxt = temp(em)
        instr(em, IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        instr(em, IrInstr.StoreSlot(idx, nxt))
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// `ty_of(span)`, unwrapping a `&T` reference so a `for` over a reference
    /// iterates the referenced sequence. Mirrors the `Ty::Ref` unwrap at the
    /// top of `for_in` in emit.rs.
fn forInSeqTy(em: Emitter, span: Span) -> Ty? {
        if (let some(t) = tyOf(em, span)) {
            match (t) {
                case Ty.Ref(inner) -> inner
                case other -> other
            }
        } else {
            none
        }
    }

    /// `for (x in seq)` over a sequence value: by-index iteration over a
    /// managed list pointer, unboxing scalar elements per trip as
    /// `for_in_values` does.
fn forInValues(em: Emitter, pattern: Pattern, seqT: int, elem: Ty, body: Block, span: Span) -> bool {
        var rp = elemRep(em, elem, span)
        if (let none = rp) {
            return false
        }
        var rep = ElemRep.ptr()
        if (let some(r) = rp) {
            rep = r
        }
        var elemIrTy = elemIr(elem)
        var seqSlot = newSlot(em, IrTy.Ptr)
        var idxSlot = newSlot(em, IrTy.Int)
        var lenSlot = newSlot(em, IrTy.Int)
        instr(em, IrInstr.StoreSlot(seqSlot, seqT))
        var zero = temp(em)
        instr(em, IrInstr.Const(zero, IrConst.Int(0)))
        instr(em, IrInstr.StoreSlot(idxSlot, zero))
        var seqL = load(em, seqSlot)
        var lenT = externCallT1(em, "pickle_list_len", [IrTy.Ptr], IrTy.Int, [seqL])
        instr(em, IrInstr.StoreSlot(lenSlot, lenT))

        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var nextId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var curT = load(em, idxSlot)
        var endL = load(em, lenSlot)
        var cmp = temp(em)
        instr(em, IrInstr.BinOp(cmp, IrBinOp.Lt, curT, endL))
        term(em, IrTerm.BranchIf(cmp, bodyId, endId))
        em.cur = bodyId
        pushLoop(em, endId, nextId)
        pushScope(em)
        var curI = load(em, idxSlot)
        var seqL2 = load(em, seqSlot)
        var raw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [seqL2, curI])
        var v = raw
        if (!(rep.isPtr)) {
            v = externCallT1(em, rep.unboxSym, [IrTy.Ptr], elemIrTy, [raw])
        }
        var elemSlot = newSlot(em, elemIrTy)
        instr(em, IrInstr.StoreSlot(elemSlot, v))
        match (pattern) {
            case Pattern.Binding(nm, _) -> declare(em, nm, elemSlot)
            case Pattern.Tuple(_) -> {
                var ev = load(em, elemSlot)
                if (!(bindMatchValue(em, pattern, elem, ev, span))) {
                    popScope(em)
                    em.loops.pop()
                    return false
                }
            }
            case _ -> {
                popScope(em)
                em.loops.pop()
                return bad(em, span, "iteration patterns other than a binding or tuple are not lowered yet")
            }
        }
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(nextId))
        em.cur = nextId
        var c = load(em, idxSlot)
        var one = temp(em)
        instr(em, IrInstr.Const(one, IrConst.Int(1)))
        var nxt = temp(em)
        instr(em, IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        instr(em, IrInstr.StoreSlot(idxSlot, nxt))
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// `for ((k, v) in m)`: bind key and value per trip from lockstep
    /// `pickle_map_keys` / `pickle_map_values` snapshots, unboxing keys and
    /// values per their `ElemRep`. Mirrors `for_in_map_entries` in emit.rs.
fn forInMapEntries(em: Emitter, kname: string, vname: string, mapT: int, kty: Ty, vty: Ty, body: Block, span: Span) -> bool {
        var vrpo = elemRep(em, vty, span)
        if (let none = vrpo) {
            return false
        }
        var vrep = ElemRep.ptr()
        if (let some(r) = vrpo) {
            vrep = r
        }
        var vIr = elemIr(vty)
        var krpo = keyRep(em, kty, span)
        if (let none = krpo) {
            return false
        }
        var krep = ElemRep.ptr()
        if (let some(r) = krpo) {
            krep = r
        }
        var kIr = krep.ir
        if (krep.isPtr) {
            kIr = IrTy.Ptr
        }
        var mapSlot = newSlot(em, IrTy.Ptr)
        var keysSlot = newSlot(em, IrTy.Ptr)
        var valsSlot = newSlot(em, IrTy.Ptr)
        var idxSlot = newSlot(em, IrTy.Int)
        var lenSlot = newSlot(em, IrTy.Int)
        instr(em, IrInstr.StoreSlot(mapSlot, mapT))
        var mapL = load(em, mapSlot)
        var keysT = externCallT1(em, "pickle_map_keys", [IrTy.Ptr], IrTy.Ptr, [mapL])
        var valsT = externCallT1(em, "pickle_map_values", [IrTy.Ptr], IrTy.Ptr, [mapL])
        instr(em, IrInstr.StoreSlot(keysSlot, keysT))
        instr(em, IrInstr.StoreSlot(valsSlot, valsT))
        var zero = temp(em)
        instr(em, IrInstr.Const(zero, IrConst.Int(0)))
        instr(em, IrInstr.StoreSlot(idxSlot, zero))
        var keysL = load(em, keysSlot)
        var lenT = externCallT1(em, "pickle_list_len", [IrTy.Ptr], IrTy.Int, [keysL])
        instr(em, IrInstr.StoreSlot(lenSlot, lenT))

        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var nextId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var curT = load(em, idxSlot)
        var endL = load(em, lenSlot)
        var cmp = temp(em)
        instr(em, IrInstr.BinOp(cmp, IrBinOp.Lt, curT, endL))
        term(em, IrTerm.BranchIf(cmp, bodyId, endId))
        em.cur = bodyId
        pushLoop(em, endId, nextId)
        pushScope(em)
        var i = load(em, idxSlot)
        var keysL2 = load(em, keysSlot)
        var valsL2 = load(em, valsSlot)
        var kraw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [keysL2, i])
        var k = kraw
        if (!(krep.isPtr)) {
            k = externCallT1(em, krep.unboxSym, [IrTy.Ptr], kIr, [kraw])
        }
        var kSlot = newSlot(em, kIr)
        instr(em, IrInstr.StoreSlot(kSlot, k))
        declare(em, kname, kSlot)
        var vraw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [valsL2, i])
        var v = vraw
        if (!(vrep.isPtr)) {
            v = externCallT1(em, vrep.unboxSym, [IrTy.Ptr], vIr, [vraw])
        }
        var vSlot = newSlot(em, vIr)
        instr(em, IrInstr.StoreSlot(vSlot, v))
        declare(em, vname, vSlot)
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(nextId))
        em.cur = nextId
        var c = load(em, idxSlot)
        var one = temp(em)
        instr(em, IrInstr.Const(one, IrConst.Int(1)))
        var nxt = temp(em)
        instr(em, IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        instr(em, IrInstr.StoreSlot(idxSlot, nxt))
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// `for (x in s)` over a string: iterates byte indices, binding the raw
    /// 0..=255 byte from `pickle_str_get` as a `byte` (`int` ABI). Mirrors
    /// `for_in_string` in emit.rs.
fn forInString(em: Emitter, name: string, seqT: int, body: Block) -> bool {
        var seqSlot = newSlot(em, IrTy.Ptr)
        var idxSlot = newSlot(em, IrTy.Int)
        var lenSlot = newSlot(em, IrTy.Int)
        instr(em, IrInstr.StoreSlot(seqSlot, seqT))
        var zero = temp(em)
        instr(em, IrInstr.Const(zero, IrConst.Int(0)))
        instr(em, IrInstr.StoreSlot(idxSlot, zero))
        var seqL = load(em, seqSlot)
        var lenT = externCallT1(em, "pickle_str_len", [IrTy.Ptr], IrTy.Int, [seqL])
        instr(em, IrInstr.StoreSlot(lenSlot, lenT))

        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var nextId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var curT = load(em, idxSlot)
        var endL = load(em, lenSlot)
        var cmp = temp(em)
        instr(em, IrInstr.BinOp(cmp, IrBinOp.Lt, curT, endL))
        term(em, IrTerm.BranchIf(cmp, bodyId, endId))
        em.cur = bodyId
        pushLoop(em, endId, nextId)
        pushScope(em)
        var curI = load(em, idxSlot)
        var seqL2 = load(em, seqSlot)
        var v = externCallT1(em, "pickle_str_get", [IrTy.Ptr, IrTy.Int], IrTy.Int, [seqL2, curI])
        var elemSlot = newSlot(em, IrTy.Int)
        instr(em, IrInstr.StoreSlot(elemSlot, v))
        declare(em, name, elemSlot)
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(nextId))
        em.cur = nextId
        var c = load(em, idxSlot)
        var one = temp(em)
        instr(em, IrInstr.Const(one, IrConst.Int(1)))
        var nxt = temp(em)
        instr(em, IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        instr(em, IrInstr.StoreSlot(idxSlot, nxt))
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// `for (x in seq)` over an `Iterable<T>` protocol value: `iterator()` then
    /// `next()`, with `continue` re-testing the option and `break`/completion
    /// leaving the loop. Mirrors `for_in_protocol` in emit.rs.
fn forInProtocol(em: Emitter, pattern: Pattern, elem: Ty, seqT: int, body: Block, span: Span) -> bool {
        if (let none = elemRep(em, elem, span)) {
            return false
        }
        var iterableIft = Ty.Interface("Iterable", [elem])
        var itvO = interfaceZeroArgCall(em, span, iterableIft, seqT, "iterator", IrTy.Ptr)
        if (let none = itvO) {
            return false
        }
        var itv = -1
        if (let some(v) = itvO) {
            itv = v
        }
        var itSlot = newSlot(em, IrTy.Ptr)
        instr(em, IrInstr.StoreSlot(itSlot, itv))

        var iteratorIft = Ty.Interface("Iterator", [elem])
        var elemIrTy = elemIr(elem)
        var optSlot = newSlot(em, IrTy.Ptr)

        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var it = load(em, itSlot)
        var nextVO = interfaceZeroArgCall(em, span, iteratorIft, it, "next", IrTy.Ptr)
        if (let none = nextVO) {
            return false
        }
        var nextV = -1
        if (let some(v) = nextVO) {
            nextV = v
        }
        instr(em, IrInstr.StoreSlot(optSlot, nextV))
        var opt = load(em, optSlot)
        var presentO = optIsPresent(em, opt)
        if (let none = presentO) {
            return false
        }
        var present = -1
        if (let some(p) = presentO) {
            present = p
        }
        term(em, IrTerm.BranchIf(present, bodyId, endId))

        em.cur = bodyId
        pushLoop(em, endId, condId)
        pushScope(em)
        var raw = load(em, optSlot)
        var vO = optResolve(em, raw, elem, span)
        if (let none = vO) {
            popScope(em)
            em.loops.pop()
            return false
        }
        var v = -1
        if (let some(x) = vO) {
            v = x
        }
        var elemSlot = newSlot(em, elemIrTy)
        instr(em, IrInstr.StoreSlot(elemSlot, v))
        match (pattern) {
            case Pattern.Binding(nm, _) -> declare(em, nm, elemSlot)
            case Pattern.Tuple(_) -> {
                var ev = load(em, elemSlot)
                if (!(bindMatchValue(em, pattern, elem, ev, span))) {
                    popScope(em)
                    em.loops.pop()
                    return false
                }
            }
            case _ -> {
                popScope(em)
                em.loops.pop()
                return bad(em, span, "iteration patterns other than a binding or tuple are not lowered yet")
            }
        }
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// Emit a block's statements only (loop bodies, where the tail is
    /// discarded).
fn blockBodyOnly(em: Emitter, b: Block) -> bool {
        for (s in b.stmts) {
            if (!(stmt(em, s))) {
                return false
            }
        }
        if (let some(e) = b.expr) {
            if (let none = expr(em, e)) {
                return false
            }
        }
        true
    }

    /// `block_value`: lower a block and produce its value (the tail expression
    /// or a unit temp).
fn blockValue(em: Emitter, b: Block) -> int? {
        for (s in b.stmts) {
            if (!(stmt(em, s))) {
                return none
            }
        }
        if (let some(e) = b.expr) {
            return expr(em, e)
        }
        unitTemp(em)
    }

    /// A `try` is a statement, but the last one in a block is also that block's
    /// value, so it needs a slot to hand the result back in.
    ///
    /// Peek before emitting: on a miss the caller still has to emit the whole
    /// sequence itself, and emitting it twice would duplicate effects. Returns
    /// the slot holding the `try`'s value, having emitted everything.
fn stmtsWithTryTail(em: Emitter, stmts: List<Stmt>, want: IrTy) -> int? {
        if (len(stmts) == 0) {
            return none
        }
        let last = stmts[len(stmts) - 1]
        // Peek before emitting: on a miss the caller still has to emit the whole
        // sequence itself, and emitting it twice would duplicate effects.
        var isTry = false
        match (last) {
            case Stmt.Try(_, _, _, _, _) -> isTry = true
            case _ -> {}
        }
        if (!isTry) {
            return none
        }
        for (i in range(0, len(stmts) - 1)) {
            if (!(stmt(em, stmts[i]))) {
                return none
            }
        }
        let slot = newSlot(em, want)
        var slotOpt: int? = none
        slotOpt = slot
        var ok = false
        match (last) {
            case Stmt.Try(body, binder, handler, fin, span) -> ok = tryStmt(em, body, binder, handler, fin, span, slotOpt)
            case _ -> {}
        }
        if (!ok) {
            return none
        }
        slotOpt
    }

    /// Lower a block, optionally storing its tail into a result slot (used by
    /// `if`/`if let`/match arm values). The tail is lifted when the slot is a
    /// `Ptr` (option-typed result).
fn blockIntoSlot(em: Emitter, b: Block, resSlot: int?) -> bool {
        if (let some(slot) = resSlot) {
            var want = IrTy.Unit
            if (slot < len(em.fslots)) {
                want = em.fslots[slot]
            }
            if (let some(trySlot) = stmtsWithTryTail(em, b.stmts, want)) {
                let t = load(em, trySlot)
                instr(em, IrInstr.StoreSlot(slot, t))
                return true
            }
        } else {
            let noResTry = stmtsWithTryTail(em, b.stmts, IrTy.Unit)
            if (let some(_) = noResTry) {
                return true
            }
        }
        for (s in b.stmts) {
            if (!(stmt(em, s))) {
                return false
            }
        }
        if (let some(e) = b.expr) {
            var t = -1
            if (let some(tv) = expr(em, e)) {
                t = tv
            } else {
                return false
            }
            if (let some(slot) = resSlot) {
                var isPtrSlot = false
                if (slot < len(em.fslots)) {
                    if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                        isPtrSlot = true
                    }
                }
                if (isPtrSlot) {
                    var vt = Ty.Unknown
                    if (let some(gt) = tyOf(em, e.span)) {
                        vt = gt
                    }
                    var w = -1
                    if (let some(wv) = optionWrap(em, t, vt, e.span)) {
                        w = wv
                    } else {
                        return false
                    }
                    instr(em, IrInstr.StoreSlot(slot, w))
                } else {
                    instr(em, IrInstr.StoreSlot(slot, t))
                }
            }
        }
        true
    }

    /// After a block body, close the current block: run statements, then make
    /// the tail expression the return value (or discard it).
fn blockTailAsReturn(em: Emitter, b: Block) {
        let trySlot = stmtsWithTryTail(em, b.stmts, em.fret)
        if (let some(ts) = trySlot) {
            // `blockIntoSlot` already option-boxed a scalar tail into a `Ptr`
            // result slot, so the loaded value matches `fret` as-is.
            let t = load(em, ts)
            term(em, IrTerm.Return(t))
            return
        }
        for (s in b.stmts) {
            if (stmt(em, s)) {
                continue
            }
            return
        }
        if (let some(e) = b.expr) {
            if (!(irTyTag(em.fret) == irTyTag(IrTy.Unit))) {
                if (let some(t) = expr(em, e)) {
                    var tv = t
                    if (irTyTag(em.fret) == irTyTag(IrTy.Ptr)) {
                        var vt = Ty.Unknown
                        if (let some(gt) = tyOf(em, e.span)) {
                            vt = gt
                        }
                        if (let some(w) = optionWrap(em, tv, vt, e.span)) {
                            tv = w
                        }
                    }
                    term(em, IrTerm.Return(tv))
                }
            } else {
                let _ = expr(em, e)
                term(em, IrTerm.Return(none))
            }
        } else {
            if (irTyTag(em.fret) == irTyTag(IrTy.Unit)) {
                term(em, IrTerm.Return(none))
            }
        }
    }

    /// Ensure the final block is closed: only unit functions get the trailing
    /// empty `return`; dead value-returning blocks stay `Unreachable`.
fn tailCleanup(em: Emitter) -> bool {
        var dead = false
        match (em.blocks[em.cur].term) {
            case IrTerm.Unreachable -> dead = true
            case _ -> {}
        }
        if (dead && irTyTag(em.fret) == irTyTag(IrTy.Unit)) {
            em.blocks[em.cur].term = IrTerm.Return(none)
        }
        true
    }

    // ---- body builders (incremental port; filled in by later sub-slices) ----

    /// Build the hoisted body of a top-level `fn`/`test`. Mirrors `emit_body`.
fn emitBody(em: Emitter, body: FnBody?) -> bool {
        em.iceSeq = emptyStrs()
        if (let some(b) = body) {
            match (b) {
                case FnBody.Block(bb) -> {
                    pushScope(em)
                    blockTailAsReturn(em, bb)
                    popScope(em)
                }
                case FnBody.Expr(e) -> {
                    if (irTyTag(em.fret) == irTyTag(IrTy.Unit)) {
                        let _ = expr(em, e)
                    } else {
                        if (let some(t) = expr(em, e)) {
                            var tv = t
                            if (irTyTag(em.fret) == irTyTag(IrTy.Ptr)) {
                                var vt = Ty.Unknown
                                if (let some(gt) = tyOf(em, e.span)) {
                                    vt = gt
                                }
                                if (let some(w) = optionWrap(em, tv, vt, e.span)) {
                                    tv = w
                                }
                            }
                            term(em, IrTerm.Return(tv))
                        }
                    }
                }
            }
        }
        tailCleanup(em)
    }

    // ---- body builders (incremental port; filled in by later sub-slices) ----

    /// Build the hoisted body of a lambda. The closure object occupies slot 0
    /// (`env`), parameters come at slots 1..=n, then captures are copied out of
    /// the closure after every parameter.
fn buildLambdaBody(em: Emitter, lambda: Expr, captures: List<Capture>, pty: List<Ty>, ret: Ty, owner: int?, fid: int) {
        let _ = fid
        var params = emptyParams()
        var lb = FnBody.Expr(Expr(Span(0, 0), ExprKind.This))
        match (lambda.kind) {
            case ExprKind.Lambda(ps, _rt, _ia, b) -> {
                params = ps
                lb = b
            }
            case _ -> {
                bad(em, lambda.span, "lambda lost its body")
                return
            }
        }
        var ptys = pty
        if (len(ptys) == 0) {
            var known = false
            if (let some(t) = em.types.get(spanKey(lambda.span))) {
                match (t) {
                    case Ty.Fn(pts, _) -> {
                        ptys = pts
                        known = true
                    }
                    case _ -> {}
                }
            }
            if (!known) {
                bad(em, lambda.span, "lambda parameter types are not statically known")
                return
            }
        }
        if (let some(ir) = mapTy(em, ret, lambda.span)) {
            em.fret = ir
        }
        em.owner = owner

        // Slot 0 is the closure object; it must stay at fparam index 0 so the
        // JIT hands the closure to slot 0.
        var envIr = IrTy.Ptr
        var envSlot = newSlot(em, envIr)
        em.fparams.push(IrParam("env", envIr))
        declare(em, "env", envSlot)
        var envObj = load(em, envSlot)

        // The lambda's own parameters, typed from the checker's Fn signature,
        // occupy slots 1..=n matching their argument order.
        var i = 0
        while (i < len(params)) {
            var p = params[i]
            var t = Ty.Unknown
            if (i < len(ptys)) {
                t = ptys[i]
            }
            var ir = IrTy.Ptr
            if (let some(r) = mapTy(em, t, p.span)) {
                ir = r
            }
            var slot = newSlot(em, ir)
            em.fparams.push(IrParam(p.name, ir))
            declare(em, p.name, slot)
            i = i + 1
        }

        // Captured values go into fresh slots after every parameter; a capture
        // whose name a parameter shadows is skipped.
        var ci = 0
        while (ci < len(captures)) {
            var cap = captures[ci]
            var v = -1
            if (let some(fv) = fieldRead(em, cap.span, envObj, cap.ty, 1 + ci)) {
                v = fv
            } else {
                return
            }
            var ir = IrTy.Ptr
            if (let some(r) = mapTy(em, cap.ty, cap.span)) {
                ir = r
            }
            var slot = newSlot(em, ir)
            instr(em, IrInstr.StoreSlot(slot, v))
            var shadowed = len(em.env) == 0
            if (!shadowed) {
                for (p in params) {
                    if (p.name == cap.name) {
                        shadowed = true
                        break
                    }
                }
            }
            if (!shadowed) {
                declare(em, cap.name, slot)
            }
            ci = ci + 1
        }
        let _ = emitBody(em, lb)
    }

/// Build a spread trampoline: a dynamically-callable forwarder whose
    /// parameters are `(recv?, boxed)` Ã¢â‚¬â€ the receiver when present (slot 0),
    /// then the boxed `List` of the spread elements. The body loads the list,
    /// unboxes one element per target parameter (by that parameter's own
    /// element representation), and calls the target directly, returning its
    /// result. Mirrors `build_spread_trampoline` in emit.rs.
fn buildSpreadTrampoline(em: Emitter, span: Span, target: int, pty: List<Ty>, ret: Ty, receiver: bool) {
        var m = mapTy(em, ret, span)
        if (let some(r) = m) {
            em.fret = r
        }
        var recvSlot = 0
        if (receiver) {
            recvSlot = newSlot(em, IrTy.Ptr)
            em.fparams.push(IrParam("recv", IrTy.Ptr))
            declare(em, "recv", recvSlot)
        }
        var listSlot = newSlot(em, IrTy.Ptr)
        em.fparams.push(IrParam("boxed", IrTy.Ptr))
        declare(em, "boxed", listSlot)
        var list = load(em, listSlot)
        var real = emptyInts()
        var i = 0
        while (i < len(pty)) {
            var idx = intConst(em, i)
            var raw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [list, idx])
            var rep = elemRep(em, pty[i], span)
            if (let some(re) = rep) {
                if (re.isPtr) {
                    real.push(raw)
                } else {
                    var v = externCallT1(em, re.unboxSym, [IrTy.Ptr], re.ir, [raw])
                    real.push(v)
                }
            } else {
                return
            }
            i = i + 1
        }
        var args = emptyInts()
        if (receiver) {
            args.push(load(em, recvSlot))
        }
        for (r in real) {
            args.push(r)
        }
        if (irTyTag(em.fret) == irTyTag(IrTy.Unit)) {
            instr(em, IrInstr.Call(none, Callee.Func(target), args))
            term(em, IrTerm.Return(none))
        } else {
            var dst = temp(em)
            instr(em, IrInstr.Call(dst, Callee.Func(target), args))
            term(em, IrTerm.Return(dst))
        }
    }

    /// Build a function-value trampoline: `(env, args...) -> ret` calling the
    /// wrapped top-level function.
fn buildTrampoline(em: Emitter, span: Span, target: int, pty: List<Ty>, ret: Ty) {
        var m = mapTy(em, ret, span)
        if (let some(r) = m) {
            em.fret = r
        }
        var envSlot = newSlot(em, IrTy.Ptr)
        em.fparams.push(IrParam("env", IrTy.Ptr))
        declare(em, "env", envSlot)
        var args = emptyInts()
        for (t in pty) {
            var it = mapTy(em, t, span)
            var ir = IrTy.Ptr
            if (let some(r) = it) {
                ir = r
            }
            var slot = newSlot(em, ir)
            var pname = "arg" + str(len(em.fparams) - 1)
            em.fparams.push(IrParam(pname, ir))
            declare(em, pname, slot)
            args.push(load(em, slot))
        }
        if (irTyTag(em.fret) == irTyTag(IrTy.Unit)) {
            instr(em, IrInstr.Call(none, Callee.Func(target), args))
            term(em, IrTerm.Return(none))
        } else {
            var dst = temp(em)
            instr(em, IrInstr.Call(dst, Callee.Func(target), args))
            term(em, IrTerm.Return(dst))
        }
    }

    /// Build the hidden future body of an `async fn`: a 0-arg hoisted body whose
    /// closure slots 1..N hold each parameter under its own name. The body is
    /// then lowered exactly like a top-level function body, so `return`/`await`
    /// inside it work normally. Mirrors `build_async_body` in emit.rs.
fn buildAsyncBody(em: Emitter, f: FnDecl, pty: List<Ty>, ret: Ty) -> bool {
        var m = mapTy(em, ret, f.span)
        if (let some(r) = m) {
            em.fret = r
        }
        em.owner = none
        var envIr = IrTy.Ptr
        var envSlot = newSlot(em, envIr)
        em.fparams.push(IrParam("env", envIr))
        declare(em, "env", envSlot)
        var envObj = load(em, envSlot)
        var i = 0
        while (i < len(f.params)) {
            var p = f.params[i]
            var t = Ty.Unknown
            if (i < len(pty)) {
                t = pty[i]
            }
            var v = 0
            var fr = fieldRead(em, p.span, envObj, t, 1 + i)
            if (let none = fr) {
                return false
            }
            if (let some(x) = fr) {
                v = x
            }
            var ir = IrTy.Ptr
            var mt = mapTy(em, t, p.span)
            if (let some(r2) = mt) {
                ir = r2
            }
            var slot = newSlot(em, ir)
            instr(em, IrInstr.StoreSlot(slot, v))
            declare(em, p.name, slot)
            i = i + 1
        }
        emitBody(em, f.body)
        tailCleanup(em)
        true
    }

    /// Build the visible wrapper of an `async` method: it has the method's real
    /// ABI (`this` at slot 0 for instance methods, then the parameters, exactly
    /// like `buildMethodBody`) but returns the future Ã¢â‚¬â€ a closure over the
    /// receiver (if any) and the parameters Ã¢â‚¬â€ without running the body.
    /// Mirrors `build_async_method_wrapper` in emit.rs.
fn buildAsyncMethodWrapper(em: Emitter, md: MethodDecl, info: CallableInfo, hidden: int, isStatic: bool, thisTy: Ty?) -> bool {
        var d = 0
        var captures = emptyCaptures()
        if (!isStatic) {
            em.fslots.push(IrTy.Ptr)
            em.fparams.push(IrParam("this", IrTy.Ptr))
            declare(em, "this", 0)
            var ct = Ty.Unknown
            if (let some(t) = thisTy) {
                ct = t
            }
            captures.push(Capture("this", ct, md.span))
            d = 1
        }
        var i = 0
        while (i < len(info.params)) {
            var p = info.params[i]
            var ir = IrTy.Ptr
            if (let some(r) = mapTy(em, p.ty, p.span)) {
                ir = r
            }
            var slot = d + i
            em.fslots.push(ir)
            em.fparams.push(IrParam(p.name, ir))
            declare(em, p.name, slot)
            captures.push(Capture(p.name, p.ty, p.span))
            i = i + 1
        }
        em.fret = IrTy.Ptr
        if (let some(obj) = closureObj(em, Expr(md.span, ExprKind.Ident("")), hidden, captures)) {
            term(em, IrTerm.Return(obj))
        }
        true
    }

    /// Build the hidden future body of an `async` method. The closure slots hold
    /// the receiver (instance methods) then the parameters; the receiver is
    /// re-declared as `this` so the body's receiver-fallback operates exactly as
    /// in a regular method body. Mirrors `build_async_method_body` in emit.rs.
fn buildAsyncMethodBody(em: Emitter, md: MethodDecl, pty: List<Ty>, ret: Ty, isStatic: bool) -> bool {
        var m = mapTy(em, ret, md.span)
        if (let some(r) = m) {
            em.fret = r
        }
        var envIr = IrTy.Ptr
        var envSlot = newSlot(em, envIr)
        em.fparams.push(IrParam("env", envIr))
        declare(em, "env", envSlot)
        var envObj = load(em, envSlot)
        var base = 0
        if (!isStatic) {
            base = 1
        }
        if (!isStatic) {
            var t = Ty.Unknown
            if (len(pty) > 0) {
                t = pty[0]
            }
            var v = 0
            var fr = fieldRead(em, md.span, envObj, t, 1)
            if (let none = fr) {
                return false
            }
            if (let some(x) = fr) {
                v = x
            }
            var ir = IrTy.Ptr
            var mt = mapTy(em, t, md.span)
            if (let some(r2) = mt) {
                ir = r2
            }
            var slot = newSlot(em, ir)
            instr(em, IrInstr.StoreSlot(slot, v))
            declare(em, "this", slot)
        }
        var i = 0
        while (i < len(md.params)) {
            var p = md.params[i]
            var t = Ty.Unknown
            if (i + base < len(pty)) {
                t = pty[i + base]
            }
            var v = 0
            var fr = fieldRead(em, p.span, envObj, t, 1 + base + i)
            if (let none = fr) {
                return false
            }
            if (let some(x) = fr) {
                v = x
            }
            var ir = IrTy.Ptr
            var mt = mapTy(em, t, p.span)
            if (let some(r2) = mt) {
                ir = r2
            }
            var slot = newSlot(em, ir)
            instr(em, IrInstr.StoreSlot(slot, v))
            declare(em, p.name, slot)
            i = i + 1
        }
        emitBody(em, md.body)
        tailCleanup(em)
        true
    }

    /// Build a bound-method trampoline: a forwarder with the hoisted-lambda
    /// signature `(env, args...) -> ret` whose closure slot 1 holds the bound
    /// receiver. The body loads that receiver and calls the wrapped instance
    /// method `target` with it first, then returns the result; when `branches`
    /// is non-empty it dispatches on the runtime class first. Mirrors
    /// `build_method_trampoline` in emit.rs.
fn buildMethodTrampoline(em: Emitter, span: Span, target: int, pty: List<Ty>, ret: Ty, branches: List<DispatchBranch>) {
        var m = mapTy(em, ret, span)
        if (let some(r) = m) {
            em.fret = r
        }
        var envIr = IrTy.Ptr
        var envSlot = newSlot(em, envIr)
        em.fparams.push(IrParam("env", envIr))
        declare(em, "env", envSlot)
        var env = load(em, envSlot)
        var one = intConst(em, 1)
        var receiver = externCallT1(em, "pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [env, one])
        var real = emptyInts()
        var i = 0
        while (i < len(pty)) {
            var t = pty[i]
            var ir = IrTy.Ptr
            var mt = mapTy(em, t, span)
            if (let some(r) = mt) {
                ir = r
            }
            var slot = newSlot(em, ir)
            var pname = "arg" + str(i)
            em.fparams.push(IrParam(pname, ir))
            declare(em, pname, slot)
            real.push(load(em, slot))
            i = i + 1
        }
        if (len(branches) == 0) {
            var args = emptyInts()
            args.push(receiver)
            for (r in real) {
                args.push(r)
            }
            if (irTyTag(em.fret) == irTyTag(IrTy.Unit)) {
                instr(em, IrInstr.Call(none, Callee.Func(target), args))
                term(em, IrTerm.Return(none))
            } else {
                var dst = temp(em)
                instr(em, IrInstr.Call(dst, Callee.Func(target), args))
                term(em, IrTerm.Return(dst))
            }
            return
        }
        var anchor = Expr(span, ExprKind.Ident(""))
        var retSlot = newSlot(em, em.fret)
        var join = newBlock(em)
        for (b in branches) {
            var cb = newBlock(em)
            var next = newBlock(em)
            var dc = intConst(em, b.cid)
            var found = externCallT1(em, "pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [receiver, dc])
            term(em, IrTerm.BranchIf(found, cb, next))
            em.cur = cb
            var bargs = emptyInts()
            bargs.push(receiver)
            for (r in real) {
                bargs.push(r)
            }
            var val = emitCallTo(em, b.fid, bargs, anchor)
            instr(em, IrInstr.StoreSlot(retSlot, val))
            term(em, IrTerm.Branch(join))
            em.cur = next
        }
        var fargs = emptyInts()
        fargs.push(receiver)
        for (r in real) {
            fargs.push(r)
        }
        var fval = emitCallTo(em, target, fargs, anchor)
        instr(em, IrInstr.StoreSlot(retSlot, fval))
        term(em, IrTerm.Branch(join))
        em.cur = join
        var dst = temp(em)
        instr(em, IrInstr.LoadSlot(dst, retSlot))
        term(em, IrTerm.Return(dst))
    }

    /// The nearest explicit-primary-constructor ancestor of `name` (the
    /// deepest class in the chain that declares a primary `constructor`),
    /// together with the absolute end slot of that ancestor's own instance
    /// fields. Classes with only *named* constructors are still synthesized,
    /// so they never count as explicit here. Mirrors
    /// `nearest_explicit_primary_ancestor`.
fn nearestExplicitPrimaryAncestor(em: Emitter, name: string) -> AncestorMeta? {
        var found: AncestorMeta? = none
        var base = 0
        for (cname in ancestry(em, name)) {
            var own = ownInstanceFields(em, cname)
            var hasCtor = false
            if (let some(t) = tableOf(em, cname)) {
                if (let some(_) = t.ctor) {
                    hasCtor = true
                }
            }
            if (hasCtor) {
                found = AncestorMeta(cname, base + len(own))
            }
            base = base + len(own)
        }
        found
    }

    /// Total instance-field slot count of `name` including inherited fields.
    /// Mirrors `total_instance_slot_count`.
fn totalInstanceSlotCount(em: Emitter, name: string) -> int {
        var total = 0
        for (c in ancestry(em, name)) {
            total = total + len(ownInstanceFields(em, c))
        }
        total
    }

    /// Parameter metadata for a synthesized constructor of `name`, in
    /// parameter order: the absolute instance-field slot each parameter must
    /// be stored into (`-1` = a leading explicit-ancestor constructor
    /// parameter, forwarded to the chained `super(...)`), plus the nearest
    /// explicit-primary ancestor to chain into and how many leading
    /// parameters that chain consumes. With no explicit-primary ancestor the
    /// whole chain's uninitialized fields become the parameters (one per
    /// field slot) and nothing is chained. Mirrors
    /// `synthesized_ctor_param_meta`.
fn synthesizedCtorParamMeta(em: Emitter, name: string) -> CtorParamMeta {
        var cc = collectInstanceInits(em, name)
        var empty = emptyInts()
        for (si in cc) {
            empty.push(si.slot)
        }
        var slots = emptyInts()
        var cparamCount = 0
        var cutBase = 0
        var anc = nearestExplicitPrimaryAncestor(em, name)
        var hasAnc = false
        if (let some(a) = anc) {
            hasAnc = true
            if (let some(t) = tableOf(em, a.name)) {
                if (let some(c) = t.ctor) {
                    cparamCount = len(c.params)
                    var k = 0
                    while (k < cparamCount) {
                        slots.push(-1)
                        k = k + 1
                    }
                }
            }
            cutBase = a.endSlot
        }
        var base = 0
        for (cname in ancestry(em, name)) {
            var own = ownInstanceFields(em, cname)
            var contribute = false
            if (hasAnc) {
                if (base >= cutBase) {
                    contribute = true
                }
            } else {
                contribute = true
            }
            if (contribute) {
                var i = 0
                while (i < len(own)) {
                    var abs = base + i
                    var hasInit = false
                    for (e in empty) {
                        if (e == abs) {
                            hasInit = true
                            break
                        }
                    }
                    if (!hasInit) {
                        slots.push(abs)
                    }
                    i = i + 1
                }
            }
            base = base + len(own)
        }
        var chainName = ""
        var chainCount = 0
        if (let some(a2) = anc) {
            chainName = a2.name
            chainCount = cparamCount
        }
        CtorParamMeta(slots, chainName, chainCount)
    }

    /// Run a constructor `Block` whose tail expression is NOT the function's
    /// return value (used for constructor bodies and `init` blocks, where the
    /// constructor always returns `this`). Mirrors `emit_ctor_block`.
fn emitCtorBlock(em: Emitter, b: Block) -> bool {
        emitCtorBlockFrom(em, b, 0)
    }

    /// Run a constructor `Block` starting at statement `from`, skipping the
    /// leading statements (i.e. the consumed `super(...)` delegation).
    /// Mirrors `emit_ctor_block_from`.
fn emitCtorBlockFrom(em: Emitter, b: Block, fromIdx: int) -> bool {
        pushScope(em)
        var i = fromIdx
        while (i < len(b.stmts)) {
            if (!stmt(em, b.stmts[i])) {
                popScope(em)
                return false
            }
            i = i + 1
        }
        if (let some(e) = b.expr) {
            let _ = expr(em, e)
        }
        popScope(em)
        true
    }

    /// Lower a `super(...)` delegation at the front of a primary constructor
    /// body: evaluate the arguments in the current scope, then inline the
    /// parent's constructor chain. Mirrors `emit_super_chain`.
fn emitSuperChain(em: Emitter, ownerName: string, delegation: Expr) -> bool {
        var args = emptyCallArgs()
        var isCall = false
        match (delegation.kind) {
            case ExprKind.Call(_super, a) -> {
                args = a
                isCall = true
            }
            case _ -> {}
        }
        if (!isCall) {
            return bad(em, delegation.span, "`super(...)` delegation is malformed")
        }
        var parent = ""
        var hasParent = false
        if (let some(t) = tableOf(em, ownerName)) {
            if (let some(ext) = t.extends) {
                if (let some(p) = named(ext)) {
                    parent = p
                    hasParent = true
                }
            }
        }
        if (!hasParent) {
            return bad(em, delegation.span, "`super(...)` requires a superclass")
        }
        var pt: ClassTable? = tableOf(em, parent)
        if (let none = pt) {
            return bad(em, delegation.span, "`" + parent + "` is not a class")
        }
        var vals = emptyCtorArgVals()
        for (a in args) {
            if (a.spread) {
                return bad(em, a.span, "spread arguments are not lowered yet")
            }
            var vO = expr(em, a.value)
            if (let none = vO) {
                return false
            }
            var v = 0
            if (let some(x) = vO) {
                v = x
            }
            var ty = Ty.Unknown
            if (let some(t) = tyOf(em, a.value.span)) {
                ty = t
            }
            vals.push(CtorArgVal(v, ty, a.value.span))
        }
        var ptable = seedClassTable()
        if (let some(t) = pt) {
            ptable = t
        }
        emitCtorChain(em, parent, ptable, vals, delegation.span)
    }

    /// Lower the synthesized `super(...)` of a class with no explicit
    /// constructor that sits below an explicit-primary ancestor: forward the
    /// first `count` constructor parameters (already in the function's local
    /// slots) to the ancestor's inlined constructor chain. Mirrors
    /// `emit_synthesized_super_chain`.
fn emitSynthesizedSuperChain(em: Emitter, ancestor: string, count: int) -> bool {
        var at: ClassTable? = tableOf(em, ancestor)
        if (let none = at) {
            return true
        }
        var atable = seedClassTable()
        if (let some(t) = at) {
            atable = t
        }
        var cparams = emptyParamInfos()
        if (let some(c) = atable.ctor) {
            cparams = c.params
        }
        var vals = emptyCtorArgVals()
        var i = 0
        while (i < count && i < len(cparams)) {
            var p = cparams[i]
            var v = load(em, i)
            vals.push(CtorArgVal(v, p.ty, p.span))
            i = i + 1
        }
        emitCtorChain(em, ancestor, atable, vals, atable.span)
    }

    /// Run the constructor chain for class `cname`, whose constructor receives
    /// the already-evaluated `vals`. An explicit constructor has its
    /// parameters bound to the values (option-wrapped where the parameter is a
    /// pointer) and its body emitted, recursing on a leading `super(...)`. A
    /// synthesized constructor stores the values into its uninitialized
    /// instance-field slots. `this` stays live in the current scope because
    /// the chain is inlined into the leaf constructor. Field initializers and
    /// `init` blocks for the whole hierarchy are run by the leaf constructor,
    /// so they are not repeated here. Mirrors `emit_ctor_chain`.
fn emitCtorChain(em: Emitter, cname: string, ct: ClassTable, vals: List<CtorArgVal>, span: Span) -> bool {
        pushScope(em)
        var cd: ConstructorDecl? = none
        if (let some(decl) = em.classDecls.get(cname)) {
            for (m in decl.members) {
                match (m) {
                    case ClassMember.Constructor(c) -> {
                        if (let none = c.name) {
                            cd = c
                            break
                        }
                    }
                    case _ -> {}
                }
            }
        }
        var hasCtCtor = false
        if (let some(_) = ct.ctor) {
            hasCtCtor = true
        }
        if (hasCtCtor) {
            if (let none = cd) {
                popScope(em)
                return bad(em, span, "`" + cname + "` primary constructor is missing")
            }
            var ctorDecl = seedConstructorDecl()
            if (let some(x) = cd) {
                ctorDecl = x
            }
            var cparams = emptyParamInfos()
            if (let some(c) = ct.ctor) {
                cparams = c.params
            }
            if (!(len(cparams) == len(vals))) {
                popScope(em)
                return bad(em, span, "`super(...)` passes " + str(len(vals)) + " argument(s) but `" + cname + "` expects " + str(len(cparams)))
            }
            var w = 0
            while (w < len(cparams)) {
                var pr = cparams[w]
                var av = vals[w]
                var ir = IrTy.Ptr
                if (let some(r) = mapTy(em, pr.ty, pr.span)) {
                    ir = r
                }
                var slot = newSlot(em, ir)
                var stored = av.v
                if (irTyTag(ir) == irTyTag(IrTy.Ptr)) {
                    var wrapped = optionWrap(em, av.v, av.ty, av.span)
                    if (let none = wrapped) {
                        popScope(em)
                        return false
                    }
                    var wv = 0
                    if (let some(x) = wrapped) {
                        wv = x
                    }
                    stored = wv
                }
                instr(em, IrInstr.StoreSlot(slot, stored))
                declare(em, pr.name, slot)
                w = w + 1
            }
            var hasDel = false
            var del = ctorSuperDelegation(ctorDecl.body)
            if (let some(dg) = del) {
                hasDel = true
                if (!emitSuperChain(em, cname, dg)) {
                    popScope(em)
                    return false
                }
            }
            if (hasDel) {
                if (!emitCtorBlockFrom(em, ctorDecl.body, 1)) {
                    popScope(em)
                    return false
                }
            } else {
                if (!emitCtorBlock(em, ctorDecl.body)) {
                    popScope(em)
                    return false
                }
            }
        } else {
            var meta = synthesizedCtorParamMeta(em, cname)
            if (!(len(meta.slots) == len(vals))) {
                popScope(em)
                return bad(em, span, "`super(...)` passes " + str(len(vals)) + " argument(s) but `" + cname + "` expects " + str(len(meta.slots)))
            }
            var thisSlotO = lookup(em, "this")
            if (let none = thisSlotO) {
                popScope(em)
                return bad(em, span, "`this` is not available in the constructor chain")
            }
            var thisSlot = 0
            if (let some(s) = thisSlotO) {
                thisSlot = s
            }
            var thisObj = load(em, thisSlot)
            if (!(meta.chainName == "")) {
                var candVals = emptyCtorArgVals()
                var kk = 0
                while (kk < meta.chainCount && kk < len(vals)) {
                    candVals.push(vals[kk])
                    kk = kk + 1
                }
                if (let some(at2) = tableOf(em, meta.chainName)) {
                    emitCtorChain(em, meta.chainName, at2, candVals, span)
                }
            }
            var ifields = allInstanceFields(em, cname)
            var z = 0
            while (z < len(meta.slots)) {
                var slot2 = meta.slots[z]
                if (slot2 < 0) {
                    z = z + 1
                    continue
                }
                var av2 = vals[z]
                var f = ifields[slot2]
                var repO = elemRep(em, f.ty, f.span)
                if (let none = repO) {
                    popScope(em)
                    return false
                }
                var rep = ElemRep.ptr()
                if (let some(r) = repO) {
                    rep = r
                }
                var packedO = packForPointerBoundary(em, rep, av2.v, av2.ty, av2.span)
                if (let none = packedO) {
                    popScope(em)
                    return false
                }
                var packed = 0
                if (let some(p) = packedO) {
                    packed = p
                }
                var boxedO = boxForStore(em, rep, packed, elemIr(f.ty))
                if (let none = boxedO) {
                    popScope(em)
                    return false
                }
                var boxed = 0
                if (let some(b) = boxedO) {
                    boxed = b
                }
                fieldStore(em, thisObj, slot2, f.ty, boxed)
                z = z + 1
            }
        }
        popScope(em)
        true
    }

    /// Build an explicit/implicit constructor. Mirrors `build_ctor_body`.
fn buildCtorBody(em: Emitter, table: ClassTable, inits: List<SlotInit>, initBlocks: List<Block>, ctor: ConstructorDecl?) -> bool {
        var ifields = allInstanceFields(em, table.name)
        var params = emptyCtorParams()
        var meta = synthesizedCtorParamMeta(em, table.name)
        var hasCtor = false
        if (let some(_) = table.ctor) {
            hasCtor = true
        }
        if (hasCtor) {
            var ctorParams = emptyParamInfos()
            if (let some(c) = table.ctor) {
                ctorParams = c.params
            }
            for (p in ctorParams) {
                params.push(CtorParam(p.name, p.ty, p.span, -1))
            }
        } else {
            var anc = nearestExplicitPrimaryAncestor(em, table.name)
            if (let some(a) = anc) {
                if (let some(t) = tableOf(em, a.name)) {
                    if (let some(c2) = t.ctor) {
                        for (p in c2.params) {
                            params.push(CtorParam(p.name, p.ty, p.span, -1))
                        }
                    }
                }
            }
            for (slot in meta.slots) {
                if (slot < 0) {
                    continue
                }
                var f = ifields[slot]
                params.push(CtorParam(f.name, f.ty, f.span, slot))
            }
        }
        var i = 0
        while (i < len(params)) {
            var pm = params[i]
            var ir = IrTy.Ptr
            if (let some(r) = mapTy(em, pm.ty, table.span)) {
                ir = r
            }
            em.fslots.push(ir)
            em.fparams.push(IrParam(pm.name, ir))
            declare(em, pm.name, i)
            i = i + 1
        }
        em.fret = IrTy.Ptr

        var cid = PICKLE_CLASS_USER_BASE
        if (let some(o) = em.owner) {
            cid = o
        }
        var thisSlot = newSlot(em, IrTy.Ptr)
        declare(em, "this", thisSlot)

        var cidT = intConst(em, cid)
        var nT = intConst(em, len(ifields))
        var created = externCallT1(em, "pickle_class_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [cidT, nT])
        instr(em, IrInstr.StoreSlot(thisSlot, created))

        var thisObj = load(em, thisSlot)

        for (si in inits) {
            var slot = si.slot
            var f = ifields[slot]
            var ty = f.ty
            var manual = f.manual
            var vO = expr(em, si.init)
            if (let none = vO) {
                return false
            }
            var v = 0
            if (let some(x) = vO) {
                v = x
            }
            if (manual) {
                v = externCallT1(em, "pickle_manual_adopt", [IrTy.Ptr], IrTy.Ptr, [v])
            }
            var repO = elemRep(em, ty, table.span)
            if (let none = repO) {
                return false
            }
            var rep = ElemRep.ptr()
            if (let some(r) = repO) {
                rep = r
            }
            var vt = Ty.Unknown
            if (let some(t) = tyOf(em, si.init.span)) {
                vt = t
            }
            var packedO = packForPointerBoundary(em, rep, v, vt, si.init.span)
            if (let none = packedO) {
                return false
            }
            var packed = 0
            if (let some(p) = packedO) {
                packed = p
            }
            var boxedO = boxForStore(em, rep, packed, elemIr(ty))
            if (let none = boxedO) {
                return false
            }
            var boxed = 0
            if (let some(b) = boxedO) {
                boxed = b
            }
            fieldStore(em, thisObj, slot, ty, boxed)
        }

        var j = 0
        while (j < len(params)) {
            var pm2 = params[j]
            if (pm2.fieldSlot >= 0) {
                var v2 = load(em, j)
                var rep2O = elemRep(em, pm2.ty, pm2.span)
                if (let none = rep2O) {
                    return false
                }
                var rep2 = ElemRep.ptr()
                if (let some(r) = rep2O) {
                    rep2 = r
                }
                var packed2O = packForPointerBoundary(em, rep2, v2, pm2.ty, pm2.span)
                if (let none = packed2O) {
                    return false
                }
                var packed2 = 0
                if (let some(p) = packed2O) {
                    packed2 = p
                }
                var boxed2O = boxForStore(em, rep2, packed2, elemIr(pm2.ty))
                if (let none = boxed2O) {
                    return false
                }
                var boxed2 = 0
                if (let some(b) = boxed2O) {
                    boxed2 = b
                }
                fieldStore(em, thisObj, pm2.fieldSlot, pm2.ty, boxed2)
            }
            j = j + 1
        }

        if (let some(cd) = ctor) {
            var del = ctorSuperDelegation(cd.body)
            if (let some(dg) = del) {
                if (!emitSuperChain(em, table.name, dg)) {
                    return false
                }
                if (!emitCtorBlockFrom(em, cd.body, 1)) {
                    return false
                }
            } else {
                if (!emitCtorBlock(em, cd.body)) {
                    return false
                }
            }
        }
        if (let none = ctor) {
            if (!(meta.chainName == "")) {
                if (!emitSynthesizedSuperChain(em, meta.chainName, meta.chainCount)) {
                    return false
                }
            }
        }
        for (b in initBlocks) {
            if (!emitCtorBlock(em, b)) {
                return false
            }
        }

        var done = load(em, thisSlot)
        term(em, IrTerm.Return(done))
        tailCleanup(em)
        true
    }

    /// Build a named constructor: a static factory that evaluates the
    /// delegation arguments and calls the primary constructor. Mirrors
    /// `build_named_ctor`.
fn buildNamedCtor(em: Emitter, table: ClassTable, cd: ConstructorDecl) -> bool {
        var info: CtorInfo? = none
        if (let some(n) = cd.name) {
            for (nc in table.namedCtors) {
                if (nc.name == n) {
                    info = nc.ctor
                    break
                }
            }
        }
        var params = emptyParamInfos()
        if (let some(c) = info) {
            params = c.params
        }
        var i = 0
        while (i < len(params)) {
            var p = params[i]
            var ir = IrTy.Ptr
            if (let some(r) = mapTy(em, p.ty, p.span)) {
                ir = r
            }
            em.fslots.push(ir)
            em.fparams.push(IrParam(p.name, ir))
            declare(em, p.name, i)
            i = i + 1
        }
        em.fret = IrTy.Ptr

        var dg: Expr? = namedCtorDelegation(cd.body)
        if (let none = dg) {
            return bad(em, cd.span, "named constructor body must be a single `this(...)` delegation to the primary constructor")
        }
        var delegation = Expr(Span(0, 0), ExprKind.Ident("x"))
        if (let some(d2) = dg) {
            delegation = d2
        }
        var args = emptyCallArgs()
        var isCall = false
        match (delegation.kind) {
            case ExprKind.Call(_callee, a) -> {
                args = a
                isCall = true
            }
            case _ -> {}
        }
        if (!isCall) {
            return bad(em, cd.span, "named constructor delegation is malformed")
        }

        var cid = PICKLE_CLASS_USER_BASE
        if (let some(c2) = em.classByName.get(table.name)) {
            cid = c2
        }
        var primaryOpt: int? = em.ctorIds.get(cid)
        if (let none = primaryOpt) {
            return bad(em, cd.span, "`" + table.name + "` has no constructor")
        }
        var primary = 0
        if (let some(p2) = primaryOpt) {
            primary = p2
        }
        var fparams = em.irModule.funcs[primary].params
        var argTemps = emptyInts()
        var ai = 0
        while (ai < len(args)) {
            var a = args[ai]
            if (a.spread) {
                return bad(em, a.span, "spread arguments are not lowered yet")
            }
            var tO = expr(em, a.value)
            if (let none = tO) {
                return false
            }
            var t = 0
            if (let some(x) = tO) {
                t = x
            }
            var isPtr = false
            if (ai < len(fparams)) {
                if (irTyTag(fparams[ai].ty) == irTyTag(IrTy.Ptr)) {
                    isPtr = true
                }
            }
            if (isPtr) {
                var vt = Ty.Unknown
                if (let some(gt) = tyOf(em, a.value.span)) {
                    vt = gt
                }
                var wrapped = optionWrap(em, t, vt, a.value.span)
                if (let none = wrapped) {
                    return false
                }
                var wv = 0
                if (let some(x) = wrapped) {
                    wv = x
                }
                t = wv
            }
            argTemps.push(t)
            ai = ai + 1
        }
        var dst = temp(em)
        instr(em, IrInstr.Call(dst, Callee.Func(primary), argTemps))
        term(em, IrTerm.Return(dst))
        true
    }

    /// Lower a `deinit` finalizer: slot 0 is `this`, the body runs with `this`
    /// live, and the function returns unit. Deinit runs off the allocation path
    /// during GC sweep. Mirrors `build_deinit_body`.
fn buildDeinitBody(em: Emitter, table: ClassTable, body: Block) -> bool {
        let _ = table
        em.fslots.push(IrTy.Ptr)
        em.fparams.push(IrParam("this", IrTy.Ptr))
        declare(em, "this", 0)
        em.fret = IrTy.Unit
        if (!emitCtorBlock(em, body)) {
            return false
        }
        tailCleanup(em)
        true
    }

    /// Lower a method: slot 0 is `this` (instance methods), followed by the
    /// declared parameters. Mirrors `build_method_body`.
fn buildMethodBody(em: Emitter, table: ClassTable, md: MethodDecl, info: CallableInfo) -> bool {
        let _ = table
        var d = 0
        if (!info.isStatic) {
            em.fslots.push(IrTy.Ptr)
            em.fparams.push(IrParam("this", IrTy.Ptr))
            declare(em, "this", 0)
            d = 1
        }
        var i = 0
        while (i < len(info.params)) {
            var p = info.params[i]
            var ir = IrTy.Ptr
            if (let some(r) = mapTy(em, p.ty, p.span)) {
                ir = r
            }
            var slot = d + i
            em.fslots.push(ir)
            em.fparams.push(IrParam(p.name, ir))
            declare(em, p.name, slot)
            i = i + 1
        }
        var mret = mapTy(em, info.ret, md.span)
        if (let some(r) = mret) {
            em.fret = r
        } else {
            em.fret = IrTy.Unit
        }
emitBody(em, md.body)
        tailCleanup(em)
        true
    }

    /// Lower a property accessor. The getter returns the property value; the
    /// setter takes `value` in the slot after `this` (if any), runs the
    /// accessor body, and returns unit. Mirrors `build_property_body`.
fn buildPropertyBody(em: Emitter, table: ClassTable, pd: PropertyDecl, info: PropertyInfo, isSet: bool, isStatic: bool) -> bool {
        let _ = table
        var d = 0
        if (!isStatic) {
            em.fslots.push(IrTy.Ptr)
            em.fparams.push(IrParam("this", IrTy.Ptr))
            declare(em, "this", 0)
            d = 1
        }
        if (isSet) {
            var ir = IrTy.Ptr
            if (let some(r) = mapTy(em, info.ty, pd.span)) {
                ir = r
            }
            em.fslots.push(ir)
            em.fparams.push(IrParam("value", ir))
            declare(em, "value", d)
            em.fret = IrTy.Unit
        } else {
            var gret = mapTy(em, info.ty, pd.span)
            if (let some(r) = gret) {
                em.fret = r
            } else {
                em.fret = IrTy.Ptr
            }
        }
        var accessor: PropertyAccessor? = none
        if (isSet) {
            accessor = pd.set
        } else {
            accessor = pd.get
        }
        if (let some(a) = accessor) {
            match (a) {
                case PropertyAccessor.Expr(e) -> {
                    if (irTyIsUnit(em.fret)) {
                        let _ = expr(em, e)
                        term(em, IrTerm.Return(none))
                    } else {
                        if (let some(t) = expr(em, e)) {
                            term(em, IrTerm.Return(t))
                        }
                    }
                }
                case PropertyAccessor.Block(b) -> {
                    emitBody(em, FnBody.Block(b))
                }
            }
        }
        tailCleanup(em)
        true
    }

    /// The synthesized static-field initializer function: default-initialize
    /// every cell, then run the non-`none` initializers in order.
fn buildStaticInit(em: Emitter, inits: List<StaticInitEntry>) {
        em.fret = IrTy.Unit
        for (e in inits) {
            buildStaticDefault(em, e.cid, e.slot)
            if (em.failed) {
                return
            }
        }
        for (e in inits) {
            if (let some(x) = e.value) {
                em.owner = e.cid
                buildStaticInitOne(em, e.cid, e.slot, x)
                if (em.failed) {
                    return
                }
            }
        }
        term(em, IrTerm.Return(none))
    }

    /// Root every managed top-level slot, then run the initializers.
    /// Mirrors `build_globals_init` in emit.rs.
    ///
    /// Every root is registered before any initializer runs, because an
    /// initializer is the first code that can allocate and therefore the first
    /// point at which the collector could run.
fn buildGlobalsInit(em: Emitter, inits: List<ManagedGlobalInit>) {
        em.fret = IrTy.Unit
        var rootAddId = externId(em, "pickle_gc_root_add", [IrTy.Int], IrTy.Int)
        for (init in inits) {
            var slotAddress = temp(em)
            instr(em, IrInstr.GlobalAddr(slotAddress, init.gid))
            instr(em, IrInstr.Call(none, Callee.Extern(rootAddId), [slotAddress]))
        }
        for (init in inits) {
            if (let some(value) = expr(em, init.value)) {
                instr(em, IrInstr.StoreGlobal(init.gid, value, init.ty))
            } else {
                if (em.failed) {
                    return
                }
            }
        }
        term(em, IrTerm.Return(none))
    }

    /// Store the default (zero scalar / null pointer) into one static cell.
    /// Mirrors `build_static_default` in emit.rs.
fn buildStaticDefault(em: Emitter, cid: int, slot: int) {
        if (let some(info) = staticFieldAt(em, cid, slot)) {
            var fieldTy = info.ty
            if (let some(rep) = elemRep(em, fieldTy, info.span)) {
                var def = 0
                if (rep.isPtr) {
                    if (let some(n) = nullTemp(em)) {
                        def = n
                    }
                } else {
                    if (let some(z) = zeroScalar(em, elemIr(fieldTy), info.span)) {
                        def = z
                    }
                }
                if (let some(b) = boxForStore(em, rep, def, elemIr(fieldTy))) {
                    staticStore(em, cid, slot, b)
                }
            }
        }
    }

    /// Evaluate one static-field initializer and store it. Mirrors
    /// `build_static_init_one` in emit.rs.
fn buildStaticInitOne(em: Emitter, cid: int, slot: int, x: Expr) {
        if (let some(info) = staticFieldAt(em, cid, slot)) {
            var fieldTy = info.ty
            var vO = expr(em, x)
            if (let some(v) = vO) {
                var vt = Ty.Unknown
                if (let some(t) = tyOf(em, x.span)) {
                    vt = t
                }
                let _ = staticAssign(em, x.span, AssignOp.Assign, cid, slot, fieldTy, v, vt)
            }
        }
    }

    /// Register every user class descriptor at the top of `main`'s entry block.
    /// Each is a `pickle_class_register(name_ptr, name_len, slot_count, mask,
    /// owned_mask, finalizer, parent)` void call; the returned id is discarded
    /// (call sites hardcode it, exactly like the runtime's allocation order).
    /// Interface buckets get `pickle_class_add_interface` plus one
    /// `pickle_class_add_iface_method` per dispatch method. Mirrors
    /// `inject_class_registrations`.
fn injectClassRegistrations(em: Emitter) {
        if (len(em.classes) == 0 && isNoneInt(em.staticInitId) && isNoneInt(em.globalsInitId) && len(em.extraSetups) == 0) {
            return
        }
        var plans = emptyRegPlans()
        for (p in em.classes) {
            var fields = allInstanceFields(em, p.name)
            var owned = 0
            var fi = 0
            while (fi < len(fields)) {
                if (fields[fi].manual && fi < 64) {
                    owned = owned | (1 << fi)
                }
                fi = fi + 1
            }
            var parentCid = 0
            if (let some(pv) = p.parent) {
                parentCid = pv
            }
            plans.push(RegPlan(p.name, totalInstanceSlotCount(em, p.name), p.classId, parentCid, owned))
        }
        var instrs = emptyIrInstrs()
        for (rp in plans) {
            var sid = internString(em, rp.name)
            var addr = temp(em)
            instrs.push(IrInstr.Const(addr, IrConst.StrAddr(sid)))
            var addrLen = temp(em)
            instrs.push(IrInstr.Const(addrLen, IrConst.Int(len(bytesOf(rp.name)))))
            var countT = temp(em)
            instrs.push(IrInstr.Const(countT, IrConst.Int(rp.fieldCount)))
            var maskT = temp(em)
            var m = -1
            if (rp.fieldCount < 64) {
                m = (1 << rp.fieldCount) - 1
            }
            instrs.push(IrInstr.Const(maskT, IrConst.Int(m)))
            var ownedT = temp(em)
            instrs.push(IrInstr.Const(ownedT, IrConst.Int(rp.owned)))
            var finT = temp(em)
            var deinitO = em.deinitIds.get(rp.cid)
            if (let some(fid2) = deinitO) {
                instrs.push(IrInstr.Const(finT, IrConst.FuncAddr(fid2)))
            } else {
                instrs.push(IrInstr.Const(finT, IrConst.Int(0)))
            }
            var parT = temp(em)
            instrs.push(IrInstr.Const(parT, IrConst.Int(rp.parent)))
            var ex = externId(em, "pickle_class_register", [IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int], IrTy.Unit)
            instrs.push(IrInstr.Call(none, Callee.Extern(ex), [addr, addrLen, countT, maskT, ownedT, finT, parT]))
            var buckets = emptyIfaceBuckets()
            if (let some(b) = em.classIfaceBuckets.get(rp.cid)) {
                buckets = b
            }
            for (bk in buckets) {
                var cidT = temp(em)
                instrs.push(IrInstr.Const(cidT, IrConst.Int(rp.cid)))
                var iidT = temp(em)
                instrs.push(IrInstr.Const(iidT, IrConst.Int(bk.ifaceId)))
                var exMark = externId(em, "pickle_class_add_interface", [IrTy.Int, IrTy.Int], IrTy.Unit)
                instrs.push(IrInstr.Call(none, Callee.Extern(exMark), [cidT, iidT]))
                for (db in bk.methods) {
                    var idxT = temp(em)
                    instrs.push(IrInstr.Const(idxT, IrConst.Int(db.cid)))
                    var fnT = temp(em)
                    instrs.push(IrInstr.Const(fnT, IrConst.FuncAddr(db.fid)))
                    var exM = externId(em, "pickle_class_add_iface_method", [IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int], IrTy.Unit)
                    instrs.push(IrInstr.Call(none, Callee.Extern(exM), [cidT, iidT, idxT, fnT]))
                }
            }
        }
        // Managed global roots are registered before `pkl_static_init` so a
        // static initializer can never observe an unrooted slot. It runs after
        // class registration because a `Ptr` initializer may call a constructor,
        // which reads the descriptor that registration creates.
        if (let some(fid4) = em.globalsInitId) {
            instrs.push(IrInstr.Call(none, Callee.Func(fid4), emptyInts()))
        }
        // Peer objects' setup functions (split link): their classes are
        // registered and their globals rooted before this object's static
        // initializers run, because a static initializer may call into a peer.
        for (s in em.extraSetups) {
            var exU = externId(em, s, emptyIrTys(), IrTy.Unit)
            instrs.push(IrInstr.Call(none, Callee.Extern(exU), emptyInts()))
        }
        if (let some(fid3) = em.staticInitId) {
            instrs.push(IrInstr.Call(none, Callee.Func(fid3), emptyInts()))
        }
        var ni = emptyIrInstrs()
        for (x in instrs) {
            ni.push(x)
        }
        for (o in em.blocks[0].instrs) {
            ni.push(o)
        }
        em.blocks[0].instrs = ni
    }
