                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_read_file", [IrTy.Str], IrTy.Ptr, [p])
            }
            case "write_file" -> {
                if (!(len(args) == 2)) {
                    bad(em, e.span, "`write_file(path, text)` takes exactly two arguments")
                    return none
                }
                var badNamed = false
                for (a in args) {
                    var named = false
                    if (let some(_) = a.name) {
                        named = true
                    }
                    if (named || a.spread) {
                        badNamed = true
                    }
                }
                if (badNamed) {
                    bad(em, e.span, "`write_file(path, text)` takes exactly two arguments")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                var t = -1
                if (let some(tv) = expr(em, args[1].value)) {
                    t = tv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_write_file", [IrTy.Str, IrTy.Str], IrTy.Bool, [p, t])
            }
            case "file_exists" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`file_exists(path)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`file_exists(path)` takes exactly one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_file_exists", [IrTy.Str], IrTy.Bool, [p])
            }
            case "delete" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`delete(path)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`delete(path)` takes exactly one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_delete", [IrTy.Str], IrTy.Bool, [p])
            }
            case "mkdir" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`mkdir(path)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`mkdir(path)` takes exactly one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_mkdir", [IrTy.Str], IrTy.Bool, [p])
            }
            case "list_dir" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`list_dir(path)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`list_dir(path)` takes exactly one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                return externCallT1(em, "pickle_list_dir", [IrTy.Str], IrTy.Ptr, [p])
            }
            case "stream_open_read" | "stream_open_write" | "stream_open_append" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`" + name + "(path)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`" + name + "(path)` takes exactly one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                var sym = "pickle_stream_open_append"
                if (name == "stream_open_read") {
                    sym = "pickle_stream_open_read"
                } else if (name == "stream_open_write") {
                    sym = "pickle_stream_open_write"
                }
                return externCallT1(em, sym, [IrTy.Str], IrTy.Ptr, [p])
            }
case "stdout_stream" | "stderr_stream" -> {
                if (!(len(args) == 0)) {
                    bad(em, e.span, "`" + name + "()` takes no arguments")
                    return none
                }
                var sym = "pickle_stderr_stream"
                if (name == "stdout_stream") {
                    sym = "pickle_stdout_stream"
                }
                return externCallT1(em, sym, emptyIrTys(), IrTy.Ptr, emptyInts())
            }
            case "args" -> {
                if (!(len(args) == 0)) {
                    bad(em, e.span, "`args()` takes no arguments")
                    return none
                }
                // Returns a `List<string>` of the program's command-line
                // arguments, excluding the program name.
                return externCallT1(em, "pickle_args", emptyIrTys(), IrTy.Ptr, emptyInts())
            }
            case "exit" -> {
                if (len(args) != 1) {
                    bad(em, e.span, "`exit(code)` takes exactly one argument")
                    return none
                }
                var named = false
                if (let some(_) = args[0].name) {
                    named = true
                }
                if (named || args[0].spread) {
                    bad(em, e.span, "`exit(code)` takes exactly one argument")
                    return none
                }
                if (let some(codeSlot) = expr(em, args[0].value)) {
                    externCallVoid(em, "pickle_exit", [IrTy.Int], [codeSlot])
                    return unitTemp(em)
                } else {
                    return none
                }
            }
            case "run_cmd" -> {
                var special = false
                for (a in args) {
                    if (let some(_) = a.name) {
                        special = true
                    }
                    if (a.spread) {
                        special = true
                    }
                }
                if (len(args) != 8 || special) {
                    bad(em, e.span, "`run_cmd(argv, cwd, envs, env_removes, stdin_bytes, max_out, timeout_ms, inherit_io)` takes exactly eight arguments")
                    return none
                }
                var temps = emptyInts()
                for (a in args) {
                    if (let some(t) = expr(em, a.value)) {
                        var tt = t
                        if (let some(ty) = tyOf(em, a.value.span)) {
                            match (ty) {
                                case Ty.Int -> { tt = externCallT1(em, "pickle_box_i64", [IrTy.Int], IrTy.Ptr, [tt]) }
                                case _ -> {}
                            }
                        }
                        temps.push(tt)
                    } else {
                        return none
                    }
                }
                return externCallT1(em, "pickle_run_cmd", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Bool], IrTy.Ptr, temps)
            }
            case "run_spawn" -> {
                var special = false
                for (a in args) {
                    if (let some(_) = a.name) {
                        special = true
                    }
                    if (a.spread) {
                        special = true
                    }
                }
                if (len(args) != 5 || special) {
                    bad(em, e.span, "`run_spawn(argv, cwd, envs, env_removes, max_out)` takes exactly five arguments")
                    return none
                }
                var temps = emptyInts()
                for (a in args) {
                    if (let some(t) = expr(em, a.value)) {
                        var tt = t
                        if (let some(ty) = tyOf(em, a.value.span)) {
                            match (ty) {
                                case Ty.Int -> { tt = externCallT1(em, "pickle_box_i64", [IrTy.Int], IrTy.Ptr, [tt]) }
                                case _ -> {}
                            }
                        }
                        temps.push(tt)
                    } else {
                        return none
                    }
                }
                return externCallT1(em, "pickle_run_spawn", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, temps)
            }
            case "proc_wait" | "proc_running" | "proc_code" | "proc_kill" | "proc_in_close" -> {
                var hNamed = false
                if (let some(_) = args[0].name) {
                    hNamed = true
                }
                if (len(args) != 1 || hNamed || args[0].spread) {
                    bad(em, e.span, "`" + name + "(handle)` takes exactly one argument")
                    return none
                }
                if (let some(h) = expr(em, args[0].value)) {
                    var sym = "pickle_proc_code"
                    if (name == "proc_wait") {
                        sym = "pickle_proc_wait"
                    } else if (name == "proc_running") {
                        sym = "pickle_proc_running"
                    } else if (name == "proc_kill") {
                        sym = "pickle_proc_kill"
                    } else if (name == "proc_in_close") {
                        sym = "pickle_proc_in_close"
                    }
                    var ret = IrTy.Bool
                    if (name == "proc_code") {
                        ret = IrTy.Ptr
                    }
                    return externCallT1(em, sym, [IrTy.Ptr], ret, [h])
                } else {
                    return none
                }
            }
            case "proc_out_read" | "proc_err_read" -> {
                var special = false
                for (a in args) {
                    if (let some(_) = a.name) {
                        special = true
                    }
                    if (a.spread) {
                        special = true
                    }
                }
                if (len(args) != 2 || special) {
                    bad(em, e.span, "`" + name + "(handle, n)` takes exactly two arguments")
                    return none
                }
                if (let some(h) = expr(em, args[0].value)) {
                    if (let some(n) = expr(em, args[1].value)) {
                        var sym = "pickle_proc_err_read"
                        if (name == "proc_out_read") {
                            sym = "pickle_proc_out_read"
                        }
                        return externCallT1(em, sym, [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [h, n])
                    } else {
                        return none
                    }
                } else {
                    return none
                }
            }
            case "proc_in_write" -> {
                var special = false
                for (a in args) {
                    if (let some(_) = a.name) {
                        special = true
                    }
                    if (a.spread) {
                        special = true
                    }
                }
                if (len(args) != 2 || special) {
                    bad(em, e.span, "`proc_in_write(handle, b)` takes exactly two arguments")
                    return none
                }
                if (let some(h) = expr(em, args[0].value)) {
                    if (let some(b) = expr(em, args[1].value)) {
                        return externCallT1(em, "pickle_proc_in_write", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [h, b])
                    } else {
                        return none
                    }
                } else {
                    return none
                }
            }
            case "current_dir" -> {
                if (!(len(args) == 0)) {
                    bad(em, e.span, "`current_dir()` takes no arguments")
                    return none
                }
                return externCallT1(em, "pickle_current_dir", emptyIrTys(), IrTy.Ptr, emptyInts())
            }
            case "captureBegin" -> {
                if (!(len(args) == 0)) {
                    bad(em, e.span, "`captureBegin()` takes no arguments")
                    return none
                }
                externCallVoid(em, "pickle_test_capture_begin", emptyIrTys(), emptyInts())
                return unitTemp(em)
            }
            case "captureTake" -> {
                if (!(len(args) == 0)) {
                    bad(em, e.span, "`captureTake()` takes no arguments")
                    return none
                }
                // Returns the captured failure message as a `string` object, or
                // `null` (`none`) when there is none.
                return externCallT1(em, "pickle_test_capture_take", emptyIrTys(), IrTy.Ptr, emptyInts())
            }
            case _ -> {
                if (let some(fb) = flatBuiltin(name)) {
                    match (fb) {
                        case (sym, params, returns, ret, pnames) -> {
                            if (let some(ts) = positionalArgs(em, e, name, args, pnames)) {
                                if (returns) {
                                    return externCallT1(em, sym, params, ret, ts)
                                } else {
                                    externCallVoid(em, sym, params, ts)
                                    return unitTemp(em)
                                }
                            } else {
                                return none
                            }
                        }
                        case _ -> { return none }
                    }
                }
                if (genericUserFn(em, name)) {
                    bad(em, e.span, "calls to the generic function `" + name + "` must specify their type arguments (`" + name + "<T,...>(...)`); argument type inference is not lowered yet")
                    return none
                }
                bad(em, e.span, "`" + name + "` is not lowered yet")
                none
            }
        }
    }


    /// Check a fixed-arity builtin's arguments and evaluate them left to
    /// right. Mirrors `positional_args` in emit.rs.
fn positionalArgs(em: Emitter, e: Expr, name: string, args: List<CallArg>, params: List<string>) -> List<int>? {
        var special = false
        for (a in args) {
            if (let some(_) = a.name) {
                special = true
            }
            if (a.spread) {
                special = true
            }
        }
        if (!(len(args) == len(params)) || special) {
            var word = "arguments"
            if (len(params) == 1) {
                word = "argument"
            }
            var shown = ""
            var first = true
            for (p in params) {
                if (first) {
                    first = false
                    shown = p
                } else {
                    shown = shown + ", " + p
                }
            }
            bad(em, e.span, "`" + name + "(" + shown + ")` takes exactly " + str(len(params)) + " " + word)
            return none
        }
        var temps = emptyInts()
        for (a in args) {
            if (let some(t) = expr(em, a.value)) {
                temps.push(t)
            } else {
                return none
            }
        }
        temps
    }

    /// Whether `name` resolves to a top-level generic user function (as opposed
    /// to a builtin or a non-generic overridden callable). Mirrors
    /// `generic_user_fn` in emit.rs.

    /// The name of the generic class/struct whose instantiated member body is
    /// currently being built (materialized generics contain the `<` type
    /// argument separator), or `none`. Mirrors `generic_owner` in emit.rs.

    /// `Enum.Variant(...)`: an attributed enum constructor call. Payload
    /// scalars are boxed exactly like list elements; the value is a managed
    /// object whose tag is the variant index and whose fields are the boxed
    /// args. Mirrors `enum_ctor` in emit.rs.
fn enumCtor(em: Emitter, e: Expr, t: EnumTable, name: string, args: List<CallArg>) -> int? {
        for (a in args) {
            if (a.spread) {
                bad(em, e.span, "spread arguments are not lowered yet")
                return none
            }
        }
        var vi = -1
        var ftypes = emptyTys()
        var found = false
        var i = 0
        for (v in t.variants) {
            if (v.name == name) {
                vi = i
                ftypes = v.fields
                found = true
                break
            }
            i = i + 1
        }
        if (!found) {
            bad(em, e.span, "enum `" + t.name + "` has no variant `" + name + "`")
            return none
        }
        var n = len(ftypes)
        if (!(len(args) == n)) {
            bad(em, e.span, "`" + name + "` takes " + str(n) + " argument(s), got " + str(len(args)))
            return none
        }
        var tag = temp(em)
        instr(em, IrInstr.Const(tag, IrConst.Int(vi)))
        var count = temp(em)
        instr(em, IrInstr.Const(count, IrConst.Int(n)))
        var obj = externCallT1(em, "pickle_enum_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [tag, count])
        var i2 = 0
        for (a in args) {
            var ft = ftypes[i2]
            var rp = elemRep(em, ft, e.span)
            if (let some(rep) = rp) {
                var v = expr(em, a.value)
                if (let some(v) = v) {
                    var vt = Ty.Unknown
                    if (let some(vt2) = tyOf(em, a.value.span)) {
                        vt = vt2
                    }
                    var packed = packForPointerBoundary(em, rep, v, vt, e.span)
                    if (let some(packed) = packed) {
                        var boxed = boxForStore(em, rep, packed, elemIr(ft))
                        if (let some(boxed) = boxed) {
                            var idx = temp(em)
                            instr(em, IrInstr.Const(idx, IrConst.Int(i2)))
                            externCallVoid(em, "pickle_enum_set_field", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, idx, boxed])
                        } else {
                            return none
                        }
                    } else {
                        return none
                    }
                } else {
                    return none
                }
            } else {
                return none
            }
            i2 = i2 + 1
        }
        obj
    }

    /// `xs.push(v)` and `xs.pop()` for `List<T>` receivers. The full method
    /// call tower: `Type.staticMethod(...)`, instance methods (virtual when
    /// overridden somewhere), fn-typed fields, interface dispatch, and the
    /// `Map`/`List`/`Stream` methods. Mirrors `method_call` in emit.rs.
fn methodCall(em: Emitter, e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        if (em.iceDepth > 150) {
            return none
        }
        em.iceDepth = em.iceDepth + 1
        em.icePath.push("methodCall")
        var r = methodCall1(em, e, object, name, args)
        em.iceDepth = em.iceDepth - 1
        r
    }

fn methodCall1(em: Emitter, e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        if (!icePoke(em, "methodCall1")) {
            return none
        }
        var ot = tyOf(em, object.span)
        var tnameO = exprKindIdentName(object)
        if (let some(tname) = tnameO) {
            var cidO = em.classByName.get(tname)
            if (let some(cid) = cidO) {
                var ncO = em.namedCtorIds.get(pairKey(str(cid), name))
                if (let some(fid) = ncO) {
                    if (anySpread(args)) {
                        bad(em, e.span, "spreading into a named constructor is not lowered yet")
                        return none
                    }
                    return callMethod(em, e, fid, args, none)
                }
                var mrO = em.methodIds.get(pairKey(str(cid), name))
                if (let some(mr) = mrO) {
                    if (!mr.isStatic) {
                        bad(em, e.span, "instance method `" + name + "` must be called on an instance of `" + tname + "`")
                        return none
                    }
                    if (anySpread(args)) {
                        var pty = srcParamList(em, mr.fid)
                        var rt = callRetFor(em, mr.fid)
                        return spreadStaticCall(em, e, e.span, mr.fid, pty, rt, none, args)
                    }
                    return callMethod(em, e, mr.fid, args, none)
                }
                bad(em, e.span, "`" + tname + "` has no static method `" + name + "`")
                return none
            }
        }
        var cid: int? = none
        if (let some(pt) = ot) {
            var isCS = false
            match (pt) {
                case Ty.Class(_, _) -> isCS = true
                case Ty.Struct(_, _) -> isCS = true
                case _ -> {}
            }
            if (isCS) {
                cid = classIdOf(em, pt, e.span)
            } else {
                var inner: Ty? = none
                match (pt) {
                    case Ty.Ref(iner) -> inner = iner
                    case _ -> {}
                }
                if (let some(iner) = inner) {
                    var isCS2 = false
                    match (iner) {
                        case Ty.Class(_, _) -> isCS2 = true
                        case Ty.Struct(_, _) -> isCS2 = true
                        case _ -> {}
                    }
                    if (isCS2) {
                        cid = classIdOf(em, iner, e.span)
                    }
                }
            }
        }
        if (let some(cc) = cid) {
            var mrO = em.methodIds.get(pairKey(str(cc), name))
            if (let some(mr) = mrO) {
                if (mr.isStatic) {
                    bad(em, e.span, "static method `" + name + "` must be called on the type, not an instance")
                    return none
                }
var receiverOpt = expr(em, object)
                if (let some(receiver) = receiverOpt) {
                    var isSuper = false
                    match (object.kind) {
                        case ExprKind.Super -> isSuper = true
                        case _ -> {}
                    }
                    var vb: List<DispatchBranch>? = none
                    if (!isSuper) {
                        vb = em.virtualDispatch.get(pairKey(str(cc), name))
                    }
                    if (let some(branches) = vb) {
                        if (len(branches) > 0) {
                            return virtualMethodCall(em, e, mr.fid, args, receiver, branches)
                        }
                    }
                    var mfid = mr.fid
                    return callMethod(em, e, mfid, args, receiver)
                }
                return none
            }
            var slotO = instanceFieldIndex(em, cc, name)
            if (let some(slot) = slotO) {
                var ft = fieldAt(em, cc, slot).ty
                var isFn = false
                match (ft) {
                    case Ty.Fn(_, _) -> isFn = true
                    case _ -> {}
                }
                if (isFn) {
                    var owner = expr(em, object)
                    if (let some(owner) = owner) {
                        var fv = fieldRead(em, e.span, owner, ft, slot)
                        if (let some(fv) = fv) {
                            return fnValueCallFrom(em, e, fv, ft, args)
                        }
                        return none
                    }
                    return none
                }
                bad(em, e.span, "field `" + name + "` of `" + classOfName(em, cc) + "` is not callable")
                return none
            }
bad(em, e.span, "`" + classOfName(em, cc) + "` has no method `" + name + "`")
            return none
        }

        // Receive-receiver (interface/list/map/stream/...) methods reject
        // spreads: only class/struct methods are wired through
        // `spreadStaticCall`. Mirrors emit.rs `method_call`.
        if (anySpread(args)) {
            bad(em, e.span, "spread arguments are not lowered for this receiver")
            return none
        }
        var hasIface = false
        if (let some(pt) = ot) {
            if (let some(_) = ifaceOf(pt)) {
                hasIface = true
            }
        }
        if (hasIface) {
            if (let some(pt) = ot) {
                return interfaceMethodCall(em, e, pt, object, name, args)
            }
            return none
        }
        var isMap = false
        var mapK = Ty.Unknown
        var mapV = Ty.Unknown
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Map(k, v) -> {
                    mapK = k
                    mapV = v
                    isMap = true
                }
                case _ -> {}
            }
        }
        if (isMap) {
            var kr = keyRep(em, mapK, object.span)
            if (let some(krep) = kr) {
                var vr = elemRep(em, mapV, e.span)
                if (let none = vr) {
                    return none
                }
                var obj = expr(em, object)
                if (let some(obj) = obj) {
                    match (name) {
                        case "has" -> {
                            if (!(len(args) == 1)) {
                                bad(em, e.span, "`has` takes one argument")
                                return none
                            }
var kt = expr(em, args[0].value)
                            if (let some(kt) = kt) {
                                var aTy = mapK
                                var aTyO = tyOf(em, args[0].value.span)
                                if (let some(t) = aTyO) {
                                    aTy = t
                                }
                                var keyO = packMapKey(em, krep, kt, aTy, args[0].value.span)
                                if (let some(key) = keyO) {
                                    return externCallT1(em, "pickle_map_has", [IrTy.Ptr, IrTy.Ptr], IrTy.Bool, [obj, key])
                                }
                                return none
                            }
                            return none
                        }
                        case "get" -> {
                            if (!(len(args) == 1)) {
                                bad(em, e.span, "`get` takes one argument (a key)")
                                return none
                            }
var k = expr(em, args[0].value)
                            if (let some(k) = k) {
                                var aTy = mapK
                                var aTyO = tyOf(em, args[0].value.span)
                                if (let some(t) = aTyO) {
                                    aTy = t
                                }
                                var keyO = packMapKey(em, krep, k, aTy, args[0].value.span)
                                if (let some(key) = keyO) {
                                    return externCallT1(em, "pickle_map_get", [IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key])
                                }
                                return none
                            }
                            return none
                        }
                        case "remove" -> {
                            if (!(len(args) == 1)) {
                                bad(em, e.span, "`remove` takes one argument (a key)")
                                return none
                            }
var k = expr(em, args[0].value)
                            if (let some(k) = k) {
                                var aTy = mapK
                                var aTyO = tyOf(em, args[0].value.span)
                                if (let some(t) = aTyO) {
                                    aTy = t
                                }
                                var keyO = packMapKey(em, krep, k, aTy, args[0].value.span)
                                if (let some(key) = keyO) {
                                    return externCallT1(em, "pickle_map_remove", [IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key])
                                }
                                return none
                            }
                            return none
                        }
                        case "keys" -> {
                            if (!(len(args) == 0)) {
                                bad(em, e.span, "`keys` takes no arguments")
                                return none
                            }
                            return externCallT1(em, "pickle_map_keys", [IrTy.Ptr], IrTy.Ptr, [obj])
                        }
                        case "values" -> {
                            if (!(len(args) == 0)) {
                                bad(em, e.span, "`values` takes no arguments")
                                return none
                            }
                            return externCallT1(em, "pickle_map_values", [IrTy.Ptr], IrTy.Ptr, [obj])
                        }
                        case _ -> {
                            bad(em, e.span, "`" + name + "` method on `Map` is not lowered yet")
                            return none
                        }
                    }
                }
                return none
            }
            return none
        }
        var isList = false
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.List(_) -> isList = true
                case _ -> {}
            }
        }
        if (isList) {
            return listMethodCall(em, e, object, name, args)
        }
        var isStream = false
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Stream -> isStream = true
                case _ -> {}
            }
        }
        if (isStream) {
            return streamMethodCall(em, e, object, name, args)
        }
        bad(em, e.span, "method calls on this type are not lowered yet")
        none
    }

    /// Emit a call to a class method function, passing the receiver first for
    /// instance methods. Mirrors `call_method` in emit.rs.
fn callMethod(em: Emitter, e: Expr, fid: int, args: List<CallArg>, receiver: int?) -> int? {
        if (!icePoke(em, "callMethod")) {
            return none
        }
        if (anySpread(args)) {
            var pty = srcParamList(em, fid)
            var rt = callRetFor(em, fid)
            return spreadStaticCall(em, e, e.span, fid, pty, rt, receiver, args)
        }
var callArgs = emptyInts()
        var ca = marshalMethodArgs(em, e, fid, args, receiver)
        if (let some(c) = ca) {
            callArgs = c
        } else {
            return none
        }
        emitCallTo(em, fid, callArgs, e)
    }

    /// Marshal a method call's receiver (first for instance methods) and
    /// argument values into the callee's calling-convention temp list. A
    /// parameter declared `T` with a `T?` option-typed callee slot gets its
    /// scalar lifted via `option_wrap`. Mirrors `marshal_method_args`.
fn marshalMethodArgs(em: Emitter, e: Expr, fid: int, args: List<CallArg>, receiver: int?) -> List<int>? {
        if (!icePoke(em, "marshalMethodArgs")) {
            return none
        }
        let _ = e
        var fparams = em.irModule.funcs[fid].params
        var callArgs = emptyInts()
        if (let some(r) = receiver) {
            callArgs.push(r)
        }
        var base = len(callArgs)
        var i = 0
        for (a in args) {
var src: Ty? = none
            if (let some(sps) = em.srcParamTys.get(fid)) {
                if (i < len(sps)) {
                    src = sps[i]
                }
            }
            var isRef = false
            if (let some(s) = src) {
                match (s) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
var t = borrowArg(em, src, a)
            if (let some(t) = t) {
                var fparamTy: IrTy? = none
                if (base + i < len(fparams)) {
                    fparamTy = fparams[base + i].ty
                } else {
                    if (let some(s) = src) {
                        fparamTy = mapTy(em, s, a.value.span)
                    }
                }
                var wantsWrap = false
                if (!isRef) {
                    if (let some(ft) = fparamTy) {
                        if (irTyTag(ft) == irTyTag(IrTy.Ptr)) {
                            wantsWrap = true
                        }
                    }
                }
                if (wantsWrap) {
                    var vt = Ty.Unknown
                    if (let some(v) = tyOf(em, a.value.span)) {
                        vt = v
                    }
                    var ov = optionWrap(em, t, vt, a.value.span)
                    if (let some(o) = ov) {
                        callArgs.push(o)
                    } else {
                        return none
                    }
                } else {
                    callArgs.push(t)
                }
            } else {
                return none
            }
            i = i + 1
        }
        callArgs
    }

    /// Emit the `Call` instruction of an already-marshaled method call.
fn emitCallTo(em: Emitter, fid: int, callArgs: List<int>, e: Expr) -> int {
        let _ = e
        var dst = temp(em)
        instr(em, IrInstr.Call(dst, Callee.Func(fid), callArgs))
        // A Pickle-level `throw` is cooperative: the callee returns normally
        // with the pending flag set instead of unwinding, so the call site has
        // to notice and leave before anyone reads `dst`.
        guardPropagation(em, fid)
        dst
    }

    /// Emit the pending check after a call to `fid`, if that call can propagate.
    /// After a call that may leave a throw pending, either record the edge (on
    /// the analysis pass) or emit the check (on the real one).
    ///
    /// Recording happens even when the enclosing function will turn out not to
    /// need a check at all: the call really is a call, so it really is an edge.
    /// Keeping every edge is what makes the fixed point safe, since the answer
    /// is only ever used to *remove* a check.
fn guardPropagation(em: Emitter, fid: int) {
        if (em.analyzing) {
            if (let some(caller) = em.currentFid) {
                match (em.callEdges.get(caller)) {
                    case some(callees) -> callees.push(fid)
                    case none -> em.callEdges[caller] = [fid]
                }
            }
            return
        }
        if (checkPropagates(em, fid)) {
            checkPending(em)
        }
    }

    /// Can a call to `fid` leave a throw pending?
    ///
    /// A program with no `throw` anywhere cannot propagate one, so it skips
    /// every check. Otherwise this is the fixed point from `solveMayThrow`, and
    /// anything it does not know -- a function the analysis pass could not reach
    /// -- is assumed to propagate. That direction only ever costs a predictable
    /// branch, whereas guessing "no" would lose a throw.

    /// After a call that may have thrown, branch to the innermost `catch` in
    /// this function or out of it. The flag stays set until someone consumes it.
fn checkPending(em: Emitter) {
        let pending = externCallT1(em, EXC_PENDING, emptyIrTys(), IrTy.Bool, emptyInts())
        let thrown = newBlock(em)
        let resume = newBlock(em)
        term(em, IrTerm.BranchIf(pending, thrown, resume))
        em.cur = thrown
        transferToHandlerOrPropagate(em)
        em.cur = resume
    }

    /// Compute the transitive may-throw answer for every function the analysis
    /// pass lowered.
    ///
    /// `directThrow` seeds the set with the functions containing a `throw` of
    /// their own; `callEdges` then carries that backwards along every recorded
    /// call, to a fixed point.
    ///
    /// The result records an answer for *every* function the analysis pass
    /// lowered, including the ones that came out `false`. That is the whole
    /// point: `checkPropagates` treats an absent id as propagating, so recording
    /// only the throwing set would leave every safe callee looking unknown and
    /// every call site checked. Only a function the pass never reached stays
    /// absent, and that can only cost a branch.
    /// The exit itself, once every `finally` has run.

    /// Run every `finally` still owed on the way out, innermost first, then take
    /// the exit itself.
fn exitThroughFinallys(em: Emitter, exit: Exit) {
        if (len(em.finallys) == 0) {
            performExit(em, exit)
            return
        }
        let chain = em.finallys
        em.finallys = emptyBlocks()
        // The flag is set on every path that reaches here through a throw, so the
        // `finally` bodies run with propagation checks suppressed.
        let saved = em.inThrowTransfer
        em.inThrowTransfer = true
        var i = len(chain) - 1
        while (i >= 0) {
            // One copy of the `finally` per level, then on to the next level.
            let after = newBlock(em)
            pushScope(em)
            blockBodyOnly(em, chain[i])
            popScope(em)
            term(em, IrTerm.Branch(after))
            em.cur = after
            i = i - 1
        }
        em.inThrowTransfer = saved
        em.finallys = chain
        performExit(em, exit)
    }

    /// Leave the current block for the innermost `catch` in this function, or out
    /// of the function when there is none.
    ///
    /// The `finally`s still owed on the way are only the ones from *inside* the
    /// handler's own `try`, and they run innermost first. The handler's own
    /// `finally` is deliberately left on the stack: `tryStmt` emits it once, after
    /// the handler body, on the path this branch takes.
    ///
    /// This only *emits*; it never mutates the `handlers`/`finallys` stacks. Both
    /// callers lower a path that does not necessarily commit -- a `checkPending`
    /// guard resumes into the same handler scope afterwards, and a `throw`
    /// statement is only one of several statements still to be emitted -- so a
    /// transfer that consumed the enclosing context would strand every later
    /// `throw` in the same body. `tryStmt` balances its own push once, when the
    /// body and the handler are both fully emitted.
fn transferToHandlerOrPropagate(em: Emitter) {
        if (len(em.handlers) == 0) {
            exitThroughFinallys(em, Exit.Propagate)
            return
        }
        let handler = em.handlers[len(em.handlers) - 1]
        let chain = em.finallys
        em.finallys = emptyBlocks()
        // The `try` emits its own `finally` after the handler body, not before,
        // so the first `finally` still owed on the way is one past it when the
        // owning `try` has one of its own, and exactly at the base when it does
        // not -- an inner `try`'s `finally` then occupies the base itself.
        var innerBase = handler.finBase
        if (handler.ownFinally) {
            innerBase = innerBase + 1
        }
        // The flag is still set here, so the inner `finally` bodies run with
        // propagation checks suppressed: a check would see the throw we are
        // transferring on and divert straight to the handler, skipping the
        // remaining `finally`s.
        let saved = em.inThrowTransfer
        em.inThrowTransfer = true
        var i = len(chain) - 1
        while (i >= innerBase) {
            let after = newBlock(em)
            pushScope(em)
            blockBodyOnly(em, chain[i])
            popScope(em)
            term(em, IrTerm.Branch(after))
            em.cur = after
            i = i - 1
        }
        em.inThrowTransfer = saved
        // The whole chain goes back, including the handler's own `finally`: the
        // handler body is emitted with it live, so a `return` inside the handler
        // still runs it.
        em.finallys = chain
        term(em, IrTerm.Branch(handler.target))
        em.cur = newBlock(em)
    }

    /// `throw EXPR`. The parser stays permissive about the operand's type, so the
    /// value here is a temp of whatever `expr` produced; the checker has already
    /// established that it is a `string`.
fn throwStmt(em: Emitter, value: Expr, _span: Span) -> bool {
        if (let some(t) = expr(em, value)) {
            var payload = t
            if (irTyTag(em.fret) == irTyTag(IrTy.Ptr)) {
                var vt = Ty.Unknown
                if (let some(gt) = tyOf(em, value.span)) {
                    vt = gt
                }
                if (let some(w) = optionWrap(em, payload, vt, value.span)) {
                    payload = w
                } else {
                    return false
                }
            }
            throwWith(em, payload)
            true
        } else {
            false
        }
    }

    /// Publish `payload` and transfer control.
    ///
    /// With an enclosing `catch` in this function, control branches straight to it
    /// after running any `finally` from *inside* that `catch`'s own `try`, so a
    /// local `throw` costs no flag round-trip. The payload still goes through
    /// `pickle_exc_throw`, which roots it in the GC for the jump and lets the
    /// handler's `pickle_exc_take` release it. With no `catch` here the flag
    /// stays set and the caller observes it after the call.
fn throwWith(em: Emitter, payload: int) {
        if (em.analyzing) {
            // A `throw` in this body is the seed for its own fixed point; the
            // transfer that follows is pass 2's problem.
            if (let some(fid) = em.currentFid) {
                em.directThrow[fid] = true
            }
            return
        }
        externCallVoid(em, EXC_THROW, [IrTy.Ptr], [payload])
        transferToHandlerOrPropagate(em)
    }

    /// `try BODY catch (BINDER)? BLOCK finally BLOCK?`
    ///
    /// `body` is emitted inline. The end of `body` checks the pending flag and
    /// either falls through to `finally` or enters the handler, which consumes
    /// the flag and binds the payload to a frame slot (the IR has no block
    /// parameters, so the `logic` idiom of a `Slot` written in one block and read
    /// in another is what carries the value across the branch). A `throw` written
    /// inside `body` skips the flag and branches to the handler directly.
    ///
    /// All three ways out -- body normal, handler, and a propagating throw -- run
    /// `fin`, so `fin` is emitted once per way out. The owning `try`'s `finally`
    /// is on the `finallys` stack while `body` and the handler are emitted, so a
    /// `return` inside either runs it; a single pop then balances it before the
    /// fall-through copies are emitted, so those copies cannot re-enter it.
fn tryStmt(em: Emitter, body: Block, binder: string?, handler: Block?, fin: Block?, _span: Span, res: int?) -> bool {
        let afterBody = newBlock(em)
        let handlerId = newBlock(em)
        let handlerFinId = newBlock(em)
        let endId = newBlock(em)
        var hasHandler = false
        var hasFinally = false
        if (let some(_) = handler) {
            hasHandler = true
        }
        if (let some(_) = fin) {
            hasFinally = true
        }

        // A `throw` in the body targets the handler directly, so its context must
        // be in scope while the body is emitted.
        let finBase = len(em.finallys)
        if (let some(f) = fin) {
            em.finallys.push(f)
        }
        if (hasHandler) {
            em.handlers.push(HandlerCtx(handlerId, finBase, hasFinally))
        }

        pushScope(em)
        if (!(blockIntoSlot(em, body, res))) {
            popScope(em)
            return false
        }
        popScope(em)

        if (hasHandler) {
            // A call in the body may have thrown: hand over to the handler.
            let pending = externCallT1(em, EXC_PENDING, emptyIrTys(), IrTy.Bool, emptyInts())
            term(em, IrTerm.BranchIf(pending, handlerId, afterBody))
        } else {
            term(em, IrTerm.Branch(afterBody))
        }

        // The body can no longer `throw` to this handler, so a `throw` in the
        // handler propagates outward instead. Only the context this `try` pushed
        // goes away: a `try` with no `catch` of its own must leave an enclosing
        // handler in scope for the code that follows it.
        if (hasHandler) {
            em.handlers.pop()
        }

        em.cur = handlerId
        if (let some(h) = handler) {
            // Consume the throw: this both clears the flag and yields the payload,
            // and it is the only thing that unroots the payload.
            let payload = externCallT1(em, EXC_TAKE, emptyIrTys(), IrTy.Ptr, emptyInts())
            pushScope(em)
            if (let some(name) = binder) {
                let slot = newSlot(em, IrTy.Ptr)
                instr(em, IrInstr.StoreSlot(slot, payload))
                declare(em, name, slot)
            }
            if (!(blockIntoSlot(em, h, res))) {
                popScope(em)
                return false
            }
            popScope(em)
        }

        if (let some(f) = fin) {
            // A single compile-time pop balances the push from before the body.
            // The handler's fall-through copy and the body's fall-through copy are
            // two emissions of the *same* `finally`, so the stack is already
            // balanced by the time the body copy is emitted.
            em.finallys.pop()
            if (hasHandler) {
                term(em, IrTerm.Branch(handlerFinId))
                em.cur = handlerFinId
                pushScope(em)
                blockBodyOnly(em, f)
                popScope(em)
            }
        }
        term(em, IrTerm.Branch(endId))

        em.cur = afterBody
        if (let some(f) = fin) {
            pushScope(em)
            blockBodyOnly(em, f)
            popScope(em)
        }
        term(em, IrTerm.Branch(endId))
        em.cur = endId
        true
    }

    /// Lower an instance call to a method overridden somewhere in the program:
    /// `pickle_class_is(receiver, D_cid)` checks deepest-derived-first, each
    /// branching to that descendant's own implementation and joining on a
    /// result slot; a receiver that is an instance of no overriding descendant
    /// falls through to the statically-resolved `fallback_fid`. Mirrors
    /// `virtual_method_call`.
fn virtualMethodCall(em: Emitter, e: Expr, fallbackFid: int, args: List<CallArg>, receiver: int, branches: List<DispatchBranch>) -> int? {
        if (anySpread(args)) {
            bad(em, e.span, "spread arguments cannot dispatch virtually (the method is overridden)")
            return none
        }
        var rt = IrTy.Unit
        if (let some(r) = irty(em, e.span)) {
            rt = r
        } else {
            return none
        }
        var retSlot = newSlot(em, rt)
        var join = newBlock(em)
        for (b in branches) {
            var cb = newBlock(em)
            var next = newBlock(em)
            var dc = intConst(em, b.cid)
            var found = externCallT1(em, "pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [receiver, dc])
            term(em, IrTerm.BranchIf(found, cb, next))
            em.cur = cb
            var callArgs = emptyInts()
            var ca1 = marshalMethodArgs(em, e, b.fid, args, receiver)
            if (let some(c1) = ca1) {
                callArgs = c1
            } else {
                return none
            }
            var val = emitCallTo(em, b.fid, callArgs, e)
            instr(em, IrInstr.StoreSlot(retSlot, val))
            term(em, IrTerm.Branch(join))
            em.cur = next
        }
        var fallbackArgs = emptyInts()
        var caf = marshalMethodArgs(em, e, fallbackFid, args, receiver)
        if (let some(cf) = caf) {
            fallbackArgs = cf
        } else {
            return none
        }
        var val = emitCallTo(em, fallbackFid, fallbackArgs, e)
        instr(em, IrInstr.StoreSlot(retSlot, val))
        term(em, IrTerm.Branch(join))
        em.cur = join
        var dst = temp(em)
        instr(em, IrInstr.LoadSlot(dst, retSlot))
        dst
    }

    /// Lower `object.name(...)` where the receiver's static type is an
    /// interface. The dispatch core is shared with the `Iterable`/`Iterator`
    /// protocol calls; see `interfaceDispatch`. Mirrors `interface_method_call`.
fn interfaceMethodCall(em: Emitter, e: Expr, ift: Ty, object: Expr, name: string, args: List<CallArg>) -> int? {
        var receiver = expr(em, object)
        if (let some(receiver) = receiver) {
            var rt = IrTy.Unit
            if (let some(r) = irty(em, e.span)) {
                rt = r
            } else {
                return none
            }
            return interfaceDispatch(em, e, e.span, ift, receiver, name, args, rt)
        }
        none
    }

    /// Shared core of an interface-dispatched `.name(args)` call against an
    /// already-lowered receiver. A compile-time chain of
    /// `pickle_class_is(receiver, D_cid)` checks over every registered class
    /// that transitively implements the interface, deepest-derived-first, each
    /// branching to that class's own resolved implementation and joining on a
    /// result slot; a runtime fallback `pickle_iface_method(receiver,
    /// iface_id, m_idx)` reads the receiver's own class's method-table entry
    /// and indirect-calls it. Mirrors `interface_dispatch`.
fn interfaceDispatch(em: Emitter, e: Expr, span2: Span, ift: Ty, receiver: int, name: string, args: List<CallArg>, retTy: IrTy) -> int? {
        var ifaceName = ""
        var ifaceArgs = emptyTys()
        var isIface = false
        if (let some(ir) = ifaceOf(ift)) {
            ifaceName = ir.name
            ifaceArgs = ir.args
            isIface = true
        }
        if (!isIface) {
            bad(em, span2, "receiver type is not an interface")
            return none
        }
        var ifaceId = 0
        if (let some(id) = ifaceIdFor(em, ifaceName, ifaceArgs, span2)) {
            ifaceId = id
        } else {
            return none
        }
        var mIdx = -1
        var foundM = false
        var msO = em.ifaceMembers.get(ifaceId)
        if (let some(members) = msO) {
            for (m in members) {
                if (m.name == name) {
                    mIdx = m.index
                    foundM = true
                    break
                }
            }
        }
        if (!foundM) {
            bad(em, span2, "`" + ifaceName + "` has no method `" + name + "`")
            return none
        }
        var branches = emptyIfaceDepths()
        for (p in em.classes) {
            if (!classImplementsIface(em, p.classId, ifaceId)) {
                continue
            }
            var mrO = em.methodIds.get(pairKey(str(p.classId), name))
            if (let none = mrO) {
                continue
            }
            if (let some(mr) = mrO) {
                if (mr.isStatic) {
                    bad(em, span2, "interface method `" + name + "` is static on `" + p.name + "`")
                    return none
                }
                var depth = len(ancestry(em, p.name))
                branches.push(IfaceDepthBranch(depth, p.classId, mr.fid))
            }
        }
        if (len(branches) == 0) {
            bad(em, span2, "`" + ifaceName + "." + name + "` is implemented by no class in this program")
            return none
        }
        sortIfaceBranches(branches)
        var retSlot = newSlot(em, retTy)
        var join = newBlock(em)
        for (b in branches) {
            var cb = newBlock(em)
            var next = newBlock(em)
            var dc = intConst(em, b.cid)
            var found = externCallT1(em, "pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [receiver, dc])
            term(em, IrTerm.BranchIf(found, cb, next))
            em.cur = cb
            var callArgs2 = emptyInts()
            var ca2 = marshalMethodArgs(em, e, b.fid, args, receiver)
            if (let some(c2) = ca2) {
                callArgs2 = c2
            } else {
                return none
            }
            var val = emitCallTo(em, b.fid, callArgs2, e)
            instr(em, IrInstr.StoreSlot(retSlot, val))
            term(em, IrTerm.Branch(join))
            em.cur = next
        }
        var iid = intConst(em, ifaceId)
        var midx = intConst(em, mIdx)
        var fp = externCallT1(em, "pickle_iface_method", [IrTy.Ptr, IrTy.Int, IrTy.Int], IrTy.Int, [receiver, iid, midx])
        var isZeroO = cmpZero(em, fp, IrBinOp.Eq, false)
        var isZero = -1
        if (let some(z) = isZeroO) {
            isZero = z
        } else {
            return none
        }
        var ok = newBlock(em)
        var guard = newBlock(em)
        term(em, IrTerm.BranchIf(isZero, guard, ok))
        em.cur = guard
        externCallVoid(em, "pickle_panic_no_iface_method", emptyIrTys(), emptyInts())
        term(em, IrTerm.Branch(join))
        em.cur = ok
        var prototype = branches[0].fid
        var protoArgs = emptyInts()
        var cap = marshalMethodArgs(em, e, prototype, args, receiver)
        if (let some(cp) = cap) {
            protoArgs = cp
        } else {
            return none
        }
        var params = emptyIrTys()
        params.push(IrTy.Ptr)
        var spsO = em.srcParamTys.get(prototype)
        if (let some(src) = spsO) {
            for (t in src) {
                var mt = mapTy(em, t, span2)
                if (let some(m) = mt) {
                    params.push(m)
                } else {
                    params.push(IrTy.Ptr)
                }
            }
        }
        var dst = temp(em)
        instr(em, IrInstr.CallInd(dst, fp, params, retTy, protoArgs))
        instr(em, IrInstr.StoreSlot(retSlot, dst))
        term(em, IrTerm.Branch(join))
        em.cur = join
        var out = temp(em)
        instr(em, IrInstr.LoadSlot(out, retSlot))
        out
    }


    /// A zero-argument interface call against an already-lowered receiver,
    /// used by the `Iterable`/`Iterator` protocol surface in `for_in_protocol`.
    /// Mirrors `interface_zero_arg_call` in emit.rs.
fn interfaceZeroArgCall(em: Emitter, span2: Span, ift: Ty, rec: int, name: string, retTy: IrTy) -> int? {
        var dummy = Expr(span2, ExprKind.Ident(""))
        interfaceDispatch(em, dummy, span2, ift, rec, name, emptyCallArgs(), retTy)
    }

    /// `xs.push(v)` and `xs.pop()` for `List<T>` receivers. Mirrors
    /// `list_method_call` in emit.rs.
fn listMethodCall(em: Emitter, e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        var elem = Ty.Unknown
        var isList = false
        if (let some(pt) = tyOf(em, object.span)) {
            match (pt) {
                case Ty.List(inner) -> {
                    elem = inner
                    isList = true
                }
                case _ -> {}
            }
        }
        if (!isList) {
            bad(em, e.span, "receiver is not a `List`")
            return none
        }
        var obj = expr(em, object)
        if (let some(obj) = obj) {
            match (name) {
                case "push" -> {
                    if (!(len(args) == 1)) {
                        bad(em, e.span, "`push` takes one argument")
                        return none
                    }
                    var rp = elemRep(em, elem, e.span)
                    if (let some(rep) = rp) {
                        var v = expr(em, args[0].value)
                        if (let some(v) = v) {
                            var pushV = v
                            if (!(rep.isPtr)) {
                                var vt = irty(em, args[0].value.span)
                                if (let some(vt) = vt) {
                                    pushV = externCallT1(em, rep.boxSym, [vt], IrTy.Ptr, [v])
                                } else {
                                    return none
                                }
                            }
                            externCallVoid(em, "pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [obj, pushV])
                            return unitTemp(em)
                        }
                        return none
                    }
                    return none
                }
                case "pop" -> {
                    if (!(len(args) == 0)) {
                        bad(em, e.span, "`pop` takes no arguments")
                        return none
                    }
                    var rp = elemRep(em, elem, e.span)
                    if (let some(rep) = rp) {
                        var raw = externCallT1(em, "pickle_list_pop", [IrTy.Ptr], IrTy.Ptr, [obj])
                        if (rep.isPtr) {
                            return raw
                        }
                        return externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
                    }
                    return none
                }
                case "remove" -> {
                    if (!(len(args) == 1)) {
                        bad(em, e.span, "`remove` takes one argument (an index)")
                        return none
                    }
                    var rp = elemRep(em, elem, e.span)
                    if (let some(rep) = rp) {
                        var index = expr(em, args[0].value)
                        if (let some(index) = index) {
                            var raw = externCallT1(em, "pickle_list_remove", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, index])
                            if (rep.isPtr) {
                                return raw
                            }
                            return externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
                        }
                        return none
                    }
                    return none
                }
                case "insert" -> {
                    if (!(len(args) == 2)) {
                        bad(em, e.span, "`insert` takes an index and a value")
                        return none
                    }
                    var rp = elemRep(em, elem, e.span)
                    if (let some(rep) = rp) {
                        var index = expr(em, args[0].value)
                        if (let some(index) = index) {
                            var v = expr(em, args[1].value)
                            if (let some(v) = v) {
                                var insV = v
                                if (!(rep.isPtr)) {
                                    var vt = irty(em, args[1].value.span)
                                    if (let some(vt) = vt) {
                                        insV = externCallT1(em, rep.boxSym, [vt], IrTy.Ptr, [v])
                                    } else {
                                        return none
                                    }
                                }
                                externCallVoid(em, "pickle_list_insert", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, index, insV])
                                return unitTemp(em)
                            }
                            return none
                        }
                        return none
                    }
                    return none
                }
                case "sort" -> {
                    if (!(len(args) == 0)) {
                        bad(em, e.span, "`sort` takes no arguments")
                        return none
                    }
                    var kv = sortKind(em, elem, e.span)
                    if (let some(kind) = kv) {
                        externCallVoid(em, "pickle_list_sort", [IrTy.Ptr, IrTy.Int], [obj, kind])
                        return unitTemp(em)
                    }
                    return none
                }
                case _ -> {
                    bad(em, e.span, "`" + name + "` method on `List` is not lowered yet")
                    return none
                }
            }
        }
        none
    }

    /// Comparison kind for `pickle_list_sort`: 0 = int/byte/char/bool boxed
    /// payloads, 1 = float bits, 2 = string bytes. Mirrors `sort_kind`.

    /// Lower a `Stream` method call. `Stream` is carried at the ABI as a raw
    /// object pointer; every method takes that pointer as its receiver. Mirrors
    /// `stream_method_call` in emit.rs.
fn streamMethodCall(em: Emitter, e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        var obj = expr(em, object)
        if (let some(obj) = obj) {
            match (name) {
                case "read" -> {
                    if (!(len(args) == 1)) {
                        bad(em, e.span, "`read` takes one argument (a byte count)")
                        return none
                    }
                    var n = expr(em, args[0].value)
                    if (let some(n) = n) {
                        return externCallT1(em, "pickle_stream_read", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, n])
                    }
                    return none
                }
                case "write" -> {
                    if (!(len(args) == 1)) {
                        bad(em, e.span, "`write` takes one argument (a `List<byte>`)")
                        return none
                    }
                    var bytes = expr(em, args[0].value)
                    if (let some(bytes) = bytes) {
                        return externCallT1(em, "pickle_stream_write", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [obj, bytes])
                    }
                    return none
                }
                case "flush" -> {
                    if (!(len(args) == 0)) {
                        bad(em, e.span, "`flush` takes no arguments")
                        return none
                    }
                    return externCallT1(em, "pickle_stream_flush", [IrTy.Ptr], IrTy.Bool, [obj])
                }
                case "close" -> {
                    if (!(len(args) == 0)) {
                        bad(em, e.span, "`close` takes no arguments")
                        return none
                    }
                    return externCallT1(em, "pickle_stream_close", [IrTy.Ptr], IrTy.Bool, [obj])
                }
                case _ -> {
                    bad(em, e.span, "`" + name + "` method on `Stream` is not lowered yet")
                    return none
                }
            }
        }
        none
    }

    /// Whether a registered class (or one of its ancestors) directly declared
    /// `implements` for `iface_id`. Mirrors `class_implements_iface`.

    /// `name<Type,...>(args)`: an explicit generic user-function (or generic
    /// class/struct ctor) call. The call is monomorphized: the generic callee
    /// is instantiated over the resolved type arguments (substituted under the
    /// enclosing instantiation, if any), and the call is emitted as a static
    /// call to that concrete function. Mirrors `generic_call` in emit.rs.
fn genericCall(em: Emitter, e: Expr, name: string, typeArgs: List<TypeExpr>, args: List<CallArg>) -> int? {
        // `Box<int>(...)`: a generic class/struct constructor call. The name
        // shares the generic-call surface with generic functions, but
        // resolves through the type table.
        var table = seedClassTable()
        var isEntry = false
        if (let some(entry) = em.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    table = t
                    isEntry = true
                }
                case TypeTableEntry.Struct(t) -> {
                    table = t
                    isEntry = true
                }
                case _ -> {}
            }
        }
        if (isEntry) {
            return genericClassCall(em, e, name, table, typeArgs, args)
        }
        var info = userCallableFirst(em, name)
        if (let none = info) {
            bad(em, e.span, "unknown generic function `" + name + "`")
            return none
        }
        var inf = seedCallableInfo()
        if (let some(x) = info) {
            inf = x
        }
        var argTys = emptyTys()
        for (te in typeArgs) {
            var t = em.resolved.resolveTy(te, em.fnGenerics, em.diags)
            argTys.push(substTy(em, t))
        }
        if (!(len(argTys) == len(inf.generics))) {
            bad(em, e.span, "`" + name + "` takes " + str(len(inf.generics)) + " type argument(s), found " + str(len(argTys)))
            return none
        }
        genericFnCall(em, e, inf, argTys, args)
    }

    /// Core of a monomorphized generic-function call, shared by the explicit
    /// `name<T,...>(args)` form and the argument-driven `name(args)` form.
    /// Mirrors `generic_fn_call` in emit.rs.
fn genericFnCall(em: Emitter, e: Expr, info: CallableInfo, argTys: List<Ty>, args: List<CallArg>) -> int? {
        var name = info.name
        if (anyHasVar(argTys)) {
            bad(em, e.span, "cannot instantiate `" + name + "` with unresolved type arguments; specify them explicitly like `" + name + "<...>(...)`")
            return none
        }
        var map = emptyStringTyMap()
        var zi = 0
        while (zi < len(info.generics) && zi < len(argTys)) {
            map[info.generics[zi]] = argTys[zi]
            zi = zi + 1
        }
        var key2 = instKey(name, argTys)
        var fid = 0
        var fidO = em.instantiations.get(key2)
        if (let some(f) = fidO) {
            fid = f
        } else {
            var ifg = instantiateGenericFn(em, e.span, info, name, argTys, map)
            if (let some(f2) = ifg) {
                fid = f2
            } else {
                return none
            }
        }
// Mirror the plain user-function call: borrow `&T` reference params,
        // wrap optional params, and store the result.
        if (anySpread(args)) {
            var pty = srcParamList(em, fid)
            var rt = callRetFor(em, fid)
            return spreadStaticCall(em, e, e.span, fid, pty, rt, none, args)
        }
        var argTemps = emptyInts()
        var i = 0
        while (i < len(args)) {
            var a = args[i]
            var srcO: Ty? = none
            if (let some(v) = em.srcParamTys.get(fid)) {
                if (i < len(v)) {
                    srcO = v[i]
                }
            }
            var isRef = false
            if (let some(sr) = srcO) {
                match (sr) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
            var isOpt = false
            if (let some(sr2) = srcO) {
                match (sr2) {
                    case Ty.Option(_) -> isOpt = true
                    case Ty.None -> isOpt = true
                    case _ -> {}
                }
            }
            var t = -1
            if (let some(tv) = borrowArg(em, srcO, a)) {
                t = tv
            } else {
                return none
            }
            var finalT = t
            if (!isRef && isOpt) {
                var vt = Ty.Unknown
                if (let some(gvt) = tyOf(em, a.value.span)) {
                    vt = gvt
                }
                var tw = optionWrap(em, t, vt, a.value.span)
                if (let some(twc) = tw) {
                    finalT = twc
                } else {
                    return none
                }
            }
            argTemps.push(finalT)
            i = i + 1
        }
        var dst = temp(em)
        instr(em, IrInstr.Call(dst, Callee.Func(fid), argTemps))
        guardPropagation(em, fid)
        dst
    }

    /// Lower `name<Type,...>` used as a VALUE (not called): the explicit type
    /// arguments pick the concrete instantiation, which is wrapped in the same
    /// zero-capture closure a plain function value gets, so it can be stored,
    /// passed around, and called through the regular dynamic call convention.
    /// Mirrors `generic_fn_value` in emit.rs.

    /// Materialize a generic function as a value over concrete `arg_tys`:
    /// create (or reuse) the instantiation, wrap it in a zero-capture closure
    /// whose slot 0 holds a forwarder trampoline's address, and return the
    /// closure object. Mirrors `generic_fn_value_for` in emit.rs.

    /// The forwarder trampoline a generic instantiation value is wrapped in:
    /// one per target instantiation, always forwarding the concrete
    /// substituted signature recorded in `finfo`. Mirrors `value_trampoline`
    /// in emit.rs.

    /// Infer the type arguments of a generic user function `name(args)` from
    /// the argument expressions' recorded types, exactly as the checker does
    /// (`ty::infer_from`). Every generic parameter must be pinned by at least
    /// one argument; an unpinned one bails with a message mirroring the
    /// checker's. Clean programs never reach this failure (the checker
    /// reports it), so the message is a defensive fallback. Mirrors
    /// `infer_generic_fn_args` in emit.rs.

    /// A generic class/struct constructor call `Box<int>(arg, ...)`. Resolves
    /// the concrete type arguments, materializes the instantiation plan, and
    /// calls its implicit constructor exactly like a plain `TypeName(arg)`
    /// call. Mirrors `generic_class_call` in emit.rs.
fn genericClassCall(em: Emitter, e: Expr, name: string, cls: ClassTable, typeArgs: List<TypeExpr>, args: List<CallArg>) -> int? {
        var argTys = emptyTys()
        for (te in typeArgs) {
            var t = em.resolved.resolveTy(te, em.fnGenerics, em.diags)
            argTys.push(substTy(em, t))
        }
        if (!(len(argTys) == len(cls.generics))) {
            bad(em, e.span, "`" + name + "` takes " + str(len(cls.generics)) + " type argument(s), found " + str(len(argTys)))
            return none
        }
        var key2 = instKey(name, argTys)
        var cid = 0
        var cidO = em.classInstByArgs.get(key2)
        if (let some(c) = cidO) {
            cid = c
        } else {
            var cg = registerClassInstantiation(em, name, argTys, e.span)
            if (let some(c2) = cg) {
                cid = c2
            } else {
                return none
            }
        }
        var fid = 0
        var fO = em.ctorIds.get(cid)
        if (let none = fO) {
            return none
        }
        if (let some(f2) = fO) {
            fid = f2
        }
        // Mirror the plain class-constructor call: borrow `&T` reference
        // parameters, wrap optional parameters, and store the result.
        var fparams = em.irModule.funcs[fid].params
        var argTemps = emptyInts()
        var i = 0
        while (i < len(args)) {
            var a = args[i]
            if (a.spread) {
                bad(em, a.span, "spread arguments are not lowered yet")
                return none
            }
            var srcO: Ty? = none
            if (let some(v) = em.srcParamTys.get(fid)) {
                if (i < len(v)) {
                    srcO = v[i]
                }
            }
            var isRef = false
            if (let some(sr) = srcO) {
                match (sr) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
            var t = -1
            if (let some(tv) = borrowArg(em, srcO, a)) {
                t = tv
            } else {
                return none
            }
            var fparamIsPtr = false
            if (i < len(fparams)) {
                if (irTyTag(fparams[i].ty) == irTyTag(IrTy.Ptr)) {
                    fparamIsPtr = true
                }
            }
            var finalT = t
            if (!isRef && fparamIsPtr) {
                var vt = Ty.Unknown
                if (let some(gt) = tyOf(em, a.value.span)) {
                    vt = gt
                }
                if (let some(w) = optionWrap(em, t, vt, a.value.span)) {
                    finalT = w
                } else {
                    return none
                }
            }
            argTemps.push(finalT)
            i = i + 1
        }
        var dst = temp(em)
        instr(em, IrInstr.Call(dst, Callee.Func(fid), argTemps))
        guardPropagation(em, fid)
        dst
    }

    /// Create the concrete instantiation of a generic function over `map`
    /// (generic parameter -> concrete type), registering its signature under
    /// `key`, and return its function id. Later calls with the same key reuse
    /// the existing function. Mirrors `instantiate_generic_fn` in emit.rs.

    /// A closure-valued callee: evaluate it, check its `fn` signature, then
    /// dispatch indirectly. Mirrors `fn_value_call` in emit.rs.
fn fnValueCall(em: Emitter, e: Expr, callee: Expr, args: List<CallArg>) -> int? {
        var fnty = Ty.Unknown
        if (let some(t) = tyOf(em, callee.span)) {
            fnty = t
        }
        var isFn = false
        match (fnty) {
            case Ty.Fn(_, _) -> isFn = true
            case _ -> {}
        }
        if (!isFn) {
            bad(em, callee.span, "function-valued call has no signature")
            return none
        }
        var obj = 0
        if (let some(o) = expr(em, callee)) {
            obj = o
        } else {
            return none
        }
        fnValueCallFrom(em, e, obj, fnty, args)
    }

    /// Core dynamic dispatch for a closure-valued callee whose object was
    /// already evaluated (`fv`) together with its `fn` type: load the hoisted
    /// body address out of closure slot 0 and call it indirectly with the
    /// closure object first, then the real arguments. Mirrors
    /// `fn_value_call_from` in emit.rs.
fn fnValueCallFrom(em: Emitter, e: Expr, fv: int, fty: Ty, args: List<CallArg>) -> int? {
        var pty = emptyTys()
        var prt = Ty.None
        var isFn = false
        match (fty) {
            case Ty.Fn(pts, r) -> {
                pty = pts
                prt = r
                isFn = true
            }
            case _ -> {}
        }
        if (!isFn) {
            bad(em, e.span, "function-valued call has no signature")
            return none
        }
        var zero = intConst(em, 0)
        var addrBoxed = externCallT1(em, "pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [fv, zero])
        var fnAddr = externCallT1(em, "pickle_unbox_i64", [IrTy.Ptr], IrTy.Int, [addrBoxed])
        var irParams = [IrTy.Ptr]
        var iargs = [fv]
        var i = 0
        while (i < len(args)) {
            var a = args[i]
            if (a.spread) {
                bad(em, a.span, "spread arguments are not lowered yet")
                return none
            }
            var src: Ty? = none
            if (i < len(pty)) {
                src = pty[i]
            }
            var isRef = false
            if (let some(st) = src) {
                match (st) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
            var t = 0
            var bt = borrowArg(em, src, a)
            if (let some(tv) = bt) {
                t = tv
            } else {
                return none
            }
            var mapsPtr = false
            if (let some(st) = src) {
                var mir = mapTy(em, st, a.span)
                if (let some(ir) = mir) {
                    if (irTyTag(ir) == irTyTag(IrTy.Ptr)) {
                        mapsPtr = true
                    }
                }
            }
            if (!isRef && mapsPtr) {
                var vt = Ty.Unknown
                if (let some(v) = tyOf(em, a.value.span)) {
                    vt = v
                }
                var tw = optionWrap(em, t, vt, a.value.span)
                if (let some(twc) = tw) {
                    t = twc
                } else {
                    return none
                }
            }
            var ir = IrTy.Ptr
            if (let some(st) = src) {
                var mir = mapTy(em, st, a.span)
                if (let some(ir2) = mir) {
                    ir = ir2
                }
            }
            irParams.push(ir)
            iargs.push(t)
            i = i + 1
        }
        var irRet = IrTy.Unit
        var mret = mapTy(em, prt, e.span)
        if (let some(ir) = mret) {
            irRet = ir
        }
        var dst = temp(em)
        instr(em, IrInstr.CallInd(dst, fnAddr, irParams, irRet, iargs))
        dst
    }

    /// A closure object holding `fid`'s code address (boxed) in slot 0 and the
    /// given captures (boxed like list elements) in slots 1..N; the slot layout
    /// must match the hoisted body's reads. Mirrors `closure_obj` in emit.rs.

    /// Lower a lambda expression to a closure object whose slot 0 holds the
    /// address of its pre-registered hoisted body. A lambda inside a generic
    /// function body registers a per-instantiation copy under that enclosing
    /// function id (substituting the instantiation into the signature,
    /// captures, and return type). Mirrors `lambda_value` in emit.rs.

    /// A top-level function referenced as a value: wrap its forwarder trampoline
    /// (not the function itself) in a zero-capture closure object, so the
    /// dynamic-call convention -- closure object first, then the real
    /// arguments -- applies to module functions exactly as to hoisted lambda
    /// bodies. Mirrors `fn_value_closure` in emit.rs.

    /// When a call argument is a *generic user function* given bare (no type
    /// arguments) and the expected parameter type is `fn`, infer the function's
    /// type arguments from that fn type and materialize the concrete
    /// instantiation as a value. `some(t)` means materialized; `none` lets the
    /// regular argument path handle it (a `funcs_by_name` member, or the clean
    /// "as a value is not lowered yet" diagnostic). Mirrors
    /// `generic_fn_arg_value` in emit.rs.

    /// An instance method bound to a receiver, used as a value: a one-capture
    /// closure object whose slot 0 is the method trampoline and whose slot 1 is
    /// the receiver object, so `fn_value_call` dispatches through it exactly
    /// like a lambda capture. Mirrors `bound_method_value` in emit.rs.
fn boundMethodValue(em: Emitter, e: Expr, object: Expr) -> int? {
        var tramp = 0
        var tg = em.fnTramp.get(spanKey(e.span))
        if (let some(t) = tg) {
            tramp = t
        } else {
            bad(em, e.span, "bound method was not registered for dynamic dispatch")
            return none
        }
        var cid = 0
        if (let some(c) = registerClosureClass(em, 1, e.span)) {
            cid = c
        } else {
            return none
        }
        var cidT = intConst(em, cid)
        var nT = intConst(em, 2)
        var obj = externCallT1(em, "pickle_class_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [cidT, nT])
        var addr = temp(em)
        instr(em, IrInstr.Const(addr, IrConst.FuncAddr(tramp)))
        var boxed = externCallT1(em, "pickle_box_i64", [IrTy.Int], IrTy.Ptr, [addr])
        var zero = intConst(em, 0)
        externCallVoid(em, "pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, zero, boxed])
        var recv = 0
        if (let some(r) = expr(em, object)) {
            recv = r
        } else {
            return none
        }
        var recvTy = Ty.Unknown
        if (let some(t) = tyOf(em, object.span)) {
            recvTy = t
        }
        var packed = 0
        var pf = packForPointerBoundary(em, ElemRep.ptr(), recv, recvTy, e.span)
        if (let some(p) = pf) {
            packed = p
        } else {
            return none
        }
        var one = intConst(em, 1)
        externCallVoid(em, "pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, one, packed])
        obj
    }

    // ---- literals: tuple / array / map ----

    /// `(a, b, c)` tuple literal: allocate a tuple and set each field, boxing
    /// scalars. Mirrors `tuple_literal` in emit.rs.
fn tupleLiteral(em: Emitter, e: Expr, items: List<Expr>) -> int? {
        var tys = emptyTys()
        var isTuple = false
        if (let some(t) = tyOf(em, e.span)) {
            match (t) {
                case Ty.Tuple(parts) -> {
                    tys = parts
                    isTuple = true
                }
                case _ -> {}
            }
        }
        if (!isTuple) {
            bad(em, e.span, "tuple literal does not have a `Tuple` type")
            return none
        }
        if (len(items) == 0) {
            bad(em, e.span, "empty tuple values are not lowered yet")
            return none
        }
        if (len(tys) != len(items)) {
            bad(em, e.span, "tuple literal element/type count mismatch")
            return none
        }
        var nn = intConst(em, len(items))
        var tv = externCallT1(em, "pickle_tuple_new", [IrTy.Int], IrTy.Ptr, [nn])
        var i = 0
        for (it in items) {
            var v = expr(em, it)
            if (let some(v) = v) {
                var rp = elemRep(em, tys[i], e.span)
                if (let some(rep) = rp) {
                    var storeV = v
                    if (!(rep.isPtr)) {
                        var vTy = irty(em, it.span)
                        if (let some(vTy) = vTy) {
                            storeV = externCallT1(em, rep.boxSym, [vTy], IrTy.Ptr, [v])
                        } else {
                            return none
                        }
                    }
                    var idx = intConst(em, i)
                    externCallVoid(em, "pickle_tuple_set_field", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [tv, idx, storeV])
                } else {
                    return none
                }
            } else {
                return none
            }
            i = i + 1
        }
        tv
    }

    /// `[a, b, c]` array literal: build a `List` by pushing each element,
    /// boxing scalars. Mirrors `array_literal`.
fn arrayLiteral(em: Emitter, e: Expr, items: List<Expr>) -> int? {
        var elemTy = Ty.Unknown
        var isList = false
        if (let some(t) = tyOf(em, e.span)) {
            match (t) {
                case Ty.List(inner) -> {
                    elemTy = inner
                    isList = true
                }
                case _ -> {}
            }
        }
        if (!isList) {
            bad(em, e.span, "array literal does not have a `List` type")
            return none
        }
        if (len(items) == 0) {
            bad(em, e.span, "empty array literal cannot be typed; add an element to infer `List<T>`")
            return none
        }
        var rp = elemRep(em, elemTy, e.span)
        if (let some(rep) = rp) {
            var cap = intConst(em, len(items))
            var list = externCallT1(em, "pickle_list_new", [IrTy.Int], IrTy.Ptr, [cap])
            for (it in items) {
                var v = expr(em, it)
                if (let some(v) = v) {
                    var pushV = v
                    if (!(rep.isPtr)) {
                        var vTy = irty(em, it.span)
                        if (let some(vTy) = vTy) {
                            pushV = externCallT1(em, rep.boxSym, [vTy], IrTy.Ptr, [v])
                        } else {
                            return none
                        }
                    }
                    externCallVoid(em, "pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [list, pushV])
                } else {
                    return none
                }
            }
            return list
        }
        none
    }

    /// `{ "k": v, ... }` map literal: build a `Map` by inserting each entry,
    /// boxing scalar values and scalar keys. Mirrors `map_literal`.
fn mapLiteral(em: Emitter, e: Expr, entries: List<MapEntry>) -> int? {
        var kty = Ty.Unknown
        var vty = Ty.Unknown
        var isMap = false
        if (let some(t) = tyOf(em, e.span)) {
            match (t) {
                case Ty.Map(k, v) -> {
                    kty = k
                    vty = v
                    isMap = true
                }
                case _ -> {}
            }
        }
        if (!isMap) {
            bad(em, e.span, "map literal does not have a `Map` type")
            return none
        }
        var kp = keyRep(em, kty, e.span)
        var vp = elemRep(em, vty, e.span)
        if (let some(krep) = kp) {
            if (let some(vrep) = vp) {
                var cap = intConst(em, 0)
                var mp = externCallT1(em, "pickle_map_new", [IrTy.Int], IrTy.Ptr, [cap])
for (entry in entries) {
                    var k = expr(em, entry.key)
                    if (let some(k) = k) {
                        var kTy = kty
                        var kTyO = tyOf(em, entry.key.span)
                        if (let some(t) = kTyO) {
                            kTy = t
                        }
                        var keyO = packMapKey(em, krep, k, kTy, entry.key.span)
                        if (let some(key) = keyO) {
                            var vt = expr(em, entry.value)
                                if (let some(vt) = vt) {
                                    var boxed = vt
                                    if (!(vrep.isPtr)) {
                                        var vTy = irty(em, entry.value.span)
                                        if (let some(vTy) = vTy) {
                                            boxed = externCallT1(em, vrep.boxSym, [vTy], IrTy.Ptr, [vt])
                                        } else {
                                            return none
                                        }
                                    }
                                    externCallVoid(em, "pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [mp, key, boxed])
} else {
                                    return none
                                }
                            } else {
                                return none
                            }
                    } else {
                        return none
                    }
                }
                return mp
            }
            return none
        }
        none
    }

/// Box a scalar so it can be stored in a List/Map, or pass a pointer type
    /// through untouched. Mirrors `box_for_store`.

    /// The `key` operand for a map op. Scalar keys are boxed; `Ptr` keys
    /// (option/tuple/composite/string) pass through as the managed pointer,
    /// except a raw scalar operand that must be lifted to its canonical
    /// `Option<T>` pointer form first (e.g. `m[5]` on a `Map<int?, V>`).
    /// Mirrors `pack_map_key` in emit.rs.

    // ---- indexes ----

    /// `a[i]` reads: `Map<K, V>`, `&Map`, scalar `&T`/`T&` raw loads, `List<T>`
    /// and `&List`, and `String`. Mirrors `index_read`/`map_index_read`.
fn indexRead(em: Emitter, e: Expr, object: Expr, index: Expr) -> int? {
        if (let some(t) = tyOf(em, object.span)) {
            match (t) {
                case Ty.Map(k, v) -> {
                    return mapIndexRead(em, e, object, index, k, v)
                }
                case _ -> {}
            }
        }
        if (let some(t) = tyOf(em, object.span)) {
            match (t) {
                case Ty.Ref(iner) -> {
                    match (iner) {
                        case Ty.Map(k, v) -> {
                        return mapIndexRead(em, e, object, index, k, v)
                    }
                        case _ -> {}
                    }
                }
                case _ -> {}
            }
        }
        var elemTy = Ty.Unknown
        var didList = false
        var ot = tyOf(em, object.span)
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Ptr(iner) -> {
                    if (let some(el) = scalarIr(iner)) {
                        var base = expr(em, object)
                        if (let some(base) = base) {
                            var idx = expr(em, index)
                            if (let some(idx) = idx) {
                                var addr = ptrElementAddr(em, base, idx, el, e.span)
                                if (let some(addr) = addr) {
                                    var dst = temp(em)
                                    instr(em, IrInstr.LoadRaw(dst, addr, el))
                                    return dst
                                }
                                return none
                            }
                            return none
                        }
                        return none
                    }
                }
                case Ty.Ref(iner) -> {
                    if (let some(el) = scalarIr(iner)) {
                        var base = expr(em, object)
                        if (let some(base) = base) {
                            var idx = expr(em, index)
                            if (let some(idx) = idx) {
                                var addr = ptrElementAddr(em, base, idx, el, e.span)
                                if (let some(addr) = addr) {
                                    var dst = temp(em)
                                    instr(em, IrInstr.LoadRaw(dst, addr, el))
                                    return dst
                                }
                                return none
                            }
                            return none
                        }
                        return none
                    }
                }
                case Ty.List(iner) -> {
                    elemTy = iner
                    didList = true
                }
                case Ty.String -> {
                    var obj = expr(em, object)
                    if (let some(obj) = obj) {
                        var idx = expr(em, index)
                        if (let some(idx) = idx) {
                            return externCallT1(em, "pickle_str_get", [IrTy.Ptr, IrTy.Int], IrTy.Int, [obj, idx])
                        }
                        return none
                    }
                    return none
                }
                case _ -> {}
            }
        }
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Ref(iner) -> {
                    match (iner) {
                        case Ty.List(el) -> {
                            elemTy = el
                            didList = true
                        }
                        case Ty.String -> {
                            var obj = expr(em, object)
                            if (let some(obj) = obj) {
                                var idx = expr(em, index)
                                if (let some(idx) = idx) {
                                    return externCallT1(em, "pickle_str_get", [IrTy.Ptr, IrTy.Int], IrTy.Int, [obj, idx])
                                }
                                return none
                            }
                            return none
                        }
                        case _ -> {}
                    }
                }
                case _ -> {}
            }
        }
        if (!didList) {
            bad(em, e.span, "indexing this type is not lowered yet")
            return none
        }
        var rp = elemRep(em, elemTy, e.span)
        if (let some(rep) = rp) {
            var obj = expr(em, object)
            if (let some(obj) = obj) {
                var idx = expr(em, index)
                if (let some(idx) = idx) {
                    var raw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idx])
                    if (rep.isPtr) {
                        return raw
                    }
                    return externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
                }
                return none
            }
            return none
        }
        none
    }

    /// `m[k]` read for a `Map<K, V>` / scalar-keyed map. Absent keys yield the
    /// value type's default via the runtime's boxed get. Mirrors
    /// `map_index_read`.
fn mapIndexRead(em: Emitter, e: Expr, object: Expr, index: Expr, kty: Ty, vty: Ty) -> int? {
        var kp = keyRep(em, kty, index.span)
        var vp = elemRep(em, vty, e.span)
        if (let some(krep) = kp) {
            if (let some(vrep) = vp) {
var obj = expr(em, object)
                if (let some(obj) = obj) {
                    var k = expr(em, index)
                    if (let some(k) = k) {
                        var kTy = kty
                        var kTyO = tyOf(em, index.span)
                        if (let some(t) = kTyO) {
                            kTy = t
                        }
                        var keyO = packMapKey(em, krep, k, kTy, index.span)
                        if (let some(key) = keyO) {
                                var defaultVal = 0
                                var haveDefault = false
                                if (!(vrep.isPtr)) {
                                    var zero = zeroScalar(em, vrep.ir, index.span)
                                    if (let some(zero) = zero) {
                                        defaultVal = externCallT1(em, vrep.boxSym, [vrep.ir], IrTy.Ptr, [zero])
                                        haveDefault = true
                                    } else {
                                        return none
                                    }
                                } else if (vty == Ty.String) {
                                    var sl = stringLiteral(em, emptyStrParts())
                                    if (let some(sl) = sl) {
                                        defaultVal = sl
                                        haveDefault = true
                                    } else {
                                        return none
                                    }
                                } else {
                                    var nul = nullTemp(em)
                                    if (let some(nul) = nul) {
                                        defaultVal = externCallT1(em, "pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, nul])
                                        haveDefault = true
                                    } else {
                                        return none
                                    }
                                }
                                if (haveDefault) {
                                    var raw = externCallT1(em, "pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, defaultVal])
                                    if (vrep.isPtr) {
                                        return raw
                                    }
                                    return externCallT1(em, vrep.unboxSym, [IrTy.Ptr], vrep.ir, [raw])
                                }
                                return none
                            }
                            return none
                        }
                        return none
                    }
                    return none
}
                return none
            }
            none
    }

    /// `base + idx * stride` ???????? the address of element `idx` of a raw pointer to
    /// a scalar `element`. Mirrors `ptr_element_addr`.

    // ---- static fields / class consts ----

    /// Read a static field cell: box scalars are unboxed after
    /// `pickle_static_get(cid, slot, v)`. Mirrors `static_read`.

    /// Static-field store: box scalars, then `pickle_static_set(cid, slot, v)`.

    /// Inline a class constant's initializer at a use site. Returns `none`
    /// when `name` is not a constant of class `cid` (or an ancestor). Mirrors
    /// `read_class_const`.
fn readClassConst(em: Emitter, span: Span, cid: int, name: string) -> int? {
        var plan: ClassPlan? = none
        for (p in em.classes) {
            if (p.classId == cid) {
                plan = p
                break
            }
        }
        if (let none = plan) {
            return none
        }
        var pname = ""
        if (let some(p) = plan) {
            pname = p.name
        }
        var chain = ancestry(em, pname)
        var ci = len(chain)
        while (ci >= 1) {
            ci = ci - 1
            var cn = chain[ci]
            var dcO = em.classByName.get(cn)
            if (let some(dc) = dcO) {
                var k = pairKey(str(dc), name)
                if (em.classConsts.has(k)) {
                    var key = classOfName(em, dc) + "." + name
                    if (strListHas(em.constInlining, key)) {
                        bad(em, span, "cyclic `const` initialization of `" + key + "`")
                        return none
                    }
                    em.constInlining.push(key)
                    var savedOwner = em.owner
                    em.owner = dc
                    var ccO = em.classConsts.get(k)
                    if (let some(cc) = ccO) {
                        var tv = expr(em, cc.init)
                        em.owner = savedOwner
                        em.constInlining.pop()
                        return tv
                    }
                    em.owner = savedOwner
                    em.constInlining.pop()
                    return none
                }
            }
        }
        none
    }

    /// Parent-first run of `cname`'s instance fields including inherited ones.
    /// Mirrors `all_instance_fields`.

    /// The `FieldInfo` for instance field slot `idx` of class `cid` (parent-
    /// first layout).

    /// The display name of a registered class id.

    // ---- statements ----

    /// Lower one statement into the current block. `true` on success; hard
    /// errors set `this.failed` through `bad` and return `false`.
fn stmt(em: Emitter, s: Stmt) -> bool {
        if (em.iceDepth > 150) {
            return false
        }
        em.iceDepth = em.iceDepth + 1
        em.icePath.push("stmt")
        var r = stmt1(em, s)
        em.iceDepth = em.iceDepth - 1
        r
    }

fn stmt1(em: Emitter, s: Stmt) -> bool {
        if (!icePoke(em, "stmt1")) {
            return false
        }
        match (s) {
            case Stmt.Let(pattern, ty, init, _mutable, attrs, span) -> {
                var manual = false
                for (a in attrs) {
                    if (a.name == "manualAlloc") {
                        manual = true
                    }
                }
                match (pattern) {
                    case Pattern.Binding(nm, patTy) -> {
                        var annot = ty
                        if (let some(pt) = patTy) {
                            annot = pt
                        }
                        var annOption = false
                        if (let some(at) = annot) {
                            match (at.kind) {
                                case TypeExprKind.Option(_) -> annOption = true
                                case _ -> {}
                            }
                        }
                        var slotTy = IrTy.Ptr
                        if (annOption) {
                            slotTy = IrTy.Ptr
                        } else {
                            if (let some(i) = init) {
                                if (let some(it) = irty(em, i.span)) {
                                    slotTy = it
                                } else {
                                    return false
                                }
                            } else {
                                if (let none = annotTy(em, annot, span)) {
                                    return false
                                }
                                if (let some(at2) = annotTy(em, annot, span)) {
                                    slotTy = at2
                                }
                            }
                        }
                        var slot = newSlot(em, slotTy)
                        if (let some(e) = init) {
                            var t = -1
                            if (let some(tv) = expr(em, e)) {
                                t = tv
                            } else {
                                return false
                            }
                            var v = t
                            if (irTyTag(slotTy) == irTyTag(IrTy.Ptr)) {
                                var vt = Ty.Unknown
                                if (let some(gt) = tyOf(em, e.span)) {
                                    vt = gt
                                }
                                if (let some(w) = optionWrap(em, v, vt, e.span)) {
                                    v = w
                                } else {
                                    return false
                                }
                            }
                            if (manual) {
                                v = externCallT1(em, "pickle_manual_adopt", [IrTy.Ptr], IrTy.Ptr, [v])
                            }
                            instr(em, IrInstr.StoreSlot(slot, v))
                        }
                        declare(em, nm, slot)
                        if (manual) {
                            declareManual(em, nm)
                        }
                        true
                    }
                    case Pattern.Wildcard -> {
                        if (let some(e) = init) {
                            if (let none = expr(em, e)) {
                                return false
                            }
                        }
                        true
                    }
case Pattern.Tuple(_) -> {
                        if (let none = init) {
                            bad(em, span, "destructuring patterns require an initializer")
                            return false
                        }
                        var st = Ty.Unknown
                        if (let some(it) = init) {
                            if (let some(gt) = tyOf(em, it.span)) {
                                st = gt
                            }
                        }
                        if (let some(e) = init) {
                            var v = -1
                            if (let some(t) = expr(em, e)) {
                                v = t
                            } else {
                                return false
                            }
                            if (!(bindMatchValue(em, pattern, st, v, e.span))) {
                                return false
                            }
                        }
                        true
                    }
                    case _ -> {
                        bad(em, span, "destructuring patterns are not lowered yet")
                        false
                    }
                }
            }
            case Stmt.Const(name, _ty, value, _span) -> {
                var t = -1
                if (let some(tv) = expr(em, value)) {
                    t = tv
                } else {
                    return false
                }
                var ty2 = IrTy.Ptr
                if (let some(it) = irty(em, value.span)) {
                    ty2 = it
                } else {
                    return false
                }
                var slot = newSlot(em, ty2)
                var v = t
                if (irTyTag(ty2) == irTyTag(IrTy.Ptr)) {
                    var vt = Ty.Unknown
                    if (let some(gt) = tyOf(em, value.span)) {
                        vt = gt
                    }
                    if (let some(w) = optionWrap(em, v, vt, value.span)) {
                        v = w
                    } else {
                        return false
                    }
                }
                instr(em, IrInstr.StoreSlot(slot, v))
                declare(em, name, slot)
                true
            }
            case Stmt.Return(value, _span) -> {
                var v: int? = none
                if (let some(e) = value) {
                    var t = -1
                    if (let some(tv) = expr(em, e)) {
                        t = tv
                    } else {
                        return false
                    }
                    if (irTyTag(em.fret) == irTyTag(IrTy.Ptr)) {
                        var vt = Ty.Unknown
                        if (let some(gt) = tyOf(em, e.span)) {
                            vt = gt
                        }
                        if (let some(w) = optionWrap(em, t, vt, e.span)) {
                            v = w
                        } else {
                            return false
                        }
                    } else {
                        v = t
                    }
                }
                exitThroughFinallys(em, Exit.Return(v))
                true
            }
            case Stmt.Break(_span) -> {
                if (let none = loopBreakTarget(em)) {
                    badSpanNote(em, "unbalanced `break`")
                    return false
                }
                var target = -1
                if (let some(t) = loopBreakTarget(em)) {
                    target = t
                }
                exitThroughFinallys(em, Exit.Branch(target))
                true
            }
            case Stmt.Continue(_span) -> {
                if (let none = loopContinueTarget(em)) {
                    badSpanNote(em, "unbalanced `continue`")
                    return false
                }
                var target = -1
                if (let some(t) = loopContinueTarget(em)) {
                    target = t
                }
                exitThroughFinallys(em, Exit.Branch(target))
                true
            }
            case Stmt.While(cond, body, span) -> whileStmt(em, cond, body, span)
            case Stmt.For(header, body, span) -> forStmt(em, header, body, span)
            case Stmt.Try(body, binder, handler, fin, span) -> tryStmt(em, body, binder, handler, fin, span, none)
            case Stmt.Throw(value, span) -> throwStmt(em, value, span)
            case Stmt.Expr(e) -> {
                if (let none = expr(em, e)) {
                    return false
                }
                true
            }
            case Stmt.Empty(_span) -> true
        }
    }

    /// `while (cond)` lowering: the `cond` block branches into the body, which
    /// back-edges to `cond`.
fn whileStmt(em: Emitter, cond: Expr, body: Block, span: Span) -> bool {
        let _ = span
        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var c = -1
        if (let some(cv) = expr(em, cond)) {
            c = cv
        } else {
            return false
        }
        term(em, IrTerm.BranchIf(c, bodyId, endId))
        em.cur = bodyId
        pushLoop(em, endId, condId)
        pushScope(em)
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// `for` loops: header initialization, a condition block, a body, and a
    /// step block (`continue` targets the step so it still runs).
fn forStmt(em: Emitter, header: ForHeader, body: Block, span: Span) -> bool {
        match (header) {
            case ForHeader.Range(init, cond, step) -> {
                if (!(stmt(em, init))) {
                    return false
                }
                var condId = newBlock(em)
                var bodyId = newBlock(em)
                var stepId = newBlock(em)
                var endId = newBlock(em)
                term(em, IrTerm.Branch(condId))
                em.cur = condId
                var c = -1
                if (let some(cv) = expr(em, cond)) {
                    c = cv
                } else {
                    return false
                }
                term(em, IrTerm.BranchIf(c, bodyId, endId))
                em.cur = bodyId
                pushLoop(em, endId, stepId)
                pushScope(em)
                if (!(blockBodyOnly(em, body))) {
                    popScope(em)
                    em.loops.pop()
                    return false
                }
                popScope(em)
                em.loops.pop()
                term(em, IrTerm.Branch(stepId))
                em.cur = stepId
                if (let none = expr(em, step)) {
                    return false
                }
                term(em, IrTerm.Branch(condId))
                em.cur = endId
                true
            }
case ForHeader.In(pattern, seq) -> forIn(em, pattern, seq, body, span)
        }
    }

    /// `for (x in seq)` / `for ((k, v) in m)`: dispatch on the sequence type,
    /// mirroring `for_in` in emit.rs. A `List` iterates by index; a `String`
    /// iterates bytes; a `Map` with a `(k, v)` binding iterates map entries
    /// (in lockstep key/value snapshots) and otherwise iterates its values; an
    /// `Iterable<T>` falls back to the protocol loop; integer ranges lower to
    /// an index loop with an inclusive/exclusive bound.
fn forIn(em: Emitter, pattern: Pattern, sequence: Expr, body: Block, span: Span) -> bool {
        var seqOt = forInSeqTy(em, sequence.span)
        if (let some(ot) = seqOt) {
            match (ot) {
                case Ty.Map(k, v) -> {
                    match (pattern) {
                        case Pattern.Tuple(parts) -> {
                            if (!(len(parts) == 2)) {
                                return bad(em, span, "map entries pattern must bind exactly two names `(k, v)`")
                            }
                            var kname = ""
                            match (parts[0]) {
                                case Pattern.Binding(nm, _) -> kname = nm
                                case _ -> {
                                    return bad(em, span, "map entries sub-patterns must be plain names")
                                }
                            }
                            var vname = ""
                            match (parts[1]) {
                                case Pattern.Binding(nm, _) -> vname = nm
                                case _ -> {
                                    return bad(em, span, "map entries sub-patterns must be plain names")
                                }
                            }
                            var mapT = -1
                            if (let some(mt) = expr(em, sequence)) {
                                mapT = mt
                            } else {
                                return false
                            }
                            return forInMapEntries(em, kname, vname, mapT, k, v, body, span)
                        }
                        case _ -> {}
                    }
                }
                case _ -> {}
            }
        }
        var seqOt2 = forInSeqTy(em, sequence.span)
        if (let some(ot) = seqOt2) {
            match (ot) {
                case Ty.String -> {
                    var nm = ""
                    match (pattern) {
                        case Pattern.Binding(nm2, _) -> nm = nm2
                        case _ -> {
                            return bad(em, span, "iteration patterns other than a binding are not lowered yet")
                        }
                    }
                    var seqT = -1
                    if (let some(st) = expr(em, sequence)) {
                        seqT = st
                    } else {
                        return false
                    }
                    return forInString(em, nm, seqT, body)
                }
                case Ty.List(inner) -> {
                    var elemT = inner
                    var seqT = -1
                    if (let some(st) = expr(em, sequence)) {
                        seqT = st
                    } else {
                        return false
                    }
                    return forInValues(em, pattern, seqT, elemT, body, span)
                }
                case Ty.Range(inner) -> {
                    var elemT = inner
                    var seqT = -1
                    if (let some(st) = expr(em, sequence)) {
                        seqT = st
                    } else {
                        return false
                    }
                    return forInValues(em, pattern, seqT, elemT, body, span)
                }
                case Ty.Map(_, v) -> {
                    var isBind = false
                    match (pattern) {
                        case Pattern.Binding(_, _) -> isBind = true
                        case _ -> {}
                    }
                    if (!isBind) {
                        return bad(em, span, "iteration patterns other than a binding are not lowered yet")
                    }
                    var mapT = -1
                    if (let some(mt) = expr(em, sequence)) {
                        mapT = mt
                    } else {
                        return false
                    }
                    var vals = externCallT1(em, "pickle_map_values", [IrTy.Ptr], IrTy.Ptr, [mapT])
                    return forInValues(em, pattern, vals, v, body, span)
                }
                case _ -> {}
            }
        }
        var iterElemTy = Ty.Unknown
        if (let some(ot) = seqOt2) {
            iterElemTy = ot
        }
        if (let some(el) = iterableElem(em, iterElemTy)) {
            var seqT = -1
            if (let some(st) = expr(em, sequence)) {
                seqT = st
            } else {
                return false
            }
            return forInProtocol(em, pattern, el, seqT, body, span)
        }
        var start: Expr? = none
        var end: Expr? = none
        var incl = false
        var isRange = false
        match (sequence.kind) {
            case ExprKind.Binary(op, lhs, rhs) -> {
                if (op == BinOp.Range) {
                    start = lhs
                    end = rhs
                    isRange = true
                }
                if (op == BinOp.RangeIncl) {
                    start = lhs
                    end = rhs
                    incl = true
                    isRange = true
                }
            }
            case _ -> {}
        }
        if (!isRange) {
            return bad(em, sequence.span, "`for (x in ...)` over non-range, non-list sequences is not lowered yet")
        }
        if (let none = start) {
            return bad(em, sequence.span, "`for (x in ...)` over non-range, non-list sequences is not lowered yet")
        }
        if (let none = end) {
            return bad(em, sequence.span, "`for (x in ...)` over non-range, non-list sequences is not lowered yet")
        }
        var startE: Expr? = start
        var endE: Expr? = end
        if (let some(s) = startE) {
            if (!(ensureInt(em, s))) {
                return false
            }
        }
        if (let some(e) = endE) {
            if (!(ensureInt(em, e))) {
                return false
            }
        }
        var startT = -1
        var endT = -1
        if (let some(s) = startE) {
            if (let some(st) = expr(em, s)) {
                startT = st
            } else {
                return false
            }
        }
        if (let some(e) = endE) {
            if (let some(et) = expr(em, e)) {
                endT = et
            } else {
                return false
            }
        }
        var idx = newSlot(em, IrTy.Int)
        var endSlot = newSlot(em, IrTy.Int)
        instr(em, IrInstr.StoreSlot(idx, startT))
        instr(em, IrInstr.StoreSlot(endSlot, endT))

        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var nextId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var curT = load(em, idx)
        var endL = load(em, endSlot)
        var cmpOp = IrBinOp.Lt
        if (incl) {
            cmpOp = IrBinOp.Le
        }
        var cmp = temp(em)
        instr(em, IrInstr.BinOp(cmp, cmpOp, curT, endL))
        term(em, IrTerm.BranchIf(cmp, bodyId, endId))
        em.cur = bodyId
        pushLoop(em, endId, nextId)
        pushScope(em)
        var nm2 = ""
        match (pattern) {
            case Pattern.Binding(nm3, _) -> nm2 = nm3
            case _ -> {
                return bad(em, span, "iteration patterns other than a binding are not lowered yet")
            }
        }
        declare(em, nm2, idx)
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(nextId))
        em.cur = nextId
        var c = load(em, idx)
        var one = temp(em)
        instr(em, IrInstr.Const(one, IrConst.Int(1)))
        var nxt = temp(em)
        instr(em, IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        instr(em, IrInstr.StoreSlot(idx, nxt))
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// `ty_of(span)`, unwrapping a `&T` reference so a `for` over a reference
    /// iterates the referenced sequence. Mirrors the `Ty::Ref` unwrap at the
    /// top of `for_in` in emit.rs.

    /// `for (x in seq)` over a sequence value: by-index iteration over a
    /// managed list pointer, unboxing scalar elements per trip as
    /// `for_in_values` does.
fn forInValues(em: Emitter, pattern: Pattern, seqT: int, elem: Ty, body: Block, span: Span) -> bool {
        var rp = elemRep(em, elem, span)
        if (let none = rp) {
            return false
        }
        var rep = ElemRep.ptr()
        if (let some(r) = rp) {
            rep = r
        }
        var elemIrTy = elemIr(elem)
        var seqSlot = newSlot(em, IrTy.Ptr)
        var idxSlot = newSlot(em, IrTy.Int)
        var lenSlot = newSlot(em, IrTy.Int)
        instr(em, IrInstr.StoreSlot(seqSlot, seqT))
        var zero = temp(em)
        instr(em, IrInstr.Const(zero, IrConst.Int(0)))
        instr(em, IrInstr.StoreSlot(idxSlot, zero))
        var seqL = load(em, seqSlot)
        var lenT = externCallT1(em, "pickle_list_len", [IrTy.Ptr], IrTy.Int, [seqL])
        instr(em, IrInstr.StoreSlot(lenSlot, lenT))

        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var nextId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var curT = load(em, idxSlot)
        var endL = load(em, lenSlot)
        var cmp = temp(em)
        instr(em, IrInstr.BinOp(cmp, IrBinOp.Lt, curT, endL))
        term(em, IrTerm.BranchIf(cmp, bodyId, endId))
        em.cur = bodyId
        pushLoop(em, endId, nextId)
        pushScope(em)
        var curI = load(em, idxSlot)
        var seqL2 = load(em, seqSlot)
        var raw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [seqL2, curI])
        var v = raw
        if (!(rep.isPtr)) {
            v = externCallT1(em, rep.unboxSym, [IrTy.Ptr], elemIrTy, [raw])
        }
        var elemSlot = newSlot(em, elemIrTy)
        instr(em, IrInstr.StoreSlot(elemSlot, v))
        match (pattern) {
            case Pattern.Binding(nm, _) -> declare(em, nm, elemSlot)
            case Pattern.Tuple(_) -> {
                var ev = load(em, elemSlot)
                if (!(bindMatchValue(em, pattern, elem, ev, span))) {
                    popScope(em)
                    em.loops.pop()
                    return false
                }
            }
            case _ -> {
                popScope(em)
                em.loops.pop()
                return bad(em, span, "iteration patterns other than a binding or tuple are not lowered yet")
            }
        }
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(nextId))
        em.cur = nextId
        var c = load(em, idxSlot)
        var one = temp(em)
        instr(em, IrInstr.Const(one, IrConst.Int(1)))
        var nxt = temp(em)
        instr(em, IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        instr(em, IrInstr.StoreSlot(idxSlot, nxt))
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// `for ((k, v) in m)`: bind key and value per trip from lockstep
    /// `pickle_map_keys` / `pickle_map_values` snapshots, unboxing keys and
    /// values per their `ElemRep`. Mirrors `for_in_map_entries` in emit.rs.
fn forInMapEntries(em: Emitter, kname: string, vname: string, mapT: int, kty: Ty, vty: Ty, body: Block, span: Span) -> bool {
        var vrpo = elemRep(em, vty, span)
        if (let none = vrpo) {
            return false
        }
        var vrep = ElemRep.ptr()
        if (let some(r) = vrpo) {
            vrep = r
        }
        var vIr = elemIr(vty)
        var krpo = keyRep(em, kty, span)
        if (let none = krpo) {
            return false
        }
        var krep = ElemRep.ptr()
        if (let some(r) = krpo) {
            krep = r
        }
        var kIr = krep.ir
        if (krep.isPtr) {
            kIr = IrTy.Ptr
        }
        var mapSlot = newSlot(em, IrTy.Ptr)
        var keysSlot = newSlot(em, IrTy.Ptr)
        var valsSlot = newSlot(em, IrTy.Ptr)
        var idxSlot = newSlot(em, IrTy.Int)
        var lenSlot = newSlot(em, IrTy.Int)
        instr(em, IrInstr.StoreSlot(mapSlot, mapT))
        var mapL = load(em, mapSlot)
        var keysT = externCallT1(em, "pickle_map_keys", [IrTy.Ptr], IrTy.Ptr, [mapL])
        var valsT = externCallT1(em, "pickle_map_values", [IrTy.Ptr], IrTy.Ptr, [mapL])
        instr(em, IrInstr.StoreSlot(keysSlot, keysT))
        instr(em, IrInstr.StoreSlot(valsSlot, valsT))
        var zero = temp(em)
        instr(em, IrInstr.Const(zero, IrConst.Int(0)))
        instr(em, IrInstr.StoreSlot(idxSlot, zero))
        var keysL = load(em, keysSlot)
        var lenT = externCallT1(em, "pickle_list_len", [IrTy.Ptr], IrTy.Int, [keysL])
        instr(em, IrInstr.StoreSlot(lenSlot, lenT))

        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var nextId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var curT = load(em, idxSlot)
        var endL = load(em, lenSlot)
        var cmp = temp(em)
        instr(em, IrInstr.BinOp(cmp, IrBinOp.Lt, curT, endL))
        term(em, IrTerm.BranchIf(cmp, bodyId, endId))
        em.cur = bodyId
        pushLoop(em, endId, nextId)
        pushScope(em)
        var i = load(em, idxSlot)
        var keysL2 = load(em, keysSlot)
        var valsL2 = load(em, valsSlot)
        var kraw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [keysL2, i])
        var k = kraw
        if (!(krep.isPtr)) {
            k = externCallT1(em, krep.unboxSym, [IrTy.Ptr], kIr, [kraw])
        }
        var kSlot = newSlot(em, kIr)
        instr(em, IrInstr.StoreSlot(kSlot, k))
        declare(em, kname, kSlot)
        var vraw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [valsL2, i])
        var v = vraw
        if (!(vrep.isPtr)) {
            v = externCallT1(em, vrep.unboxSym, [IrTy.Ptr], vIr, [vraw])
        }
        var vSlot = newSlot(em, vIr)
        instr(em, IrInstr.StoreSlot(vSlot, v))
        declare(em, vname, vSlot)
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(nextId))
        em.cur = nextId
        var c = load(em, idxSlot)
        var one = temp(em)
        instr(em, IrInstr.Const(one, IrConst.Int(1)))
        var nxt = temp(em)
        instr(em, IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        instr(em, IrInstr.StoreSlot(idxSlot, nxt))
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// `for (x in s)` over a string: iterates byte indices, binding the raw
    /// 0..=255 byte from `pickle_str_get` as a `byte` (`int` ABI). Mirrors
    /// `for_in_string` in emit.rs.
fn forInString(em: Emitter, name: string, seqT: int, body: Block) -> bool {
        var seqSlot = newSlot(em, IrTy.Ptr)
        var idxSlot = newSlot(em, IrTy.Int)
        var lenSlot = newSlot(em, IrTy.Int)
        instr(em, IrInstr.StoreSlot(seqSlot, seqT))
        var zero = temp(em)
        instr(em, IrInstr.Const(zero, IrConst.Int(0)))
        instr(em, IrInstr.StoreSlot(idxSlot, zero))
        var seqL = load(em, seqSlot)
        var lenT = externCallT1(em, "pickle_str_len", [IrTy.Ptr], IrTy.Int, [seqL])
        instr(em, IrInstr.StoreSlot(lenSlot, lenT))

        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var nextId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var curT = load(em, idxSlot)
        var endL = load(em, lenSlot)
        var cmp = temp(em)
        instr(em, IrInstr.BinOp(cmp, IrBinOp.Lt, curT, endL))
        term(em, IrTerm.BranchIf(cmp, bodyId, endId))
        em.cur = bodyId
        pushLoop(em, endId, nextId)
        pushScope(em)
        var curI = load(em, idxSlot)
        var seqL2 = load(em, seqSlot)
        var v = externCallT1(em, "pickle_str_get", [IrTy.Ptr, IrTy.Int], IrTy.Int, [seqL2, curI])
        var elemSlot = newSlot(em, IrTy.Int)
        instr(em, IrInstr.StoreSlot(elemSlot, v))
        declare(em, name, elemSlot)
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(nextId))
        em.cur = nextId
        var c = load(em, idxSlot)
        var one = temp(em)
        instr(em, IrInstr.Const(one, IrConst.Int(1)))
        var nxt = temp(em)
        instr(em, IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        instr(em, IrInstr.StoreSlot(idxSlot, nxt))
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// `for (x in seq)` over an `Iterable<T>` protocol value: `iterator()` then
    /// `next()`, with `continue` re-testing the option and `break`/completion
    /// leaving the loop. Mirrors `for_in_protocol` in emit.rs.
fn forInProtocol(em: Emitter, pattern: Pattern, elem: Ty, seqT: int, body: Block, span: Span) -> bool {
        if (let none = elemRep(em, elem, span)) {
            return false
        }
        var iterableIft = Ty.Interface("Iterable", [elem])
        var itvO = interfaceZeroArgCall(em, span, iterableIft, seqT, "iterator", IrTy.Ptr)
        if (let none = itvO) {
            return false
        }
        var itv = -1
        if (let some(v) = itvO) {
            itv = v
        }
        var itSlot = newSlot(em, IrTy.Ptr)
        instr(em, IrInstr.StoreSlot(itSlot, itv))

        var iteratorIft = Ty.Interface("Iterator", [elem])
        var elemIrTy = elemIr(elem)
        var optSlot = newSlot(em, IrTy.Ptr)

        var condId = newBlock(em)
        var bodyId = newBlock(em)
        var endId = newBlock(em)
        term(em, IrTerm.Branch(condId))
        em.cur = condId
        var it = load(em, itSlot)
        var nextVO = interfaceZeroArgCall(em, span, iteratorIft, it, "next", IrTy.Ptr)
        if (let none = nextVO) {
            return false
        }
        var nextV = -1
        if (let some(v) = nextVO) {
            nextV = v
        }
        instr(em, IrInstr.StoreSlot(optSlot, nextV))
        var opt = load(em, optSlot)
        var presentO = optIsPresent(em, opt)
        if (let none = presentO) {
            return false
        }
        var present = -1
        if (let some(p) = presentO) {
            present = p
        }
        term(em, IrTerm.BranchIf(present, bodyId, endId))

        em.cur = bodyId
        pushLoop(em, endId, condId)
        pushScope(em)
        var raw = load(em, optSlot)
        var vO = optResolve(em, raw, elem, span)
        if (let none = vO) {
            popScope(em)
            em.loops.pop()
            return false
        }
        var v = -1
        if (let some(x) = vO) {
            v = x
        }
        var elemSlot = newSlot(em, elemIrTy)
        instr(em, IrInstr.StoreSlot(elemSlot, v))
        match (pattern) {
            case Pattern.Binding(nm, _) -> declare(em, nm, elemSlot)
            case Pattern.Tuple(_) -> {
                var ev = load(em, elemSlot)
                if (!(bindMatchValue(em, pattern, elem, ev, span))) {
                    popScope(em)
                    em.loops.pop()
                    return false
                }
            }
            case _ -> {
                popScope(em)
                em.loops.pop()
                return bad(em, span, "iteration patterns other than a binding or tuple are not lowered yet")
            }
        }
        if (!(blockBodyOnly(em, body))) {
            popScope(em)
            em.loops.pop()
            return false
        }
        popScope(em)
        em.loops.pop()
        term(em, IrTerm.Branch(condId))
        em.cur = endId
        true
    }

    /// Emit a block's statements only (loop bodies, where the tail is
    /// discarded).
fn blockBodyOnly(em: Emitter, b: Block) -> bool {
        for (s in b.stmts) {
            if (!(stmt(em, s))) {
                return false
            }
        }
        if (let some(e) = b.expr) {
            if (let none = expr(em, e)) {
                return false
            }
        }
        true
    }

    /// `block_value`: lower a block and produce its value (the tail expression
    /// or a unit temp).
fn blockValue(em: Emitter, b: Block) -> int? {
        for (s in b.stmts) {
            if (!(stmt(em, s))) {
                return none
            }
        }
        if (let some(e) = b.expr) {
            return expr(em, e)
        }
        unitTemp(em)
    }

    /// A `try` is a statement, but the last one in a block is also that block's
    /// value, so it needs a slot to hand the result back in.
    ///
    /// Peek before emitting: on a miss the caller still has to emit the whole
    /// sequence itself, and emitting it twice would duplicate effects. Returns
    /// the slot holding the `try`'s value, having emitted everything.
fn stmtsWithTryTail(em: Emitter, stmts: List<Stmt>, want: IrTy) -> int? {
        if (len(stmts) == 0) {
            return none
        }
        let last = stmts[len(stmts) - 1]
        // Peek before emitting: on a miss the caller still has to emit the whole
        // sequence itself, and emitting it twice would duplicate effects.
        var isTry = false
        match (last) {
            case Stmt.Try(_, _, _, _, _) -> isTry = true
            case _ -> {}
        }
        if (!isTry) {
            return none
        }
        for (i in range(0, len(stmts) - 1)) {
            if (!(stmt(em, stmts[i]))) {
                return none
            }
        }
        let slot = newSlot(em, want)
        var slotOpt: int? = none
        slotOpt = slot
        var ok = false
        match (last) {
            case Stmt.Try(body, binder, handler, fin, span) -> ok = tryStmt(em, body, binder, handler, fin, span, slotOpt)
            case _ -> {}
        }
        if (!ok) {
            return none
        }
        slotOpt
    }

    /// Lower a block, optionally storing its tail into a result slot (used by
    /// `if`/`if let`/match arm values). The tail is lifted when the slot is a
    /// `Ptr` (option-typed result).
fn blockIntoSlot(em: Emitter, b: Block, resSlot: int?) -> bool {
        if (let some(slot) = resSlot) {
            var want = IrTy.Unit
            if (slot < len(em.fslots)) {
                want = em.fslots[slot]
            }
            if (let some(trySlot) = stmtsWithTryTail(em, b.stmts, want)) {
                let t = load(em, trySlot)
                instr(em, IrInstr.StoreSlot(slot, t))
                return true
            }
        } else {
            let noResTry = stmtsWithTryTail(em, b.stmts, IrTy.Unit)
            if (let some(_) = noResTry) {
                return true
            }
        }
        for (s in b.stmts) {
            if (!(stmt(em, s))) {
                return false
            }
        }
        if (let some(e) = b.expr) {
            var t = -1
            if (let some(tv) = expr(em, e)) {
                t = tv
            } else {
                return false
            }
            if (let some(slot) = resSlot) {
                var isPtrSlot = false
                if (slot < len(em.fslots)) {
                    if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                        isPtrSlot = true
                    }
                }
                if (isPtrSlot) {
                    var vt = Ty.Unknown
                    if (let some(gt) = tyOf(em, e.span)) {
                        vt = gt
                    }
                    var w = -1
                    if (let some(wv) = optionWrap(em, t, vt, e.span)) {
                        w = wv
                    } else {
                        return false
                    }
                    instr(em, IrInstr.StoreSlot(slot, w))
                } else {
                    instr(em, IrInstr.StoreSlot(slot, t))
                }
            }
        }
        true
    }

    /// After a block body, close the current block: run statements, then make
    /// the tail expression the return value (or discard it).

    /// Ensure the final block is closed: only unit functions get the trailing
    /// empty `return`; dead value-returning blocks stay `Unreachable`.

    // ---- body builders (incremental port; filled in by later sub-slices) ----

    /// Build the hoisted body of a top-level `fn`/`test`. Mirrors `emit_body`.

    // ---- body builders (incremental port; filled in by later sub-slices) ----

    /// Build the hoisted body of a lambda. The closure object occupies slot 0
    /// (`env`), parameters come at slots 1..=n, then captures are copied out of
    /// the closure after every parameter.

/// Build a spread trampoline: a dynamically-callable forwarder whose
    /// parameters are `(recv?, boxed)` Ã¢â‚¬â€ the receiver when present (slot 0),
    /// then the boxed `List` of the spread elements. The body loads the list,
    /// unboxes one element per target parameter (by that parameter's own
    /// element representation), and calls the target directly, returning its
    /// result. Mirrors `build_spread_trampoline` in emit.rs.

    /// Build a function-value trampoline: `(env, args...) -> ret` calling the
    /// wrapped top-level function.

    /// Build the hidden future body of an `async fn`: a 0-arg hoisted body whose
    /// closure slots 1..N hold each parameter under its own name. The body is
    /// then lowered exactly like a top-level function body, so `return`/`await`
    /// inside it work normally. Mirrors `build_async_body` in emit.rs.

    /// Build the visible wrapper of an `async` method: it has the method's real
    /// ABI (`this` at slot 0 for instance methods, then the parameters, exactly
    /// like `buildMethodBody`) but returns the future Ã¢â‚¬â€ a closure over the
    /// receiver (if any) and the parameters Ã¢â‚¬â€ without running the body.
    /// Mirrors `build_async_method_wrapper` in emit.rs.

    /// Build the hidden future body of an `async` method. The closure slots hold
    /// the receiver (instance methods) then the parameters; the receiver is
    /// re-declared as `this` so the body's receiver-fallback operates exactly as
    /// in a regular method body. Mirrors `build_async_method_body` in emit.rs.

    /// Build a bound-method trampoline: a forwarder with the hoisted-lambda
    /// signature `(env, args...) -> ret` whose closure slot 1 holds the bound
    /// receiver. The body loads that receiver and calls the wrapped instance
    /// method `target` with it first, then returns the result; when `branches`
    /// is non-empty it dispatches on the runtime class first. Mirrors
    /// `build_method_trampoline` in emit.rs.

    /// The nearest explicit-primary-constructor ancestor of `name` (the
    /// deepest class in the chain that declares a primary `constructor`),
    /// together with the absolute end slot of that ancestor's own instance
    /// fields. Classes with only *named* constructors are still synthesized,
    /// so they never count as explicit here. Mirrors
    /// `nearest_explicit_primary_ancestor`.

    /// Total instance-field slot count of `name` including inherited fields.
    /// Mirrors `total_instance_slot_count`.

    /// Parameter metadata for a synthesized constructor of `name`, in
    /// parameter order: the absolute instance-field slot each parameter must
    /// be stored into (`-1` = a leading explicit-ancestor constructor
    /// parameter, forwarded to the chained `super(...)`), plus the nearest
    /// explicit-primary ancestor to chain into and how many leading
    /// parameters that chain consumes. With no explicit-primary ancestor the
    /// whole chain's uninitialized fields become the parameters (one per
    /// field slot) and nothing is chained. Mirrors
    /// `synthesized_ctor_param_meta`.

    /// Run a constructor `Block` whose tail expression is NOT the function's
    /// return value (used for constructor bodies and `init` blocks, where the
