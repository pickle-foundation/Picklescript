                }
                var lo = -1
                if (let some(lv) = expr(em, args[1].value)) {
                    lo = lv
                } else {
                    return none
                }
                var hi = -1
                if (let some(hv) = expr(em, args[2].value)) {
                    hi = hv
                } else {
                    return none
                }
                var maxCond = temp(em)
                instr(em, IrInstr.BinOp(maxCond, IrBinOp.Gt, x, lo))
                var mid = newSlot(em, it)
                var takeX = newBlock(em)
                var takeLo = newBlock(em)
                var maxJoin = newBlock(em)
                term(em, IrTerm.BranchIf(maxCond, takeX, takeLo))
                em.cur = takeX
                instr(em, IrInstr.StoreSlot(mid, x))
                term(em, IrTerm.Branch(maxJoin))
                em.cur = takeLo
                instr(em, IrInstr.StoreSlot(mid, lo))
                term(em, IrTerm.Branch(maxJoin))
                em.cur = maxJoin
                var maxv = load(em, mid)
                var minCond = temp(em)
                instr(em, IrInstr.BinOp(minCond, IrBinOp.Lt, maxv, hi))
                var resSlot = newSlot(em, it)
                var takeMax = newBlock(em)
                var takeHi = newBlock(em)
                var join = newBlock(em)
                term(em, IrTerm.BranchIf(minCond, takeMax, takeHi))
                em.cur = takeMax
                instr(em, IrInstr.StoreSlot(resSlot, maxv))
                term(em, IrTerm.Branch(join))
                em.cur = takeHi
                instr(em, IrInstr.StoreSlot(resSlot, hi))
                term(em, IrTerm.Branch(join))
                em.cur = join
                return load(em, resSlot)
            }
            case "str" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`str(x)` takes exactly one argument")
                    return none
                }
                var namedS = false
                if (let some(_) = args[0].name) {
                    namedS = true
                }
                if (namedS || args[0].spread) {
                    bad(em, e.span, "`str(x)` takes exactly one argument")
                    return none
                }
                var v = -1
                if (let some(vv) = expr(em, args[0].value)) {
                    v = vv
                } else {
                    return none
                }
                var isByteList = false
                if (let some(gt) = tyOf(em, args[0].value.span)) {
                    match (gt) {
                        case Ty.List(inner) -> {
                            match (inner) {
                                case Ty.Byte -> isByteList = true
                                case _ -> {}
