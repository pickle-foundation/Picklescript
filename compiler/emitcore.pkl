// PickleScript compiler: the lowering core.
// Every former `class Emitter` method as a free fn over the emitter value.
// Family modules (emitmatch, emitspread, ...) are carved out of this file
// bottom-up in later batches; call style is already fn(em, ...) everywhere.
module compiler.emitcore

import * from compiler.ast
import { Span, Diagnostic, DiagnosticSink } from compiler.diag
import { IrBlock, IrFunc, IrGlobal, IrModule, IrParam, IrTy, emptyIrBlocks, emptyIrGlobals, emptyIrParams, emptyIrTys, emptyModule, irTyStr, irxParseFloat } from compiler.ir
import { CallableInfo, ClassTable, CtorInfo, entryGenerics, EnumTable, FieldInfo, ParamInfo, PropertyInfo, ResolvedProgram, TypeTableEntry } from compiler.resolvebag

import { collectExprTypes } from compiler.checkcore
import { containsStr, isNoneStr, spanKey } from compiler.checkutil
import * from compiler.ty
import { f64ToBits } from compiler.x64
import * from compiler.emitutil

import { Emitter } from compiler.emittypes
import * from compiler.emitprim
import * from compiler.emitreadsglobal
import * from compiler.emitleaf
import * from compiler.emitleaf2


    /// Record the initializer of a top-level `const`. Void so the arm of the
    /// registration match stays unit-typed.

   /// Allocate global ids in source order and push one `IrGlobal` per top-level
   /// `var`. Globals have no body, so this only has to validate the type and
   /// reduce the initializer; failures are recorded and reported once every
   /// body is built, so one bad global does not mask unrelated problems.
   ///
   /// `resolved.globals` is already in source order and carries the resolved
   /// type; `globalDecls` supplies the initializer expression, which the
   /// resolver deliberately does not keep (it is not part of the type surface).

    /// Register functions, classes, structs, and enums in source order, and
    /// then build all their bodies. Mirrors `Emitter::emit()` in emit.rs.

    /// Lower every registered function body, including any registered lazily by
    /// an earlier one.

    // ---- registration ----

    /// Record one instance/static method definition, first-wins (mirrors the
    /// `or_insert` used for `method_ids` in Rust), and append the walked method
    /// table so `build_virtual_dispatch` can iterate every receiver entry.

    /// Register a top-level function (or test) that has an unambiguous user
    /// callable and fully low-level parameter/return types. Mirrors
    /// `register_fn` in emit.rs.

    /// Register an `async fn` as two lowerable functions:
    ///
    ///   * the hidden future body Ã¢â‚¬â€ a 0-arg hoisted body with the lambda ABI
    ///     (`env` = closure object), whose closure slots 1..N snapshot each of
    ///     the async fn's parameters under its own name; and
    ///   * the visible wrapper Ã¢â‚¬â€ a normal module function with the async fn's
    ///     real ABI that allocates that closure and returns it. Calling it runs
    ///     no user code; the body runs only when `await` drives the future's
    ///     0-arg call.
    ///
    /// The hidden entry is registered first so the wrapper can name it.
    /// Mirrors `register_async_fn` in emit.rs.

    /// Register an `async` method as two lowerable functions, mirroring
    /// `register_async_fn` for methods:
    ///
    ///   * the hidden future body, whose closure slots hold the receiver
    ///     (`this`, instance methods) followed by the parameters; and
    ///   * the visible wrapper Ã¢â‚¬â€ the method itself Ã¢â‚¬â€ with the method's real ABI
    ///     (receiver-first for instance methods), allocating that closure and
    ///     returning it. `methodIds` maps the method name to the wrapper, so
    ///     instance/static calls and (via inheritance + virtual dispatch)
    ///     overrides dispatch exactly like regular methods.
    ///
    /// `thisTy` is the instantiated receiver type (`None` for static), `suffix`
    /// disambiguates generic-class instantiation symbols, and `map` carries the
    /// substitution when the receiver class is a generic instantiation.
    /// Mirrors `register_async_method` in emit.rs.


    /// Register a class and, first, its ancestors, so a superclass always has a
    /// lower class id than its subclasses. Mirrors `register_class_by_name`.

    /// The resolver's `ClassTable` for a class name (classes only, not
    /// structs ???????? the caller has already looked the decl up).

    /// Register a struct (structs have no inheritance, so no ancestor walk).
    /// Mirrors `register_struct_item` in emit.rs.

    /// Build the class/struct table for `name` from the resolver, or from the
    /// emitter's own tables for synthetic/generic plans. Mirrors `table_of`.

    /// The superclass name of `name`, when it extends another class.

    /// Ancestry from the rootmost superclass down to `name` inclusive.

    /// True when `anc` is `desc` itself or one of its ancestors.




    /// Discover every instance method overridden somewhere in the program and
    /// record, per static receiver class, the descendant classes that provide a
    /// different implementation (deepest-derived first). Mirrors
    /// `build_virtual_dispatch` in emit.rs.

    /// Record one property-accessor definition (instanced), first-wins, and
    /// append it to the walked table so superclass slots can be inherited.

    /// Record one static property-accessor definition, first-wins, and append
    /// it to the walked table.

    /// A class/struct's own (non-inherited) instance fields.


    /// Instance-field initializers for `name` and its ancestors, root first,
    /// recorded at absolute slot numbers.

    /// `init` blocks for `name` and its ancestors, root first.

    /// Resolve an interface instantiation `name<args>` to its runtime id,
    /// assigning a fresh one on first use and recording its member plan.

    /// Record a class's own `implements` declarations into its runtime bucket.

    /// Lower a class/struct into a `ClassPlan`, recursively building its
    /// constructors, methods, and property accessors. Mirrors
    /// `maybe_register_class` in emit.rs.

    /// Whether `cls` is a generic class/struct whose member bodies carry `Var`s
    /// that only an instantiation can substitute (lambdas inside them are
    /// rejected loudly).

    /// Walk every lambda-holding member body of a class/struct with the class
    /// as owner (so statics/consts/fields resolve through it). Generics carry
    /// `Var`s, so a lambda inside a generic class is rejected by `walk_expr`.

    /// Whether the type inferred for `span` is a function type.

    /// Decide which free names a lambda really captures (globals and the
    /// owner class's statics/consts resolve statically; instance members ride
    /// along as `this`), sorted deterministically for slot assignment.

    /// A lambda body's inferred return type: its trailing expression, or unit
    /// when none (checked annotations win first, in `registerLambdaAt`).

    /// Register a lambda's hoisted body and its closure class.

    /// Register a hoisted lambda body under the (enclosing function, span) key,
    /// substituting `smap` into the signature, captures, and return type.

    /// Register the synthetic `__closure_N` class (or return its id). Slot 0
    /// holds the hoisted body's code address; slots 1..N the captured values.

    /// Register the forwarder letting a top-level function be called through a
    /// closure object, keyed so every value-use site maps to the same trampoline.

    /// Register the forwarder letting an instance method bound to a receiver
    /// be used as a value; dispatches on the receiver's runtime class when the
    /// receiver class records overrides for the method.

    /// The runtime slot of instance field `name` on class `cid`, following the
    /// parent-first layout, when registered.

    /// Absolute (parent-first) slot of instance field `field` reachable from
    /// `cname`, whether declared on it or inherited.

    /// The static slot of static field `name` on class `cid`, with its declared
    /// type and the *declaring* class's id, when registered. Own declarations
    /// win, then up the ancestry.

    /// Whether `name` is a `const` declared on `cid` or any ancestor.

    /// The registered runtime class id of a resolved class/struct type.
    /// Non-generic types resolve through `classByName`; a generic type with
    /// concrete arguments materializes its instantiation on first use.

    /// Materialize one concrete instantiation of a generic class/struct under
    /// its mangled display name, registering its ctor and instance methods.

    /// The owner class/struct id of a class-level function, resolved from the
    /// recorded owner, falling back to the class name. Mirrors the
    /// `fid_owner.get().or_else(class_by_name)` chain in `build_func`.

    // ---- function registration helpers ----

    /// Append a class-level function (ctor, method, property accessor,
    /// `static.init`, `test.setup`, ...) to the module and record its source.


    /// The runtime symbol for a top-level callable, honoring an
    /// `#[symbol("...")]` attribute override so a function can claim an exact ABI
    /// symbol (e.g. a ported runtime's `pickle_str_len`).


    /// The single user (non-builtin, non-overloaded) callable for `name`.

    // ---- diagnostics & type lowering ----
    /// Lower an explicit type annotation to its IR type. Mirrors `annot_ty`
    /// in emit.rs.
    // ---- allocation helpers ----
    /// Record `name` as a `#[manualAlloc]` binding in the current scope.

    /// Is `name` a `#[manualAlloc]` binding in any enclosing scope?

    /// Walk the build environment scopes (innermost first) for a name's slot.

    /// Bind the resolved parameter list at function entry. Slots are the
    /// parameter indices (0-based), matching the callee ABI.

    /// Adopt every `#[manualAlloc]` parameter at function entry so the callee
    /// owns (and is responsible for freeing) the incoming allocation.
    /// Mirror of `boxForStore` for boundaries that are not list/map element
    /// slots: when the destination representation is `Ptr`, a scalar source
    /// (e.g. `let m: int? = 5`) must be lifted via `optionWrap` first.
/// The lowered parameter types of `fid` (empty before the callee's body is
    /// emitted). Mirrors reading `src_param_tys` from `emit.rs`.

    /// The resolved return type of `fid`.
    /// How a `Map<K, ...>` key is represented at the runtime boundary. Mirrors
    /// `key_rep` in emit.rs.

/// The element type `T` of an `Iterable<T>` value (mirror of the
    /// checker's rule): either the interface type `Iterable<int>` directly, or
    /// a class/struct that transitively declares `implements Iterable<...>`
    /// with its own generic args substituted (so `MyList<string>` yields
    /// `string`). `none` when the value is not iterable via the protocol.
    /// Mirrors `iterable_elem` in emit.rs.

    /// Read one field slot of a managed object: `pickle_obj_slot_get` (mdv-63
    /// `mdv_09 slot`), unboxed when the field carries a scalar boundary type.

    /// Push a `break`/`continue` target pair for a loop.

    /// The innermost loop's `break` target, if inside a loop.

    /// The innermost loop's `continue` target, if inside a loop.
    /// Report a non-exhaustive enum match that fell through the whole chain.


    /// Fold a string temp list with `pickle_str_concat`. Mirrors `concat_strs`.

    /// Lower a string literal: plain text becomes a `Const Str` temp;
    /// interpolated sub-expressions are stringified with the `pickle_str_from_*`
    /// helpers and concatenated. Mirrors `string_literal` in emit.rs.
fn stringLiteral(em: Emitter, parts: List<StrPart>) -> int? {
        var acc = -1
        var hasAcc = false
        for (part in parts) {
            var v = -1
            match (part) {
                case StrPart.Text(text) -> {
                    var t = temp(em)
                    instr(em, IrInstr.Const(t, IrConst.Str(internString(em, text))))
                    v = t
                }
                case StrPart.Expr(e) -> {
                    var vx = -1
                    if (let some(te) = expr(em, e)) {
                        vx = te
                    } else {
                        return none
                    }
                    var isByte = false
                    if (let some(bt) = tyOf(em, e.span)) {
                        match (bt) {
                            case Ty.Byte -> isByte = true
                            case _ -> {}
                        }
                    }
                    if (isByte) {
                        vx = externCallT1(em, "pickle_str_from_byte", [IrTy.Int], IrTy.Str, [vx])
                    } else {
                        var kind = -1
                        if (let some(it) = irty(em, e.span)) {
                            kind = irTyTag(it)
                        } else {
                            return none
                        }
                        if (kind == irTyTag(IrTy.Int)) {
                            vx = externCallT1(em, "pickle_str_from_i64", [IrTy.Int], IrTy.Str, [vx])
                        } else if (kind == irTyTag(IrTy.Float)) {
                            vx = externCallT1(em, "pickle_str_from_f64", [IrTy.Float], IrTy.Str, [vx])
                        } else if (kind == irTyTag(IrTy.Bool)) {
                            vx = externCallT1(em, "pickle_str_from_bool", [IrTy.Bool], IrTy.Str, [vx])
                        } else if (kind == irTyTag(IrTy.Char)) {
                            vx = externCallT1(em, "pickle_str_from_char", [IrTy.Char], IrTy.Str, [vx])
                        } else if (kind != irTyTag(IrTy.Str)) {
                            bad(em, e.span, "interpolation of this IR type is not lowered yet")
                            return none
                        }
                    }
                    v = vx
                }
            }
            if (!hasAcc) {
                acc = v
            } else {
                acc = externCallT1(em, "pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [acc, v])
            }
            hasAcc = true
        }
        if (!hasAcc) {
            var t2 = temp(em)
            instr(em, IrInstr.Const(t2, IrConst.Str(internString(em, ""))))
            return t2
        }
        acc
    }

    /// Lower a literal expression. Float literals defer to a pure text-to-float
    /// conversion (`floatVal`).
fn lit(em: Emitter, l: Lit) -> int? {
        match (l) {
            case Lit.Int(value) -> intConst(em, value)
            case Lit.Float(text) -> floatConst(em, floatVal(text))
            case Lit.Bool(b) -> boolConst(em, b)
            case Lit.Char(c) -> charConst(em, c as int)
            case Lit.String(parts) -> {
                var ph = temp(em)
                stringLiteral(em, parts)
            }
case Lit.None -> {
                var ph = temp(em)
                nullTemp(em)
            }
        }
    }

    // ---- expression hub ----

    /// The expression lowering hub (mirror of `expr` in emit.rs). Kinds whose
    /// lowering lives in later sub-slices (calls, binary/unary/assign, if/let,
/// Ice guard: deep recursion without `TRICK_COUNT` pops means the ported
    /// emitter re-entered a cycle. Report the tail of the route taken.

    /// Catches an unwrapped recursion cycle by looking for a short repeating
    /// period in the monotonic ledger of hot lowering-function entries. Pk's
    /// explicit-return style defeats entry/exit bookkeeping, so this uses the
    /// repetition itself: a runaway loop prints itself within a few laps,
    /// well before the native stack bottoms out.

fn expr(em: Emitter, e: Expr) -> int? {
        if (em.iceDepth > 150) {
            return none
        }
        em.iceDepth = em.iceDepth + 1
        em.icePath.push("expr")
        var r = expr1(em, e)
        em.iceDepth = em.iceDepth - 1
        r
    }

fn expr1(em: Emitter, e: Expr) -> int? {
        if (!icePoke(em, "expr1")) {
            return none
        }
        if (let none = irty(em, e.span)) {
            return none
        }
        match (e.kind) {
            case ExprKind.Lit(l) -> lit(em, l)
            case ExprKind.Ident(name) -> identExpr(em, e, name)
            case ExprKind.Call(callee, args) -> call(em, e, callee, args)
            case ExprKind.Binary(op, lhs, rhs) -> binary(em, e, op, lhs, rhs)
            case ExprKind.Unary(op, operand) -> unary(em, e, op, operand)
            case ExprKind.Assign(target, op, value) -> assign(em, e, target, op, value)
            case ExprKind.If(cond, then, elseElse) -> ifExpr(em, e, cond, then, elseElse)
            case ExprKind.Block(b) -> {
                pushScope(em)
                var r = blockValue(em, b)
                popScope(em)
                r
            }
            case ExprKind.This -> thisValue(em, e)
            case ExprKind.Super -> thisValue(em, e)
            case ExprKind.Member(object, name) -> memberValue(em, e, object, name)
            case ExprKind.Index(object, index) -> indexRead(em, e, object, index)
            case ExprKind.OptAccess(object, name) -> optAccess(em, e, object, name)
            case ExprKind.OptUnwrap(inner) -> optUnwrap(em, e, inner)
            case ExprKind.Lambda(_p, _r, _a, _b) -> lambdaValue(em, e)
            case ExprKind.Match(scrutinee, arms) -> matchExpr(em, e, scrutinee, arms)
            case ExprKind.Await(inner) -> {
                var t0: Ty? = none
                if (let some(t) = tyOf(em, inner.span)) {
                    t0 = t
                }
                // A future is a captured zero-argument closure (`() -> R`):
                // drive it by calling it with no arguments.
                var emptyFn = false
                var prt = Ty.None
                match (t0) {
                    case some(Ty.Fn(ps, r)) -> {
                        if (len(ps) == 0) {
                            emptyFn = true
                            prt = r
                        }
                    }
                    case _ -> {}
                }
                if (emptyFn) {
                    var obj = 0
                    if (let some(o) = expr(em, inner)) {
                        obj = o
                    } else {
                        return none
                    }
                    return fnValueCallFrom(em, e, obj, Ty.Fn(emptyTyList(), prt), emptyCallArgs())
                }
                match (t0) {
                    case some(Ty.Unknown) -> {
                        bad(em, inner.span, "cannot `await` a value whose type is unknown; an `async fn` call returns a `() -> T` future")
                    }
                    case some(Ty.Fn(_, _)) -> {
                        bad(em, inner.span, "a function taking arguments; a future is a zero-argument function")
                    }
                    case some(t2) -> {
                        bad(em, inner.span, "cannot `await` a value of type `{bareName(t2)}`; a future is the `() -> T` value returned by an `async fn`")
                    }
                    case none -> {
                        bad(em, inner.span, "an untyped value")
                    }
                }
                none
            }
            case ExprKind.GenericCall(name, typeArgs) -> genericFnValue(em, e, name, typeArgs)
            case ExprKind.Cast(ex, ty, k) -> cast(em, e, ex, ty, k)
            case ExprKind.Unsafe(b) -> {
                pushScope(em)
                var r = blockValue(em, b)
                popScope(em)
                r
            }
            case ExprKind.Tuple(items) -> tupleLiteral(em, e, items)
            case ExprKind.Array(items) -> arrayLiteral(em, e, items)
            case ExprKind.Map(entries) -> mapLiteral(em, e, entries)
            case ExprKind.Range(_s, _e, _i) -> {
                bad(em, e.span, "range values are not lowered yet")
                none
            }
        }
    }

    /// `this` / bare-name locals in instance context: read a bare field; the
    /// getter for a bare property; a static field of the enclosing class; or a
    /// class constant of the enclosing class. Mirrors `ident_expr` in emit.rs.
fn identExpr(em: Emitter, e: Expr, name: string) -> int? {
   if (let some(slot) = lookup(em, name)) {
   return load(em, slot)
   }
   // A top-level `var` is a real data slot: read it. This must be checked
   // *before* the const inline so a global is never mistaken for a value.
   if (em.globalIds.has(name)) {
   var gid: int? = none
   gid = em.globalIds[name]
   if (let some(id) = gid) {
   var ty = em.irModule.globals[id].ty
   var dst = temp(em)
   instr(em, IrInstr.LoadGlobal(dst, id, ty))
   return dst
   }
   }
   if (em.constsInits.has(name)) {
            if (strListHas(em.constInlining, name)) {
                bad(em, e.span, "cyclic `const` initialization of `" + name + "`")
                return none
            }
            em.constInlining.push(name)
            var ini = em.constsInits.get(name)
            if (let some(ini) = ini) {
                var t = expr(em, ini)
                em.constInlining.pop()
                return t
            }
            em.constInlining.pop()
            return none
        }
        if (let some(cid) = em.owner) {
            if (let some(slot) = instanceFieldIndex(em, cid, name)) {
                var fieldTy = fieldAt(em, cid, slot).ty
                var tv = thisValue(em, e)
                if (let some(tv) = tv) {
                    return fieldRead(em, e.span, tv, fieldTy, slot)
                }
                return none
            }
            if (let some(fid) = em.propertyIds.get(tripleKey(str(cid), name, str(false)))) {
                var tthis = thisValue(em, e)
                if (let some(tthis) = tthis) {
                    return callMethod(em, e, fid, emptyCallArgs(), tthis)
                }
                return none
            }
            if (let some(sf) = staticField(em, cid, name)) {
                return staticRead(em, e.span, sf.dcid, sf.slot, sf.info.ty)
            }
            if (let some(r) = readClassConst(em, e.span, cid, name)) {
                return r
            }
        }
        if (let some(fid) = em.irModule.funcsByName.get(name)) {
            return fnValueClosure(em, e, fid)
        }
        if (genericUserFn(em, name)) {
            bad(em, e.span, "using the generic function `" + name + "` as a value is not lowered yet; call it with explicit type arguments instead")
            return none
        }
        bad(em, e.span, "using `" + name + "` as a value is not lowered yet")
        none
    }

    /// The current receiver `this`, when available. Mirrors `this_value`.

    /// `object.name`: enum variants, class/struct instance fields, instance
    /// properties (deferred), bound methods (deferred), and `Type.member`
    /// static reads/class consts. Mirrors `member_value` in emit.rs.
fn memberValue(em: Emitter, e: Expr, object: Expr, name: string) -> int? {
        if (let some(en) = exprKindIdentName(object)) {
            if (let some(entry) = em.resolved.types.get(en)) {
                match (entry) {
                    case TypeTableEntry.Enum(t) -> {
                        var vix = -1
                        var found = false
                        var hasPayload = false
                        var i = 0
                        for (v in t.variants) {
                            if (v.name == name) {
                                vix = i
                                found = true
                                hasPayload = len(v.fields) > 0
                                break
                            }
                            i = i + 1
                        }
                        if (!found) {
                            bad(em, e.span, "enum `" + t.name + "` has no variant `" + name + "`")
                            return none
                        }
                        if (hasPayload) {
                            bad(em, e.span, "variant `" + name + "` carries " + str(len(t.variants[vix].fields)) + " payload field(s) and needs `" + name + "(...)`")
                            return none
                        }
                        var tag = intConst(em, vix)
                        var zero = intConst(em, 0)
                        return externCallT1(em, "pickle_enum_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [tag, zero])
                    }
                    case _ -> {}
                }
            }
        }
        var ot = tyOf(em, object.span)
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Ptr(iner) -> ot = iner
                case Ty.Ref(iner) -> ot = iner
                case _ -> {}
            }
        }
        var cid: int? = none
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Class(_, _) -> cid = classIdOf(em, pt, e.span)
                case Ty.Struct(_, _) -> cid = classIdOf(em, pt, e.span)
                case _ -> {}
            }
        }
        if (let some(cc) = cid) {
            if (let some(slot) = instanceFieldIndex(em, cc, name)) {
                var fieldTy = fieldAt(em, cc, slot).ty
                var obj = expr(em, object)
                if (let some(obj) = obj) {
                    return fieldRead(em, e.span, obj, fieldTy, slot)
                }
                return none
            }
            if (let some(fid) = em.propertyIds.get(tripleKey(str(cc), name, str(false)))) {
                var obj = expr(em, object)
                if (let some(obj) = obj) {
                    return callMethod(em, e, fid, emptyCallArgs(), obj)
                }
                return none
            }
            if (let some(mref) = em.methodIds.get(pairKey(str(cc), name))) {
                if (mref.isStatic) {
                    bad(em, e.span, "static method `" + name + "` cannot be used as a value")
                    return none
                }
                return boundMethodValue(em, e, object)
            }
            bad(em, e.span, "method `" + name + "` of `" + classOfName(em, cc) + "` cannot be used as a value")
            return none
        }
        if (let some(tname) = exprKindIdentName(object)) {
            if (let some(cx) = em.classByName.get(tname)) {
                if (let some(fid) = em.staticPropertyIds.get(tripleKey(str(cx), name, str(false)))) {
                    return callMethod(em, e, fid, emptyCallArgs(), none)
                }
                if (let some(sf) = staticField(em, cx, name)) {
                    return staticRead(em, e.span, sf.dcid, sf.slot, sf.info.ty)
                }
                if (let some(r) = readClassConst(em, e.span, cx, name)) {
                    return r
                }
                bad(em, e.span, "static member `" + name + "` on `" + tname + "` is not lowered yet")
                return none
            }
        }
        bad(em, e.span, "member access is not lowered yet")
        none
    }

    // ---- option expressions ----

    /// `p != null`: whether an option pointer is present.

    /// Resolve a present option pointer to its inner value: scalars are
    /// unboxed to the element IR type; managed values pass through. Mirrors
    /// `opt_resolve` in emit.rs.

    /// `a ?? b`: yield the unwrapped `a` when present, else `b`. Mirrors
    /// `null_coalesce` in emit.rs.
fn nullCoalesce(em: Emitter, e: Expr, lhs: Expr, rhs: Expr) -> int? {
        var innerTy = Ty.Unknown
        var got = false
        if (let some(t) = tyOf(em, lhs.span)) {
            if (let some(i) = innerOption(t)) {
                innerTy = i
                got = true
            }
        }
        if (!got) {
            bad(em, e.span, "left side of `??` is not an option")
            return none
        }
        var resIr0 = mapTy(em, innerTy, e.span)
        if (let none = resIr0) {
            return none
        }
        var resIr = IrTy.Unit
        if (let some(x) = resIr0) {
            resIr = x
        }
        var resSlot = newSlot(em, resIr)
        var a0 = expr(em, lhs)
        if (let none = a0) {
            return none
        }
        var a = 0
        if (let some(v) = a0) {
            a = v
        }
        var present0 = optIsPresent(em, a)
        if (let none = present0) {
            return none
        }
        var present = 0
        if (let some(p) = present0) {
            present = p
        }
        var someId = newBlock(em)
        var rhsId = newBlock(em)
        var join = newBlock(em)
        term(em, IrTerm.BranchIf(present, someId, rhsId))
        em.cur = someId
        var av0 = optResolve(em, a, innerTy, e.span)
        if (let none = av0) {
            return none
        }
        var av = 0
        if (let some(v) = av0) {
            av = v
        }
        instr(em, IrInstr.StoreSlot(resSlot, av))
        term(em, IrTerm.Branch(join))
        em.cur = rhsId
        var bv = expr(em, rhs)
        if (let none = bv) {
            return none
        }
        var b = 0
        if (let some(v) = bv) {
            b = v
        }
        if (irTyTag(resIr) == irTyTag(IrTy.Ptr)) {
            var vt = Ty.Unknown
            if (let some(gt) = tyOf(em, rhs.span)) {
                vt = gt
            }
            var wv = optionWrap(em, b, vt, rhs.span)
            if (let none = wv) {
                return none
            }
            if (let some(w) = wv) {
                b = w
            }
        }
        instr(em, IrInstr.StoreSlot(resSlot, b))
        term(em, IrTerm.Branch(join))
        em.cur = join
        return load(em, resSlot)
    }

    /// `a?`: unwrap `a` to its inner value, panicking on `none`. Mirrors
    /// `opt_unwrap`.

fn optUnwrap(em: Emitter, e: Expr, operand: Expr) -> int? {
        var innerTy = Ty.Unknown
        var got = false
        if (let some(t) = tyOf(em, operand.span)) {
            if (let some(i) = innerOption(t)) {
                innerTy = i
                got = true
            }
        }
        if (!got) {
            bad(em, e.span, "`?` operand is not an option")
            return none
        }
        var p = expr(em, operand)
        if (let some(p) = p) {
            return optUnwrapVal(em, e.span, p, innerTy)
        }
        none
    }

    /// Unwrap an already-evaluated option pointer `p` to its inner value,
    /// panicking on `none`. Mirrors `opt_unwrap_val`.

    /// `a?.name`: when `a` is present, read `name` off the receiver and lift it
    /// to `T?`; when it is `none`, the result is `none`. Mirrors `opt_access`.
fn optAccess(em: Emitter, e: Expr, object: Expr, name: string) -> int? {
        var innerTy = Ty.Unknown
        var got = false
        if (let some(t) = tyOf(em, object.span)) {
            if (let some(i) = innerOption(t)) {
                innerTy = i
                got = true
            }
        }
        if (!got) {
            bad(em, e.span, "`?.` requires an option receiver")
            return none
        }
        var o = expr(em, object)
        if (let some(o) = o) {
            var resSlot = newSlot(em, IrTy.Ptr)
            var present = optIsPresent(em, o)
            if (let some(present) = present) {
                var someId = newBlock(em)
                var noneId = newBlock(em)
                var join = newBlock(em)
                term(em, IrTerm.BranchIf(present, someId, noneId))
                em.cur = noneId
                var n = nullTemp(em)
                if (let some(n) = n) {
                    instr(em, IrInstr.StoreSlot(resSlot, n))
                    term(em, IrTerm.Branch(join))
                    em.cur = someId
                    var mr = optMemberRead(em, e, o, innerTy, name)
                    if (let some(mr) = mr) {
                        var wrapper = optionWrap(em, mr.v, mr.ty, e.span)
                        if (let some(w) = wrapper) {
                            instr(em, IrInstr.StoreSlot(resSlot, w))
                            term(em, IrTerm.Branch(join))
                            em.cur = join
                            return load(em, resSlot)
                        }
                        return none
                    }
                    return none
                }
                return none
            }
            return none
        }
        none
    }

    /// Read field `name` (or dispatch the getter for property `name`) from an
    /// already-evaluated class/struct receiver (property getters deferred).
    /// Mirrors `opt_member_read`.
fn optMemberRead(em: Emitter, e: Expr, obj: int, recvTy: Ty, name: string) -> OptMemberVal? {
        var cid: int? = none
        var cname = ""
        match (recvTy) {
            case Ty.Class(cn, _) -> {
                cid = classIdOf(em, recvTy, e.span)
                cname = cn
            }
            case Ty.Struct(cn, _) -> {
                cid = classIdOf(em, recvTy, e.span)
                cname = cn
            }
            case _ -> {}
        }
if (let some(cc) = cid) {
            if (let some(slot) = instanceFieldIndex(em, cc, name)) {
                var fieldTy = fieldAt(em, cc, slot).ty
                var v = fieldRead(em, e.span, obj, fieldTy, slot)
                if (let some(v) = v) {
                    return OptMemberVal(fieldTy, v)
                }
                return none
            }
            if (let some(fid) = em.propertyIds.get(tripleKey(str(cc), name, str(false)))) {
                var pty = propertyTyOf(em, cname, name)
                var v = callMethod(em, e, fid, emptyCallArgs(), obj)
                if (let some(v) = v) {
                    return OptMemberVal(pty, v)
                }
                return none
            }
        }
        bad(em, e.span, "no field or property `" + name + "` for optional access")
        none
    }

    /// The declared type of property `name` on class `cname`.

    // ---- unary / binary / logic / casts / assigns --------------------------

    /// The class id of a non-generic `Ty::Class(n, [])`, or `none` when `ty`
    /// is not such a type (mirrors `user_class_id`).

    /// An ASCII `char` literal re-read as the `int` it represents, or `none`
    /// for anything else. Used so a `byte` compared against an ASCII `char`
    /// literal shares the `i64` ABI (mirrors the `ascii_lit_int` closure).

    /// `-x` / `~x` / `!x` / `*p` / `&x`. Mirrors `unary` in emit.rs.
fn unary(em: Emitter, e: Expr, op: UnOp, operand: Expr) -> int? {
        match (op) {
            case UnOp.Neg | UnOp.BitNot -> {
                var v = expr(em, operand)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dst = temp(em)
                if (op == UnOp.Neg) {
                    instr(em, IrInstr.UnOp(dst, IrUnOp.Neg, vId))
                } else {
                    instr(em, IrInstr.UnOp(dst, IrUnOp.BitNot, vId))
                }
                dst
            }
            case UnOp.Not -> {
                var v = expr(em, operand)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dst = temp(em)
                instr(em, IrInstr.UnOp(dst, IrUnOp.Not, vId))
                dst
            }
            case UnOp.Deref -> {
                var scalar: IrTy? = none
                if (let some(t) = tyOf(em, operand.span)) {
                    match (t) {
                        case Ty.Ptr(pr) -> scalar = scalarIr(pr)
                        case Ty.Ref(pr) -> scalar = scalarIr(pr)
                        case _ -> {}
                    }
                }
                if (let some(ty) = scalar) {
                    var addr = expr(em, operand)
                    if (let none = addr) {
                        return none
                    }
                    var addrId = 0
                    if (let some(aa) = addr) {
                        addrId = aa
                    }
                    var dst = temp(em)
                    instr(em, IrInstr.LoadRaw(dst, addrId, ty))
                    return dst
                }
                expr(em, operand)
            }
            case UnOp.AddrOf -> {
                var t = tyOf(em, operand.span)
                var tScalar = false
                if (let some(tt) = t) {
                    if (let some(_) = scalarIr(tt)) {
                        tScalar = true
                    }
                }
                if (tScalar) {
                    var nameO = exprKindIdentName(operand)
                    if (let none = nameO) {
                        bad(em, e.span, "`&` of a scalar requires a local variable")
                        return none
                    }
                    var name = ""
                    if (let some(n) = nameO) {
                        name = n
                    }
                    var slotO = lookup(em, name)
                    if (let some(s) = slotO) {
                        var dst = temp(em)
                        instr(em, IrInstr.LocalAddr(dst, s))
                        return dst
                    }
                    // A top-level `var` is addressable too: the cell lives in the
                    // image's `.data`, so `&g` is the address of that symbol and a
                    // write through it lands in the global, not a copy. This is
                    // what lets a ported runtime pass a mutable cell to an extern
                    // (e.g. a per-thread frame head) instead of returning a value.
                    if (em.globalIds.has(name)) {
                        var gidO = em.globalIds.get(name)
                        if (let some(gid) = gidO) {
                            var dst2 = temp(em)
                            instr(em, IrInstr.GlobalAddr(dst2, gid))
                            return dst2
                        }
                    }
                    bad(em, e.span, "`&` of an unknown local")
                    return none
                }
                var ok = false
                if (let some(tt) = t) {
                    match (tt) {
                        case Ty.Class(_, _) -> ok = true
                        case Ty.Struct(_, _) -> ok = true
                        case Ty.Ptr(_) -> ok = true
                        // The checker already types `&str` as `*string`
                        // (see `check.pkl`), so the emitter has to lower it
                        // the same way: the value *is* the object pointer.
                        case Ty.String -> ok = true
                        case _ -> {}
                    }
                }
                if (ok) {
                    return expr(em, operand)
                }
                bad(em, e.span, "`&` currently only supports class, struct, pointer, and scalar local variables")
                none
            }
        }
    }

    /// Binary arithmetic/comparison/boolean expressions. Mirrors `binary` in
    /// emit.rs (order matters: string/enum special cases first, then the Itof
    /// promotion pair, then the ASCII-byte trick, then the defensive check).
fn binary(em: Emitter, e: Expr, op: BinOp, lhs: Expr, rhs: Expr) -> int? {
        var lt = tyOf(em, lhs.span)
        var rt = tyOf(em, rhs.span)
        var bothStr = false
        if (let some(l) = lt) {
            if (let some(r) = rt) {
                if (l == Ty.String && r == Ty.String) {
                    bothStr = true
                }
            }
        }
        var bothEnum = false
        if (let some(l) = lt) {
            match (l) {
                case Ty.Enum(_, _) -> {
                    if (let some(r) = rt) {
                        match (r) {
                            case Ty.Enum(_, _) -> bothEnum = true
                            case _ -> {}
                        }
                    }
                }
                case _ -> {}
            }
        }
        match (op) {
            case BinOp.And | BinOp.Or -> {
                return logic(em, e, op, lhs, rhs)
            }
            case BinOp.NullCoalesce -> {
                return nullCoalesce(em, e, lhs, rhs)
            }
case BinOp.Range | BinOp.RangeIncl -> {
                if (!ensureInt(em, lhs)) {
                    return none
                }
                if (!ensureInt(em, rhs)) {
                    return none
                }
                var start = expr(em, lhs)
                if (let none = start) {
                    return none
                }
                var end = expr(em, rhs)
                if (let none = end) {
                    return none
                }
                var startV = 0
                if (let some(v) = start) {
                    startV = v
                }
                var endV = 0
                if (let some(v) = end) {
                    endV = v
                }
                var one = intConst(em, 1)
                if (op == BinOp.Range) {
                    return externCallT1(em, "pickle_range", [IrTy.Int, IrTy.Int, IrTy.Int], IrTy.Ptr, [startV, endV, one])
                }
                var end1 = temp(em)
                instr(em, IrInstr.BinOp(end1, IrBinOp.Add, endV, one))
                return externCallT1(em, "pickle_range", [IrTy.Int, IrTy.Int, IrTy.Int], IrTy.Ptr, [startV, end1, one])
            }
            case BinOp.Pow -> {
                return emitPow(em, e, lhs, rhs)
            }
            case BinOp.In -> {
                return emitIn(em, e, lhs, rhs)
            }
            case BinOp.Send -> {
                return emitSend(em, lhs, rhs)
            }
            case BinOp.Is -> {
                bad(em, e.span, "the `is` operator is not lowered yet")
                return none
            }
            case BinOp.Add -> {
                if (bothStr) {
                    var a = expr(em, lhs)
                    if (let none = a) {
                        return none
                    }
                    var b = expr(em, rhs)
                    if (let none = b) {
                        return none
                    }
                    var aId = 0
                    if (let some(v) = a) {
                        aId = v
                    }
                    var bId = 0
                    if (let some(v) = b) {
                        bId = v
                    }
                    return externCallT1(em, "pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [aId, bId])
                }
            }
            case BinOp.Eq | BinOp.Ne -> {
                if (bothStr) {
                    var a = expr(em, lhs)
                    if (let none = a) {
                        return none
                    }
                    var b = expr(em, rhs)
                    if (let none = b) {
                        return none
                    }
                    var aId = 0
                    if (let some(v) = a) {
                        aId = v
                    }
                    var bId = 0
                    if (let some(v) = b) {
                        bId = v
                    }
                    var cmp = externCallT1(em, "pickle_str_cmp", [IrTy.Str, IrTy.Str], IrTy.Int, [aId, bId])
                    var zero = temp(em)
                    instr(em, IrInstr.Const(zero, IrConst.Int(0)))
                    var dst = temp(em)
                    var eqOp = IrBinOp.Eq
                    if (op == BinOp.Ne) {
                        eqOp = IrBinOp.Ne
                    }
                    instr(em, IrInstr.BinOp(dst, eqOp, cmp, zero))
                    return dst
                }
                if (bothEnum) {
                    var a = expr(em, lhs)
                    if (let none = a) {
                        return none
                    }
                    var b = expr(em, rhs)
                    if (let none = b) {
                        return none
                    }
                    var aId = 0
                    if (let some(v) = a) {
                        aId = v
                    }
                    var bId = 0
                    if (let some(v) = b) {
                        bId = v
                    }
                    var eq = externCallT1(em, "pickle_enum_eq", [IrTy.Ptr, IrTy.Ptr], IrTy.Bool, [aId, bId])
                    if (op == BinOp.Eq) {
                        return eq
                    }
                    var dst = temp(em)
                    instr(em, IrInstr.UnOp(dst, IrUnOp.Not, eq))
                    return dst
                }
            }
            case _ -> {}
        }
        var a = expr(em, lhs)
        if (let none = a) {
            return none
        }
        var b = expr(em, rhs)
        if (let none = b) {
            return none
        }
        var aId = 0
        if (let some(v) = a) {
            aId = v
        }
        var bId = 0
        if (let some(v) = b) {
            bId = v
        }
        var aty = irty(em, lhs.span)
        var bty = irty(em, rhs.span)
        var aFloat = false
        var bInt = false
        if (let some(t) = aty) {
            if (t == IrTy.Float) {
                aFloat = true
            }
        }
        if (let some(t) = bty) {
            if (t == IrTy.Int) {
                bInt = true
            }
        }
        if (aFloat && bInt) {
            var t = temp(em)
            instr(em, IrInstr.Itof(t, bId))
            bId = t
        } else {
            var aInt = false
            var bFloat = false
            if (let some(t) = aty) {
                if (t == IrTy.Int) {
                    aInt = true
                }
            }
            if (let some(t) = bty) {
                if (t == IrTy.Float) {
                    bFloat = true
                }
            }
            if (aInt && bFloat) {
                var t = temp(em)
                instr(em, IrInstr.Itof(t, aId))
                aId = t
            }
        }
        var aByte = false
        if (let some(t) = lt) {
            if (t == Ty.Byte) {
                aByte = true
            }
        }
        var bByte = false
        if (let some(t) = rt) {
            if (t == Ty.Byte) {
                bByte = true
            }
        }
        if (aByte || bByte) {
            if (aByte) {
                var asciiB = asciiLitInt(em, rhs)
                if (let some(t) = asciiB) {
                    bId = t
                    bty = IrTy.Int
                }
            } else {
                var asciiA = asciiLitInt(em, lhs)
                if (let some(t) = asciiA) {
                    aId = t
                    aty = IrTy.Int
                }
            }
        }
        var isCmp = false
        match (op) {
            case BinOp.Lt | BinOp.Le | BinOp.Gt | BinOp.Ge | BinOp.Eq | BinOp.Ne -> isCmp = true
            case _ -> {}
        }
        if (isCmp) {
            var aTag = -1
            var bTag = -1
            if (let some(t) = aty) {
                aTag = irTyTag(t)
            }
            if (let some(t) = bty) {
                bTag = irTyTag(t)
            }
            if (!cmpTypesCompatible(aTag, bTag)) {
                bad(em, e.span, "comparison `" + binOpName(op) + "` with incompatible operand types is not lowered yet")
                return none
            }
        }
        var dst = temp(em)
        instr(em, IrInstr.BinOp(dst, binaryOpcode(op), aId, bId))
        dst
    }

    /// Short-circuit `&&` / `||` through a result slot. Mirrors `logic` in
    /// emit.rs.
fn logic(em: Emitter, e: Expr, op: BinOp, lhs: Expr, rhs: Expr) -> int? {
        var res = newSlot(em, IrTy.Bool)
        var isAnd = op == BinOp.And
        var a = expr(em, lhs)
        if (let none = a) {
            return none
        }
        var aId = 0
        if (let some(v) = a) {
            aId = v
        }
        var rhsId = newBlock(em)
        var shortId = newBlock(em)
        var join = newBlock(em)
        if (isAnd) {
            term(em, IrTerm.BranchIf(aId, rhsId, shortId))
        } else {
            term(em, IrTerm.BranchIf(aId, shortId, rhsId))
        }
        em.cur = rhsId
        var b = expr(em, rhs)
        if (let none = b) {
            return none
        }
        var bId = 0
        if (let some(v) = b) {
            bId = v
        }
        instr(em, IrInstr.StoreSlot(res, bId))
        term(em, IrTerm.Branch(join))
        em.cur = shortId
        var sv = temp(em)
        instr(em, IrInstr.Const(sv, IrConst.Bool(!isAnd)))
        instr(em, IrInstr.StoreSlot(res, sv))
        term(em, IrTerm.Branch(join))
        em.cur = join
        load(em, res)
    }

    /// Combine two boolean temps (`&&` when `isAnd`, otherwise `||`) into one
    /// `Bool` temp. Mirrors `combine_cond` in emit.rs.

    // ---- casts ----

    /// `x is T` / `x as T` / `x as? T`. The result stays in the typed IR value
    /// domain: `is` -> bool, `as` -> `T`, `as?` -> `T?` (a pointer). Mirrors
    /// `cast` in emit.rs.
fn cast(em: Emitter, e: Expr, operand: Expr, ty: TypeExpr, kind: CastKind) -> int? {
        var src = Ty.Unknown
        if (let some(t) = tyOf(em, operand.span)) {
            src = t
        }
        var dst = em.resolved.resolveTy(ty, emptyStrs(), em.diags)
        match (kind) {
            case CastKind.Is -> castIs(em, e, operand, src, dst)
            case CastKind.As -> castAs(em, e, operand, src, dst)
            case CastKind.TryAs -> {
                var v = expr(em, operand)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var inner = dst
                if (let some(i) = innerOption(dst)) {
                    inner = i
                }
                castToOption(em, e.span, vId, src, inner)
            }
        }
    }

    /// `x is T`: compare underlying (option-stripped) types. Mirrors `cast_is`.
fn castIs(em: Emitter, e: Expr, operand: Expr, src: Ty, dst: Ty) -> int? {
        var srcOpt = innerOption(src)
        var dstOpt = innerOption(dst)
        var baseSrc = src
        var baseDst = dst
        if (let some(s) = srcOpt) {
            baseSrc = s
        }
        if (let some(d) = dstOpt) {
            baseDst = d
        }
        var v = expr(em, operand)
        if (let none = v) {
            return none
        }
        var vId = 0
        if (let some(vv) = v) {
            vId = vv
        }
        if (tyEq(baseSrc, baseDst)) {
            var srcIsOpt = true
            var dstIsOpt = true
            if (let none = srcOpt) {
                srcIsOpt = false
            }
            if (let none = dstOpt) {
                dstIsOpt = false
            }
            if (srcIsOpt && !dstIsOpt) {
                return optIsPresent(em, vId)
            }
            return boolConst(em, true)
        }
        if (isNumeric(baseSrc) && isNumeric(baseDst)) {
            return boolConst(em, false)
        }
        var srcRef = userClassId(em, baseSrc)
        var dstRef = userClassId(em, baseDst)
        if (let some(sr) = srcRef) {
            if (let some(dr) = dstRef) {
                if (isAncestor(em, dr.name, sr.name)) {
                    return boolConst(em, true)
                }
                if (isAncestor(em, sr.name, dr.name)) {
                    var dc = intConst(em, dr.id)
                    return externCallT1(em, "pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [vId, dc])
                }
                return boolConst(em, false)
            }
        }
        var dstIf = ifaceOf(baseDst)
        if (let some(di) = dstIf) {
            var ifaceId = ifaceIdFor(em, di.name, di.args, e.span)
            if (let some(id) = ifaceId) {
                var dc = intConst(em, id)
                return externCallT1(em, "pickle_class_implements", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [vId, dc])
            }
            return none
        }
        if (let some(_) = ifaceOf(baseSrc)) {
            var dRef = userClassId(em, baseDst)
            if (let none = dRef) {
                bad(em, e.span, "`" + bareName(src) + " is " + bareName(dst) + "` is not lowered yet")
                return none
            }
            var drId = 0
            if (let some(dr2) = dRef) {
                drId = dr2.id
            }
            var dc = intConst(em, drId)
            return externCallT1(em, "pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [vId, dc])
        }
        bad(em, e.span, "`" + bareName(src) + " is " + bareName(dst) + "` is not lowered yet (class/interface tests need inheritance)")
        none
    }

    /// `x as T`: unpreserving, but `T?` targets never panic. Mirrors `cast_as`.
fn castAs(em: Emitter, e: Expr, operand: Expr, src: Ty, dst: Ty) -> int? {
        var v = expr(em, operand)
        if (let none = v) {
            return none
        }
        var vId = 0
        if (let some(vv) = v) {
            vId = vv
        }
        if (let some(inner) = innerOption(dst)) {
            return castToOption(em, e.span, vId, src, inner)
        }
        if (let some(si) = innerOption(src)) {
            var ival = optUnwrapVal(em, e.span, vId, si)
            if (let none = ival) {
                return none
            }
            var iv = 0
            if (let some(ivv) = ival) {
                iv = ivv
            }
            return convert(em, e.span, iv, si, dst)
        }
        convert(em, e.span, vId, src, dst)
    }

    /// Produce the option `inner?` from an already-evaluated `v` of type `src`.
    /// A managed source passes through; scalars are boxed. When `src` is itself
    /// an option, `none` is preserved and the present value is converted.
    /// Mirrors `cast_to_option`.

    /// Convert a non-option value between related (non-option) types. Identity
    /// and numeric conversions are supported; anything else bails. Mirrors
    /// `convert` in emit.rs.

    // ---- assignments ----

    /// `target = value`, `target op= value`, `*p = value`, `xs[i] ... = value`,
    /// `obj.field ... = value`. Mirrors `assign` in emit.rs.
fn assign(em: Emitter, e: Expr, target: Expr, op: AssignOp, value: Expr) -> int? {
        var span = target.span
        var derefOperand: Expr? = none
        match (target.kind) {
            case ExprKind.Unary(UnOp.Deref, operand) -> derefOperand = operand
            case _ -> {}
        }
if (let some(operand) = derefOperand) {
            var pt = Ty.Unknown
            if (let some(t) = tyOf(em, operand.span)) {
                pt = t
            }
            var scalar: IrTy? = none
            match (pt) {
                case Ty.Ptr(pr) -> scalar = scalarIr(pr)
                case _ -> {}
            }
            if (let some(ty) = scalar) {
                var addr = expr(em, operand)
                if (let none = addr) {
                    return none
                }
                var addrId = 0
                if (let some(aa) = addr) {
                    addrId = aa
                }
                if (op == AssignOp.Assign) {
                    var v = expr(em, value)
                    if (let none = v) {
                        return none
                    }
                    var vId = 0
                    if (let some(vv) = v) {
                        vId = vv
                    }
                    instr(em, IrInstr.StoreRaw(addrId, vId, ty))
                    return vId
                }
                // `*p op= v`: read-modify-write on the dereferenced cell.
                var cur = temp(em)
                instr(em, IrInstr.LoadRaw(cur, addrId, ty))
                var v = expr(em, value)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dst = temp(em)
                instr(em, IrInstr.BinOp(dst, assignOpcode(op), cur, vId))
                instr(em, IrInstr.StoreRaw(addrId, dst, ty))
                return dst
            }
            if (op != AssignOp.Assign) {
                bad(em, span, "compound assignment through a raw pointer is not lowered yet")
                return none
            }
            match (pt) {
                case Ty.Class(_, _) -> {
                    return assign(em, e, operand, op, value)
                }
                case Ty.Struct(_, _) -> {
                    return assign(em, e, operand, op, value)
                }
                case Ty.Ptr(_) -> {
                    return assign(em, e, operand, op, value)
                }
                case Ty.Ref(_) -> {
                    bad(em, span, "cannot write through an immutable reference (`&T`)")
                    return none
                }
                case _ -> {
                    bad(em, span, "assignment through a raw pointer is only supported for class, struct, pointer, and scalar values")
                    return none
                }
            }
        }
        match (target.kind) {
            case ExprKind.Index(object, index) -> {
                return indexAssign(em, e, op, object, index, value)
            }
            case _ -> {}
        }
        match (target.kind) {
            case ExprKind.Member(object, name) -> {
                return memberAssign(em, e, op, object, name, value)
            }
            case _ -> {}
        }
        var name = ""
        match (target.kind) {
            case ExprKind.Ident(n) -> name = n
            case _ -> {
                bad(em, span, "assignment targets other than names are not lowered yet")
                return none
            }
        }
        var v = expr(em, value)
        if (let none = v) {
            return none
        }
        var vId = 0
        if (let some(vv) = v) {
            vId = vv
        }
        var vt = Ty.Unknown
        if (let some(t) = tyOf(em, value.span)) {
            vt = t
        }
        var slotO = lookup(em, name)
        if (let some(slot) = slotO) {
            if (op == AssignOp.Assign) {
                var sv = vId
                if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                    var w = optionWrap(em, vId, vt, value.span)
                    if (let none = w) {
                        return none
                    }
                    if (let some(wv) = w) {
                        sv = wv
                    }
                }
                instr(em, IrInstr.StoreSlot(slot, sv))
                return vId
            }
            var cur = load(em, slot)
            var dst = 0
            if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Str)) {
                dst = externCallT1(em, "pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [cur, vId])
            } else {
                var t = temp(em)
                instr(em, IrInstr.BinOp(t, assignOpcode(op), cur, vId))
                dst = t
            }
            instr(em, IrInstr.StoreSlot(slot, dst))
            return dst
        }
        // A top-level `var` write goes to the data symbol. Compound forms
        // are read-modify-write against the slot, so `g += 1` is a load then
        // a store, never a blind store of `v`.
        if (em.globalIds.has(name)) {
            var gid: int? = none
            gid = em.globalIds[name]
            if (let some(id) = gid) {
                var ty = em.irModule.globals[id].ty
                var stored = vId
                if (op != AssignOp.Assign) {
                    var cur = temp(em)
                    instr(em, IrInstr.LoadGlobal(cur, id, ty))
                    if (irTyTag(ty) == irTyTag(IrTy.Str)) {
                        var cc = externCallT1(em, "pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [cur, vId])
                        stored = cc
                    } else {
                        var t = temp(em)
                        instr(em, IrInstr.BinOp(t, assignOpcode(op), cur, vId))
                        stored = t
                    }
                }
                instr(em, IrInstr.StoreGlobal(id, stored, ty))
                return stored
            }
        }
        if (let some(cid) = em.owner) {
            var idxO = instanceFieldIndex(em, cid, name)
            if (let some(idx) = idxO) {
                var fieldTy = fieldAt(em, cid, idx).ty
                var owned = fieldAt(em, cid, idx).manual
                var thO = thisValue(em, e)
                if (let none = thO) {
                    return none
                }
                var th = 0
                if (let some(thv) = thO) {
                    th = thv
                }
                return fieldAssign(em, e.span, op, th, fieldTy, idx, vId, vt, owned)
            }
            var sfo = staticField(em, cid, name)
            if (let some(sf) = sfo) {
                if (!sf.info.mutable) {
                    bad(em, span, "cannot assign to immutable static field `" + name + "`")
                    return none
                }
                return staticAssign(em, span, op, sf.dcid, sf.slot, sf.info.ty, vId, vt)
            }
        }
bad(em, span, "cannot assign to `" + name + "`")
        none
    }

/// `obj.field` and `obj.field op= value` on class/struct instances.
    /// Mirrors `member_assign` in emit.rs.

fn memberAssign(em: Emitter, e: Expr, op: AssignOp, object: Expr, name: string, value: Expr) -> int? {
        // `Type.staticProperty = v` dispatches the receiver-less setter.
        var tname = ""
        var isType = false
        match (object.kind) {
            case ExprKind.Ident(n) -> {
                tname = n
                isType = true
            }
            case _ -> {}
        }
        if (isType) {
            var cidO = em.classByName.get(tname)
            if (let some(cid) = cidO) {
var fidO = em.staticPropertyIds.get(tripleKey(str(cid), name, str(true)))
                if (let some(fid) = fidO) {
                    if (op != AssignOp.Assign) {
                        // `Type.prop op= value`: read through the getter,
                        // combine, call the setter with the result.
                        var getFidO = em.staticPropertyIds.get(tripleKey(str(cid), name, str(false)))
                        if (let none = getFidO) {
                            bad(em, e.span, "static property `" + name + "` has no getter")
                            return none
                        }
                        var getFid = 0
                        if (let some(g) = getFidO) {
                            getFid = g
                        }
                        var ptyTy = propertyTyOf(em, tname, name)
                        var curO = callMethod(em, e, getFid, emptyCallArgs(), none)
                        if (let none = curO) {
                            return none
                        }
                        var cur = 0
                        if (let some(c) = curO) {
                            cur = c
                        }
                        var v = expr(em, value)
                        if (let none = v) {
                            return none
                        }
                        var vId = 0
                        if (let some(vv) = v) {
                            vId = vv
                        }
                        var dstO = combineCompound(em, e.span, op, ptyTy, cur, vId, "static property")
                        if (let none = dstO) {
                            return none
                        }
                        var dst = 0
                        if (let some(d) = dstO) {
                            dst = d
                        }
                        var packed = dst
                        if (irTyTag(em.irModule.funcs[fid].params[0].ty) == irTyTag(IrTy.Ptr)) {
                            var w = optionWrap(em, dst, ptyTy, value.span)
                            if (let none = w) {
                                return none
                            }
                            if (let some(wv) = w) {
                                packed = wv
                            }
                        }
                            var dsti = temp(em)
                            instr(em, IrInstr.Call(dsti, Callee.Func(fid), [packed]))
                            // `Type.prop = v`: same as the instance case, the setter
                            // is a call that can throw. Nothing reads `dsti` here, but
                            // the pending check still has to fire before the next
                            // statement.
                            guardPropagation(em, fid)
                            return dst
                    }
                    var v = expr(em, value)
                    if (let none = v) {
                        return none
                    }
                    var vId = 0
                    if (let some(vv) = v) {
                        vId = vv
                    }
                    var vt = Ty.Unknown
                    if (let some(t) = tyOf(em, value.span)) {
                        vt = t
                    }
                    var packed = vId
                    if (irTyTag(em.irModule.funcs[fid].params[0].ty) == irTyTag(IrTy.Ptr)) {
                        var w = optionWrap(em, vId, vt, value.span)
                        if (let none = w) {
                            return none
                        }
                        if (let some(wv) = w) {
                            packed = wv
                        }
                    }
                        var dst = temp(em)
                        instr(em, IrInstr.Call(dst, Callee.Func(fid), [packed]))
                        // As with the static setter: a throwing accessor has to
                        // leave before the compound assignment is considered done.
                        guardPropagation(em, fid)
                        return vId
                }
                var sfo = staticField(em, cid, name)
                if (let some(sf) = sfo) {
                    if (!sf.info.mutable) {
                        bad(em, e.span, "cannot assign to immutable static field `" + name + "`")
                        return none
                    }
                    var v = expr(em, value)
                    if (let none = v) {
                        return none
                    }
                    var vId = 0
                    if (let some(vv) = v) {
                        vId = vv
                    }
                    var vt = Ty.Unknown
                    if (let some(t) = tyOf(em, value.span)) {
                        vt = t
                    }
                    return staticAssign(em, e.span, op, sf.dcid, sf.slot, sf.info.ty, vId, vt)
                }
                bad(em, e.span, "`" + tname + "` has no settable static member `" + name + "`")
                return none
            }
        }
var ot = tyOf(em, object.span)
        var o2: Ty? = none
        if (let some(tt) = ot) {
            match (tt) {
                case Ty.Ptr(pr) -> o2 = pr
                case _ -> o2 = tt
            }
        }
        var cidVal = -1
        if (let some(oo) = o2) {
            match (oo) {
                case Ty.Class(_, _) -> {
                    var co = classIdOf(em, oo, e.span)
                    if (let some(c) = co) {
                        cidVal = c
                    }
                }
                case Ty.Struct(_, _) -> {
                    var co = classIdOf(em, oo, e.span)
                    if (let some(c) = co) {
                        cidVal = c
                    }
                }
                case _ -> {}
            }
        }
if (cidVal < 0) {
            bad(em, e.span, "assignment over this member type is not lowered yet")
            return none
        }
        var idxO = instanceFieldIndex(em, cidVal, name)
        if (let some(idx) = idxO) {
            var fieldTy = fieldAt(em, cidVal, idx).ty
            var owned = fieldAt(em, cidVal, idx).manual
            var v = expr(em, value)
            if (let none = v) {
                return none
            }
            var vId = 0
            if (let some(vv) = v) {
                vId = vv
            }
            var vvt = Ty.Unknown
            if (let some(t) = tyOf(em, value.span)) {
                vvt = t
            }
            var obj = expr(em, object)
            if (let none = obj) {
                return none
            }
            var objId = 0
            if (let some(o) = obj) {
                objId = o
            }
            return fieldAssign(em, e.span, op, objId, fieldTy, idx, vId, vvt, owned)
        }
// `obj.prop = value` dispatches the property's setter.
        var fidO = em.propertyIds.get(tripleKey(str(cidVal), name, str(true)))
        if (let some(fid) = fidO) {
            if (op != AssignOp.Assign) {
                // `obj.prop op= value`: read through the getter, combine,
                // call the setter with the result.
                var getFidO = em.propertyIds.get(tripleKey(str(cidVal), name, str(false)))
                if (let none = getFidO) {
                    bad(em, e.span, "property `" + name + "` has no getter")
                    return none
                }
                var getFid = 0
                if (let some(g) = getFidO) {
                    getFid = g
                }
                var obj = expr(em, object)
                if (let none = obj) {
                    return none
                }
                var objId = 0
                if (let some(o) = obj) {
                    objId = o
                }
                var ptyTy = propertyTyOf(em, classOfName(em, cidVal), name)
                var curO = callMethod(em, e, getFid, emptyCallArgs(), objId)
                if (let none = curO) {
                    return none
                }
                var cur = 0
                if (let some(c) = curO) {
                    cur = c
                }
                var v = expr(em, value)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dstO = combineCompound(em, e.span, op, ptyTy, cur, vId, "property")
                if (let none = dstO) {
                    return none
                }
                var dst = 0
                if (let some(d) = dstO) {
                    dst = d
                }
                var packed = dst
                if (irTyTag(em.irModule.funcs[fid].params[1].ty) == irTyTag(IrTy.Ptr)) {
                    var w = optionWrap(em, dst, ptyTy, value.span)
                    if (let none = w) {
                        return none
                    }
                    if (let some(wv) = w) {
                        packed = wv
                    }
                }
                var dsti = temp(em)
                instr(em, IrInstr.Call(dsti, Callee.Func(fid), [objId, packed]))
                // A property setter is a real call: a throwing accessor leaves the
                // flag set, and the assignment's result is meaningless until we
                // have left.
                guardPropagation(em, fid)
                return dst
            }
            var obj = expr(em, object)
            if (let none = obj) {
                return none
            }
            var objId = 0
            if (let some(o) = obj) {
                objId = o
            }
            var v = expr(em, value)
            if (let none = v) {
                return none
            }
            var vId = 0
            if (let some(vv) = v) {
                vId = vv
            }
            var vt = Ty.Unknown
            if (let some(t) = tyOf(em, value.span)) {
                vt = t
            }
            var packed = vId
            if (irTyTag(em.irModule.funcs[fid].params[1].ty) == irTyTag(IrTy.Ptr)) {
                var w = optionWrap(em, vId, vt, value.span)
                if (let none = w) {
                    return none
                }
                if (let some(wv) = w) {
                    packed = wv
                }
            }
            var dst = temp(em)
            instr(em, IrInstr.Call(dst, Callee.Func(fid), [objId, packed]))
            // Same for the compound form: the read-modify-write calls a setter,
            // which is where the read-modify-write result comes back through.
            guardPropagation(em, fid)
            return vId
        }
        bad(em, e.span, "`" + name + "` is not a field or settable property of this `" + classOfName(em, cidVal) + "`")
        none
    }

    /// Read-modify-write/plain store of one field slot. Mirrors `field_assign`.

/// Emit `pickle_obj_slot_set(obj, slot, boxed)`. Mirrors `field_store`.

    /// Combine the current value `cur` of a compound-assignment target with the
    /// RHS `v` for operator `op`, where the target's declared type is `ty`.
    /// Scalar targets use the arithmetic binary op; `string` targets
    /// concatenate (`pickle_str_concat`), gated on `+=` because the checker
    /// does not validate compound operators, so any other operator on a string
    /// bails instead of being silently interpreted as concatenation. Other
    /// pointer-shape targets (`Option`, `List`, class instances, ...) have no
    /// compound operator and keep bailing. `what` names the target for the
    /// not-lowered diagnostic. Mirrors `combine_compound` in emit.rs.

    /// Declared info of the static field at static slot `slot` of class `cid`.
    /// Mirrors `static_field_at`.

    /// Plain or compound (`op=`) store of one static field cell. Mirrors
    /// `static_assign`.

    // ---- index assignment ----

    /// `xs[i] = v` / `xs[i] op= v` over lists, maps, string-typed targets and
    /// raw pointer elements. Mirrors `index_assign` in emit.rs.
fn indexAssign(em: Emitter, e: Expr, op: AssignOp, object: Expr, index: Expr, value: Expr) -> int? {
        var ot = tyOf(em, object.span)
        if (let some(t) = ot) {
            match (t) {
                case Ty.Map(k, v) -> {
                    return mapIndexAssign(em, op, object, index, value, k, v)
                }
                case _ -> {}
            }
        }
        var elemOpt: Ty? = none
        if (let some(t) = ot) {
            match (t) {
                case Ty.Ptr(pr) -> {
                    var scalarO = scalarIr(pr)
                    if (let none = scalarO) {
                        bad(em, e.span, "storing through a pointer to a managed value is not lowered yet")
                        return none
                    }
                    var ty = IrTy.Int
                    if (let some(s) = scalarO) {
                        ty = s
                    }
                    var baseO = expr(em, object)
                    if (let none = baseO) {
                        return none
                    }
                    var base = 0
                    if (let some(v) = baseO) {
                        base = v
                    }
                    var idxO = expr(em, index)
                    if (let none = idxO) {
                        return none
                    }
                    var idx = 0
                    if (let some(v) = idxO) {
                        idx = v
                    }
                    var addrO = ptrElementAddr(em, base, idx, ty, e.span)
                    if (let none = addrO) {
                        return none
                    }
                    var addr = 0
                    if (let some(v) = addrO) {
                        addr = v
                    }
                    if (op == AssignOp.Assign) {
                        var vO = expr(em, value)
                        if (let none = vO) {
                            return none
                        }
                        var v = 0
                        if (let some(vv) = vO) {
                            v = vv
                        }
                        instr(em, IrInstr.StoreRaw(addr, v, ty))
                        return v
                    }
                    var cur = temp(em)
                    instr(em, IrInstr.LoadRaw(cur, addr, ty))
                    var vO = expr(em, value)
                    if (let none = vO) {
                        return none
                    }
                    var v = 0
                    if (let some(vv) = vO) {
                        v = vv
                    }
                    var dst = temp(em)
                    instr(em, IrInstr.BinOp(dst, assignOpcode(op), cur, v))
                    instr(em, IrInstr.StoreRaw(addr, dst, ty))
                    return dst
                }
                case Ty.Ref(_) -> {
                    bad(em, e.span, "cannot write through an immutable reference (`&T`)")
                    return none
                }
                case Ty.String -> {
                    return strIndexAssign(em, e, op, object, index, value)
                }
                case Ty.List(pr) -> elemOpt = pr
                case _ -> {
                    bad(em, e.span, "index assignment over this type is not lowered yet")
                    return none
                }
            }
        }
        if (let none = elemOpt) {
            bad(em, e.span, "index assignment over this type is not lowered yet")
            return none
        }
        var elem = Ty.Unknown
        if (let some(x) = elemOpt) {
            elem = x
        }
        var repO = elemRep(em, elem, e.span)
        if (let none = repO) {
            return none
        }
        var rep = ElemRep.ptr()
        if (let some(r) = repO) {
            rep = r
        }
        var objO = expr(em, object)
        if (let none = objO) {
            return none
        }
        var obj = 0
        if (let some(v) = objO) {
            obj = v
        }
        var idxO = expr(em, index)
        if (let none = idxO) {
            return none
        }
        var idx = 0
        if (let some(v) = idxO) {
            idx = v
        }
        if (op == AssignOp.Assign) {
            var vO = expr(em, value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var ok = listStore(em, obj, idx, rep, elem, v)
            if (let none = ok) {
                return none
            }
            return v
        }
if (rep.isPtr) {
            if (elem != Ty.String) {
                bad(em, e.span, "compound assignment to a non-scalar list element is not lowered yet")
                return none
            }
            // String element: read the current string, concatenate, store back.
            var cur = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idx])
            var vO = expr(em, value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var dstO = combineCompound(em, e.span, op, elem, cur, v, "list element")
            if (let none = dstO) {
                return none
            }
            var dst = 0
            if (let some(d) = dstO) {
                dst = d
            }
            var ok = listStore(em, obj, idx, rep, elem, dst)
            if (let none = ok) {
                return none
            }
            return dst
        }
        var cur = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idx])
        var curV = externCallT1(em, rep.unboxSym, [IrTy.Ptr], rep.ir, [cur])
        var vO = expr(em, value)
        if (let none = vO) {
            return none
        }
        var v = 0
        if (let some(vv) = vO) {
            v = vv
        }
        var dst = temp(em)
        instr(em, IrInstr.BinOp(dst, assignOpcode(op), curV, v))
        var ok = listStore(em, obj, idx, rep, elem, dst)
        if (let none = ok) {
            return none
        }
        dst
    }

    /// `pickle_list_set(obj, idx, boxed)`: boxes a scalar element first.
    /// Mirrors `list_store`.

    /// `m[k] = v` / `m[k] op= v` over a `Map<K, V>`. Mirrors `map_index_assign`.
fn mapIndexAssign(em: Emitter, op: AssignOp, object: Expr, index: Expr, value: Expr, kty: Ty, vty: Ty) -> int? {
        var krepO = keyRep(em, kty, index.span)
        if (let none = krepO) {
            return none
        }
        var krep = ElemRep.ptr()
        if (let some(r) = krepO) {
            krep = r
        }
        var vrepO = elemRep(em, vty, object.span)
        if (let none = vrepO) {
            return none
        }
        var vrep = ElemRep.ptr()
        if (let some(r) = vrepO) {
            vrep = r
        }
        var objO = expr(em, object)
        if (let none = objO) {
            return none
        }
        var obj = 0
        if (let some(v) = objO) {
            obj = v
        }
        var kO = expr(em, index)
        if (let none = kO) {
            return none
        }
        var k = 0
        if (let some(v) = kO) {
            k = v
        }
var kTy = kty
        var kTyO = tyOf(em, index.span)
        if (let some(t) = kTyO) {
            kTy = t
        }
        var keyO = packMapKey(em, krep, k, kTy, index.span)
        if (let none = keyO) {
            return none
        }
        var key = 0
        if (let some(kk) = keyO) {
            key = kk
        }
        if (op == AssignOp.Assign) {
            var vO = expr(em, value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var vTy = IrTy.Int
            if (let some(t) = irty(em, value.span)) {
                vTy = t
            }
            var boxedO = boxForStore(em, vrep, v, vTy)
            if (let none = boxedO) {
                return none
            }
            var boxed = 0
            if (let some(b) = boxedO) {
                boxed = b
            }
            externCallVoid(em, "pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [obj, key, boxed])
            return v
        }
if (vrep.isPtr) {
            if (vty != Ty.String) {
                bad(em, object.span, "compound assignment to a non-scalar map value is not lowered yet")
                return none
            }
            // String value: an absent key reads as `""`, then the current
            // string is concatenated with the RHS and stored back.
            var defaultO = stringLiteral(em, emptyStrParts())
            if (let none = defaultO) {
                return none
            }
            var default = 0
            if (let some(d) = defaultO) {
                default = d
            }
            var cur = externCallT1(em, "pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, default])
            var vO = expr(em, value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var dstO = combineCompound(em, object.span, op, vty, cur, v, "map value")
            if (let none = dstO) {
                return none
            }
            var dst = 0
            if (let some(d) = dstO) {
                dst = d
            }
            externCallVoid(em, "pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [obj, key, dst])
            return dst
        }
        var zero = zeroScalar(em, vrep.ir, object.span)
        if (let none = zero) {
            return none
        }
        var zeroId = 0
        if (let some(z) = zero) {
            zeroId = z
        }
        var default = externCallT1(em, vrep.boxSym, [vrep.ir], IrTy.Ptr, [zeroId])
        var curPtr = externCallT1(em, "pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, default])
        var cur = externCallT1(em, vrep.unboxSym, [IrTy.Ptr], vrep.ir, [curPtr])
        var vO = expr(em, value)
        if (let none = vO) {
            return none
        }
        var v = 0
        if (let some(vv) = vO) {
            v = vv
        }
        var dst = temp(em)
        instr(em, IrInstr.BinOp(dst, assignOpcode(op), cur, v))
        var boxed = externCallT1(em, vrep.boxSym, [vrep.ir], IrTy.Ptr, [dst])
        externCallVoid(em, "pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [obj, key, boxed])
        dst
    }

    /// `s[i] = v` / `s[i] op= v` over a string: copy-on-write through
    /// `pickle_str_set`, storing back into the name/field the string came from.
    /// Mirrors `str_index_assign`.
fn strIndexAssign(em: Emitter, e: Expr, op: AssignOp, object: Expr, index: Expr, value: Expr) -> int? {
        match (object.kind) {
            case ExprKind.Ident(name) -> {
                var sO = expr(em, object)
                if (let none = sO) {
                    return none
                }
                var s = 0
                if (let some(v) = sO) {
                    s = v
                }
                var iO = expr(em, index)
                if (let none = iO) {
                    return none
                }
                var i = 0
                if (let some(v) = iO) {
                    i = v
                }
                var vO = byteRhs(em, value)
                if (let none = vO) {
                    return none
                }
                var v = 0
                if (let some(vv) = vO) {
                    v = vv
                }
                var byte = strIndexByte(em, op, s, i, v)
                var nsO = externCallT1(em, "pickle_str_set", [IrTy.Ptr, IrTy.Int, IrTy.Int], IrTy.Str, [s, i, byte])
                var ns = nsO
                var slotO = lookup(em, name)
                if (let some(slot) = slotO) {
                    instr(em, IrInstr.StoreSlot(slot, ns))
                    return ns
                }
                if (let some(cid) = em.owner) {
                    var idxO = instanceFieldIndex(em, cid, name)
                    if (let some(idx) = idxO) {
                        var fieldTy = fieldAt(em, cid, idx).ty
                        var owned = fieldAt(em, cid, idx).manual
                        var thO = thisValue(em, e)
                        if (let none = thO) {
                            return none
                        }
                        var th = 0
                        if (let some(thv) = thO) {
                            th = thv
                        }
                        var vt = Ty.String
                        if (let some(t) = tyOf(em, object.span)) {
                            vt = t
                        }
                        return fieldAssign(em, e.span, AssignOp.Assign, th, fieldTy, idx, ns, vt, owned)
                    }
                    var sfo = staticField(em, cid, name)
                    if (let some(sf) = sfo) {
                        if (!sf.info.mutable) {
                            bad(em, e.span, "cannot assign to immutable static field `" + name + "`")
                            return none
                        }
                        var vt = Ty.String
                        if (let some(t) = tyOf(em, object.span)) {
                            vt = t
                        }
                        return staticAssign(em, e.span, AssignOp.Assign, sf.dcid, sf.slot, sf.info.ty, ns, vt)
                    }
                }
                bad(em, e.span, "cannot assign to `" + name + "`")
                none
            }
case ExprKind.Member(mobj, mname) -> {
                var ot = tyOf(em, mobj.span)
                var o2: Ty? = ot
                if (let some(tt) = ot) {
                    match (tt) {
                        case Ty.Ptr(pr) -> o2 = pr
                        case _ -> {}
                    }
                }
                var cidVal = -1
                if (let some(oo) = o2) {
                    match (oo) {
                        case Ty.Class(_, _) -> {
                            var co = classIdOf(em, oo, e.span)
                            if (let some(c) = co) {
                                cidVal = c
                            }
                        }
                        case Ty.Struct(_, _) -> {
                            var co = classIdOf(em, oo, e.span)
                            if (let some(c) = co) {
                                cidVal = c
                            }
                        }
                        case _ -> {}
                    }
                }
                if (cidVal < 0) {
                    bad(em, e.span, "string index assignment over this member type is not lowered yet")
                    return none
                }
                var idxO = instanceFieldIndex(em, cidVal, mname)
                if (let none = idxO) {
                    bad(em, e.span, "`" + mname + "` is not a field of this `" + classOfName(em, cidVal) + "`")
                    return none
                }
                var idx = 0
                if (let some(v) = idxO) {
                    idx = v
                }
                var fieldTy = fieldAt(em, cidVal, idx).ty
                var owned = fieldAt(em, cidVal, idx).manual
                var moO = expr(em, mobj)
                if (let none = moO) {
                    return none
                }
                var mo = 0
                if (let some(v) = moO) {
                    mo = v
                }
                var idxc = intConst(em, idx)
                var raw = externCallT1(em, "pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [mo, idxc])
                var iO = expr(em, index)
                if (let none = iO) {
                    return none
                }
                var i = 0
                if (let some(v) = iO) {
                    i = v
                }
                var vO = byteRhs(em, value)
                if (let none = vO) {
                    return none
                }
                var v = 0
                if (let some(vv) = vO) {
                    v = vv
                }
                var byte = strIndexByte(em, op, raw, i, v)
                var ns = externCallT1(em, "pickle_str_set", [IrTy.Ptr, IrTy.Int, IrTy.Int], IrTy.Str, [raw, i, byte])
                var vt = Ty.String
                if (let some(t) = tyOf(em, object.span)) {
                    vt = t
                }
                return fieldAssign(em, e.span, AssignOp.Assign, mo, fieldTy, idx, ns, vt, owned)
            }
            case _ -> {
                bad(em, e.span, "string index assignment over a non-variable target is not lowered yet (strings are copy-on-write)")
                none
            }
        }
    }

    /// The byte (int ABI) to write into the string: an ASCII `char` literal
    /// lowers directly to its 0..=255 value; anything else lowers as its own
    /// value expression. Mirrors `byte_rhs`.
fn byteRhs(em: Emitter, value: Expr) -> int? {
        match (value.kind) {
            case ExprKind.Lit(Lit.Char(c)) -> {
                if ((c as int) <= 0x7F) {
                    return intConst(em, c as int)
                }
                expr(em, value)
            }
            case _ -> expr(em, value)
        }
    }

    /// The byte to write back for `s[i] op= v`: `v` itself for a plain store,
    /// or the current byte combined with `v` for a compound operator. Mirrors
    /// `str_index_byte`.


    /// Lower `if (cond) { then } else { other }`. A binding condition
    /// delegates to `if_let_expr`; otherwise the condition branches between
    /// the then-block and the else side (or the join when no else exists), and
    /// the matching side stores its value into `res_slot`. Mirrors `if_expr`
    /// in emit.rs.
fn ifExpr(em: Emitter, e: Expr, cond: IfCond, then: Block, elseElse: Expr?) -> int? {
        match (cond) {
            case IfCond.Binding(pattern, value) -> ifLetExpr(em, e, pattern, value, then, elseElse)
            case IfCond.Cond(c) -> {
                var condT = expr(em, c)
                if (let none = condT) {
                    return none
                }
                var condTV = 0
                if (let some(v) = condT) {
                    condTV = v
                }
                var resTy = irty(em, e.span)
                var needSlot = false
                if (matchResultNeedsSlot(resTy)) {
                    if (let some(_) = elseElse) {
                        needSlot = true
                    }
                }
                var resSlot: int? = none
                if (needSlot) {
                    var rt = IrTy.Unit
                    if (let some(x) = resTy) {
                        rt = x
                    }
                    resSlot = newSlot(em, rt)
                }
                var thenId = newBlock(em)
                var elseId: int? = none
                if (let some(_) = elseElse) {
                    elseId = newBlock(em)
                }
                var join = newBlock(em)
                var eid = join
                if (let some(x) = elseId) {
                    eid = x
                }
                term(em, IrTerm.BranchIf(condTV, thenId, eid))
                em.cur = thenId
                pushScope(em)
                if (!(blockIntoSlot(em, then, resSlot))) {
                    popScope(em)
                    return none
                }
                popScope(em)
                term(em, IrTerm.Branch(join))
                if (let some(ee) = elseElse) {
                    var els = join
                    if (let some(x) = elseId) {
                        els = x
                    }
                    em.cur = els
                    if (let some(slot) = resSlot) {
                        var t = expr(em, ee)
                        if (let none = t) {
                            return none
                        }
                        var tv = 0
                        if (let some(x) = t) {
                            tv = x
                        }
                        var isPtrSlot = false
                        if (slot < len(em.fslots)) {
                            if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                                isPtrSlot = true
                            }
                        }
                        if (isPtrSlot) {
                            var ty = Ty.Unknown
                            if (let some(gt) = tyOf(em, ee.span)) {
                                ty = gt
                            }
                            var wv = optionWrap(em, tv, ty, ee.span)
                            if (let none = wv) {
                                return none
                            }
                            var vv = 0
                            if (let some(x) = wv) {
                                vv = x
                            }
                            instr(em, IrInstr.StoreSlot(slot, vv))
                        } else {
                            instr(em, IrInstr.StoreSlot(slot, tv))
                        }
                    } else {
                        if (let none = expr(em, ee)) {
                            return none
                        }
                    }
                    term(em, IrTerm.Branch(join))
                }
                em.cur = join
                if (let some(slot) = resSlot) {
                    return load(em, slot)
                }
                unitTemp(em)
            }
        }
    }

    /// Lower `if (let pattern = value) { then } [else ...]`: the value is
    /// evaluated once into a slot, `pattern_test_cond` gates the then-block
    /// (always-true binding/wildcard patterns need no branch), and bindings
    /// are scoped to the then-block only. Mirrors `if_let_expr` in emit.rs.
fn ifLetExpr(em: Emitter, e: Expr, pattern: Pattern, value: Expr, then: Block, elseElse: Expr?) -> int? {
        var st = Ty.Unknown
        if (let some(t) = tyOf(em, value.span)) {
            st = t
        }
        var sIr = matchScrutineeIr(em, st)
        var sIrV = IrTy.Ptr
        if (let some(x) = sIr) {
            sIrV = x
        }
        var v = expr(em, value)
        if (let none = v) {
            return none
        }
        var vv = 0
        if (let some(x) = v) {
            vv = x
        }
        var sSlot = newSlot(em, sIrV)
        instr(em, IrInstr.StoreSlot(sSlot, vv))
        var resTy = irty(em, e.span)
        var needSlot = false
        if (matchResultNeedsSlot(resTy)) {
            if (let some(_) = elseElse) {
                needSlot = true
            }
        }
        var resSlot: int? = none
        if (needSlot) {
            var rt = IrTy.Unit
            if (let some(x) = resTy) {
                rt = x
            }
            resSlot = newSlot(em, rt)
        }
        var always = false
        match (pattern) {
            case Pattern.Binding(_, _) -> always = true
            case Pattern.Wildcard -> always = true
            case _ -> {}
        }
        var thenId = newBlock(em)
        var elseId: int? = none
        if (let some(_) = elseElse) {
            elseId = newBlock(em)
        }
        var join = newBlock(em)
        if (always) {
            term(em, IrTerm.Branch(thenId))
            em.cur = thenId
            pushScope(em)
            var bv = load(em, sSlot)
            if (!(bindMatchValue(em, pattern, st, bv, value.span))) {
                popScope(em)
                return none
            }
            if (!(blockIntoSlot(em, then, resSlot))) {
                popScope(em)
                return none
            }
            popScope(em)
            term(em, IrTerm.Branch(join))
        } else {
            var sv = load(em, sSlot)
            var cond = patternTestCond(em, pattern, st, sv, value.span)
            if (let none = cond) {
                return none
            }
            var condV = 0
            if (let some(c) = cond) {
                condV = c
            }
            var eid = join
            if (let some(x) = elseId) {
                eid = x
            }
            term(em, IrTerm.BranchIf(condV, thenId, eid))
            em.cur = thenId
            pushScope(em)
            var bv = load(em, sSlot)
            if (!(bindMatchValue(em, pattern, st, bv, value.span))) {
                popScope(em)
                return none
            }
            if (!(blockIntoSlot(em, then, resSlot))) {
                popScope(em)
                return none
            }
            popScope(em)
            term(em, IrTerm.Branch(join))
        }
        if (let some(ee) = elseElse) {
            var els = join
            if (let some(x) = elseId) {
                els = x
            }
            em.cur = els
            if (let some(slot) = resSlot) {
                var t = expr(em, ee)
                if (let none = t) {
                    return none
                }
                var tv = 0
                if (let some(x) = t) {
                    tv = x
                }
                var isPtrSlot = false
                if (slot < len(em.fslots)) {
                    if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                        isPtrSlot = true
                    }
                }
                if (isPtrSlot) {
                    var ty = Ty.Unknown
                    if (let some(gt) = tyOf(em, ee.span)) {
                        ty = gt
                    }
                    var wv = optionWrap(em, tv, ty, ee.span)
                    if (let none = wv) {
                        return none
                    }
                    var vv = 0
                    if (let some(x) = wv) {
                        vv = x
                    }
                    instr(em, IrInstr.StoreSlot(slot, vv))
                } else {
                    instr(em, IrInstr.StoreSlot(slot, tv))
                }
            } else {
                if (let none = expr(em, ee)) {
                    return none
                }
            }
            term(em, IrTerm.Branch(join))
        }
        em.cur = join
        if (let some(slot) = resSlot) {
            return load(em, slot)
        }
        unitTemp(em)
    }

    /// Lower `match` over any scrutinee. Enum scrutinees use tag equality to
    /// route each `Enum.Variant(..)`/or-pattern arm; everything else delegates
    /// to `lower_generic_match`. A non-exhaustive chain panics at runtime.
    /// Mirrors `match_expr` in emit.rs.
fn matchExpr(em: Emitter, e: Expr, scrutinee: Expr, arms: List<MatchArm>) -> int? {
        var st0 = tyOf(em, scrutinee.span)
        if (let none = st0) {
            bad(em, e.span, "matching over non-enum values is not lowered yet")
            return none
        }
        var st = Ty.Unknown
        if (let some(s) = st0) {
            st = s
        }
        var isEnum = false
        match (st) {
            case Ty.Enum(_, _) -> isEnum = true
            case _ -> {}
        }
        if (!isEnum) {
            return lowerGenericMatch(em, e, scrutinee, arms, st)
        }
        var enumName = ""
        match (st) {
            case Ty.Enum(en, _) -> enumName = en
            case _ -> {}
        }
        var tableO: EnumTable? = none
        if (let some(entry) = em.resolved.types.get(enumName)) {
            match (entry) {
                case TypeTableEntry.Enum(t) -> tableO = t
                case _ -> {}
            }
        }
        if (let none = tableO) {
            bad(em, e.span, "unknown enum type `" + enumName + "`")
            return none
        }
        if (let some(t) = tableO) {
            return lowerEnumMatchTable(em, e, scrutinee, arms, enumName, t)
        }
        none
    }

    /// The enum-tag `match` lowering (Rust `match_expr` with the `ty_of` /
    /// table lookup already resolved). The scrutinee lives in a `Ptr` slot;
    /// arms branch on `pickle_enum_tag` equality, bind payloads, and join at
    /// a common block.
fn lowerEnumMatchTable(em: Emitter, e: Expr, scrutinee: Expr, arms: List<MatchArm>, enumName: string, table: EnumTable) -> int? {
        var s = expr(em, scrutinee)
        if (let none = s) {
            return none
        }
        var sV = 0
        if (let some(x) = s) {
            sV = x
        }
        var sSlot = newSlot(em, IrTy.Ptr)
        instr(em, IrInstr.StoreSlot(sSlot, sV))
        var resTy = irty(em, e.span)
        var resSlot: int? = none
        if (matchResultNeedsSlot(resTy)) {
            var rt = IrTy.Unit
            if (let some(x) = resTy) {
                rt = x
            }
            resSlot = newSlot(em, rt)
        }
        var sv = load(em, sSlot)
        var tag = externCallT1(em, "pickle_enum_tag", [IrTy.Ptr], IrTy.Int, [sv])
        var join = newBlock(em)
        var cur = em.cur
        var chainLive = true
        for (arm in arms) {
            var body = newBlock(em)
            var guard = arm.guard
            var hasPayloadCond = false
            match (arm.pattern) {
                case Pattern.Variant(_, pl) -> {
                    for (plp in pl) {
                        var isPlSimple = false
                        match (plp) {
                            case Pattern.Wildcard -> isPlSimple = true
                            case Pattern.Binding(_, _) -> isPlSimple = true
                            case _ -> {}
                        }
                        if (!isPlSimple) {
                            hasPayloadCond = true
                        }
                    }
                }
                case _ -> {}
            }
            var guardIn = body
            if (let some(_) = guard) {
                guardIn = newBlock(em)
            } else {
                if (hasPayloadCond) {
                    guardIn = newBlock(em)
                }
            }
            var isCatchAll = false
            var bindName: string? = none
            match (arm.pattern) {
                case Pattern.Wildcard -> isCatchAll = true
                case Pattern.Binding(nm, _) -> {
                    bindName = nm
                    isCatchAll = true
                }
                case _ -> {}
            }
            if (isCatchAll) {
                if (let some(g) = guard) {
                    if (chainLive) {
                        em.cur = cur
                        term(em, IrTerm.Branch(guardIn))
                        cur = newBlock(em)
                        em.cur = guardIn
                        pushScope(em)
                        if (let some(nm) = bindName) {
                            var slot = newSlot(em, IrTy.Ptr)
                            var bv = load(em, sSlot)
                            instr(em, IrInstr.StoreSlot(slot, bv))
                            declare(em, nm, slot)
                        }
                        var cond = expr(em, g)
                        if (let none = cond) {
                            popScope(em)
                            return none
                        }
                        var condV = 0
                        if (let some(x) = cond) {
                            condV = x
                        }
                        term(em, IrTerm.BranchIf(condV, body, cur))
                        em.cur = body
                        if (!(matchArmBody(em, arm.body, resSlot))) {
                            popScope(em)
                            return none
                        }
                        popScope(em)
                        term(em, IrTerm.Branch(join))
                    } else {
                        em.cur = guardIn
                        pushScope(em)
                        if (let some(nm) = bindName) {
                            var slot = newSlot(em, IrTy.Ptr)
                            var bv = load(em, sSlot)
                            instr(em, IrInstr.StoreSlot(slot, bv))
                            declare(em, nm, slot)
                        }
                        var cond = expr(em, g)
                        if (let none = cond) {
                            popScope(em)
                            return none
                        }
                        var condV = 0
                        if (let some(x) = cond) {
                            condV = x
                        }
                        term(em, IrTerm.BranchIf(condV, body, join))
                        em.cur = body
                        if (!(matchArmBody(em, arm.body, resSlot))) {
                            popScope(em)
                            return none
                        }
                        popScope(em)
                        term(em, IrTerm.Branch(join))
                    }
                    continue
                }
                if (chainLive) {
                    em.cur = cur
                    term(em, IrTerm.Branch(body))
                    chainLive = false
                }
                em.cur = body
                pushScope(em)
                if (let some(nm) = bindName) {
                    var slot = newSlot(em, IrTy.Ptr)
                    var bv = load(em, sSlot)
                    instr(em, IrInstr.StoreSlot(slot, bv))
                    declare(em, nm, slot)
                }
                if (!(matchArmBody(em, arm.body, resSlot))) {
                    popScope(em)
                    return none
                }
                popScope(em)
                term(em, IrTerm.Branch(join))
            } else {
                match (arm.pattern) {
                    case Pattern.Variant(path, payloads) -> {
                        var vname = ""
                        var isPath = false
                        if (len(path) == 2) {
                            vname = path[1]
                            isPath = true
                        }
                        if (len(path) == 1) {
                            vname = path[0]
                            isPath = true
                        }
                        if (!isPath) {
                            bad(em, arm.span, "invalid enum variant pattern")
                            return none
                        }
                        var vi = -1
                        var vfound = false
                        var vii = 0
                        for (v in table.variants) {
                            if (v.name == vname) {
                                vi = vii
                                vfound = true
                                break
                            }
                            vii = vii + 1
                        }
                        if (!vfound) {
                            bad(em, arm.span, "enum `" + enumName + "` has no variant `" + vname + "`")
                            return none
                        }
                        if (chainLive) {
                            em.cur = cur
                            var viT = temp(em)
                            instr(em, IrInstr.Const(viT, IrConst.Int(vi)))
                            var c = temp(em)
                            instr(em, IrInstr.BinOp(c, IrBinOp.Eq, tag, viT))
                            var next = newBlock(em)
                            term(em, IrTerm.BranchIf(c, guardIn, next))
                            cur = next
                        }
                        em.cur = guardIn
                        pushScope(em)
                        var payloadCond = bindEnumPayloads(em, arm.span, table, vi, payloads, sSlot)
                        if (let none = payloadCond) {
                            popScope(em)
                            return none
                        }
                        var cf = -1
                        if (let some(pc) = payloadCond) {
                            cf = pc
                        }
                        if (let some(g) = guard) {
                            var cond = expr(em, g)
                            if (let none = cond) {
                                popScope(em)
                                return none
                            }
                            var condV = 0
                            if (let some(x) = cond) {
                                condV = x
                            }
                            if (cf == -1) {
                                cf = condV
                            } else {
                                cf = combineCond(em, true, cf, condV)
                            }
                        }
                        if (!(cf == -1)) {
                            var fall = join
                            if (chainLive) {
                                fall = cur
                            }
                            term(em, IrTerm.BranchIf(cf, body, fall))
                            em.cur = body
                        }
                        if (!(matchArmBody(em, arm.body, resSlot))) {
                            popScope(em)
                            return none
                        }
                        popScope(em)
                        term(em, IrTerm.Branch(join))
                    }
                    case Pattern.Or(alts) -> {
                        if (chainLive) {
                            em.cur = cur
                        }
                        var tagTest: int? = none
                        for (alt in alts) {
                            match (alt) {
                                case Pattern.Variant(p, pl) -> {
                                    for (pla in pl) {
                                        match (pla) {
                                            case Pattern.Wildcard -> {}
                                            case _ -> {
                                                bad(em, arm.span, "enum or-pattern alternatives may only use `_` payloads")
                                                return none
                                            }
                                        }
                                    }
                                    var ovn = ""
                                    var ois = false
                                    if (len(p) == 2) {
                                        ovn = p[1]
                                        ois = true
                                    }
                                    if (len(p) == 1) {
                                        ovn = p[0]
                                        ois = true
                                    }
                                    if (!ois) {
                                        bad(em, arm.span, "invalid enum variant pattern")
                                        return none
                                    }
                                    var ovi = -1
                                    var ofound = false
                                    var oi = 0
                                    for (v in table.variants) {
                                        if (v.name == ovn) {
                                            ovi = oi
                                            ofound = true
                                            break
                                        }
                                        oi = oi + 1
                                    }
                                    if (!ofound) {
                                        bad(em, arm.span, "enum `" + enumName + "` has no variant `" + ovn + "`")
                                        return none
                                    }
                                    var viT = constTemp(em, IrConst.Int(ovi))
                                    var c = temp(em)
                                    instr(em, IrInstr.BinOp(c, IrBinOp.Eq, tag, viT))
                                    if (let some(prev) = tagTest) {
                                        tagTest = combineCond(em, false, prev, c)
                                    } else {
                                        tagTest = c
                                    }
                                }
                                case _ -> {
                                    bad(em, arm.span, "enum or-pattern alternatives must be variant patterns")
                                    return none
                                }
                            }
                        }
                        var condV = 0
                        if (let some(cv) = tagTest) {
                            condV = cv
                        } else {
                            bad(em, arm.span, "an or-pattern has no alternatives")
                            return none
                        }
                        if (chainLive) {
                            var next = newBlock(em)
                            term(em, IrTerm.BranchIf(condV, guardIn, next))
                            cur = next
                        }
                        em.cur = guardIn
                        pushScope(em)
                        if (let some(g) = guard) {
                            var cond = expr(em, g)
                            if (let none = cond) {
                                popScope(em)
                                return none
                            }
                            var cv2 = 0
                            if (let some(x) = cond) {
                                cv2 = x
                            }
                            var fall = join
                            if (chainLive) {
                                fall = cur
                            }
                            term(em, IrTerm.BranchIf(cv2, body, fall))
                            em.cur = body
                        }
                        if (!(matchArmBody(em, arm.body, resSlot))) {
                            popScope(em)
                            return none
                        }
                        popScope(em)
                        term(em, IrTerm.Branch(join))
                    }
                    case _ -> {
                        bad(em, arm.span, "this match pattern is not lowered yet")
                        return none
                    }
                }
            }
        }
        if (chainLive) {
            em.cur = cur
            panicNoMatchAt(em, e.span, sv)
            term(em, IrTerm.Branch(join))
        }
        em.cur = join
        if (let some(slot) = resSlot) {
            return load(em, slot)
        }
        unitTemp(em)
    }

    /// Lower `match` over non-enum scrutinees: numeric scalars, `bool`,
    /// `char`, `byte`, `string`, and options (`some(v)`/`none`). Literal
    /// patterns become equality tests against the scrutinee slot; a
    /// binding/wildcard arm catches everything that reaches it. A
    /// non-exhaustive chain fails loudly at runtime. Mirrors
    /// `lower_generic_match` in emit.rs.
fn lowerGenericMatch(em: Emitter, e: Expr, scrutinee: Expr, arms: List<MatchArm>, st: Ty) -> int? {
        var sIr = matchScrutineeIr(em, st)
        if (let none = sIr) {
            bad(em, e.span, "matching over `" + bareName(st) + "` values is not lowered yet")
            return none
        }
        var sIrV = IrTy.Unit
        if (let some(x) = sIr) {
            sIrV = x
        }
        var s = expr(em, scrutinee)
        if (let none = s) {
            return none
        }
        var sV = 0
        if (let some(x) = s) {
            sV = x
        }
        var sSlot = newSlot(em, sIrV)
        instr(em, IrInstr.StoreSlot(sSlot, sV))
        var resTy = irty(em, e.span)
        var resSlot: int? = none
        if (matchResultNeedsSlot(resTy)) {
            var rt = IrTy.Unit
            if (let some(x) = resTy) {
                rt = x
            }
            resSlot = newSlot(em, rt)
        }
        var join = newBlock(em)
        var cur = em.cur
        var chainLive = true
for (arm in arms) {
            var body = newBlock(em)
            var guard = arm.guard
            var guardIn = body
            if (let some(_) = guard) {
                guardIn = newBlock(em)
            }
            var testable: Pattern? = none
            match (arm.pattern) {
                case Pattern.Wildcard -> {}
                case Pattern.Binding(_, _) -> {}
                case other -> testable = other
            }
            if (let some(p) = testable) {
                if (chainLive) {
                    em.cur = cur
                    var sv = load(em, sSlot)
                    var cond = patternTestCond(em, p, st, sv, arm.span)
                    if (let none = cond) {
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    var next = newBlock(em)
                    term(em, IrTerm.BranchIf(condV, guardIn, next))
                    cur = next
                }
                em.cur = guardIn
                pushScope(em)
                var bv = load(em, sSlot)
                if (!(bindMatchValue(em, arm.pattern, st, bv, arm.span))) {
                    popScope(em)
                    return none
                }
                if (let some(g) = guard) {
                    var cond = expr(em, g)
                    if (let none = cond) {
                        popScope(em)
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    var fall = join
                    if (chainLive) {
                        fall = cur
                    }
                    term(em, IrTerm.BranchIf(condV, body, fall))
                    em.cur = body
                }
                if (!(matchArmBody(em, arm.body, resSlot))) {
                    popScope(em)
                    return none
                }
                popScope(em)
                term(em, IrTerm.Branch(join))
                continue
            }
            if (let some(g) = guard) {
                if (chainLive) {
                    em.cur = cur
                    term(em, IrTerm.Branch(guardIn))
                    cur = newBlock(em)
                    em.cur = guardIn
                    pushScope(em)
                    var bv = load(em, sSlot)
                    if (!(bindMatchValue(em, arm.pattern, st, bv, arm.span))) {
                        popScope(em)
                        return none
                    }
                    var cond = expr(em, g)
                    if (let none = cond) {
                        popScope(em)
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    term(em, IrTerm.BranchIf(condV, body, cur))
                    em.cur = body
                    if (!(matchArmBody(em, arm.body, resSlot))) {
                        popScope(em)
                        return none
                    }
                    popScope(em)
                    term(em, IrTerm.Branch(join))
                } else {
                    em.cur = guardIn
                    pushScope(em)
                    var bv = load(em, sSlot)
                    if (!(bindMatchValue(em, arm.pattern, st, bv, arm.span))) {
                        popScope(em)
                        return none
                    }
                    var cond = expr(em, g)
                    if (let none = cond) {
                        popScope(em)
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    term(em, IrTerm.BranchIf(condV, body, join))
                    em.cur = body
                    if (!(matchArmBody(em, arm.body, resSlot))) {
                        popScope(em)
                        return none
                    }
                    popScope(em)
                    term(em, IrTerm.Branch(join))
                }
                continue
            }
            if (chainLive) {
                em.cur = cur
                term(em, IrTerm.Branch(body))
                chainLive = false
            }
            em.cur = body
            pushScope(em)
            var bv = load(em, sSlot)
            if (!(bindMatchValue(em, arm.pattern, st, bv, arm.span))) {
                popScope(em)
                return none
            }
            if (!(matchArmBody(em, arm.body, resSlot))) {
                popScope(em)
                return none
            }
            popScope(em)
            term(em, IrTerm.Branch(join))
        }
        if (chainLive) {
            em.cur = cur
            externCallVoid(em, "pickle_panic_no_match", emptyIrTys(), emptyInts())
            term(em, IrTerm.Branch(join))
        }
        em.cur = join
        if (let some(slot) = resSlot) {
            return load(em, slot)
        }
        unitTemp(em)
    }

    /// The branch condition under which `p` matches the scrutinee value `a`
    /// (already loaded): `none` tests absence; `some(payload)` tests presence
    /// (recursing for nested payload patterns); tuple patterns AND each
    /// element; `a | b` ORs alternatives; literal patterns test equality.
    /// Mirrors `pattern_test_cond` in emit.rs.

    /// The match condition contributed by tuple element `i` (read from the
    /// tuple pointer `a`): bindings/wildcards are always true; a testable
    /// nested pattern is unboxed to the element's IR domain and recursed.
    /// Mirrors `tuple_part_cond` in emit.rs.

    /// Build a constant in the scrutinee's domain for a literal pattern. A
    /// float scrutinee widens integer literals; a byte scrutinee accepts
    /// ASCII char literals. Mirrors `pattern_literal_temp` in emit.rs (the
    /// float-to-int path uses a truncate-and-round-trip check because Pk
    /// floats expose no `trunc`).


    /// The IR domain a match scrutinee (`match`/`if let`) is kept in: scalars
    /// as themselves, strings as `Str` foreign pointers, and every composite
    /// (option/list/map/class/struct/enum/interface/tuple/range) as a managed
    /// `Ptr`. Mirrors `match_scrutinee_ir` in emit.rs.

    /// Bind the names an arm pattern introduces to the scrutinee value `v`
    /// (already loaded, of type `st`) in the current block. Bindings declare
    /// under `map_ty`; `some(v)` unboxes the present option; tuple patterns
    /// unbox each element; or-patterns bind nothing (the checker only admits
    /// name-free or-patterns); `_`/literals bind nothing. Mirrors
    /// `bind_match_value` in emit.rs.

    /// Bind a nested pattern to a value `v` of type `ty` already in IR form
    /// (a `some` payload or a tuple element). Mirrors `bind_pattern_value`
    /// in emit.rs.
    /// Store an arm body's value into the match's result slot, lifting scalar
    /// values when the slot is a `Ptr` (an option-typed result). Mirrors
    /// `match_arm_body` in emit.rs.
fn matchArmBody(em: Emitter, body: Expr, resSlot: int?) -> bool {
        var bt = expr(em, body)
        if (let none = bt) {
            return false
        }
        var btv = 0
        if (let some(x) = bt) {
            btv = x
        }
        if (let some(slot) = resSlot) {
            var isPtrSlot = false
            if (slot < len(em.fslots)) {
                if (irTyTag(em.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                    isPtrSlot = true
                }
            }
            if (isPtrSlot) {
                var btTy = Ty.Unknown
                if (let some(t) = tyOf(em, body.span)) {
                    btTy = t
                }
                var wv = optionWrap(em, btv, btTy, body.span)
                if (let none = wv) {
                    return false
                }
                var wvv = 0
                if (let some(x) = wv) {
                    wvv = x
                }
                instr(em, IrInstr.StoreSlot(slot, wvv))
            } else {
                instr(em, IrInstr.StoreSlot(slot, btv))
            }
        }
        true
    }

    /// Bind the payload fields of variant `vi` of `table` into fresh slots for
    /// `Color.Rgb(r, g, b)` patterns, and return the folded match condition
    /// contributed by any nested (non-binding) payload patterns. A `-1`
    /// return means no condition (every payload bound a name or `_`); `none`
    /// reports an emission error. Fields are boxed in the object, so each is
    /// unboxed to its element IR type; nested patterns bind the names they
    /// introduce and contribute a condition. Mirrors `bind_enum_payloads` in
    /// emit.rs.

    /// The match condition for an enum variant pattern: the scrutinee value
    /// `v` (of enum type `st`) must carry the variant's tag, and nested
    /// payload conditions are folded in. Payload fields are read only inside a
    /// block guarded by the tag equality, so a mismatched variant is never
    /// dereferenced. Mirrors `enum_variant_cond` in emit.rs.

    /// Fold the extra match conditions contributed by the nested (non-binding)
    /// payload patterns of enum variant `vi`, whose object pointer sits in the
    /// rooted slot `vSlot`. Binding names are declared separately by
    /// `bindEnumPayloads`; a `-1` return means every payload was a name or
    /// `_`. Mirrors `bind_enum_payload_cond` in emit.rs.

    // ---- calls ----

    /// The first user (non-builtin, non-overloaded) callable for `name`.
    /// Rust's `infos.iter().find(|c| !(c.span.file.0 == 0 && c.span.end == 0))`.

    /// Is `callee` a general function-typed expression (as opposed to a plain
    /// named user/ctor/builtin call, which has its own static paths)? Mirrors
    /// `is_fn_dispatchable` in emit.rs.

    /// The value argument of the outermost `expect(...)` in an assertion chain,
    /// plus whether a `.not()` flips the expectation. Mirrors `peel_expect`.

    /// The value argument of a positional-only one-arg expectation method, or
    /// `none` after emitting a diagnostic. Mirrors `expect_single_arg`.

    /// Reject any argument list for a zero-arg expectation method. Returns
    /// `false` (after a diagnostic) when the list is non-empty.
    /// Hash-identity or structural equality condition for `toBe`/`toEqual`.
    /// Mirrors `expect_eq_cond`.

    /// `int` -> `float` promotion (the IR `Itof`). Mirrors `float_cast`.

    /// Promote `v` to `float` unless its IR type is already `Float`. Mirrors
    /// `emit.rs::coerce_to_float`.

    /// `**`: integer operands stay integral (`pickle_int_pow`); a float on
    /// either side routes through `pickle_float_pow`, promoting the other
    /// operand with an `Itof`. Mirrors `emit.rs` `AstBinOp::Pow`.
fn emitPow(em: Emitter, e: Expr, lhs: Expr, rhs: Expr) -> int? {
        var aO = expr(em, lhs)
        if (let none = aO) {
            return none
        }
        var bO = expr(em, rhs)
        if (let none = bO) {
            return none
        }
        var a = 0
        if (let some(v) = aO) {
            a = v
        }
        var b = 0
        if (let some(v) = bO) {
            b = v
        }
        var aT = irty(em, lhs.span)
        var bT = irty(em, rhs.span)
        var useFloat = false
        if (let some(t) = aT) {
            match (t) {
                case IrTy.Float -> useFloat = true
                case _ -> {}
            }
        }
        if (let some(t) = bT) {
            match (t) {
                case IrTy.Float -> useFloat = true
                case _ -> {}
            }
        }
        if (useFloat) {
            var af = coerceToFloat(em, a, aT)
            var bf = coerceToFloat(em, b, bT)
            return externCallT1(em, "pickle_float_pow", [IrTy.Float, IrTy.Float], IrTy.Float, [af, bf])
        }
        return externCallT1(em, "pickle_int_pow", [IrTy.Int, IrTy.Int], IrTy.Int, [a, b])
    }

    /// `in`: the right operand selects the container. Mirrors `emit.rs`
    /// `AstBinOp::In` - a `Map` keys through `pickle_map_has`, a `List` routes
    /// through `pickle_list_contains`, a `string` through `pickle_str_contains`.
fn emitIn(em: Emitter, e: Expr, lhs: Expr, rhs: Expr) -> int? {
        if (let some(t) = tyOf(em, rhs.span)) {
            match (t) {
                case Ty.Map(k, _) -> {
                    if (let some(krep) = keyRep(em, k, rhs.span)) {
                        return emitInContains(em, e, lhs, rhs, krep, k, "pickle_map_has")
                    }
                    return none
                }
                case Ty.List(el) -> {
                    if (let some(erep) = elemRep(em, el, rhs.span)) {
                        return emitInContains(em, e, lhs, rhs, erep, el, "pickle_list_contains")
                    }
                    return none
                }
                case Ty.String -> {
                    var needle = expr(em, lhs)
                    if (let some(nv) = needle) {
                        var hay = expr(em, rhs)
                        if (let some(hv) = hay) {
                            return externCallT1(em, "pickle_str_contains", [IrTy.Str, IrTy.Str], IrTy.Bool, [hv, nv])
                        }
                    }
                    return none
                }
                case _ -> {}
            }
        }
        bad(em, e.span, "`in` requires a `List`, `Map`, or `string` on the right")
        return none
    }

    /// Shared tail of the `Map`/`List` `in` arms: evaluate the needle and the
    /// container, box the needle to the container's element representation, and
    /// emit the containment call.
fn emitInContains(em: Emitter, e: Expr, lhs: Expr, rhs: Expr, rep: ElemRep, elemTy: Ty, symbol: string) -> int? {
        var needle = expr(em, lhs)
        if (let none = needle) {
            return none
        }
        var coll = expr(em, rhs)
        if (let none = coll) {
            return none
        }
        var nv = 0
        if (let some(v) = needle) {
            nv = v
        }
        var cv = 0
        if (let some(v) = coll) {
            cv = v
        }
        var nTy = elemTy
        if (let some(x) = tyOf(em, lhs.span)) {
            nTy = x
        }
        if (let some(key) = packMapKey(em, rep, nv, nTy, lhs.span)) {
            return externCallT1(em, symbol, [IrTy.Ptr, IrTy.Ptr], IrTy.Bool, [cv, key])
        }
        return none
    }

    /// `<-`: a channel send, a statement with a unit result. The compiler
    /// yields the value-typed `0` so an expression position stays well-formed.
    /// Mirrors `emit.rs` `AstBinOp::Send`.
fn emitSend(em: Emitter, lhs: Expr, rhs: Expr) -> int? {
        var ch = expr(em, lhs)
        if (let none = ch) {
            return none
        }
        var v = expr(em, rhs)
        if (let none = v) {
            return none
        }
        var chV = 0
        if (let some(x) = ch) {
            chV = x
        }
        var vV = 0
        if (let some(x) = v) {
            vV = x
        }
        externCallVoid(em, "pickle_channel_send", [IrTy.Int, IrTy.Int], [chV, vV])
        return intConst(em, 0)
    }

    /// Truthiness as a branchable condition of a raw value temp. `need` is
    /// `true` when a truthy value passes (folded through `.not()`). Mirrors
    /// `expect_truthy`.

    /// Render a value temp as text for an `Expected:`/`Received:` line.
    /// Mirrors `expect_str`.

    /// Lower one `expect(...)` assertion: the `(ok, expected, received)` triple
    /// decoded by the method name, a `pickle_test_fail_obj(msg)` failure branch,
    /// and the "Expected:/Received:" message rendering. Mirrors `expect_assert`.
fn expectAssert(em: Emitter, e: Expr, value: Expr, method: string, args: List<CallArg>, negated: bool) -> int? {
        if (!icePoke(em, "expectAssert")) {
            return none
        }
for (a in args) {
            var named = false
            if (let some(_) = a.name) {
                named = true
            }
            if (a.spread || named) {
                bad(em, e.span, "expectation methods take plain positional arguments")
                return none
            }
        }
        var vt = Ty.Unknown
        if (let some(t) = tyOf(em, value.span)) {
            vt = t
        }
        var it = IrTy.Unit
        if (let some(iv) = irty(em, value.span)) {
            it = iv
        } else {
            return none
        }
        var v = -1
        if (let some(vv) = expr(em, value)) {
            v = vv
        } else {
            return none
        }
        var ok = -1
        var expected = -1
        var received = -1
        var badMethod = ""
        match (method) {
            case "toBe" | "toEqual" -> {
                var av = expectSingleArg(em, e, method, args)
                if (let some(arg) = av) {
                    var at = -1
                    if (let some(avt) = expr(em, arg.value)) {
                        at = avt
                    } else {
                        return none
                    }
                    var aIt = IrTy.Unit
                    if (let some(iv) = irty(em, arg.value.span)) {
                        aIt = iv
                    } else {
                        return none
                    }
                    var ev = -1
                    if (let some(x) = expectStr(em, at, aIt, arg.value.span)) {
                        ev = x
                    } else {
                        return none
                    }
                    var rv = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rv = x
                    } else {
                        return none
                    }
                    var okv = expectEqCond(em, v, it, at, aIt, negated, e.span)
                    if (let some(o) = okv) {
                        ok = o
                    } else {
                        return none
                    }
                    expected = ev
                    received = rv
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toBeTruthy" | "toBeFalsy" -> {
                if (expectNoArgs(em, e, method, args)) {
                    var rvT = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rvT = x
                    } else {
                        return none
                    }
                    var wantTruthy = method == "toBeTruthy"
                    var need = (wantTruthy && !(negated)) || (!(wantTruthy) && negated)
                    var okT = expectTruthy(em, v, it, need, e.span)
                    if (let some(o) = okT) {
                        ok = o
                    } else {
                        return none
                    }
                    if (wantTruthy) {
                        expected = strConst(em, "true")
                    } else {
                        expected = strConst(em, "false")
                    }
                    received = rvT
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toBeNull" -> {
                if (expectNoArgs(em, e, method, args)) {
                    var rvN = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rvN = x
                    } else {
                        return none
                    }
                    var nul = nullTemp(em)
                    if (let some(n) = nul) {
                        var res = externCallT1(em, "pickle_expect_obj_eq", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, n])
                        var okN = cmpZero(em, res, IrBinOp.Ne, negated)
                        if (let some(o) = okN) {
                            ok = o
                        } else {
                            return none
                        }
                        expected = strConst(em, "none")
                        received = rvN
                    } else {
                        return none
                    }
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toExist" -> {
                if (expectNoArgs(em, e, method, args)) {
                    var rvE = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rvE = x
                    } else {
                        return none
                    }
                    var nul = nullTemp(em)
                    if (let some(n) = nul) {
                        var res = externCallT1(em, "pickle_expect_obj_eq", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, n])
                        var okE = cmpZero(em, res, IrBinOp.Eq, negated)
                        if (let some(o) = okE) {
                            ok = o
                        } else {
                            return none
                        }
                        expected = strConst(em, "a non-none value")
                        received = rvE
                    } else {
                        return none
                    }
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toHaveLength" -> {
                var avL = expectSingleArg(em, e, method, args)
                if (let some(arg) = avL) {
                    var n = -1
                    if (let some(nv) = expr(em, arg.value)) {
                        n = nv
                    } else {
                        return none
                    }
                    var nIt = IrTy.Unit
                    if (let some(iv) = irty(em, arg.value.span)) {
                        nIt = iv
                    } else {
                        return none
                    }
                    var lenT = -1
                    var badLen = false
                    match (vt) {
                        case Ty.String -> lenT = externCallT1(em, "pickle_str_len", [IrTy.Str], IrTy.Int, [v])
                        case Ty.List(_) -> lenT = externCallT1(em, "pickle_list_len", [IrTy.Ptr], IrTy.Int, [v])
                        case Ty.Map(_, _) -> lenT = externCallT1(em, "pickle_map_len", [IrTy.Ptr], IrTy.Int, [v])
                        case _ -> {
                            badLen = true
                            lenT = lenT
                        }
                    }
                    if (badLen) {
                        bad(em, value.span, "`.toHaveLength()` needs a string, list, or map value")
                        return none
                    }
                    var eq = temp(em)
                    instr(em, IrInstr.BinOp(eq, flipCmp(IrBinOp.Eq, negated), lenT, n))
                    ok = eq
                    var evL = -1
                    if (let some(x) = expectStr(em, n, nIt, arg.value.span)) {
                        evL = x
                    } else {
                        return none
                    }
                    var rvL = -1
                    if (let some(x) = expectStr(em, lenT, IrTy.Int, value.span)) {
                        rvL = x
                    } else {
                        return none
                    }
                    expected = evL
                    received = rvL
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toContain" -> {
                var avC = expectSingleArg(em, e, method, args)
                if (let some(arg) = avC) {
                    var needle = -1
                    if (let some(nv) = expr(em, arg.value)) {
                        needle = nv
                    } else {
                        return none
                    }
                    var needleIt = IrTy.Unit
                    if (let some(iv) = irty(em, arg.value.span)) {
                        needleIt = iv
                    } else {
                        return none
                    }
                    var res = -1
                    var badContain = false
                    match (vt) {
                        case Ty.String -> res = externCallT1(em, "pickle_expect_str_contains", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, needle])
                        case Ty.List(_) -> {
                            var nty = Ty.Unknown
                            if (let some(gt) = tyOf(em, arg.value.span)) {
                                nty = gt
                            }
                            var nd = -1
                            if (let some(w) = optionWrap(em, needle, nty, arg.value.span)) {
                                nd = w
                            } else {
                                return none
                            }
                            res = externCallT1(em, "pickle_expect_list_contains", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, nd])
                        }
                        case _ -> {
                            badContain = true
                            res = res
                        }
                    }
                    if (badContain) {
                        bad(em, value.span, "`.toContain()` needs a string or list value")
                        return none
                    }
                    var okC = cmpZero(em, res, IrBinOp.Ne, negated)
                    if (let some(o) = okC) {
                        ok = o
                    } else {
                        return none
                    }
                    var evC = -1
                    if (let some(x) = expectStr(em, needle, needleIt, arg.value.span)) {
                        evC = x
                    } else {
                        return none
                    }
                    var rvC = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rvC = x
                    } else {
                        return none
                    }
                    expected = evC
                    received = rvC
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toBeGreaterThan" | "toBeLessThan" -> {
                var avG = expectSingleArg(em, e, method, args)
                if (let some(arg) = avG) {
                    var at = -1
                    if (let some(av) = expr(em, arg.value)) {
                        at = av
                    } else {
                        return none
                    }
                    var aIt = IrTy.Unit
                    if (let some(iv) = irty(em, arg.value.span)) {
                        aIt = iv
                    } else {
                        return none
                    }
                    var vf = v
                    var af = at
                    var unFloat = irTyTag(it) == irTyTag(IrTy.Float) || irTyTag(aIt) == irTyTag(IrTy.Float)
                    if (unFloat) {
                        if (!(irTyTag(it) == irTyTag(IrTy.Float))) {
                            if (let some(f) = floatCast(em, v)) {
                                vf = f
                            } else {
                                return none
                            }
                        }
                        if (!(irTyTag(aIt) == irTyTag(IrTy.Float))) {
                            if (let some(f) = floatCast(em, at)) {
                                af = f
                            } else {
                                return none
                            }
                        }
                    }
                    var cmp = temp(em)
                    var cmpOp = IrBinOp.Gt
                    if (method == "toBeLessThan") {
                        cmpOp = IrBinOp.Lt
                    }
                    instr(em, IrInstr.BinOp(cmp, flipCmp(cmpOp, negated), vf, af))
                    var opTxt = -1
                    if (method == "toBeGreaterThan") {
                        opTxt = strConst(em, "> ")
                    } else {
                        opTxt = strConst(em, "< ")
                    }
                    var dv = -1
                    if (let some(x) = expectStr(em, at, aIt, arg.value.span)) {
                        dv = x
                    } else {
                        return none
                    }
                    var evG = -1
                    if (let some(x) = concatStr(em, [opTxt, dv])) {
                        evG = x
                    } else {
                        return none
                    }
                    var rvG = -1
                    if (let some(x) = expectStr(em, v, it, value.span)) {
                        rvG = x
                    } else {
                        return none
                    }
                    ok = cmp
                    expected = evG
                    received = rvG
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case other -> {
                bad(em, e.span, "unknown expectation method `.`" + other + "()`")
                badMethod = other
            }
        }
        if (len(badMethod) > 0) {
            return none
        }
        var head = strConst(em, "Expected:\n")
        var mid = strConst(em, "\n\nReceived:\n")
        var tail = strConst(em, "\n")
        var msg = -1
        if (let some(mv) = concatStr(em, [head, expected, mid, received, tail])) {
            msg = mv
        } else {
            return none
        }
        var cont = newBlock(em)
        var fail = newBlock(em)
        term(em, IrTerm.BranchIf(ok, cont, fail))
        em.cur = fail
        externCallVoid(em, "pickle_test_fail_obj", [IrTy.Ptr], [msg])
        term(em, IrTerm.Branch(cont))
        em.cur = cont
        return unitTemp(em)
    }

    /// The argument of a call into a `&T` parameter slot: an explicit/expected
    /// reference is passed by identity (managed) or by address (scalar local),
    /// anything else by value. Mirrors `borrow_arg` in emit.rs.
fn borrowArg(em: Emitter, src: Ty?, a: CallArg) -> int? {
        if (!icePoke(em, "borrowArg")) {
            return none
        }
        if (let some(hint) = src) {
            var isFn = false
            match (hint) {
                case Ty.Fn(_, _) -> isFn = true
                case _ -> {}
            }
            if (isFn) {
                var gv = genericFnArgValue(em, a.value, hint)
                if (let some(vv) = gv) {
                    return vv
                }
            }
        }
        if (let some(rf) = src) {
            var inner = Ty.Unknown
            var isRef = false
            match (rf) {
                case Ty.Ref(iner) -> {
                    inner = iner
                    isRef = true
                }
                case _ -> {}
            }
            if (isRef) {
                var at = tyOf(em, a.value.span)
                if (let some(at2) = at) {
                    if (tyEq(at2, inner)) {
                        if (let none = scalarIr(inner)) {
                            return expr(em, a.value)
                        }
                        match (a.value.kind) {
                            case ExprKind.Ident(name) -> {
                                var slotO = lookup(em, name)
                                if (let some(slot) = slotO) {
                                    var dst = temp(em)
                                    instr(em, IrInstr.LocalAddr(dst, slot))
                                    return dst
                                }
                                bad(em, a.value.span, "cannot borrow unknown `" + name + "`")
                                return none
                            }
                            case _ -> {
                                bad(em, a.value.span, "implicitly borrowing a scalar needs a plain local variable")
                                return none
                            }
                        }
                    }
                }
            }
        }
        expr(em, a.value)
    }

/// Lower a call whose arguments include a spread (`...list`): build the
    /// boxed argument list, check the spread element count at runtime, and
    /// call the shared spread trampoline of the target. Mirrors
    /// `spread_static_call` in emit.rs.
fn spreadStaticCall(em: Emitter, e: Expr, span: Span, fid: int, pty: List<Ty>, ret: Ty, receiver: int?, args: List<CallArg>) -> int? {
        var refParam = false
        for (t in pty) {
            match (t) {
                case Ty.Ref(_) -> refParam = true
                case _ -> {}
            }
        }
        if (refParam) {
            bad(em, span, "spreading into a `&T` parameter is not lowered yet")
            return none
        }
        var fs = em.fsource.get(fid)
        if (let some(src) = fs) {
            var tl: FnDecl? = none
            match (src) {
                case FnSource.TopLevel(f) -> tl = f
                case _ -> {}
            }
            if (let some(f) = tl) {
                var hasDef = false
                for (p in f.params) {
                    if (let some(_) = p.default) {
                        hasDef = true
                    }
                }
                if (hasDef) {
                    bad(em, span, "spreading into a parameter with a default value is not lowered yet")
                    return none
                }
            }
        }
        var finf = em.finfo.get(fid)
        if (let some(info) = finf) {
            var hasRest = false
            for (p in info.params) {
                if (p.rest) {
                    hasRest = true
                }
            }
            if (hasRest) {
                bad(em, span, "spreading into a rest parameter is only lowered for `println`")
                return none
            }
        }
        var m = 0
        while (m < len(args) && !args[m].spread) {
            m = m + 1
        }
        if (m > len(pty)) {
            bad(em, span, "too many arguments for this call")
            return none
        }
        var spArgO: CallArg? = none
        if (m < len(args)) {
            spArgO = args[m]
        }
        var foundSpread = false
        if (let some(sa) = spArgO) {
            if (sa.spread) {
                foundSpread = true
            }
        }
        if (!foundSpread) {
            bad(em, span, "internal error: missing spread argument")
            return none
        }
        var spArg = CallArg(none, Expr(span, ExprKind.Ident("")), true, span)
        if (let some(sa) = spArgO) {
            spArg = sa
        }
        var matchedList = false
        var elemTy = Ty.Unknown
        if (let some(t) = tyOf(em, spArg.value.span)) {
            match (t) {
                case Ty.List(inner) -> {
                    matchedList = true
                    elemTy = inner
                }
                case _ -> {}
            }
        }
        if (!matchedList) {
            bad(em, spArg.span, "a spread argument must be a `List`")
            return none
        }
        var erepO = elemRep(em, elemTy, spArg.span)
        if (let none = erepO) {
            return none
        }
        var erep = ElemRep.ptr()
        if (let some(re) = erepO) {
            erep = re
        }
        var j = m
        while (j < len(pty)) {
            var pre = elemRep(em, pty[j], spArg.span)
            if (let none = pre) {
                return none
            }
            var prev = ElemRep.ptr()
            if (let some(re) = pre) {
                prev = re
            }
            if (!elemRepSame(prev, erep)) {
                bad(em, span, "spreading over parameters with mixed element representations is not lowered yet")
                return none
            }
            j = j + 1
        }
        var retM = mapTy(em, ret, span)
        if (let none = retM) {
            bad(em, span, "spread call return type is not lowered yet")
            return none
        }
        var retIr = IrTy.Unit
        if (let some(r) = retM) {
            retIr = r
        }
        var tramp = 0
        var trampO = em.spreadTramps.get(fid)
        if (let some(t) = trampO) {
            tramp = t
        } else {
            var recvFlag = false
            if (let some(_) = receiver) {
                recvFlag = true
            }
            tramp = pushClassFunc(em, "fn.spread", "pkl_sptramp_" + str(fid), FnSource.SpreadTrampoline(span, fid, pty, ret, recvFlag))
            em.spreadTramps[fid] = tramp
        }
        var resSlot = newSlot(em, retIr)
        var cap = intConst(em, len(pty))
        var xs = externCallT1(em, "pickle_list_new", [IrTy.Int], IrTy.Ptr, [cap])
        var base = 0
        if (let some(_) = receiver) {
            base = 1
        }
        var fparams = em.irModule.funcs[fid].params
        var i = 0
        while (i < m) {
            var a = args[i]
            var srcO: Ty? = none
            if (let some(v) = em.srcParamTys.get(fid)) {
                if (i < len(v)) {
                    srcO = v[i]
                }
            }
            var t = -1
            if (let some(tv) = borrowArg(em, srcO, a)) {
                t = tv
            } else {
                return none
            }
            var fparamTy: IrTy? = none
            if (base + i < len(fparams)) {
                fparamTy = fparams[base + i].ty
            } else {
                if (let some(s) = srcO) {
                    fparamTy = mapTy(em, s, a.value.span)
                }
            }
            var isRef2 = false
            if (let some(sr) = srcO) {
                match (sr) {
                    case Ty.Ref(_) -> isRef2 = true
                    case _ -> {}
                }
            }
            var srcVal = t
            if (!isRef2) {
                var fparamIsPtr = false
                if (let some(ft) = fparamTy) {
                    if (irTyTag(ft) == irTyTag(IrTy.Ptr)) {
                        fparamIsPtr = true
                    }
                }
                if (fparamIsPtr) {
                    var vt = Ty.Unknown
                    if (let some(gt) = tyOf(em, a.value.span)) {
                        vt = gt
                    }
                    var w = optionWrap(em, t, vt, a.value.span)
                    if (let some(wv) = w) {
                        srcVal = wv
                    } else {
                        return none
                    }
                }
            }
            var repI = elemRep(em, pty[i], a.value.span)
            if (let none = repI) {
                return none
            }
            var repV = ElemRep.ptr()
            if (let some(re) = repI) {
                repV = re
            }
            if (repV.isPtr) {
                externCallVoid(em, "pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [xs, srcVal])
            } else {
                var bx = externCallT1(em, repV.boxSym, [repV.ir], IrTy.Ptr, [srcVal])
                externCallVoid(em, "pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [xs, bx])
            }
            i = i + 1
        }
        var sp = expr(em, spArg.value)
        if (let none = sp) {
            return none
        }
        var spV = 0
        if (let some(sv) = sp) {
            spV = sv
        }
        var n = externCallT1(em, "pickle_list_len", [IrTy.Ptr], IrTy.Int, [spV])
        var r = intConst(em, len(pty) - m)
        var ok = temp(em)
        instr(em, IrInstr.BinOp(ok, IrBinOp.Eq, n, r))
        var rOk = newBlock(em)
        var rPanic = newBlock(em)
        var join = newBlock(em)
        term(em, IrTerm.BranchIf(ok, rOk, rPanic))
        em.cur = rPanic
        externCallVoid(em, "pickle_panic_arity_diff", emptyIrTys(), emptyInts())
        term(em, IrTerm.Branch(join))
        em.cur = rOk
        var rMissing = len(pty) - m
        var k = 0
        while (k < rMissing) {
            var idx = intConst(em, k)
            var raw = externCallT1(em, "pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [spV, idx])
            externCallVoid(em, "pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [xs, raw])
            k = k + 1
        }
        var callArgs = emptyInts()
        if (let some(recv) = receiver) {
            callArgs.push(recv)
        }
        callArgs.push(xs)
        var dst = temp(em)
        instr(em, IrInstr.Call(dst, Callee.Func(tramp), callArgs))
        // The trampoline tail-calls the target, so a throw from the callee comes
        // back with the flag set on *this* function, and the store below would
        // otherwise write a garbage result into the slot.
        guardPropagation(em, tramp)
        instr(em, IrInstr.StoreSlot(resSlot, dst))
        term(em, IrTerm.Branch(join))
        em.cur = join
        load(em, resSlot)
    }

    /// `...xs` as a `print`/`println` operand: emit a runtime loop that
    /// prints every element individually, unboxing scalar element reps and
    /// passing managed elements straight to `pickle_print_obj`. An empty
    /// spread prints nothing. Mirrors `print_spread_list` in emit.rs.

    /// The call-lowering hub. Mirrors `call` in emit.rs: expect-method
    /// dispatch, `.free()` on `#[manualAlloc]`, `Enum.Variant(...)` ctors,
    /// plain member calls, generic calls (explicit and inferred), fn-value
    /// dispatch, plain user functions, class/struct ctors, then the builtins.
fn call(em: Emitter, e: Expr, callee: Expr, args: List<CallArg>) -> int? {
        if (em.iceDepth > 150) {
            return none
        }
        em.iceDepth = em.iceDepth + 1
        em.icePath.push("call")
        var r = call1(em, e, callee, args)
        em.iceDepth = em.iceDepth - 1
        r
    }

fn call1(em: Emitter, e: Expr, callee: Expr, args: List<CallArg>) -> int? {
        if (!icePoke(em, "call1")) {
            return none
        }
        match (callee.kind) {
            case ExprKind.Member(object, name) -> {
                if (isExpectMethod(name)) {
                    var p = peelExpect(em, object)
                    if (let some(pe) = p) {
                        return expectAssert(em, e, pe.value, name, args, pe.negated)
                    }
                }
                if (name == "free") {
                    match (object.kind) {
                        case ExprKind.Ident(id) -> {
                            if (isManual(em, id)) {
                                if (!(len(args) == 0)) {
                                    bad(em, e.span, "`free()` takes no arguments")
                                    return none
                                }
                                var obj = -1
                                if (let some(ov) = expr(em, object)) {
                                    obj = ov
                                } else {
                                    return none
                                }
                                externCallVoid(em, "pickle_manual_free", [IrTy.Ptr], [obj])
                                return unitTemp(em)
                            }
                        }
                        case _ -> {}
                    }
                }
                var enO = exprKindIdentName(object)
                if (let some(enumName) = enO) {
                    if (let some(entry) = em.resolved.types.get(enumName)) {
                        match (entry) {
                            case TypeTableEntry.Enum(t) -> {
                                return enumCtor(em, e, t, name, args)
                            }
                            case _ -> {}
                        }
                    }
                }
                return methodCall(em, e, object, name, args)
            }
            case ExprKind.GenericCall(name2, typeArgs) -> {
                return genericCall(em, e, name2, typeArgs, args)
            }
            case ExprKind.Ident(cname) -> {
                var inf = userCallableFirst(em, cname)
                if (let some(info) = inf) {
                    if (!(len(info.generics) == 0)) {
                        var argTys = inferGenericFnArgs(em, e.span, info, args)
                        if (let some(aa) = argTys) {
                            return genericFnCall(em, e, info, aa, args)
                        }
                        return none
                    }
                }
            }
            case _ -> {}
        }
        if (let some(cid) = em.owner) {
            var enM = exprKindIdentName(callee)
            if (let some(mname) = enM) {
                var mvO = em.methodIds.get(pairKey(str(cid), mname))
                if (let some(mv) = mvO) {
                    if (mv.isStatic) {
                        return callMethod(em, e, mv.fid, args, none)
                    }
                    var th = thisValue(em, e)
                    if (let none = th) {
                        return none
                    }
                    var thV = 0
                    if (let some(t) = th) {
                        thV = t
                    }
                    var vb = em.virtualDispatch.get(pairKey(str(cid), mname))
                    if (let some(branches) = vb) {
                        if (!(len(branches) == 0)) {
                            return virtualMethodCall(em, e, mv.fid, args, thV, branches)
                        }
                    }
                    return callMethod(em, e, mv.fid, args, thV)
                }
            }
        }
        if (isFnDispatchable(em, callee)) {
            return fnValueCall(em, e, callee, args)
        }
        var enO2 = exprKindIdentName(callee)
        if (let none = enO2) {
            bad(em, e.span, "only plain function calls are lowered yet")
            return none
        }
        var name = ""
        if (let some(nm) = enO2) {
            name = nm
        }
var fidO = em.irModule.funcsByName.get(name)
        if (let some(fid) = fidO) {
            if (anySpread(args)) {
                var pty = srcParamList(em, fid)
                var rt = callRetFor(em, fid)
                return spreadStaticCall(em, e, e.span, fid, pty, rt, none, args)
            }
            var fparams = em.irModule.funcs[fid].params
            var argTemps = emptyInts()
            var i = 0
            while (i < len(args)) {
                var a = args[i]
                var srcO: Ty? = none
                if (let some(v) = em.srcParamTys.get(fid)) {
                    if (i < len(v)) {
                        srcO = v[i]
                    }
                }
                var isRef = false
                if (let some(sr) = srcO) {
                    match (sr) {
                        case Ty.Ref(_) -> isRef = true
                        case _ -> {}
                    }
                }
                var t = -1
                if (let some(tv) = borrowArg(em, srcO, a)) {
                    t = tv
                } else {
                    return none
                }
                var fparamIsPtr = false
                if (i < len(fparams)) {
                    if (irTyTag(fparams[i].ty) == irTyTag(IrTy.Ptr)) {
                        fparamIsPtr = true
                    }
                }
                var finalT = t
                if (!isRef && fparamIsPtr) {
                    var vt = Ty.Unknown
                    if (let some(gt) = tyOf(em, a.value.span)) {
                        vt = gt
                    }
                    if (let some(w) = optionWrap(em, t, vt, a.value.span)) {
                        finalT = w
                    } else {
                        return none
                    }
                }
                argTemps.push(finalT)
                i = i + 1
            }
            var dst = temp(em)
            instr(em, IrInstr.Call(dst, Callee.Func(fid), argTemps))
            guardPropagation(em, fid)
            return dst
        }
var cidO = em.classByName.get(name)
        if (let some(cid) = cidO) {
            var ctorO = em.ctorIds.get(cid)
            if (let some(fid) = ctorO) {
                if (anySpread(args)) {
                    var pty = srcParamList(em, fid)
                    return spreadStaticCall(em, e, e.span, fid, pty, Ty.Class(name, emptyTys()), none, args)
                }
                var fparams = em.irModule.funcs[fid].params
                var argTemps = emptyInts()
                var i = 0
                while (i < len(args)) {
                    var a = args[i]
                    var srcO: Ty? = none
                    if (let some(v) = em.srcParamTys.get(fid)) {
                        if (i < len(v)) {
                            srcO = v[i]
                        }
                    }
                    var isRef = false
                    if (let some(sr) = srcO) {
                        match (sr) {
                            case Ty.Ref(_) -> isRef = true
                            case _ -> {}
                        }
                    }
                    var t = -1
                    if (let some(tv) = borrowArg(em, srcO, a)) {
                        t = tv
                    } else {
                        return none
                    }
                    var fparamIsPtr = false
                    if (i < len(fparams)) {
                        if (irTyTag(fparams[i].ty) == irTyTag(IrTy.Ptr)) {
                            fparamIsPtr = true
                        }
                    }
                    var finalT = t
                    if (!isRef && fparamIsPtr) {
                        var vt = Ty.Unknown
                        if (let some(gt) = tyOf(em, a.value.span)) {
                            vt = gt
                        }
                        if (let some(w) = optionWrap(em, t, vt, a.value.span)) {
                            finalT = w
                        } else {
                            return none
                        }
                    }
                    argTemps.push(finalT)
                    i = i + 1
                }
                var dst = temp(em)
                instr(em, IrInstr.Call(dst, Callee.Func(fid), argTemps))
                guardPropagation(em, fid)
                return dst
            }
            bad(em, e.span, "`" + name + "` has no constructor")
            return none
        }
        match (name) {
            case "assert" -> {
                if (len(args) == 0 || len(args) > 2) {
                    bad(em, e.span, "`assert(cond, msg?)` takes a condition and an optional message")
                    return none
                }
                var cond = -1
                if (let some(cv) = expr(em, args[0].value)) {
                    cond = cv
                } else {
                    return none
                }
                var cont = newBlock(em)
                var fail = newBlock(em)
                term(em, IrTerm.BranchIf(cond, cont, fail))
                em.cur = fail
                var msg = -1
                if (len(args) == 2) {
                    if (let some(mv) = expr(em, args[1].value)) {
                        msg = mv
                    } else {
                        return none
                    }
                } else {
                    if (let some(nv) = nullTemp(em)) {
                        msg = nv
                    } else {
                        return none
                    }
                }
                externCallVoid(em, "pickle_test_fail_obj", [IrTy.Ptr], [msg])
                term(em, IrTerm.Branch(cont))
                em.cur = cont
                return unitTemp(em)
            }
            case "expect" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`expect(value)` takes exactly one value")
                    return none
                }
                var namedE = false
                if (let some(_) = args[0].name) {
                    namedE = true
                }
                if (namedE || args[0].spread) {
                    bad(em, e.span, "`expect(value)` takes exactly one value")
                    return none
                }
                return expr(em, args[0].value)
            }
case "print" | "println" -> {
                var newline = name == "println"
                for (a in args) {
                    if (a.spread) {
                        var listMatched = false
                        var elemT = Ty.Unknown
                        if (let some(gt) = tyOf(em, a.value.span)) {
                            match (gt) {
                                case Ty.List(inner) -> {
                                    listMatched = true
                                    elemT = inner
                                }
                                case _ -> {}
                            }
                        }
                        if (!listMatched) {
                            bad(em, a.span, "spread argument in `print` must be a `List`")
                            return none
                        }
                        var spv = -1
                        if (let some(sv) = expr(em, a.value)) {
                            spv = sv
                        } else {
                            return none
                        }
                        if (!printSpreadList(em, a.span, spv, elemT)) {
                            return none
                        }
                    } else {
                    var t = -1
                    if (let some(tv) = expr(em, a.value)) {
                        t = tv
                    } else {
                        return none
                    }
                    var sym = ""
                    var pty = IrTy.Ptr
                    var unsupported = false
                    if (let some(gt) = tyOf(em, a.value.span)) {
                        match (gt) {
                            case Ty.Int -> {
                                sym = "pickle_print_i64"
                                pty = IrTy.Int
                            }
                            case Ty.Float -> {
                                sym = "pickle_print_f64"
                                pty = IrTy.Float
                            }
                            case Ty.Bool -> {
                                sym = "pickle_print_bool"
                                pty = IrTy.Bool
                            }
                            case Ty.Byte -> {
                                sym = "pickle_print_byte"
                                pty = IrTy.Int
                            }
                            case Ty.Char -> {
                                sym = "pickle_print_char"
                                pty = IrTy.Char
                            }
                            case Ty.String | Ty.List(_) | Ty.Map(_, _) | Ty.Enum(_, _, _) | Ty.Class(_, _) | Ty.Struct(_, _) -> {
                                sym = "pickle_print_obj"
                                pty = IrTy.Ptr
                            }
                            case _ -> {
                                unsupported = true
                                pty = pty
                            }
                        }
                    } else {
                        unsupported = true
                        pty = pty
                    }
                    if (unsupported) {
                        bad(em, a.value.span, "unsupported `print` argument type")
                        return none
                    }
                    externCallVoid(em, sym, [pty], [t])
                    }
                }
                if (newline) {
                    externCallVoid(em, "pickle_print_newline", emptyIrTys(), emptyInts())
                }
                return unitTemp(em)
            }
            case "alloc" -> {
                if (!(len(args) == 2)) {
                    bad(em, e.span, "`alloc(T, count)` takes two arguments")
                    return none
                }
                var stride = 0
                var badAlloc = false
                if (let some(gt) = tyOf(em, args[0].value.span)) {
                    match (gt) {
                        case Ty.Int | Ty.Float -> stride = 8
                        case Ty.Char -> stride = 4
                        case Ty.Bool -> stride = 1
                        case _ -> {
                            badAlloc = true
                            stride = stride
                        }
                    }
                } else {
                    badAlloc = true
                    stride = stride
                }
                if (badAlloc) {
                    bad(em, args[0].span, "`alloc` currently only supports scalar element types (int, float, bool, char)")
                    return none
                }
                var count = -1
                if (let some(cv) = expr(em, args[1].value)) {
                    count = cv
                } else {
                    return none
                }
                var s = intConst(em, stride)
                var size = temp(em)
                instr(em, IrInstr.BinOp(size, IrBinOp.Mul, count, s))
                return externCallT1(em, "pickle_raw_alloc", [IrTy.Int], IrTy.Int, [size])
            }
            case "view" -> {
                if (len(args) != 1) {
                    bad(em, e.span, "`view(obj)` takes one argument")
                    return none
                }
                var v = 0
                if (let some(pv) = expr(em, args[0].value)) {
                    v = pv
                } else {
                    return none
                }
                // A managed value already evaluates to its object address in
                // IR; the form simply re-types it as a raw `*int` for the
                // caller. No runtime call, no copy.
                return v
            }
            case "free" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`free(p)` takes one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = expr(em, args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                externCallVoid(em, "pickle_raw_free", [IrTy.Int], [p])
                return unitTemp(em)
            }
            case "len" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`len` takes one argument")
                    return none
                }
                var t = -1
                if (let some(tv) = expr(em, args[0].value)) {
                    t = tv
                } else {
                    return none
                }
                if (let some(gt) = tyOf(em, args[0].value.span)) {
                    match (gt) {
                        case Ty.String -> { return externCallT1(em, "pickle_str_len", [IrTy.Str], IrTy.Int, [t]) }
                        case Ty.List(_) -> { return externCallT1(em, "pickle_list_len", [IrTy.Ptr], IrTy.Int, [t]) }
                        case Ty.Map(_, _) -> { return externCallT1(em, "pickle_map_len", [IrTy.Ptr], IrTy.Int, [t]) }
                        case _ -> {}
                    }
                }
                bad(em, e.span, "`len` over this type is not lowered yet")
                none
            }
            case "abs" -> {
                if (!(len(args) == 1)) {
                    bad(em, e.span, "`abs(x)` takes exactly one argument")
                    return none
                }
                var namedA = false
                if (let some(_) = args[0].name) {
                    namedA = true
                }
                if (namedA || args[0].spread) {
                    bad(em, e.span, "`abs(x)` takes exactly one argument")
                    return none
                }
                var v = -1
                if (let some(vv) = expr(em, args[0].value)) {
                    v = vv
                } else {
                    return none
                }
                var vit = IrTy.Unit
                if (let some(iv) = irty(em, args[0].value.span)) {
                    vit = iv
                } else {
                    return none
                }
                var zero = -1
                var badAbs = false
                match (vit) {
                    case IrTy.Int -> zero = intConst(em, 0)
                    case IrTy.Float -> zero = floatConst(em, 0.0)
                    case _ -> {
                        badAbs = true
                        zero = zero
                    }
                }
                if (badAbs) {
                    bad(em, args[0].value.span, "`abs` requires an `int` or `float` argument")
                    return none
                }
                var isNeg = temp(em)
                instr(em, IrInstr.BinOp(isNeg, IrBinOp.Lt, v, zero))
                var negV = temp(em)
                instr(em, IrInstr.UnOp(negV, IrUnOp.Neg, v))
                var resSlot = newSlot(em, vit)
                var negB = newBlock(em)
                var posB = newBlock(em)
                var join = newBlock(em)
                term(em, IrTerm.BranchIf(isNeg, negB, posB))
                em.cur = negB
                instr(em, IrInstr.StoreSlot(resSlot, negV))
                term(em, IrTerm.Branch(join))
                em.cur = posB
                instr(em, IrInstr.StoreSlot(resSlot, v))
                term(em, IrTerm.Branch(join))
                em.cur = join
                return load(em, resSlot)
            }
            case "min" | "max" -> {
                if (!(len(args) == 2)) {
                    bad(em, e.span, "`" + name + "(a, b)` takes exactly two arguments")
                    return none
                }
                var namedM0 = false
                if (let some(_) = args[0].name) {
                    namedM0 = true
                }
                var namedM1 = false
                if (let some(_) = args[1].name) {
                    namedM1 = true
                }
                if (namedM0 || args[0].spread || namedM1 || args[1].spread) {
                    bad(em, e.span, "`" + name + "(a, b)` takes exactly two arguments")
                    return none
                }
                var it = IrTy.Unit
                if (let some(iv) = irty(em, args[0].value.span)) {
                    it = iv
                } else {
                    return none
                }
                var badMinMax = false
                if (!(irTyTag(it) == irTyTag(IrTy.Int)) && !(irTyTag(it) == irTyTag(IrTy.Float))) {
                    badMinMax = true
                }
                if (badMinMax) {
                    bad(em, e.span, "`min`/`max` requires `int` or `float` arguments")
                    return none
                }
                var a = -1
                if (let some(av) = expr(em, args[0].value)) {
                    a = av
                } else {
                    return none
                }
                var b = -1
                if (let some(bv) = expr(em, args[1].value)) {
                    b = bv
                } else {
                    return none
                }
                var pickA = temp(em)
                var op = IrBinOp.Gt
                if (name == "min") {
                    op = IrBinOp.Lt
                }
                instr(em, IrInstr.BinOp(pickA, op, a, b))
                var resSlot = newSlot(em, it)
                var aB = newBlock(em)
                var bB = newBlock(em)
                var join = newBlock(em)
                term(em, IrTerm.BranchIf(pickA, aB, bB))
                em.cur = aB
                instr(em, IrInstr.StoreSlot(resSlot, a))
                term(em, IrTerm.Branch(join))
                em.cur = bB
                instr(em, IrInstr.StoreSlot(resSlot, b))
                term(em, IrTerm.Branch(join))
                em.cur = join
                return load(em, resSlot)
            }
            case "clamp" -> {
                if (!(len(args) == 3)) {
                    bad(em, e.span, "`clamp(x, lo, hi)` takes exactly three arguments")
                    return none
                }
                var badClamp = false
                for (a in args) {
                    var named = false
                    if (let some(_) = a.name) {
                        named = true
                    }
                    if (named || a.spread) {
                        badClamp = true
                    }
                }
                if (badClamp) {
                    bad(em, e.span, "`clamp(x, lo, hi)` takes exactly three arguments")
                    return none
                }
                var it = IrTy.Unit
                if (let some(iv) = irty(em, args[0].value.span)) {
                    it = iv
                } else {
                    return none
                }
                var badType = false
                if (!(irTyTag(it) == irTyTag(IrTy.Int)) && !(irTyTag(it) == irTyTag(IrTy.Float))) {
                    badType = true
                }
                if (badType) {
                    bad(em, e.span, "`clamp` requires `int` or `float` arguments")
                    return none
                }
                var x = -1
                if (let some(xv) = expr(em, args[0].value)) {
                    x = xv
                } else {
