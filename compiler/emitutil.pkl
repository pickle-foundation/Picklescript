module compiler.emitutil

// Support model for the emitter: module constants, pure data classes, and free
// helper functions over AST/ty/resolve types. Split out of emit.pkl per the
// one-primary-declaration-per-file rule; emit.pkl keeps `class Emitter` plus
// the register/lower orchestration and imports this module one-way.

import * from compiler.ast
import { Span, Diagnostic, DiagnosticSink } from compiler.diag
import { IrBlock, IrFunc, IrGlobal, IrModule, IrParam, IrTy, emptyIrBlocks, emptyIrGlobals, emptyIrParams, emptyIrTys, emptyModule, irTyStr, irxParseFloat } from compiler.ir
import { CallableInfo, ClassTable, CtorInfo, entryGenerics, EnumTable, FieldInfo, ParamInfo, PropertyInfo, ResolvedProgram, TypeTableEntry } from compiler.resolvebag

import { collectExprTypes } from compiler.checkcore
import { containsStr, isNoneStr, spanKey } from compiler.checkutil
import * from compiler.ty
import { f64ToBits } from compiler.x64

/// Runtime class ids for user classes start at this id: the runtime reserves
/// 0..=6 for the builtin boxed types (string/list/map/int/float/bool/char),
/// 7 for `PEnum`, 8 for `PTuple`, and 9 for `PStream`, so the first user class
/// registered at runtime gets id `PICKLE_CLASS_USER_BASE`. The compiler assigns
/// `base + index` in declaration order, matching the runtime's allocation
/// order.
const PICKLE_CLASS_USER_BASE: int = 10

/// Make a function symbol from a type's display name: keep alphanumerics,
/// replace every other character (commas, spaces, parens, `?`, `&`, ...) with
/// `_`, so instantiation suffixes stay valid linker symbols.
fn sanitizeSymbol(s: string) -> string {
    var out = ""
    for (c in s) {
        if (isAsciiAlnum(c)) {
            out += "{c as char}"
        } else {
            out += "_"
        }
    }
    if (out == "") {
        out = "_"
    }
    out
}

fn isAsciiAlnum(c: byte) -> bool {
    (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
}

/// How a function body leaves its current block, once every `finally` owed on
/// the way has already run.
enum Exit {
    /// Leave the function with this value.
    Return(v: int?)
    /// Jump to an existing block (a `break`/`continue` target).
    Branch(target: int)
    /// Leave the function because a throw is propagating. A function with a
    /// result must still produce one, so a zero of that type is returned; the
    /// caller checks the pending flag before it reads the value.
    Propagate
}

/// The innermost `catch` in the function being emitted, and enough context to
/// know which `finally`s are still owed on the way into it.
class HandlerCtx {
    var target: int
    var finBase: int
    var ownFinally: bool

    constructor(target: int, finBase: int, ownFinally: bool) {
        this.target = target
        this.finBase = finBase
        this.ownFinally = ownFinally
    }
}

/// A `break`/`continue` target pair.
class LoopCtx {
    var continueTarget: int
    var breakTarget: int

    constructor(continueTarget: int, breakTarget: int) {
        this.continueTarget = continueTarget
        this.breakTarget = breakTarget
    }
}

/// Where a registered function's body and signature come from.
enum FnSource {
    // Top-level `fn` (or `test`) declaration.
    TopLevel(f: FnDecl)
    // The visible wrapper of an `async fn`: a normal module function with the
    // async fn's real ABI that allocates the future closure and returns it.
    // Runs no user code; the body runs only when `await` drives the closure.
    AsyncFn(f: FnDecl, hidden: int)
    // The hidden future body of an `async fn`: a 0-arg hoisted body with the
    // lambda ABI (`env` = closure object), whose slots 1..N snapshot each of
    // the async fn's parameters under its own name.
    AsyncBody(f: FnDecl, pty: List<Ty>, ret: Ty)
    // A lambda expression's hoisted body: slot 0 is the closure object, whose
    // slots 1..N hold the captured values copied in at entry; the lambda's own
    // parameters come after the closure object.
    Lambda(lambda: Expr, captures: List<Capture>, pty: List<Ty>, ret: Ty, owner: int?)
    // The constructor of a class/struct: synthesized from the fields unless an
    // explicit `constructor(...)` body is present.
    Ctor(table: ClassTable, inits: List<SlotInit>, initBlocks: List<Block>, ctor: ConstructorDecl?)
    // A named constructor: a static factory that delegates to the primary
    // constructor via `this(...)`.
    NamedCtor(table: ClassTable, ctor: ConstructorDecl)
    // A `deinit` finalizer: runs at GC sweep on a dead instance, off the
    // allocation path. Slot 0 is `this`; returns unit.
    Deinit(table: ClassTable, body: Block)
    // A class/struct method (instance or static).
    Method(table: ClassTable, md: MethodDecl)
    // The visible wrapper of an `async` method (instance or static), with the
    // method's real ABI (`this` at slot 0 for instance methods, then the
    // parameters): allocates the future closure and returns it. `methodIds`
    // maps the method name here, so calls and overrides dispatch exactly like
    // a regular method.
    AsyncMethod(table: ClassTable, md: MethodDecl, hidden: int, isStatic: bool, thisTy: Ty?)
    // The hidden future body of an `async` method: closure slots hold the
    // receiver (instance methods) then the parameters; the receiver is
    // re-declared as `this` so the body runs exactly like a regular method.
    AsyncMethodBody(table: ClassTable, md: MethodDecl, pty: List<Ty>, ret: Ty, isStatic: bool)
    // A property accessor: slot 0 is `this` (instance only; static
    // properties are receiver-less), and setters take a `value` parameter,
    // over the resolved property signature.
    Property(table: ClassTable, pd: PropertyDecl, info: PropertyInfo, isSet: bool, isStatic: bool)
    // The synthesized static-field initializer: one assignment per static
    // field, evaluated once at program start. `None` means the field had no
    // initializer and is stored as its default (zero/null) value.
StaticInit(inits: List<StaticInitEntry>)
    GlobalsInit(inits: List<ManagedGlobalInit>)
    // A dynamically-callable forwarder for a top-level function used as a
    // value. Slot 0 is the closure object (ignored; module functions capture
    // nothing), the real arguments occupy slots 1..N, and the body calls
    // `target` and returns its result. This gives a module function the same
    // `(env, ...)` ABI as a hoisted lambda body, so `fn_value_call` can
    // dispatch to it uniformly through a zero-capture closure object.
    Trampoline(span: Span, target: int, pty: List<Ty>, ret: Ty)
    // A dynamically-callable forwarder for an instance method bound to a
    // receiver. Slot 0 is the closure object, slot 1 holds the bound receiver
    // (captured like a lambda capture), and the real arguments occupy slots
    // 2..N; the body loads the receiver and calls `target` with it first, then
    // returns the result. This gives a bound method the same `(env, ...)` ABI
    // as a hoisted lambda body, so `fn_value_call` dispatches to it uniformly.
    // When the method is overridden (`branches` non-empty), the body dispatches
    // on the runtime class of the loaded receiver exactly like a virtual call.
MethodTrampoline(span: Span, target: int, pty: List<Ty>, ret: Ty, branches: List<DispatchBranch>)
    // A dynamically-callable forwarder for spreading a boxed `List<...>` into a
    // target function's real arguments. Slot 0 is the receiver (instance methods
    // only), slot 1 is the boxed list; the body unboxes each element by its own
    // parameter's representation and calls `target` directly, so every call site
    // that spreads into the same target shares one trampoline ("fn.spread").
    // Mirrors `build_spread_trampoline` in emit.rs.
    SpreadTrampoline(span: Span, target: int, pty: List<Ty>, ret: Ty, receiver: bool)
    // The synthesized `pkl_test_setup` function: registers every user class
    // and runs `pkl_static_init` before the test runner starts (test modules
    // have no `main`, so the preamble cannot ride on one).
    TestSetup
}

/// `(slot, initializer)` for each instance field with an initializer, in
/// declaration order.
class SlotInit {
    var slot: int
    var init: Expr

    constructor(slot: int, init: Expr) {
        this.slot = slot
        this.init = init
    }
}

/// One static-field entry of the synthesized static init: `(class id, static
/// slot, value expr)`. `value == none` means "no initializer" (store the
/// default value).
class StaticInitEntry {
    var cid: int
    var slot: int
    var value: Expr?

    constructor(cid: int, slot: int, value: Expr?) {
        this.cid = cid
        this.slot = slot
        this.value = value
    }
}

/// One managed top-level `var`: the global id whose slot must be rooted, and the
/// initializer expression that builds its value at run time.
class ManagedGlobalInit {
var gid: int
        var ty: IrTy
        var value: Expr

        constructor(gid: int, ty: IrTy, value: Expr) {
            this.gid = gid
            this.ty = ty
            this.value = value
        }
}

/// One virtual-dispatch branch: `(descendant class id, its own
/// implementation)`.
class DispatchBranch {
    var cid: int
    var fid: int

    constructor(cid: int, fid: int) {
        this.cid = cid
        this.fid = fid
    }
}

/// A registered, lowerable user class/struct.
class ClassPlan {
    var name: string
    var classId: int
    /// Superclass id for a class that `extends` another, else `None`.
    var parent: int?
    var table: ClassTable

    constructor(name: string, classId: int, parent: int?, table: ClassTable) {
        this.name = name
        this.classId = classId
        this.parent = parent
        this.table = table
    }
}

/// One value a lambda body reads from its creating scope. Captures are copied
/// (snapshotted) into the closure object at creation time and are read-only
/// inside the hoisted body.
class Capture {
    var name: string
    var ty: Ty
    var span: Span

    constructor(name: string, ty: Ty, span: Span) {
        this.name = name
        this.ty = ty
        this.span = span
    }
}

/// Closures may capture up to this many values; beyond it the synthetic
/// `__closure_N` layout (one slot per capture) is rejected loudly.
const MAX_LAMBDA_CAPTURES: int = 8

/// Publish `payload` and raise this thread's pending flag.
const EXC_THROW: string = "pickle_exc_throw"

/// Is a throw in flight on this thread?
const EXC_PENDING: string = "pickle_exc_pending"

/// Consume the in-flight throw, returning its payload.
const EXC_TAKE: string = "pickle_exc_take"

/// Runtime symbol names used to build and call closure values.
const CLOSURE_CLASS_PREFIX: string = "__closure_"

/// The slot holding the hoisted body's code address inside a closure object.
const CLOSURE_FN_SLOT: int = 0

/// The number of parameters on a lambda expression.
fn paramsLen(lambda: Expr) -> int {
    match (lambda.kind) {
        case ExprKind.Lambda(params, _, _, _) -> len(params)
        case _ -> 0
    }
}

/// A lambda parameter list's bound names.
fn boundParams(params: List<Param>) -> Map<string, bool> {
    var m = { "::seed::": true }
    m.remove("::seed::")
    for (p in params) {
        m[p.name] = true
    }
    m
}

/// Is `name` bound in one of the open lexical scopes at or above `from`?
/// Scopes below `from` belong to the enclosing function and are invisible to
/// a hoisted lambda body, so they are NOT treated as bound here (they must be
/// captured instead).
fn scopeContainsFrom(scope: List<Map<string, bool>>, fromLevel: int, name: string) -> bool {
    var i = len(scope)
    while (i >= 1) {
        i = i - 1
        if (i < fromLevel) {
            break
        }
        if (scope[i].has(name)) {
            return true
        }
    }
    false
}

/// Bind `name` in the innermost open scope.
fn scopeBind(scope: List<Map<string, bool>>, name: string) {
    if (len(scope) >= 1) {
        var top = scope[len(scope) - 1]
        top[name] = true
    }
}

/// The names a pattern binds (only `Pattern.Binding` introduces names).
fn patternBinds(p: Pattern) -> List<string> {
    var out = emptyStrs()
    collectBinds(p, out)
    out
}

fn collectBinds(p: Pattern, out: List<string>) {
    match (p) {
        case Pattern.Binding(name, _) -> out.push(name)
        case Pattern.Tuple(xs) -> {
            for (x in xs) {
                collectBinds(x, out)
            }
        }
        case Pattern.Or(xs) -> {
            for (x in xs) {
                collectBinds(x, out)
            }
        }
        case Pattern.Variant(_, payloads) -> {
            for (x in payloads) {
                collectBinds(x, out)
            }
        }
        case Pattern.Wildcard | Pattern.Literal(_) -> {}
    }
}

/// Is `e` a `this(...)` call expression?
fn thisCallExpr(e: Expr) -> Expr? {
    match (e.kind) {
        case ExprKind.Call(callee, _) -> {
            match (callee.kind) {
                case ExprKind.This -> e
                case _ -> none
            }
        }
        case _ -> none
    }
}

/// The single `this(...)` delegation expression of a named-constructor body, or
/// `None` if the body is not exactly one such expression (as a statement or a
/// block tail).
fn namedCtorDelegation(body: Block) -> Expr? {
    if (len(body.stmts) == 0) {
        return match (body.expr) {
            case some(e) -> thisCallExpr(e)
            case none -> none
        }
    }
    if (len(body.stmts) != 1) {
        return none
    }
    var res: Expr? = none
    match (body.expr) {
        case none -> {
            match (body.stmts[0]) {
                case Stmt.Expr(e) -> res = thisCallExpr(e)
                case _ -> {}
            }
        }
        case some(_) -> {}
    }
    res
}

/// The leading `super(...)` delegation expression of a primary-constructor
/// body, when it is the first statement. The call's arguments are evaluated
/// in the current function's scope and fed to the parent constructor.
fn ctorSuperDelegation(body: Block) -> Expr? {
    if (len(body.stmts) == 0) {
        return none
    }
    match (body.stmts[0]) {
        case Stmt.Expr(e) -> {
            match (e.kind) {
                case ExprKind.Call(callee, _) -> {
                    match (callee.kind) {
                        case ExprKind.Super -> e
                        case _ -> none
                    }
                }
                case _ -> none
            }
        }
        case _ -> none
    }
}

/// Static slot number of static field `name` (its position among static
/// fields).
fn staticFieldSlot(table: ClassTable, name: string) -> int? {
    var n = 0
    for (f in table.fields) {
        if (f.isStatic) {
            if (f.name == name) {
                return n
            }
            n = n + 1
        }
    }
    none
}

/// The declared info of static field `name`, when present.
fn staticFieldInfo(table: ClassTable, name: string) -> FieldInfo? {
    for (f in table.fields) {
        if (f.isStatic && f.name == name) {
            return f
        }
    }
    none
}

/// The IR type a `List<T>` element value carries outside the runtime.
fn elemIr(elem: Ty) -> IrTy {
    match (elem) {
        case Ty.Int -> IrTy.Int
        case Ty.Float -> IrTy.Float
        case Ty.Bool -> IrTy.Bool
        case Ty.Byte -> IrTy.Int
        case Ty.Char -> IrTy.Char
        case Ty.String -> IrTy.Str
        case _ -> IrTy.Ptr
    }
}

fn emptyFnSources() -> List<FnSource> {
    var l = [FnSource.TopLevel(FnDecl("x", Span(0, 0), Visibility.Public, false, emptyGenericParams(), emptyParams(), none, none))]
    l.pop()
    l
}

fn emptyCaptures() -> List<Capture> {
    var l = [Capture("x", Ty.Int, Span(0, 0))]
    l.pop()
    l
}

fn emptyPatterns() -> List<Pattern> {
    var l = [Pattern.Binding("x", none)]
    l.pop()
    l
}

fn emptyClassPlans() -> List<ClassPlan> {
    var l = [ClassPlan("x", 0, none, seedClassTable())]
    l.pop()
    l
}

fn emptyLoopCtxs() -> List<LoopCtx> {
    var l = [LoopCtx(0, 0)]
    l.pop()
    l
}

fn emptyHandlerCtxs() -> List<HandlerCtx> {
    var l = [HandlerCtx(0, 0, false)]
    l.pop()
    l
}

fn emptySlotInits() -> List<SlotInit> {
    var l = [SlotInit(0, Expr(Span(0, 0), ExprKind.Ident("x")))]
    l.pop()
    l
}

fn emptyStaticInitEntries() -> List<StaticInitEntry> {
  var l = [StaticInitEntry(0, 0, none)]
  l.pop()
  l
}

fn emptyManagedGlobalInits() -> List<ManagedGlobalInit> {
  var l = [ManagedGlobalInit(0, IrTy.Str, Expr(Span(0, 0), ExprKind.Lit(Lit.Int(0))))]
  l.pop()
  l
}

fn emptyCtorArgVals() -> List<CtorArgVal> {
    var l = [CtorArgVal(0, Ty.Int, Span(0, 0))]
    l.pop()
    l
}

fn emptyCtorParams() -> List<CtorParam> {
    var l = [CtorParam("x", Ty.Int, Span(0, 0), -1)]
    l.pop()
    l
}

fn emptyRegPlans() -> List<RegPlan> {
    var l = [RegPlan("x", 0, 0, 0, 0)]
    l.pop()
    l
}

fn emptyDispatchBranches() -> List<DispatchBranch> {
    var l = [DispatchBranch(0, 0)]
    l.pop()
    l
}

fn emptyScopeMaps() -> List<Map<string, bool>> {
    var l = [boundParams(emptyParams())]
    l.pop()
    l
}

fn seedClassTable() -> ClassTable {
    ClassTable("x", Span(0, 0), Visibility.Public, emptyStrs(), none, emptyTys(), emptyFieldInfos(), emptyCallableInfos(), emptyPropertyInfos(), none, emptyNamedCtorInfos(), emptyFieldInfos())
}

/// A seeded empty primary-constructor declaration.
fn seedConstructorDecl() -> ConstructorDecl {
    ConstructorDecl(none, Span(0, 0), Visibility.Public, emptyParams(), emptyBlock())
}

fn emptyFieldInfos() -> List<FieldInfo> {
    var l = [FieldInfo("x", Visibility.Public, false, false, false, false, Ty.Int, Span(0, 0))]
    l.pop()
    l
}

fn emptyCallableInfos() -> List<CallableInfo> {
    var l = [CallableInfo("x", Span(0, 0), Visibility.Public, false, false, false, false, none, emptyStrs(), emptyParamInfos(), Ty.Int)]
    l.pop()
    l
}

fn emptyPropertyInfos() -> List<PropertyInfo> {
    var l = [PropertyInfo("x", Visibility.Public, false, Ty.Int, false, false, Span(0, 0))]
    l.pop()
    l
}

fn emptyParamInfos() -> List<ParamInfo> {
    var l = [ParamInfo("x", Ty.Int, false, false, Span(0, 0))]
    l.pop()
    l
}

fn emptyNamedCtorInfos() -> List<NamedCtorInfo> {
    var l = [NamedCtorInfo("x", CtorInfo(Span(0, 0), Visibility.Public, emptyParamInfos()))]
    l.pop()
    l
}

/// Registered instance-method resolution: a function plus whether it is
/// static, keyed by (class id, method name).
class MethodRef {
    var fid: int
    var isStatic: bool

    constructor(fid: int, isStatic: bool) {
        this.fid = fid
        this.isStatic = isStatic
    }
}

/// Declared info and initializer of a class-level `const`, keyed by
/// (class id, const name) and inlined at use sites.
class ClassConst {
    var field: FieldInfo
    var init: Expr

    constructor(field: FieldInfo, init: Expr) {
        this.field = field
        this.init = init
    }
}

/// A top-level `var` that could not be lowered to a data symbol. Kept as a
/// record instead of reporting inline so the rest of the module still emits.
class GlobalFailure {
    var name: string
    var span: Span
    var msg: string

    constructor(name: string, span: Span, msg: string) {
        this.name = name
        this.span = span
        this.msg = msg
    }
}

/// Outcome of reducing a global initializer to bytes: `bytes == none` means
/// zero-init (`.bss`); a non-empty `err` means the initializer was rejected.
class GlobalInitResult {
    var bytes: List<int>?
    var err: string

    constructor(bytes: List<int>?, err: string) {
        this.bytes = bytes
        this.err = err
    }
}

/// One interface member in declaration order: `(method name, method index)`.
class IfaceMember {
    var name: string
    var index: int

    constructor(name: string, index: int) {
        this.name = name
        this.index = index
    }
}

/// One direct `implements` declaration: the interface id plus its
/// method-index -> implementation map.
class IfaceBucket {
    var ifaceId: int
    var methods: List<DispatchBranch>

    constructor(ifaceId: int, methods: List<DispatchBranch>) {
        this.ifaceId = ifaceId
        this.methods = methods
    }
}

/// `<a>|<b>|<c>` composite key standing in for Rust's `HashMap<(A, B, C), _>`.
fn tripleKey(a: string, b: string, c: string) -> string {
    a + "|" + b + "|" + c
}

/// One instance method visible at a receiver class: `(name, fid)`.
class NamedFid {
    var name: string
    var fid: int

    constructor(name: string, fid: int) {
        this.name = name
        this.fid = fid
    }
}

/// One recorded `method_ids` insertion in program order, with the receiver
/// class id kept alongside the string key so `build_virtual_dispatch` can walk
/// the method table without decoding `pairKey` keys.
class MethodEntry {
    var cid: int
    var name: string
    var fid: int
    var isStatic: bool

    constructor(cid: int, name: string, fid: int, isStatic: bool) {
        this.cid = cid
        this.name = name
        this.fid = fid
        this.isStatic = isStatic
    }
}

/// A virtual-dispatch candidate before sorting: `(cid, depth, fid)`.
class DispatchBranchDepth {
    var dcid: int
    var depth: int
    var dfid: int

    constructor(dcid: int, depth: int, dfid: int) {
        this.dcid = dcid
        this.depth = depth
        this.dfid = dfid
    }
}

/// An interface-dispatch branch before sorting: `(depth, cid, fid)`. Sorted
/// deepest-derived first with class-id ties ascending, mirroring Rust's
/// `sort_by(|a, b| b.0.cmp(&a.0).then_with(|| a.1.cmp(&b.1)))`.
class IfaceDepthBranch {
    var depth: int
    var cid: int
    var fid: int

    constructor(depth: int, cid: int, fid: int) {
        this.depth = depth
        this.cid = cid
        this.fid = fid
    }
}

/// One recorded property-accessor insertion in program order, keeping the
/// receiver class id and `is_set` flag alongside the `tripleKey` key so
/// superclass slots can be inherited without decoding string keys.
class PropertyEntry {
    var cid: int
    var name: string
    var isSet: bool
    var fid: int

    constructor(cid: int, name: string, isSet: bool, fid: int) {
        this.cid = cid
        this.name = name
        this.isSet = isSet
        this.fid = fid
    }
}

/// `(interface name, type arguments)` extracted from an interface type.
class IfaceRef {
    var name: string
    var args: List<Ty>

    constructor(name: string, args: List<Ty>) {
        this.name = name
        this.args = args
    }
}

/// One static-field slot pending its initializer: `(slot, value expr)`,
/// waiting for the class id before it becomes a `StaticInitEntry`.
class StaticSlotInit {
    var slot: int
    var value: Expr?

    constructor(slot: int, value: Expr?) {
        this.slot = slot
        this.value = value
    }
}

/// One value passed to a chained `super(...)`/forwarded constructor:
/// `(value temp, checked type, span)`.
class CtorArgVal {
    var v: int
    var ty: Ty
    var span: Span

    constructor(v: int, ty: Ty, span: Span) {
        this.v = v
        this.ty = ty
        this.span = span
    }
}

/// One primary-constructor parameter as lowered by `build_ctor_body`:
/// `(name, type, span)` plus the absolute instance-field slot the value must
/// be stored into (`-1` for an explicit constructor parameter, which the
/// body assigns itself).
class CtorParam {
    var name: string
    var ty: Ty
    var span: Span
    var fieldSlot: int

    constructor(name: string, ty: Ty, span: Span, fieldSlot: int) {
        this.name = name
        this.ty = ty
        this.span = span
        this.fieldSlot = fieldSlot
    }
}

/// The result of `synthesized_ctor_param_meta`: the absolute instance-field
/// slot each synthesized parameter must be stored into (`-1` = a leading
/// explicit-ancestor primary-constructor parameter, forwarded to its
/// chain), plus the nearest explicit-primary ancestor to chain into
/// (`chainName == ""` when none) and how many leading parameters its chain
/// consumes.
class CtorParamMeta {
    var slots: List<int>
    var chainName: string
    var chainCount: int

    constructor(slots: List<int>, chainName: string, chainCount: int) {
        this.slots = slots
        this.chainName = chainName
        this.chainCount = chainCount
    }
}

/// The nearest explicit-primary-constructor ancestor of a class: its name
/// and the absolute end slot of its own instance fields.
class AncestorMeta {
    var name: string
    var endSlot: int

    constructor(name: string, endSlot: int) {
        this.name = name
        this.endSlot = endSlot
    }
}

/// One `pickle_class_register` plan: `(name, field count, class id, parent
/// id, manual-field owned mask)`.
class RegPlan {
    var name: string
    var fieldCount: int
    var cid: int
    var parent: int
    var owned: int

    constructor(name: string, fieldCount: int, cid: int, parent: int, owned: int) {
        this.name = name
        this.fieldCount = fieldCount
        this.cid = cid
        this.parent = parent
        this.owned = owned
    }
}

/// `<a>|<b>` composite key standing in for Rust's `HashMap<(A, B), _>`.
fn pairKey(a: string, b: string) -> string {
    a + "|" + b
}

/// Generic-instantiation key for a function/class/interface name plus its
/// concrete type arguments, standing in for Rust's `(String, Vec<Ty>)`. The
/// arg rendering matches the runtime symbol suffix `name<b1, b2>`.
fn instKey(name: string, args: List<Ty>) -> string {
    name + "<" + bareJoin(args, ", ") + ">"
}

/// `@<fid>|<span>` key for lambda registrations, standing in for Rust's
/// `(Option<FuncId>, Span)`. `-` marks module scope (no enclosing function).
fn lambdaKey(owner: int?, span: Span) -> string {
    var o = "-"
    match (owner) {
        case some(f) -> o = "@" + str(f)
        case none -> {}
    }
    o + "|" + spanKey(span)
}

/// True when `x` is `some` (the checker rejects `x == none` directly).
fn isSomeInt(x: int?) -> bool {
    match (x) {
        case some(_) -> true
        case none -> false
    }
}

/// True when `x` is `none`.
fn isNoneInt(x: int?) -> bool {
    match (x) {
        case some(_) -> false
        case none -> true
    }
}

/// True when `s` is an element of `xs`.
fn hasStr(xs: List<string>, s: string) -> bool {
    var i = 0
    while (i < len(xs)) {
        if (xs[i] == s) {
            return true
        }
        i = i + 1
    }
    false
}

/// The interface instantiation behind `ty`, or `none`: `Ty::Interface` as-is,
/// peeling a leading reference.
fn ifaceOf(ty: Ty) -> IfaceRef? {
    match (ty) {
        case Ty.Interface(n, a) -> IfaceRef(n, a)
        case Ty.Ref(inner) -> ifaceOf(inner)
        case _ -> none
    }
}

/// The literal text of a string-literal part, or `none` when it interpolates.
fn textOf(p: StrPart) -> string? {
    match (p) {
        case StrPart.Text(t) -> t
        case StrPart.Expr(_) -> none
    }
}

/// True when every part of a string-literal template is plain text.
fn allTextParts(parts: List<StrPart>) -> bool {
    var ok = true
    for (p in parts) {
        if (let none = textOf(p)) {
            ok = false
        }
    }
    ok
}

/// Concatenate the literal text of a string-literal template (interpolated
/// parts contribute nothing).
fn joinText(parts: List<StrPart>) -> string {
    var text = ""
    for (p in parts) {
        if (let some(t) = textOf(p)) {
            text = text + t
        }
    }
    text
}

