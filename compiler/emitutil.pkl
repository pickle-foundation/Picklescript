fn globalInitOk(b: List<int>?) -> GlobalInitResult {
   GlobalInitResult(b, "")
   }

/// True when a declaration carried an explicit `: Type` annotation.
fn hasTypeExpr(te: TypeExpr?) -> bool {
   if (let some(_v) = te) {
   return true
   }
   false
   }

fn globalInitErr(msg: string) -> GlobalInitResult {
   GlobalInitResult(none, msg)
   }

fn emptyBytes8() -> List<int> {
   var b = [0, 0, 0, 0, 0, 0, 0, 0]
   b
   }

   fn emptyBytes4() -> List<int> {
       var b = [0, 0, 0, 0]
       b
   }

   fn emptyBytes1() -> List<int> {
       var b = [0]
       b
   }

   /// Little-endian bytes of a 32-bit slot. Mirrors `u32::to_le_bytes`.
   fn int32LeBytes(v: int) -> List<int> {
       var b = emptyBytes4()
       b[0] = v & 0xFF
       b[1] = (v >> 8) & 0xFF
       b[2] = (v >> 16) & 0xFF
       b[3] = (v >> 24) & 0xFF
       b
   }

   /// Little-endian bytes of an `f64`. Mirrors `f64::to_le_bytes`.
   fn float64LeBytes(v: float) -> List<int> {
       int64LeBytes(f64ToBits(v))
   }

/// Little-endian bytes of a 64-bit slot. Mirrors `i64::to_le_bytes`.
fn int64LeBytes(v: int) -> List<int> {
   var b = emptyBytes8()
   b[0] = v & 0xFF
   b[1] = (v >> 8) & 0xFF
   b[2] = (v >> 16) & 0xFF
   b[3] = (v >> 24) & 0xFF
   b[4] = (v >> 32) & 0xFF
   b[5] = (v >> 40) & 0xFF
   b[6] = (v >> 48) & 0xFF
   b[7] = (v >> 56) & 0xFF
   b
   }

/// Linker symbol for a top-level `var`. The `pkl_global_` prefix is reserved:
/// a function named `global_x` would otherwise collide with a global `x`.
fn globalSymbol(name: string) -> string {
   "pkl_global_" + name
   }

/// Source `Ty` -> IR slot type, or `none` when this slice has no lowering for
/// it yet.
fn globalIrTy(ty: Ty) -> IrTy? {
      if (ty == Ty.Int) {
          return IrTy.Int
      }
      if (ty == Ty.Bool) {
          return IrTy.Bool
      }
      if (ty == Ty.Char) {
          return IrTy.Char
      }
      if (ty == Ty.Float) {
          return IrTy.Float
      }
      if (ty == Ty.String) {
          return IrTy.Str
      }
      // Every remaining reference type is one GC object of a known class, so the
      // slot holds a raw object pointer that the collector traces through the
      // registered root. `Fn` is excluded because a closure is not a single
      // object, and `Option` because it is not one either.
      match (ty) {
          case Ty.List(_) -> IrTy.Ptr
          case Ty.Map(_, _) -> IrTy.Ptr
          case Ty.Tuple(_) -> IrTy.Ptr
          case Ty.Class(_, _) -> IrTy.Ptr
          case Ty.Struct(_, _) -> IrTy.Ptr
          case Ty.Enum(_, _) -> IrTy.Ptr
          case _ -> none
      }
  }

/// Reduce a global initializer to little-endian image bytes.
///
/// Returns `ok(none)` for a managed slot: `Str` and `Ptr` have no static form,
/// so the COFF writer emits a zeroed 8-byte slot and the value plus its
/// `pickle_gc_root_add` registration are emitted into `pkl_globals_init`
/// instead.
///
/// The scalars are the POD types, each as a literal (float and int may be
/// negated): enough to prove the `.data` path end to end without inventing a
/// general static-evaluator.
fn globalInitBytes(e: Expr, ty: IrTy, name: string) -> GlobalInitResult {
    // The article is part of the type phrase: "an integer" but "a bool".
    var want = match (ty) {
    case IrTy.Bool -> "a bool"
    case IrTy.Char -> "a char"
    case IrTy.Float -> "a float"
    case _ -> "an integer"
    }
    var mismatch = "the initializer of top-level `var " + name + "` must be " + want + " literal; a scalar global's value is written into the image before `main` runs, so its initializer cannot call, load, or allocate"
    // Negation is the one unary that still yields a static scalar.
    var inner = match (e.kind) {
    case ExprKind.Unary(op, operand) -> match (op) {
    case UnOp.Neg -> operand
    case _ -> none
    }
    case _ -> none
    }
    if (ty == IrTy.Bool) {
        if (let some(b) = matchLitBool(e)) {
            var one = emptyBytes1()
            one[0] = if (b) { 1 } else { 0 }
            return globalInitOk(one)
        }
        return globalInitErr(mismatch)
    }
    if (ty == IrTy.Char) {
        if (let some(c) = matchLitChar(e)) {
            return globalInitOk(int32LeBytes(c))
        }
        return globalInitErr(mismatch)
    }
    if (ty == IrTy.Float) {
        if (let some(v) = matchLitFloat(e, inner)) {
            return globalInitOk(float64LeBytes(v))
        }
        return globalInitErr(mismatch)
    }
    if (let some(v) = matchLitInt(e, inner)) {
        return globalInitOk(int64LeBytes(v))
    }
    if (ty == IrTy.Unit) {
        return globalInitOk(none)
    }
if (ty == IrTy.Str || ty == IrTy.Ptr) {
          // Managed: no static bytes. The COFF writer already emits an 8-byte
          // zero slot for a `none` initializer, and the value plus the
          // `pickle_gc_root_add` registration are emitted into `pkl_globals_init`.
          return globalInitOk(none)
      }
    return globalInitErr(mismatch)
  }

  fn matchLitBool(e: Expr) -> bool? {
    match (e.kind) {
    case ExprKind.Lit(Lit.Bool(b)) -> b
    case _ -> none
    }
  }

fn matchLitChar(e: Expr) -> int? {
    match (e.kind) {
    case ExprKind.Lit(Lit.Char(c)) -> c as int
    case _ -> none
    }
}

  fn matchLitInt(e: Expr, neg: Expr?) -> int? {
    if (let some(operand) = neg) {
        if (let some(v) = matchLitInt(operand, none)) {
            return 0 - v
        }
        return none
    }
    match (e.kind) {
    case ExprKind.Lit(Lit.Int(v)) -> v
    case _ -> none
    }
  }

fn matchLitFloat(e: Expr, neg: Expr?) -> float? {
    if (let some(operand) = neg) {
        if (let some(v) = matchLitFloat(operand, none)) {
            return 0.0 - v
        }
        return none
    }
match (e.kind) {
    case ExprKind.Lit(Lit.Float(text)) -> floatVal(text)
    case _ -> none
    }
}

