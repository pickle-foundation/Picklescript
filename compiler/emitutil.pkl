/// One free-identifier occurrence a walk records: `(name, span)`.
class NameRef {
    var name: string
    var span: Span

    constructor(name: string, span: Span) {
        this.name = name
        this.span = span
    }
}

/// `(declaring class id, static slot, declared info)` of a resolved static
/// field, mirroring the Rust `Option<(u32, usize, FieldInfo)>`.
class StaticFieldLoc {
    var dcid: int
    var slot: int
    var info: FieldInfo

    constructor(dcid: int, slot: int, info: FieldInfo) {
        this.dcid = dcid
        this.slot = slot
        this.info = info
    }
}

