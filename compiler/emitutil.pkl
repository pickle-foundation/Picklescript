/// Byte-wise lexicographic ordering, matching Rust's `String::cmp` for the
/// ASCII identifier names capture lists sort by.
fn strLess(a: string, b: string) -> bool {
    var ab = bytesOf(a)
    var bb = bytesOf(b)
    var i = 0
    while (i < len(ab) && i < len(bb)) {
        if (ab[i] != bb[i]) {
            return ab[i] < bb[i]
        }
        i = i + 1
    }
    len(ab) < len(bb)
}

fn bytesOf(s: string) -> List<int> {
    var out: List<int> = [0]
    out.pop()
    for (c in s) {
        out.push(c as int)
    }
    out
}

/// Split `xs[fromLevel..]` off into a new list, order-preserving on both
/// sides (the tail is returned; `xs` keeps its prefix). Mirrors Rust's
/// `Vec::split_off`, which the pickled port cannot call directly.
fn splitOff(xs: List<NameRef>, fromLevel: int) -> List<NameRef> {
    var tail = emptyNameRefs()
    var keep = emptyNameRefs()
    var i = fromLevel
    while (i < len(xs)) {
        tail.push(xs[i])
        i = i + 1
    }
    var j = 0
    while (j < fromLevel) {
        keep.push(xs[j])
        j = j + 1
    }
    while (len(xs) > 0) {
        xs.remove(len(xs) - 1)
    }
    for (k in keep) {
        xs.push(k)
    }
    tail
}

/// A small integer tag per `IrTy`, so option-less IR types can be compared
/// with plain `==`.
fn irTyTag(t: IrTy) -> int {
    match (t) {
        case IrTy.Bool -> 0
        case IrTy.Char -> 1
        case IrTy.Int -> 2
        case IrTy.Float -> 3
        case IrTy.Str -> 4
        case IrTy.Unit -> 5
        case IrTy.Ptr -> 6
    }
}

fn irTysEqual(a: List<IrTy>, b: List<IrTy>) -> bool {
    if (!(len(a) == len(b))) {
        return false
    }
    var i = 0
    while (i < len(a)) {
        if (!(irTyTag(a[i]) == irTyTag(b[i]))) {
            return false
        }
        i = i + 1
    }
    true
}

/// Byte-wise list-of-ints equality (the string table's entries).
fn intListsEqual(a: List<int>, b: List<int>) -> bool {
    if (!(len(a) == len(b))) {
        return false
    }
    var i = 0
    while (i < len(a)) {
        if (!(a[i] == b[i])) {
            return false
        }
        i = i + 1
    }
    true
}

fn seedScopeMap() -> Map<string, bool> {
    let m = {"::seed::": true}
    m.remove("::seed::")
    m
}

/// How a `List<T>` element (or `Map<K,_>` key) is represented at the runtime
/// boundary. `Ptr` passes the managed value through as a pointer; `Scalar`
/// records the box/unbox extern pair and the scalar IR type.
class ElemRep {
    isPtr: bool
    boxSym: string
    unboxSym: string
    ir: IrTy
    static fn ptr() -> ElemRep {
        ElemRep(true, "pickle_box_i64", "pickle_unbox_i64", IrTy.Int)
    }
    static fn scalar(boxSym: string, unboxSym: string, ir: IrTy) -> ElemRep {
        ElemRep(false, boxSym, unboxSym, ir)
    }
}

/// Whether a string list contains `s` (the ported form of
/// `const_inlining.iter().any(|n| n == ...)`).
fn strListHas(l: List<string>, s: string) -> bool {
    for (x in l) {
        if (x == s) {
            return true
        }
    }
    false
}

/// The name of an `Ident` expression, or `none` for any other kind.
fn exprKindIdentName(e: Expr) -> string? {
    match (e.kind) {
        case ExprKind.Ident(n) -> n
        case _ -> none
    }
}

fn kindDbg(e: Expr) -> string {
    match (e.kind) {
        case ExprKind.Ident(n) -> "ident:" + n
        case ExprKind.Member(obj, n) -> "member:." + n
        case ExprKind.Call(_, _) -> "call"
        case ExprKind.Binary(_, _, _) -> "binop"
        case ExprKind.Lit(_) -> "lit"
        case ExprKind.This -> "this"
        case ExprKind.Block(_) -> "block"
        case _ -> "other"
    }
}

/// Whether any argument carries a spread (`...list`).
fn anySpread(a: List<CallArg>) -> bool {
    for (x in a) {
        if (x.spread) {
            return true
        }
    }
    false
}

/// Whether two element representations round-trip identically at the runtime
/// boundary. Mirrors `ElemRep::eq`.
fn elemRepSame(a: ElemRep, b: ElemRep) -> bool {
    a.isPtr == b.isPtr && a.boxSym == b.boxSym && a.unboxSym == b.unboxSym && irTyTag(a.ir) == irTyTag(b.ir)
}

/// The IR binary op for an AST binary operator, with a defensive fallback to
/// `Add` (only the arithmetic/comparison ops reach the generic `BinOp` tail).
/// Mirrors `binary_opcode` in emit.rs.
fn binaryOpcode(op: BinOp) -> IrBinOp {
    match (op) {
        case BinOp.Add -> IrBinOp.Add
        case BinOp.Sub -> IrBinOp.Sub
        case BinOp.Mul -> IrBinOp.Mul
        case BinOp.Div -> IrBinOp.Div
        case BinOp.Mod -> IrBinOp.Mod
        case BinOp.Shl -> IrBinOp.Shl
        case BinOp.Shr -> IrBinOp.Shr
        case BinOp.BitAnd -> IrBinOp.BitAnd
        case BinOp.BitOr -> IrBinOp.BitOr
        case BinOp.BitXor -> IrBinOp.BitXor
        case BinOp.Lt -> IrBinOp.Lt
        case BinOp.Le -> IrBinOp.Le
        case BinOp.Gt -> IrBinOp.Gt
        case BinOp.Ge -> IrBinOp.Ge
        case BinOp.Eq -> IrBinOp.Eq
        case BinOp.Ne -> IrBinOp.Ne
        case _ -> IrBinOp.Add
    }
}

/// The IR binary op for a compound `op=` assignment (`Assign` never combines;
/// it falls back to `Add`). Mirrors `assign_opcode` in emit.rs.
fn assignOpcode(op: AssignOp) -> IrBinOp {
    match (op) {
        case AssignOp.Add -> IrBinOp.Add
        case AssignOp.Sub -> IrBinOp.Sub
        case AssignOp.Mul -> IrBinOp.Mul
        case AssignOp.Div -> IrBinOp.Div
        case AssignOp.Mod -> IrBinOp.Mod
        case AssignOp.Shl -> IrBinOp.Shl
        case AssignOp.Shr -> IrBinOp.Shr
        case AssignOp.BitAnd -> IrBinOp.BitAnd
        case AssignOp.BitOr -> IrBinOp.BitOr
        case AssignOp.BitXor -> IrBinOp.BitXor
        case AssignOp.Assign -> IrBinOp.Add
    }
}

/// Can two comparison operands share one `icmp`/`fcmp`? The scalar mix
/// `int`/`float` is handled by the `Itof` promotion counting as compatible;
/// everything else must be the same IR type. Unknown/unresolved types count
/// as compatible so substitution-time programs keep flowing to their concrete
/// form. `-1` is the "unknown/missing" sentinel. Mirrors
/// `cmp_types_compatible` in emit.rs.
fn cmpTypesCompatible(aTag: int, bTag: int) -> bool {
    if (aTag < 0 || bTag < 0) {
        return true
    }
    if (aTag == irTyTag(IrTy.Float) || bTag == irTyTag(IrTy.Float)) {
        return true
    }
    aTag == bTag
}

/// Flip a comparison op under a logical `.not()`. Note `!EQ -> NE`, `!GT ->
/// LE`, `!LT -> GE` (the non-strict inverse), which is what a "not greater"
/// pass really means. Mirrors `flip_cmp` in emit.rs.
fn flipCmp(op: IrBinOp, negated: bool) -> IrBinOp {
    if (!negated) {
        return op
    }
    match (op) {
        case IrBinOp.Eq -> IrBinOp.Ne
        case IrBinOp.Ne -> IrBinOp.Eq
        case IrBinOp.Gt -> IrBinOp.Le
        case IrBinOp.Ge -> IrBinOp.Lt
        case IrBinOp.Lt -> IrBinOp.Ge
        case IrBinOp.Le -> IrBinOp.Gt
        case _ -> op
    }
}

/// The Rust `Debug` name of a binary operator, used in defensive messages.
fn binOpName(op: BinOp) -> string {
    match (op) {
        case BinOp.Add -> "Add"
        case BinOp.Sub -> "Sub"
        case BinOp.Mul -> "Mul"
        case BinOp.Div -> "Div"
        case BinOp.Mod -> "Mod"
        case BinOp.Pow -> "Pow"
        case BinOp.Shl -> "Shl"
        case BinOp.Shr -> "Shr"
        case BinOp.BitAnd -> "BitAnd"
        case BinOp.BitOr -> "BitOr"
        case BinOp.BitXor -> "BitXor"
        case BinOp.Lt -> "Lt"
        case BinOp.Le -> "Le"
        case BinOp.Gt -> "Gt"
        case BinOp.Ge -> "Ge"
        case BinOp.Eq -> "Eq"
        case BinOp.Ne -> "Ne"
        case BinOp.And -> "And"
        case BinOp.Or -> "Or"
        case BinOp.Range -> "Range"
        case BinOp.RangeIncl -> "RangeIncl"
        case BinOp.NullCoalesce -> "NullCoalesce"
        case BinOp.Send -> "Send"
        case BinOp.Is -> "Is"
        case BinOp.In -> "In"
    }
}

/// Parse a float literal's text into the `f64` value it denotes. The checker
/// has already validated the shape, so no error handling is needed. Mirrors
/// Rust's `str::parse::<f64>()` for the plain decimal literals the test suite
/// `[-]digits[.digits][e[+-]digits]` (no exponents beyond that shape, `_`
/// separators already stripped) -> the same `f64` Rust's
/// `text.parse::<f64>()` produces, bit for bit.
///
/// This delegates to `irxParseFloat`, which builds the exact decimal as a
/// big integer and performs one correctly-rounded conversion. Do not
/// reintroduce the obvious shortcut of scaling `mant as float` by a power of
/// ten: that needs three separate roundings (`mant as float`, building `p`,
/// and the multiply/divide), so it silently loses the value at both ends of
/// the range. `p = 10.0^|scale|` overflows to `inf` for any `scale < -308`,
/// which turned every subnormal literal (`1e-320`, `5e-324`) into `0.0`, and
/// `scale > 0` overflowed to `inf` for large magnitudes
/// (`1.7976931348623157e308`). Repeated multiplication also accumulated error
/// well before that, so `1e300` came out as `1.0000000000000002e300`.
///
/// The token is lexed as a number before we get here, so a `none` result is
/// unreachable; `0.0` is only a defensive fallback.
fn floatVal(text: string) -> float {
    if (let some(v) = irxParseFloat(text)) {
        return v
    }
    0.0
}

/// `(class name, registered class id)` closed over by the cast helpers for a
/// concrete `Ty::Class(n, [])`. Mirrors Rust's `user_class_id` result.
class UserClassRef {
    var name: string
    var id: int

    constructor(name: string, id: int) {
        this.name = name
        this.id = id
    }
}

/// The declared type and lowered value of an `a?.name` / `a?.prop` read.
class OptMemberVal {
    var ty: Ty
    var v: int

    constructor(ty: Ty, v: int) {
        this.ty = ty
        this.v = v
    }
}

/// The peeled `expect(value)` argument of an assertion chain, plus whether a
/// `.not()` flips the expectation. Rust's `Option<(&Expr, bool)>`.
class ExpectPeel {
    var value: Expr
    var negated: bool

    constructor(value: Expr, negated: bool) {
        this.value = value
        this.negated = negated
    }
}

    /// Collect the `#[tag("???????")]` values from an item's attributes. Arguments
    /// that are not plain string literals are ignored. Mirrors `item_tags`.
fn itemTags(attrs: List<Attribute>) -> List<string> {
        var out = emptyStrs()
        for (a in attrs) {
            if (a.name != "tag") {
                continue
            }
            for (arg in a.args) {
                match (arg.kind) {
                    case ExprKind.Lit(Lit.String(parts)) -> {
                        if (allTextParts(parts)) {
                            var text = joinText(parts)
                            if (!(text == "")) {
                                out.push(text)
                            }
                        }
                    }
                    case _ -> {}
                }
            }
        }
        out
    }

    /// True when `name`'s table declares a method `mname`.
fn hasMethodName(t: ClassTable, mname: string) -> bool {
        var i = 0
        while (i < len(t.methods)) {
            if (t.methods[i].name == mname) {
                return true
            }
            i = i + 1
        }
        false
    }

    /// The depth of `cname` inside an ancestry chain: rootmost is deepest
    /// distance, the element itself is 0. Mirrors the Rust position math.
fn chainDepth(chain: List<string>, cname: string) -> int {
        var i = 0
        while (i < len(chain)) {
            if (chain[i] == cname) {
                return len(chain) - 1 - i
            }
            i = i + 1
        }
        0
    }

    /// Sort dispatch candidates deepest-derived first (stable insertion sort).
fn sortBranches(branches: List<DispatchBranchDepth>) {
        var i = 1
        while (i < len(branches)) {
            var j = i
            while (j > 0 && branches[j - 1].depth < branches[j].depth) {
                var tmp = branches[j - 1]
                branches[j - 1] = branches[j]
                branches[j] = tmp
                j = j - 1
            }
            i = i + 1
        }
    }

    /// The generic-plan name behind `name`: for a materialized instantiation
    /// like `Counter<int>` the plan name `Counter` (declarations and
    /// initializers live under the plan key); otherwise `name` unchanged.
fn planName(name: string) -> string {
        var out = ""
        for (c in name) {
            if (c == 60) {
                break
            }
            out = out + "{c as char}"
        }
        out
    }

    /// Collect an `#[symbol("...")]` override from an item's attributes, giving a
    /// top-level function an exact C ABI symbol name instead of the `pkl_<name>`
    /// default. This is what lets the ported runtime define `pickle_*` ABI
    /// functions directly in Pickle. Returns none when absent.
    ///
    /// Mirrors `emit.rs::item_symbol`: only a single string literal made purely
    /// of text parts counts. Interpolation parts yield the empty string and are
    /// rejected, matching Rust's `StrPart::Expr(_) => String::new()`.
    ///
    /// This attribute was previously *validated* by `check.pkl` and then silently
    /// ignored at emit time, so the port emitted `pkl_abiExcUncaught` where Rust
    /// emits `pickle_exc_uncaught`. That made every ported `#[symbol]` fn unable to
    /// override the Rust runtime archive at all - see the duplicate-resolution note
    /// in `linklib.pkl::mergeAll`.
fn itemSymbol(attrs: List<Attribute>) -> string? {
        for (a in attrs) {
            if (a.name != "symbol") {
                continue
            }
            for (arg in a.args) {
                match (arg.kind) {
                    case ExprKind.Lit(lit) -> {
                        match (lit) {
                            case Lit.String(parts) -> {
                                var plain = true
                                var text = ""
                                for (p in parts) {
                                    if (let StrPart.Text(t) = p) {
                                        text += t
                                        true
                                    } else {
                                        plain = false
                                        false
                                    }
                                }
                                if (plain && text != "") {
                                    return text
                                }
                            }
                            case _ -> { false }
                        }
                    }
                    case _ -> { false }
                }
            }
        }
        none
    }

    /// The runtime symbol for a top-level callable.
fn symbolFor(name: string, isTest: bool) -> string {
        if (isTest) {
            return "pickle_test_" + name
        }
        if (name == "main") {
            return "pickle_main"
        }
        "pkl_" + name
    }

    /// The IR scalar type behind a language scalar type, if any.
fn scalarIr(t: Ty) -> IrTy? {
        match (t) {
            case Ty.Int -> IrTy.Int
            case Ty.Float -> IrTy.Float
            case Ty.Bool -> IrTy.Bool
            case Ty.Char -> IrTy.Char
            case Ty.Byte -> IrTy.Int
            case _ -> none
        }
    }

    /// The IR shape of a `T&`/`&T` referent type.
    ///
    /// A scalar referent (`*int`, `*float`, ...) is lowered to a MANAGED `Ptr`,
    /// not a raw `Int`. The value is still a bare address and the ABI is
    /// unchanged, but the home that carries it is now a shadow cell the
    /// collector scans. That is what keeps a scalar pointer alive across a call
    /// that may collect: `abi_list_push(list, v)` spills `list` and calls
    /// `require_capacity`, and with a raw `Int` home the collector could not see
    /// `list` and freed it out from under the callee (the heap write that
    /// faulted). Lowering it as unmanaged was the port's divergence; the raw
    /// buffer contract is unaffected because a `raw_alloc` block is outside the
    /// registry, so scanning its address is a no-op.
fn refIrTy(inner: Ty) -> IrTy {
        IrTy.Ptr
    }

    /// The zero span the port uses where Rust reports `FileId(0)`.
fn fnameSpanFallback() -> Span {
        Span(0, 0)
    }

    /// Managed (pointer-carrying) IR types need no scalar boxing.
fn managedIr(it: IrTy) -> bool {
        match (it) {
            case IrTy.Str -> true
            case IrTy.Ptr -> true
            case IrTy.Unit -> true
            case _ -> false
        }
    }

    /// Whether a match/if/if-let result needs a slot at all: only non-unit,
    /// present result types do. Mirrors `!matches!(res_ty, Some(IrTy::Unit) |
    /// None)` in emit.rs.
fn matchResultNeedsSlot(resTy: IrTy?) -> bool {
        if (let some(rt) = resTy) {
            if (irTyTag(rt) == irTyTag(IrTy.Unit)) {
                return false
            }
            return true
        }
        false
    }

    /// The raw IR domain a non-enum, non-string matched type lives in.
    /// Mirrors `scalar_ir_of` in emit.rs.
fn scalarIrOf(st: Ty) -> IrTy? {
        match (st) {
            case Ty.Int -> IrTy.Int
            case Ty.Byte -> IrTy.Int
            case Ty.Float -> IrTy.Float
            case Ty.Bool -> IrTy.Bool
            case Ty.Char -> IrTy.Char
            case _ -> none
        }
    }

    /// The tasks and synchronisation builtins, as
    /// `(runtime symbol, argument IR types, returns, result IR type, argument
    /// names)`. The result IR type is meaningful only when `returns` is true.
    /// Mirrors `flat_builtin` in emit.rs.
fn flatBuiltin(name: string) -> (string, List<IrTy>, bool, IrTy, List<string>)? {
        match (name) {
            case "thread_spawn" -> ("pickle_thread_spawn", [IrTy.Ptr], true, IrTy.Int, ["body"])
            case "thread_join" -> ("pickle_thread_join", [IrTy.Int], true, IrTy.Bool, ["task"])
            case "thread_finished" -> ("pickle_thread_finished", [IrTy.Int], true, IrTy.Bool, ["task"])
            case "thread_message" -> ("pickle_thread_panic_message", [IrTy.Int], true, IrTy.Ptr, ["task"])
            case "thread_count" -> ("pickle_thread_count", emptyIrTys(), true, IrTy.Int, emptyStrs())
            case "thread_current" -> ("pickle_thread_current", emptyIrTys(), true, IrTy.Int, emptyStrs())
            case "sleep_ms" -> ("pickle_thread_sleep_ms", [IrTy.Int], false, IrTy.Int, ["ms"])
            case "thread_yield" -> ("pickle_thread_yield", emptyIrTys(), false, IrTy.Int, emptyStrs())
            // Win32 import: `Sleep` (`VOID Sleep(DWORD)`), so a `#[symbol]`
            // body can occupy `pickle_thread_sleep_ms` with wall-clock sleep
            // and no Rust shim.
            case "win_sleep" -> ("__imp_Sleep", [IrTy.Int], false, IrTy.Int, ["ms"])
            // Win32 import. `__imp_` is the MSVC import-symbol prefix, and
            // the backend treats that prefix as "resolve me from a system
            // DLL" rather than "find me in the runtime archive".
            case "win_thread_id" -> ("__imp_GetCurrentThreadId", emptyIrTys(), true, IrTy.Int, emptyStrs())
            case "win_tls_alloc" -> ("__imp_TlsAlloc", emptyIrTys(), true, IrTy.Int, emptyStrs())
            case "win_tls_get" -> ("__imp_TlsGetValue", [IrTy.Int], true, IrTy.Int, ["slot"])
            case "win_tls_set" -> ("__imp_TlsSetValue", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["slot", "value"])
            // Process termination, reachable as an import so a `#[symbol]`
            // body can own the `pickle_exit` slot. No return: the Win32
            // prototype is `VOID ExitProcess(UINT)`.
                case "win_exit" -> ("__imp_ExitProcess", [IrTy.Int], false, IrTy.Int, ["code"])
                // The process heap, reachable as an import triple so a `#[symbol]`
                // body can own the `pickle_raw_alloc` / `pickle_raw_free` slots.
                // All three are KERNEL32 exports, and `HeapAlloc` on
                // `GetProcessHeap()` with zero flags is what Rust's `System`
                // allocator lowers to on Windows - so a block handed out by one
                // side and released by the other stays valid even if only one
                // half of the pair ends up ported.
                case "win_get_process_heap" -> ("__imp_GetProcessHeap", emptyIrTys(), true, IrTy.Int, emptyStrs())
                case "win_heap_alloc" -> ("__imp_HeapAlloc", [IrTy.Int, IrTy.Int, IrTy.Int], true, IrTy.Int, ["heap", "flags", "size"])
                // Void rather than the Win32 `BOOL`: the caller has no use for
                // the answer, and reading a 32-bit `BOOL` back as a 64-bit `Int`
                // would depend on the upper half happening to be zero.
                case "win_heap_free" -> ("__imp_HeapFree", [IrTy.Int, IrTy.Int, IrTy.Int], false, IrTy.Int, ["heap", "flags", "ptr"])
                // The filesystem entry points, so a `#[symbol]` body can own
                // the whole `fs.rs` surface. All are KERNEL32, which is what
                // `win_import_addr` and `pelink::isShellImp` already assume for
                // any `__imp_` other than `CommandLineToArgvW`.
                case "win_get_file_attributes_w" -> ("__imp_GetFileAttributesW", [IrTy.Int], true, IrTy.Int, ["path"])
                case "win_delete_file_w" -> ("__imp_DeleteFileW", [IrTy.Int], true, IrTy.Int, ["path"])
                case "win_remove_directory_w" -> ("__imp_RemoveDirectoryW", [IrTy.Int], true, IrTy.Int, ["path"])
                case "win_create_directory_w" -> ("__imp_CreateDirectoryW", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["path", "sec"])
                // `(0, NULL)` is the sizing call: it returns the UTF-16 units a
                // real call would need, counting the terminator.
                case "win_get_current_directory_w" -> ("__imp_GetCurrentDirectoryW", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["cap", "buf"])
                case "win_create_file_w" -> ("__imp_CreateFileW", [IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int], true, IrTy.Int, ["name", "access", "share", "sec", "disp", "flags", "tmpl"])
                case "win_read_file" -> ("__imp_ReadFile", [IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int], true, IrTy.Int, ["handle", "buf", "n", "pRead", "ov"])
                case "win_write_file" -> ("__imp_WriteFile", [IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int], true, IrTy.Int, ["handle", "buf", "n", "pWritten", "ov"])
                case "win_close_handle" -> ("__imp_CloseHandle", [IrTy.Int], true, IrTy.Int, ["handle"])
                case "win_find_first_file_w" -> ("__imp_FindFirstFileW", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["pattern", "data"])
                case "win_find_next_file_w" -> ("__imp_FindNextFileW", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["handle", "data"])
                case "win_find_close" -> ("__imp_FindClose", [IrTy.Int], true, IrTy.Int, ["handle"])
                case "win_get_std_handle" -> ("__imp_GetStdHandle", [IrTy.Int], true, IrTy.Int, ["which"])
                // The command line, so a `#[symbol]` body can own the
                // `pickle_args` slot: `GetCommandLineW` (KERNEL32) hands back
                // the process's UTF-16 line, `CommandLineToArgvW` (SHELL32 -
                // the one name `pelink::isShellImp` routes apart from
                // KERNEL32) splits it into a null-terminated `LPWSTR*`, and
                // `LocalFree` (KERNEL32) releases that block. The split takes
                // a second, out argument - a count slot - which it requires
                // to be a writable address; a program that never reads the
                // count still has to supply the slot, or the call returns
                // null as if the parse had failed. Void result so
                // the answer, which nobody reads, never has to agree with the
                // upper half of a 64-bit `Int`.
                case "win_get_command_line_w" -> ("__imp_GetCommandLineW", emptyIrTys(), true, IrTy.Int, emptyStrs())
                case "win_command_line_to_argv_w" -> ("__imp_CommandLineToArgvW", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["cmdline", "pargs"])
                case "win_local_free" -> ("__imp_LocalFree", [IrTy.Int], false, IrTy.Int, ["mem"])
                // Process spawning for `run_cmd`. Every parameter is a raw
                // `Int`: pointers, counts, and Win32 `BOOL`s all arrive as
                // machine words at the `CreateProcessW` boundary, and the
                // body is the only caller, so it passes 0/1 integers for the
                // inherit flag. See the comment in `resolve.pkl`.
                case "win_create_process_w" -> ("__imp_CreateProcessW", [IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int], true, IrTy.Int, ["app", "cmdline", "procAttr", "threadAttr", "inherit", "flags", "env", "cwd", "si", "pi"])
                case "win_create_pipe" -> ("__imp_CreatePipe", [IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int], true, IrTy.Int, ["pRead", "pWrite", "sec", "size"])
                case "win_set_handle_information" -> ("__imp_SetHandleInformation", [IrTy.Int, IrTy.Int, IrTy.Int], true, IrTy.Int, ["handle", "mask", "flags"])
                case "win_wait_single" -> ("__imp_WaitForSingleObject", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["handle", "ms"])
                case "win_get_exit_code_process" -> ("__imp_GetExitCodeProcess", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["handle", "pCode"])
                case "win_terminate_process" -> ("__imp_TerminateProcess", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["handle", "code"])
                case "win_peek_pipe" -> ("__imp_PeekNamedPipe", [IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int], true, IrTy.Int, ["handle", "buf", "n", "pRead", "pAvail"])
                case "win_get_environment_strings_w" -> ("__imp_GetEnvironmentStringsW", emptyIrTys(), true, IrTy.Int, emptyStrs())
                case "win_free_environment_strings_w" -> ("__imp_FreeEnvironmentStringsW", [IrTy.Int], true, IrTy.Int, ["block"])
                case "win_get_module_file_name_w" -> ("__imp_GetModuleFileNameW", [IrTy.Int, IrTy.Int, IrTy.Int], true, IrTy.Int, ["module", "buf", "size"])
                case "win_get_system_directory_w" -> ("__imp_GetSystemDirectoryW", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["buf", "size"])
                case "win_get_windows_directory_w" -> ("__imp_GetWindowsDirectoryW", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["buf", "size"])
                case "win_tick_ms64" -> ("__imp_GetTickCount64", emptyIrTys(), true, IrTy.Int, emptyStrs())
            case "mutex_new" -> ("pickle_mutex_new", emptyIrTys(), true, IrTy.Int, emptyStrs())
            case "mutex_lock" -> ("pickle_mutex_lock", [IrTy.Int], false, IrTy.Int, ["m"])
            case "mutex_trylock" -> ("pickle_mutex_trylock", [IrTy.Int], true, IrTy.Bool, ["m"])
            case "mutex_unlock" -> ("pickle_mutex_unlock", [IrTy.Int], false, IrTy.Int, ["m"])
            case "cond_new" -> ("pickle_cond_new", emptyIrTys(), true, IrTy.Int, emptyStrs())
            case "cond_signal" -> ("pickle_cond_signal", [IrTy.Int], false, IrTy.Int, ["c"])
            case "cond_broadcast" -> ("pickle_cond_broadcast", [IrTy.Int], false, IrTy.Int, ["c"])
            case "cond_wait" -> ("pickle_cond_wait", [IrTy.Int, IrTy.Int], false, IrTy.Int, ["c", "m"])
            case "sem_new" -> ("pickle_sem_new", [IrTy.Int], true, IrTy.Int, ["permits"])
            case "sem_acquire" -> ("pickle_sem_acquire", [IrTy.Int, IrTy.Int], false, IrTy.Int, ["s", "n"])
            case "sem_try_acquire" -> ("pickle_sem_try_acquire", [IrTy.Int, IrTy.Int], true, IrTy.Bool, ["s", "n"])
            case "sem_release" -> ("pickle_sem_release", [IrTy.Int, IrTy.Int], false, IrTy.Int, ["s", "n"])
            case "atomic_new" -> ("pickle_atomic_new", [IrTy.Int], true, IrTy.Int, ["value"])
            case "atomic_load" -> ("pickle_atomic_load", [IrTy.Int], true, IrTy.Int, ["a"])
            case "atomic_store" -> ("pickle_atomic_store", [IrTy.Int, IrTy.Int], false, IrTy.Int, ["a", "value"])
            case "atomic_add" -> ("pickle_atomic_add", [IrTy.Int, IrTy.Int], true, IrTy.Int, ["a", "delta"])
            case "atomic_cas" -> ("pickle_atomic_cas", [IrTy.Int, IrTy.Int, IrTy.Int], true, IrTy.Bool, ["a", "expected", "value"])
case "once_new" -> ("pickle_once_new", emptyIrTys(), true, IrTy.Int, emptyStrs())
        case "once_done" -> ("pickle_once_done", [IrTy.Int], true, IrTy.Bool, ["o"])
        case "once_run" -> ("pickle_once_run", [IrTy.Int, IrTy.Ptr], true, IrTy.Bool, ["o", "body"])
        case "channel_new" -> ("pickle_channel_new", [IrTy.Int], true, IrTy.Int, ["cap"])
        case "channel_cap" -> ("pickle_channel_cap", [IrTy.Int], true, IrTy.Int, ["ch"])
        case "channel_len" -> ("pickle_channel_len", [IrTy.Int], true, IrTy.Int, ["ch"])
        case "channel_send" -> ("pickle_channel_send", [IrTy.Int, IrTy.Int], false, IrTy.Int, ["ch", "value"])
        case "channel_try_send" -> ("pickle_channel_try_send", [IrTy.Int, IrTy.Int], true, IrTy.Bool, ["ch", "value"])
        case "channel_recv" -> ("pickle_channel_recv", [IrTy.Int], true, IrTy.Int, ["ch"])
        case "channel_try_recv" -> ("pickle_channel_try_recv", [IrTy.Int], true, IrTy.Ptr, ["ch"])
        case "channel_close" -> ("pickle_channel_close", [IrTy.Int], false, IrTy.Int, ["ch"])
        case "channel_closed" -> ("pickle_channel_closed", [IrTy.Int], true, IrTy.Bool, ["ch"])
          // Bit-reinterpret and class-name primitives. Both exist for the
          // `pickle_print_obj` port in `runtime/abi_console.pkl`.
          //
          // `f64FromBits` has no source-level spelling: `x as float` is a
          // *numeric* conversion, not a bitcast (verified - `1072693248 as
          // float` yields `1072693248`, not `0.5`). It is the exact inverse of
          // the boxing side, which stores `v.to_bits()`.
          //
          // `className` is the user-class fallback arm's lookup: the collector
          // holds the descriptor name table, and without a symbol the arm had
          // nothing to call. Returns a `string` object or `none`.
          case "f64FromBits" -> ("pickle_f64_from_bits", [IrTy.Int], true, IrTy.Float, ["bits"])
          case "className" -> ("pickle_class_name", [IrTy.Int], true, IrTy.Ptr, ["classId"])
        // Garbage collection. `bool` crosses the ABI as the C `bool` the
        // runtime extern takes, so it needs no boxing.
        case "gcCollect" -> ("pickle_gc_collect", [IrTy.Bool], false, IrTy.Int, ["force"])
        // Observable GC contract: the counters/threshold that make the
        // auto-collect decision drivable from Pickle (gc.rs:714/720/727).
        // All three return/take `u32` across the ABI, so `Int` unboxed.
        case "gcAllocationsSinceGc" -> ("pickle_gc_allocations_since_gc", emptyIrTys(), true, IrTy.Int, emptyStrs())
        case "gcBytesSinceGc" -> ("pickle_gc_bytes_since_gc", emptyIrTys(), true, IrTy.Int, emptyStrs())
        case "gcCollectionCount" -> ("pickle_gc_collection_count", emptyIrTys(), true, IrTy.Int, emptyStrs())
        case "gcSetThreshold" -> ("pickle_gc_set_threshold", [IrTy.Int], false, IrTy.Int, ["bytes"])
            case _ -> none
        }
    }

    /// Sort interface-dispatch candidates deepest-derived first, then by
    /// ascending class id (stable insertion sort). Mirrors Rust's
    /// `sort_by(|a, b| b.0.cmp(&a.0).then_with(|| a.1.cmp(&b.1)))`.
fn sortIfaceBranches(branches: List<IfaceDepthBranch>) {
        var i = 1
        while (i < len(branches)) {
            var j = i
            while (j > 0) {
                var prev = branches[j - 1]
                var b = branches[j]
                var swap = prev.depth < b.depth || (prev.depth == b.depth && prev.cid > b.cid)
                if (!swap) {
                    break
                }
                branches[j - 1] = b
                branches[j] = prev
                j = j - 1
            }
            i = i + 1
        }
    }

