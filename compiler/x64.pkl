        this.cb.u8(0x41)
        this.cb.u8(0x18)
        this.cb.u8(0x49)
        this.cb.u8(0x8B)
        this.cb.u8(0x51)
        this.cb.u8(0x10)
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0xE2)
        this.cb.u8(0xF8)
        this.cb.u8(0x48)
