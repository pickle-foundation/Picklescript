        this.cb.u8(0xCA)
        this.cb.u8(0x01)
        this.cb.u8(0x49)
        this.cb.u8(0x89)
        this.cb.u8(0x51)
        this.cb.u8(0x10)
        this.cb.u8(0x89)
        this.cb.u8(0xC1)
        this.cb.u8(0x83)
        this.cb.u8(0xE1)
        this.cb.u8(0x07)
        this.emitJcc(0x04, tailed)
        this.cb.u8(0xC1)
        this.cb.u8(0xE1)
