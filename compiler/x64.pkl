        this.cb.u8(0x48)
        this.cb.u8(0xD3)
        this.cb.u8(0xE2)
        this.cb.u8(0x48)
        this.cb.u8(0xFF)
        this.cb.u8(0xCA)
        this.cb.u8(0x4B)
        this.cb.u8(0x21)
        this.cb.u8(0x54)
        this.cb.u8(0x11)
        this.cb.u8(0x20)
        this.cb.u8(0x4F)
        this.cb.u8(0x09)
        this.cb.u8(0x5C)
        this.cb.u8(0x11)
        this.cb.u8(0x20)
        this.emitJmp(done1)
        this.starts[aligned1] = this.cb.size()
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0x5A)
        this.cb.u8(0x20)
        this.cb.u8(0x4F)
