    /// `pkl_wsMaskWord` inlined: a pure leaf that the generic call path wraps
    /// in a frame plus a stack write and read for every sub-expression.
    /// `abiStrSplitWhitespace` asks for the mask once per eight input bytes,
    /// so the benchmark's 240-byte lines reach it about thirty times each and
    /// that frame overhead was a measurable part of the split phase.
    ///
    /// The arithmetic is exactly the runtime body: each target byte produces
    /// `((xorWord & 0x7F..) + 0x7F..) | xorWord`, whose byte lane has bit 7
    /// clear precisely when the lane equals the target. AND-ing the four
    /// reduced words leaves bit 7 set only when no target matched, so the
    /// final complement isolates the `0x80` lane flags. Keeping the operation
    /// exact (rather than the shorter subtract-based `haszero`) matters: this
    /// mask locates field boundaries, and a false lane would truncate a field.
    /// The randomized differential in `abi_string_test` compares the produced
    /// fields against an independent per-byte scanner and covers it.
    fn emitInlineWsMaskWord(d: int, arg: int) {
        this.loadTmp(1, 64, arg)
        // r11 = input word, r10 = the per-lane low-bit mask.
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0xD9)
        this.cb.u8(0x49)
        this.cb.u8(0xBA)
        this.cb.u64le(0x7F7F7F7F7F7F7F7F)
        // First target (space) seeds the accumulator; the rest fold into it.
        this.emitWsMaskTarget(0x2020202020202020, 0)
        this.emitWsMaskTarget(0x0909090909090909, 1)
        this.emitWsMaskTarget(0x0A0A0A0A0A0A0A0A, 1)
        this.emitWsMaskTarget(0x0D0D0D0D0D0D0D0D, 1)
        // rax = ~accumulator & 0x80-per-lane.
        this.cb.u8(0x48)
        this.cb.u8(0xF7)
        this.cb.u8(0xD0)
        this.cb.u8(0x49)
        this.cb.u8(0xB8)
        this.cb.u64le(0x0101010101010101 * 128)
        this.cb.u8(0x4C)
        this.cb.u8(0x21)
        this.cb.u8(0xC0)
        this.clobberRcx()
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// One whitespace target inside `emitInlineWsMaskWord`. `fold == 0` seeds
    /// rax with the reduced word; `fold == 1` ANDs it into rax. Registers:
    /// r11 holds the input word, r10 the `0x7F` lane mask, rax the accumulator,
    /// rdx the reduced word, r8 the target constant, r9 a copy of it.
    fn emitWsMaskTarget(target: int, fold: int) {
        this.cb.u8(0x49)
        this.cb.u8(0x8B)
        this.cb.u8(0xD3)
        this.cb.u8(0x49)
        this.cb.u8(0xB8)
        this.cb.u64le(target)
        this.cb.u8(0x4C)
        this.cb.u8(0x31)
        this.cb.u8(0xC2)
        // r9 = rdx (copy of the reduced word), so the OR below can still see it.
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0xCA)
        this.cb.u8(0x4C)
        this.cb.u8(0x21)
        this.cb.u8(0xD2)
        this.cb.u8(0x4C)
        this.cb.u8(0x01)
        this.cb.u8(0xD2)
        this.cb.u8(0x4C)
        this.cb.u8(0x09)
        this.cb.u8(0xCA)
        if (fold == 0) {
            this.cb.u8(0x48)
            this.cb.u8(0x8B)
            this.cb.u8(0xC2)
        } else {
            this.cb.u8(0x48)
            this.cb.u8(0x21)
            this.cb.u8(0xD0)
        }
    }

    /// `pickle_map_get`'s bloom-filter rejection, inlined. The query loop asks
    /// `docs[i].get(term)` with a 256-term vocabulary against 48-term
    /// documents, so most lookups are absent and the map's two-bit bloom
    /// filter answers them without probing. Reaching that answer through the
    /// extern costs a call and the entry prologue; the filter is conservative
    /// (bits are only ever set, never cleared, and removal keeps them), so a
    /// clear filter is a sound "absent". Every other shape - a key whose hash
    /// is not cached yet, a non-string key, a bloom hit - falls back to the
    /// real entry point with the argument registers untouched.
    fn emitInlineMapGet(d: int, mapT: int, keyT: int) {
        this.loadTmp(1, 64, mapT)
        this.loadTmp(2, 64, keyT)
        let slow = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let miss = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // 0/1/2 are the map's empty/tombstone/none sentinels, not pointers.
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0xFA)
        this.cb.u8(0x02)
        this.emitJcc(0x06, slow)
        // Word 1 is the class id; only string keys may be answered here.
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0x7A)
        this.cb.u8(0x08)
        this.cb.u8(0x00)
        this.emitJcc(0x05, slow)
        // Word 2 carries the flags; without FLAG_HASH the filter index is
        // unknown, so let the runtime hash and cache it.
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x42)
        this.cb.u8(0x10)
        this.cb.u8(0x48)
        this.cb.u8(0xA8)
        this.cb.u8(0x02)
        this.emitJcc(0x04, slow)
        // rax = cached FNV hash; r8 = entry table (word 6, byte 48).
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x02)
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(0x30)
        this.cb.u8(0x4D)
        this.cb.u8(0x85)
        this.cb.u8(0xC0)
        this.emitJcc(0x04, slow)
        // First filter bit: word (h >> 6) & 3, bit h & 63.
        this.cb.u8(0x49)
        this.cb.u8(0x89)
        this.cb.u8(0xC3)
        this.cb.u8(0x49)
        this.cb.u8(0xC1)
        this.cb.u8(0xEB)
        this.cb.u8(0x06)
        this.cb.u8(0x49)
        this.cb.u8(0x83)
        this.cb.u8(0xE3)
        this.cb.u8(0x03)
        this.cb.u8(0x4F)
        this.cb.u8(0x8B)
        this.cb.u8(0x4C)
        this.cb.u8(0xD8)
        this.cb.u8(0xE0)
        this.cb.u8(0x49)
        this.cb.u8(0x89)
        this.cb.u8(0xC3)
        this.cb.u8(0x4D)
        this.cb.u8(0x0F)
        this.cb.u8(0xA3)
        this.cb.u8(0xD9)
        this.emitJcc(0x03, miss)
        // Second filter bit: word (h >> 14) & 3, bit (h >> 8) & 63.
        this.cb.u8(0x49)
        this.cb.u8(0x89)
        this.cb.u8(0xC3)
        this.cb.u8(0x49)
        this.cb.u8(0xC1)
        this.cb.u8(0xEB)
        this.cb.u8(0x0E)
        this.cb.u8(0x49)
        this.cb.u8(0x83)
        this.cb.u8(0xE3)
        this.cb.u8(0x03)
        this.cb.u8(0x4F)
        this.cb.u8(0x8B)
        this.cb.u8(0x4C)
        this.cb.u8(0xD8)
        this.cb.u8(0xE0)
        this.cb.u8(0x49)
        this.cb.u8(0x89)
        this.cb.u8(0xC3)
        this.cb.u8(0x49)
        this.cb.u8(0xC1)
        this.cb.u8(0xEB)
        this.cb.u8(0x08)
        this.cb.u8(0x4D)
        this.cb.u8(0x0F)
        this.cb.u8(0xA3)
        this.cb.u8(0xD9)
        this.emitJcc(0x03, miss)
        this.emitJmp(slow)
        this.starts[miss] = this.cb.size()
        this.cb.u8(0x31)
        this.cb.u8(0xC0)
        this.emitJmp(done)
        this.starts[slow] = this.cb.size()
        this.cb.movabsReloc(10, "pickle_map_get")
        this.cb.u8(0x41)
        this.cb.u8(0xFF)
        this.cb.u8(0xD2)
        this.starts[done] = this.cb.size()
        this.clobberRcx()
        this.putRes(d, 64, this.kOfTemp(d))
    }

    fn emitCall(sum: string, ptys: List<IrTy>, ret: IrTy, d: int?, args: List<int>, direct: bool) {
        // A call with more arguments than the callee has parameters is an
        // emitter bug: the argument loop below indexes `ptys` by argument
        // position. Report it instead of reading past the list.
        if (len(args) > len(ptys)) {
            this.fail("call to `" + sum + "` has " + str(len(args)) + " argument(s), but the callee takes " + str(len(ptys)))
            return
        }
        // Backend-only inlining of the hottest leaf helpers. Each is a single
        // bounds-tested load, so the call frame cost more than the body. The
        // emitted IR is unchanged; only the x64 spelling differs.
        if (sum == "pkl_abiManagedAlloc" && len(args) == 1) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineManagedAlloc(dd, args[0])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pkl_abiEngineRegister" && len(args) == 1 && ret == IrTy.Unit) {
            this.emitInlineEngineRegister(d, args[0])
            return
        }
        if (sum == "pickle_box_i64" && len(args) == 1) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineBoxI64(dd, args[0])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pickle_str_append_two" && len(args) == 3) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineAppendTwo(dd, args[0], args[1], args[2])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pkl_shortInternWord" && len(args) == 2) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineShortInternWord(dd, args[0], args[1])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pkl_wsMaskWord" && len(args) == 1) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineWsMaskWord(dd, args[0])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pickle_map_get" && len(args) == 2) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineMapGet(dd, args[0], args[1])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pickle_str_from_i64" && len(args) == 1) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineStrFromI64(dd, args[0])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pickle_list_get" && len(args) == 2) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineListGet(dd, args[0], args[1])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pickle_list_set" && len(args) == 3) {
            this.emitInlineListSet(args[0], args[1], args[2])
            return
        }
        if (sum == "pickle_list_push" && len(args) == 2 && ret == IrTy.Unit) {
            match (d) {
                case none -> {
                    this.emitInlineListPush(args[0], args[1])
                    return
                }
                case some(_) -> {}
            }
        }
        if ((sum == "pickle_list_len" || sum == "pickle_str_len" || sum == "pickle_map_len") && len(args) == 1) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineObjLen(dd, args[0])
                    return
                }
                case none -> {}
            }
        }
        if ((sum == "pickle_unbox_i64" || sum == "pickle_unbox_char") && len(args) == 1) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineUnbox(dd, args[0])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pickle_unbox_bool" && len(args) == 1) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineUnboxBool(dd, args[0])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pickle_box_bool" && len(args) == 1) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineBoxBool(dd, args[0])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pickle_unbox_f64" && len(args) == 1) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineUnboxF64(dd, args[0])
                    return
                }
                case none -> {}
            }
        }
        // Class field access always passes a statically-known slot. Inline the
        // two slot helpers rather than paying a call that is pure loads and a
        // compare; anything unusual (a wide or negative index, a result taken
        // from a void store) keeps the real entry point.
        if (sum == "pickle_obj_slot_get" && len(args) == 2) {
            match (d) {
                case some(dd) -> {
                    if (this.plan.constVals.has(args[1])) {
                        let s = this.plan.constVals[args[1]]
                        if (s >= 0 && s <= 268435452) {
                            this.emitInlineObjSlotGet(dd, args[0], s)
                            return
                        }
                    }
                }
                case none -> {}
            }
        }
        if (sum == "pickle_obj_slot_set" && len(args) == 3) {
            match (d) {
                case none -> {
                    if (this.plan.constVals.has(args[1])) {
                        let s = this.plan.constVals[args[1]]
                        if (s >= 0 && s <= 268435452) {
                            this.emitInlineObjSlotSet(args[0], s, args[2])
                            return
                        }
                    }
                }
                case some(_) -> {}
            }
        }
        // Enum tag/field access: the tag is one load, and both field helpers
        // are a size-derived bound plus one load/store. Matching on an enum
        // emits a tag call followed by a field call for the arm it binds.
        if (sum == "pickle_enum_tag" && len(args) == 1) {
            match (d) {
                case some(dd) -> {
                    this.emitInlineEnumTag(dd, args[0])
                    return
                }
                case none -> {}
            }
        }
        if (sum == "pickle_enum_field" && len(args) == 2) {
            match (d) {
                case some(dd) -> {
                    if (this.plan.constVals.has(args[1])) {
                        let s = this.plan.constVals[args[1]]
                        if (s >= 0 && s <= 268435449) {
                            this.emitInlineEnumField(dd, args[0], s)
                            return
                        }
                    }
                }
                case none -> {}
            }
        }
        if (sum == "pickle_enum_new" && len(args) == 2) {
            match (d) {
                case some(dd) -> {
                    if (this.plan.constVals.has(args[1])) {
                        let c = this.plan.constVals[args[1]]
                        if (c >= 0 && c <= 8) {
                            this.emitInlineEnumNew(dd, args[0], args[1])
                            return
                        }
                    }
                }
                case none -> {}
            }
        }
        if (sum == "pickle_enum_set_field" && len(args) == 3) {
            match (d) {
                case none -> {
                    if (this.plan.constVals.has(args[1])) {
                        let s = this.plan.constVals[args[1]]
                        if (s >= 0 && s <= 268435449) {
                            this.emitInlineEnumSetField(args[0], s, args[2])
                            return
                        }
                    }
                }
                case some(_) -> {}
            }
        }
        let n = len(args)
        var i = 0
        while (i < n && i < 4) {
            let t = ptys[i]
            if (isFloatTy(t)) {
                this.loadTmpFloat(i, args[i])
            } else {
                this.loadTmp(intArgReg(i), tyWidth(t), args[i])
            }
            i = i + 1
        }
        var ns = n - 4
        if (ns < 0) {
            ns = 0
        }
        var R = 0
        if (ns > 0) {
            R = CALL_SHADOW_BYTES + 8 * ns + 8 * (ns % 2)
            this.cb.subRsp(R)
            i = 4
            while (i < n) {
                let j = i - 4
                let t = ptys[i]
                let disp = CALL_SHADOW_BYTES + 8 * j
                if (isFloatTy(t)) {
                    this.loadTmpFloat(4, args[i])
                    this.cb.stsdRsp(4, disp)
                } else {
                    this.loadTmp(0, tyWidth(t), args[i])
                    this.cb.stRsp(0, tyWidth(t), disp)
                }
                i = i + 1
            }
        }
        // The call may clobber every volatile XMM register, so the copy cache
        // cannot survive it. The homes are current either way.
        this.dropFx()
        // Calls to functions in this IR module resolve into the merged program
        // `.text` section, so `E8 rel32` is position independent and removes
        // the 10-byte address materialisation plus an indirect branch. Externs
        // must remain indirect: imports resolve to IAT slots and archive
        // selection/linking may bind them outside this object.
        if (direct) {
            this.cb.callRel32(sum)
        } else {
            this.cb.movabsReloc(10, sum)
            if (isImpSlotCall(sum)) {
                // The reloc above resolved to the IAT slot, which stores the entry
                // point rather than being one: `mov r10, [r10]` turns the slot
                // address into the address of the imported function. CRT imports
                // skip this because their reloc already names a jump thunk.
                this.cb.u8(0x4D)
                this.cb.u8(0x8B)
                this.cb.u8(0x12)
            }
            this.cb.u8(0x41)
            this.cb.u8(0xFF)
            this.cb.u8(0xD2)
        }
        if (ns > 0) {
            this.cb.addRsp(R)
        }
        this.clobberRcx()
        match (d) {
            case some(dd) -> {
                if (isFloatTy(ret)) {
                    this.cb.stsd(0, this.kOfTemp(dd))
                    this.setFx(0, dd)
                } else {
                    this.putRes(dd, tyWidth(ret), this.kOfTemp(dd))
                }
            }
            case none -> {}
        }
    }

    fn lowerInstr(ins: IrInstr) {
        if (this.failed) {
            return
        }
        // A deferred result is only in rax. When this instruction cannot take it
        // from there as its first move, materialise the home now - before the
        // instruction has a chance to clobber rax.
        if (!this.pendingConsumedBy(ins)) {
            this.flushPend()
        }
        if (!this.floatConsumedBy(ins)) {
            this.dropFx()
        }
        match (ins) {
            case IrInstr.Const(d, cst) -> this.emitConst(d, cst)
            case IrInstr.UnOp(d, op, v) -> this.emitUnOp(d, op, v)
            case IrInstr.BinOp(d, op, a, b) -> this.emitBinOp(d, op, a, b)
            case IrInstr.Copy(d, v) -> {
                let w = tyWidth(this.typeOfT(v))
                this.loadTmp(0, w, v)
                this.putRes(d, w, this.kOfTemp(d))
            }
            case IrInstr.Itof(d, v) -> {
                // Convert into whichever scratch register is free. In the
                // `term * x / (i as float)` chain xmm0 still holds the pending
                // numerator, so the divisor lands in xmm1 and `divsd` reads
                // both operands without a store/reload.
                let kd = this.kOfTemp(d)
                this.loadTmp(0, 64, v)
                if (this.fx0 >= 0) {
                    this.dropFxReg(1)
                    this.cb.u8(0xF2)
                    this.cb.u8(0x48)
                    this.cb.u8(0x0F)
                    this.cb.u8(0x2A)
                    this.cb.u8(0xC8)
                    this.cb.stsd(1, kd)
                    this.setFx(1, d)
                } else {
                    this.dropFxReg(0)
                    this.cb.u8(0xF2)
                    this.cb.u8(0x48)
                    this.cb.u8(0x0F)
                    this.cb.u8(0x2A)
                    this.cb.u8(0xC0)
                    this.cb.stsd(0, kd)
                    this.setFx(0, d)
                }
            }
            case IrInstr.Ftoi(d, v) -> this.emitFtoi(d, v)
            case IrInstr.Chartoi(d, v) -> {
                this.loadTmp(0, 32, v)
                this.putRes(d, 64, this.kOfTemp(d))
            }
            case IrInstr.Itochar(d, v) -> {
                this.loadTmp(0, 64, v)
                this.cb.u8(0x89)
                this.cb.u8(0xC0)
                this.putRes(d, 32, this.kOfTemp(d))
            }
            case IrInstr.LoadSlot(d, s) -> this.emitMem(IrInstr.LoadSlot(d, s))
            case IrInstr.StoreSlot(s, v) -> this.emitMem(IrInstr.StoreSlot(s, v))
            case IrInstr.LocalAddr(d, s) -> this.emitMem(IrInstr.LocalAddr(d, s))
            case IrInstr.LoadRaw(d, addr, ty) -> this.emitMem(IrInstr.LoadRaw(d, addr, ty))
            case IrInstr.StoreRaw(addr, v, ty) -> this.emitMem(IrInstr.StoreRaw(addr, v, ty))
            case IrInstr.GlobalAddr(d, id) -> {
                this.cb.movabsReloc(0, this.globalSym(id))
                this.putRes(d, 64, this.kOfTemp(d))
            }
            case IrInstr.LoadGlobal(d, id, ty) -> {
                if (!this.globalTyOk(ty)) {
                    this.fail("loadglobal of `" + irTyStr(ty) + "` is not lowered yet")
                    return
                }
                this.cb.movabsReloc(0, this.globalSym(id))
                this.cb.ldMemR0(0, tyWidth(ty))
                this.putRes(d, tyWidth(ty), this.kOfTemp(d))
            }
            case IrInstr.StoreGlobal(id, v, ty) -> {
                if (!this.globalTyOk(ty)) {
                    this.fail("storeglobal of `" + irTyStr(ty) + "` is not lowered yet")
                    return
                }
                this.loadTmp(1, tyWidth(ty), v)
                this.cb.movabsReloc(0, this.globalSym(id))
                this.cb.stMemR0(1, tyWidth(ty))
            }
            case IrInstr.Call(d, callee, args) -> {
                var sym = ""
                var ptys = List<IrTy>()
                match (callee) {
                    case Callee.Func(id) -> {
                        let f = this.m.funcs[id]
                        sym = funcSymbolOf(this.m, id)
                        ptys = List<IrTy>()
                        for (p in f.params) {
                            ptys.push(p.ty)
                        }
                        this.emitCall(sym, ptys, f.ret, d, args, true)
                    }
                    case Callee.Extern(id) -> {
                        let e = this.m.externs[id]
                        sym = e.symbol
                        ptys = e.params
                        var skip = false
                        // Backend-only swap: the IR and its declaration stay
                        // `pickle_str_concat`; only the emitted symbol changes.
                        // A proven two-link chain emits one fused call at the
                        // second link and skips the first, because no code can
                        // observe the intermediate buffer (see
                        // `analyzeAppendOwned`).
                        if (sym == "pickle_str_concat" && len(args) == 2) {
                            match (d) {
                                case some(dd) -> {
                                    if (this.appendFuse.has(dd)) {
                                        skip = true
                                    } else if (this.appendFuse.has(args[0])) {
                                        let parts = this.appendFuse[args[0]]
                                        let fargs: List<int> = [parts[0], parts[1], args[1]]
                                        let ftys: List<IrTy> = [ptys[0], ptys[1], ptys[1]]
                                        this.emitCall("pickle_str_append_two", ftys, e.ret, d, fargs, false)
                                        skip = true
                                    } else if (this.appendOwned.has(dd) && this.appendOwned[dd]) {
                                        sym = "pickle_str_append_owned"
                                    }
                                }
                                case none -> {}
                            }
                        } else {
                            match (d) {
                                case some(dd) -> {
                                    if (this.appendOwned.has(dd) && this.appendOwned[dd]) {
                                        sym = "pickle_str_append_owned"
                                    }
                                }
                                case none -> {}
                            }
                        }
                        if (!skip) {
                            this.emitCall(sym, ptys, e.ret, d, args, isDirectRuntimeCall(sym))
                        }
                    }
                }
            }
            case IrInstr.CallInd(d, fnAddr, params, ret, args) -> {
                let ptys = params
                if (len(args) > len(ptys)) {
                    this.fail("indirect call has " + str(len(args)) + " argument(s), but the signature takes " + str(len(ptys)))
                    return
                }
                let n = len(args)
                var i = 0
                while (i < n && i < 4) {
                    let t = ptys[i]
                    if (isFloatTy(t)) {
                        this.loadTmpFloat(i, args[i])
                    } else {
                        this.loadTmp(intArgReg(i), tyWidth(t), args[i])
                    }
                    i = i + 1
                }
                var ns = n - 4
                if (ns < 0) {
                    ns = 0
                }
                var R = 0
                if (ns > 0) {
                    R = CALL_SHADOW_BYTES + 8 * ns + 8 * (ns % 2)
                    this.cb.subRsp(R)
                    i = 4
                    while (i < n) {
                        let j = i - 4
                        let t = ptys[i]
                        let disp = CALL_SHADOW_BYTES + 8 * j
                        if (isFloatTy(t)) {
                            this.loadTmpFloat(4, args[i])
                            this.cb.stsdRsp(4, disp)
                        } else {
                            this.loadTmp(0, tyWidth(t), args[i])
                            this.cb.stRsp(0, tyWidth(t), disp)
                        }
                        i = i + 1
                    }
                }
                this.loadTmp(10, 64, fnAddr)
                this.dropFx()
                this.cb.u8(0x41)
                this.cb.u8(0xFF)
                this.cb.u8(0xD2)
                if (ns > 0) {
                    this.cb.addRsp(R)
                }
                this.clobberRcx()
                match (d) {
                    case some(dd) -> {
                        if (isFloatTy(ret)) {
                            this.cb.stsd(0, this.kOfTemp(dd))
                            this.setFx(0, dd)
                        } else {
                            this.putRes(dd, tyWidth(ret), this.kOfTemp(dd))
                        }
                    }
                    case none -> {}
                }
            }
        }
        this.noteRax(ins)
    }

    fn emitJmp(target: int) {
        this.cb.u8(0xE9)
        let field = this.cb.size()
        this.cb.u32le(0)
        this.fixes.push(BranchFix(field, target))
    }

    fn emitJcc(cc: int, target: int) {
        this.cb.u8(0x0F)
        this.cb.u8(0x80 + cc)
        let field = this.cb.size()
        this.cb.u32le(0)
        this.fixes.push(BranchFix(field, target))
    }

    fn lowerTerm(t: IrTerm) {
        if (!this.termConsumes(t)) {
            this.flushPend()
        }
        match (t) {
            case IrTerm.Branch(target) -> this.emitJmp(target)
            case IrTerm.BranchIf(c, tn, el) -> {
                if (this.fuseCc >= 0) {
                    // Fused `cmp` + `jcc`: the comparison's 0/1 result was only
                    // ever consumed by this branch, so materialising it in a
                    // byte register and testing it again is pure overhead.
                    this.loadTmp(0, this.fuseW, this.fuseA)
                    if (this.fuseImm) {
                        if (this.fuseW == 64) {
                            this.cb.u8(0x48)
                        }
                        this.cb.u8(0x3D)
                        this.cb.u32le(this.fuseImmV & 0xFFFFFFFF)
                    } else {
                        this.loadTmp(1, this.fuseW, this.fuseB)
                        if (this.fuseW == 8) {
                            this.cb.u8(0x38)
                            this.cb.u8(0xC8)
                        } else if (this.fuseW == 32) {
                            this.cb.u8(0x39)
                            this.cb.u8(0xC8)
                        } else {
                            this.cb.u8(0x48)
                            this.cb.u8(0x39)
                            this.cb.u8(0xC8)
                        }
                    }
                    this.emitJcc(this.fuseCc, tn)
                    this.emitJmp(el)
                } else {
                    this.loadTmp(0, 8, c)
                    this.cb.u8(0x84)
                    this.cb.u8(0xC0)
                    this.emitJcc(0x05, tn)
                    this.emitJmp(el)
                }
            }
            case IrTerm.Return(v) -> {
                // `emitEscapedCheck`/`popShadow` are calls: whatever the last
                // instruction left in rax/rcx is gone, so drop the forwarding
                // caches before the return value is loaded. A call clobbers
                // both, and a stale rcx hit here would load a garbage return.
                this.raxT = 0 - 1
                this.raxW = 0
                this.clobberRcx()
                if (this.fun.symbol == ENTRY_SYMBOL || this.plan.shadowed) {
                    // These two helpers can emit a runtime call, which
                    // destroys xmm0/xmm1 along with the GPR caches above.
                    this.dropFx()
                }
                this.emitEscapedCheck()
                if (this.plan.shadowed) {
                    this.popShadow()
                }
                match (v) {
                    case some(ti) -> {
                        if (!(this.fun.ret == IrTy.Unit)) {
                            if (isFloatTy(this.fun.ret)) {
                                this.loadTmpFloat(0, ti)
                            } else {
                                this.loadTmp(0, tyWidth(this.fun.ret), ti)
                            }
                        }
                    }
                    case none -> {}
                }
                var p = 0
                while (p < len(this.plan.pinRegs)) {
                    this.cb.ld(this.plan.pinRegs[p], 64, this.plan.pinK[p])
                    p = p + 1
                }
                this.cb.u8(0x48)
                this.cb.u8(0x89)
                this.cb.u8(0xEC)
                this.cb.u8(0x5D)
                this.cb.u8(0xC3)
            }
            case IrTerm.Unreachable -> {
                this.cb.u8(0x0F)
                this.cb.u8(0x0B)
            }
        }
    }

    fn patchFixes() {
        for (fx in this.fixes) {
            match (this.starts.get(fx.target)) {
                case some(ln) -> {
                    let p = ln - (fx.off + 4)
                    this.cb.bytes[fx.off] = p & 0xFF
                    this.cb.bytes[fx.off + 1] = (p >> 8) & 0xFF
                    this.cb.bytes[fx.off + 2] = (p >> 16) & 0xFF
                    this.cb.bytes[fx.off + 3] = (p >> 24) & 0xFF
                }
                case none -> this.fail("unknown branch target " + str(fx.target))
            }
        }
    }

    fn emitFunc() -> X64Func? {
        this.prologue()
        this.seedParams()
        this.pushShadow()
        for (blk in this.fun.blocks) {
            this.starts[blk.id] = this.cb.size()
            // Control flow joins here from arbitrary predecessors, so nothing
            // is known about rax.
            this.raxT = 0 - 1
            this.raxW = 0
            this.rcxT = 0 - 1
            this.rcxW = 0
            this.pendT = 0 - 1
            this.fuseCc = 0 - 1
            // A loop header carries the per-iteration safepoint. It sits after
            // `starts[id]` so a back-edge lands on the poll, and before any
            // instruction so no live value is clobbered.
            if (this.isLoopHeader(blk.id)) {
                this.emitGcPoll()
            }
            let n = len(blk.instrs)
            if (n > 0 && this.planFuse(blk.instrs[n - 1], blk.term)) {
                // The trailing comparison feeds only this `BranchIf`; its
                // `cmp` is emitted by `lowerTerm` right before the branch.
                var fi = 0
                while (fi < n - 1) {
                    this.lowerInstr(blk.instrs[fi])
                    fi = fi + 1
                }
            } else {
                for (ins in blk.instrs) {
                    this.lowerInstr(ins)
                }
            }
            this.flushLiveOutAliases(blk.id)
            this.lowerTerm(blk.term)
            this.clearAliases()
        }
        if (this.failed) {
            return none
        }
        this.patchFixes()
        if (this.failed) {
            return none
        }
        X64Func(this.fun.symbol, this.cb.bytes, this.cb.relocs, this.plan.ncells, this.plan.totalK)
    }

    /// Decide whether `last` is a comparison used only by the `BranchIf` term.
    /// The operands are normalised here exactly like `emitBinOp` does, so the
    /// fused emission can share its immediate/register logic.
    fn planFuse(last: IrInstr, term: IrTerm) -> bool {
        match (term) {
            case IrTerm.BranchIf(c, tn, el) -> {
                match (last) {
                    case IrInstr.BinOp(d, op, a, b) -> {
                        if (d != c || !isCmp(op) || isFloatTy(this.typeOfT(a))
                            || tempUseCount(this.plan.tempUses, c) != 1) {
                            return false
                            }
                        let w = tyWidth(this.typeOfT(a))
                        var aa = a
                        var bb = b
                        if (!this.plan.constVals.has(bb) && this.plan.constVals.has(aa)
                            && binOpCommutes(op)) {
                            aa = b
                            bb = a
                            }
                        this.fuseCc = this.intCmpCc(op)
                        this.fuseA = aa
                        this.fuseB = bb
                        this.fuseW = w
                        this.fuseImm = this.constFits32(bb) && (w == 32 || w == 64)
                        this.fuseImmV = 0
                        if (this.fuseImm) {
                            this.fuseImmV = this.plan.constVals[bb]
                        }
                        true
                    }
                    case _ -> false
                }
            }
            case _ -> false
        }
    }
}

fn x64LowerModule(m: IrModule, diags: DiagnosticSink) -> X64Out? {
    // Constant folding, load CSE, copy propagation and DCE first: the emitter
    // lowers every instruction literally, so removing the redundant ones here
    // is what keeps the generated code compact.
    let om = optimizeModule(m)
    var funcs = List<X64Func>()
    let mayGC = computeMayGC(om)
    var i = 0
    while (i < len(om.funcs)) {
        let e = X64Emitter(om, om.funcs[i], diags, mayGC)
        let f = e.emitFunc()
        var failed = false
        match (f) {
            case some(xf) -> funcs.push(xf)
            case none -> failed = true
        }
        if (failed) {
            return none
        }
        i = i + 1
    }
    X64Out(funcs)
}

class HexBuf {
    var acc: string

    constructor() {
        this.acc = ""
    }

    fn put(s: string) {
        this.acc = this.acc + s
    }

    fn text() -> string {
        this.acc
    }
}

fn hex2(b: int) -> string {
    var h = "0123456789abcdef"
    let hb = bytes(h)
    let hi = (b >> 4) & 0xF
    let lo = b & 0xF
    "{hb[hi] as char}" + "{hb[lo] as char}"
}

fn x64Dump(out: X64Out) -> string {
    let w = HexBuf()
    for (f in out.funcs) {
        w.put("func " + f.symbol + " ncells=" + str(f.ncells) + " frame=" + str(f.totalK) + "\n")
        var i = 0
        while (i < len(f.bytes)) {
            let o = str(i)
            var pad = o
            while (len(pad) < 4) {
                pad = "0" + pad
            }
            w.put(pad + ": ")
            var j = 0
            while (j < 8 && i + j < len(f.bytes)) {
                w.put(hex2(f.bytes[i + j]) + " ")
                j = j + 1
            }
            w.put("\n")
            i = i + 8
        }
        for (r in f.relocs) {
            w.put("reloc " + str(r.off) + " " + r.sym + "\n")
        }
    }
    w.text()
}