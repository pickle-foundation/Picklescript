module compiler.x64

import { Diagnostic, DiagnosticSink, Span } from compiler.diag
import { Callee, IrBlock, IrFunc, IrModule, IrTy, IrConst, IrUnOp, IrBinOp, IrInstr, IrTerm, irTyStr } from compiler.ir
import { optimizeModule } from compiler.irop
import { sliceRange } from std.text.format

const SHADOW_HEADER_BYTES: int = 16
const CELL_BYTES: int = 8
const CALL_SHADOW_BYTES: int = 32

/// The tag the emitter stamps into the high byte of a shadow frame's word 1,
/// next to the masked `ncells`: `(SHADOW_FRAME_TAG << 56) | (totalK << 32) |
/// ncells`. The collector reads `totalK` back to conservatively scan the frame's
/// unmanaged local area, which the cell walk alone cannot see. Keep in step with
/// `abi_gcengine.pkl`'s copies.
const SHADOW_FRAME_TAG: int = 90
const SHADOW_TAG_SHIFT: int = 56

/// The linked module's entry point. Every path out of this function is a place a
/// throw can escape the program, so each one is where the backend reports it.
const ENTRY_SYMBOL: string = "pickle_main"

/// ABI: report a throw that escaped the program, and exit 1. A no-op when
/// nothing escaped, so a program that threw nothing only pays a flag read.
const EXC_UNCAUGHT: string = "pickle_exc_uncaught"

fn isManaged(t: IrTy) -> bool {
    match (t) {
        case IrTy.Str -> true
        case IrTy.Ptr -> true
        case IrTy.Int -> false
        case IrTy.Bool -> false
        case IrTy.Char -> false
        case IrTy.Float -> false
        case IrTy.Unit -> false
    }
}

/// The shadow-frame API is the one place the emitter must NOT instrument. Every
/// other function that owns a managed home gets a shadow frame, but a frame is
/// built by CALLING `pickle_shadow_push`, so an instrumented `pickle_shadow_push`
/// would re-enter itself until the stack died - the exact failure `abi_shadow`'s
/// module doc records. `abiShadowHead` is the reader side of the same protocol:
/// instrumented, its own prologue would push a frame and it would hand the
/// collector THAT frame instead of the caller's chain head.
fn isShadowApiFn(name: string, symbol: string) -> bool {
    if (symbol == "pickle_shadow_push") {
        return true
    }
    if (symbol == "pickle_shadow_pop") {
        return true
    }
    if (name == "abiShadowHead") {
        return true
    }
    false
}

fn isFloatTy(t: IrTy) -> bool {
    match (t) {
        case IrTy.Float -> true
        case _ -> false
    }
}

fn tyWidth(t: IrTy) -> int {
    match (t) {
        case IrTy.Bool -> 8
        case IrTy.Char -> 32
        case IrTy.Int -> 64
        case IrTy.Float -> 64
        case IrTy.Str -> 64
        case IrTy.Unit -> 64
        case IrTy.Ptr -> 64
    }
}

fn tyBytes(t: IrTy) -> int {
    tyWidth(t) / 8
}

fn isCmp(op: IrBinOp) -> bool {
    match (op) {
        case IrBinOp.Eq -> true
        case IrBinOp.Ne -> true
        case IrBinOp.Lt -> true
        case IrBinOp.Le -> true
        case IrBinOp.Gt -> true
        case IrBinOp.Ge -> true
        case _ -> false
    }
}

/// Commutative integer operators: safe to swap operands so a constant lands on
/// the right-hand side and folds into the immediate field.
fn binOpCommutes(op: IrBinOp) -> bool {
    match (op) {
        case IrBinOp.Add -> true
        case IrBinOp.Mul -> true
        case IrBinOp.BitAnd -> true
        case IrBinOp.BitOr -> true
        case IrBinOp.BitXor -> true
        case IrBinOp.Eq -> true
        case IrBinOp.Ne -> true
        case _ -> false
    }
}

/// Signed strength reduction for `x / c` and `x % c` when `c` is a positive
/// non-power-of-two divisor in `(1, 2^31)`. Returns `[M, s]`, or `none`.
///
/// `M = floor(2^(64+s)/c) + 1` with the smallest `s` whose error
/// `e = M*c - 2^(64+s)` satisfies `0 < e < 2^(s+1)`. For `u = |x|` (which is
/// `2^63` at `INT64_MIN`) that strict bound makes `floor(u*M / 2^(64+s))`
/// equal `floor(u/c)`; allowing `e == 2^(s+1)` is off by one at exactly
/// `u == 2^63`. `0 < e` is also required: the `+ 1` overshoots when `c`
/// divides `2^(64+s)`.
///
/// The loop is long division over the single set bit of `2^(64+s)`: `r` stays
/// below `c <= 2^31`, so `r*2` cannot overflow, and quotient bits at or above
/// 64 are rejected instead of silently wrapping. The emitted quotient is
/// `mulhi(u, M) >> s`; `M*c` wraps mod 2^64 to `e` because `s <= 30`.
fn magicDivConst(c: int) -> List<int>? {
    var s = 0
    while (s <= 30) {
        var q = 0
        var r = 0
        var wide = false
        var i = 64 + s
        while (i >= 0) {
            r = r * 2
            if (i == 64 + s) {
                r = r + 1
            }
            if (r >= c) {
                r = r - c
                if (i >= 64) {
                    wide = true
                } else {
                    q = q | (1 << i)
                }
            }
            i = i - 1
        }
        if (!wide) {
            let m = q + 1
            let e = m * c
            if (e > 0 && e < (1 << (s + 1))) {
                return [m, s]
            }
        }
        s = s + 1
    }
    none
}

/// Opcode of the `rAX, imm32` form of an integer ALU op:
/// `add 05`, `sub 2D`, `and 25`, `or 0D`, `xor 35`.
fn immGroupOpcode(op: IrBinOp) -> int {
    match (op) {
        case IrBinOp.Add -> 0x05
        case IrBinOp.Sub -> 0x2D
        case IrBinOp.BitAnd -> 0x25
        case IrBinOp.BitOr -> 0x0D
        case IrBinOp.BitXor -> 0x35
        case _ -> 0x05
    }
}

fn alignK(k: int, a: int) -> int {
    let r = k % a
    if (r != 0) {
        k + a - r
    } else {
        k
    }
}

fn intArgReg(i: int) -> int {
    match (i) {
        case 0 -> 1
        case 1 -> 2
        case 2 -> 8
        case 3 -> 9
        case _ -> 0
    }
}

fn funcSymbolOf(m: IrModule, id: int) -> string {
    let f = m.funcs[id]
    if (f.symbol != "") {
        f.symbol
    } else {
        f.name
    }
}

fn constTy(c: IrConst) -> IrTy {
    match (c) {
        case IrConst.Int(_) -> IrTy.Int
        case IrConst.Float(_) -> IrTy.Float
        case IrConst.Bool(_) -> IrTy.Bool
        case IrConst.Char(_) -> IrTy.Char
        case IrConst.Null -> IrTy.Ptr
        case IrConst.Str(_) -> IrTy.Str
        case IrConst.StrAddr(_) -> IrTy.Int
        case IrConst.FuncAddr(_) -> IrTy.Int
    }
}

fn callRet(m: IrModule, callee: Callee) -> IrTy {
    match (callee) {
        case Callee.Func(id) -> m.funcs[id].ret
        case Callee.Extern(id) -> m.externs[id].ret
    }
}

/// The PE link stage hands these imports a `jmp [rip+...]` thunk (see
/// `pelink::isCrtImp`), so a reloc naming `__imp_<name>` already resolves to a
/// callable address. Every other import resolves to the IAT *slot*, which holds
/// a pointer and is not code.
///
/// Deliberately mirrors `pelink::isCrtImp`/`linklib::isCrtImp`; the lists must
/// agree or an extern call will jump into data.
fn isCrtThunkImp(nm: string) -> bool {
    if (nm == "memcpy") {
        return true
    }
    if (nm == "memmove") {
        return true
    }
    if (nm == "memset") {
        return true
    }
    if (nm == "memcmp") {
        return true
    }
    false
}

/// True when an extern callee's symbol resolves to an IAT slot rather than to
/// code, so `emitCall` has to dereference it before jumping.
fn isImpSlotCall(sym: string) -> bool {
    if (len(sym) < 6 || sliceRange(sym, 0, 6) != "__imp_") {
        return false
    }
    return !isCrtThunkImp(sliceRange(sym, 6, len(sym)))
}

/// Runtime ABI symbols are resolved from the static runtime archive and merged
/// into the final executable's `.text`, so an extern call to one has the same
/// REL32 contract as a call to a function in the current IR module. Imports,
/// CRT calls, and indirect function-pointer calls do not qualify: they either
/// resolve through the IAT/thunk machinery or have no link-time target.
fn isDirectRuntimeCall(sym: string) -> bool {
    if (len(sym) >= 7 && sliceRange(sym, 0, 7) == "pickle_") {
        return true
    }
    if (len(sym) >= 4 && sliceRange(sym, 0, 4) == "pkl_") {
        return true
    }
    false
}

class Reloc {
    var off: int
    var sym: string
    /// COFF relocation kind: ADDR64 (1) for absolute addresses, REL32 (4)
    /// for direct internal calls.
    var type: int

    constructor(off: int, sym: string, type: int) {
        this.off = off
        this.sym = sym
        this.type = type
    }
}

class BranchFix {
    var off: int
    var target: int

    constructor(off: int, target: int) {
        this.off = off
        this.target = target
    }
}

class X64Func {
    var symbol: string
    var bytes: List<int>
    var relocs: List<Reloc>
    var ncells: int
    var totalK: int

    constructor(symbol: string, bytes: List<int>, relocs: List<Reloc>, ncells: int, totalK: int) {
        this.symbol = symbol
        this.bytes = bytes
        this.relocs = relocs
        this.ncells = ncells
        this.totalK = totalK
    }
}

class X64Out {
    var funcs: List<X64Func>

    constructor(funcs: List<X64Func>) {
        this.funcs = funcs
    }
}

class CB {
    var bytes: List<int>
    var relocs: List<Reloc>

    constructor() {
        this.bytes = [0]
        this.bytes.pop()
        this.relocs = List<Reloc>()
    }

    fn size() -> int {
        len(this.bytes)
    }

    fn u8(b: int) {
        this.bytes.push(b & 0xFF)
    }

    fn u32le(v: int) {
        this.u8(v)
        this.u8(v >> 8)
        this.u8(v >> 16)
        this.u8(v >> 24)
    }

    fn u64le(v: int) {
        this.u32le(v & 0xFFFFFFFF)
        this.u32le(v >> 32)
    }

    fn relocAbs(sym: string) {
        let off = this.size()
        this.u64le(0)
        this.relocs.push(Reloc(off, sym, 1))
    }

    /// Emit a four-byte IMAGE_REL_AMD64_REL32 relocation. The linker resolves
    /// it as `symbol - (field address + 4)`, exactly the displacement `E8`
    /// needs. This is valid only for symbols emitted in the same image.
    fn callRel32(sym: string) {
        this.u8(0xE8)
        let off = this.size()
        this.u32le(0)
        this.relocs.push(Reloc(off, sym, 4))
    }

    /// Emit a four-byte REL32 field for a RIP-relative memory operand. The
    /// linker resolves it as `symbol + addend - (field address + 4)`. When the
    /// field ends the instruction the addend is 0, exactly what a
    /// `[rip+disp32]` operand needs. A field followed by immediate bytes needs
    /// `-trailing`: the linker measures from the field end, the CPU from the
    /// instruction end. The inline safepoint's `cmp [rip+disp32], imm8` has one
    /// such byte.
    fn rel32Data(sym: string, addend: int) {
        let off = this.size()
        this.u32le(addend)
        this.relocs.push(Reloc(off, sym, 4))
    }

    fn rbpMem(reg: int, k: int) -> List<int> {
        let d: List<int> = []
        if (k <= 128) {
            d.push(0x45 | ((reg & 7) << 3))
            d.push((0 - k) & 0xFF)
        } else {
            d.push(0x85 | ((reg & 7) << 3))
            let neg = (0 - k) & 0xFFFFFFFF
            d.push(neg & 0xFF)
            d.push((neg >> 8) & 0xFF)
            d.push((neg >> 16) & 0xFF)
            d.push((neg >> 24) & 0xFF)
        }
        d
    }

    fn rex(w: int, ext: int) {
        var v = 0x40
        if (w == 64) {
            v = v | 0x08
        }
        if (ext != 0) {
            v = v | 0x01
        }
        this.u8(v)
    }

    fn ld(reg: int, w: int, k: int) {
        var ext = 0
        if (w == 64) {
            ext = ext | 0x08
        }
        if (reg >= 8) {
            ext = ext | 0x04
        }
        if (ext != 0) {
            this.u8(0x40 | ext)
        }
        if (w == 8) {
            this.u8(0x8A)
        } else {
            this.u8(0x8B)
        }
        for (b in this.rbpMem(reg, k)) {
            this.u8(b)
        }
    }

    fn st(reg: int, w: int, k: int) {
        var ext = 0
        if (w == 64) {
            ext = ext | 0x08
        }
        if (reg >= 8) {
            ext = ext | 0x04
        }
        if (ext != 0) {
            this.u8(0x40 | ext)
        }
        if (w == 8) {
            this.u8(0x88)
        } else {
            this.u8(0x89)
        }
        for (b in this.rbpMem(reg, k)) {
            this.u8(b)
        }
    }

    /// `mov <dstReg>, [r0]` - load a `w`-bit word at the address in r0.
    /// Only r0..r7 are addressable here, which is all the callers need. A 64-bit
    /// access needs REX.W; an 8-bit access into r4..r7 needs a bare REX so the
    /// encoding picks SPL/BPL/SIL/DIL rather than AH/CH/DH/BH.
    fn ldMemR0(dstReg: int, w: int) {
        if (w == 64) {
            this.u8(0x48)
        } else if (w == 8 && (dstReg & 7) >= 4) {
            this.u8(0x40)
        }
        this.u8(0x8B)
        this.u8((dstReg & 7) << 3)
    }

    /// `mov [r0], <srcReg>` - store a `w`-bit word from srcReg to the address in r0.
    /// ModRM is `(srcReg << 3) | 0` because r0 is the only base register used.
    fn stMemR0(srcReg: int, w: int) {
        if (w == 64) {
            this.u8(0x48)
        } else if (w == 8 && (srcReg & 7) >= 4) {
            this.u8(0x40)
        }
        this.u8(0x89)
        this.u8((srcReg & 7) << 3)
    }

    fn stImm(reg: int, w: int, k: int, imm: int) {
        if (w == 8) {
            this.u8(0xC6)
            for (b in this.rbpMem(reg, k)) {
                this.u8(b)
            }
            this.u8(imm)
        } else if (w == 32) {
            this.u8(0xC7)
            for (b in this.rbpMem(reg, k)) {
                this.u8(b)
            }
            this.u32le(imm)
        } else {
            this.movabsImm(0, imm)
            this.st(0, 64, k)
        }
    }

    fn ssePre(reg: int) {
        this.u8(0xF2)
        if (reg >= 4) {
            this.u8(0x44)
        }
    }

    fn ldsd(reg: int, k: int) {
        this.ssePre(reg)
        this.u8(0x0F)
        this.u8(0x10)
        for (b in this.rbpMem(reg, k)) {
            this.u8(b)
        }
    }

    fn stsd(reg: int, k: int) {
        this.ssePre(reg)
        this.u8(0x0F)
        this.u8(0x11)
        for (b in this.rbpMem(reg, k)) {
            this.u8(b)
        }
    }

    /// `movq xmm, r11`: load a 64-bit bit pattern from r11 into the low half of
    /// `reg` (66 REX.W(+R/B) 0F 6E /r). r11 is scratch in every lowering, so a
    /// rematerialised constant can reach an SSE operand without touching rax or
    /// any argument register that has already been loaded.
    fn movqXmmR11(reg: int) {
        this.u8(0x66)
        if (reg >= 8) {
            this.u8(0x4D)
        } else {
            this.u8(0x49)
        }
        this.u8(0x0F)
        this.u8(0x6E)
        this.u8(0xC3 | ((reg & 7) << 3))
    }

    /// `movq xmm, rax`: load the 64-bit bit pattern already in rax into the low
    /// half of `reg` (66 REX.W(+R) 0F 6E /r). `loadTmpFloat` uses this when a
    /// float consumer reads a temp whose home write `putRes` deferred.
    fn movqXmmRax(reg: int) {
        this.u8(0x66)
        if (reg >= 8) {
            this.u8(0x4C)
        } else {
            this.u8(0x48)
        }
        this.u8(0x0F)
        this.u8(0x6E)
        this.u8(0xC0 | ((reg & 7) << 3))
    }

    /// `movsd dst, src` between two XMM registers (F2 0F 10 /r with mod=11).
    /// Used to copy a pinned float slot or a tracked temp between scratch
    /// registers without a memory round trip.
    fn movsdRR(dst: int, src: int) {
        this.u8(0xF2)
        this.u8(0x0F)
        this.u8(0x10)
        this.u8(0xC0 | ((dst & 7) << 3) | (src & 7))
    }

    /// `movq r64, xmm`: move the low 64 bits of an XMM register into a GPR
    /// (66 REX.W 0F 7E /r). The exact inverse of `movqXmmR11`, needed when a
    /// pinned float slot's bits are consumed as an integer (Copy, bitcast).
    fn movqXmmToR(reg: int, xr: int) {
        this.u8(0x66)
        var rex = 0x48
        if (reg >= 8) {
            rex = rex | 0x04
        }
        if (xr >= 8) {
            rex = rex | 0x01
        }
        this.u8(rex)
        this.u8(0x0F)
        this.u8(0x7E)
        this.u8(0xC0 | ((reg & 7) << 3) | (xr & 7))
    }

    fn movabsImm(reg: int, imm: int) {
        var ext = 0x08
        if (reg >= 8) {
            ext = ext | 0x01
        }
        this.u8(0x40 | ext)
        this.u8(0xB8 + (reg & 7))
        this.u64le(imm)
    }

    /// `mov dst, src` between two general-purpose registers. Used by slot
    /// pinning, which keeps hot scalar locals in callee-saved registers instead
    /// of re-reading them from their stack home at every use.
    fn movRR(dst: int, src: int, w: int) {
        var ext = 0
        if (w == 64) {
            ext = ext | 0x08
        }
        if (src >= 8) {
            ext = ext | 0x04
        }
        if (dst >= 8) {
            ext = ext | 0x01
        }
        if (ext != 0) {
            this.u8(0x40 | ext)
        }
        this.u8(0x89)
        this.u8(0xC0 | ((src & 7) << 3) | (dst & 7))
    }

    fn movabsReloc(reg: int, sym: string) {
        var ext = 0x08
        if (reg >= 8) {
            ext = ext | 0x01
        }
        this.u8(0x40 | ext)
        this.u8(0xB8 + (reg & 7))
        this.relocAbs(sym)
    }

    fn leaRbp(reg: int, k: int) {
        var ext = 0x08
        if (reg >= 8) {
            ext = ext | 0x04
        }
        this.u8(0x40 | ext)
        this.u8(0x8D)
        for (b in this.rbpMem(reg, k)) {
            this.u8(b)
        }
    }

    fn subRsp(k: int) {
        this.u8(0x48)
        this.u8(0x81)
        this.u8(0xEC)
        this.u32le(k)
    }

    fn addRsp(k: int) {
        this.u8(0x48)
        this.u8(0x81)
        this.u8(0xC4)
        this.u32le(k)
    }

    fn stRsp(reg: int, w: int, disp: int) {
        if (w == 64) {
            this.u8(0x48)
        }
        if (w == 8) {
            this.u8(0x88)
        } else {
            this.u8(0x89)
        }
        this.u8(0x44 | (reg << 3))
        this.u8(0x24)
        this.u8(disp)
    }

    fn stsdRsp(reg: int, disp: int) {
        this.ssePre(reg)
        this.u8(0x0F)
        this.u8(0x11)
        this.u8(0x44 | ((reg & 7) << 3))
        this.u8(0x24)
        this.u8(disp)
    }

    fn setcc(cc: int) {
        this.u8(0x0F)
        this.u8(0x90 + cc)
        this.u8(0xC0)
    }

    /// `setcc` into CL. Float compares need two independent results - one from
    /// the ordering flag (CF/ZF) and one from PF for the unordered case - and
    /// `setcc` hardcodes ModRM 0xC0, which is always AL. Emitting both into AL
    /// means the second one clobbers the first; the trailing `AND AL,CL` /
    /// `OR AL,CL` then combines against an undefined CL, so the result depends
    /// on whatever CL happened to hold.
    fn setccCl(cc: int) {
        this.u8(0x0F)
        this.u8(0x90 + cc)
        this.u8(0xC1)
    }
}

fn f64ToBits(f: float) -> int {
    var neg = false
    var a = f
    if (a < 0.0) {
        neg = true
        a = 0.0 - a
    }
    if (a != a) {
        // NaN compares false against everything, so it slips past both the sign
        // test and the `== 0.0` test. Rust lowers float constants with native
        // `to_bits`, so emit the canonical quiet NaN instead of letting it fall
        // through to the mantissa math below (where `nan as int` is garbage).
        var nanBits = 0x7FF8000000000000
        if (neg) {
            nanBits = nanBits | i64MinBits()
        }
        return nanBits
    }
    if (a == 0.0) {
        // `-0.0 < 0.0` is false under IEEE, so `neg` cannot have caught a
        // negative zero above. `1.0 / a` is the reliable discriminator: it is
        // `-inf` for `-0.0` and `+inf` for `+0.0`. Rust keeps the sign bit
        // (`f64::to_bits` of `-0.0` is `i64::MIN`), so this must not flatten
        // `-0.0` onto `+0.0`.
        if (neg || (1.0 / a) < 0.0) {
            return i64MinBits()
        }
        return 0
    }
    var e = 0
    // Both normalization loops are bounded. A literal at or above the f64
    // ceiling parses to +inf, and `inf / 2.0` is still `inf`, so the first
    // loop would spin forever; symmetrically an underflowing value can reach
    // 0.0 and then spin forever in the second (`0.0 * 2.0` is still `0.0`).
    // Clamping `e` turns both into a detectable saturating case below.
    while (a >= 2.0 && e < 1200) {
        a = a / 2.0
        e = e + 1
    }
    if (a >= 2.0) {
        // Saturated upward: the magnitude overflowed to infinity. `a` is
        // already non-negative here, so the sign bit is taken from `neg` alone -
        // ORing `i64MinBits()` unconditionally would turn every `+inf`, which
        // is what an overflowing positive literal such as `1.0e400` parses to,
        // into `-inf`.
        var infBits = 0x7FF0000000000000
        if (neg) {
            infBits = infBits | i64MinBits()
        }
        return infBits
    }
    while (a < 1.0 && e > 0 - 1200) {
        a = a * 2.0
        e = e - 1
    }
    if (a < 1.0 || e < 0 - 1074) {
        // Saturated downward: the magnitude underflowed past the smallest
        // subnormal, which really is zero.
        return 0
    }
    var eField = e + 1023
    var fracI = 0
    if (eField <= 0) {
        // Subnormal (e <= -1022): there is no implicit leading 1, so scale the
        // whole value rather than `a - 1.0`. The mantissa field is
        // `a * 2^(e + 1074)`, and `e >= -1074` above keeps the loop short.
        // Note that e == -1022 with a == 1.0 is the smallest *normal*, 2^-1022,
        // and must keep its exponent field of 1 - it is not zero.
        var frac = a
        var k = 0
        while (k < e + 1074) {
            frac = frac * 2.0
            k = k + 1
        }
        fracI = frac as int
        eField = 0
    } else {
        fracI = ((a - 1.0) * 4503599627370496.0) as int
    }
    var bits = (eField << 52) | fracI
    if (neg) {
        bits = bits | i64MinBits()
    }
    bits
}

fn i64MinBits() -> int {
    (0 - 0x7FFFFFFFFFFFFFFF) - 1
}

fn negTwo63Bits() -> int {
    i64MinBits() | 0x43E0000000000000
}

class FnPlan {
    var ncells: int
    var shadowBytes: int
    var totalK: int
    var shadowed: bool
    var slotCell: List<int>
    var slotK: List<int>
    var tempCell: Map<int, int>
    var tempK: Map<int, int>
    var types: Map<int, IrTy>
    /// Scalar constants that never need a stack home: the emitter materialises
    /// them at the use site (or folds them into the instruction's immediate
    /// field). Keys are temps, values the 64-bit bit pattern.
    var constVals: Map<int, int>
    /// Hot unmanaged scalar slots kept in a callee-saved register for the whole
    /// body. Slot -> register number.
    var slotReg: Map<int, int>
    /// Hot float slots kept in an XMM register for the whole body. Slot -> XMM
    /// register number. Only populated for functions that emit no call: every
    /// XMM register is volatile under Win64, so a call would destroy the pin.
    /// These slots therefore get no stack home at all - the register *is* the
    /// home, exactly like `slotReg`.
    var floatSlotReg: Map<int, int>
    /// Registers pinned by this function, in save order. Empty for most
    /// functions (the selection is use-count driven).
    var pinRegs: List<int>
    /// K of each pin's save slot, parallel to `pinRegs`.
    var pinK: List<int>
    /// How many times each temp is read, instructions and terminators
    /// included. A comparison read exactly once by its block's `BranchIf` is
    /// fused into the branch instead of materialising a 0/1 bool.
    var tempUses: Map<int, int>

    constructor(
        ncells: int,
        shadowBytes: int,
        totalK: int,
        shadowed: bool,
        slotCell: List<int>,
        slotK: List<int>,
        tempCell: Map<int, int>,
        tempK: Map<int, int>,
        types: Map<int, IrTy>,
        constVals: Map<int, int>,
        slotReg: Map<int, int>,
        pinRegs: List<int>,
        pinK: List<int>,
        tempUses: Map<int, int>
    ) {
        this.ncells = ncells
        this.shadowBytes = shadowBytes
        this.totalK = totalK
        this.shadowed = shadowed
        this.slotCell = slotCell
        this.slotK = slotK
        this.tempCell = tempCell
        this.tempK = tempK
        this.types = types
        this.constVals = constVals
        this.slotReg = slotReg
        this.pinRegs = pinRegs
        this.pinK = pinK
        this.tempUses = tempUses
    }

    fn slotHome(s: int) -> int? {
        if (this.slotReg.has(s) || this.floatSlotReg.has(s)) {
            none
        } else if (s < len(this.slotCell) && this.slotCell[s] >= 0) {
            return this.shadowBytes - SHADOW_HEADER_BYTES - CELL_BYTES * this.slotCell[s]
        } else if (s < len(this.slotK) && this.slotK[s] >= 1) {
            return this.slotK[s]
        } else {
            none
        }
    }

    fn tempHome(t: int) -> int? {
        if (this.tempCell.has(t)) {
            return this.shadowBytes - SHADOW_HEADER_BYTES - CELL_BYTES * this.tempCell[t]
        }
        if (this.tempK.has(t)) {
            return this.tempK[t]
        }
        none
    }
}

fn defTy(types: Map<int, IrTy>, v: int) -> IrTy {
    if (types.has(v)) {
        types[v]
    } else {
        IrTy.Ptr
    }
}

/// Registers eligible for slot pinning, in preference order. All of them are
/// callee-saved under the Win64 ABI, so a pinned value survives every call the
/// emitter emits (including into the runtime, which follows the same ABI). The
/// emitter itself never touches these, so no allocator bookkeeping is needed.
const PIN_REG_0: int = 3
const PIN_REG_1: int = 6
const PIN_REG_2: int = 7
const PIN_REG_3: int = 12
const PIN_REG_4: int = 13
const PIN_REG_5: int = 14
const MAX_PINS: int = 6
/// Float pins use xmm2..xmm5. All four are volatile under Win64, which is fine
/// because the selection only ever fires for functions whose body emits no
/// call; xmm0/xmm1 stay the emitter's scratch pair, so a pinned register is
/// never implicitly clobbered by a lowering sequence.
const MAX_FLOAT_PINS: int = 4
fn floatPinRegAt(j: int) -> int {
    return 2 + j
}
/// A slot has to be touched at least this many times before the prologue save
/// and the one-instruction restore at the return are worth the register. Two
/// uses already break even, but three keeps short leaf helpers untouched.
const PIN_MIN_USES: int = 3

fn pinRegAt(j: int) -> int {
    match (j) {
        case 0 -> PIN_REG_0
        case 1 -> PIN_REG_1
        case 2 -> PIN_REG_2
        case 3 -> PIN_REG_3
        case 4 -> PIN_REG_4
        case 5 -> PIN_REG_5
        case _ -> 15
    }
}

fn slotUseCount(uses: Map<int, int>, s: int) -> int {
    if (uses.has(s)) {
        uses[s]
    } else {
        0
    }
}

fn tempUseCount(uses: Map<int, int>, t: int) -> int {
    if (uses.has(t)) {
        uses[t]
    } else {
        0
    }
}

fn bumpTempUses(uses: Map<int, int>, t: int) {
    uses[t] = tempUseCount(uses, t) + 1
}

/// Count every temp read by one instruction. Definitions are not uses; the
/// only consumers of this map are the fusion and forwarding decisions, which
/// care whether a value is read after it is produced.
fn countInstrUses(uses: Map<int, int>, ins: IrInstr) {
    match (ins) {
        case IrInstr.Const(d, cst) -> {}
        case IrInstr.UnOp(d, op, v) -> bumpTempUses(uses, v)
        case IrInstr.BinOp(d, op, a, b) -> {
            bumpTempUses(uses, a)
            bumpTempUses(uses, b)
        }
        case IrInstr.Copy(d, v) -> bumpTempUses(uses, v)
        case IrInstr.Itof(d, v) -> bumpTempUses(uses, v)
        case IrInstr.Ftoi(d, v) -> bumpTempUses(uses, v)
        case IrInstr.Chartoi(d, v) -> bumpTempUses(uses, v)
        case IrInstr.Itochar(d, v) -> bumpTempUses(uses, v)
        case IrInstr.LoadSlot(d, s) -> {}
        case IrInstr.StoreSlot(s, v) -> bumpTempUses(uses, v)
        case IrInstr.LocalAddr(d, s) -> {}
        case IrInstr.LoadRaw(d, addr, ty) -> bumpTempUses(uses, addr)
        case IrInstr.StoreRaw(addr, v, ty) -> {
            bumpTempUses(uses, addr)
            bumpTempUses(uses, v)
        }
        case IrInstr.GlobalAddr(d, id) -> {}
        case IrInstr.LoadGlobal(d, id, ty) -> {}
        case IrInstr.StoreGlobal(id, v, ty) -> bumpTempUses(uses, v)
        case IrInstr.Call(d, callee, args) -> {
            for (a in args) {
                bumpTempUses(uses, a)
            }
        }
        case IrInstr.CallInd(d, fnAddr, params, ret, args) -> {
            bumpTempUses(uses, fnAddr)
            for (a in args) {
                bumpTempUses(uses, a)
            }
        }
    }
}

/// True when `ins` reads `t`. The alias flush needs the predicate form: a
/// `LoadSlot` result only lives in its pin register inside the block that
/// loaded it, so a read from any other block forces a store to its home.
fn instrReadsTmp(ins: IrInstr, t: int) -> bool {
    var hit = false
    match (ins) {
        case IrInstr.Const(d, cst) -> {}
        case IrInstr.UnOp(d, op, v) -> {
            if (v == t) { hit = true }
        }
        case IrInstr.BinOp(d, op, a, b) -> {
            if (a == t || b == t) { hit = true }
        }
        case IrInstr.Copy(d, v) -> {
            if (v == t) { hit = true }
        }
        case IrInstr.Itof(d, v) -> {
            if (v == t) { hit = true }
        }
        case IrInstr.Ftoi(d, v) -> {
            if (v == t) { hit = true }
        }
        case IrInstr.Chartoi(d, v) -> {
            if (v == t) { hit = true }
        }
        case IrInstr.Itochar(d, v) -> {
            if (v == t) { hit = true }
        }
        case IrInstr.LoadSlot(d, s) -> {}
        case IrInstr.StoreSlot(s, v) -> {
            if (v == t) { hit = true }
        }
        case IrInstr.LocalAddr(d, s) -> {}
        case IrInstr.LoadRaw(d, addr, ty) -> {
            if (addr == t) { hit = true }
        }
        case IrInstr.StoreRaw(addr, v, ty) -> {
            if (addr == t || v == t) { hit = true }
        }
        case IrInstr.GlobalAddr(d, id) -> {}
        case IrInstr.LoadGlobal(d, id, ty) -> {}
        case IrInstr.StoreGlobal(id, v, ty) -> {
            if (v == t) { hit = true }
        }
        case IrInstr.Call(d, callee, args) -> {
            for (a in args) {
                if (a == t) { hit = true }
            }
        }
        case IrInstr.CallInd(d, fnAddr, params, ret, args) -> {
            if (fnAddr == t) { hit = true }
            for (a in args) {
                if (a == t) { hit = true }
            }
        }
    }
    hit
}

// ---------------------------------------------------------------------------
// Which functions can actually trigger a collection?
//
// A shadow frame only exists to keep a function's managed homes visible while a
// collection can run, and a collection only ever runs under `abiEngineRegister`
// (the auto-collect trigger; `abiEngineCollect` is reached from there). A
// function whose body cannot reach that trigger - directly or through the call
// graph - can never observe a collection, so its homes need no frame at all.
//
// Gating the frame on this keeps hot runtime helpers (list get/push, map
// lookup, string slicing) frame-free: they carry managed `*int` homes now, but
// none of them can collect. Every frame that genuinely sits on the dynamic
// chain above a collection is still emitted, because a caller of a collecting
// function is itself marked collecting (the reachability is transitive).
//
// Conservatism: an indirect call (`CallInd`) is treated as collecting, since
// the target is unknown, and an extern whose symbol names the engine trigger is
// treated the same way.
/// Whether a call to this extern symbol can reach a collection. The compiler
/// emits `pickle_*` calls for every runtime operation, and only the allocating
/// ones can collect. Whitelisting the read-only/arithmetic entry points is what
/// lets hot lookups (`pickle_map_get`, `pickle_list_get`, `pickle_unbox_i64`, ...)
/// drop their shadow frame entirely, in user programs as well as the runtime.
/// Everything not listed stays conservative: a wrong "cannot collect" would
/// leave live locals invisible while the GC runs.
fn externMayCollect(sym: string) -> bool {
    if (sym == "pickle_map_get" || sym == "pickle_map_get_boxed"
        || sym == "pickle_map_has" || sym == "pickle_map_len"
        || sym == "pickle_list_get" || sym == "pickle_list_len"
        || sym == "pickle_str_len" || sym == "pickle_str_cmp"
        || sym == "pickle_str_get" || sym == "pickle_str_contains"
        || sym == "pickle_str_starts_with" || sym == "pickle_str_ends_with"
        || sym == "pickle_str_index_of" || sym == "pickle_str_last_index_of"
        || sym == "pickle_str_count"
        || sym == "pickle_unbox_i64" || sym == "pickle_unbox_char"
        || sym == "pickle_unbox_bool" || sym == "pickle_unbox_f64"
        || sym == "pickle_fmod"
        || sym == "pickle_obj_slot_get" || sym == "pickle_obj_slot_set"
        || sym == "pickle_tuple_field"
        || sym == "pickle_enum_tag" || sym == "pickle_enum_field"
        || sym == "pickle_enum_set_field"
        || sym == "pickle_enum_eq" || sym == "pickle_union_eq"
        || sym == "pickle_class_is" || sym == "pickle_int_pow"
        // Win32/CRT primitives: the heap, TLS, memory-copy and process-exit
        // entry points are OS calls; they can never re-enter PickleScript code,
        // so they cannot reach the collection trigger. `__imp_ExitProcess` is
        // listed because the allocator's failure path calls it: leaving it out
        // made every allocating helper transitively may-GC, which put a shadow
        // push/pop around every string/map/list operation. The same applies to
        // `memcpy`/`memset`, which every string builder calls.
        || sym == "__imp_HeapAlloc" || sym == "__imp_HeapFree"
        || sym == "__imp_GetProcessHeap" || sym == "__imp_ExitProcess"
        || sym == "__imp_TlsAlloc" || sym == "__imp_TlsGetValue"
        || sym == "__imp_TlsSetValue"
        // Console writes. `abi_panic`/`abi_expect`/the fatal channel write to
        // stderr through these, and any diagnostic built on them is a leaf: a
        // WriteFile cannot re-enter PickleScript code, so it cannot reach the
        // collection trigger.
        || sym == "__imp_GetStdHandle"
        || sym == "__imp_WriteFile"
        // Win32 synchronization primitives. An SRW lock / condition variable
        // call is a kernel transition; it can never run PickleScript code, so a
        // function whose only "allocating" call is one of these cannot reach
        // the collection trigger. They are listed deliberately: the collector's
        // sweep takes the chunk lock through `abiManagedRelease`, and leaving
        // the SRW imports unlisted marked the whole sweep may-GC. That put a
        // shadow frame on `geSweepBlock`, whose prologue then re-entered the
        // non-recursive registry lock the sweep already holds (self-deadlock).
        || sym == "__imp_AcquireSRWLockExclusive"
        || sym == "__imp_TryAcquireSRWLockExclusive"
        || sym == "__imp_ReleaseSRWLockExclusive"
        || sym == "__imp_SleepConditionVariableSRW"
        || sym == "__imp_WakeConditionVariable"
        || sym == "__imp_WakeAllConditionVariable"
        || sym == "__imp_memcpy" || sym == "__imp_memmove"
        || sym == "__imp_memset" || sym == "__imp_memcmp"
        // Raw heap allocation/free: `pickle_raw_alloc` is the `alloc(int, n)`
        // builtin's HeapAlloc wrapper (with `pickle_raw_free` its HeapFree
        // pair). Neither registers a managed object nor reaches
        // `abiEngineRegister`, so a caller holding only its own homes across
        // one can never observe a collection. Leaving these out marked every
        // function that touches `alloc` may-GC - including `str(int)`'s
        // intern-table init, which put a 17-cell shadow frame on the hottest
        // string helper in the benchmark.
        || sym == "pickle_raw_alloc" || sym == "pickle_raw_free"
        // Pure string -> string builders. `abi_string`'s newStr/builders
        // deliberately do NOT register their blocks (see that module's header):
        // strings allocate from the managed arena and never enter the
        // sweepability registry, so no path below reaches the collection
        // trigger. Only string-to-string entries are listed; the split/chars
        // family creates lists through `abiListNew`, which does register, and
        // stays conservative.
        || sym == "pickle_str_concat" || sym == "pickle_str_append_owned"
        || sym == "pickle_str_from_i64" || sym == "pickle_str_from_bytes"
        || sym == "pickle_str_from_bool" || sym == "pickle_str_from_byte"
        || sym == "pickle_str_from_char" || sym == "pickle_str_substring"
        || sym == "pickle_str_set" || sym == "pickle_str_repeat"
        || sym == "pickle_str_replace" || sym == "pickle_str_replace_first"
        || sym == "pickle_str_to_lower" || sym == "pickle_str_to_upper"
        || sym == "pickle_str_trim" || sym == "pickle_str_trim_start"
        || sym == "pickle_str_trim_end"
        || sym == "pickle_str_pad_start" || sym == "pickle_str_pad_end"
        || sym == "pickle_str_strip_prefix" || sym == "pickle_str_strip_suffix") {
        return false
        }
    true
}

fn computeMayGC(m: IrModule) -> Map<string, bool> {
    var mgc: Map<string, bool> = {"": false}
    mgc.remove("")
    var i = 0
    while (i < len(m.funcs)) {
        let f = m.funcs[i]
        if (f.name == "abiEngineRegister") {
            mgc[f.name] = true
        }
        for (b in f.blocks) {
            for (ins in b.instrs) {
                match (ins) {
                    case IrInstr.Call(d, callee, args) -> {
                        match (callee) {
                            case Callee.Func(id) -> {}
                            case Callee.Extern(id) -> {
                                // Only allocating runtime entry points can
                                // collect. OS/CRT calls cannot re-enter the
                                // runtime, and the read-only pickle_* helpers
                                // are listed in `externMayCollect`.
                                if (externMayCollect(m.externs[id].symbol)) {
                                    mgc[f.name] = true
                                }
                            }
                        }
                    }
                    case IrInstr.CallInd(d, fnAddr, params, ret, args) -> {
                        mgc[f.name] = true
                    }
                    case _ -> {}
                }
            }
        }
        i = i + 1
    }
    var changed = true
    while (changed) {
        changed = false
        var a = 0
        while (a < len(m.funcs)) {
            let f = m.funcs[a]
            if (!mgc.has(f.name)) {
                for (b in f.blocks) {
                    for (ins in b.instrs) {
                        match (ins) {
                            case IrInstr.Call(d, callee, args) -> {
                                match (callee) {
                                    case Callee.Func(id) -> {
                                        if (mgc.has(m.funcs[id].name)) {
                                            mgc[f.name] = true
                                            changed = true
                                        }
                                    }
                                    case Callee.Extern(id) -> {}
                                }
                            }
                            case _ -> {}
                        }
                    }
                }
            }
            a = a + 1
        }
    }
    mgc
}

/// True when the callee is the global `pickle_str_concat` entry point. Runtime
/// modules call `abiStrConcat` directly (`Callee.Func`), which is deliberately
/// excluded: only the user-facing ABI call has the assignment shape.
fn isExternConcat(m: IrModule, callee: Callee) -> bool {
    match (callee) {
        case Callee.Extern(id) -> m.externs[id].symbol == "pickle_str_concat"
        case Callee.Func(id) -> false
    }
}

fn instrTouchesSlot(ins: IrInstr, s: int) -> bool {
    match (ins) {
        case IrInstr.LoadSlot(d, s2) -> s2 == s
        case IrInstr.StoreSlot(s2, v) -> s2 == s
        case IrInstr.LocalAddr(d, s2) -> s2 == s
        case _ -> false
    }
}

fn blockStoresTo(fun: IrFunc, id: int, s: int) -> bool {
    let blk = fun.blocks[id]
    var hit = false
    for (ins in blk.instrs) {
        match (ins) {
            case IrInstr.StoreSlot(s2, v) -> {
                if (s2 == s) {
                    hit = true
                }
            }
            case _ -> {}
        }
    }
    hit
}

/// True when this block contains a `pickle_str_concat` whose first argument
/// comes from a load of `s`. This is a *possible* mutation point; using a
/// superset here is safe because a false positive only makes the ownership
/// proof more conservative.
fn blockHasConcatOnSlot(m: IrModule, fun: IrFunc, id: int, s: int, loadSlotOf: Map<int, int>) -> bool {
    let blk = fun.blocks[id]
    var hit = false
    for (ins in blk.instrs) {
        match (ins) {
            case IrInstr.Call(d, callee, args) -> {
                if (isExternConcat(m, callee) && len(args) >= 1) {
                    let a0 = args[0]
                    if (loadSlotOf.has(a0) && loadSlotOf[a0] == s) {
                        hit = true
                    }
                }
            }
            case _ -> {}
        }
    }
    hit
}

fn termSucc(term: IrTerm) -> List<int> {
    var out: List<int> = []
    match (term) {
        case IrTerm.Branch(t) -> { out.push(t) }
        case IrTerm.BranchIf(c, tn, el) -> {
            out.push(tn)
            out.push(el)
        }
        case IrTerm.Return(v) -> {}
        case IrTerm.Unreachable -> {}
    }
    out
}

/// Can a read of the slot reach an append block without a store to the slot in
/// between? A store replaces the value the read saw, so paths through one are
/// harmless. Anything else means the read value can still be the object an
/// append would mutate - reject.
fn reachesAppendBlock(m: IrModule, fun: IrFunc, start: int, s: int, loadSlotOf: Map<int, int>) -> bool {
    var seen = {0: false}
    seen.remove(0)
    var q: List<int> = []
    q.push(start)
    var qi = 0
    while (qi < len(q)) {
        let id = q[qi]
        qi = qi + 1
        if (!(seen.has(id) && seen[id])) {
            seen[id] = true
            if (blockHasConcatOnSlot(m, fun, id, s, loadSlotOf)) {
                return true
            }
            if (!blockStoresTo(fun, id, s)) {
                for (nx in termSucc(fun.blocks[id].term)) {
                    if (!(seen.has(nx) && seen[nx])) {
                        q.push(nx)
                    }
                }
            }
        }
    }
    false
}

/// Follow a concat result through single-use concat consumers until it is
/// stored. The chain is only accepted when it stays in one block and stores
/// back to `s`, with no other access to `s` between the root load and the
/// store. Returns every concat call in the chain, or an empty list.
fn appendChain(
    m: IrModule,
    fun: IrFunc,
    concatBlock: Map<int, int>,
    concatArg0: Map<int, int>,
    loadBlock: Map<int, int>,
    first: int,
    s: int,
    tempUses: Map<int, int>
) -> List<int> {
    var chain: List<int> = []
    let bi = concatBlock[first]
    let root = concatArg0[first]
    if (!loadBlock.has(root) || loadBlock[root] != bi) {
        return chain
    }
    var rootIdx = 0 - 1
    var ii = 0
    for (ins in fun.blocks[bi].instrs) {
        match (ins) {
            case IrInstr.LoadSlot(d, s2) -> {
                if (d == root && s2 == s) {
                    rootIdx = ii
                }
            }
            case _ -> {}
        }
        ii = ii + 1
    }
    if (rootIdx < 0) {
        return chain
    }
    var cur = first
    chain.push(first)
    var storeIdx = 0 - 1
    var steps = 0
    var ok = true
    while (ok && storeIdx < 0) {
        steps = steps + 1
        if (steps > 64 || tempUseCount(tempUses, cur) != 1) {
            ok = false
        } else {
            var consumer = 0 - 1
            var count = 0
            ii = 0
            for (ins in fun.blocks[bi].instrs) {
                if (instrReadsTmp(ins, cur)) {
                    consumer = ii
                    count = count + 1
                }
                ii = ii + 1
            }
            if (count != 1) {
                ok = false
            } else {
                match (fun.blocks[bi].instrs[consumer]) {
                    case IrInstr.StoreSlot(s2, v) -> {
                        ok = s2 == s
                        if (ok) {
                            storeIdx = consumer
                        }
                    }
                    case IrInstr.Call(d2, callee, args) -> {
                        var next = false
                        if (isExternConcat(m, callee) && len(args) == 2 && args[0] == cur) {
                            match (d2) {
                                case some(dd) -> {
                                    if (concatBlock.has(dd) && concatBlock[dd] == bi) {
                                        chain.push(dd)
                                        cur = dd
                                        next = true
                                    }
                                }
                                case none -> {}
                            }
                        }
                        if (!next) {
                            ok = false
                        }
                    }
                    case _ -> { ok = false }
                }
            }
        }
    }
    if (!ok || storeIdx < 0) {
        return [0]
    }
    // Nothing may read the slot between the chain's root load and final store:
    // a read there would observe the half-appended buffer.
    ii = rootIdx + 1
    while (ii < storeIdx) {
        if (instrTouchesSlot(fun.blocks[bi].instrs[ii], s)) {
            return [0]
        }
        ii = ii + 1
    }
    chain
}

/// Result of the append-owned proof: which concat destinations may lower to
/// `pickle_str_append_owned`, plus the two-link chains that may lower to one
/// fused `pickle_str_append_two`. `fuse` maps the *first* concat's destination
/// to `[root, piece]`; the emitter skips that call and emits the fused call at
/// the second link.
class AppendPlan {
    var owned: Map<int, bool>
    var fuse: Map<int, List<int>>

    constructor(owned: Map<int, bool>, fuse: Map<int, List<int>>) {
        this.owned = owned
        this.fuse = fuse
    }
}

/// Backend-only proof that lets `pickle_str_concat` lower to
/// `pickle_str_append_owned`. See the runtime body for the second line of
/// defence (static/shared strings are always copied). The proof is deliberately
/// whole-function: a single escaped read of the slot that can reach an append
/// without an intervening store disqualifies the slot, even if the immediate
/// instruction sequence looks linear.
fn analyzeAppendOwned(m: IrModule, fun: IrFunc, types: Map<int, IrTy>, tempUses: Map<int, int>) -> AppendPlan {
    var owned = {0: false}
    owned.remove(0)
    var fuse = {0: [0]}
    fuse.remove(0)
    // The schedules below address blocks by id. The emitter allocates ids in
    // order; refuse anything else instead of guessing.
    var bi = 0
    while (bi < len(fun.blocks)) {
        if (fun.blocks[bi].id != bi) {
            return AppendPlan(owned, fuse)
        }
        bi = bi + 1
    }
    var loadSlotOf = {0: 0}
    loadSlotOf.remove(0)
    var loadBlock = {0: 0}
    loadBlock.remove(0)
    var concatArg0 = {0: 0}
    concatArg0.remove(0)
    var concatArg1 = {0: 0}
    concatArg1.remove(0)
    var concatBlock = {0: 0}
    concatBlock.remove(0)
    var arg0Set = {0: false}
    arg0Set.remove(0)
    var constStr = {0: false}
    constStr.remove(0)
    var any = false
    for (blk in fun.blocks) {
        for (ins in blk.instrs) {
            match (ins) {
                case IrInstr.LoadSlot(d, s) -> {
                    loadSlotOf[d] = s
                    loadBlock[d] = blk.id
                    // Unit tail: the arms below are value-typed and all arms of
                    // a match must agree.
                    {}
                }
                case IrInstr.StoreSlot(s, v) -> {}
                case IrInstr.LocalAddr(d, s) -> {}
                case IrInstr.Const(d, cst) -> {
                    match (cst) {
                        case IrConst.Str(id) -> { constStr[d] = true }
                        case _ -> {}
                    }
                }
                case IrInstr.Call(d, callee, args) -> {
                    if (isExternConcat(m, callee) && len(args) == 2) {
                        any = true
                        match (d) {
                            case some(dd) -> {
                                concatArg0[dd] = args[0]
                                concatArg1[dd] = args[1]
                                concatBlock[dd] = blk.id
                                arg0Set[args[0]] = true
                            }
                            case none -> {}
                        }
                    }
                }
                case _ -> {}
            }
        }
    }
    if (!any) {
        return AppendPlan(owned, fuse)
    }
    // Rule 1: a concat result used exactly once as another concat's first
    // argument is private by construction, regardless of where it came from.
    for (dd in concatArg0.keys()) {
        let a0 = concatArg0[dd]
        if (concatArg0.has(a0) && tempUseCount(tempUses, a0) == 1) {
            owned[dd] = true
        }
    }
    // Rule 2: a linear string slot. Every stored value must be a literal or a
    // single-use concat result; every read that is not the chain's root must be
    // unable to reach an append without crossing a store.
    var si = 0
    while (si < len(fun.slots)) {
        let s = si
        if (fun.slots[s] == IrTy.Str) {
            var hasAddr = false
            var badStore = false
            var hasStore = false
            var roots = 0
            var otherLoads: List<int> = []
            for (blk in fun.blocks) {
                for (ins in blk.instrs) {
                    match (ins) {
                        case IrInstr.LocalAddr(d, s2) -> {
                            if (s2 == s) {
                                hasAddr = true
                            }
                        }
                        case IrInstr.StoreSlot(s2, v) -> {
                            if (s2 == s) {
                                hasStore = true
                                var good = constStr.has(v)
                                if (!good && concatArg0.has(v) && tempUseCount(tempUses, v) == 1) {
                                    good = true
                                }
                                if (!good) {
                                    badStore = true
                                }
                            }
                        }
                        case IrInstr.LoadSlot(d, s2) -> {
                            if (s2 == s) {
                                if (arg0Set.has(d) && tempUseCount(tempUses, d) == 1) {
                                    roots = roots + 1
                                } else {
                                    otherLoads.push(d)
                                }
                            }
                        }
                        case _ -> {}
                    }
                }
            }
            if (!hasAddr && !badStore && hasStore && roots > 0) {
                var safe = true
                for (l2 in otherLoads) {
                    if (safe) {
                        let lb = loadBlock[l2]
                        if (blockStoresTo(fun, lb, s)) {
                            safe = false
                        }
                        if (safe && reachesAppendBlock(m, fun, lb, s, loadSlotOf)) {
                            safe = false
                        }
                    }
                }
                if (safe) {
                    for (dd in concatArg0.keys()) {
                        let a0 = concatArg0[dd]
                        if (loadSlotOf.has(a0) && loadSlotOf[a0] == s && tempUseCount(tempUses, a0) == 1) {
                            let ch = appendChain(m, fun, concatBlock, concatArg0, loadBlock, dd, s, tempUses)
                            if (len(ch) > 0) {
                                for (ct in ch) {
                                    owned[ct] = true
                                }
                                if (len(ch) == 2 && concatArg1.has(ch[0])) {
                                    fuse[ch[0]] = [concatArg0[ch[0]], concatArg1[ch[0]]]
                                }
                            }
                        }
                    }
                }
            }
        }
        si = si + 1
    }
    AppendPlan(owned, fuse)
}

fn analyze(m: IrModule, fun: IrFunc, mayGC: Map<string, bool>) -> FnPlan {
    var slotCell: List<int> = []
    var slotK: List<int> = []
    var i = 0
    while (i < len(fun.slots)) {
        slotCell.push(-1)
        slotK.push(0)
        i = i + 1
    }
    var types = {0: IrTy.Unit}
    types.remove(0)
    var constVals = {0: 0}
    constVals.remove(0)
    var tempUses = {0: 0}
    tempUses.remove(0)
    var allTemps: List<int> = []
    // Slot pinning inputs: a slot whose address is taken must keep its stack
    // home (the address has to stay valid for the whole body), and the use
    // count decides which remaining slots are hot enough to be worth a
    // callee-saved register.
    var addressTaken = {0: false}
    addressTaken.remove(0)
    var slotUses = {0: 0}
    slotUses.remove(0)
    // Mark blocks that lie inside a loop: a backward branch target plus every
    // block up to the branching block. Uses there are weighted, so loop-carried
    // locals (the map hash's `h`, `v`, `n`) outrank locals that merely appear
    // often in straight-line code when the six pins are handed out.
    var loopBlock = {0: false}
    loopBlock.remove(0)
    for (pb in fun.blocks) {
        loopBlock[pb.id] = false
    }
    for (pb in fun.blocks) {
        var back = 0 - 1
        match (pb.term) {
            case IrTerm.Branch(t) -> {
                if (t <= pb.id) { back = t }
            }
            case IrTerm.BranchIf(c, tn, el) -> {
                if (tn <= pb.id) { back = tn }
                if (el <= pb.id) { back = el }
            }
            case _ -> {}
        }
        if (back >= 0) {
            var lk = back
            while (lk <= pb.id) {
                loopBlock[lk] = true
                lk = lk + 1
            }
        }
    }
    var bi = 0
    while (bi < len(fun.blocks)) {
        let cur = fun.blocks[bi]
        let wgt = if (loopBlock.has(cur.id) && loopBlock[cur.id]) { 8 } else { 1 }
        for (ins in cur.instrs) {
            match (ins) {
                case IrInstr.Const(d, cst) -> {
                    types[d] = constTy(cst)
                    if (let IrConst.Int(v) = cst) {
                        constVals[d] = v
                    }
                    if (let IrConst.Bool(bv) = cst) {
                        if (bv) {
                            constVals[d] = 1
                        } else {
                            constVals[d] = 0
                        }
                    }
                    if (let IrConst.Char(cv) = cst) {
                        constVals[d] = cv as int
                    }
                    if (IrConst.Null == cst) {
                        constVals[d] = 0
                    }
                    allTemps.push(d)
                }
                case IrInstr.UnOp(d, op, v) -> {
                    if (op == IrUnOp.Not) {
                        types[d] = IrTy.Bool
                    } else {
                        types[d] = defTy(types, v)
                    }
                    allTemps.push(d)
                }
                case IrInstr.BinOp(d, op, a, b) -> {
                    if (isCmp(op)) {
                        types[d] = IrTy.Bool
                    } else {
                        types[d] = defTy(types, a)
                    }
                    allTemps.push(d)
                }
                case IrInstr.Copy(d, v) -> {
                    types[d] = defTy(types, v)
                    allTemps.push(d)
                }
                case IrInstr.Itof(d, v) -> {
                    types[d] = IrTy.Float
                    allTemps.push(d)
                }
                case IrInstr.Ftoi(d, v) -> {
                    types[d] = IrTy.Int
                    allTemps.push(d)
                }
                case IrInstr.Chartoi(d, v) -> {
                    types[d] = IrTy.Int
                    allTemps.push(d)
                }
                case IrInstr.Itochar(d, v) -> {
                    types[d] = IrTy.Char
                    allTemps.push(d)
                }
                case IrInstr.LoadSlot(d, s) -> {
                    types[d] = fun.slots[s]
                    slotUses[s] = slotUseCount(slotUses, s) + wgt
                    allTemps.push(d)
                }
                case IrInstr.StoreSlot(s, v) -> {
                    slotUses[s] = slotUseCount(slotUses, s) + wgt
                }
                case IrInstr.LocalAddr(d, s) -> {
                    types[d] = IrTy.Int
                    addressTaken[s] = true
                    allTemps.push(d)
                }
                case IrInstr.LoadRaw(d, addr, ty) -> {
                    types[d] = ty
                    allTemps.push(d)
                }
                case IrInstr.StoreRaw(addr, v, ty) -> {}
                case IrInstr.GlobalAddr(d, id) -> {
                    types[d] = IrTy.Int
                    allTemps.push(d)
                }
                case IrInstr.LoadGlobal(d, id, ty) -> {
                    types[d] = ty
                    allTemps.push(d)
                }
                case IrInstr.StoreGlobal(id, v, ty) -> {}
                case IrInstr.Call(d, callee, args) -> {
                    match (d) {
                        case some(dd) -> {
                            types[dd] = callRet(m, callee)
                            allTemps.push(dd)
                        }
                        case none -> {}
                    }
                }
                case IrInstr.CallInd(d, fnAddr, params, ret, args) -> {
                    match (d) {
                        case some(dd) -> {
                            types[dd] = ret
                            allTemps.push(dd)
                        }
                        case none -> {}
                    }
                }
            }
        }
        bi = bi + 1
    }
    var ncells = 0
    var tempCell = {0: 0}
    tempCell.remove(0)
    // Count reads after types are known: the fusion check below needs the
    // BranchIf operand's total use count, terminators included.
    for (blk in fun.blocks) {
        for (ins in blk.instrs) {
            countInstrUses(tempUses, ins)
        }
        match (blk.term) {
            case IrTerm.BranchIf(c, tn, el) -> bumpTempUses(tempUses, c)
            case IrTerm.Return(v) -> {
                match (v) {
                    case some(tv) -> bumpTempUses(tempUses, tv)
                    case none -> {}
                }
            }
            case _ -> {}
        }
    }
    var tempK = {0: 0}
    tempK.remove(0)
    i = 0
    while (i < len(fun.slots)) {
        if (isManaged(fun.slots[i])) {
            slotCell[i] = ncells
            ncells = ncells + 1
        }
        i = i + 1
    }
    for (t in allTemps) {
        if (!constVals.has(t) && isManaged(types[t])) {
            tempCell[t] = ncells
            ncells = ncells + 1
        }
    }
    let shadowBytes = SHADOW_HEADER_BYTES + CELL_BYTES * ncells
    // Pick the hot scalar slots to keep in registers. Int and Char only: both
    // are 4/8-byte values every candidate register can encode directly, while a
    // `bool` slot is one byte and byte registers 4..7 need a REX prefix to mean
    // sil/dil rather than ah/bh. Float would need an XMM register. Ties break on
    // the lower slot index so the choice is deterministic.
    var cand: List<int> = []
    i = 0
    while (i < len(fun.slots)) {
        let ty = fun.slots[i]
        if (!addressTaken.has(i) && (ty == IrTy.Int || ty == IrTy.Char)
            && slotUseCount(slotUses, i) >= PIN_MIN_USES) {
            cand.push(i)
            }
        i = i + 1
    }
    var slotReg = {0: 0}
    slotReg.remove(0)
    var pinRegs: List<int> = []
    var pinSet: List<bool> = []
    i = 0
    while (i < len(cand)) {
        pinSet.push(false)
        i = i + 1
    }
    var picking = true
    while (picking && len(pinRegs) < MAX_PINS) {
        var best = 0 - 1
        var bestUses = 0
        var j = 0
        while (j < len(cand)) {
            if (!pinSet[j]) {
                let u = slotUseCount(slotUses, cand[j])
                if (best < 0 || u > bestUses) {
                    best = j
                    bestUses = u
                }
            }
            j = j + 1
        }
        if (best < 0) {
            picking = false
        } else {
            pinSet[best] = true
            let rg = pinRegAt(len(pinRegs))
            slotReg[cand[best]] = rg
            pinRegs.push(rg)
        }
    }
    // Float pins: only when the body cannot emit a call. `exp`, the benchmark's
    // hot Taylor loop, reads and writes nothing but float locals, and keeping
    // them in XMM registers removes the memory round trip that otherwise sits
    // on the `mulsd`/`divsd` dependency chain on every iteration.
    var emitsCall = fun.symbol == ENTRY_SYMBOL
    if (ncells > 0 && mayGC.has(fun.name) && !isShadowApiFn(fun.name, fun.symbol)) {
        // The prologue/return shadow push calls clobber every volatile XMM
        // register, so a float pin could not survive them either.
        emitsCall = true
    }
    for (blk in fun.blocks) {
        for (ins in blk.instrs) {
            match (ins) {
                case IrInstr.Call(_, _, _) -> emitsCall = true
                case IrInstr.CallInd(_, _, _, _, _) -> emitsCall = true
                case IrInstr.BinOp(_, op, a, _) -> {
                    // Float modulo lowers to a call to `pickle_fmod`.
                    if (op == IrBinOp.Mod && isFloatTy(defTy(types, a))) {
                        emitsCall = true
                    }
                }
                case _ -> {}
            }
        }
    }
    // Seeding more than one float parameter would let an earlier pin overwrite
    // an incoming xmm2/xmm3 argument before `seedParams` has spilled it. A
    // single float parameter is safe: its own move either is a no-op or happens
    // before any other pin is seeded.
    var floatParams = 0
    for (p in fun.params) {
        if (isFloatTy(p.ty)) {
            floatParams = floatParams + 1
        }
    }
    var floatSlotReg = {0: 0}
    floatSlotReg.remove(0)
    if (!emitsCall && floatParams <= 1) {
        var fcand: List<int> = []
        i = 0
        while (i < len(fun.slots)) {
            if (!(addressTaken.has(i) && addressTaken[i]) && isFloatTy(fun.slots[i])
                && slotUseCount(slotUses, i) >= PIN_MIN_USES) {
                fcand.push(i)
                }
            i = i + 1
        }
        var fpinSet: List<bool> = []
        for (f in fcand) {
            fpinSet.push(false)
        }
        var fpicking = true
        var fpins = 0
        while (fpicking && fpins < MAX_FLOAT_PINS) {
            var fbest = 0 - 1
            var fbestUses = 0
            var fk = 0
            while (fk < len(fcand)) {
                if (!fpinSet[fk]) {
                    let u = slotUseCount(slotUses, fcand[fk])
                    if (fbest < 0 || u > fbestUses) {
                        fbest = fk
                        fbestUses = u
                    }
                }
                fk = fk + 1
            }
            if (fbest < 0) {
                fpicking = false
            } else {
                fpinSet[fbest] = true
                floatSlotReg[fcand[fbest]] = floatPinRegAt(fpins)
                fpins = fpins + 1
            }
        }
    }
    // The shadow frame occupies K in [0, shadowBytes]: `prev` sits at exactly
    // shadowBytes, so unmanaged slots/temps must start strictly past it. Starting
    // at shadowBytes would let an alloc whose K is already a multiple of its
    // alignment (e.g. tyBytes(Int) == 8) land on `prev`, which pickle_shadow_push
    // then overwrites.
    //
    // A home's displacement K is its *deepest* byte: an access of width W bytes
    // at [rbp-K] physically consumes offsets [K-W+1, K]. `used` tracks the
    // deepest K reserved so far, and each new home of width W must satisfy
    // K >= used + W so [K-W+1, K] clears the previous home instead of
    // overlapping a small home parked directly beneath an aligned big one.
    var used = shadowBytes + CELL_BYTES
    var firstK = true
    i = 0
    while (i < len(fun.slots)) {
        if (!isManaged(fun.slots[i]) && !slotReg.has(i) && !floatSlotReg.has(i)) {
            let k = alignK(used + (if (firstK) { 0 } else { tyBytes(fun.slots[i]) }), tyBytes(fun.slots[i]))
            slotK[i] = k
            used = k
            firstK = false
        }
        i = i + 1
    }
    for (t in allTemps) {
        if (!constVals.has(t) && !isManaged(types[t])) {
            let k = alignK(used + (if (firstK) { 0 } else { tyBytes(types[t]) }), tyBytes(types[t]))
            tempK[t] = k
            used = k
            firstK = false
        }
    }
    // Save area for the pinned registers, at the bottom of the frame. Each save
    // slot is a full 8 bytes, and the lowest one has to clear the last home, so
    // the reservation starts one slot deeper than `used`.
    let pinBytes = 8 * len(pinRegs)
    var pinK: List<int> = []
    var totalK = 0
    if (pinBytes > 0) {
        used = used + pinBytes + 8
    }
    totalK = alignK(used, 16)
    var j0 = 0
    while (j0 < len(pinRegs)) {
        pinK.push(totalK - 8 * (j0 + 1))
        j0 = j0 + 1
    }
    let shadowed = ncells > 0 && mayGC.has(fun.name) && !isShadowApiFn(fun.name, fun.symbol)
    var plan = FnPlan(ncells, shadowBytes, totalK, shadowed, slotCell, slotK, tempCell, tempK, types, constVals, slotReg, pinRegs, pinK, tempUses)
    // Assigned after construction: the seed-built backend drops the 15th
    // constructor argument, leaving a null map behind. `floatSlotReg` is a
    // plain field, so a post-hoc store is equivalent.
    plan.floatSlotReg = floatSlotReg
    plan
}

class X64Emitter {
    var m: IrModule
    var diags: DiagnosticSink
    var fun: IrFunc
    var mayGC: Map<string, bool>
    var plan: FnPlan
    var failed: bool
    var cb: CB
    var fixes: List<BranchFix>
    var starts: Map<int, int>
    /// Lazily computed spawn capability of the whole lowered module: -1 before
    /// the first query, 0 when nothing names `pickle_thread_spawn`, 1 when the
    /// module defines or calls it. Only a spawn-capable module pays for the
    /// loop back-edge safepoints; every other module keeps the pre-Phase-3
    /// bytes exactly.
    var spawnCapable: int
    /// Loop-header blocks of the function being emitted, and whether the scan
    /// that fills it has run. A header is any block some terminator reaches
    /// with a backward edge; it carries the per-iteration safepoint.
    var loopHeads: Map<int, bool>
    var loopHeadsComputed: bool
    /// Temp whose value is currently in rax, and the width that value is valid
    /// at (-1 / 0 when nothing is known). See `loadTmp`/`noteRax`.
    var raxT: int
    var raxW: int
    /// Same, for rcx. The two registers are the emitter's operand pair, so a
    /// value left in one can reach the other with a register move instead of a
    /// reload. Both entries are cleared at every instruction boundary unless
    /// the arm proved what it left behind.
    var rcxT: int
    var rcxW: int
    /// Deferred home write. `pendT` is a temp whose value is in rax but not yet
    /// stored to its home, because it has exactly one use and that use can take
    /// it straight out of rax. `pendK` is the home the write was skipped for.
    /// Anything that touches rax before the consumer must `flushPend` first;
    /// `lowerInstr`/`lowerTerm` decide that from the instruction shape.
    var pendT: int
    var pendK: int
    var pendW: int
    /// Compare/branch fusion for the current block: when `fuseCc >= 0`, the
    /// block's trailing comparison `fuseA op fuseB` is emitted as `cmp`+`jcc`
    /// inside `lowerTerm` instead of a setcc/store. `fuseImm` says the right
    /// operand is the constant `fuseImmV`.
    var fuseCc: int
    var fuseA: int
    var fuseB: int
    var fuseW: int
    var fuseImm: bool
    var fuseImmV: int
    /// Counter for the negative pseudo-block ids used by backend-only inline
    /// sequences that need a local join/slow label. Real block ids are
    /// non-negative, so `-1 - n` can never collide with one in `starts`.
    var inlineLab: int
    /// Pinned-slot aliases. A `LoadSlot` of a register-pinned slot needs no
    /// copy: the value already lives in the pin register until the next store
    /// to that slot. `aliasReg` maps the loaded temp to that register,
    /// `aliasSlot` records which slot it came from (so a store invalidates it),
    /// and `aliasW` is the width the register is valid at. The alias is
    /// materialised to the temp's home only when a store clobbers the register
    /// or a use wants a different width.
    var aliasReg: Map<int, int>
    var aliasSlot: Map<int, int>
    var aliasW: Map<int, int>
    /// Float-pinned-slot aliases, the XMM counterpart of `aliasReg`: a
    /// `LoadSlot` of a `floatSlotReg` slot names the pin directly and consumers
    /// read it without a copy.
    var aliasXmm: Map<int, int>
    var aliasXSlot: Map<int, int>
    /// Temp ids whose value a float-producing instruction left in xmm0/xmm1, or
    /// -1. Like `raxT`/`rcxT` this is a redundant copy: every float result is
    /// still written to its home, so a miss (or a cleared entry) just reloads.
    /// It exists to keep `mulsd` -> `divsd` chains out of memory.
    var fx0: int
    var fx1: int
    /// `pickle_str_concat` results whose first argument the backend may pass to
    /// `pickle_str_append_owned` instead. Keyed by the call's destination temp;
    /// `analyzeAppendOwned` only lists calls where the function provably owns
    /// the buffer, and the runtime re-checks the string header regardless.
    var appendOwned: Map<int, bool>
    /// First link of a proven two-concat chain, mapped to `[root, piece]`.
    /// Emitting that call is skipped; the second link becomes one
    /// `pickle_str_append_two` call with both pieces.
    var appendFuse: Map<int, List<int>>

    constructor(m: IrModule, fun: IrFunc, diags: DiagnosticSink, mayGC: Map<string, bool>) {
        this.m = m
        this.fun = fun
        this.diags = diags
        this.failed = false
        this.mayGC = mayGC
        this.plan = analyze(m, fun, mayGC)
        let ap = analyzeAppendOwned(m, fun, this.plan.types, this.plan.tempUses)
        this.appendOwned = ap.owned
        this.appendFuse = ap.fuse
        this.cb = CB()
        this.fixes = [BranchFix(0, 0)]
        this.fixes.pop()
        this.starts = {0: 0}
        this.starts.remove(0)
        this.spawnCapable = 0 - 1
        this.loopHeads = {0: true}
        this.loopHeads.remove(0)
        this.loopHeadsComputed = false
        this.raxT = 0 - 1
        this.raxW = 0
        this.rcxT = 0 - 1
        this.rcxW = 0
        this.pendT = 0 - 1
        this.pendK = 0
        this.pendW = 0
        this.fuseCc = 0 - 1
        this.fuseA = 0
        this.fuseB = 0
        this.fuseW = 64
        this.fuseImm = false
        this.fuseImmV = 0
        this.inlineLab = 0
        this.aliasReg = {0: 0}
        this.aliasReg.remove(0)
        this.aliasSlot = {0: 0}
        this.aliasSlot.remove(0)
        this.aliasW = {0: 0}
        this.aliasW.remove(0)
        this.aliasXmm = {0: 0}
        this.aliasXmm.remove(0)
        this.aliasXSlot = {0: 0}
        this.aliasXSlot.remove(0)
        this.fx0 = 0 - 1
        this.fx1 = 0 - 1
    }

    fn fail(msg: string) {
        this.failed = true
        this.diags.emit(Diagnostic.errorAt(Span(0, 0), "x64: " + msg))
    }

    fn typeOfT(t: int) -> IrTy {
        this.plan.types[t]
    }

    /// Linker symbol behind a global id.
    fn globalSym(id: int) -> string {
        this.m.globals[id].symbol
    }

    /// Which global slot types have a lowering. A POD scalar carries its value in
    /// `.data`; `string` carries a raw object pointer that `pkl_globals_init`
    /// roots with `pickle_gc_root_add` before any initializer runs. `Ptr` is
    /// still excluded because nothing emits its root registration yet.
    fn globalTyOk(ty: IrTy) -> bool {
        ty == IrTy.Int || ty == IrTy.Bool || ty == IrTy.Char || ty == IrTy.Float
        || ty == IrTy.Str || ty == IrTy.Ptr
    }

    fn kOfSlot(s: int) -> int {
        match (this.plan.slotHome(s)) {
            case some(k) -> k
            case none -> {
                this.fail("unplanned slot " + str(s))
                0
            }
        }
    }

    fn kOfTemp(t: int) -> int {
        match (this.plan.tempHome(t)) {
            case some(k) -> k
            case none -> {
                this.fail("unplanned temp t" + str(t))
                0
            }
        }
    }

    /// Load a source temp into `reg`. Scalar constants have no stack home (and
    /// no shadow cell), so they are rematerialised here. This is what removes
    /// the `movabs`+store+reload sequence a literal used to cost.
    ///
    /// `reg == 0` also consults the rax forwarding cache: when the previous
    /// instruction left this very temp in rax, the reload is dropped. `raxT`
    /// and `raxW` are only ever set where the emitter knows rax's final
    /// contents, so a hit is always exact.
    fn loadTmp(reg: int, w: int, t: int) {
        // The deferred result lives only in rax. Serving the consumer from it
        // is the reason the home write was skipped; a width mismatch means rax
        // cannot be used as-is, so materialise the home and reload normally.
        if (t == this.pendT) {
            if (w == this.pendW) {
                this.pendT = 0 - 1
                if (reg == 0) {
                    this.raxT = t
                    this.raxW = w
                    return
                }
                this.cb.movRR(reg, 0, w)
                if (reg == 1) {
                    this.rcxT = t
                    this.rcxW = w
                }
                return
            }
            this.cb.st(0, this.pendW, this.pendK)
            this.pendT = 0 - 1
        }
        if (reg == 0 && this.raxT == t && this.raxW == w) {
            return
        }
        if (reg == 1 && this.rcxT == t && this.rcxW == w) {
            return
        }
        if (this.plan.constVals.has(t)) {
            this.cb.movabsImm(reg, this.plan.constVals[t])
            if (reg == 0) {
                this.raxT = t
                this.raxW = w
            } else if (reg == 1) {
                this.rcxT = t
                this.rcxW = w
            }
            return
        }
        // A float temp loaded straight from a pinned slot is not in its home.
        // A consumer that wants the raw bits (a copy or an int-typed alias)
        // gets them from the pin register; the XMM copy stays valid.
        if (this.aliasXmm.has(t)) {
            if (w == 64) {
                this.cb.movqXmmToR(reg, this.aliasXmm[t])
                if (reg == 0) {
                    this.raxT = t
                    this.raxW = w
                } else if (reg == 1) {
                    this.rcxT = t
                    this.rcxW = w
                }
                return
            }
            this.cb.stsd(this.aliasXmm[t], this.kOfTemp(t))
            this.dropXAlias(t)
        }
        // A register-to-register move is ~1 cycle against ~5 for a reload that
        // forwards through the store it follows.
        if (reg == 0 && this.rcxT == t && this.rcxW == w) {
            this.cb.movRR(0, 1, w)
            this.raxT = t
            this.raxW = w
            return
        }
        if (reg == 1 && this.raxT == t && this.raxW == w) {
            this.cb.movRR(1, 0, w)
            this.rcxT = t
            this.rcxW = w
            return
        }
        // A pinned-slot load left the value in its callee-saved register; serve
        // the use from there instead of a home that was never written.
        if (this.aliasReg.has(t)) {
            if (this.aliasW[t] == w) {
                let ar = this.aliasReg[t]
                if (ar != reg) {
                    this.cb.movRR(reg, ar, w)
                }
                if (reg == 0) {
                    this.raxT = t
                    this.raxW = w
                } else if (reg == 1) {
                    this.rcxT = t
                    this.rcxW = w
                }
                return
            }
            // Reused at a different width (e.g. char -> int): give the home its
            // one write, then load normally.
            this.flushAlias(t)
        }
        this.cb.ld(reg, w, this.kOfTemp(t))
        if (reg == 0) {
            this.raxT = t
            this.raxW = w
        } else if (reg == 1) {
            this.rcxT = t
            this.rcxW = w
        }
    }

    /// Load a float operand into an SSE register. A float constant keeps an
    /// ordinary home, but an Int/Bool/Char constant can appear where a float is
    /// expected: the front end's implicit "return zero" tail emits `const 0`
    /// even in a float function. Scalar constants have no home (`noEmitConst`),
    /// so reproduce what a home-based backend's 8-byte load would see: the
    /// constant's 64-bit pattern reinterpreted as a double. r11 carries the
    /// bits, so neither rax (possibly an already-loaded argument) nor any other
    /// argument register is disturbed.
    fn loadTmpFloat(reg: int, t: int) {
        // `putRes` can leave a float load's bits in rax with its home never
        // written: unpinned float slots load through the integer `ld` path, and
        // a single-use temp defers the store. Consume that value here, exactly
        // as `loadTmp` does for integer consumers. rax stays valid, so the
        // deferred home write is still safe to drop or flush later.
        if (t == this.pendT) {
            if (this.pendW == 64) {
                this.cb.movqXmmRax(reg)
                if (reg < 2) {
                    this.setFx(reg, t)
                }
                return
            }
            this.cb.st(0, this.pendW, this.pendK)
            this.pendT = 0 - 1
        }
        // A pinned float slot has no stack home: its value lives in the pin
        // register for the whole body. Copying from there is the only load.
        if (this.aliasXmm.has(t)) {
            let ar = this.aliasXmm[t]
            if (ar != reg) {
                if (reg < 2) {
                    this.dropFxReg(reg)
                }
                this.cb.movsdRR(reg, ar)
            }
            if (reg < 2) {
                this.setFx(reg, t)
            }
            return
        }
        if (reg >= 2) {
            // A pin destination reads the producer's result straight out of the
            // scratch register that still holds it. Without this, every float
            // pin store reloads the home the producer just wrote, putting a
            // store-to-load-forwarding round trip on the loop's critical path
            // (the `exp` Taylor loop measured ~25 cycles/iteration instead of
            // the ~19 the arithmetic allows).
            if (this.fx0 == t) {
                this.cb.movsdRR(reg, 0)
                return
            }
            if (this.fx1 == t) {
                this.cb.movsdRR(reg, 1)
                return
            }
        }
        if (reg < 2) {
            if (this.fxOf(reg) == t) {
                return
            }
            // Serve the other scratch register before touching memory: a
            // `mulsd` result feeding a `divsd` whose divisor was already
            // converted stays entirely in registers.
            let other = 1 - reg
            if (this.fxOf(other) == t) {
                this.dropFxReg(reg)
                this.cb.movsdRR(reg, other)
                this.setFx(reg, t)
                return
            }
            // An unrelated tracked value is only a copy; the home is current.
            this.dropFxReg(reg)
        }
        if (this.plan.constVals.has(t)) {
            this.cb.movabsImm(11, this.plan.constVals[t])
            this.cb.movqXmmR11(reg)
        } else {
            this.cb.ldsd(reg, this.kOfTemp(t))
        }
        if (reg < 2) {
            this.setFx(reg, t)
        }
    }

    /// Write the value in rax to `d`'s home - or, when `d` has exactly one use,
    /// leave it in rax and remember the skipped write. The consumer takes it
    /// from rax (`loadTmp`), so a chain of single-use temps lowers to one
    /// instruction per node with no store at all. `flushPend` covers every case
    /// where something else needs rax first.
    fn putRes(d: int, w: int, kd: int) {
        if (this.pendT < 0 && tempUseCount(this.plan.tempUses, d) == 1) {
            this.pendT = d
            this.pendK = kd
            this.pendW = w
        } else {
            this.cb.st(0, w, kd)
        }
    }

    /// Emit the deferred home write, if any. Always safe: it does not change
    /// rax, so the forwarding entry stays valid.
    fn flushPend() {
        if (this.pendT >= 0) {
            this.cb.st(0, this.pendW, this.pendK)
            this.pendT = 0 - 1
        }
    }

    fn dropAlias(t: int) {
        if (this.aliasReg.has(t)) {
            this.aliasReg.remove(t)
            this.aliasSlot.remove(t)
            this.aliasW.remove(t)
        }
    }

    /// Materialise an aliased temp into its home and forget the alias. Required
    /// before the pin register it names is overwritten.
    fn flushAlias(t: int) {
        if (this.aliasReg.has(t)) {
            this.cb.st(this.aliasReg[t], this.aliasW[t], this.kOfTemp(t))
            this.dropAlias(t)
        }
    }

    /// Spill every live alias of `s` except `keep` (the value about to be
    /// written to the slot's register).
    fn flushSlotAliases(s: int, keep: int) {
        let ts = this.aliasSlot.keys()
        for (t in ts) {
            if (t != keep && this.aliasSlot.has(t) && this.aliasSlot[t] == s) {
                this.flushAlias(t)
            }
        }
    }

    /// Forget what an XMM register holds. The producing instruction already
    /// wrote the temp's home, so dropping is always safe - it only costs the
    /// next consumer a reload.
    fn dropFxReg(reg: int) {
        if (reg == 0) {
            this.fx0 = 0 - 1
        } else {
            this.fx1 = 0 - 1
        }
    }

    fn dropFx() {
        this.fx0 = 0 - 1
        this.fx1 = 0 - 1
    }

    fn fxOf(reg: int) -> int {
        if (reg == 0) {
            this.fx0
        } else {
            this.fx1
        }
    }

    fn setFx(reg: int, t: int) {
        if (reg == 0) {
            this.fx0 = t
        } else {
            this.fx1 = t
        }
    }

    /// Materialise every live float alias of `s` into its temp's home before a
    /// store overwrites the pin register that currently backs it.
    fn flushXSlotAliases(s: int) {
        let ts = this.aliasXmm.keys()
        for (t in ts) {
            if (this.aliasXmm.has(t) && this.aliasXSlot[t] == s) {
                this.cb.stsd(this.aliasXmm[t], this.kOfTemp(t))
                this.aliasXmm.remove(t)
                this.aliasXSlot.remove(t)
            }
        }
    }

    fn dropXAlias(t: int) {
        if (this.aliasXmm.has(t)) {
            this.aliasXmm.remove(t)
            this.aliasXSlot.remove(t)
        }
    }

    /// True when `t`, a `LoadSlot` result defined in block `bi`, is read from
    /// any other block. Aliases only live in their pin register inside the
    /// block that loaded them, so exactly these reads force a store to the
    /// home before that block's terminator.
    fn tempReadOutside(t: int, bi: int) -> bool {
        var j = 0
        while (j < len(this.fun.blocks)) {
            if (j != bi) {
                let blk = this.fun.blocks[j]
                for (ins in blk.instrs) {
                    if (instrReadsTmp(ins, t)) {
                        return true
                    }
                }
                match (blk.term) {
                    case IrTerm.BranchIf(c, tn, el) -> {
                        if (c == t) {
                            return true
                        }
                    }
                    case IrTerm.Return(v) -> {
                        match (v) {
                            case some(tv) -> {
                                if (tv == t) {
                                    return true
                                }
                            }
                            case none -> {}
                        }
                    }
                    case _ -> {}
                }
            }
            j = j + 1
        }
        false
    }

    /// Materialise the aliases read outside the current block. Every path out
    /// of a block runs through its terminator, so this is the exit state later
    /// blocks can rely on. Aliases read only by the terminator itself stay live
    /// for `loadTmp` to consume straight from the pin.
    fn flushLiveOutAliases(bi: int) {
        let ts = this.aliasSlot.keys()
        for (t in ts) {
            if (this.aliasSlot.has(t) && this.tempReadOutside(t, bi)) {
                this.flushAlias(t)
            }
        }
        let xs = this.aliasXmm.keys()
        for (t in xs) {
            if (this.aliasXmm.has(t) && this.tempReadOutside(t, bi)) {
                this.cb.stsd(this.aliasXmm[t], this.kOfTemp(t))
                this.dropXAlias(t)
            }
        }
    }

    /// Forget every alias at block exit. The pin register may be reused on a
    /// path that never executed the load, so a later block must never see it.
    fn clearAliases() {
        let ts = this.aliasSlot.keys()
        for (t in ts) {
            this.dropAlias(t)
        }
        let xs = this.aliasXmm.keys()
        for (t in xs) {
            this.dropXAlias(t)
        }
        this.dropFx()
    }

    /// True for a scalar `Const` instruction: `emitConst` rematerialises those
    /// at each use, so the instruction emits no code and leaves rax untouched.
    /// The IR interleaves one before almost every operand, so treating it as a
    /// barrier would flush the deferred value into its home and reload it
    /// immediately - exactly the store/reload pair this cache exists to avoid.
    fn noEmitConst(ins: IrInstr) -> bool {
        match (ins) {
            case IrInstr.Const(d, c) -> {
                return this.plan.constVals.has(d)
            }
            case _ -> {
                return false
            }
        }
    }

    /// Whether lowering `ins` will read the deferred temp out of rax as its
    /// first action. Mirrors the operand normalisation in `emitBinOp` and the
    /// load order of the other arms exactly; anything unrecognised answers
    /// false, which costs a store but can never lose the value.
    fn pendingConsumedBy(ins: IrInstr) -> bool {
        let t = this.pendT
        if (t < 0) {
            return false
        }
        // A rematerialised constant emits nothing, so the pending value keeps
        // its home in rax across it.
        if (this.noEmitConst(ins)) {
            return true
        }
        let w = this.pendW
        match (ins) {
            case IrInstr.StoreGlobal(id, v, ty) -> {
                return v == t && tyWidth(ty) == w
            }
            case IrInstr.BinOp(d, op, a, b) -> {
                if (isFloatTy(this.typeOfT(a))) {
                    return false
                }
                var aa = a
                var bb = b
                if (!this.plan.constVals.has(bb) && this.plan.constVals.has(aa) && binOpCommutes(op)) {
                    aa = b
                    bb = a
                }
                return (aa == t || bb == t) && tyWidth(this.typeOfT(a)) == w
            }
            case IrInstr.UnOp(d, op, v) -> {
                if (op == IrUnOp.Neg && isFloatTy(this.typeOfT(v))) {
                    return false
                }
                var ww = tyWidth(this.typeOfT(v))
                if (op == IrUnOp.Not) {
                    ww = 8
                }
                return v == t && ww == w
            }
            case IrInstr.Copy(d, v) -> {
                return v == t && tyWidth(this.typeOfT(v)) == w
            }
            case IrInstr.LoadRaw(d, addr, ty) -> {
                return addr == t && w == 64
            }
            case IrInstr.StoreRaw(addr, v, ty) -> {
                if (isFloatTy(ty)) {
                    return false
                }
                if (addr == t && w == 64) {
                    return true
                }
                return v == t && tyWidth(ty) == w
            }
            case IrInstr.StoreSlot(s, v) -> {
                return v == t && tyWidth(this.fun.slots[s]) == w
            }
            case IrInstr.LoadSlot(d, s) -> {
                // A pinned-slot load emits no code (the temp aliases the pin
                // register), so a deferred rax value survives it unharmed.
                return this.plan.slotReg.has(s)
            }
            case IrInstr.Chartoi(d, v) -> {
                return v == t && w == 32
            }
            case IrInstr.Itochar(d, v) -> {
                return v == t && w == 64
            }
            // Calls load their arguments before emitting the `call`, so a
            // deferred result that is argument 0 is consumed by that first
            // load. This is what keeps a just-computed slot/tag read from
            // being stored and immediately reloaded for the unbox that
            // follows it. Restrict to the shapes whose lowering really does
            // start with `loadTmp(argReg, ..., args[0])`:
            //   * the append-fuse rewrite drops or reorders `pickle_str_concat`
            //     arguments, so it keeps the flush;
            //   * the indirect-call address load comes after the arguments, so
            //     only a plain argument-0 use qualifies there.
            case IrInstr.Call(d, callee, args) -> {
                if (len(args) == 0 || args[0] != t) {
                    return false
                }
                var pt: IrTy = this.typeOfT(args[0])
                match (callee) {
                    case Callee.Func(id) -> {
                        let f = this.m.funcs[id]
                        if (len(f.params) == 0) {
                            return false
                        }
                        pt = f.params[0].ty
                    }
                    case Callee.Extern(id) -> {
                        let e = this.m.externs[id]
                        if (e.symbol == "pickle_str_concat" && len(args) == 2) {
                            return false
                        }
                        if (len(e.params) == 0) {
                            return false
                        }
                        pt = e.params[0]
                    }
                }
                if (isFloatTy(pt)) {
                    return false
                }
                return tyWidth(pt) == w
            }
            case IrInstr.CallInd(d, fnAddr, params, ret, args) -> {
                if (len(args) == 0 || args[0] != t || len(params) == 0) {
                    return false
                }
                return !isFloatTy(params[0]) && tyWidth(params[0]) == w
            }
            case _ -> {
                return false
            }
        }
    }

    /// True when `ins` may leave the XMM copy cache (`fx0`/`fx1`) valid. Only a
    /// `call` can clobber xmm0/xmm1 behind the cache's back: every other
    /// lowering either touches GPRs only (integer loads, constants, copies,
    /// stores) or re-stamps the entry for the register it writes. That is what
    /// keeps `term * x` live across the `load i` / `itof i` pair in `exp`'s
    /// loop; dropping it there forced a reload of the numerator and a
    /// scratch-register reshuffle on every iteration.
    fn floatConsumedBy(ins: IrInstr) -> bool {
        match (ins) {
            // Integer binops use GPRs only. Float arithmetic writes xmm0 (and
            // operands via `loadTmpFloat`, which invalidates the register it
            // overwrites) and re-stamps fx0 with its result; the float modulo
            // path calls out and drops the cache explicitly.
            case IrInstr.BinOp(_, _, _, _) -> true
            // Float `Neg` writes xmm0 and drops fx1 itself; `Not`/`BitNot`
            // are GPR-only.
            case IrInstr.UnOp(_, _, _) -> true
            // Reads xmm0, writes xmm1 and rax; fx0 stays valid.
            case IrInstr.Ftoi(_, _) -> true
            // Writes a scratch xmm register and stamps it.
            case IrInstr.Itof(_, _) -> true
            // A float load drops fx0 before overwriting it; an integer load is
            // GPR-only.
            case IrInstr.LoadRaw(_, _, _) -> true
            // A float store routes through `loadTmpFloat(0, ...)`, which keeps
            // fx0 honest; an integer store is GPR-only.
            case IrInstr.StoreRaw(_, _, _) -> true
            // Unpinned float slots load their bits through the integer `ld`
            // path; pinned ones only link an alias. Neither writes xmm0/xmm1.
            case IrInstr.LoadSlot(_, _) -> true
            // A float constant drops fx0 before materialising itself and
            // re-stamps it; a rematerialised one emits nothing at all.
            case IrInstr.Const(_, _) -> true
            case IrInstr.Copy(_, _) -> true
            // Float pin stores forward from the cache; unpinned float stores
            // go through `loadTmpFloat(0, ...)`; integer stores are GPR-only.
            case IrInstr.StoreSlot(_, _) -> true
            case IrInstr.Chartoi(_, _) -> true
            case IrInstr.Itochar(_, _) -> true
            case IrInstr.LocalAddr(_, _) -> true
            case IrInstr.GlobalAddr(_, _) -> true
            case IrInstr.LoadGlobal(_, _, _) -> true
            case IrInstr.StoreGlobal(_, _, _) -> true
            // Calls may use every XMM register as scratch.
            case _ -> false
        }
    }

    /// Same decision for the block terminator, which is lowered after the
    /// instructions and can be the deferred temp's single consumer.
    fn termConsumes(t: IrTerm) -> bool {
        if (this.pendT < 0) {
            return false
        }
        match (t) {
            case IrTerm.BranchIf(c, tn, el) -> {
                if (this.fuseCc >= 0) {
                    return this.fuseA == this.pendT && this.fuseW == this.pendW
                }
                return c == this.pendT && this.pendW == 8
            }
            case IrTerm.Return(v) -> {
                // The escaped-exception check and shadow pop that `lowerTerm`
                // runs first are no-ops off the entry point and in a frame-free
                // function, so rax still holds the deferred value there.
                //
                // Float returns are the exception to the rax path: the return
                // arm moves xmm0 from the value's home with `ldsd`, so a float
                // temp left deferred would be read from an unwritten slot.
                if (this.plan.shadowed || this.fun.symbol == ENTRY_SYMBOL || isFloatTy(this.fun.ret)) {
                    return false
                }
                match (v) {
                    case some(ti) -> {
                        return ti == this.pendT && tyWidth(this.fun.ret) == this.pendW
                    }
                    case none -> {
                        return false
                    }
                }
            }
            case _ -> {
                return false
            }
        }
    }

    /// A call may destroy rcx (Win64 volatile register). Nothing may forward a
    /// temp through it once a `call` has been emitted; the rax return value is
    /// reconstructed separately by `putRes`/`noteRax`.
    fn clobberRcx() {
        this.rcxT = 0 - 1
        this.rcxW = 0
    }

    /// Record the temp whose value `ins` left in rax (or forget it). Every arm
    /// here mirrors an emitter arm that ends with rax holding the result, or
    /// leaves rax untouched. Anything else clears the cache, which is always
    /// safe - a miss just reloads from the home.
    fn noteRax(ins: IrInstr) {
        // No-emit scalars leave rax exactly as the previous instruction did.
        if (this.noEmitConst(ins)) {
            return
        }
        this.raxT = 0 - 1
        this.raxW = 0
        match (ins) {
            case IrInstr.UnOp(d, op, v) -> {
                if (!isFloatTy(this.typeOfT(v))) {
                    this.raxT = d
                    if (op == IrUnOp.Not) {
                        this.raxW = 8
                    } else {
                        this.raxW = tyWidth(this.typeOfT(d))
                    }
                }
            }
            case IrInstr.BinOp(d, op, a, b) -> {
                if (!isFloatTy(this.typeOfT(a))) {
                    this.raxT = d
                    if (isCmp(op)) {
                        this.raxW = 8
                    } else {
                        this.raxW = tyWidth(this.typeOfT(d))
                    }
                }
            }
            case IrInstr.Copy(d, v) -> {
                this.raxT = d
                this.raxW = tyWidth(this.typeOfT(v))
            }
            case IrInstr.Ftoi(d, v) -> {
                this.raxT = d
                this.raxW = 64
            }
            case IrInstr.Chartoi(d, v) -> {
                this.raxT = d
                this.raxW = 64
            }
            case IrInstr.Itochar(d, v) -> {
                this.raxT = d
                this.raxW = 32
            }
            case IrInstr.LoadSlot(d, s) -> {
                if (!this.plan.slotReg.has(s)) {
                    this.raxT = d
                    this.raxW = tyWidth(this.fun.slots[s])
                }
            }
            case IrInstr.StoreSlot(s, v) -> {
                // A pinned slot is written with a register move, which leaves
                // the value in rax alone only when the source was not loaded
                // there; the deflection below covers the common case.
                if (!this.plan.slotReg.has(s)) {
                    this.raxT = v
                    this.raxW = tyWidth(this.fun.slots[s])
                }
            }
            case IrInstr.LocalAddr(d, s) -> {
                this.raxT = d
                this.raxW = 64
            }
            case IrInstr.LoadRaw(d, addr, ty) -> {
                if (!isFloatTy(ty)) {
                    this.raxT = d
                    this.raxW = tyWidth(ty)
                }
            }
            case IrInstr.GlobalAddr(d, id) -> {
                this.raxT = d
                this.raxW = 64
            }
            case IrInstr.LoadGlobal(d, id, ty) -> {
                if (!isFloatTy(ty)) {
                    this.raxT = d
                    this.raxW = tyWidth(ty)
                }
            }
            case IrInstr.Call(d, callee, args) -> {
                // The call itself clobbers rcx.
                this.rcxT = 0 - 1
                this.rcxW = 0
                match (d) {
                    case some(dd) -> {
                        let rt = callRet(this.m, callee)
                        if (!isFloatTy(rt)) {
                            this.raxT = dd
                            this.raxW = tyWidth(rt)
                        }
                    }
                    case none -> {}
                }
            }
            case IrInstr.CallInd(d, fnAddr, params, ret, args) -> {
                this.rcxT = 0 - 1
                this.rcxW = 0
                match (d) {
                    case some(dd) -> {
                        if (!isFloatTy(ret)) {
                            this.raxT = dd
                            this.raxW = tyWidth(ret)
                        }
                    }
                    case none -> {}
                }
            }
            case _ -> {}
        }
    }

    /// True when a constant temp's value is a sign-extended 32-bit immediate.
    /// Everything wider has to go through `movabs`, which is still one
    /// instruction but needs a register instead of the immediate field.
    fn constFits32(t: int) -> bool {
        if (!this.plan.constVals.has(t)) {
            return false
        }
        let v = this.plan.constVals[t]
        v >= 0 - 2147483648 && v <= 2147483647
    }

    /// Does this module define or call `pickle_thread_spawn`? A module that
    /// never spawns cannot gain a second Pickle thread (the runtime creates one
    /// only from that entry point), so its loops need no safepoint and keep the
    /// original code shape. Cached: the scan is a property of the module, not
    /// of the function.
    fn moduleMaySpawn() -> bool {
        if (this.spawnCapable >= 0) {
            return this.spawnCapable != 0
        }
        var found = false
        var i = 0
        while (i < len(this.m.externs)) {
            if (this.m.externs[i].symbol == "pickle_thread_spawn") {
                found = true
            }
            i = i + 1
        }
        i = 0
        while (i < len(this.m.funcs)) {
            if (this.m.funcs[i].symbol == "pickle_thread_spawn") {
                found = true
            }
            i = i + 1
        }
        if (found) {
            this.spawnCapable = 1
        } else {
            this.spawnCapable = 0
        }
        return found
    }

    /// True when some terminator branches to a block that has already been
    /// emitted, i.e. the function contains a loop. Only used to decide whether
    /// the prologue must reserve Win64 shadow space for the loop-header poll.
    fn hasBackEdge() -> bool {
        var found = false
        for (b in this.fun.blocks) {
            if (this.isLoopHeader(b.id)) {
                found = true
            }
        }
        found
    }

    /// Can `to` reach `from` through the CFG? Used to distinguish a real loop
    /// back edge from a backward branch to a join block. An `if` whose join is
    /// laid out before its body produces an edge `body -> join` that points
    /// backwards in block order but closes no cycle: the join cannot reach the
    /// body. Treating that edge as a loop header plants a safepoint at an
    /// arbitrary join, and a poll executed while a runtime lock is held then
    /// re-enters that lock (`pickle_shadow_push` -> `shadowInitNode` -> poll ->
    /// `abiShadowSelf` -> `shadowLock`) and deadlocks the collector.
    fn closesCycle(src: int, dst: int, pos: Map<int, int>) -> bool {
        var seen: Map<int, bool> = Map<int, bool>()
        var work: List<int> = [dst]
        while (len(work) > 0) {
            let cur = work.pop()
            if (cur == src) {
                return true
            }
            if (!seen.has(cur) && pos.has(cur)) {
                seen[cur] = true
                match (this.fun.blocks[pos[cur]].term) {
                    case IrTerm.Branch(target) -> {
                        work.push(target)
                    }
                    case IrTerm.BranchIf(_, tn, el) -> {
                        work.push(tn)
                        work.push(el)
                    }
                    case _ -> {}
                }
            }
        }
        return false
    }

    /// Is `id` a loop header - a block some terminator reaches with a backward
    /// edge that actually closes a cycle? The safepoint lives here rather than
    /// at the terminator because at block entry no value is live in a
    /// caller-saved register: a poll at the terminator could destroy the
    /// comparison a fused `BranchIf` is about to consume. Computed once per
    /// function and cached.
    fn isLoopHeader(id: int) -> bool {
        if (!this.moduleMaySpawn()) {
            return false
        }
        // The safepoint function itself must never carry a poll. Its own wait
        // loop is already inside the park protocol; a poll at that header would
        // re-enter the protocol, decrement `gcRunningCount` a second time, and
        // deadlock the collector. It is also the recursion edge that turned a
        // dead-block back edge into an infinite `pickle_gc_poll -> poll` chain.
        if (this.fun.symbol == "pickle_gc_poll") {
            return false
        }
        if (!this.loopHeadsComputed) {
            var pos: Map<int, int> = {0: 0}
            pos.remove(0)
            var i = 0
            for (b in this.fun.blocks) {
                pos[b.id] = i
                i = i + 1
            }
            // Only reachable blocks may declare a loop header. The emitter
            // leaves dead join blocks behind (an `unsafe` expression's
            // abandoned merge, for one), and a dead `branch` to an earlier
            // block would otherwise make a live block look like a loop header.
            // That is not cosmetic: the extra safepoint poll can land inside
            // `pickle_gc_poll` itself, and the poll then recurses forever.
            var reach: Map<int, bool> = {0: true}
            var work: List<int> = [0]
            while (len(work) > 0) {
                let cur = work.pop()
                if (pos.has(cur)) {
                    let b = this.fun.blocks[pos[cur]]
                    match (b.term) {
                        case IrTerm.Branch(target) -> {
                            if (!reach.has(target)) {
                                reach[target] = true
                                work.push(target)
                            }
                        }
                        case IrTerm.BranchIf(_, tn, el) -> {
                            if (!reach.has(tn)) {
                                reach[tn] = true
                                work.push(tn)
                            }
                            if (!reach.has(el)) {
                                reach[el] = true
                                work.push(el)
                            }
                        }
                        case _ -> {}
                    }
                }
            }
            i = 0
            for (b in this.fun.blocks) {
                if (reach.has(b.id)) {
                    match (b.term) {
                        case IrTerm.Branch(target) -> {
                            if (pos.has(target) && pos[target] <= i && this.closesCycle(b.id, target, pos)) {
                                this.loopHeads[target] = true
                            }
                        }
                        case IrTerm.BranchIf(_, tn, el) -> {
                            if (pos.has(tn) && pos[tn] <= i && this.closesCycle(b.id, tn, pos)) {
                                this.loopHeads[tn] = true
                            }
                            if (pos.has(el) && pos[el] <= i && this.closesCycle(b.id, el, pos)) {
                                this.loopHeads[el] = true
                            }
                        }
                        case _ -> {}
                    }
                }
                i = i + 1
            }
            this.loopHeadsComputed = true
        }
        this.loopHeads.has(id)
    }

    /// `pickle_gc_poll()` at a loop header. Every managed home is already in
    /// the shadow frame (the frame is the spill area), so nothing has to be
    /// flushed; the call only destroys the redundant register caches, which are
    /// dropped first.
    ///
    /// The pending flag is tested INLINE. A loop that allocates nothing spends
    /// almost all its time here, and the out-of-line call (plus its 448-byte
    /// frame) was 3-4 cycles per iteration - the dominant cost of a tight
    /// numeric loop and the reason 8-16 such threads lost throughput to the
    /// call-heavy front end. The inline form is one RIP-relative load and a
    /// predicted `je`; the call happens only when a collection is pending.
    /// `gcRequested` is the same `pkl_global_` cell the runtime's poll reads.
    fn emitGcPoll() {
        this.raxT = 0 - 1
        this.raxW = 0
        this.clobberRcx()
        this.dropFx()
        // cmp dword ptr [rip + pkl_global_gcRequested], 0
        this.cb.u8(0x83)
        this.cb.u8(0x3D)
        this.cb.rel32Data("pkl_global_gcRequested", 0 - 1)
        this.cb.u8(0x00)
        // je +5: skip the call below, which is exactly five bytes.
        this.cb.u8(0x74)
        this.cb.u8(0x05)
        this.cb.callRel32("pickle_gc_poll")
    }

    /// True when the body can emit a machine `call`. Four-or-fewer-argument
    /// calls emit no `sub rsp` of their own (the args fit the registers), so
    /// only the prologue can reserve the Win64 shadow space they need.
    fn makesCalls() -> bool {
        if (this.plan.shadowed || this.fun.symbol == ENTRY_SYMBOL) {
            return true
        }
        if (this.moduleMaySpawn() && this.hasBackEdge()) {
            return true
        }
        var found = false
        for (blk in this.fun.blocks) {
            for (ins in blk.instrs) {
                match (ins) {
                    case IrInstr.Call(_, _, _) -> {
                        found = true
                    }
                    case IrInstr.CallInd(_, _, _, _, _) -> {
                        found = true
                    }
                    case IrInstr.BinOp(_, op, a, _) -> {
                        // Float modulo is a call to the `pickle_fmod` helper.
                        if (op == IrBinOp.Mod && isFloatTy(this.typeOfT(a))) {
                            found = true
                        }
                    }
                    case _ -> {}
                }
            }
        }
        found
    }

    fn prologue() {
        this.cb.u8(0x55)
        this.cb.u8(0x48)
        this.cb.u8(0x89)
        this.cb.u8(0xE5)
        var frameK = this.plan.totalK
        if (this.makesCalls()) {
            // Win64 reserves 32 bytes below every call for the callee's spill
            // area. Calls with at most four arguments emit no per-call `sub
            // rsp`, so the frame itself has to provide that scratch space;
            // otherwise the callee writes over the bottom of the caller's
            // frame - exactly where the pin saves live. `totalK` is 16-byte
            // aligned, so adding 32 keeps the call sites 16-byte aligned.
            frameK = frameK + CALL_SHADOW_BYTES
        }
        if (frameK > 0) {
            this.cb.subRsp(frameK)
        }
        // Slot pinning: stash the caller's callee-saved registers in the frame
        // before the body can touch them. `pinK` was laid out below every home.
        var p = 0
        while (p < len(this.plan.pinRegs)) {
            this.cb.st(this.plan.pinRegs[p], 64, this.plan.pinK[p])
            p = p + 1
        }
        if (this.plan.shadowed) {
            // Zero the cells two at a time with a 16-byte SSE store. Cells are
            // 8 bytes apart and `k` is the offset of the cell's *lowest* byte,
            // so cell `c` occupies [k, k+7] and cell `c+1` occupies
            // [k-8, k-1]: one `movdqu [rbp-k]` covers both. avx is avoided,
            // SSE2 is baseline.
            //
            // The register must NOT be xmm0..3: `seedParams` runs after this
            // and spills the incoming float arguments out of exactly those
            // registers, so zeroing xmm0 here would replace the first float
            // parameter with 0.0. xmm4 is volatile and unused by the emitter.
            this.cb.u8(0x0F)
            this.cb.u8(0x57)
            this.cb.u8(0xE4)
            var c = 0
            while (c + 1 < this.plan.ncells) {
                let k = this.plan.shadowBytes - SHADOW_HEADER_BYTES - CELL_BYTES * c
                this.cb.u8(0xF3)
                this.cb.u8(0x0F)
                this.cb.u8(0x7F)
                for (b in this.cb.rbpMem(4, k)) {
                    this.cb.u8(b)
                }
                c = c + 2
            }
            if (c < this.plan.ncells) {
                let k = this.plan.shadowBytes - SHADOW_HEADER_BYTES - CELL_BYTES * c
                this.cb.stImm(0, 64, k, 0)
            }
            let packed = (SHADOW_FRAME_TAG << SHADOW_TAG_SHIFT) | (this.plan.totalK << 32) | this.plan.ncells
            this.cb.stImm(0, 64, this.plan.shadowBytes - 8, packed)
        }
    }

    /// Pushes the shadow frame. Must run AFTER `seedParams`: the frame pointer
    /// is built with `lea rcx` and `rcx` is also `intArgReg(0)`, so building the
    /// frame before spilling the incoming args would clobber arg 0.
    fn pushShadow() {
        if (this.plan.shadowed) {
            this.cb.leaRbp(1, this.plan.shadowBytes)
            this.cb.movabsReloc(10, "pickle_shadow_push")
            this.cb.u8(0x41)
            this.cb.u8(0xFF)
            this.cb.u8(0xD2)
        }
    }

    fn popShadow() {
        if (this.plan.shadowed) {
            this.cb.leaRbp(1, this.plan.shadowBytes)
            this.cb.movabsReloc(10, "pickle_shadow_pop")
            this.cb.u8(0x41)
            this.cb.u8(0xFF)
            this.cb.u8(0xD2)
        }
    }

    /// Report a throw that escaped the program. A no-op on every path out of a
    /// function that is not the entry point.
    ///
    /// This is deliberately *not* in the IR. The native emitter leaves the same
    /// job to the host, which calls `take_escaped_exception()` once
    /// `Program::run` returns; keeping the decision out of the IR is what keeps
    /// the self-host emitter byte-identical to the native one. A self-host
    /// module is its own host, so the backend puts the check on the entry
    /// function's returns instead, and the runtime is what actually consumes the
    /// flag and renders the payload.
    ///
    /// Emitted before the frame is torn down, so the shadow frame is still live
    /// if reporting ever reaches an allocation, and before the return value is
    /// loaded into `rax`, which the call would otherwise clobber. Only the
    /// entry function's `Return` can carry an escape: a throw propagates out of
    /// an ordinary function as a plain return, and its caller checks the flag.
    fn emitEscapedCheck() {
        if (!(this.fun.symbol == ENTRY_SYMBOL)) {
            return
        }
        this.cb.movabsReloc(10, EXC_UNCAUGHT)
        this.cb.u8(0x41)
        this.cb.u8(0xFF)
        this.cb.u8(0xD2)
    }

    fn seedParams() {
        var i = 0
        while (i < len(this.fun.params)) {
            let t = this.fun.params[i].ty
            if (isFloatTy(t)) {
                if (this.plan.floatSlotReg.has(i)) {
                    // The parameter's home is an XMM register for the whole
                    // body; move the incoming argument straight into the pin.
                    let xr = this.plan.floatSlotReg[i]
                    if (i < 4) {
                        if (xr != i) {
                            this.cb.movsdRR(xr, i)
                        }
                    } else {
                        let disp = 48 + 8 * (i - 4)
                        this.cb.ld(11, 64, 0 - disp)
                        this.cb.movqXmmR11(xr)
                    }
                } else {
                    let k = this.kOfSlot(i)
                    if (i < 4) {
                        this.cb.stsd(i, k)
                    } else {
                        let disp = 48 + 8 * (i - 4)
                        this.cb.ld(0, 64, 0 - disp)
                        this.cb.st(0, 64, k)
                    }
                }
            } else if (this.plan.slotReg.has(i)) {
                // The parameter's home is a pinned register for the whole body.
                let rg = this.plan.slotReg[i]
                if (i < 4) {
                    this.cb.movRR(rg, intArgReg(i), tyWidth(t))
                } else {
                    let disp = 48 + 8 * (i - 4)
                    this.cb.ld(rg, 64, 0 - disp)
                }
            } else {
                let k = this.kOfSlot(i)
                if (i < 4) {
                    this.cb.st(intArgReg(i), tyWidth(t), k)
                } else {
                    let disp = 48 + 8 * (i - 4)
                    this.cb.ld(0, 64, 0 - disp)
                    this.cb.st(0, tyWidth(t), k)
                }
            }
            i = i + 1
        }
    }

    fn emitConst(d: int, c: IrConst) {
        // Scalar constants are rematerialised at each use, so they define
        // nothing and take no space in the frame.
        if (this.plan.constVals.has(d)) {
            return
        }
        let k = this.kOfTemp(d)
        match (c) {
            case IrConst.Int(v) -> {
                this.cb.movabsImm(0, v)
                this.cb.st(0, 64, k)
            }
            case IrConst.Float(v) -> {
                this.dropFxReg(0)
                this.cb.movabsImm(0, f64ToBits(v))
                this.cb.u8(0x66)
                this.cb.u8(0x48)
                this.cb.u8(0x0F)
                this.cb.u8(0x6E)
                this.cb.u8(0xC0)
                this.cb.stsd(0, k)
                this.setFx(0, d)
            }
            case IrConst.Bool(b) -> {
                var v = 0
                if (b) {
                    v = 1
                }
                this.cb.stImm(0, 8, k, v)
            }
            case IrConst.Char(v) -> {
                this.cb.stImm(0, 32, k, v as int)
            }
            case IrConst.Null -> {
                this.cb.movabsImm(0, 0)
                this.cb.st(0, 64, k)
            }
            case IrConst.Str(id) -> {
                // Static descriptor emitted into `.rdata` by compiler/coff.pkl:
                // header + bytes with the same layout `newStr` produces, so a
                // literal costs one address load instead of an allocation and a
                // copy. Literals are immutable; `pickle_str_set` copies.
                this.cb.movabsReloc(0, "pkl_strdesc_" + str(id))
                this.cb.st(0, 64, k)
            }
            case IrConst.StrAddr(id) -> {
                this.cb.movabsReloc(0, "pkl_strdata_" + str(id))
                this.cb.st(0, 64, k)
            }
            case IrConst.FuncAddr(id) -> {
                this.cb.movabsReloc(0, funcSymbolOf(this.m, id))
                this.cb.st(0, 64, k)
            }
        }
    }

    fn emitUnOp(d: int, op: IrUnOp, v: int) {
        let kd = this.kOfTemp(d)
        match (op) {
            case IrUnOp.Neg -> {
                if (isFloatTy(this.typeOfT(v))) {
                    this.loadTmpFloat(0, v)
                    this.dropFxReg(1)
                    this.cb.movabsImm(0, i64MinBits())
                    this.cb.u8(0x66)
                    this.cb.u8(0x48)
                    this.cb.u8(0x0F)
                    this.cb.u8(0x6E)
                    this.cb.u8(0xC8)
                    this.cb.u8(0x66)
                    this.cb.u8(0x0F)
                    this.cb.u8(0x57)
                    this.cb.u8(0xC1)
                    this.cb.stsd(0, kd)
                    this.setFx(0, d)
                } else {
                    let w = tyWidth(this.typeOfT(v))
                    this.loadTmp(0, w, v)
                    if (w == 64) {
                        this.cb.u8(0x48)
                    }
                    this.cb.u8(0xF7)
                    this.cb.u8(0xD8)
                    this.putRes(d, w, kd)
                }
            }
            case IrUnOp.Not -> {
                this.loadTmp(0, 8, v)
                this.cb.u8(0x84)
                this.cb.u8(0xC0)
                this.cb.setcc(0x04)
                this.putRes(d, 8, kd)
            }
            case IrUnOp.BitNot -> {
                let w = tyWidth(this.typeOfT(v))
                this.loadTmp(0, w, v)
                if (w == 64) {
                    this.cb.u8(0x48)
                    this.cb.u8(0xF7)
                    this.cb.u8(0xD0)
                } else if (w == 32) {
                    this.cb.u8(0xF7)
                    this.cb.u8(0xD0)
                } else {
                    this.cb.u8(0xF6)
                    this.cb.u8(0xD0)
                }
                this.putRes(d, w, kd)
            }
        }
    }

    fn floatCmpSeq(op: IrBinOp) {
        this.rcxT = 0 - 1
        this.rcxW = 0
        this.cb.u8(0x66)
        this.cb.u8(0x0F)
        this.cb.u8(0x2E)
        this.cb.u8(0xC1)
        match (op) {
            case IrBinOp.Eq -> {
                this.cb.setcc(0x04)
                this.cb.setccCl(0x0B)
                this.cb.u8(0x20)
                this.cb.u8(0xC8)
            }
            case IrBinOp.Ne -> {
                this.cb.setcc(0x05)
                this.cb.setccCl(0x0A)
                this.cb.u8(0x08)
                this.cb.u8(0xC8)
            }
            case IrBinOp.Lt -> {
                this.cb.setcc(0x02)
                this.cb.setccCl(0x0B)
                this.cb.u8(0x20)
                this.cb.u8(0xC8)
            }
            case IrBinOp.Le -> {
                this.cb.setcc(0x06)
                this.cb.setccCl(0x0B)
                this.cb.u8(0x20)
                this.cb.u8(0xC8)
            }
            case IrBinOp.Gt -> {
                this.cb.setcc(0x07)
            }
            case IrBinOp.Ge -> {
                this.cb.setcc(0x03)
            }
            case _ -> {}
        }
    }

    fn intSetcc(cc: int) {
        this.cb.u8(0x0F)
        this.cb.u8(0x90 + cc)
        this.cb.u8(0xC0)
    }

    fn intCmpCc(op: IrBinOp) -> int {
        match (op) {
            case IrBinOp.Eq -> 0x04
            case IrBinOp.Ne -> 0x05
            case IrBinOp.Lt -> 0x0C
            case IrBinOp.Le -> 0x0E
            case IrBinOp.Gt -> 0x0F
            case IrBinOp.Ge -> 0x0D
            case _ -> 0x04
        }
    }

    fn emitBinOp(d: int, op: IrBinOp, a: int, b: int) {
        let ta = this.typeOfT(a)
        let kd = this.kOfTemp(d)
        if (isFloatTy(ta)) {
            if (op == IrBinOp.Mod) {
                // `pickle_fmod` is a call: it may read every XMM register as
                // scratch, so drop the copy cache before loading the operands.
                this.dropFx()
                this.loadTmpFloat(0, a)
                this.loadTmpFloat(1, b)
                this.cb.movabsReloc(10, "pickle_fmod")
                this.cb.u8(0x41)
                this.cb.u8(0xFF)
                this.cb.u8(0xD2)
                this.clobberRcx()
                // The call clobbers rcx: drop the forwarding cache so a later
                // consumer cannot read the result through a dead register.
                this.dropFx()
                this.cb.stsd(0, kd)
                this.setFx(0, d)
            } else if (isCmp(op)) {
                this.loadTmpFloat(0, a)
                this.loadTmpFloat(1, b)
                this.floatCmpSeq(op)
                this.putRes(d, 8, kd)
            } else {
                // `b` may already be the tracked value in xmm0 (the divisor
                // `itof` just produced, for instance). Park it in xmm1 before
                // `a` claims xmm0; overwriting xmm1 is safe because its home is
                // always current.
                if (b != a && this.fx0 == b) {
                    this.cb.movsdRR(1, 0)
                    this.fx1 = b
                    this.fx0 = 0 - 1
                }
                this.loadTmpFloat(0, a)
                this.loadTmpFloat(1, b)
                match (op) {
                    case IrBinOp.Add -> {
                        this.cb.u8(0xF2)
                        this.cb.u8(0x0F)
                        this.cb.u8(0x58)
                        this.cb.u8(0xC1)
                    }
                    case IrBinOp.Sub -> {
                        this.cb.u8(0xF2)
                        this.cb.u8(0x0F)
                        this.cb.u8(0x5C)
                        this.cb.u8(0xC1)
                    }
                    case IrBinOp.Mul -> {
                        this.cb.u8(0xF2)
                        this.cb.u8(0x0F)
                        this.cb.u8(0x59)
                        this.cb.u8(0xC1)
                    }
                    case IrBinOp.Div -> {
                        this.cb.u8(0xF2)
                        this.cb.u8(0x0F)
                        this.cb.u8(0x5E)
                        this.cb.u8(0xC1)
                    }
                    case _ -> this.fail("bad float binop")
                }
                this.cb.stsd(0, kd)
                this.setFx(0, d)
            }
        } else {
            let w = tyWidth(ta)
            // Put a constant on the right so it can fold into the immediate
            // field. Only commutative operators may be reordered.
            var aa = a
            var bb = b
            if (!this.plan.constVals.has(bb) && this.plan.constVals.has(aa) && binOpCommutes(op)) {
                aa = b
                bb = a
            }
            // A deferred operand-b is still in rax. Park it in rcx before the
            // next load overwrites rax; `loadTmp(1, ..., bb)` then serves the
            // value straight from rcx instead of its stack home. Keeping rax's
            // forwarding entry also covers `aa == bb`.
            if (this.pendT == bb && this.pendW == w) {
                this.cb.movRR(1, 0, w)
                this.rcxT = bb
                this.rcxW = w
                this.raxT = bb
                this.raxW = w
                this.pendT = 0 - 1
            }
            // Signed `x / c` and `x % c` for a power-of-two `c`: hardware
            // `idiv` costs 20-40 cycles, while the correction below is 4-5 ALU
            // ops. `shr rdx, 64-k` turns the sign fill (-1/0) into the `c-1`
            // bias truncating division needs for negatives. `c == 1` is not
            // expressible this way (a 64-bit shift count masks to 0), so it is
            // peeled off first.
            if ((op == IrBinOp.Div || op == IrBinOp.Mod) && w == 64 && this.plan.constVals.has(bb)) {
                let cv = this.plan.constVals[bb]
                if (cv > 0 && cv <= 2147483648 && (cv & (cv - 1)) == 0) {
                    if (cv == 1) {
                        if (op == IrBinOp.Div) {
                            this.loadTmp(0, 64, aa)
                        } else {
                            this.cb.movabsImm(0, 0)
                        }
                    } else {
                        var k = 0
                        var p = 1
                        while (p < cv) {
                            p = p * 2
                            k = k + 1
                        }
                        this.loadTmp(0, 64, aa)
                        // rdx = x < 0 ? (c - 1) : 0
                        this.cb.u8(0x48)
                        this.cb.u8(0x89)
                        this.cb.u8(0xC2)
                        this.cb.u8(0x48)
                        this.cb.u8(0xC1)
                        this.cb.u8(0xFA)
                        this.cb.u8(63)
                        this.cb.u8(0x48)
                        this.cb.u8(0xC1)
                        this.cb.u8(0xEA)
                        this.cb.u8(64 - k)
                        this.cb.u8(0x48)
                        this.cb.u8(0x01)
                        this.cb.u8(0xD0)
                        if (op == IrBinOp.Mod) {
                            this.cb.u8(0x48)
                            this.cb.u8(0x25)
                            this.cb.u32le(cv - 1)
                            this.cb.u8(0x48)
                            this.cb.u8(0x29)
                            this.cb.u8(0xD0)
                        } else {
                            this.cb.u8(0x48)
                            this.cb.u8(0xC1)
                            this.cb.u8(0xF8)
                            this.cb.u8(k)
                        }
                    }
                    this.putRes(d, 64, kd)
                    return
                }
                // Non-power-of-two positive divisors: signed magic-number
                // multiply. `u = |x|` is unsigned (2^63 at INT64_MIN), the
                // quotient is `mulhi(u, M) >> s`, and division reapplies the
                // sign while modulo recomputes `u - q*c`. This replaces a
                // 20-40 cycle `idiv` with a multiply and a few ALU ops.
                if (cv > 1 && cv <= 2147483647) {
                    match (magicDivConst(cv)) {
                        case some(ms) -> {
                            let mag = ms[0]
                            let sh = ms[1]
                            this.loadTmp(0, 64, aa)
                            // r9 = x < 0 ? -1 : 0
                            this.cb.movRR(9, 0, 64)
                            this.cb.u8(0x49)
                            this.cb.u8(0xC1)
                            this.cb.u8(0xF9)
                            this.cb.u8(63)
                            // rax = u = |x|
                            this.cb.u8(0x4C)
                            this.cb.u8(0x31)
                            this.cb.u8(0xC8)
                            this.cb.u8(0x4C)
                            this.cb.u8(0x29)
                            this.cb.u8(0xC8)
                            // r10 keeps u for the modulo's `u - q*c`
                            this.cb.movRR(10, 0, 64)
                            // rdx = mulhi(u, M)
                            this.cb.movabsImm(11, mag)
                            this.cb.u8(0x49)
                            this.cb.u8(0xF7)
                            this.cb.u8(0xE3)
                            if (sh > 0) {
                                this.cb.u8(0x48)
                                this.cb.u8(0xC1)
                                this.cb.u8(0xEA)
                                this.cb.u8(sh)
                            }
                            if (op == IrBinOp.Div) {
                                // rdx = sign ? -q : q
                                this.cb.u8(0x4C)
                                this.cb.u8(0x31)
                                this.cb.u8(0xCA)
                                this.cb.u8(0x4C)
                                this.cb.u8(0x29)
                                this.cb.u8(0xCA)
                                this.cb.movRR(0, 2, 64)
                            } else {
                                // rax = u - q*c, then reapply the sign
                                this.cb.u8(0x4C)
                                this.cb.u8(0x69)
                                this.cb.u8(0xDA)
                                this.cb.u32le(cv)
                                this.cb.movRR(0, 10, 64)
                                this.cb.u8(0x4C)
                                this.cb.u8(0x29)
                                this.cb.u8(0xD8)
                                this.cb.u8(0x4C)
                                this.cb.u8(0x31)
                                this.cb.u8(0xC8)
                                this.cb.u8(0x4C)
                                this.cb.u8(0x29)
                                this.cb.u8(0xC8)
                            }
                            this.putRes(d, 64, kd)
                            return
                        }
                        case none -> { }
                    }
                }
            }
            let immOp = this.constFits32(bb) && (w == 32 || w == 64)
            && !(op == IrBinOp.Div || op == IrBinOp.Mod)
            if (immOp) {
                let cv = this.plan.constVals[bb]
                this.loadTmp(0, w, aa)
                if (isCmp(op)) {
                    if (w == 64) {
                        this.cb.u8(0x48)
                    }
                    this.cb.u8(0x3D)
                    this.cb.u32le(cv & 0xFFFFFFFF)
                    this.intSetcc(this.intCmpCc(op))
                    this.putRes(d, 8, kd)
                } else if (op == IrBinOp.Shl || op == IrBinOp.Shr) {
                    if (w == 64) {
                        this.cb.u8(0x48)
                    }
                    this.cb.u8(0xC1)
                    if (op == IrBinOp.Shl) {
                        this.cb.u8(0xE0)
                    } else {
                        this.cb.u8(0xF8)
                    }
                    this.cb.u8(cv & 0xFF)
                    this.putRes(d, 64, kd)
                } else if (op == IrBinOp.Mul) {
                    if (w == 64) {
                        this.cb.u8(0x48)
                    }
                    this.cb.u8(0x69)
                    this.cb.u8(0xC0)
                    this.cb.u32le(cv & 0xFFFFFFFF)
                    this.putRes(d, w, kd)
                } else if (op == IrBinOp.Add || op == IrBinOp.Sub || op == IrBinOp.BitAnd
                    || op == IrBinOp.BitOr || op == IrBinOp.BitXor) {
                    // `add/sub/and/or/xor rax, imm32`
                    if (w == 64) {
                        this.cb.u8(0x48)
                    }
                    this.cb.u8(immGroupOpcode(op))
                    this.cb.u32le(cv & 0xFFFFFFFF)
                    this.putRes(d, w, kd)
                    } else {
                    this.fail("bad int immediate binop")
                    }
            } else {
                this.loadTmp(0, w, aa)
                this.loadTmp(1, w, bb)
                if (isCmp(op)) {
                    if (w == 8) {
                        this.cb.u8(0x38)
                        this.cb.u8(0xC8)
                    } else if (w == 32) {
                        this.cb.u8(0x39)
                        this.cb.u8(0xC8)
                    } else {
                        this.cb.u8(0x48)
                        this.cb.u8(0x39)
                        this.cb.u8(0xC8)
                    }
                    this.intSetcc(this.intCmpCc(op))
                    this.putRes(d, 8, kd)
                } else if (op == IrBinOp.Div || op == IrBinOp.Mod) {
                    this.cb.u8(0x48)
                    this.cb.u8(0x99)
                    this.cb.u8(0x48)
                    this.cb.u8(0xF7)
                    this.cb.u8(0xF9)
                    if (op == IrBinOp.Mod) {
                        this.cb.u8(0x48)
                        this.cb.u8(0x89)
                        this.cb.u8(0xD0)
                    }
                    this.putRes(d, 64, kd)
                } else if (op == IrBinOp.Shl || op == IrBinOp.Shr) {
                    if (w == 64) {
                        this.cb.u8(0x48)
                    }
                    this.cb.u8(0xD3)
                    if (op == IrBinOp.Shl) {
                        this.cb.u8(0xE0)
                    } else {
                        this.cb.u8(0xF8)
                    }
                    this.putRes(d, 64, kd)
                } else {
                    match (op) {
                        case IrBinOp.Add -> {
                            if (w == 64) {
                                this.cb.u8(0x48)
                            }
                            this.cb.u8(0x01)
                            this.cb.u8(0xC8)
                        }
                        case IrBinOp.Sub -> {
                            if (w == 64) {
                                this.cb.u8(0x48)
                            }
                            this.cb.u8(0x29)
                            this.cb.u8(0xC8)
                        }
                        case IrBinOp.Mul -> {
                            if (w == 64) {
                                this.cb.u8(0x48)
                            }
                            this.cb.u8(0x0F)
                            this.cb.u8(0xAF)
                            this.cb.u8(0xC1)
                        }
                        case IrBinOp.BitAnd -> {
                            if (w == 64) {
                                this.cb.u8(0x48)
                            }
                            this.cb.u8(0x21)
                            this.cb.u8(0xC8)
                        }
                        case IrBinOp.BitOr -> {
                            if (w == 64) {
                                this.cb.u8(0x48)
                            }
                            this.cb.u8(0x09)
                            this.cb.u8(0xC8)
                        }
                        case IrBinOp.BitXor -> {
                            if (w == 64) {
                                this.cb.u8(0x48)
                            }
                            this.cb.u8(0x31)
                            this.cb.u8(0xC8)
                        }
                        case _ -> this.fail("bad int binop")
                    }
                    this.putRes(d, w, kd)
                }
            }
        }
    }

    fn emitFtoi(d: int, v: int) {
        let kd = this.kOfTemp(d)
        this.loadTmpFloat(0, v)
        // The overflow branches materialise their constants in xmm1..xmm2.
        this.dropFxReg(1)
        this.cb.u8(0x66)
        this.cb.u8(0x0F)
        this.cb.u8(0x2E)
        this.cb.u8(0xC0)
        var fnan = this.cb.size()
        this.cb.u8(0x7A)
        this.cb.u8(0x00)
        this.rcxT = 0 - 1
        this.rcxW = 0
        this.cb.movabsImm(1, 0x43E0000000000000)
        this.cb.u8(0x66)
        this.cb.u8(0x48)
        this.cb.u8(0x0F)
        this.cb.u8(0x6E)
        this.cb.u8(0xC9)
        this.cb.u8(0x66)
        this.cb.u8(0x0F)
        this.cb.u8(0x2E)
        this.cb.u8(0xC1)
        var fbig = this.cb.size()
        this.cb.u8(0x73)
        this.cb.u8(0x00)
        this.cb.movabsImm(1, negTwo63Bits())
        // Reuse xmm1, the same scratch the 2^63 constant used. xmm2..xmm5
        // may hold live float pins, and this is not a call that justifies
        // clobbering one.
        this.cb.u8(0x66)
        this.cb.u8(0x48)
        this.cb.u8(0x0F)
        this.cb.u8(0x6E)
        this.cb.u8(0xC9)
        this.cb.u8(0x66)
        this.cb.u8(0x0F)
        this.cb.u8(0x2E)
        this.cb.u8(0xC1)
        var fsmall = this.cb.size()
        this.cb.u8(0x72)
        this.cb.u8(0x00)
        this.cb.u8(0xF2)
        this.cb.u8(0x48)
        this.cb.u8(0x0F)
        this.cb.u8(0x2C)
        this.cb.u8(0xC0)
        var fdj = this.cb.size()
        this.cb.u8(0xEB)
        this.cb.u8(0x00)
        var offNan = this.cb.size()
        this.cb.u8(0x48)
        this.cb.u8(0x31)
        this.cb.u8(0xC0)
        var fnj = this.cb.size()
        this.cb.u8(0xEB)
        this.cb.u8(0x00)
        var offBig = this.cb.size()
        this.cb.movabsImm(0, 0x7FFFFFFFFFFFFFFF)
        var fbj = this.cb.size()
        this.cb.u8(0xEB)
        this.cb.u8(0x00)
        var offSmall = this.cb.size()
        this.cb.movabsImm(0, i64MinBits())
        var offDone = this.cb.size()
        this.cb.bytes[fnan + 1] = (offNan - (fnan + 2)) & 0xFF
        this.cb.bytes[fbig + 1] = (offBig - (fbig + 2)) & 0xFF
        this.cb.bytes[fsmall + 1] = (offSmall - (fsmall + 2)) & 0xFF
        this.cb.bytes[fdj + 1] = (offDone - (fdj + 2)) & 0xFF
        this.cb.bytes[fnj + 1] = (offDone - (fnj + 2)) & 0xFF
        this.cb.bytes[fbj + 1] = (offDone - (fbj + 2)) & 0xFF
        this.putRes(d, 64, kd)
    }

    fn emitMem(op: IrInstr) {
        match (op) {
            case IrInstr.LoadSlot(d, s) -> {
                let w = tyWidth(this.fun.slots[s])
                if (this.plan.floatSlotReg.has(s)) {
                    // Same no-copy rule as an int pin: consumers read the XMM
                    // pin until a store to the slot overwrites it.
                    this.aliasXmm[d] = this.plan.floatSlotReg[s]
                    this.aliasXSlot[d] = s
                } else if (this.plan.slotReg.has(s)) {
                    // No copy: consumers read the pin register until a store to
                    // the slot invalidates the alias.
                    this.aliasReg[d] = this.plan.slotReg[s]
                    this.aliasSlot[d] = s
                    this.aliasW[d] = w
                } else {
                    this.cb.ld(0, w, this.kOfSlot(s))
                    this.putRes(d, w, this.kOfTemp(d))
                }
            }
            case IrInstr.StoreSlot(s, v) -> {
                let w = tyWidth(this.fun.slots[s])
                if (this.plan.floatSlotReg.has(s)) {
                    // Spill aliases of the old value before the pin changes,
                    // then move the new value into the pin.
                    this.flushXSlotAliases(s)
                    this.loadTmpFloat(this.plan.floatSlotReg[s], v)
                } else if (this.plan.slotReg.has(s)) {
                    // Writing the register invalidates every alias of the old
                    // value; spill them before the move lands.
                    this.flushSlotAliases(s, v)
                    this.loadTmp(this.plan.slotReg[s], w, v)
                } else if (isFloatTy(this.fun.slots[s]) && isFloatTy(this.typeOfT(v))) {
                    // A float slot is 8 bytes: one SSE store, no GPR round trip.
                    this.loadTmpFloat(0, v)
                    this.cb.stsd(0, this.kOfSlot(s))
                } else {
                    let kh = this.kOfSlot(s)
                    this.loadTmp(0, w, v)
                    this.cb.st(0, w, kh)
                }
            }
            case IrInstr.LocalAddr(d, s) -> {
                this.cb.leaRbp(0, this.kOfSlot(s))
                this.putRes(d, 64, this.kOfTemp(d))
            }
            case IrInstr.LoadRaw(d, addr, ty) -> {
                this.loadTmp(0, 64, addr)
                let kd = this.kOfTemp(d)
                if (isFloatTy(ty)) {
                    this.dropFxReg(0)
                    this.cb.u8(0xF2)
                    this.cb.u8(0x0F)
                    this.cb.u8(0x10)
                    this.cb.u8(0x00)
                    this.cb.stsd(0, kd)
                    this.setFx(0, d)
                } else {
                    let w = tyWidth(ty)
                    if (w == 64) {
                        this.cb.u8(0x48)
                    }
                    if (w == 8) {
                        this.cb.u8(0x8A)
                    } else {
                        this.cb.u8(0x8B)
                    }
                    this.cb.u8(0x00)
                    this.putRes(d, w, kd)
                }
            }
            case IrInstr.StoreRaw(addr, v, ty) -> {
                this.loadTmp(1, 64, addr)
                if (isFloatTy(ty)) {
                    this.loadTmpFloat(0, v)
                    this.cb.u8(0xF2)
                    this.cb.u8(0x0F)
                    this.cb.u8(0x11)
                    this.cb.u8(0x01)
                } else {
                    let w = tyWidth(ty)
                    this.loadTmp(0, w, v)
                    if (w == 64) {
                        this.cb.u8(0x48)
                    }
                    if (w == 8) {
                        this.cb.u8(0x88)
                    } else {
                        this.cb.u8(0x89)
                    }
                    this.cb.u8(0x01)
                }
            }
            case _ -> {}
        }
    }

    /// `pickle_list_get(list, index)` inlined: signed bounds check, then the
    /// element load. Mirrors `abiListGet` exactly - including a negative index
    /// reading below `data`, which the compiler's static bounds checks make
    /// unreachable but the runtime body would do.
    fn emitInlineListGet(d: int, listT: int, indexT: int) {
        this.loadTmp(1, 64, listT)
        this.loadTmp(2, 64, indexT)
        // rax = list[LEN_WORD] (24); if (index >= len) -> null.
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(24)
        this.cb.u8(0x48)
        this.cb.u8(0x39)
        this.cb.u8(0xC2)
        this.cb.u8(0x7D)
        this.cb.u8(0x0A)
        // rax = ((*int) list[DATA_WORD])[index]
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(40)
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x04)
        this.cb.u8(0xD0)
        this.cb.u8(0xEB)
        this.cb.u8(0x02)
        // null:
        this.cb.u8(0x31)
        this.cb.u8(0xC0)
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// `pickle_list_set(list, index, value)` inlined. The runtime only rejects
    /// indexes at or above the list length; retain its signed comparison so a
    /// negative index has the same compiler-guarded behavior as the ABI call.
    /// The store cannot allocate or collect, so publishing the already-rooted
    /// value directly into the existing element span is safe.
    fn emitInlineListSet(listT: int, indexT: int, valT: int) {
        this.loadTmp(1, 64, listT)
        this.loadTmp(2, 64, indexT)
        this.loadTmp(8, 64, valT)
        // rax = list[LEN_WORD] (24); if (index >= len), return.
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(24)
        this.cb.u8(0x48)
        this.cb.u8(0x39)
        this.cb.u8(0xC2)
        this.cb.u8(0x7D)
        this.cb.u8(0x08)
        // rax = list[DATA_WORD] (40); data[index] = value.
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(40)
        this.cb.u8(0x4C)
        this.cb.u8(0x89)
        this.cb.u8(0x04)
        this.cb.u8(0xD0)
    }

    /// `pickle_list_push(list, value)`'s append fast path, inlined. The runtime
    /// body is two calls deep (`abiListPush` -> `requireCapacity`, each with
    /// its own GC shadow frame), and a pipeline's output list is usually
    /// preallocated to the receiver's length, so that frame cost is paid per
    /// element to do one store and one increment.
    ///
    /// The fast path is the whole runtime body when `len < cap`: read the
    /// element span, store, bump `len`. A full list falls back to the real
    /// entry point with both arguments still in rcx/rdx, so growth, the
    /// capacity floor, and the raw-span allocation stay in one place.
    ///
    /// No collection can run between the load of `len` and the store, so the
    /// list and the value are as rooted as they were at the call site, and the
    /// element is published before `len` makes it visible to the tracer. The
    /// receiver and value are already managed homes (or freshly registered
    /// boxes), exactly as the call's arguments were.
    fn emitInlineListPush(listT: int, valT: int) {
        this.loadTmp(1, 64, listT)
        this.loadTmp(2, 64, valT)
        let slow = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // rax = list[LEN_WORD] (24); r8 = list[CAP_WORD] (32).
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(24)
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(32)
        // cmp rax, r8; jae slow - unsigned, so a full list takes the growth
        // path and no other value can pass.
        this.cb.u8(0x4C)
        this.cb.u8(0x39)
        this.cb.u8(0xC0)
        this.emitJcc(0x03, slow)
        // r9 = list[DATA_WORD] (40); data[len] = value; len = len + 1.
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0x49)
        this.cb.u8(40)
        this.cb.u8(0x49)
        this.cb.u8(0x89)
        this.cb.u8(0x14)
        this.cb.u8(0xC1)
        this.cb.u8(0x48)
        this.cb.u8(0xFF)
        this.cb.u8(0xC0)
        this.cb.u8(0x48)
        this.cb.u8(0x89)
        this.cb.u8(0x41)
        this.cb.u8(24)
        this.emitJmp(done)
        this.starts[slow] = this.cb.size()
        this.cb.movabsReloc(10, "pickle_list_push")
        this.cb.u8(0x41)
        this.cb.u8(0xFF)
        this.cb.u8(0xD2)
        this.starts[done] = this.cb.size()
        this.clobberRcx()
    }

    /// `pickle_obj_slot_get(obj, slot)` inlined for a constant, non-negative
    /// slot. Mirrors `abiObjSlotGet`: a null object answers null, and the bound
    /// is `(size - 32) / 8` derived from the object's own stored size. The
    /// runtime treats a size below `HEADER + 8` as -1, so every non-negative
    /// slot is out of range there; a signed shift also leaves the bound
    /// negative for every 8-aligned size below 32, which is the only shape the
    /// allocator can store. Reading `slots` and the payload word is otherwise
    /// exactly the two loads the runtime body performs.
    ///
    /// Every class field site in the front end passes `intConst`, so the index
    /// never needs a register; the caller falls back to the real entry point
    /// for a non-constant or wide index.
    fn emitInlineObjSlotGet(d: int, objT: int, slot: int) {
        this.loadTmp(1, 64, objT)
        let nullL = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // test rcx, rcx; je null
        this.cb.u8(0x48)
        this.cb.u8(0x85)
        this.cb.u8(0xC9)
        this.emitJcc(0x04, nullL)
        // rax = obj.size (word 2, byte 16)
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(16)
        // The runtime bound is `slot > (size - 32) / 8`. For an integer slot
        // that is exactly `size < 32 + 8*slot`, which also covers every size
        // below HEADER + 8 (where the runtime returns -1) without the
        // subtract and shift.
        // cmp rax, 32 + 8*slot; jl null
        this.cb.u8(0x48)
        this.cb.u8(0x3D)
        this.cb.u32le(32 + 8 * slot)
        this.emitJcc(0x0C, nullL)
        // rax = obj.slots[slot] (byte 24 + 8*slot)
        let disp = 24 + 8 * slot
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        if (disp <= 127) {
            this.cb.u8(0x41)
            this.cb.u8(disp)
        } else {
            this.cb.u8(0x81)
            this.cb.u32le(disp)
        }
        this.emitJmp(done)
        this.starts[nullL] = this.cb.size()
        // xor eax, eax
        this.cb.u8(0x31)
        this.cb.u8(0xC0)
        this.starts[done] = this.cb.size()
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// `pickle_obj_slot_set(obj, slot, value)` inlined for a constant,
    /// non-negative slot. Same null and `(size - 32) >> 3` guard as the getter;
    /// an out-of-range write is a silent no-op, exactly like `abiObjSlotSet`.
    fn emitInlineObjSlotSet(objT: int, slot: int, valT: int) {
        this.loadTmp(1, 64, objT)
        this.loadTmp(2, 64, valT)
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // test rcx, rcx; je done
        this.cb.u8(0x48)
        this.cb.u8(0x85)
        this.cb.u8(0xC9)
        this.emitJcc(0x04, done)
        // rax = obj.size
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(16)
        // `slot > (size - 32) / 8` is exactly `size < 32 + 8*slot` for an
        // integer slot, and a size below HEADER + 8 leaves the bound negative
        // either way, so the subtract and shift fold away.
        // cmp rax, 32 + 8*slot; jl done
        this.cb.u8(0x48)
        this.cb.u8(0x3D)
        this.cb.u32le(32 + 8 * slot)
        this.emitJcc(0x0C, done)
        // obj.slots[slot] = rdx
        let disp = 24 + 8 * slot
        this.cb.u8(0x48)
        this.cb.u8(0x89)
        if (disp <= 127) {
            this.cb.u8(0x51)
            this.cb.u8(disp)
        } else {
            this.cb.u8(0x91)
            this.cb.u32le(disp)
        }
        this.starts[done] = this.cb.size()
    }

    /// `pickle_enum_tag(obj)` inlined: the tag is payload word 0, one
    /// unchecked load at byte 24. `abiEnumTag` has no null test either, so a
    /// null object faults at the same place the call did.
    fn emitInlineEnumTag(d: int, objT: int) {
        this.loadTmp(1, 64, objT)
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(24)
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// `pickle_enum_new(tag, count)` inlined for a constant, small field count.
    /// Variant construction is the whole cost of an enum benchmark: the object
    /// is five words, and the two runtime layers (`abiEnumNew` ->
    /// `enumNewAddr`) plus their frames cost more than the allocation they
    /// wrap. The layout is the one `abi_enum.pkl` stamps - `next` 0, class 7
    /// (`PICKLE_CLASS_ENUM`), the byte size, the tag at word 3, then `count`
    /// zeroed payload words at word 4 - and a fresh chunk, an oversized
    /// request or a count this inline does not cover falls back to the real
    /// entry point with both arguments still in place.
    ///
    /// Stamping happens before registration, exactly as in the runtime body:
    /// nothing between the allocation and the register can collect, and the
    /// register itself is the engine's own entry point.
    fn emitInlineEnumNew(d: int, tagT: int, countT: int) {
        let count = this.plan.constVals[countT]
        let size = 32 + 8 * count
        let kd = this.kOfTemp(d)
        let slow = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        this.loadTmp(1, 64, tagT)
        // rdx = used, r8 = cap; r9 = used + size.
        this.cb.movabsReloc(10, "pkl_global_managedArenaUsed")
        this.cb.u8(0x49)
        this.cb.u8(0x8B)
        this.cb.u8(0x12)
        this.cb.movabsReloc(11, "pkl_global_managedArenaCap")
        this.cb.u8(0x4D)
        this.cb.u8(0x8B)
        this.cb.u8(0x03)
        this.cb.u8(0x4C)
        this.cb.u8(0x8D)
        this.cb.u8(0x4A)
        this.cb.u8(size)
        this.cb.u8(0x4D)
        this.cb.u8(0x39)
        this.cb.u8(0xC1)
        this.emitJcc(0x0F, slow)
        // rax = base + used; used = used + size.
        this.cb.movabsReloc(10, "pkl_global_managedArenaBase")
        this.cb.u8(0x49)
        this.cb.u8(0x8B)
        this.cb.u8(0x02)
        this.cb.u8(0x48)
        this.cb.u8(0x01)
        this.cb.u8(0xD0)
        this.cb.movabsReloc(10, "pkl_global_managedArenaUsed")
        this.cb.u8(0x4D)
        this.cb.u8(0x89)
        this.cb.u8(0x0A)
        // Header: next, class, byte size, tag.
        this.cb.u8(0x48)
        this.cb.u8(0xC7)
        this.cb.u8(0x00)
        this.cb.u32le(0)
        this.cb.u8(0x48)
        this.cb.u8(0xC7)
        this.cb.u8(0x40)
        this.cb.u8(8)
        this.cb.u32le(7)
        this.cb.u8(0x48)
        this.cb.u8(0xC7)
        this.cb.u8(0x40)
        this.cb.u8(16)
        this.cb.u32le(size)
        this.cb.u8(0x48)
        this.cb.u8(0x89)
        this.cb.u8(0x48)
        this.cb.u8(24)
        // Payload fields start null so an unset slot is never traced.
        var i = 0
        while (i < count) {
            this.cb.u8(0x48)
            this.cb.u8(0xC7)
            this.cb.u8(0x40)
            this.cb.u8(32 + 8 * i)
            this.cb.u32le(0)
            i = i + 1
        }
        this.cb.st(0, 64, kd)
        this.emitInlineEngineRegister(none, d)
        this.cb.ld(0, 64, kd)
        this.emitJmp(done)
        this.starts[slow] = this.cb.size()
        this.cb.u8(0xBA)
        this.cb.u32le(count)
        this.cb.movabsReloc(10, "pickle_enum_new")
        this.cb.u8(0x41)
        this.cb.u8(0xFF)
        this.cb.u8(0xD2)
        this.clobberRcx()
        this.starts[done] = this.cb.size()
        this.putRes(d, 64, kd)
    }

    /// `pickle_enum_field(obj, index)` inlined for a constant, non-negative
    /// index. Mirrors `abiEnumField`: the count is `(size - 32) / 8` with a
    /// saturating subtract, an index equal to the count is out of range, and
    /// the answer for one is null. No null-object test: the runtime reads the
    /// size word with no test either.
    fn emitInlineEnumField(d: int, objT: int, index: int) {
        this.loadTmp(1, 64, objT)
        let nullL = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // rax = obj.size
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(16)
        // `index >= (size - 32) / 8` is exactly `size < 40 + 8*index`; a size
        // at or below HEADER + 8 yields a count of 0, which the same compare
        // covers.
        // cmp rax, 40 + 8*index; jl null
        this.cb.u8(0x48)
        this.cb.u8(0x3D)
        this.cb.u32le(40 + 8 * index)
        this.emitJcc(0x0C, nullL)
        // rax = obj.fields[index] (byte 32 + 8*index)
        let disp = 32 + 8 * index
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        if (disp <= 127) {
            this.cb.u8(0x41)
            this.cb.u8(disp)
        } else {
            this.cb.u8(0x81)
            this.cb.u32le(disp)
        }
        this.emitJmp(done)
        this.starts[nullL] = this.cb.size()
        this.cb.u8(0x31)
        this.cb.u8(0xC0)
        this.starts[done] = this.cb.size()
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// `pickle_enum_set_field(obj, index, value)` inlined for a constant,
    /// non-negative index. Same count guard as the field read; an index at or
    /// past the count is a silent no-op.
    fn emitInlineEnumSetField(objT: int, index: int, valT: int) {
        this.loadTmp(1, 64, objT)
        this.loadTmp(2, 64, valT)
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // rax = obj.size
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(16)
        // cmp rax, 40 + 8*index; jl done   (index >= count is out of range)
        this.cb.u8(0x48)
        this.cb.u8(0x3D)
        this.cb.u32le(40 + 8 * index)
        this.emitJcc(0x0C, done)
        // obj.fields[index] = rdx
        let disp = 32 + 8 * index
        this.cb.u8(0x48)
        this.cb.u8(0x89)
        if (disp <= 127) {
            this.cb.u8(0x51)
            this.cb.u8(disp)
        } else {
            this.cb.u8(0x91)
            this.cb.u32le(disp)
        }
        this.starts[done] = this.cb.size()
    }

    /// `pickle_list_len` / `pickle_str_len` / `pickle_map_len` inlined: each
    /// reads its object's `len` word at offset 24 (`LEN_WORD` is 3 everywhere).
    fn emitInlineObjLen(d: int, objT: int) {
        this.loadTmp(1, 64, objT)
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(24)
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// `pickle_unbox_i64` / `pickle_unbox_char` inlined: the payload is word 3
    /// of the box, a single unchecked load at offset 24. Both runtime bodies are
    /// exactly that read (`abi_box`'s `boxBits`), so a null pointer faults the
    /// same way the call did.
    fn emitInlineUnbox(d: int, objT: int) {
        this.loadTmp(1, 64, objT)
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(24)
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// `pickle_unbox_f64` inlined: word 3 of a float box is the exact IEEE-754
    /// word `abiBoxF64` stored (`f64Bits(v)`), so loading it as a double is the
    /// same reinterpretation `abiUnboxF64` performs. The runtime body rebuilds
    /// the value field-by-field through `f64FromBits` (sign, exponent, `pow2`
    /// loops); that is bit-exact but costs a call and dozens of instructions per
    /// unbox, and the benchmark's inner loop unboxes `idfs[k]` 288k times.
    ///
    /// The two forms differ only on a NaN payload: `f64FromBits` answers the
    /// canonical quiet NaN, while the load reproduces whatever word was stored.
    /// Every float box is produced by `pickle_box_f64`, which stores the
    /// canonical quiet NaN for any NaN, so the loaded word *is* that canonical
    /// NaN. Even if another word reached the payload, Pickle cannot read a
    /// float's bits (`f64Bits` canonicalises NaN), `==` is false for every NaN,
    /// and the formatter writes `NaN` - so the difference is unobservable.
    fn emitInlineUnboxF64(d: int, objT: int) {
        this.loadTmp(1, 64, objT)
        this.cb.u8(0xF2)
        this.cb.u8(0x0F)
        this.cb.u8(0x10)
        this.cb.u8(0x41)
        this.cb.u8(24)
        this.cb.stsd(0, this.kOfTemp(d))
    }

    /// `pickle_unbox_bool` inlined: `abiUnboxBool` is `boxBits(obj) != 0`, one
    /// payload load and a comparison. The result is materialised as a byte so
    /// it matches the 8-bit representation every Bool temp uses.
    fn emitInlineUnboxBool(d: int, objT: int) {
        this.loadTmp(1, 64, objT)
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(24)
        this.cb.u8(0x48)
        this.cb.u8(0x85)
        this.cb.u8(0xC0)
        this.cb.u8(0x0F)
        this.cb.u8(0x95)
        this.cb.u8(0xC0)
        this.putRes(d, 8, this.kOfTemp(d))
    }

    /// `pickle_box_bool`'s two shared singletons, inlined. After the first use
    /// of each value `abiBoxBool` is a global load and a return; reaching it
    /// through the extern still costs a call and the shadow frame its
    /// allocating first-use path needs. Probe the matching singleton here and
    /// fall back to the real entry point when it is still zero. The argument
    /// stays in rcx for the fallback.
    fn emitInlineBoxBool(d: int, arg: int) {
        this.loadTmp(1, 8, arg)
        let slow = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let isFalse = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let joined = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // test cl, cl; je isFalse
        this.cb.u8(0x84)
        this.cb.u8(0xC9)
        this.emitJcc(0x04, isFalse)
        this.cb.movabsReloc(0, "pkl_global_trueBox")
        this.emitJmp(joined)
        this.starts[isFalse] = this.cb.size()
        this.cb.movabsReloc(0, "pkl_global_falseBox")
        this.starts[joined] = this.cb.size()
        // rax = *slot; a zero singleton is the allocating path.
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x00)
        this.cb.u8(0x48)
        this.cb.u8(0x85)
        this.cb.u8(0xC0)
        this.emitJcc(0x04, slow)
        this.emitJmp(done)
        this.starts[slow] = this.cb.size()
        this.cb.movabsReloc(10, "pickle_box_bool")
        this.cb.u8(0x41)
        this.cb.u8(0xFF)
        this.cb.u8(0xD2)
        this.starts[done] = this.cb.size()
        this.clobberRcx()
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// `pickle_box_i64`'s shared-small-value cache, inlined, with the allocating
    /// tail inlined too. The benchmark's map updates box `0..48` on every
    /// `m[k] = m[k] + 1`, and `abiBoxI64` answers those from `smallBoxTab`
    /// without allocating. Everything else allocates a fresh 32-byte box:
    /// `abiManagedAlloc(32)`, the four-word header/payload stamp, and
    /// `abiEngineRegister`. Both halves are already independent inlines
    /// (`emitInlineManagedAlloc`, `emitInlineEngineRegister`) whose fast paths
    /// need no calls, so the extern call and its prologue are pure overhead.
    ///
    /// Cache hits, fresh boxes, and the cold-table case must stay observably
    /// identical to `abiBoxI64`:
    ///   - a small value is inserted into the table, so two calls share one
    ///     box (`sameObject` and `abi_box_test` pin this);
    ///   - a cold table falls back to the real entry point, which builds and
    ///     zeroes the table and owns that path;
    ///   - values outside `0..4095` are never looked up or inserted.
    ///
    /// Registration can collect; the box is fully stamped and its address sits
    /// in the destination temp's home before that call, exactly as in the
    /// runtime body. The table is not a root, but the value is also reachable
    /// from the destination, so inserting after registration is safe.
    fn emitInlineBoxI64(d: int, arg: int) {
        this.loadTmp(1, 64, arg)
        // The allocating tail and the registration inline clobber rcx/rax/rdx,
        // and `loadTmp` can only rematerialise a *constant* once its forwarding
        // entry is gone. Give a real temp's home its value now, so every later
        // reload of `arg` (stamp payload, table index) is a plain memory read.
        if (!this.plan.constVals.has(arg)) {
            this.cb.st(1, 64, this.kOfTemp(arg))
        }
        let cold = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let big = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // rax = smallBoxTab; a zero table is the cold path.
        this.cb.movabsReloc(0, "pkl_global_smallBoxTab")
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x00)
        this.cb.u8(0x48)
        this.cb.u8(0x85)
        this.cb.u8(0xC0)
        this.emitJcc(0x04, cold)
        // Unsigned compare folds the `v < 0` and `v >= SMALL_BOX_CAP` tests
        // into one branch: a negative value is huge as unsigned. The bound is
        // `runtime.abi_box`'s `SMALL_BOX_CAP`; keep the two in step.
        this.cb.u8(0x48)
        this.cb.u8(0x81)
        this.cb.u8(0xF9)
        this.cb.u32le(4096)
        this.emitJcc(0x03, big)
        // rax = tab[v]. A non-zero entry is a canonical hit; a zero entry is
        // a small-value miss and falls through to the allocating tail.
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x04)
        this.cb.u8(0xC8)
        this.cb.u8(0x48)
        this.cb.u8(0x85)
        this.cb.u8(0xC0)
        this.emitJcc(0x05, done)
        // Small-value miss: allocate, stamp, register, then publish into the
        // table so later calls canonicalise to the same box.
        this.emitInlineManagedAllocConst(d, 32)
        this.loadTmp(0, 64, d)
        this.emitStampIntBox(arg)
        this.cb.st(0, 64, this.kOfTemp(d))
        this.emitInlineEngineRegister(none, d)
        this.cb.ld(0, 64, this.kOfTemp(d))
        this.cb.movabsReloc(8, "pkl_global_smallBoxTab")
        this.cb.u8(0x4D)
        this.cb.u8(0x8B)
        this.cb.u8(0x00)
        this.loadTmp(2, 64, arg)
        this.cb.u8(0x49)
        this.cb.u8(0x89)
        this.cb.u8(0x04)
        this.cb.u8(0xD0)
        this.emitJmp(done)
        // Values outside the cache: allocate, stamp, register, no table entry.
        this.starts[big] = this.cb.size()
        this.emitInlineManagedAllocConst(d, 32)
        this.loadTmp(0, 64, d)
        this.emitStampIntBox(arg)
        this.cb.st(0, 64, this.kOfTemp(d))
        this.emitInlineEngineRegister(none, d)
        this.cb.ld(0, 64, this.kOfTemp(d))
        this.emitJmp(done)
        // Cold table: the runtime builds it, and its path owns the insert.
        this.starts[cold] = this.cb.size()
        this.cb.movabsReloc(10, "pickle_box_i64")
        this.cb.u8(0x41)
        this.cb.u8(0xFF)
        this.cb.u8(0xD2)
        this.starts[done] = this.cb.size()
        this.clobberRcx()
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// Stamp a 32-byte int box at the address already in rax: `next` 0, class
    /// `PICKLE_CLASS_BOX_INT` (3), byte size 32, payload word 3. Same four
    /// stores `abiBoxI64` performs; `arg` is reloaded into rdx because the
    /// allocator used rcx and the register inline clobbers the scratch pair.
    fn emitStampIntBox(arg: int) {
        this.cb.u8(0x48)
        this.cb.u8(0xC7)
        this.cb.u8(0x00)
        this.cb.u32le(0)
        this.cb.u8(0x48)
        this.cb.u8(0xC7)
        this.cb.u8(0x40)
        this.cb.u8(8)
        this.cb.u32le(3)
        this.cb.u8(0x48)
        this.cb.u8(0xC7)
        this.cb.u8(0x40)
        this.cb.u8(16)
        this.cb.u32le(32)
        this.loadTmp(2, 64, arg)
        this.cb.u8(0x48)
        this.cb.u8(0x89)
        this.cb.u8(0x50)
        this.cb.u8(24)
    }

    /// `abiManagedAlloc(size)`'s bump-pointer path, inlined. Every managed
    /// object - box, enum, class instance, list, map, string - reaches this
    /// helper, and the entry prologue the backend gives it (a home for every
    /// temp plus the callee-saved spill pair) costs more than the five
    /// instructions the common path actually needs.
    ///
    /// The fast path is the whole body for a small request: clamp to 8 bytes,
    /// round up, and take the next slice of the current chunk. Anything that
    /// needs a fresh chunk, an oversized request that bypasses the arena, or a
    /// request whose rounded size does not fit falls back to the real entry
    /// point with rcx still holding the original size. `abiManagedAlloc` is a
    /// leaf that never calls into Pickle code, so the inline adds no
    /// collection point the caller did not already have.
    ///
    /// The globals are the ones the runtime body reads; every archive member
    /// that calls this helper embeds the closure that defines them.
    fn emitInlineManagedAlloc(d: int, sizeT: int) {
        this.loadTmp(1, 64, sizeT)
        this.emitInlineManagedAllocBody(d)
    }

    /// Constant-size form of `emitInlineManagedAlloc`: the size goes straight
    /// into rcx, which is where the body and its slow-path fallback expect it.
    fn emitInlineManagedAllocConst(d: int, size: int) {
        // `mov ecx, imm32` zero-extends into rcx; every caller passes a small
        // positive byte size.
        this.cb.u8(0xB9)
        this.cb.u32le(size)
        this.clobberRcx()
        this.emitInlineManagedAllocBody(d)
    }

    /// The allocator body, entered with the requested size in rcx.
    fn emitInlineManagedAllocBody(d: int) {
        let slow = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // Parallel mode costs nothing here. `abiRawSetParallel` zeroes
        // `managedArenaCap` when the process gains its second thread, so the
        // capacity test below fails on every request and the call lands in
        // `abiManagedAlloc`, whose mode branch owns the per-thread arena. The
        // emitted fast path stays byte-identical to the single-thread shape.
        // rax = max(size, 8), rounded up to a multiple of 8. The clamp is a
        // cmov so the tiny-size case costs no branch of its own.
        this.cb.u8(0x48)
        this.cb.u8(0x89)
        this.cb.u8(0xC8)
        this.cb.u8(0xBA)
        this.cb.u32le(8)
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0xF8)
        this.cb.u8(8)
        this.cb.u8(0x48)
        this.cb.u8(0x0F)
        this.cb.u8(0x4C)
        this.cb.u8(0xC2)
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0xC0)
        this.cb.u8(7)
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0xE0)
        this.cb.u8(0xF8)
        // An oversized request goes straight to the heap in the runtime.
        this.cb.u8(0x48)
        this.cb.u8(0x3D)
        this.cb.u32le(262144)
        this.emitJcc(0x0F, slow)
        // rdx = used, r8 = cap; r9 = used + n.
        this.cb.movabsReloc(10, "pkl_global_managedArenaUsed")
        this.cb.u8(0x49)
        this.cb.u8(0x8B)
        this.cb.u8(0x12)
        this.cb.movabsReloc(11, "pkl_global_managedArenaCap")
        this.cb.u8(0x4D)
        this.cb.u8(0x8B)
        this.cb.u8(0x03)
        this.cb.u8(0x4C)
        this.cb.u8(0x8D)
        this.cb.u8(0x0C)
        this.cb.u8(0x02)
        this.cb.u8(0x4D)
        this.cb.u8(0x39)
        this.cb.u8(0xC1)
        this.emitJcc(0x0F, slow)
        // r11 = base + used; used = used + n; rax = the new address.
        this.cb.movabsReloc(11, "pkl_global_managedArenaBase")
        this.cb.u8(0x4D)
        this.cb.u8(0x8B)
        this.cb.u8(0x1B)
        this.cb.u8(0x49)
        this.cb.u8(0x01)
        this.cb.u8(0xD3)
        this.cb.movabsReloc(10, "pkl_global_managedArenaUsed")
        this.cb.u8(0x4D)
        this.cb.u8(0x89)
        this.cb.u8(0x0A)
        this.cb.u8(0x4C)
        this.cb.u8(0x89)
        this.cb.u8(0xD8)
        this.emitJmp(done)
        this.starts[slow] = this.cb.size()
        this.cb.movabsReloc(10, "pkl_abiManagedAlloc")
        this.cb.u8(0x41)
        this.cb.u8(0xFF)
        this.cb.u8(0xD2)
        this.starts[done] = this.cb.size()
        this.clobberRcx()
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// `abiEngineRegister(objAddr)`'s no-collection path, inlined. Registration
    /// is on every managed allocation, and under `PKL_NO_AUTO_GC` the whole
    /// reachable body is "record the address, bump the counters": no pin, no
    /// threshold trigger. Reaching that through the extern pays the entry
    /// prologue and a `geRegObjSize` call for eight instructions of work.
    ///
    /// The fast path requires the environment to be read (so `noAutoGc` is
    /// final) and no automatic collection to be armed. A cold environment, a
    /// live auto-collector (which needs the pin and the trigger) and a
    /// geometric registry growth all fall back to the real entry point with
    /// rcx still holding the object address. The size word is read directly
    /// (word 2, byte 16), exactly as `geRegObjSize` does.
    fn emitInlineEngineRegister(d: int?, objT: int) {
        this.loadTmp(1, 64, objT)
        let slow = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // Null is a no-op, like the runtime's first branch.
        this.cb.u8(0x48)
        this.cb.u8(0x85)
        this.cb.u8(0xC9)
        this.emitJcc(0x04, done)
        // Parallel mode needs no test here either. `abiEngineParallelOn` zeroes
        // `regCap` at the same moment, so the capacity check below fails and
        // the append lands in `abiEngineRegister`, whose mode branch owns the
        // calling thread's private block.
        // `envInited` must be 2 (fully published) and `noAutoGc` must be set.
        // State 1 means another thread is still reading the block, so the
        // registration must take the runtime path and wait for the publish.
        // `jne` is deliberate: `je` would send the fully-published state to the
        // slow path and inline only the uninitialized one.
        this.cb.movabsReloc(0, "pkl_global_envInited")
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0x38)
        this.cb.u8(2)
        this.emitJcc(0x05, slow)
        this.cb.movabsReloc(0, "pkl_global_noAutoGc")
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0x38)
        this.cb.u8(0)
        this.emitJcc(0x04, slow)
        // rdx = object byte size (word 2).
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x51)
        this.cb.u8(16)
        // r8 = regCount; a full registry grows through the real entry point.
        this.cb.movabsReloc(0, "pkl_global_regCount")
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0x00)
        this.cb.movabsReloc(0, "pkl_global_regCap")
        this.cb.u8(0x4C)
        this.cb.u8(0x3B)
        this.cb.u8(0x00)
        this.emitJcc(0x03, slow)
        // regBase[count] = obj.
        this.cb.movabsReloc(0, "pkl_global_regBase")
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x00)
        this.cb.u8(0x4A)
        this.cb.u8(0x89)
        this.cb.u8(0x0C)
        this.cb.u8(0xC0)
        // regCount = count + 1.
        this.cb.movabsReloc(0, "pkl_global_regCount")
        this.cb.u8(0x4D)
        this.cb.u8(0x8D)
        this.cb.u8(0x50)
        this.cb.u8(1)
        this.cb.u8(0x4C)
        this.cb.u8(0x89)
        this.cb.u8(0x10)
        // regBytes += size; rawAllocCount += 1; rawAllocBytes += size.
        this.cb.movabsReloc(0, "pkl_global_regBytes")
        this.cb.u8(0x48)
        this.cb.u8(0x01)
        this.cb.u8(0x10)
        this.cb.movabsReloc(0, "pkl_global_rawAllocCount")
        this.cb.u8(0x48)
        this.cb.u8(0xFF)
        this.cb.u8(0x00)
        this.cb.movabsReloc(0, "pkl_global_rawAllocBytes")
        this.cb.u8(0x48)
        this.cb.u8(0x01)
        this.cb.u8(0x10)
        this.emitJmp(done)
        this.starts[slow] = this.cb.size()
        this.cb.movabsReloc(10, "pkl_abiEngineRegister")
        this.cb.u8(0x41)
        this.cb.u8(0xFF)
        this.cb.u8(0xD2)
        this.starts[done] = this.cb.size()
        this.clobberRcx()
        // A unit return still carries an IR destination temp in some lowering
        // paths (a runtime module's statement call allocates one), and the
        // generic path stores rax there. Nothing ever reads a unit temp, but
        // leave a defined value in case something later does.
        match (d) {
            case some(dd) -> {
                this.cb.u8(0x31)
                this.cb.u8(0xC0)
                this.putRes(dd, 64, this.kOfTemp(dd))
            }
            case none -> {}
        }
    }

    /// `pickle_str_from_i64`'s small-integer intern cache, inlined. Every
    /// generated name in the benchmark is `"w" + str(t)` with `t` in 0..255, so
    /// the runtime answers from a 2000-slot table (`-999..999`) and never
    /// builds digits. Those entries are `FLAG_SHARED` and never freed, so a hit
    /// is immutable and pointer-identical to the split text the map probe
    /// compares against. A cold table, an out-of-range value or an unfilled
    /// slot falls back to the real entry point with rcx untouched.
    fn emitInlineStrFromI64(d: int, arg: int) {
        this.loadTmp(1, 64, arg)
        let slow = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // rax = pkl_global_internTab; test tab != 0.
        this.cb.movabsReloc(0, "pkl_global_internTab")
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x00)
        this.cb.u8(0x48)
        this.cb.u8(0x85)
        this.cb.u8(0xC0)
        this.emitJcc(0x04, slow)
        // r11 = v + 1000. The unsigned compare folds `v < -999` and `v > 999`
        // into one branch: a negative value is huge as unsigned.
        this.cb.u8(0x4C)
        this.cb.u8(0x8D)
        this.cb.u8(0x99)
        this.cb.u32le(1000)
        this.cb.u8(0x49)
        this.cb.u8(0x81)
        this.cb.u8(0xFB)
        this.cb.u32le(2000)
        this.emitJcc(0x03, slow)
        // rax = tab[v + 1000]; a zero entry is a miss.
        this.cb.u8(0x4A)
        this.cb.u8(0x8B)
        this.cb.u8(0x04)
        this.cb.u8(0xD8)
        this.cb.u8(0x48)
        this.cb.u8(0x85)
        this.cb.u8(0xC0)
        this.emitJcc(0x04, slow)
        this.emitJmp(done)
        this.starts[slow] = this.cb.size()
        this.cb.movabsReloc(11, "pickle_str_from_i64")
        this.cb.u8(0x41)
        this.cb.u8(0xFF)
        this.cb.u8(0xD3)
        this.starts[done] = this.cb.size()
        this.clobberRcx()
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// `pkl_shortInternWord` inlined: the intern probe is the single most
    /// frequent runtime entry in the benchmark (once per generated name and
    /// once per split field), and its generic body spends most of its ~155
    /// instructions spilling sub-expressions to the frame. The hot path here
    /// keeps the payload, table, capacity mask and slot index in registers;
    /// every miss - an empty slot, a grown table, a cold table - falls back to
    /// the real entry point, so insertion, growth and FNV hashing stay in one
    /// implementation.
    ///
    /// The placement mix is copied exactly: `(vv ^ (ln * K1)) * K2`, arithmetic
    /// shift right by 33, then `& (cap - 1)`. K1 is the negated 64-bit golden
    /// ratio constant and K2 is the 64-bit mix multiplier; both are emitted as
    /// 64-bit immediates because the operation is wrapping i64 arithmetic. The
    /// shift is `sar`, not `shr`: the runtime's `>>` is signed, so a negative
    /// product must sign-extend before the mask.
    ///
    /// The fallback passes `r11`, which is the raw input before masking and the
    /// masked payload afterwards. `shortInternWord` masks its argument again
    /// with the same length, so the masked form is an equivalent input; this
    /// avoids reloading a value whose home may have been elided by pending-rax
    /// forwarding.
    fn emitInlineShortInternWord(d: int, vT: int, lnT: int) {
        this.loadTmp(1, 64, vT)
        this.loadTmp(2, 64, lnT)
        let cold = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let masked = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let probe = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let nextSlot = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let hit = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // r11 = v; r8 = table; a null table takes the cold path (init/insert).
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0xD9)
        this.cb.movabsReloc(0, "pkl_global_shortInternTab")
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0x00)
        this.cb.u8(0x4D)
        this.cb.u8(0x85)
        this.cb.u8(0xC0)
        this.emitJcc(0x04, cold)
        // msk = -1; if (ln < 8) msk = (1 << (ln * 8)) - 1. The signed compare
        // matches the runtime's `ln < 8`; the shift count only uses `cl`.
        this.cb.u8(0x49)
        this.cb.u8(0xC7)
        this.cb.u8(0xC1)
        this.cb.u32le(0 - 1)
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0xFA)
        this.cb.u8(0x08)
        this.emitJcc(0x0D, masked)
        this.cb.u8(0x89)
        this.cb.u8(0xD1)
        this.cb.u8(0xC1)
        this.cb.u8(0xE1)
        this.cb.u8(0x03)
        this.cb.u8(0x49)
        this.cb.u8(0xC7)
        this.cb.u8(0xC1)
        this.cb.u32le(1)
        this.cb.u8(0x49)
        this.cb.u8(0xD3)
        this.cb.u8(0xE1)
        this.cb.u8(0x49)
        this.cb.u8(0x83)
        this.cb.u8(0xE9)
        this.cb.u8(0x01)
        this.starts[masked] = this.cb.size()
        // r11 = vv; r9 = capacity mask.
        this.cb.u8(0x4D)
        this.cb.u8(0x21)
        this.cb.u8(0xCB)
        this.cb.movabsReloc(0, "pkl_global_shortInternCap")
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0x08)
        this.cb.u8(0x49)
        this.cb.u8(0x83)
        this.cb.u8(0xE9)
        this.cb.u8(0x01)
        // rax = (((vv ^ (ln * K1)) * K2) >> 33) & mask.
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0xC2)
        this.cb.u8(0x49)
        this.cb.u8(0xBA)
        this.cb.u64le(0 - 0x61C8864680B583EB)
        this.cb.u8(0x49)
        this.cb.u8(0x0F)
        this.cb.u8(0xAF)
        this.cb.u8(0xC2)
        this.cb.u8(0x4C)
        this.cb.u8(0x31)
        this.cb.u8(0xD8)
        this.cb.u8(0x49)
        this.cb.u8(0xBA)
        this.cb.u64le(0x7FB5D329728EA185)
        this.cb.u8(0x49)
        this.cb.u8(0x0F)
        this.cb.u8(0xAF)
        this.cb.u8(0xC2)
        this.cb.u8(0x48)
        this.cb.u8(0xC1)
        this.cb.u8(0xF8)
        this.cb.u8(33)
        this.cb.u8(0x4C)
        this.cb.u8(0x21)
        this.cb.u8(0xC8)
        this.starts[probe] = this.cb.size()
        // p = tab[idx]; an empty slot needs insertion.
        this.cb.u8(0x4D)
        this.cb.u8(0x8B)
        this.cb.u8(0x14)
        this.cb.u8(0xC0)
        this.cb.u8(0x4D)
        this.cb.u8(0x85)
        this.cb.u8(0xD2)
        this.emitJcc(0x04, cold)
        // A hit needs both the length and the masked payload to match.
        this.cb.u8(0x49)
        this.cb.u8(0x39)
        this.cb.u8(0x52)
        this.cb.u8(0x18)
        this.emitJcc(0x05, nextSlot)
        this.cb.u8(0x4D)
        this.cb.u8(0x39)
        this.cb.u8(0x5A)
        this.cb.u8(0x20)
        this.emitJcc(0x04, hit)
        this.starts[nextSlot] = this.cb.size()
        this.cb.u8(0x48)
        this.cb.u8(0xFF)
        this.cb.u8(0xC0)
        this.cb.u8(0x4C)
        this.cb.u8(0x21)
        this.cb.u8(0xC8)
        this.emitJmp(probe)
        this.starts[hit] = this.cb.size()
        this.cb.u8(0x4C)
        this.cb.u8(0x89)
        this.cb.u8(0xD0)
        this.emitJmp(done)
        this.starts[cold] = this.cb.size()
        // rcx = r11 (raw v, or vv for the same ln); rdx still holds ln.
        this.cb.u8(0x49)
        this.cb.u8(0x8B)
        this.cb.u8(0xCB)
        this.cb.movabsReloc(10, "pkl_shortInternWord")
        this.cb.u8(0x41)
        this.cb.u8(0xFF)
        this.cb.u8(0xD2)
        this.starts[done] = this.cb.size()
        this.clobberRcx()
        this.putRes(d, 64, this.kOfTemp(d))
    }

    /// `pickle_str_append_two`'s fast path, inlined. The backend already fuses
    /// `line + piece + " "` into this symbol, and the benchmark reaches it once
    /// per generated token. The runtime body is correct but pays a full call
    /// frame, argument spills and a stack home for every sub-expression; the
    /// whole fast path is a handful of masked word stores, so it is emitted
    /// here with the operands in the argument registers.
    ///
    /// Exactly the runtime conditions gate the fast path: no operand aliases
    /// `a`, `a` is an owned heap buffer, not shared, both appended lengths fit
    /// one payload word, and the result fits the allocation. Everything else -
    /// including a destination that must grow - jumps to the real entry point
    /// with rcx/rdx/r8 untouched, so capacity growth, copying and interning stay
    /// in one implementation. The store rule is the source's: keep the
    /// destination's low `pos & 7` bytes, shift the piece in, spill the overflow
    /// byte into the next word, then publish the new length and the cleared
    /// cached-hash flag. The tail word is masked last so the payload stays
    /// canonical past `n`.
    ///
    /// Register plan (all caller-saved): rcx/rdx/r8 are the arguments, r9 keeps
    /// `a`, r10 the word base or scratch, r11 the payload word, rax the new
    /// length, and rcx doubles as the shift count between the stores. Byte
    /// offsets are `32 + (pos & ~7)`: the payload's fifth word is `a[4]` at byte
    /// 32, so the word containing payload offset `pos` starts there.
    fn emitInlineAppendTwo(d: int, aT: int, bT: int, cT: int) {
        this.loadTmp(1, 64, aT)
        this.loadTmp(2, 64, bT)
        this.loadTmp(8, 64, cT)
        let slow = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let cross1 = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let aligned1 = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done1 = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let cross2 = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let aligned2 = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done2 = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let tailed = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        let done = 0 - 1 - this.inlineLab
        this.inlineLab = this.inlineLab + 1
        // `a == b` and `a == c` must fall back: the sequential bodies expose
        // the intermediate buffer, so writing over live source bytes is wrong.
        this.cb.u8(0x48)
        this.cb.u8(0x39)
        this.cb.u8(0xD1)
        this.emitJcc(0x04, slow)
        this.cb.u8(0x4C)
        this.cb.u8(0x39)
        this.cb.u8(0xC1)
        this.emitJcc(0x04, slow)
        // rax = flags. Owned (bit 0) and not shared (bit 2) are required.
        this.cb.u8(0x48)
        this.cb.u8(0x8B)
        this.cb.u8(0x41)
        this.cb.u8(0x10)
        this.cb.u8(0xA8)
        this.cb.u8(0x01)
        this.emitJcc(0x04, slow)
        this.cb.u8(0xA8)
        this.cb.u8(0x04)
        this.emitJcc(0x05, slow)
        // r9 = byte capacity, r10 = len(a), r11 = len(b), rax = len(c).
        this.cb.movRR(9, 0, 64)
        this.cb.u8(0x49)
        this.cb.u8(0x83)
        this.cb.u8(0xE1)
        this.cb.u8(0xF8)
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0x51)
        this.cb.u8(0x18)
        this.cb.u8(0x4C)
        this.cb.u8(0x8B)
        this.cb.u8(0x5A)
        this.cb.u8(0x18)
        this.cb.u8(0x49)
        this.cb.u8(0x83)
        this.cb.u8(0xFB)
        this.cb.u8(0x08)
        this.emitJcc(0x0F, slow)
        this.cb.u8(0x49)
        this.cb.u8(0x8B)
        this.cb.u8(0x40)
        this.cb.u8(0x18)
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0xF8)
        this.cb.u8(0x08)
        this.emitJcc(0x0F, slow)
