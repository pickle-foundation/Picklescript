        this.cb.u8(0x4D)
        this.cb.u8(0x8B)
        this.cb.u8(0x50)
        this.cb.u8(0x18)
        this.cb.u8(0x4C)
        this.cb.u8(0x29)
        this.cb.u8(0xD1)
        this.cb.movRR(10, 1, 64)
        this.cb.u8(0x41)
        this.cb.u8(0x83)
        this.cb.u8(0xE2)
        this.cb.u8(0x07)
        this.emitJcc(0x04, aligned2)
        this.cb.u8(0x4D)
        this.cb.u8(0x8B)
        this.cb.u8(0x58)
        this.cb.u8(0x18)
        // Cross test without losing r2: rdx = (pos & 7) + len(c). rdx held the
        // source pointer for the first piece and is dead here.
        this.cb.u8(0x4C)
        this.cb.u8(0x89)
        this.cb.u8(0xD2)
        this.cb.u8(0x4C)
        this.cb.u8(0x01)
        this.cb.u8(0xDA)
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0xFA)
        this.cb.u8(0x08)
        this.emitJcc(0x0F, cross2)
        this.cb.movRR(2, 1, 64)
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0xE2)
        this.cb.u8(0xF8)
        this.cb.u8(0x44)
        this.cb.u8(0x89)
        this.cb.u8(0xD1)
        this.cb.u8(0xC1)
        this.cb.u8(0xE1)
        this.cb.u8(0x03)
        this.cb.u8(0x4D)
        this.cb.u8(0x8B)
        this.cb.u8(0x58)
