        this.cb.u8(0x83)
        this.cb.u8(0xE1)
        this.cb.u8(0xF8)
        this.cb.u8(0x4D)
        this.cb.u8(0x89)
        this.cb.u8(0x5C)
        this.cb.u8(0x09)
        this.cb.u8(0x20)
        this.emitJmp(done2)
        this.starts[cross2] = this.cb.size()
        this.cb.movRR(2, 1, 64)
        this.cb.u8(0x48)
        this.cb.u8(0x83)
        this.cb.u8(0xE2)
        this.cb.u8(0xF8)
        this.cb.u8(0x44)
        this.cb.u8(0x89)
        this.cb.u8(0xD1)
        this.cb.u8(0xC1)
        this.cb.u8(0xE1)
        this.cb.u8(0x03)
        this.cb.u8(0x4D)
        this.cb.u8(0x8B)
        this.cb.u8(0x58)
        this.cb.u8(0x20)
        this.cb.u8(0xF7)
        this.cb.u8(0xD9)
        this.cb.movRR(10, 11, 64)
        this.cb.u8(0x49)
        this.cb.u8(0xD3)
        this.cb.u8(0xEA)
        this.cb.u8(0x4D)
        this.cb.u8(0x89)
        this.cb.u8(0x54)
        this.cb.u8(0x11)
        this.cb.u8(0x28)
        this.cb.u8(0xF7)
        this.cb.u8(0xD9)
        this.cb.u8(0x49)
        this.cb.u8(0xC7)
        this.cb.u8(0xC2)
        this.cb.u32le(1)
        this.cb.u8(0x49)
        this.cb.u8(0xD3)
        this.cb.u8(0xE2)
        this.cb.u8(0x49)
        this.cb.u8(0xFF)
        this.cb.u8(0xCA)
        this.cb.u8(0x49)
        this.cb.u8(0xD3)
        this.cb.u8(0xE3)
        this.cb.u8(0x4D)
        this.cb.u8(0x21)
        this.cb.u8(0x54)
        this.cb.u8(0x11)
        this.cb.u8(0x20)
        this.cb.u8(0x4D)
        this.cb.u8(0x09)
        this.cb.u8(0x5C)
        this.cb.u8(0x11)
        this.cb.u8(0x20)
        this.starts[done2] = this.cb.size()
