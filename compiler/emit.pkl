module compiler.emit

// Lower the checked AST to PickleIR.
//
// The checker runs first (collecting `expr -> Ty` into a side table); this
// module walks the typed AST and emits the flat block/slot/temp IR from
// `ir.rs`. Constructs outside the slice-1 subset are rejected with a
// "not lowered yet" diagnostic rather than miscompiled.

import * from compiler.ast
import { Span, Diagnostic, DiagnosticSink } from compiler.diag
import { IrBlock, IrFunc, IrGlobal, IrModule, IrParam, IrTy, emptyIrBlocks, emptyIrGlobals, emptyIrParams, emptyIrTys, emptyModule, irTyStr, irxParseFloat } from compiler.ir
import { CallableInfo, ClassTable, CtorInfo, entryGenerics, EnumTable, FieldInfo, ParamInfo, PropertyInfo, ResolvedProgram, TypeTableEntry } from compiler.resolvebag

import { collectExprTypes } from compiler.checkcore
import { containsStr, isNoneStr, spanKey } from compiler.checkutil
import * from compiler.ty
import { f64ToBits } from compiler.x64

import * from compiler.emitutil
import * from compiler.emittypes
import * from compiler.emitcore

class EmitOut {
    var ir: IrModule
    var classCount: int
    /// ABI symbols declared with `#[symbol]` (see `Emitter.overrides`). The
    /// linker needs these to let a program definition displace the runtime
    /// archive body of the same name.
    var overrides: List<string>

    constructor(m: IrModule, cc: int, ov: List<string>) {
        this.ir = m
        this.classCount = cc
        this.overrides = ov
    }
}

/// Lower `prog` to pickle IR with the Â§17.1 split-link options, or `None`
/// when checking or lowering fails. Mirrors `emit_ir` in emit.rs; the
/// defaults (`cidSalt = 0`, no setup symbol, no peer setups) are exactly the
/// single-object behavior.
fn emitIrEx(prog: Program, resolved: ResolvedProgram, diags: DiagnosticSink, cidSalt: int, moduleSetupSymbol: string, extraSetups: List<string>) -> EmitOut? {
          var types = collectExprTypes(prog, resolved, diags)
    if (diags.anyError()) {
        return none
    }
    var em = Emitter(prog, resolved, diags, types)
    em.cidSalt = cidSalt
    em.moduleSetupSymbol = moduleSetupSymbol
    em.extraSetups = extraSetups
    emit(em)
    for (gf in em.globalFailures) {
        diags.emit(Diagnostic.errorAt(gf.span, gf.msg))
    }
    // `em.failed` alone is not enough. A global failure is reported as an error
    // diagnostic rather than by setting `failed`, so the `diags.anyError()` arm is
    // what makes a rejected global actually stop code generation. Without it the
    // port went on to lower and link a program whose slot is never filled, which
    // is a null dereference at run time -- exactly the outcome the diagnostic is
    // warning about. Mirrors `em.failed || em.diags.any_error()` in emit.rs.
    if (em.failed || diags.anyError()) {
        return none
    }
    EmitOut(em.irModule, len(em.classes), em.overrides)
}

/// Lower `prog` to pickle IR, or `None` when checking or lowering fails.
/// Mirrors `emit_ir` in emit.rs.
fn emitIr(prog: Program, resolved: ResolvedProgram, diags: DiagnosticSink) -> IrModule? {
    if (let some(out) = emitIrEx(prog, resolved, diags, 0, "", emptyStrs())) {
        return out.ir
    }
    none
}

