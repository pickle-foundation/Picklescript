module compiler.check

import * from compiler.ast
import { Span, Diagnostic, DiagnosticSink } from compiler.diag
import * from compiler.ty
import * from compiler.resolve

fn containsStr(hay: string, needle: string) -> bool {
    let hb = bytes(hay)
    let nb = bytes(needle)
    if (len(nb) == 0) {
        return true
    }
    if (len(nb) > len(hb)) {
        return false
    }
    var i = 0
    while (i <= len(hb) - len(nb)) {
        var j = 0
        var ok = true
        while (j < len(nb)) {
            if (hb[i + j] != nb[j]) {
                ok = false
            }
            j = j + 1
        }
        if (ok) {
            return true
        }
        i = i + 1
    }
    false
}

fn joinStrs(ts: List<string>, sep: string) -> string {
    var out = ""
    var i = 0
    while (i < len(ts)) {
        if (i > 0) {
            out += sep
        }
        out += ts[i]
        i = i + 1
    }
    out
}

fn listHasStr(l: List<string>, s: string) -> bool {
    var i = 0
    while (i < len(l)) {
        if (l[i] == s) {
            return true
        }
        i = i + 1
    }
    false
}

fn listRemoveStr(l: List<string>, s: string) {
    var i = 0
    while (i < len(l)) {
        if (l[i] == s) {
            var j = i
            while (j + 1 < len(l)) {
                l[j] = l[j + 1]
                j = j + 1
            }
            l.pop()
            return
        }
        i = i + 1
    }
}

fn listHasTy(l: List<Ty>, t: Ty) -> bool {
    var i = 0
    while (i < len(l)) {
        if (l[i] == t) {
            return true
        }
        i = i + 1
    }
    false
}

fn absDiffInt(a: int, b: int) -> int {
    if (a >= b) {
        a - b
    } else {
        b - a
    }
}

/// Whether `s` is a plain C identifier, i.e. usable verbatim as a linkable symbol
/// name by `#[symbol("...")]`. Guards against a Pickle-level override that would
/// either never resolve at link time or collide with the COFF symbol table.
fn isAbiSymbol(s: string) -> bool {
    if (s == "") {
        return false
    }
    var i = 0
    while (i < len(s)) {
        let c = s[i] as int
        let isDigit = c >= 48 && c <= 57
        let isUpper = c >= 65 && c <= 90
        let isLower = c >= 97 && c <= 122
        let isUnd = c == 95
        if (!(isDigit || isUpper || isLower || isUnd)) {
            return false
        }
        i = i + 1
    }
    let first = s[0] as int
    !(first >= 48 && first <= 57)
}

fn spanKey(s: Span) -> string {
    "{s.start}:{s.end}"
}

fn binOpName(op: BinOp) -> string {
    match (op) {
        case BinOp.Add -> "Add"
        case BinOp.Sub -> "Sub"
        case BinOp.Mul -> "Mul"
        case BinOp.Div -> "Div"
        case BinOp.Mod -> "Mod"
        case BinOp.Pow -> "Pow"
        case BinOp.Shl -> "Shl"
        case BinOp.Shr -> "Shr"
        case BinOp.BitAnd -> "BitAnd"
        case BinOp.BitOr -> "BitOr"
        case BinOp.BitXor -> "BitXor"
        case BinOp.Lt -> "Lt"
        case BinOp.Le -> "Le"
        case BinOp.Gt -> "Gt"
        case BinOp.Ge -> "Ge"
        case BinOp.Eq -> "Eq"
        case BinOp.Ne -> "Ne"
        case BinOp.And -> "And"
        case BinOp.Or -> "Or"
        case BinOp.Range -> "Range"
        case BinOp.RangeIncl -> "RangeIncl"
        case BinOp.NullCoalesce -> "NullCoalesce"
        case BinOp.Send -> "Send"
        case BinOp.Is -> "Is"
        case BinOp.In -> "In"
    }
}

fn unOpName(op: UnOp) -> string {
    match (op) {
        case UnOp.Neg -> "Neg"
        case UnOp.Not -> "Not"
        case UnOp.BitNot -> "BitNot"
        case UnOp.Deref -> "Deref"
        case UnOp.AddrOf -> "AddrOf"
    }
}

/// The concatenated text of a string literal's parts, or `""` when any part
/// interpolates (mirrors the `#[tag(...)]` validity rule).
fn strPartsText(parts: List<StrPart>) -> string {
    var out = ""
    var isPlain = true
    for (p in parts) {
        match (p) {
            case StrPart.Text(t) -> {
                out += t
                false
            }
            case StrPart.Expr(_) -> {
                isPlain = false
                false
            }
        }
    }
    if (isPlain) {
        out
    } else {
        ""
    }
}

/// True when `s` is `none`. The checker rejects `s == none` directly, so
/// option tests go through a match.
fn isNoneStr(s: string?) -> bool {
    match (s) {
        case none -> true
        case some(_) -> false
    }
}

/// True when `e` is `none`.
fn isNoneExpr(e: Expr?) -> bool {
    match (e) {
        case none -> true
        case some(_) -> false
    }
}

/// Map a checker diagnostic message to its stable error code, most specific
/// first. Unlisted messages render without a code rather than a wrong one.
fn classifyMessage(msg: string) -> string? {
    let table = [
        ["not lowered yet", "E0900"],
        ["after `free()`", "E0501"],
        ["after it was moved", "E0501"],
        ["was already freed", "E0502"],
        ["`free` is only available on a `#[manualAlloc]` binding", "E0503"],
        ["cannot store `#[manualAlloc]`", "E0504"],
        ["cannot assign `#[manualAlloc]`", "E0504"],
        ["cannot bind `#[manualAlloc]`", "E0504"],
        ["takes ownership of its argument", "E0504"],
        ["cannot overwrite `#[manualAlloc]` binding", "E0505"],
        ["cannot return `#[manualAlloc]` value", "E0505"],
        ["`#[manualAlloc]` takes no arguments", "E0401"],
        ["`#[manualAlloc]` attribute", "E0401"],
        ["is not supported on static fields", "E0401"],
        ["is not supported on constants", "E0401"],
        ["requires an allocation initializer", "E0401"],
        ["requires a class or struct type", "E0401"],
        ["requires a class or struct return type", "E0401"],
        ["must be a class or struct type", "E0401"],
        ["owned field `", "E0401"],
        ["unknown attribute `#[", "E0400"],
        ["`#[tag", "E0400"],
        ["attempt to call a non-function", "E0411"],
        ["unknown generic function `", "E0410"],
        [" argument(s), found ", "E0410"],
        ["missing argument", "E0410"],
        ["too many arguments in call", "E0410"],
        ["named argument `", "E0410"],
        ["cannot access member `", "E0420"],
        ["left side of `??` is not", "E0430"],
        ["`?.` on a non-option value", "E0430"],
        ["cannot unwrap non-option value", "E0430"],
        ["requires numeric or string operands", "E0430"],
        ["bitwise operators require", "E0430"],
        ["unary `", "E0430"],
        ["requires a numeric operand", "E0430"],
        ["requires a `bool` operand", "E0430"],
        ["requires an `int` operand", "E0430"],
        ["of a scalar requires a local variable", "E0430"],
        ["currently only supports class, struct, pointer", "E0430"],
        ["cannot dereference a value of type", "E0430"],
        ["`alloc(T, count)`", "E0440"],
        ["`alloc` element type", "E0440"],
        ["`alloc` count must be an `int`", "E0440"],
        ["`alloc` currently only supports scalar element types", "E0440"],
        ["`free(p)` takes one argument", "E0440"],
        ["`free` expects a pointer argument", "E0440"],
        ["`free()` takes no arguments", "E0440"],
        ["may only be used inside an `unsafe` block", "E0520"],
        ["type mismatch in ", "E0308"],
        ["cannot return a value from a function with no return type", "E0310"],
        ["`if` branches have mismatched types", "E0310"],
        ["match arms produce inconsistent types", "E0310"],
        ["condition must be a `bool`", "E0340"],
        ["used outside of a loop", "E0320"],
        ["`for (x in ...)` requires a sequence", "E0341"],
        ["map keys must be `string` values", "E0342"],
        ["map keys must be `", "E0342"],
        ["index must be an `int`", "E0343"],
        ["map index must be a `string`", "E0343"],
        ["map index must be a `", "E0343"],
        ["string index must be an `int`", "E0343"],
        ["pointer index must be an `int`", "E0343"],
        ["cannot index a value of type", "E0343"],
        ["index assignment target must be a List", "E0343"],
        ["indexing a pointer to a", "E0343"],
        ["storing through a pointer to a", "E0343"],
        ["use of undeclared name `", "E0351"],
        ["cannot assign to undeclared name `", "E0351"],
        ["no member `", "E0352"],
        ["no assignable member `", "E0352"],
        ["has no variant", "E0353"],
        ["payload field(s); use `", "E0353"],
        ["enum variant pattern requires a value of enum type", "E0353"],
        ["cannot be constructed directly", "E0354"],
        ["cannot assign to a member of a non-class value", "E0355"],
        ["declares `implements", "E0360"],
        ["`this` used outside of a class body", "E0361"],
        ["`super` used outside of a class body", "E0361"],
        ["no parent to call `super`", "E0361"],
        ["can only be used as a named constructor's delegation", "E0361"],
        ["may only delegate to `this(...)`", "E0361"],
        ["cannot assign to immutable", "E0362"],
        ["must be assigned on an instance", "E0362"],
        ["must be assigned on the type", "E0362"],
        ["has no setter", "E0362"],
        ["assignment target must be a variable, member, or index", "E0362"],
        ["cannot write through an immutable reference", "E0362"],
        ["cannot write to a field", "E0362"],
        ["can never succeed", "E0363"],
        ["cannot cast `", "E0363"],
        ["references are supported only as function parameter types", "E0700"],
    ]
    for (row in table) {
        if (containsStr(msg, row[0])) {
            return row[1]
        }
    }
    none
}

class Local {
    var ty: Ty
    var mutable: bool
    var manual: bool
    var freed: bool
    var moved: bool

    constructor(ty: Ty, mutable: bool, manual: bool, freed: bool, moved: bool) {
        this.ty = ty
        this.mutable = mutable
        this.manual = manual
        this.freed = freed
        this.moved = moved
    }
}

class MovedBits {
    var moved: bool
    var freed: bool

    constructor(moved: bool, freed: bool) {
        this.moved = moved
        this.freed = freed
    }
}

class TypeKey {
    var name: string
    var args: Map<string, Ty>

    constructor(name: string, args: Map<string, Ty>) {
        this.name = name
        this.args = args
    }
}

class FieldCount {
    var name: string
    var count: int

    constructor(name: string, count: int) {
        this.name = name
        this.count = count
    }
}

class ManualFns {
    var rets: List<string>
    var params: Map<string, List<bool>>

    constructor(rets: List<string>, params: Map<string, List<bool>>) {
        this.rets = rets
        this.params = params
    }
}

fn emptyMapLocal() -> Map<string, Local> {
    let m = {"::seed::": Local(Ty.Int, false, false, false, false)}
    m.remove("::seed::")
    m
}

fn emptyMapStrTy() -> Map<string, Ty> {
    let m = {"::seed::": Ty.Int}
    m.remove("::seed::")
    m
}

fn emptyMapStrMoved() -> Map<string, MovedBits> {
    let m = {"::seed::": MovedBits(false, false)}
    m.remove("::seed::")
    m
}

fn emptyMapStrBoolList() -> Map<string, List<bool>> {
    let m = {"::seed::": emptyBools()}
    m.remove("::seed::")
    m
}

fn emptyBools() -> List<bool> {
    var l = [true]
    l.pop()
    l
}

fn emptyStrList() -> List<string> {
    var l = [""]
    l.pop()
    l
}

fn emptyLocalList() -> List<Local> {
    var l = [Local(Ty.Int, false, false, false, false)]
    l.pop()
    l
}

fn emptyMovedList() -> List<Map<string, MovedBits>> {
    var l = [emptyMapStrMoved()]
    l.pop()
    l
}

fn emptySpanList() -> List<Span> {
    var l = [Span(0, 0)]
    l.pop()
    l
}

fn copySpanList(l: List<Span>) -> List<Span> {
    var out = emptySpanList()
    for (s in l) {
        out.push(s)
    }
    out
}

fn copyStrList(l: List<string>) -> List<string> {
    var out = emptyStrList()
    for (s in l) {
        out.push(s)
    }
    out
}

/// Spans are class instances (reference type), so compare field-wise.
fn spanEq(a: Span, b: Span) -> bool {
    a.start == b.start && a.end == b.end
}

fn hasSpan(l: List<Span>, s: Span) -> bool {
    for (x in l) {
        if (spanEq(x, s)) {
            return true
        }
    }
    false
}

fn removeSpan(l: List<Span>, s: Span) -> bool {
    var i = 0
    while (i < len(l)) {
        if (spanEq(l[i], s)) {
            l.remove(i)
            return true
        }
        i = i + 1
    }
    false
}

fn emptyTyList() -> List<Ty> {
    var l = [Ty.Int]
    l.pop()
    l
}

fn tyVars(names: List<string>) -> List<Ty> {
    var out = emptyTyList()
    for (n in names) {
        out.push(Ty.Var(n))
    }
    out
}

fn isClassOrStruct(t: Ty) -> bool {
    match (t) {
        case Ty.Class(_, _) -> true
        case Ty.Struct(_, _) -> true
        case _ -> false
    }
}

fn isThisCall(e: Expr) -> bool {
    match (e.kind) {
        case ExprKind.Call(callee, _) -> match (callee.kind) {
            case ExprKind.This -> true
            case _ -> false
        }
        case _ -> false
    }
}

/// The single `this(...)` delegation expression of a named-constructor body, or
/// `none` if the body is not exactly one such expression (as a statement or a
/// block tail).
fn namedCtorDelegation(body: Block) -> Expr? {
    if (len(body.stmts) == 0) {
        if (let some(t) = body.expr) {
            if (isThisCall(t)) {
                t
            } else {
                none
            }
        } else {
            none
        }
    } else if (len(body.stmts) == 1) {
        if (let none = body.expr) {
            let s = body.stmts[0]
            match (s) {
                case Stmt.Expr(e) -> {
                    if (isThisCall(e)) {
                        e
                    } else {
                        none
                    }
                }
                case _ -> none
            }
        } else {
            none
        }
    } else {
        none
    }
}

/// Which `List<T>` element types `sort` can order. It compares raw boxed
/// payloads (int/byte/char/bool), float bits, or string bytes.
fn isListSortable(t: Ty) -> bool {
    match (t) {
        case Ty.Int -> true
        case Ty.Float -> true
        case Ty.Byte -> true
        case Ty.Char -> true
        case Ty.Bool -> true
        case Ty.String -> true
        case _ -> false
    }
}

/// Free functions annotated `#[manualAlloc]` (result owned by the caller) and,
/// for each, which positional parameters are `#[manualAlloc]` (owned).
fn collectManualFns(prog: Program) -> ManualFns {
    var rets = emptyStrList()
    var params = emptyMapStrBoolList()
    for (item in prog.items) {
        let f = match (item.kind) {
            case ItemKind.Fn(f) -> f
            case ItemKind.Test(f) -> f
            case _ -> none
        }
        if (let some(ff) = f) {
            let has = fn(attrs: List<Attribute>) -> bool {
                var i = 0
                while (i < len(attrs)) {
                    if (attrs[i].name == "manualAlloc") {
                        return true
                    }
                    i = i + 1
                }
                false
            }
            if (has(item.attrs)) {
                rets.push(ff.name)
            }
            var flags = emptyBools()
            for (p in ff.params) {
                flags.push(has(p.attrs))
            }
            var anyOwned = false
            for (b in flags) {
                if (b) {
                    anyOwned = true
                }
            }
            if (anyOwned) {
                params[ff.name] = flags
            }
        }
    }
    ManualFns(rets, params)
}

fn checkProgram(prog: Program, resolved: ResolvedProgram, diags: DiagnosticSink) {
    let ck = Checker(prog, resolved, diags)
    ck.check()
}

fn collectExprTypes(prog: Program, resolved: ResolvedProgram, diags: DiagnosticSink) -> Map<string, Ty> {
    let ck = Checker(prog, resolved, diags)
    ck.check()
    ck.types
}

class Checker {
    var prog: Program
    var resolved: ResolvedProgram
    var diags: DiagnosticSink
    var scopes: List<Map<string, Local>>
    var types: Map<string, Ty>
    var selfTy: Ty?
    var selfArgs: Map<string, Ty>
    var retTy: Ty
    var fnGenerics: List<string>
    var namedCtorParams: List<Ty>?
    var namedCtorDelegated: bool
    var superCtorParams: List<Ty>?
    var loopDepth: int
    var retManual: bool
    var manualRetFns: List<string>
    var manualParamFns: Map<string, List<bool>>
    var pendingOwnedCalls: List<Span>
    var unsafeDepth: int

    constructor(prog: Program, resolved: ResolvedProgram, diags: DiagnosticSink) {
        this.prog = prog
        this.resolved = resolved
        this.diags = diags
        this.scopes = [emptyMapLocal()]
        this.types = emptyMapStrTy()
        this.selfTy = none
        this.selfArgs = emptyMapStrTy()
        this.retTy = Ty.Empty
        this.fnGenerics = emptyStrList()
        this.namedCtorParams = none
        this.namedCtorDelegated = false
        this.superCtorParams = none
        this.loopDepth = 0
        this.retManual = false
        let mf = collectManualFns(prog)
        this.manualRetFns = mf.rets
        this.manualParamFns = mf.params
        this.pendingOwnedCalls = emptySpanList()
        this.unsafeDepth = 0
    }

    fn check() {
        for (item in this.prog.items) {
            let isFn = match (item.kind) {
                case ItemKind.Fn(_) -> true
                case ItemKind.Test(_) -> true
                case _ -> false
            }
            let isTest = match (item.kind) {
                case ItemKind.Test(_) -> true
                case _ -> false
            }
            for (a in item.attrs) {
                if (a.name == "manualAlloc" && isFn) {
                    if (len(a.args) > 0) {
                        this.err(a.span, "`#[manualAlloc]` takes no arguments")
                    }
                } else if (a.name == "symbol" && isFn) {
                    if (!(len(a.args) == 1)) {
                        this.err(a.span, "`#[symbol(...)]` takes exactly one string literal")
                    } else {
                        match (a.args[0].kind) {
                            case ExprKind.Lit(lit) -> {
                                match (lit) {
                                    case Lit.String(parts) -> {
                                        let text = strPartsText(parts)
                                        if (text == "") {
                                            this.err(a.args[0].span, "`#[symbol(...)]` requires a non-empty string literal")
                                        } else if (!isAbiSymbol(text)) {
                                            this.err(a.args[0].span, "`#[symbol(...)]` must be a C identifier (letters, digits, underscore; not starting with a digit)")
                                        }
                                    }
                                    case _ -> {
                                        this.err(a.args[0].span, "`#[symbol(...)]` requires a non-empty string literal")
                                    }
                                }
                            }
                            case _ -> {
                                this.err(a.args[0].span, "`#[symbol(...)]` requires a non-empty string literal")
                            }
                        }
                    }
                } else if (a.name == "symbol") {
                    this.err(a.span, "`#[symbol(...)]` is only allowed on functions")
                } else if (a.name == "tag" && isTest) {
                    if (len(a.args) == 0) {
                        this.err(a.span, "`#[tag(...)]` needs at least one tag")
                    }
                    for (arg in a.args) {
                        match (arg.kind) {
                            case ExprKind.Lit(lit) -> {
                                match (lit) {
                                    case Lit.String(parts) -> {
                                        let text = strPartsText(parts)
                                        if (text == "") {
                                            this.err(arg.span, "`#[tag(...)]` arguments must be non-empty string literals")
                                        }
                                    }
                                    case _ -> {
                                        this.err(arg.span, "`#[tag(...)]` arguments must be string literals")
                                    }
                                }
                            }
                            case _ -> {
                                this.err(arg.span, "`#[tag(...)]` arguments must be string literals")
                            }
                        }
                    }
                } else if (a.name == "tag") {
                    this.err(a.span, "`#[tag(...)]` is only allowed on test items")
                } else {
                    this.err(a.span, "attributes on declarations are not lowered yet (`#[{a.name}]`)")
                }
            }
            match (item.kind) {
                case ItemKind.Fn(f) -> this.checkFnSignatureBodies(f, item.attrs)
                case ItemKind.Test(f) -> this.checkFnSignatureBodies(f, item.attrs)
                case ItemKind.Const(c) -> {
                    var ty = Ty.Unknown
                    var i = 0
                    while (i < len(this.resolved.consts)) {
                        if (this.resolved.consts[i].name == c.name) {
                            ty = this.resolved.consts[i].ty
                        }
                        i = i + 1
                    }
                    let got = this.checkExpr(c.value)
                    this.guardRefUse(ty, c.span, "a `const` binding")
                    this.checkAssignable(ty, got, c.span, "const initializer")
                }
                case ItemKind.Class(c) -> this.checkClassBodies(c)
                case ItemKind.Struct(s) -> this.checkStructBodies(s)
                case ItemKind.Enum(_) -> {}
                case ItemKind.Interface(_) -> {}
                case ItemKind.Global(g) -> {
                    var ty = Ty.Unknown
                    var i = 0
                    while (i < len(this.resolved.globals)) {
                        if (this.resolved.globals[i].name == g.name) {
                            ty = this.resolved.globals[i].ty
                        }
                        i = i + 1
                    }
                    let got = this.checkExpr(g.value)
                    this.guardRefUse(ty, g.span, "a `var` binding")
                    this.checkAssignable(ty, got, g.span, "global initializer")
                }
            }
        }
        this.checkInterfaceConformance()
    }

    // ---- scope helpers -----------------------------------------------------

    fn pushScope() {
        this.scopes.push(emptyMapLocal())
    }

    fn popScope() {
        this.scopes.pop()
    }

    fn declare( name: string, ty: Ty, mutable: bool) {
        this.scopes[len(this.scopes) - 1][name] = Local(ty, mutable, false, false, false)
    }

    /// Validate `#[...]` attributes on a `let`/`var` binding and report
    /// whether the binding is `#[manualAlloc]`.
    fn checkLetAttributes( attrs: List<Attribute>) -> bool {
        var manual = false
        for (a in attrs) {
            if (a.name == "manualAlloc") {
                if (len(a.args) > 0) {
                    this.err(a.span, "`#[manualAlloc]` takes no arguments")
                }
                if (manual) {
                    this.err(a.span, "duplicate `#[manualAlloc]` attribute")
                }
                manual = true
            } else {
                this.err(a.span, "unknown attribute `#[{a.name}]`")
            }
        }
        manual
    }

    /// Mark a local as `#[manualAlloc]` after `bindPattern` inserted it.
    fn markManual( name: string) {
        var i = len(this.scopes) - 1
        while (i >= 0) {
            if (let some(l) = this.scopes[i].get(name)) {
                l.manual = true
                return
            }
            i = i - 1
        }
    }

    fn isManual( name: string) -> bool {
        if (let some(l) = this.lookup(name)) {
            l.manual
        } else {
            false
        }
    }

    fn isFreed( name: string) -> bool {
        if (let some(l) = this.lookup(name)) {
            l.freed
        } else {
            false
        }
    }

    fn markMoved( name: string) {
        var i = len(this.scopes) - 1
        while (i >= 0) {
            if (let some(l) = this.scopes[i].get(name)) {
                l.moved = true
                return
            }
            i = i - 1
        }
    }

    /// If `e` is a bare identifier naming a live `#[manualAlloc]` local, return
    /// its name. Naming it in an owning position hands over ownership.
    fn manualMoveSource( e: Expr) -> string? {
        match (e.kind) {
            case ExprKind.Ident(name) -> {
                if (let some(l) = this.lookup(name)) {
                    if (l.manual && !l.moved && !l.freed) {
                        name
                    } else {
                        none
                    }
                } else {
                    none
                }
            }
            case _ -> none
        }
    }

    /// Mark a pending `#[manualAlloc]`-returning call as consumed by the
    /// enclosing owned position.
    fn consumeOwned( e: Expr) {
        removeSpan(this.pendingOwnedCalls, e.span)
    }

    /// Is `e` a fresh allocation that an owned position may take directly:
    /// a class/struct constructor call, or a call to a `#[manualAlloc]`
    /// function.
    fn isFreshAllocation( e: Expr) -> bool {
        if (hasSpan(this.pendingOwnedCalls, e.span)) {
            return true
        }
        match (e.kind) {
            case ExprKind.Call(callee, _) -> match (callee.kind) {
                case ExprKind.Ident(name) -> {
                    if (this.resolved.types.has(name)) {
                        if (let some(t) = this.types.get(spanKey(e.span))) {
                            match (t) {
                                case Ty.Class(_, _) -> true
                                case Ty.Struct(_, _) -> true
                                case _ -> false
                            }
                        } else {
                            false
                        }
                    } else {
                        false
                    }
                }
                case _ -> false
            }
            case _ -> false
        }
    }

    /// Check the arguments at an owned-parameter boundary: each owned parameter
    /// receives a `#[manualAlloc]` binding (moved) or a fresh allocation.
    fn checkManualArgs( flags: List<bool>, args: List<CallArg>) {
        var i = 0
        while (i < len(args)) {
            if (i >= len(flags) || !flags[i]) {
                i = i + 1
                continue
            }
            let a = args[i]
            if (let some(name) = this.manualMoveSource(a.value)) {
                this.markMoved(name)
            } else if (this.isFreshAllocation(a.value)) {
                this.consumeOwned(a.value)
            } else {
                this.errNote(
                    a.span,
                    "parameter #{(i + 1)} is `#[manualAlloc]` and takes ownership of its argument",
                    "pass a `#[manualAlloc]` binding or a fresh allocation",
                )
            }
            i = i + 1
        }
    }

    /// Snapshot the consumption state (`moved`, `freed`) of every live local,
    /// so a branch can be analysed from the state at the join point and merged
    /// afterwards.
    fn captureMoved() -> List<Map<string, MovedBits>> {
        var out = emptyMovedList()
        for (s in this.scopes) {
            var snap = emptyMapStrMoved()
            for (k in s.keys()) {
                snap[k] = MovedBits(s[k].moved, s[k].freed)
            }
            out.push(snap)
        }
        out
    }

    fn setMoved( state: List<Map<string, MovedBits>>) {
        var i = 0
        while (i < len(this.scopes) && i < len(state)) {
            let scope = this.scopes[i]
            for (k in scope.keys()) {
                if (let some(bits) = state[i].get(k)) {
                    scope[k].moved = bits.moved
                    scope[k].freed = bits.freed
                }
            }
            i = i + 1
        }
    }

    /// Union the consumption bits of `b` into `a` (a value consumed on *either*
    /// path must be treated as consumed after the join).
    fn unionMoved(a: List<Map<string, MovedBits>>, b: List<Map<string, MovedBits>>) {
        var i = 0
        while (i < len(a) && i < len(b)) {
            let sa = a[i]
            let sb = b[i]
            for (k in sb.keys()) {
                let bm = sb[k]
                if (let some(am) = sa.get(k)) {
                    let nm = MovedBits(am.moved || bm.moved, am.freed || bm.freed)
                    sa[k] = nm
                } else {
                    sa[k] = MovedBits(bm.moved, bm.freed)
                }
            }
            i = i + 1
        }
    }

    fn markFreed( name: string) {
        var i = len(this.scopes) - 1
        while (i >= 0) {
            if (let some(l) = this.scopes[i].get(name)) {
                l.freed = true
                return
            }
            i = i - 1
        }
    }

    fn lookup( name: string) -> Local? {
        var i = len(this.scopes) - 1
        while (i >= 0) {
            if (let some(l) = this.scopes[i].get(name)) {
                return l
            }
            i = i - 1
        }
        none
    }

    fn err( span: Span, msg: string) {
        if (let some(code) = classifyMessage(msg)) {
            this.diags.emit(Diagnostic.errorAt(span, msg).withCode(code))
        } else {
            this.diags.emit(Diagnostic.errorAt(span, msg))
        }
    }

    fn errNote( span: Span, msg: string, note: string) {
        if (let some(code) = classifyMessage(msg)) {
            this.diags.emit(Diagnostic.errorAt(span, msg).withCode(code).note(note))
        } else {
            this.diags.emit(Diagnostic.errorAt(span, msg).note(note))
        }
    }

    // ---- assignability -----------------------------------------------------

    /// Is `got` acceptable where `want` is declared?
    fn okTypes( want: Ty, got: Ty) -> bool {
        if (got == Ty.Unknown || want == Ty.Unknown) {
            return true
        }
        match (want) {
            case Ty.Var(_) -> { return true }
            case _ -> {}
        }
        if (tyEq(got, want)) {
            return true
        }
        // `&T` reference parameters accept the bare value `T` by implicit
        // borrow; a raw `*T` argument is NOT accepted.
        match (want) {
            case Ty.Ref(inner) -> {
                if (this.okTypes(inner, got)) {
                    return true
                }
            }
            case _ -> {}
        }
        // none -> T?
        if (isNone(got) && isOption(want)) {
            return true
        }
        if (isOption(want)) {
            if (isOption(got)) {
                let wi = innerOption(want)
                let gi = innerOption(got)
                if (let some(w) = wi) {
                    if (let some(g) = gi) {
                        return this.okTypes(w, g)
                    }
                }
            }
            if (let some(w) = innerOption(want)) {
                return this.okTypes(w, got)
            }
        }
        // A `Map` widens when its key or value types widen through the same
        // option rules (e.g. a `Map<int, V>` literal satisfies a
        // `Map<int?, V>` binding). Container covariance is otherwise rejected.
        match (want) {
            case Ty.Map(kw, vw) -> match (got) {
                case Ty.Map(kg, vg) -> {
                    var keyOpt = isOption(kw) || isOption(kg)
                    var valOpt = isOption(vw) || isOption(vg)
                    if ((keyOpt || valOpt) && this.okTypes(kw, kg) && this.okTypes(vw, vg)) {
                        return true
                    }
                }
                case _ -> {}
            }
            case _ -> {}
        }
        // class implements interface?
        if (let some(gotn) = named(got)) {
            if (let some(wantn) = named(want)) {
                if (gotn != wantn) {
                    if (this.implementsInterface(gotn, wantn)) {
                        return true
                    }
                    if (this.conformsTo(got, want)) {
                        return true
                    }
                }
                // A subclass/descendant `got` is assignable to an ancestor.
                match (want) {
                    case Ty.Class(_, _) -> {
                        if (this.isAncestor(wantn, gotn)) {
                            return true
                        }
                    }
                    case Ty.Struct(_, _) -> {
                        if (this.isAncestor(wantn, gotn)) {
                            return true
                        }
                    }
                    case _ -> {}
                }
            }
        }
        // Function types: parameters are contravariant, result covariant.
        match (got) {
            case Ty.Fn(gp, gr) -> match (want) {
                case Ty.Fn(wp, wr) -> {
                    if (len(gp) != len(wp)) {
                        return false
                    }
                    var i = 0
                    while (i < len(gp)) {
                        if (gp[i] == Ty.Unknown || wp[i] == Ty.Unknown) {
                            i = i + 1
                            continue
                        }
                        // contravariance: callee params may accept a wider type
                        if (!this.okTypes(gp[i], wp[i])) {
                            return false
                        }
                        i = i + 1
                    }
                    if (gr == Ty.Unknown || wr == Ty.Unknown) {
                        return true
                    }
                    return this.okTypes(gr, wr)
                }
                case _ -> {}
            }
            case _ -> {}
        }
        false
    }

    fn checkAssignable( want: Ty, got: Ty, span: Span, what: string) {
        if (!this.okTypes(want, got)) {
            this.errNote(
                span,
                "type mismatch in {what}: expected `{bareName(want)}`, found `{bareName(got)}`",
                "`{bareName(got)}` does not satisfy `{bareName(want)}`; use `as` for an explicit conversion",
            )
        }
    }

    /// `checkAssignable`, except a `byte` target also accepts an `int` literal
    /// in 0..=255 or an ASCII `char` literal.
    fn checkAssignRhs( want: Ty, got: Ty, value: Expr, span: Span, what: string) {
        if (want == Ty.Byte) {
            match (value.kind) {
                case ExprKind.Lit(lit) -> {
                    let fitsByte = match (lit) {
                        case Lit.Int(v) -> v >= 0 && v <= 255
                        case Lit.Char(c) -> (c as int) <= 0x7F
                        case _ -> false
                    }
                    if (fitsByte) {
                        return
                    }
                }
                case _ -> {}
            }
        }
        this.checkAssignable(want, got, span, what)
    }

    /// `&T` is supported only as a function parameter type.
    fn guardRefUse( ty: Ty, span: Span, whereStr: string) {
        match (ty) {
            case Ty.Ref(_) -> {
                this.err(span, "`&T` references are supported only as function parameter types ({whereStr})")
            }
            case _ -> {}
        }
    }

    // ---- type table lookups ------------------------------------------------

    fn classTable( name: string) -> ClassTable? {
        if (let some(e) = this.resolved.types.get(name)) {
            match (e) {
                case TypeTableEntry.Class(t) -> t
                case TypeTableEntry.Struct(t) -> t
                case _ -> none
            }
        } else {
            none
        }
    }

    /// Substitute concrete args for a type's generic `Var`s.
    fn substTy( ty: Ty, args: Map<string, Ty>) -> Ty {
        subst(ty, args)
    }

    /// The `(name, generic-args)` pair that backs this type for member lookup.
    fn typeKey( ty: Ty) -> TypeKey? {
        match (ty) {
            case Ty.Class(n, a) -> this.typeKeyNamed(n, a)
            case Ty.Struct(n, a) -> this.typeKeyNamed(n, a)
            case Ty.Enum(n, a) -> this.typeKeyNamed(n, a)
            case Ty.Interface(n, _) -> TypeKey(n, emptyMapStrTy())
            case _ -> none
        }
    }

    fn typeKeyNamed( n: string, a: List<Ty>) -> TypeKey {
        var params = emptyStrList()
        if (let some(e) = this.resolved.types.get(n)) {
            params = entryGenerics(e)
        }
        var map = emptyMapStrTy()
        var i = 0
        while (i < len(params)) {
            if (i < len(a)) {
                map[params[i]] = a[i]
            } else {
                map[params[i]] = Ty.Unknown
            }
            i = i + 1
        }
        TypeKey(n, map)
    }

    fn implementsInterface( cls: string, iface: string) -> bool {
        var pending = [cls]
        var seen = emptyStrList()
        while (len(pending) > 0) {
            let name = pending[len(pending) - 1]
            pending.pop()
            if (listHasStr(seen, name)) {
                continue
            }
            seen.push(name)
            let table = this.classTable(name)
            if (let none = table) {
                continue
            }
            if (let some(t) = table) {
                var foundIface = false
                for (i in t.implements) {
                    if (let some(nm) = named(i)) {
                        if (nm == iface) {
                            foundIface = true
                        }
                    }
                }
                if (foundIface) {
                    return true
                }
                if (let some(p) = t.extends) {
                    if (let some(nm) = named(p)) {
                        pending.push(nm)
                    }
                }
            }
        }
        false
    }

    /// The element type `T` of an `Iterable<T>`, or `none`.
    fn iterableElem( ty: Ty) -> Ty? {
        match (ty) {
            case Ty.Interface(n, args) -> {
                if (n == "Iterable") {
                    if (len(args) > 0) {
                        return args[0]
                    } else {
                        return Ty.Unknown
                    }
                } else {
                    return none
                }
            }
            case _ -> {}
        }
        if (let none = this.typeKey(ty)) {
            return none
        }
        match (this.typeKey(ty)) {
            case some(tk) -> {
                var chain = [tk.name]
                var seen = emptyStrList()
                while (len(chain) > 0) {
                    let cname = chain[len(chain) - 1]
                    chain.pop()
                    if (listHasStr(seen, cname)) {
                        continue
                    }
                    seen.push(cname)
                    match (this.classTable(cname)) {
                        case some(t) -> {
                            for (i in t.implements) {
                                match (i) {
                                    case Ty.Interface(iname, iargs) -> {
                                        if (iname == "Iterable") {
                                            var el = Ty.Unknown
                                            if (len(iargs) > 0) {
                                                el = iargs[0]
                                            }
                                            return this.substTy(el, tk.args)
                                        }
                                    }
                                    case _ -> {}
                                }
                            }
                            if (let some(p) = t.extends) {
                                if (let some(nm) = named(p)) {
                                    chain.push(nm)
                                }
                            }
                        }
                        case none -> {}
                    }
                }
            }
            case none -> {}
        }
        none
    }

    /// True if `desc` extends/structurally inherits `anc` through the class
    /// chain (used for upcast/downcast checks in casts).
    fn isAncestor( anc: string, desc: string) -> bool {
        var pending = [desc]
        var seen = emptyStrList()
        while (len(pending) > 0) {
            let name = pending[len(pending) - 1]
            pending.pop()
            if (name == anc) {
                return true
            }
            if (listHasStr(seen, name)) {
                continue
            }
            seen.push(name)
            if (let some(t) = this.classTable(name)) {
                if (let some(p) = t.extends) {
                    if (let some(nm) = named(p)) {
                        pending.push(nm)
                    }
                }
            }
        }
        false
    }

    /// True if `got`'s declared interfaces include `want` (or an ancestor).
    fn conformsTo( got: Ty, want: Ty) -> bool {
        match (named(got)) {
            case some(gotn) -> {
                match (named(want)) {
                    case some(wantn) -> {
                        if (wantn == gotn) {
                            return true
                        }
                        let isIface = match (want) {
                            case Ty.Interface(_, _) -> true
                            case _ -> false
                        }
                        if (!isIface) {
                            return false
                        }
                        this.implementsInterface(gotn, wantn)
                    }
                    case none -> false
                }
            }
            case none -> false
        }
    }

    // ---- member lookup -----------------------------------------------------

    fn findField( cls: string, name: string, args: Map<string, Ty>) -> FieldInfo? {
        var chain = [cls]
        var seen = emptyStrList()
        while (len(chain) > 0) {
            let cname = chain[len(chain) - 1]
            chain.pop()
            if (listHasStr(seen, cname)) {
                continue
            }
            seen.push(cname)
            match (this.classTable(cname)) {
                case some(t) -> {
                    for (f in t.fields) {
                        if (f.name == name) {
                            return f
                        }
                    }
                    for (f in t.consts) {
                        if (f.name == name) {
                            return f
                        }
                    }
                    if (let some(p) = t.extends) {
                        if (let some(nm) = named(p)) {
                            chain.push(nm)
                        }
                    }
                }
                case none -> {}
            }
        }
        let _ = args
        none
    }

    fn findMethod( cls: string, name: string) -> CallableInfo? {
        var chain = [cls]
        var seen = emptyStrList()
        while (len(chain) > 0) {
            let cname = chain[len(chain) - 1]
            chain.pop()
            if (listHasStr(seen, cname)) {
                continue
            }
            seen.push(cname)
            match (this.classTable(cname)) {
                case some(t) -> {
                    for (m in t.methods) {
                        if (m.name == name) {
                            return m
                        }
                    }
                    if (let some(p) = t.extends) {
                        if (let some(nm) = named(p)) {
                            chain.push(nm)
                        }
                    }
                }
                case none -> {}
            }
        }
        none
    }

    fn findProperty( cls: string, name: string) -> PropertyInfo? {
        if (let some(t) = this.classTable(cls)) {
            for (p in t.properties) {
                if (p.name == name) {
                    return p
                }
            }
        }
        none
    }

    fn findNamedCtor( cls: string, name: string) -> CtorInfo? {
        if (let some(t) = this.classTable(cls)) {
            for (nc in t.namedCtors) {
                if (nc.name == name) {
                    return nc.ctor
                }
            }
        }
        none
    }

    /// The instance field names that carry an initializer in the class/struct
    /// declaration, used to derive the synthesized constructor's parameters.
    fn initializedFields( name: string) -> List<string> {
        var members: List<ClassMember>? = none
        for (item in this.prog.items) {
            match (item.kind) {
                case ItemKind.Class(c) -> {
                    if (c.name == name) {
                        members = c.members
                    }
                }
                case ItemKind.Struct(s) -> {
                    if (s.name == name) {
                        members = s.members
                    }
                }
                case _ -> {}
            }
        }
        var out = emptyStrList()
        if (let some(ms) = members) {
            for (m in ms) {
                match (m) {
                    case ClassMember.Field(name, _, init, _, isStatic, _, _, _) -> {
                        if (let some(_) = init) {
                            if (!isStatic) {
                                out.push(name)
                            }
                        }
                    }
                    case _ -> {}
                }
            }
        }
        out
    }

    /// Parameter types of the constructor a named constructor delegates to.
    fn primaryCtorParamTys( table: ClassTable) -> List<Ty> {
        if (let some(c) = table.ctor) {
            var out = emptyTys()
            for (p in c.params) {
                out.push(p.ty)
            }
            out
        } else {
            this.synthesizedCtorParamTys(table.name)
        }
    }

    /// The nearest explicit-primary-constructor ancestor of `name` together
    /// with the number of instance-field slots belonging to classes up to and
    /// including that ancestor.
    fn nearestExplicitPrimaryFieldCount( name: string) -> FieldCount? {
        var chain = [name]
        var cur = name
        var done = false
        while (len(chain) < 64 && !done) {
            let t = this.classTable(cur)
            let parent = none
            if (let some(tb) = t) {
                if (let some(e) = tb.extends) {
                    if (let some(nm) = named(e)) {
                        chain.push(nm)
                        cur = nm
                        continue
                    }
                }
            }
            let _ = parent
            done = true
        }
        var rev = emptyStrList()
        var c = len(chain) - 1
        while (c >= 0) {
            rev.push(chain[c])
            c = c - 1
        }
        var found: FieldCount? = none
        var count = 0
        for (cname in rev) {
            let t = this.classTable(cname)
            var own = 0
            if (let some(tb) = t) {
                for (f in tb.fields) {
                    if (!f.isStatic) {
                        own = own + 1
                    }
                }
            }
            if (let some(tb) = t) {
                if (let some(_) = tb.ctor) {
                    found = FieldCount(cname, count + own)
                }
            }
            count = count + own
        }
        found
    }

    /// Synthesized-constructor parameter types for `name`.
    fn synthesizedCtorParamTys( name: string) -> List<Ty> {
        var out = emptyTys()
        var cut = 0
        if (let some(fc) = this.nearestExplicitPrimaryFieldCount(name)) {
            if (let some(t) = this.classTable(fc.name)) {
                if (let some(c) = t.ctor) {
                    for (p in c.params) {
                        out.push(p.ty)
                    }
                }
            }
            cut = fc.count
        }
        var chain = [name]
        var cur = name
        while (len(chain) < 64) {
            if (let some(t) = this.classTable(cur)) {
                if (let some(e) = t.extends) {
                    if (let some(nm) = named(e)) {
                        chain.push(nm)
                        cur = nm
                        continue
                    }
                }
            }
            break
        }
        var rev = emptyStrList()
        var c = len(chain) - 1
        while (c >= 0) {
            rev.push(chain[c])
            c = c - 1
        }
        var count = 0
        for (cname in rev) {
            if (let some(t) = this.classTable(cname)) {
                var own = 0
                for (f in t.fields) {
                    if (!f.isStatic) {
                        own = own + 1
                    }
                }
                if (count >= cut) {
                    let initialized = this.initializedFields(cname)
                    for (f in t.fields) {
                        if (!f.isStatic && !listHasStr(initialized, f.name)) {
                            out.push(f.ty)
                        }
                    }
                }
                count = count + own
            }
        }
        out
    }

    /// Check a named constructor: the body must be exactly one `this(...)`
    /// delegation to the primary constructor.
    fn checkNamedCtorBody( cd: ConstructorDecl, table: ClassTable) {
        match (namedCtorDelegation(cd.body)) {
            case none -> {
                this.err(cd.span, "named constructor body must be a single `this(...)` delegation to the primary constructor")
            }
            case some(call) -> {
                let params = this.primaryCtorParamTys(table)
                this.namedCtorParams = params
                this.namedCtorDelegated = false
                let _ = this.checkExpr(call)
                this.namedCtorParams = none
                this.namedCtorDelegated = false
            }
        }
    }

    // ---- bodies ------------------------------------------------------------

    /// Validate `#[...]` attributes on a parameter and report whether it is
    /// `#[manualAlloc]` (the function takes ownership of the argument).
    fn checkParamAttributes( p: Param) -> bool {
        var manual = false
        for (a in p.attrs) {
            if (a.name == "manualAlloc") {
                if (len(a.args) > 0) {
                    this.err(a.span, "`#[manualAlloc]` takes no arguments")
                }
                if (manual) {
                    this.err(a.span, "duplicate `#[manualAlloc]` attribute")
                }
                manual = true
            } else {
                this.err(a.span, "unknown attribute `#[{a.name}]`")
            }
        }
        manual
    }

    /// Validate `#[...]` field attributes and report whether the field is
    /// `#[manualAlloc]` (owned, freed recursively with its object).
    fn checkFieldAttributes( attrs: List<Attribute>, ty: Ty?, isStatic: bool, isConst: bool, span: Span) -> bool {
        var manual = false
        for (a in attrs) {
            if (a.name == "manualAlloc") {
                if (len(a.args) > 0) {
                    this.err(a.span, "`#[manualAlloc]` takes no arguments")
                }
                if (manual) {
                    this.err(a.span, "duplicate `#[manualAlloc]` attribute")
                }
                manual = true
            } else {
                this.err(a.span, "unknown attribute `#[{a.name}]`")
            }
        }
        if (manual) {
            if (isStatic) {
                this.err(span, "`#[manualAlloc]` is not supported on static fields")
            }
            if (isConst) {
                this.err(span, "`#[manualAlloc]` is not supported on constants")
            }
            if (let some(t) = ty) {
                if (!isClassOrStruct(t)) {
                    this.errNote(
                        span,
                        "`#[manualAlloc]` field must be a class or struct type, found `{bareName(t)}`",
                        "ownership applies to class/struct instances",
                    )
                }
            }
        }
        manual
    }

    /// Treat `value` as an owned position: move a manual binding, accept a fresh
    /// allocation, or reject anything else. `what` names the destination.
    fn consumeIntoOwned( value: Expr, span: Span, what: string) {
        if (let some(src) = this.manualMoveSource(value)) {
            this.markMoved(src)
        } else if (this.isFreshAllocation(value)) {
            this.consumeOwned(value)
        } else {
            this.errNote(
                span,
                "{what} takes ownership of its value",
                "assign a `#[manualAlloc]` binding or a fresh allocation",
            )
        }
    }

    fn resolvedFnTy( te: TypeExpr, generics: List<string>) -> Ty {
        // Resolve against the final module tables, so user-defined types and
        // this module's generics are visible.
        var g = copyStrList(generics)
        if (let some(sty) = this.selfTy) {
            if (let some(gt) = this.typeKey(sty)) {
                for (k in gt.args.keys()) {
                    if (!listHasStr(g, k)) {
                        g.push(k)
                    }
                }
            }
        }
        this.resolved.resolveTy(te, this.instantiatedGenerics(g), this.diags)
    }

    fn instantiatedGenerics( generics: List<string>) -> List<string> {
        generics
    }

    fn resolveParamTy( p: Param) -> Ty {
        if (let some(te) = p.ty) {
            var generics = copyStrList(this.fnGenerics)
            if (let some(sty) = this.selfTy) {
                if (let some(gt) = this.typeKey(sty)) {
                    for (k in gt.args.keys()) {
                        generics.push(k)
                    }
                }
            }
            this.resolvedFnTy(te, generics)
        } else {
            Ty.Unknown
        }
    }

    fn checkFnSignatureBodies( f: FnDecl, attrs: List<Attribute>) {
        this.pushScope()
        this.fnGenerics = emptyStrList()
        for (g in f.generics) {
            this.fnGenerics.push(g.name)
        }
        this.retTy = Ty.Empty
        if (let some(fns) = this.resolved.fns.get(f.name)) {
            if (len(fns) > 0) {
                this.retTy = fns[0].ret
            }
        }
        this.guardRefUse(this.retTy, f.span, "a return type")
        this.retManual = false
        for (a in attrs) {
            if (a.name == "manualAlloc") {
                this.retManual = true
            }
        }
        if (this.retManual && !isClassOrStruct(this.retTy)) {
            this.errNote(
                f.span,
                "`#[manualAlloc]` on a function requires a class or struct return type",
                "the caller receives ownership of the returned instance",
            )
        }
        for (p in f.params) {
            let manual = this.checkParamAttributes(p)
            let ty = this.resolveParamTy(p)
            this.declare(p.name, ty, true)
            if (manual) {
                if (!isClassOrStruct(ty)) {
                    this.errNote(
                        p.span,
                        "`#[manualAlloc]` parameter `{p.name}` must be a class or struct type",
                        "ownership applies to class/struct instances",
                    )
                }
                this.markManual(p.name)
            }
            if (let some(d) = p.default) {
                let dt = this.checkExpr(d)
                this.checkAssignable(this.resolveParamTy(p), dt, p.span, "default argument")
            }
        }
        if (let some(body) = f.body) {
            this.checkFnBody(body)
        }
        this.retTy = Ty.Empty
        this.retManual = false
        this.fnGenerics = emptyStrList()
        this.popScope()
    }

    fn checkFnBody( body: FnBody) {
        match (body) {
            case FnBody.Block(b) -> {
                let exprTy = this.checkBlock(b)
                this.checkReturnExpr(exprTy, b.span)
                if (let some(e) = b.expr) {
                    this.checkOwnedTail(e)
                }
            }
            case FnBody.Expr(e) -> {
                let t = this.checkExpr(e)
                this.checkReturnExpr(t, e.span)
                this.checkOwnedTail(e)
            }
        }
    }

    /// Handle a block/expression tail value as an ownership position: either it
    /// is the owned return of a `#[manualAlloc]` function, or a leaked result.
    fn checkOwnedTail( e: Expr) {
        if (this.retManual) {
            this.consumeOwned(e)
        } else if (removeSpan(this.pendingOwnedCalls, e.span)) {
            this.errNote(
                e.span,
                "result of a `#[manualAlloc]` function is owned by the caller",
                "bind it with `#[manualAlloc] let`, pass it to an owned parameter, or return it",
            )
        }
    }

    fn checkReturnExpr( got: Ty, span: Span) {
        if (this.retTy != Ty.Empty && got != Ty.Empty) {
            this.checkAssignable(this.retTy, got, span, "return value")
        }
    }

    fn checkBlock( b: Block) -> Ty {
        this.pushScope()
        var last = Ty.Empty
        for (s in b.stmts) {
            last = this.checkStmt(s)
        }
        if (let some(e) = b.expr) {
            last = this.checkExpr(e)
        }
        this.popScope()
        last
    }

    /// Check one statement, then report any `#[manualAlloc]`-returning call
    /// whose result was not consumed into an owned position within it.
    fn checkStmt( s: Stmt) -> Ty {
        let before = copySpanList(this.pendingOwnedCalls)
        let t = this.checkStmtInner(s)
        var leaked = emptySpanList()
        for (sp in this.pendingOwnedCalls) {
            if (!hasSpan(before, sp)) {
                leaked.push(sp)
            }
        }
        for (sp in leaked) {
            this.errNote(
                sp,
                "result of a `#[manualAlloc]` function is owned by the caller",
                "bind it with `#[manualAlloc] let`, pass it to an owned parameter, or return it",
            )
            removeSpan(this.pendingOwnedCalls, sp)
        }
        t
    }

    fn checkStmtInner( s: Stmt) -> Ty {
        match (s) {
            case Stmt.Let(pattern, ty, init, mutable, attrs, span) -> {
                let manual = this.checkLetAttributes(attrs)
                var hasAnnotated = false
                var annotatedTy = Ty.Unknown
                if (let some(te) = ty) {
                    hasAnnotated = true
                    annotatedTy = this.resolvedFnTy(te, this.fnGenerics)
                }
                match (pattern) {
                    case Pattern.Binding(_, ann) -> {
                        if (let some(ae) = ann) {
                            let at = this.resolvedFnTy(ae, this.fnGenerics)
                            this.guardRefUse(at, span, "a `let` binding")
                        }
                    }
                    case _ -> {}
                }
                if (hasAnnotated) {
                    this.guardRefUse(annotatedTy, span, "a `let` binding")
                }
                var hasInferred = false
                var inferredTy = Ty.Unknown
                if (let some(e) = init) {
                    hasInferred = true
                    inferredTy = this.checkExpr(e)
                }
                var finalTy = Ty.Unknown
                if (hasAnnotated && hasInferred) {
                    this.checkAssignable(annotatedTy, inferredTy, span, "initializer")
                    finalTy = annotatedTy
                } else if (hasAnnotated) {
                    finalTy = annotatedTy
                } else if (hasInferred) {
                    finalTy = inferredTy
                } else {
                    finalTy = Ty.Unknown
                }
                let movedFrom = if (let some(e) = init) { this.manualMoveSource(e) } else { none }
                if (manual) {
                    if (let some(src) = movedFrom) {
                        // Ownership transfer: `#[manualAlloc] let y = x`
                        // moves the allocation out of `x`.
                        this.markMoved(src)
                    } else if (let none = init) {
                        this.err(span, "`#[manualAlloc]` requires an allocation initializer")
                    } else if (!isClassOrStruct(finalTy)) {
                        this.errNote(
                            span,
                            "`#[manualAlloc]` requires a class or struct type, found `{bareName(finalTy)}`",
                            "manual allocation applies to class/struct instances",
                        )
                    } else if (let some(i) = init) {
                        // A `#[manualAlloc]` function result is consumed here.
                        this.consumeOwned(i)
                    }
                } else if (let some(src) = movedFrom) {
                    this.errNote(
                        span,
                        "cannot bind `#[manualAlloc]` value `{src}` to a managed binding",
                        "take ownership with `#[manualAlloc] let ... = {src}`, or `{src}.free()`",
                    )
                }
                this.bindPattern(pattern, finalTy, mutable, span)
                if (manual) {
                    match (pattern) {
                        case Pattern.Binding(name, _) -> this.markManual(name)
                        case _ -> {}
                    }
                }
                finalTy
            }
            case Stmt.Const(name, ty, value, span) -> {
                let vt = this.checkExpr(value)
                if (let some(t) = ty) {
                    let tt = this.resolvedFnTy(t, this.fnGenerics)
                    this.guardRefUse(tt, span, "a `const` binding")
                    this.checkAssignable(tt, vt, span, "const initializer")
                    this.declare(name, tt, false)
                } else {
                    this.declare(name, vt, false)
                }
                vt
            }
            case Stmt.Return(value, span) -> {
                let vt = if (let some(e) = value) { this.checkExpr(e) } else { Ty.Empty }
                let movedFrom = if (let some(e) = value) { this.manualMoveSource(e) } else { none }
                if (let some(src) = movedFrom) {
                    if (this.retManual) {
                        // Ownership passes to the caller.
                        this.markMoved(src)
                    } else {
                        this.errNote(
                            span,
                            "cannot return `#[manualAlloc]` value `{src}` from a function that does not own its result",
                            "mark the function `#[manualAlloc]` to transfer `{src}` to the caller",
                        )
                    }
                } else if (this.retManual) {
                    // A `#[manualAlloc]` function may return a fresh allocation
                    // or another owned call directly.
                    if (let some(e) = value) {
                        this.consumeOwned(e)
                    }
                }
                if (this.retTy == Ty.Empty) {
                    if (!isNoneExpr(value)) {
                        this.errNote(
                            span,
                            "cannot return a value from a function with no return type",
                            "declare a return type with `-> T`, or remove the value",
                        )
                    }
                } else {
                    this.checkAssignable(this.retTy, vt, span, "return value")
                }
                Ty.Empty
            }
            case Stmt.Break(span) -> {
                if (this.loopDepth == 0) {
                    this.err(span, "`break`/`continue` used outside of a loop")
                }
                Ty.Empty
            }
            case Stmt.Continue(span) -> {
                if (this.loopDepth == 0) {
                    this.err(span, "`break`/`continue` used outside of a loop")
                }
                Ty.Empty
            }
            case Stmt.While(cond, body, _span) -> {
                this.checkBoolCond(cond)
                this.loopDepth = this.loopDepth + 1
                this.checkBlock(body)
                this.loopDepth = this.loopDepth - 1
                Ty.Empty
            }
            case Stmt.For(header, body, _span) -> {
                this.checkForHeader(header)
                this.loopDepth = this.loopDepth + 1
                this.checkBlock(body)
                this.loopDepth = this.loopDepth - 1
                Ty.Empty
            }
            case Stmt.Try(body, binder, handler, fin, _span) -> {
                this.checkTry(body, binder, handler, fin)
                Ty.Empty
            }
            case Stmt.Throw(value, span) -> {
                let t = this.checkExpr(value)
                if (t != Ty.Unknown && t != Ty.String) {
                    this.errNote(span, "a `throw` payload must be a `string`", "found `{bareName(t)}`")
                }
                Ty.Empty
            }
            case Stmt.Expr(e) -> {
                let _ = this.checkExpr(e)
                Ty.Empty
            }
            case Stmt.Empty(_span) -> Ty.Empty
        }
    }

    /// `try BODY catch (BINDER)? BLOCK finally BLOCK?`
    ///
    /// The payload is a `string`, so a handler always knows what it holds. The
    /// binder is declared in its own scope so the handler nests inside it rather
    /// than leaking `e` into whatever follows the `try`.
    fn checkTry(body: Block, binder: string?, handler: Block?, fin: Block?) {
        this.checkBlock(body)
        var hasHandler = false
        if (let some(h) = handler) {
            hasHandler = true
            if (let some(name) = binder) {
                this.pushScope()
                this.declare(name, Ty.String, false)
                this.checkBlock(h)
                this.popScope()
            } else {
                this.checkBlock(h)
            }
        }
        if (let some(f) = fin) {
            this.checkBlock(f)
        }
    }

    fn checkBoolCond( e: Expr) {
        let t = this.checkExpr(e)
        if (t != Ty.Unknown && t != Ty.Bool) {
            this.errNote(e.span, "condition must be a `bool`", "found `{bareName(t)}`")
        }
    }

    fn checkForHeader( header: ForHeader) {
        match (header) {
            case ForHeader.In(pattern, sequence) -> {
                // Iterating an immutable `&T` borrow iterates its referent.
                var st = this.checkExpr(sequence)
                match (st) {
                    case Ty.Ref(inner) -> {
                        st = inner
                    }
                    case _ -> {}
                }
                let elemT = match (st) {
                    case Ty.List(_) -> {
                        if (let some(e) = elem(st)) {
                            e
                        } else {
                            Ty.Unknown
                        }
                    }
                    case Ty.Range(_) -> {
                        if (let some(e) = elem(st)) {
                            e
                        } else {
                            Ty.Unknown
                        }
                    }
                    case Ty.Map(k, v) -> {
                        let mapElem = if (let some(e) = elem(st)) { e } else { Ty.Unknown }
                        match (pattern) {
                            case Pattern.Tuple(parts) -> {
                                if (len(parts) != 2) {
                                    this.err(sequence.span, "map entries pattern must bind exactly two names `(k, v)`")
                                    Ty.Unknown
                                } else {
                                    Ty.Tuple([k, v])
                                }
                            }
                            case _ -> mapElem
                        }
                    }
                    case Ty.String -> Ty.Byte
                    case Ty.Unknown -> Ty.Unknown
                    case _ -> {
                        if (let some(e) = this.iterableElem(st)) {
                            e
                        } else {
                            this.errNote(
                                sequence.span,
                                "`for (x in ...)` requires a sequence (List, string, Map, range, or an `Iterable<T>`), found `{bareName(st)}`",
                                "found `{bareName(st)}`",
                            )
                            Ty.Unknown
                        }
                    }
                }
                this.bindPattern(pattern, elemT, true, sequence.span)
            }
            case ForHeader.Range(init, cond, step) -> {
                let _ = this.checkStmt(init)
                this.checkBoolCond(cond)
                let _ = this.checkExpr(step)
            }
        }
    }

    fn bindPattern( p: Pattern, ty: Ty, mutable: bool, span: Span) {
        match (p) {
            case Pattern.Wildcard -> {}
            case Pattern.Binding(name, ann) -> {
                // A pattern annotation like `let m: int?` is parsed into the
                // pattern; it wins over the inferred value type and is checked
                // against it.
                if (let some(te) = ann) {
                    let at = this.resolvedFnTy(te, this.fnGenerics)
                    if (ty != Ty.Unknown) {
                        this.checkAssignable(at, ty, span, "binding")
                    }
                    this.declare(name, at, mutable)
                } else {
                    this.declare(name, ty, mutable)
                }
            }
            case Pattern.Literal(_l) -> {}
            case Pattern.Tuple(parts) -> {
                match (ty) {
                    case Ty.Tuple(tys) -> {
                        var i = 0
                        while (i < len(parts)) {
                            let pt = if (i < len(tys)) { tys[i] } else { Ty.Unknown }
                            this.bindPattern(parts[i], pt, mutable, span)
                            i = i + 1
                        }
                    }
                    case _ -> {
                        if (ty != Ty.Unknown) {
                            this.err(span, "tuple pattern does not match a tuple value")
                        }
                    }
                }
            }
            case Pattern.Variant(path, payloads) -> {
                // `some(v)` binds the payload against an option scrutinee.
                if (len(path) == 1 && path[0] == "some" && isOption(ty)) {
                    let inner = if (let some(x) = innerOption(ty)) { x } else { Ty.Unknown }
                    if (len(payloads) != 1) {
                        this.err(span, "`some` pattern takes exactly one payload binding")
                    } else {
                        this.bindPattern(payloads[0], inner, mutable, span)
                    }
                } else {
                    // `Enum.Variant(p1, p2)` binding. If only the variant name
                    // is given, the enum type is inferred from the value.
                    var enumName = ""
                    var variantName = ""
                    var resolvedName = true
                    if (len(path) == 2) {
                        enumName = path[0]
                        variantName = path[1]
                        false
                    } else if (len(path) == 1) {
                        match (ty) {
                            case Ty.Enum(en, _) -> {
                                enumName = en
                                variantName = path[0]
                                false
                            }
                            case _ -> {
                                if (ty != Ty.Unknown) {
                                    this.err(span, "enum variant pattern requires a value of enum type")
                                }
                                resolvedName = false
                                false
                            }
                        }
                    } else {
                        resolvedName = false
                    }
                    if (resolvedName && ty != Ty.Unknown) {
                        if (let some(entry) = this.resolved.types.get(enumName)) {
                            match (entry) {
                                case TypeTableEntry.Enum(t) -> {
                                    var variant: EnumVariantInfo? = none
                                    for (v in t.variants) {
                                        if (v.name == variantName) {
                                            variant = v
                                        }
                                    }
                                    if (let some(v) = variant) {
                                        var i = 0
                                        while (i < len(payloads)) {
                                            let ft = if (i < len(v.fields)) { v.fields[i] } else { Ty.Unknown }
                                            this.bindPattern(payloads[i], ft, mutable, span)
                                            i = i + 1
                                        }
                                    } else {
                                        this.err(span, "enum `{enumName}` has no variant `{variantName}`")
                                    }
                                }
                                case _ -> {}
                            }
                        }
                    }
                }
            }
            case Pattern.Or(parts) -> {
                for (part in parts) {
                    this.bindPattern(part, ty, mutable, span)
                }
            }
        }
    }

    // ---- bodies ------------------------------------------------------------

    /// Validate a single field declaration: type annotation, initializer,
    /// `#[manualAlloc]` ownership. Shared by class and struct bodies.
    fn checkFieldDecl(
        typeName: string,
        fname: string,
        fty: TypeExpr?,
        init: Expr?,
        isStatic: bool,
        isConst: bool,
        attrs: List<Attribute>,
        span: Span,
        generics: List<string>
    ) {
        match (init) {
            case some(e) -> {
                let ft = this.checkExpr(e)
                var w = Ty.Unknown
                if (let some(te) = fty) {
                    w = this.resolvedFnTy(te, generics)
                    this.guardRefUse(w, span, "a field")
                }
                if (let none = fty) {
                    // Fall back to the resolved table's field type, with the
                    // class generics substituted.
                    if (let some(entry) = this.resolved.types.get(typeName)) {
                        match (entry) {
                            case TypeTableEntry.Class(t) -> {
                                for (f in t.fields) {
                                    if (f.name == fname) {
                                        w = this.substTy(f.ty, this.selfArgs)
                                    }
                                }
                            }
                            case TypeTableEntry.Struct(t) -> {
                                for (f in t.fields) {
                                    if (f.name == fname) {
                                        w = this.substTy(f.ty, this.selfArgs)
                                    }
                                }
                            }
                            case _ -> {}
                        }
                    }
                }
                if (w == Ty.Unknown) {
                    w = ft
                }
                let manual = this.checkFieldAttributes(attrs, w, isStatic, isConst, span)
                if (manual) {
                    if (let none = fty) {
                        this.err(span, "owned field `{fname}` needs an explicit type annotation")
                    }
                }
                this.checkAssignable(w, ft, span, "field initializer")
                if (manual) {
                    this.consumeIntoOwned(e, span, "owned field")
                }
            }
            case none -> {
                var w0 = Ty.Unknown
                if (let some(te) = fty) {
                    w0 = this.resolvedFnTy(te, generics)
                    this.guardRefUse(w0, span, "a field")
                }
                let wOpt = if (w0 == Ty.Unknown) { none } else { w0 }
                let manual = this.checkFieldAttributes(attrs, wOpt, isStatic, isConst, span)
                if (manual) {
                    this.errNote(
                        span,
                        "owned field `{fname}` must be initialized where it is declared",
                        "give it an initializer such as `= Node(...)`",
                    )
                }
            }
        }
    }

    fn checkClassBodies( c: ClassDecl) {
        if (let some(table) = this.classTable(c.name)) {
            this.selfTy = Ty.Class(c.name, tyVars(table.generics))
            var args = emptyMapStrTy()
            for (g in table.generics) {
                args[g] = Ty.Var(g)
            }
            this.selfArgs = args
            for (m in c.members) {
                match (m) {
                    case ClassMember.Field(name, fty, init, _visibility, isStatic, isConst, attrs, span) -> {
                        this.checkFieldDecl(c.name, name, fty, init, isStatic, isConst, attrs, span, table.generics)
                    }
                    case ClassMember.Const(_cname, _visibility, cty, value, cspan) -> {
                        let vt = this.checkExpr(value)
                        if (let some(t) = cty) {
                            let tt = this.resolvedFnTy(t, table.generics)
                            this.checkAssignable(tt, vt, cspan, "const initializer")
                        }
                    }
                    case ClassMember.Method(md) -> this.checkMethodBody(md, table)
                    case ClassMember.Constructor(cd) -> {
                        this.pushScope()
                        this.retTy = Ty.Empty
                        this.fnGenerics = emptyStrList()
                        for (p in cd.params) {
                            let pt = this.resolveParamTy(p)
                            this.declare(p.name, pt, true)
                        }
                        if (let some(_nn) = cd.name) {
                            this.checkNamedCtorBody(cd, table)
                        } else {
                            // A `super(...)` delegation is only valid inside a
                            // primary constructor body of a class with a parent.
                            this.superCtorParams = none
                            if (let some(ps) = table.extends) {
                                if (let some(n) = named(ps)) {
                                    if (let some(pt) = this.classTable(n)) {
                                        this.superCtorParams = this.primaryCtorParamTys(pt)
                                    }
                                }
                            }
                            this.checkBlock(cd.body)
                            this.superCtorParams = none
                        }
                        this.popScope()
                    }
                    case ClassMember.Init(b) -> {
                        this.pushScope()
                        this.retTy = Ty.Empty
                        this.fnGenerics = emptyStrList()
                        let _ = this.checkBlock(b)
                        this.popScope()
                    }
                    case ClassMember.Deinit(b) -> {
                        this.pushScope()
                        this.retTy = Ty.Empty
                        this.fnGenerics = emptyStrList()
                        let _ = this.checkBlock(b)
                        this.popScope()
                    }
                    case ClassMember.Property(p) -> this.checkPropertyBodies(p, table.generics)
                }
            }
            this.selfTy = none
            this.selfArgs = emptyMapStrTy()
        }
    }

    fn checkStructBodies( s: StructDecl) {
        if (let some(table) = this.classTable(s.name)) {
            this.selfTy = Ty.Struct(s.name, tyVars(table.generics))
            var args = emptyMapStrTy()
            for (g in table.generics) {
                args[g] = Ty.Var(g)
            }
            this.selfArgs = args
            for (m in s.members) {
                match (m) {
                    case ClassMember.Field(name, fty, init, _visibility, isStatic, isConst, attrs, span) -> {
                        this.checkFieldDecl(s.name, name, fty, init, isStatic, isConst, attrs, span, table.generics)
                    }
                    case ClassMember.Method(md) -> this.checkMethodBody(md, table)
                    case ClassMember.Property(p) -> this.checkPropertyBodies(p, table.generics)
                    case _ -> {}
                }
            }
            this.selfTy = none
            this.selfArgs = emptyMapStrTy()
        }
    }

    fn checkMethodBody( md: MethodDecl, table: ClassTable) {
        this.pushScope()
        this.fnGenerics = emptyStrList()
        for (g in md.generics) {
            this.fnGenerics.push(g.name)
        }
        this.retTy = Ty.Empty
        if (let some(entry) = this.resolved.types.get(table.name)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    for (m in t.methods) {
                        if (m.name == md.name) {
                            this.retTy = m.ret
                        }
                    }
                }
                case TypeTableEntry.Struct(t) -> {
                    for (m in t.methods) {
                        if (m.name == md.name) {
                            this.retTy = m.ret
                        }
                    }
                }
                case _ -> {}
            }
        }
        this.guardRefUse(this.retTy, md.span, "a return type")
        // Declare `this` in scope.
        if (let some(st) = this.selfTy) {
            this.declare("this", st, false)
        }
        for (p in md.params) {
            let pt = this.resolveParamTy(p)
            this.declare(p.name, pt, true)
            if (let some(d) = p.default) {
                let dt = this.checkExpr(d)
                this.checkAssignable(pt, dt, p.span, "default argument")
            }
        }
        if (let some(body) = md.body) {
            this.checkFnBody(body)
        }
        this.retTy = Ty.Empty
        this.fnGenerics = emptyStrList()
        this.popScope()
    }

    /// Type-check a property's accessor bodies. The getter is a value of the
    /// property type and runs with `this` live; the setter receives the new
    /// value bound to `value` and reads `this`.
    fn checkPropertyBodies( p: PropertyDecl, generics: List<string>) {
        let pty = if (let some(te) = p.ty) { this.resolvedFnTy(te, generics) } else { Ty.Unknown }
        if (let some(get) = p.get) {
            this.pushScope()
            this.fnGenerics = emptyStrList()
            this.retTy = pty
            if (let some(st) = this.selfTy) {
                if (!p.isStatic) {
                    this.declare("this", st, false)
                }
            }
            let t = match (get) {
                case PropertyAccessor.Expr(e) -> this.checkExpr(e)
                case PropertyAccessor.Block(b) -> this.checkBlock(b)
            }
            if (t != Ty.Empty) {
                this.checkAssignable(pty, t, p.span, "property getter")
            }
            this.popScope()
        }
        if (let some(set) = p.set) {
            this.pushScope()
            this.fnGenerics = emptyStrList()
            this.retTy = Ty.Empty
            if (let some(st) = this.selfTy) {
                if (!p.isStatic) {
                    this.declare("this", st, false)
                }
            }
            this.declare("value", pty, true)
            let _ = match (set) {
                case PropertyAccessor.Expr(e) -> this.checkExpr(e)
                case PropertyAccessor.Block(b) -> this.checkBlock(b)
            }
            this.popScope()
        }
    }

    fn checkInterfaceConformance() {
        for (entry in this.resolved.types.values()) {
            var cname = ""
            var impls = emptyTyList()
            var skip = false
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    cname = t.name
                    impls = t.implements
                    skip
                }
                case TypeTableEntry.Struct(t) -> {
                    cname = t.name
                    impls = t.implements
                    skip
                }
                case TypeTableEntry.Enum(t) -> {
                    cname = t.name
                    impls = t.implements
                    skip
                }
                case TypeTableEntry.Interface(_) -> skip = true
            }
            if (skip) {
                continue
            }
            for (i in impls) {
                let ifaceName = if (let some(n) = named(i)) { n } else { "" }
                if (ifaceName == "") {
                    continue
                }
                if (let some(entry2) = this.resolved.types.get(ifaceName)) {
                    match (entry2) {
                        case TypeTableEntry.Interface(iface) -> {
                            for (member in iface.members) {
                                if (member.isProperty) {
                                    var hasProp = this.findProperty(cname, member.name)
                                    if (let none = hasProp) {
                                        if (let none = this.findField(cname, member.name, emptyMapStrTy())) {
                                            this.err(member.span, "`{cname}` declares `implements {ifaceName}` but has no member `{member.name}`")
                                        }
                                    }
                                } else if (let none = this.findMethod(cname, member.name)) {
                                    this.err(member.span, "`{cname}` declares `implements {ifaceName}` but has no method `{member.name}`")
                                }
                            }
                        }
                        case _ -> {}
                    }
                }
            }
        }
    }

// ---- expressions --------------------------------------------------------

    /// Typecheck an expression, recording its inferred type into the type map.
    fn checkExpr( e: Expr) -> Ty {
        let t = this.checkExprImpl(e)
        this.types[spanKey(e.span)] = t
        t
    }

    fn checkExprImpl( e: Expr) -> Ty {
        match (e.kind) {
            case ExprKind.Lit(Lit.String(parts)) -> this.stringTy(parts)
            case ExprKind.Lit(l) -> this.litTy(l)
            case ExprKind.Ident(name) -> this.identTy(e, name)
            case ExprKind.This -> {
                if (let some(st) = this.selfTy) {
                    st
                } else {
                    this.err(e.span, "`this` used outside of a class body")
                    Ty.Unknown
                }
            }
            case ExprKind.Super -> this.superTy(e)
            case ExprKind.Block(b) -> this.checkBlock(b)
            case ExprKind.Tuple(parts) -> {
                var ts = emptyTyList()
                for (p in parts) {
                    ts.push(this.checkExpr(p))
                }
                Ty.Tuple(ts)
            }
            case ExprKind.Array(parts) -> {
                if (len(parts) == 0) {
                    Ty.List(Ty.Unknown)
                } else {
                    let elem = this.checkExpr(parts[0])
                    var i = 1
                    while (i < len(parts)) {
                        let t = this.checkExpr(parts[i])
                        this.checkAssignable(elem, t, parts[i].span, "array element")
                        i = i + 1
                    }
                    Ty.List(elem)
                }
            }
            case ExprKind.Map(pairs) -> {
                if (len(pairs) == 0) {
                    Ty.Map(Ty.Unknown, Ty.Unknown)
                } else {
                    let k = this.checkExpr(pairs[0].key)
                    if (k != Ty.Unknown) {
                        var keyOk = false
                        match (k) {
                            case Ty.String -> keyOk = true
                            case Ty.Int -> keyOk = true
                            case Ty.Float -> keyOk = true
                            case Ty.Bool -> keyOk = true
                            case Ty.Char -> keyOk = true
                            case Ty.Byte -> keyOk = true
                            case Ty.List(_) -> keyOk = true
                            case Ty.Map(_, _) -> keyOk = true
                            case Ty.Class(_, _) -> keyOk = true
                            case Ty.Struct(_, _) -> keyOk = true
                            case Ty.Enum(_, _) -> keyOk = true
                            case Ty.Interface(_, _) -> keyOk = true
                            case Ty.Range(_) -> keyOk = true
                            case Ty.Option(_) -> keyOk = true
                            case Ty.Tuple(_) -> keyOk = true
                            case _ -> {}
                        }
                        if (!keyOk) {
                            this.err(pairs[0].key.span, "map keys must be `string`, `int`, `float`, `bool`, `char`, `byte`, a list, a map, a class/struct, an enum, an option, or a tuple, found `{bareName(k)}`")
                        }
                    }
                    let vt = this.checkExpr(pairs[0].value)
                    var mi = 1
                    while (mi < len(pairs)) {
                        let tk = this.checkExpr(pairs[mi].key)
                        let tv = this.checkExpr(pairs[mi].value)
                        this.checkAssignable(k, tk, pairs[mi].key.span, "map key")
                        this.checkAssignable(vt, tv, pairs[mi].value.span, "map value")
                        mi = mi + 1
                    }
                    Ty.Map(k, vt)
                }
            }
            case ExprKind.Await(x) -> {
                // `await <future>` drives a zero-argument function (a future
                // returned by an `async fn`) to completion and yields its value.
                let t = this.checkExpr(x)
                var isEmptyFn = false
                var prt = Ty.None
                match (t) {
                    case Ty.Fn(ps, r) -> {
                        if (len(ps) == 0) {
                            isEmptyFn = true
                            prt = r
                        }
                    }
                    case _ -> {}
                }
                if (isEmptyFn) {
                    prt
                } else {
                    var isUnknown = false
                    match (t) {
                        case Ty.Unknown -> isUnknown = true
                        case _ -> {}
                    }
                    if (isUnknown) {
                        Ty.Unknown
                    } else {
                        this.err(e.span, "cannot `await` a value of type `{bareName(t)}`; a future is a zero-argument function (`() -> T`) returned by an `async fn`")
                        Ty.Unknown
                    }
                }
            }
            case ExprKind.Unsafe(b) -> {
                this.unsafeDepth = this.unsafeDepth + 1
                let t = this.checkBlock(b)
                this.unsafeDepth = this.unsafeDepth - 1
                t
            }
            case ExprKind.Range(start, end, _incl) -> {
                let st = this.checkExpr(start)
                let _ = this.checkExpr(end)
                Ty.Range(st)
            }
            case ExprKind.Assign(target, _op, value) -> this.checkAssign(e, target, value)
            case ExprKind.Lambda(params, returnTy, isAsync, body) -> {
                let t = this.checkLambda(e, params, returnTy, isAsync, body)
                t
            }
            case ExprKind.If(cond, thenBlock, elseExpr) -> this.checkIf(e, cond, thenBlock, elseExpr)
            case ExprKind.Match(scrutinee, arms) -> this.checkMatch(e, scrutinee, arms)
            case ExprKind.Call(callee, args) -> this.checkCall(e, callee, args)
            case ExprKind.Member(object, name) -> this.checkMember(e, object, name)
            case ExprKind.Index(object, index) -> this.checkIndex(e, object, index)
            case ExprKind.OptAccess(object, name) -> this.checkOptAccess(e, object, name)
            case ExprKind.OptUnwrap(x) -> this.checkOptUnwrap(e, x)
            case ExprKind.Binary(op, lhs, rhs) -> this.checkBinary(e, op, lhs, rhs)
            case ExprKind.Unary(op, operand) -> this.checkUnary(e, op, operand)
            case ExprKind.Cast(expr, ty, kind) -> this.checkCast(e, expr, ty, kind)
            case ExprKind.GenericCall(name, typeArgs) -> this.genericFnTy(e, name, typeArgs)
            case _ -> Ty.Unknown
        }
    }

    fn litTy( lit: Lit) -> Ty {
        match (lit) {
            case Lit.Int(_) -> Ty.Int
            case Lit.Float(_) -> Ty.Float
            case Lit.String(_) -> Ty.String
            case Lit.Char(_) -> Ty.Char
            case Lit.Bool(_) -> Ty.Bool
            case Lit.None -> Ty.None
        }
    }

    /// Type an interpolated string: check every embedded expression (so the
    /// codegen side table has its type and unresolved names are reported), and
    /// the literal itself is a `string`.
    fn stringTy( parts: List<StrPart>) -> Ty {
        var i = 0
        while (i < len(parts)) {
            let part = parts[i]
            match (part) {
                case StrPart.Expr(x) -> {
                    let _ = this.checkExpr(x)
                }
                case _ -> {}
            }
            i = i + 1
        }
        Ty.String
    }

    fn identTy( e: Expr, name: string) -> Ty {
        if (let some(l) = this.lookup(name)) {
            if (l.freed) {
                this.err(e.span, "use of `{name}` after `free()`")
            } else if (l.moved) {
                this.errNote(e.span, "use of `{name}` after it was moved", "a `#[manualAlloc]` value has a single owner; bind the new name and use that")
            }
            return l.ty
        }
        if (let some(fns) = this.resolved.fns.get(name)) {
            return this.fnSig(fns)
        }
        for (c in this.resolved.consts) {
            if (c.name == name) {
                return c.ty
            }
        }
        for (g in this.resolved.globals) {
            if (g.name == name) {
                return g.ty
            }
        }
        // Implicit receiver: a bare field/property/method name inside a
        // class or struct body refers to `this.name`.
        if (let some(st) = this.selfTy) {
            if (let some(tk) = this.typeKey(st)) {
                if (let some(f) = this.findField(tk.name, name, tk.args)) {
                    return subst(f.ty, tk.args)
                }
                if (let some(p) = this.findProperty(tk.name, name)) {
                    return p.ty
                }
                if (let some(m) = this.findMethod(tk.name, name)) {
                    var mps = emptyTyList()
                    for (mp in m.params) {
                        mps.push(mp.ty)
                    }
                    return Ty.Fn(mps, this.methodRetTy(m, emptyMapStrTy()))
                }
            }
        }
        // Type name used as a constructor/static receiver.
        if (let some(entry) = this.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    return Ty.Class(t.name, tyVars(t.generics))
                }
                case TypeTableEntry.Struct(t) -> {
                    return Ty.Struct(t.name, tyVars(t.generics))
                }
                case TypeTableEntry.Enum(t) -> {
                    return Ty.Enum(t.name, tyVars(t.generics))
                }
                case TypeTableEntry.Interface(t) -> {
                    return Ty.Interface(t.name, tyVars(t.generics))
                }
            }
        }
        this.errNote(e.span, "use of undeclared name `{name}`", "names must be declared before use")
        Ty.Unknown
    }

    fn superTy( e: Expr) -> Ty {
        if (let some(st) = this.selfTy) {
            if (let some(tk) = this.typeKey(st)) {
                if (let some(table) = this.classTable(tk.name)) {
                    if (let some(p) = table.extends) {
                        return p
                    }
                    this.err(e.span, "this class has no parent to call `super` on")
                    return Ty.Unknown
                }
            }
        }
        this.err(e.span, "`super` used outside of a class body")
        Ty.Unknown
    }

    fn fnSig( fns: List<CallableInfo>) -> Ty {
        if (len(fns) == 0) {
            return Ty.Unknown
        }
        let f = fns[0]
        var ps = emptyTyList()
        for (p in f.params) {
            ps.push(p.ty)
        }
        // An `async fn` used as a value is a function returning a future
        // (`() -> R`), not the result `R` itself.
        var ret = f.ret
        if (f.isAsync && (len(f.generics) == 0)) {
            ret = Ty.Fn(emptyTyList(), f.ret)
        }
        Ty.Fn(ps, ret)
    }

    /// Type of a method call. For an `async` method this is the future
    /// (`() -> R`), which `await` then drives.
    fn methodRetTy(m: CallableInfo, map: Map<string, Ty>) -> Ty {
        var ret = subst(m.ret, map)
        if (m.isAsync) {
            ret = Ty.Fn(emptyTyList(), ret)
        }
        ret
    }

    /// Type an explicit generic call `name<T>(...)` used as a value (callee).
    fn genericFnTy( e: Expr, name: string, typeArgs: List<TypeExpr>) -> Ty {
        if (let none = this.resolved.fns.get(name)) {
            this.err(e.span, "unknown generic function `{name}`")
            return Ty.Unknown
        }
        var f: CallableInfo? = none
        if (let some(fns) = this.resolved.fns.get(name)) {
            for (c in fns) {
                if (!(c.span.start == 0 && c.span.end == 0)) {
                    f = c
                    break
                }
            }
            if (let none = f) {
                return this.fnSig(fns)
            }
        }
        if (let some(ff) = f) {
            // Instantiate the callee signature with the explicit type args.
            var argsTyp = emptyTyList()
            for (te in typeArgs) {
                argsTyp.push(this.resolvedFnTy(te, copyStrList(this.fnGenerics)))
            }
            if (len(ff.generics) != len(argsTyp)) {
                this.err(e.span, "`{name}` takes {len(ff.generics)} type argument(s), found {len(argsTyp)}")
                var fps = emptyTyList()
                for (p in ff.params) {
                    fps.push(p.ty)
                }
                return Ty.Fn(fps, ff.ret)
            }
            var map: Map<string, Ty> = emptyMapStrTy()
            var gi = 0
            while (gi < len(ff.generics)) {
                map[ff.generics[gi]] = argsTyp[gi]
                gi = gi + 1
            }
            var ps2 = emptyTyList()
            for (p in ff.params) {
                ps2.push(subst(p.ty, map))
            }
            var sret = subst(ff.ret, map)
            // An `async fn` called with explicit type arguments returns a future
            // (`() -> R`), exactly like the inferred-generic path.
            if (ff.isAsync) {
                sret = Ty.Fn(emptyTyList(), sret)
            }
            return Ty.Fn(ps2, sret)
        }
        Ty.Unknown
    }

    fn checkCall( e: Expr, callee: Expr, args: List<CallArg>) -> Ty {
        // `super(...)` inside a primary constructor body delegates to the
        // parent constructor; its arguments are checked against the parent's
        // constructor parameters.
        match (callee.kind) {
            case ExprKind.Super -> {
                if (let none = this.superCtorParams) {
                    this.err(e.span, "`super(...)` can only be used as a constructor delegation")
                    return Ty.Unknown
                }
                if (let some(params) = this.superCtorParams) {
                    this.checkArgs(e, params, args)
                }
                return Ty.Empty
            }
            case ExprKind.This -> {
                if (let none = this.namedCtorParams) {
                    this.err(e.span, "`this(...)` can only be used as a named constructor's delegation")
                    return Ty.Unknown
                }
                if (this.namedCtorDelegated) {
                    this.err(e.span, "a named constructor may only delegate to `this(...)` once")
                }
                this.namedCtorDelegated = true
                if (let some(params) = this.namedCtorParams) {
                    this.checkArgs(e, params, args)
                }
                return Ty.Empty
            }
            case _ -> {}
        }
        // Raw-buffer builtins and misc named builtins.
        let isIdent = match (callee.kind) {
            case ExprKind.Ident(_) -> true
            case _ -> false
        }
        if (isIdent) {
            let bn = match (callee.kind) {
                case ExprKind.Ident(n) -> n
                case _ -> ""
            }
            if (bn == "alloc" || bn == "free") {
                return this.checkRawBuiltin(e, bn, args)
            }
            if (bn == "assert") {
                return this.checkAssert(e, args)
            }
            if (bn == "abs") {
                return this.checkAbs(e, args)
            }
            if (bn == "min" || bn == "max") {
                return this.checkMinmax(e, bn, args)
            }
            if (bn == "clamp") {
                return this.checkClamp(e, args)
            }
            if (bn == "str") {
                return this.checkStr(e, args)
            }
            if (bn == "range") {
                return this.checkRange(e, args)
            }
            if (bn == "read_file") {
                return this.checkReadFile(e, args)
            }
            if (bn == "write_file") {
                return this.checkWriteFile(e, args)
            }
            if (bn == "file_exists") {
                return this.checkFileExists(e, args)
            }
            if (bn == "delete") {
                return this.checkDelete(e, args)
            }
            if (bn == "mkdir") {
                return this.checkMkdir(e, args)
            }
            if (bn == "list_dir") {
                return this.checkListDir(e, args)
            }
            if (bn == "bytes") {
                return this.checkBytes(e, args)
            }
            if (bn == "stream_open_read" || bn == "stream_open_write" || bn == "stream_open_append") {
                return this.checkStreamOpen(e, bn, args)
            }
            if (bn == "stdout_stream" || bn == "stderr_stream") {
                return this.checkStreamSingleton(e, bn, args)
            }
            if (bn == "args") {
                return this.checkArgsBuiltin(e, args)
            }
            if (bn == "exit") {
                return this.checkExit(e, args)
            }
            if (bn == "run_cmd") {
                return this.checkRunCmd(e, args)
            }
            if (bn == "run_spawn") {
                return this.checkRunSpawn(e, args)
            }
            if (bn == "proc_wait" || bn == "proc_running" || bn == "proc_code" || bn == "proc_kill" || bn == "proc_in_close") {
                return this.checkProcHandle(e, bn, args)
            }
            if (bn == "proc_out_read" || bn == "proc_err_read") {
                return this.checkProcRead(e, bn, args)
            }
            if (bn == "proc_in_write") {
                return this.checkProcWrite(e, args)
            }
            if (bn == "current_dir") {
                return this.checkCurrentDir(e, args)
            }
            if (bn == "thread_spawn") {
                return this.checkTaskBody(e, bn, args, 0)
            }
            if (bn == "once_run") {
                return this.checkTaskBody(e, bn, args, 1)
            }
            if (bn == "captureBegin") {
                return this.checkCaptureBegin(e, args)
            }
            if (bn == "captureTake") {
                return this.checkCaptureTake(e, args)
            }
            if (bn == "expect" && !this.resolved.fns.has("expect")) {
                return this.checkExpect(e, args)
            }
        }
        // `expect(v).toEqual(w)` / `.not().toBe(w)` / ... chains.
        let isMember = match (callee.kind) {
            case ExprKind.Member(_, _) -> true
            case _ -> false
        }
        if (isMember) {
            let mName = match (callee.kind) {
                case ExprKind.Member(_, n) -> n
                case _ -> ""
            }
            let mObj = match (callee.kind) {
                case ExprKind.Member(o, _) -> o
                case _ -> callee
            }
            if (mName != "not" && isExpectMethod(mName) && this.expectChainDepth(mObj) > 0) {
                if (let some(src) = this.expectSource(mObj)) {
                    return this.checkExpectMethod(e, src, mName, args)
                }
            }
            // `.free()` on a `#[manualAlloc]` binding.
            if (mName == "free") {
                let objIsIdent = match (mObj.kind) {
                    case ExprKind.Ident(_) -> true
                    case _ -> false
                }
                if (objIsIdent) {
                    let id = match (mObj.kind) {
                        case ExprKind.Ident(n) -> n
                        case _ -> ""
                    }
                    if (this.isManual(id)) {
                        let _ = this.checkExpr(mObj)
                        return this.checkFree(e, id, args)
                    }
                }
                let rt = this.checkExpr(mObj)
                var hasUserFree = false
                if (let some(tk) = this.typeKey(rt)) {
                    if (let some(_m) = this.findMethod(tk.name, "free")) {
                        hasUserFree = true
                    }
                }
                if (!hasUserFree) {
                    this.errNote(e.span, "`free` is only available on a `#[manualAlloc]` binding", "declare the binding with `#[manualAlloc] let x = T()`")
                    return Ty.Unknown
                }
            }
        }
        // `Enum.Variant(...)` constructor call.
        if (isMember) {
            let mName2 = match (callee.kind) {
                case ExprKind.Member(_, n) -> n
                case _ -> ""
            }
            let mObj2 = match (callee.kind) {
                case ExprKind.Member(o, _) -> o
                case _ -> callee
            }
            let objIsIdent2 = match (mObj2.kind) {
                case ExprKind.Ident(_) -> true
                case _ -> false
            }
            if (objIsIdent2) {
                let enumName = match (mObj2.kind) {
                    case ExprKind.Ident(n) -> n
                    case _ -> ""
                }
                if (let some(entry) = this.resolved.types.get(enumName)) {
                    match (entry) {
                        case TypeTableEntry.Enum(t) -> {
                            var ftypes: List<Ty>? = none
                            for (v in t.variants) {
                                if (v.name == mName2) {
                                    ftypes = v.fields
                                }
                            }
                            if (let some(ft) = ftypes) {
                                this.checkArgs(e, ft, args)
                                return Ty.Enum(t.name, emptyTys())
                            }
                            this.err(callee.span, "enum `{enumName}` has no variant `{mName2}`")
                            return Ty.Unknown
                        }
                        case _ -> {}
                    }
                }
            }
        }
        // A generic class/struct constructor call `Box<int>(args)`.
        let isGen = match (callee.kind) {
            case ExprKind.GenericCall(_, _) -> true
            case _ -> false
        }
        if (isGen) {
            let gName = match (callee.kind) {
                case ExprKind.GenericCall(n, _) -> n
                case _ -> ""
            }
            let gArgTys = match (callee.kind) {
                case ExprKind.GenericCall(_, t) -> t
                case _ -> emptyTypeExprs()
            }
            if (let some(entry) = this.resolved.types.get(gName)) {
                var gCtor = false
                match (entry) {
                    case TypeTableEntry.Class(_) -> gCtor = true
                    case TypeTableEntry.Struct(_) -> gCtor = true
                    case TypeTableEntry.Enum(_) -> {}
                    case TypeTableEntry.Interface(_) -> {}
                }
                if (!gCtor) {
                    this.err(e.span, "`{gName}` cannot be constructed directly")
                    return Ty.Unknown
                }
                var gt = emptyTyList()
                for (te in gArgTys) {
                    gt.push(this.resolvedFnTy(te, copyStrList(this.fnGenerics)))
                }
                if (let some(table) = this.classTable(gName)) {
                    if (len(gt) != len(table.generics)) {
                        this.err(e.span, "`{gName}` takes {len(table.generics)} type argument(s), found {len(gt)}")
                        return Ty.Unknown
                    }
                    var gmap: Map<string, Ty> = emptyMapStrTy()
                    var gi = 0
                    while (gi < len(table.generics)) {
                        gmap[table.generics[gi]] = gt[gi]
                        gi = gi + 1
                    }
                    var gparams = emptyTyList()
                    if (let some(ctor) = table.ctor) {
                        for (p in ctor.params) {
                            gparams.push(subst(p.ty, gmap))
                        }
                    } else {
                        let synth = this.synthesizedCtorParamTys(gName)
                        for (s in synth) {
                            gparams.push(subst(s, gmap))
                        }
                    }
                    this.checkArgs(e, gparams, args)
                    match (entry) {
                        case TypeTableEntry.Class(c) -> { return Ty.Class(c.name, gt) }
                        case TypeTableEntry.Struct(s) -> { return Ty.Struct(s.name, gt) }
                        case _ -> { return Ty.Unknown }
                    }
                }
                return Ty.Unknown
            }
            // Not a type name: falls through to the generic-function check.
        }
        // Constructor call: `TypeName(args)` where callee is a type name.
        if (isIdent) {
            let cname = match (callee.kind) {
                case ExprKind.Ident(n) -> n
                case _ -> ""
            }
            if (let some(entry) = this.resolved.types.get(cname)) {
                var ct = Ty.Unknown
                var cCtor = true
                match (entry) {
                    case TypeTableEntry.Class(c) -> {
                        ct = Ty.Class(c.name, tyVars(c.generics))
                        cCtor
                    }
                    case TypeTableEntry.Struct(s) -> {
                        ct = Ty.Struct(s.name, tyVars(s.generics))
                        cCtor
                    }
                    case TypeTableEntry.Interface(_) -> {
                        cCtor = false
                        cCtor
                    }
                    case TypeTableEntry.Enum(_) -> {
                        cCtor = false
                        cCtor
                    }
                }
                if (!cCtor) {
                    this.err(e.span, "`{cname}` cannot be constructed directly")
                    return Ty.Unknown
                }
                if (let some(ck) = this.typeKey(ct)) {
                    if (let some(m) = this.findMethod(ck.name, cname)) {
                        var mps = emptyTyList()
                        for (p in m.params) {
                            mps.push(p.ty)
                        }
                        this.checkArgs(e, mps, args)
                        return m.ret
                    }
                }
                if (let some(c) = this.classTable(cname)) {
                    if (let some(ctor) = c.ctor) {
                        var cps = emptyTyList()
                        for (p in ctor.params) {
                            cps.push(p.ty)
                        }
                        this.checkArgs(e, cps, args)
                    } else {
                        this.checkArgs(e, this.synthesizedCtorParamTys(cname), args)
                    }
                }
                return ct
            }
            // Regular function call by name (user or builtin).
            if (let some(fns) = this.resolved.fns.get(cname)) {
                var nsa = 0
                for (a in args) {
                    if (!a.spread) {
                        nsa = nsa + 1
                    }
                }
                // Prefer the signature whose fixed-param count best fits the
                // positional arguments; variadic rest stays loose.
                var bestI = 0
                var bestDiff = 1000000
                var fi = 0
                while (fi < len(fns)) {
                    var fixed = 0
                    for (p in fns[fi].params) {
                        if (!p.rest) {
                            fixed = fixed + 1
                        }
                    }
                    let d = absDiffInt(fixed, nsa)
                    if (d < bestDiff) {
                        bestDiff = d
                        bestI = fi
                    }
                    fi = fi + 1
                }
                let first = fns[bestI]
                if (len(first.generics) > 0) {
                    // A generic function called without explicit type
                    // arguments: infer them from the arguments.
                    if (let some(t) = this.inferGenericCall(e, first, args)) {
                        if (let some(flags) = this.manualParamFns.get(cname)) {
                            this.checkManualArgs(flags, args)
                        }
                        if (listHasStr(this.manualRetFns, cname)) {
                            if (!hasSpan(this.pendingOwnedCalls, e.span)) {
                                this.pendingOwnedCalls.push(e.span)
                            }
                        }
                        return t
                    }
                    return Ty.Unknown
                }
                this.checkArgsInfo(e, first.params, args)
                if (let some(flags) = this.manualParamFns.get(cname)) {
                    this.checkManualArgs(flags, args)
                }
                if (listHasStr(this.manualRetFns, cname)) {
                    if (!hasSpan(this.pendingOwnedCalls, e.span)) {
                        this.pendingOwnedCalls.push(e.span)
                    }
                }
                var retEmpty = match (first.ret) {
                    case Ty.Empty -> true
                    case _ -> false
                }
                if (first.isAsync && (len(first.generics) == 0) && !retEmpty) {
                    // Calling an `async fn` does not run the body: it returns a
                    // captured 0-arg function (the future) typed `() -> R`,
                    // which `await` drives.
                    return Ty.Fn(emptyTyList(), first.ret)
                }
                return first.ret
            }
        }
        let ct = this.checkExpr(callee)
        match (ct) {
            case Ty.Fn(params, ret) -> {
                this.checkArgs(e, params, args)
                ret
            }
            case Ty.Unknown -> Ty.Unknown
            case _ -> {
                this.errNote(e.span, "attempt to call a non-function value of type `{bareName(ct)}`", "only functions and type constructors can be called")
                Ty.Unknown
            }
        }
    }

    fn checkRawBuiltin( e: Expr, name: string, args: List<CallArg>) -> Ty {
        if (this.unsafeDepth == 0) {
            this.err(e.span, "`{name}` may only be used inside an `unsafe` block")
        }
        if (name == "alloc") {
            if (len(args) != 2) {
                this.err(e.span, "`alloc(T, count)` takes two arguments")
                for (a in args) {
                    let _ = this.checkExpr(a.value)
                }
                return Ty.Unknown
            }
            let tyArg = args[0]
            let countArg = args[1]
            let tyIsIdent = match (tyArg.value.kind) {
                case ExprKind.Ident(_) -> true
                case _ -> false
            }
            if (!tyIsIdent) {
                this.err(tyArg.value.span, "`alloc` element type must be a type name")
                let _ = this.checkExpr(countArg.value)
                return Ty.Unknown
            }
            let tyName = match (tyArg.value.kind) {
                case ExprKind.Ident(n) -> n
                case _ -> ""
            }
            let wrapped = TypeExpr(tyArg.value.span, TypeExprKind.Path([tyName]))
            let inner = this.resolvedFnTy(wrapped, emptyStrList())
            this.types[spanKey(tyArg.value.span)] = inner
            var scalarOk = false
            match (inner) {
                case Ty.Int -> scalarOk = true
                case Ty.Float -> scalarOk = true
                case Ty.Bool -> scalarOk = true
                case Ty.Char -> scalarOk = true
                case _ -> {}
            }
            if (!scalarOk) {
                this.err(tyArg.value.span, "`alloc` currently only supports scalar element types (int, float, bool, char), found `{bareName(inner)}`")
                let _ = this.checkExpr(countArg.value)
                return Ty.Unknown
            }
            let ct = this.checkExpr(countArg.value)
            if (ct != Ty.Unknown && ct != Ty.Int) {
                this.err(countArg.value.span, "`alloc` count must be an `int`")
            }
            return Ty.Ptr(inner)
        }
        // free(p)
        if (len(args) != 1) {
            this.err(e.span, "`free(p)` takes one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Empty
        }
        let p = args[0].value
        let at = this.checkExpr(p)
        match (at) {
            case Ty.Ptr(_) -> {}
            case other -> {
                this.err(p.span, "`free` expects a pointer argument, found `{bareName(other)}`")
            }
        }
        Ty.Empty
    }

    /// Validate `assert(cond, msg?)`: the condition must be a `bool`, an
    /// optional second argument a `string` (only used when it fails).
    fn checkAssert( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) == 0 || len(args) > 2) {
            this.err(e.span, "`assert(cond, msg?)` takes a condition and an optional message")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Empty
        }
        let cond = this.checkExpr(args[0].value)
        this.checkAssignable(Ty.Bool, cond, args[0].value.span, "assert condition")
        if (len(args) > 1) {
            let mt = this.checkExpr(args[1].value)
            this.checkAssignable(Ty.String, mt, args[1].value.span, "assert message")
        }
        Ty.Empty
    }

    /// `expect(value)` typed as the value's type.
    fn checkExpect( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`expect(value)` takes exactly one value")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        this.checkExpr(args[0].value)
    }

    /// Statement count of an `expect(...)` / `expect(...).not()` chain.
    fn expectChainDepth( e: Expr) -> int {
        match (e.kind) {
            case ExprKind.Call(callee, args) -> {
                if (len(args) == 1 && !args[0].spread && isNoneStr(args[0].name)) {
                    match (callee.kind) {
                        case ExprKind.Ident(n) -> {
                            if (n == "expect") {
                                return 1
                            }
                        }
                        case _ -> {}
                    }
                }
                if (len(args) == 0) {
                    match (callee.kind) {
                        case ExprKind.Member(object, name) -> {
                            if (name == "not") {
                                let d = this.expectChainDepth(object)
                                if (d > 0) {
                                    return d + 1
                                }
                            }
                        }
                        case _ -> {}
                    }
                }
                0
            }
            case _ -> 0
        }
    }

    /// The value argument of the outermost `expect(...)` in an assertion chain.
    fn expectSource( e: Expr) -> Expr? {
        match (e.kind) {
            case ExprKind.Call(callee, args) -> {
                if (len(args) == 1 && !args[0].spread && isNoneStr(args[0].name)) {
                    match (callee.kind) {
                        case ExprKind.Ident(n) -> {
                            if (n == "expect") {
                                return args[0].value
                            }
                        }
                        case _ -> {}
                    }
                    return none
                }
                if (len(args) == 0) {
                    match (callee.kind) {
                        case ExprKind.Member(object, name) -> {
                            if (name == "not") {
                                return this.expectSource(object)
                            }
                        }
                        case _ -> {}
                    }
                }
                none
            }
            case _ -> none
        }
    }

    /// Validate an `expect(v).<method>(...)` assertion.
    fn checkExpectMethod( e: Expr, src: Expr, method: string, args: List<CallArg>) -> Ty {
        for (a in args) {
            if (a.spread) {
                this.err(a.span, "spread arguments are not supported in an expectation")
                return Ty.Empty
            }
            if (!isNoneStr(a.name)) {
                this.err(a.span, "named arguments are not supported in an expectation")
                return Ty.Empty
            }
        }
        let vt = this.checkExpr(src)
        let vtNum = match (vt) {
            case Ty.Int -> true
            case Ty.Float -> true
            case _ -> false
        }
        if (method == "toBe" || method == "toEqual") {
            if (len(args) != 1) {
                this.err(e.span, "`.{method}(expected)` takes one argument")
                for (a in args) {
                    let _ = this.checkExpr(a.value)
                }
                return Ty.Empty
            }
            let at = this.checkExpr(args[0].value)
            let atNum = match (at) {
                case Ty.Int -> true
                case Ty.Float -> true
                case _ -> false
            }
            // Cross-numeric (`int` vs `float`) compares are allowed.
            if (!(vtNum && atNum)) {
                this.checkAssignable(vt, at, args[0].value.span, "expectation argument")
            }
        } else if (method == "toBeTruthy" || method == "toBeFalsy" || method == "toBeNull" || method == "toExist") {
            if (len(args) > 0) {
                this.err(e.span, "`.{method}()` takes no arguments")
                for (a in args) {
                    let _ = this.checkExpr(a.value)
                }
            }
        } else if (method == "toHaveLength") {
            if (len(args) != 1) {
                this.err(e.span, "`.toHaveLength(n)` takes one argument")
                for (a in args) {
                    let _ = this.checkExpr(a.value)
                }
                return Ty.Empty
            }
            match (vt) {
                case Ty.String -> {}
                case Ty.List(_) -> {}
                case Ty.Map(_, _) -> {}
                case Ty.Unknown -> {}
                case other -> {
                    this.err(src.span, "`.toHaveLength()` needs a string, list, or map value, found `{bareName(other)}`")
                }
            }
            let lt = this.checkExpr(args[0].value)
            this.checkAssignable(Ty.Int, lt, args[0].value.span, "`.toHaveLength()` argument")
        } else if (method == "toContain") {
            if (len(args) != 1) {
                this.err(e.span, "`.toContain(value)` takes one argument")
                for (a in args) {
                    let _ = this.checkExpr(a.value)
                }
                return Ty.Empty
            }
            let at = this.checkExpr(args[0].value)
            match (vt) {
                case Ty.String -> this.checkAssignable(Ty.String, at, args[0].value.span, "`.toContain()` argument")
                case Ty.List(inner) -> this.checkAssignable(inner, at, args[0].value.span, "`.toContain()` argument")
                case Ty.Map(k, _) -> this.checkAssignable(k, at, args[0].value.span, "`.toContain()` argument")
                case Ty.Unknown -> {}
                case other -> {
                    this.err(src.span, "`.toContain()` needs a string, list, or map value, found `{bareName(other)}`")
                }
            }
        } else if (method == "toBeGreaterThan" || method == "toBeLessThan") {
            if (len(args) != 1) {
                this.err(e.span, "`.{method}(n)` takes one argument")
                for (a in args) {
                    let _ = this.checkExpr(a.value)
                }
                return Ty.Empty
            }
            match (vt) {
                case Ty.Int -> {}
                case Ty.Float -> {}
                case Ty.Unknown -> {}
                case other -> {
                    this.err(src.span, "`.{method}()` needs a numeric value, found `{bareName(other)}`")
                }
            }
            let at = this.checkExpr(args[0].value)
            let atNum2 = match (at) {
                case Ty.Int -> true
                case Ty.Float -> true
                case Ty.Unknown -> true
                case _ -> false
            }
            if (!atNum2) {
                this.err(args[0].value.span, "`.{method}()` argument must be numeric, found `{bareName(at)}`")
            }
        } else {
            this.err(e.span, "unknown expectation method `.{method}()`")
        }
        Ty.Empty
    }

    /// Validate `x.free()` on a `#[manualAlloc]` binding and mark it released.
    fn checkFree( e: Expr, name: string, args: List<CallArg>) -> Ty {
        for (a in args) {
            this.err(a.span, "`free()` takes no arguments")
            let _ = this.checkExpr(a.value)
        }
        if (this.isFreed(name)) {
            this.err(e.span, "`{name}` was already freed")
            return Ty.Empty
        }
        this.markFreed(name)
        Ty.Empty
    }

    /// Check a call's arguments against a plain positional signature.
    fn checkArgs( e: Expr, params: List<Ty>, args: List<CallArg>) {
        var position = 0
        let fixed = len(params)
        for (a in args) {
            if (!isNoneStr(a.name)) {
                var an = ""
                if (let some(s) = a.name) {
                    an = s
                }
                this.errNote(a.span, "named argument `" + an + "` is not supported for this call", "positional arguments are expected here")
                let _ = this.checkExpr(a.value)
                position = position + 1
                continue
            }
            if (a.spread) {
                let _ = this.checkExpr(a.value)
                position = position + 1
                continue
            }
            if (position < fixed) {
                let want = params[position]
                let got = this.checkExpr(a.value)
                this.checkAssignable(want, got, a.span, "argument")
            } else {
                let _ = this.checkExpr(a.value)
                this.err(e.span, "too many arguments in call")
            }
            position = position + 1
        }
        if (position < fixed) {
            this.err(e.span, "expected {fixed} argument(s), found {position}")
        }
    }

    /// Check a generic function call `name(args)` by **inferring** its type
    /// arguments from the (already-checked) arguments.
    fn inferGenericCall( e: Expr, f: CallableInfo, args: List<CallArg>) -> Ty? {
        var map: Map<string, Ty> = emptyMapStrTy()
        var got: Map<string, Ty> = emptyMapStrTy()
        var position = 0
        for (a in args) {
            let t = this.checkExpr(a.value)
            got[spanKey(a.value.span)] = t
            if (isNoneStr(a.name) && !a.spread) {
                if (position < len(f.params)) {
                    inferFrom(f.params[position].ty, t, map)
                }
            }
            position = position + 1
        }
        var missing = emptyStrList()
        for (g in f.generics) {
            if (!map.has(g)) {
                missing.push(g)
            }
        }
        if (len(missing) > 0) {
            var plural = ""
            if (len(missing) != 1) {
                plural = "s"
            }
            var names = ""
            var mi = 0
            while (mi < len(missing)) {
                if (mi > 0) {
                    names = "{names}, "
                }
                names = "{names}`{missing[mi]}`"
                mi = mi + 1
            }
            this.err(e.span, "cannot infer the type argument{plural} {names} for `{f.name}`; specify them explicitly like `{f.name}<...>(...)`")
            return none
        }
        var params = emptyTyList()
        for (p in f.params) {
            params.push(subst(p.ty, map))
        }
        this.checkArgsTyped(e, params, args, got)
        var ret = subst(f.ret, map)
        // Calling an inferred `async fn` returns the future, not the body's
        // result: the future is a captured zero-argument function `() -> R`.
        if (f.isAsync) {
            ret = Ty.Fn(emptyTyList(), ret)
        }
        ret
    }

    /// Argument checking against a signature whose expressions have already
    /// been checked: reads the argument types back from `got` instead of
    /// re-checking them (so inference's single pass stays single).
    fn checkArgsTyped( e: Expr, params: List<Ty>, args: List<CallArg>, got: Map<string, Ty>) {
        var position = 0
        let fixed = len(params)
        for (a in args) {
            if (!isNoneStr(a.name)) {
                var an = ""
                if (let some(s) = a.name) {
                    an = s
                }
                this.errNote(a.span, "named argument `" + an + "` is not supported for this call", "positional arguments are expected here")
                position = position + 1
                continue
            }
            if (a.spread) {
                position = position + 1
                continue
            }
            if (position < fixed) {
                let want = params[position]
                let gotTy = if (let some(t) = got.get(spanKey(a.value.span))) {
                    t
                } else {
                    Ty.Unknown
                }
                this.checkAssignable(want, gotTy, a.span, "argument")
            } else {
                this.err(e.span, "too many arguments in call")
            }
            position = position + 1
        }
        if (position < fixed) {
            this.err(e.span, "expected {fixed} argument(s), found {position}")
        }
    }

    /// Variadic-aware argument checking against `ParamInfo`s. Params flagged
    /// `rest` absorb any remaining positional arguments without arity errors.
    fn checkArgsInfo( e: Expr, params: List<ParamInfo>, args: List<CallArg>) {
        var restTy: Ty? = none
        var pi = len(params) - 1
        while (pi >= 0) {
            if (params[pi].rest) {
                restTy = params[pi].ty
                break
            }
            pi = pi - 1
        }
        var fixed = 0
        for (p in params) {
            if (!p.rest) {
                fixed = fixed + 1
            }
        }
        var position = 0
        for (a in args) {
            if (!isNoneStr(a.name)) {
                var an = ""
                if (let some(s) = a.name) {
                    an = s
                }
                this.errNote(a.span, "named argument `" + an + "` is not supported for this call", "positional arguments are expected here")
                let _ = this.checkExpr(a.value)
                position = position + 1
                continue
            }
            if (a.spread) {
                let _ = this.checkExpr(a.value)
                position = position + 1
                continue
            }
            if (position < fixed) {
                let want = params[position].ty
                let got = this.checkExpr(a.value)
                this.checkAssignable(want, got, a.span, "argument")
            } else if (let some(rt) = restTy) {
                let got = this.checkExpr(a.value)
                this.checkAssignable(rt, got, a.span, "argument")
            } else {
                let _ = this.checkExpr(a.value)
                this.err(e.span, "too many arguments in call")
            }
            position = position + 1
        }
        if (position < fixed) {
            var allNamed = true
            for (a in args) {
                if (isNoneStr(a.name)) {
                    allNamed = false
                }
            }
            if (allNamed) {
                var joined = ""
                var plural = ""
                var missCount = 0
                var mj = position
                while (mj < fixed) {
                    if (missCount > 0) {
                        joined = joined + ", "
                    }
                    joined = joined + "`" + params[mj].name + "`"
                    missCount = missCount + 1
                    mj = mj + 1
                }
                if (missCount != 1) {
                    plural = "s"
                }
                this.errNote(e.span, "missing argument" + plural + " for parameter" + plural + " `" + joined + "`", "all required parameters must be supplied")
            }
        }
    }

    fn checkMember( e: Expr, object: Expr, name: string) -> Ty {
        // Type-qualified static access: `Foo.bar`.
        let objIsIdent = match (object.kind) {
            case ExprKind.Ident(_) -> true
            case _ -> false
        }
        if (objIsIdent) {
            let tname = match (object.kind) {
                case ExprKind.Ident(n) -> n
                case _ -> ""
            }
            if (let some(entry) = this.resolved.types.get(tname)) {
                let gname = entryName(entry)
                if (let some(f) = this.findField(gname, name, emptyMapStrTy())) {
                    if (!f.isStatic) {
                        this.err(e.span, "instance field `{name}` must be accessed on an instance of `{gname}`")
                        return Ty.Unknown
                    }
                    return subst(f.ty, emptyMapStrTy())
                }
                if (let some(p) = this.findProperty(gname, name)) {
                    if (!p.isStatic) {
                        this.err(e.span, "instance property `{name}` must be accessed on an instance of `{gname}`")
                        return Ty.Unknown
                    }
                    return p.ty
                }
                if (let some(m) = this.findMethod(gname, name)) {
                    var mps = emptyTyList()
                    for (mp in m.params) {
                        mps.push(mp.ty)
                    }
                    return Ty.Fn(mps, this.methodRetTy(m, emptyMapStrTy()))
                }
                if (let some(nc) = this.findNamedCtor(gname, name)) {
                    let ret = match (entry) {
                        case TypeTableEntry.Class(c) -> Ty.Class(c.name, tyVars(c.generics))
                        case TypeTableEntry.Struct(s) -> Ty.Struct(s.name, tyVars(s.generics))
                        case _ -> Ty.Unknown
                    }
                    var nps = emptyTyList()
                    for (np in nc.params) {
                        nps.push(np.ty)
                    }
                    return Ty.Fn(nps, ret)
                }
                // Bare enum variant access: `Color.Red` when the variant has
                // no payload fields.
                match (entry) {
                    case TypeTableEntry.Enum(t) -> {
                        for (v in t.variants) {
                            if (v.name == name) {
                                if (len(v.fields) == 0) {
                                    return Ty.Enum(t.name, emptyTys())
                                }
                                this.err(e.span, "variant `{name}` carries {len(v.fields)} payload field(s); use `{name}(...)`")
                                return Ty.Unknown
                            }
                        }
                    }
                    case _ -> {}
                }
                this.err(e.span, "no member `{name}` on type `{tname}`")
                return Ty.Unknown
            }
        }
        let ot0 = this.checkExpr(object)
        // Member access through a raw pointer (`p.field`) auto-dereferences
        // and needs `unsafe`; through an immutable `&T` borrow it is a safe
        // read.
        var ot = ot0
        match (ot0) {
            case Ty.Ptr(inner) -> {
                if (this.unsafeDepth == 0) {
                    this.err(e.span, "pointer access may only be used inside an `unsafe` block")
                }
                ot = inner
            }
            case Ty.Ref(inner) -> {
                ot = inner
            }
            case _ -> {}
        }
        match (ot) {
            case Ty.List(inner) -> {
                // Builtin list methods (slice subset).
                if (name == "push") {
                    return Ty.Fn([inner], Ty.Empty)
                }
                if (name == "pop") {
                    return Ty.Fn(emptyTyList(), inner)
                }
                if (name == "remove") {
                    return Ty.Fn([Ty.Int], inner)
                }
                if (name == "insert") {
                    var ips = emptyTyList()
                    ips.push(Ty.Int)
                    ips.push(inner)
                    return Ty.Fn(ips, Ty.Empty)
                }
                if (name == "sort" && isListSortable(inner)) {
                    return Ty.Fn(emptyTyList(), Ty.Empty)
                }
                if (name == "sort") {
                    this.err(e.span, "`sort` needs a `List` of int, float, byte, char, bool, or string (got `List<{bareName(inner)}>`)")
                    return Ty.Unknown
                }
                this.err(e.span, "no member `{name}` on `List<{bareName(inner)}>`")
                return Ty.Unknown
            }
            case Ty.Map(k, v) -> {
                // Builtin map methods (slice subset).
                if (name == "has") {
                    return Ty.Fn([k], Ty.Bool)
                }
                if (name == "get") {
                    return Ty.Fn([k], optOf(v))
                }
                if (name == "remove") {
                    return Ty.Fn([k], optOf(v))
                }
                if (name == "keys") {
                    return Ty.Fn(emptyTyList(), Ty.List(k))
                }
                if (name == "values") {
                    return Ty.Fn(emptyTyList(), Ty.List(v))
                }
                this.err(e.span, "no member `{name}` on `Map<{bareName(k)}, {bareName(v)}>`")
                return Ty.Unknown
            }
            case Ty.Stream -> {
                // Builtin stream methods (buffered I/O).
                if (name == "read") {
                    var rps = [Ty.Int]
                    return Ty.Fn(rps, Ty.Option(Ty.List(Ty.Byte)))
                }
                if (name == "write") {
                    var wps = [Ty.List(Ty.Byte)]
                    return Ty.Fn(wps, Ty.Int)
                }
                if (name == "flush") {
                    return Ty.Fn(emptyTyList(), Ty.Bool)
                }
                if (name == "close") {
                    return Ty.Fn(emptyTyList(), Ty.Bool)
                }
                this.err(e.span, "no member `{name}` on `Stream` (members are `read`, `write`, `flush`, `close`)")
                return Ty.Unknown
            }
            case Ty.Interface(iface, iargs) -> {
                // Interface members type calls on interface-typed receivers.
                var imap: Map<string, Ty> = emptyMapStrTy()
                if (let some(entry) = this.resolved.types.get(iface)) {
                    match (entry) {
                        case TypeTableEntry.Interface(it) -> {
                            var ii = 0
                            while (ii < len(it.generics)) {
                                if (ii < len(iargs)) {
                                    imap[it.generics[ii]] = iargs[ii]
                                } else {
                                    imap[it.generics[ii]] = Ty.Unknown
                                }
                                ii = ii + 1
                            }
                        }
                        case _ -> {}
                    }
                }
                var chain = [iface]
                var seen = emptyStrList()
                while (len(chain) > 0) {
                    let iname = chain[len(chain) - 1]
                    chain.pop()
                    if (listHasStr(seen, iname)) {
                        continue
                    }
                    seen.push(iname)
                    if (let none = this.resolved.types.get(iname)) {
                        continue
                    }
                    if (let some(entEntry) = this.resolved.types.get(iname)) {
                        match (entEntry) {
                            case TypeTableEntry.Interface(ent) -> {
                                var foundMethod = false
                                for (mem in ent.members) {
                                    if (mem.name == name) {
                                        if (mem.isProperty) {
                                            this.errNote(e.span, "property `{name}` on interface `{iface}`", "interface property access is not lowered yet (interface methods are); use the interface's methods")
                                            return Ty.Unknown
                                        }
                                        var mps = emptyTyList()
                                        for (mp in mem.params) {
                                            mps.push(subst(mp.ty, imap))
                                        }
                                        return Ty.Fn(mps, subst(mem.ty, imap))
                                    }
                                }
                                for (ext in ent.extends) {
                                    if (let some(n) = named(ext)) {
                                        chain.push(n)
                                    }
                                }
                            }
                            case _ -> {}
                        }
                    }
                }
                this.errNote(e.span, "no member `{name}` on interface `{iface}`", "an interface declares method signatures; check the spelling")
                return Ty.Unknown
            }
            case _ -> {}
        }
        if (let none = this.typeKey(ot)) {
            this.errNote(e.span, "cannot access member `{name}` on value of type `{bareName(ot)}`", "member access requires a class, struct, enum, or interface value")
            return Ty.Unknown
        }
        if (let some(tk) = this.typeKey(ot)) {
            if (let some(f) = this.findField(tk.name, name, tk.args)) {
                if (f.isStatic) {
                    this.err(e.span, "static field `{name}` must be accessed on the type `{tk.name}`, not on an instance")
                    return Ty.Unknown
                }
                return subst(f.ty, tk.args)
            }
            if (let some(p) = this.findProperty(tk.name, name)) {
                if (p.isStatic) {
                    this.err(e.span, "static property `{name}` must be accessed on the type `{tk.name}`, not on an instance")
                    return Ty.Unknown
                }
                return subst(p.ty, tk.args)
            }
            if (let some(m) = this.findMethod(tk.name, name)) {
                var mps = emptyTyList()
                for (mp in m.params) {
                    mps.push(subst(mp.ty, tk.args))
                }
                return Ty.Fn(mps, this.methodRetTy(m, tk.args))
            }
            this.errNote(e.span, "no member `{name}` on `{tk.name}`", "`{tk.name}` defines fields, properties, and methods; check the spelling")
            return Ty.Unknown
        }
        Ty.Unknown
    }

    fn checkOptAccess( e: Expr, object: Expr, name: string) -> Ty {
        let ot = this.checkExpr(object)
        if (let none = innerOption(ot)) {
            this.errNote(e.span, "`?.` on a non-option value of type `{bareName(ot)}`", "optional chaining requires an `Option` receiver")
            return Ty.Unknown
        }
        let inner = if (let some(x) = innerOption(ot)) { x } else { Ty.Unknown }
        if (let some(tk) = this.typeKey(inner)) {
            if (let some(f) = this.findField(tk.name, name, tk.args)) {
                return optOf(subst(f.ty, tk.args))
            }
            if (let some(p) = this.findProperty(tk.name, name)) {
                return optOf(subst(p.ty, tk.args))
            }
            if (let some(m) = this.findMethod(tk.name, name)) {
                var mps = emptyTyList()
                for (mp in m.params) {
                    mps.push(subst(mp.ty, tk.args))
                }
                return optOf(Ty.Fn(mps, this.methodRetTy(m, tk.args)))
            }
            this.err(e.span, "no member `{name}` on `{tk.name}`")
            return Ty.Unknown
        }
        Ty.Unknown
    }

    fn checkOptUnwrap( e: Expr, inner: Expr) -> Ty {
        let t = this.checkExpr(inner)
        if (let some(innerT) = innerOption(t)) {
            innerT
        } else {
            this.errNote(e.span, "`?` cannot unwrap non-option value of type `{bareName(t)}`", "only `Option` values may be unwrapped")
            t
        }
    }

    /// A map index must be assignable to the map's key type. Byte-keyed maps
    /// additionally accept in-range `int` literals (via `checkAssignRhs`).
    fn checkMapIndex( keyTy: Ty, indexTy: Ty, index: Expr, span: Span) {
        if (indexTy == Ty.Unknown) {
            return
        }
        if (keyTy == Ty.Byte) {
            this.checkAssignRhs(keyTy, indexTy, index, span, "map index")
            return
        }
        if (!this.okTypes(keyTy, indexTy)) {
            this.err(span, "map index must be a `{bareName(keyTy)}`")
        }
    }

    fn checkIndex( e: Expr, object: Expr, index: Expr) -> Ty {
        let ot0 = this.checkExpr(object)
        let it = this.checkExpr(index)
        // Indexing through an immutable `&T` borrow reads through the
        // referent: a collection/string referent is indexed exactly like the
        // value itself, a scalar referent is addressed like a pointer element.
        var ot = ot0
        match (ot0) {
            case Ty.Ref(inner) -> {
                match (inner) {
                    case Ty.Int -> {}
                    case Ty.Float -> {}
                    case Ty.Bool -> {}
                    case Ty.Char -> {}
                    case _ -> {
                        ot = inner
                    }
                }
            }
            case _ -> {}
        }
        match (ot) {
            case Ty.List(_) -> {
                if (it != Ty.Unknown && it != Ty.Int) {
                    this.err(e.span, "index must be an `int`")
                }
                if (let some(el) = elem(ot)) {
                    el
                } else {
                    Ty.Unknown
                }
            }
            case Ty.Range(_) -> {
                if (it != Ty.Unknown && it != Ty.Int) {
                    this.err(e.span, "index must be an `int`")
                }
                if (let some(el) = elem(ot)) {
                    el
                } else {
                    Ty.Unknown
                }
            }
            case Ty.Map(keyTy, valTy) -> {
                this.checkMapIndex(keyTy, it, index, e.span)
                valTy
            }
            case Ty.String -> {
                if (it != Ty.Unknown && it != Ty.Int) {
                    this.err(e.span, "string index must be an `int`")
                }
                Ty.Byte
            }
            case Ty.Tuple(items) -> Ty.Tuple(items)
            case Ty.Ptr(inner) -> {
                if (it != Ty.Unknown && it != Ty.Int) {
                    this.err(e.span, "pointer index must be an `int`")
                }
                if (this.unsafeDepth == 0) {
                    this.err(e.span, "pointer indexing may only be used inside an `unsafe` block")
                }
                var scalarP = false
                match (inner) {
                    case Ty.Int -> scalarP = true
                    case Ty.Float -> scalarP = true
                    case Ty.Bool -> scalarP = true
                    case Ty.Char -> scalarP = true
                    case Ty.Byte -> scalarP = true
                    case _ -> {}
                }
                if (scalarP) {
                    inner
                } else {
                    this.err(e.span, "indexing a pointer to a `{bareName(inner)}` value is not supported yet")
                    Ty.Unknown
                }
            }
            // Indexing through an immutable `&T` borrow reads the referent
            // (safe; no `unsafe` needed). Non-scalar referents were
            // dereferenced above, so only scalar referents reach here.
            case Ty.Ref(inner) -> {
                if (it != Ty.Unknown && it != Ty.Int) {
                    this.err(e.span, "pointer index must be an `int`")
                }
                inner
            }
            case Ty.Unknown -> Ty.Unknown
            case other -> {
                this.err(e.span, "cannot index a value of type `{bareName(other)}`")
                Ty.Unknown
            }
        }
    }

    fn checkBinary( e: Expr, op: BinOp, lhs: Expr, rhs: Expr) -> Ty {
        let lt = this.checkExpr(lhs)
        let rt = this.checkExpr(rhs)
        if (op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div || op == BinOp.Mod || op == BinOp.Pow) {
            if (lt != Ty.Unknown && rt != Ty.Unknown) {
                if (!(isNumeric(lt) && isNumeric(rt)) && !(op == BinOp.Add && lt == Ty.String && rt == Ty.String)) {
                    this.errNote(e.span, "operator `" + binOpName(op) + "` requires numeric or string operands, found `" + bareName(lt) + "` and `" + bareName(rt) + "`", "`+` concatenates strings; arithmetic operators need numbers")
                }
            }
            if (lt == Ty.Float || rt == Ty.Float) {
                Ty.Float
            } else if (op == BinOp.Add && (lt == Ty.String || rt == Ty.String)) {
                Ty.String
            } else {
                Ty.Int
            }
        } else if (op == BinOp.Shl || op == BinOp.Shr || op == BinOp.BitAnd || op == BinOp.BitOr || op == BinOp.BitXor) {
            if (lt != Ty.Unknown && lt != Ty.Int) {
                this.err(e.span, "bitwise operators require `int` operands")
            }
            Ty.Int
        } else if (op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Le || op == BinOp.Gt || op == BinOp.Ge) {
            this.checkComparison(e, op, lt, rt)
            Ty.Bool
        } else if (op == BinOp.And || op == BinOp.Or) {
            // `lt`/`rt` are already `checkExpr(lhs)`/`checkExpr(rhs)`. Calling
            // `checkBoolCond` here would re-walk both operands, which doubles
            // the work at every level of a left-leaning `a || b || c` chain
            // (T(n) = 2*T(n-1), i.e. exponential) and re-emits any diagnostic
            // the operands already produced.
            if (lt != Ty.Unknown && lt != Ty.Bool) {
                this.errNote(lhs.span, "condition must be a `bool`", "found `{bareName(lt)}`")
            }
            if (rt != Ty.Unknown && rt != Ty.Bool) {
                this.errNote(rhs.span, "condition must be a `bool`", "found `{bareName(rt)}`")
            }
            Ty.Bool
        } else if (op == BinOp.Range || op == BinOp.RangeIncl) {
            Ty.Range(lt)
        } else if (op == BinOp.NullCoalesce) {
            if (let some(innerT) = innerOption(lt)) {
                if (rt != Ty.Unknown) {
                    this.checkAssignable(innerT, rt, rhs.span, "`??` default")
                }
                innerT
            } else {
                this.errNote(e.span, "left side of `??` is not an `Option`", "`a ?? b` yields `a` when present, else `b`")
                lt
            }
        } else if (op == BinOp.Send) {
            // `channel <- value` sends and yields no value. Mirrors check.rs.
            Ty.Empty
        } else if (op == BinOp.Is) {
            Ty.Bool
        } else {
            // In
            var container = false
            match (rt) {
                case Ty.List(_) -> container = true
                case Ty.Map(_, _) -> container = true
                case Ty.String -> container = true
                case _ -> {}
            }
            if (rt != Ty.Unknown && !container) {
                this.errNote(e.span, "right side of `in` must be a `List`, `Map`, or `string`", "found `" + bareName(rt) + "`")
            }
            Ty.Bool
        }
    }

    /// Comparison operands must actually be comparable. Concrete rules:
    /// numbers compare with every operator (mixed `int`/`float` included);
    /// `char` pairs compare with every operator; `==`/`!=` may additionally
    /// pair identical types. Everything else is an error.
    fn checkComparison( e: Expr, op: BinOp, lt: Ty, rt: Ty) {
        if (lt == Ty.Unknown || rt == Ty.Unknown || hasVar(lt) || hasVar(rt)) {
            return
        }
        let eqOnly = op == BinOp.Eq || op == BinOp.Ne
        let scalar = (isNumeric(lt) && isNumeric(rt)) || (lt == Ty.Char && rt == Ty.Char)
        if (scalar) {
            return
        }
        let byteChar = (lt == Ty.Byte && rt == Ty.Char) || (lt == Ty.Char && rt == Ty.Byte)
        if (byteChar) {
            var charPart: Expr? = none
            match (e.kind) {
                case ExprKind.Binary(_op2, lhs, rhs) -> {
                    if (lt == Ty.Byte) {
                        charPart = rhs
                    } else if (rt == Ty.Byte) {
                        charPart = lhs
                    } else {
                        this.err(e.span, "`byte` values only compare with `int`s or an ASCII `char` literal")
                        return
                    }
                }
                case _ -> {
                    this.err(e.span, "`byte` values only compare with `int`s or an ASCII `char` literal")
                    return
                }
            }
            if (let some(cp) = charPart) {
                match (cp.kind) {
                    case ExprKind.Lit(lit) -> {
                        match (lit) {
                            case Lit.Char(c) -> {
                                if ((c as int) <= 0x7F) {
                                    return
                                }
                                this.err(e.span, "a non-ASCII char literal has no `byte` value: `{c}` (its bytes are multi-byte UTF-8)")
                            }
                            case _ -> {
                                this.err(e.span, "`byte` values only compare with `int`s or an ASCII `char` literal")
                            }
                        }
                    }
                    case _ -> {
                        this.err(e.span, "`byte` values only compare with `int`s or an ASCII `char` literal")
                    }
                }
            }
            return
        }
        if (eqOnly && tyEq(lt, rt)) {
            return // identity/equality on identical types (strings, enums, ...)
        }
        if (tyEq(lt, rt)) {
            this.err(e.span, "operator `" + binOpName(op) + "` is not supported for `" + bareName(lt) + "` operands")
        } else {
            this.err(e.span, "operator `" + binOpName(op) + "` requires comparable operands, found `" + bareName(lt) + "` and `" + bareName(rt) + "`")
        }
    }

    fn checkUnary( e: Expr, op: UnOp, operand: Expr) -> Ty {
        let t = this.checkExpr(operand)
        if (op == UnOp.Neg) {
            if (t != Ty.Unknown && !isNumeric(t)) {
                this.err(e.span, "unary `-` requires a numeric operand, found `{bareName(t)}`")
            }
            t
        } else if (op == UnOp.Not) {
            if (t != Ty.Unknown && t != Ty.Bool) {
                this.err(e.span, "unary `!` requires a `bool` operand, found `{bareName(t)}`")
            }
            Ty.Bool
        } else if (op == UnOp.BitNot) {
            if (t != Ty.Unknown && t != Ty.Int) {
                this.err(e.span, "unary `~` requires an `int` operand, found `{bareName(t)}`")
            }
            Ty.Int
        } else if (op == UnOp.AddrOf) {
            if (this.unsafeDepth == 0) {
                this.err(e.span, "`&` may only be used inside an `unsafe` block")
            }
            match (t) {
                case Ty.Class(_, _) -> Ty.Ptr(t)
                case Ty.Struct(_, _) -> Ty.Ptr(t)
                case Ty.Ptr(_) -> Ty.Ptr(t)
                case Ty.String -> Ty.Ptr(t)
                case Ty.Unknown -> Ty.Ptr(t)
                case Ty.Int -> Ty.Ptr(t)
                case Ty.Float -> Ty.Ptr(t)
                case Ty.Bool -> Ty.Ptr(t)
                case Ty.Char -> Ty.Ptr(t)
                case Ty.Byte -> Ty.Ptr(t)
                case other -> {
                    this.err(e.span, "`&` currently only supports class, struct, pointer, and scalar values, found `{bareName(other)}`")
                    Ty.Unknown
                }
            }
        } else {
            // Deref
            let borrow = match (t) {
                case Ty.Ref(_) -> true
                case _ -> false
            }
            if (this.unsafeDepth == 0 && !borrow) {
                this.err(e.span, "`*` may only be used inside an `unsafe` block")
            }
            match (t) {
                case Ty.Ptr(inner) -> inner
                case Ty.Ref(inner) -> inner
                case Ty.Unknown -> Ty.Unknown
                case other -> {
                    this.errNote(e.span, "cannot dereference a value of type `{bareName(other)}`", "only pointers (`*T`) and references (`&T`) can be dereferenced")
                    Ty.Unknown
                }
            }
        }
    }

    fn checkAssign( e: Expr, target: Expr, value: Expr) -> Ty {
        let vt = this.checkExpr(value)
        let movedFrom = this.manualMoveSource(value)
        match (target.kind) {
            case ExprKind.Ident(name) -> {
                // Lexical scope wins: a fn-local (or parameter) shadows
                // session-wide globals by name, matching both identTy (reads)
                // and the emitter (writes). `resolved.globals` spans every
                // module in the compile session, so without this ordering a
                // same-named global in an imported module would hijack
                // assignments to an unrelated local.
                if (let some(l) = this.lookup(name)) {
                    if (!l.mutable) {
                        this.err(target.span, "cannot assign to immutable binding `{name}`")
                    }
                    if (l.manual) {
                        this.errNote(target.span, "cannot overwrite `#[manualAlloc]` binding `{name}`", "`free()` `{name}` first, then bind a new value with `let`")
                    } else if (let some(src) = movedFrom) {
                        this.errNote(target.span, "cannot assign `#[manualAlloc]` value `{src}` to managed binding `{name}`", "take ownership with `#[manualAlloc] let ... = {src}`, or `{src}.free()`")
                    }
                    this.checkAssignable(l.ty, vt, target.span, "assignment")
                    return Ty.Empty
                }
                // A top-level `var` is assignable by name from anywhere in the
                // module; there is no shadow-frame entry to consult.
                var foundGlobal = false
                for (g in this.resolved.globals) {
                    if (g.name == name) {
                        foundGlobal = true
                        // `vt` is the type of `value` computed once above;
                        // re-checking it here would double-emit diagnostics.
                        this.guardRefUse(g.ty, target.span, "an assignment to a top-level `var`")
                        this.checkAssignable(g.ty, vt, target.span, "assignment to a top-level `var`")
                    }
                }
                if (foundGlobal) {
                    return Ty.Empty
                }
                // Implicit receiver field assignment: `count = x`
                // inside a class body writes `this.count`.
                if (let some(st) = this.selfTy) {
                    if (let some(tk) = this.typeKey(st)) {
                        if (let some(f) = this.findField(tk.name, name, tk.args)) {
                            if (!f.mutable) {
                                this.err(target.span, "cannot assign to immutable field `{name}`")
                            }
                            if (f.manual) {
                                this.consumeIntoOwned(value, target.span, "owned field `{name}`")
                            } else if (let some(src) = movedFrom) {
                                this.errNote(target.span, "cannot store `#[manualAlloc]` value `{src}` in managed field `{name}`", "an owned value must stay in an owned position")
                            }
                            this.checkAssignable(f.ty, vt, target.span, "assignment")
                            return Ty.Empty
                        }
                    }
                }
                this.err(target.span, "cannot assign to undeclared name `{name}`")
            }
            case ExprKind.Unary(op, operand) -> {
                if (op == UnOp.Deref) {
                    // Dereferencing a raw pointer needs `unsafe`; writing
                    // through an immutable `&T` borrow is rejected outright.
                    let pt = this.checkExpr(operand)
                    let isBorrow = match (pt) {
                        case Ty.Ref(_) -> true
                        case _ -> false
                    }
                    if (this.unsafeDepth == 0 && !isBorrow) {
                        this.err(target.span, "`*` may only be used inside an `unsafe` block")
                    }
                    match (pt) {
                        case Ty.Ptr(inner) -> {
                            this.checkAssignable(inner, vt, target.span, "assignment")
                        }
                        case Ty.Ref(_) -> {
                            this.err(target.span, "cannot write through an immutable reference (`&T`)")
                        }
                        case Ty.Unknown -> {}
                        case other -> {
                            this.errNote(target.span, "cannot dereference a value of type `{bareName(other)}`", "only pointers (`*T`) and references (`&T`) can be dereferenced")
                        }
                    }
                } else {
                    this.err(target.span, "assignment target must be a variable, member, or index")
                }
            }
            case ExprKind.Member(object, name) -> {
                // Type-qualified static property assignment: `Type.prop = v`.
                let objIsIdent = match (object.kind) {
                    case ExprKind.Ident(_) -> true
                    case _ -> false
                }
                if (objIsIdent) {
                    let tname = match (object.kind) {
                        case ExprKind.Ident(n) -> n
                        case _ -> ""
                    }
                    if (let some(entry) = this.resolved.types.get(tname)) {
                        let gname = entryName(entry)
                        if (let some(f) = this.findField(gname, name, emptyMapStrTy())) {
                            if (!f.isStatic) {
                                this.err(target.span, "instance field `{name}` must be assigned on an instance of `{gname}`")
                            } else if (!f.mutable) {
                                this.err(target.span, "cannot assign to immutable static field `{name}`")
                            }
                            this.checkAssignable(f.ty, vt, target.span, "assignment")
                            return Ty.Empty
                        }
                        if (let some(p) = this.findProperty(gname, name)) {
                            if (!p.isStatic) {
                                this.err(target.span, "instance property `{name}` must be assigned on an instance of `{gname}`")
                            } else if (!p.hasSet) {
                                this.err(target.span, "static property `{name}` has no setter")
                            }
                            this.checkAssignable(p.ty, vt, target.span, "assignment")
                            return Ty.Empty
                        }
                        this.err(target.span, "no assignable member `{name}` on `{tname}`")
                        return Ty.Empty
                    }
                }
                let otRaw = this.checkExpr(object)
                var ot = otRaw
                match (otRaw) {
                    case Ty.Ptr(inner) -> {
                        if (this.unsafeDepth == 0) {
                            this.err(target.span, "pointer access may only be used inside an `unsafe` block")
                        }
                        ot = inner
                    }
                    case Ty.Ref(_) -> {
                        this.err(target.span, "cannot write to a field `{name}` through an immutable reference (`&T`)")
                        ot = Ty.Unknown
                    }
                    case _ -> {}
                }
                if (let some(tk) = this.typeKey(ot)) {
                    if (let some(f) = this.findField(tk.name, name, tk.args)) {
                        if (f.isStatic) {
                            this.err(target.span, "static field `{name}` must be assigned on the type `{tk.name}`, not on an instance")
                        } else if (!f.mutable) {
                            this.err(target.span, "cannot assign to immutable field `{name}`")
                        } else if (f.manual) {
                            this.consumeIntoOwned(value, target.span, "owned field `{name}`")
                        } else if (let some(src) = movedFrom) {
                            this.errNote(target.span, "cannot store `#[manualAlloc]` value `{src}` in managed field `{name}`", "an owned value must stay in an owned position")
                        }
                        this.checkAssignable(f.ty, vt, target.span, "assignment")
                    } else if (let some(p) = this.findProperty(tk.name, name)) {
                        if (!p.hasSet) {
                            this.err(target.span, "property `{name}` has no setter")
                        }
                        this.checkAssignable(subst(p.ty, tk.args), vt, target.span, "assignment")
                    } else {
                        this.err(target.span, "no assignable member `{name}` on `{tk.name}`")
                    }
                } else {
                    this.err(target.span, "cannot assign to a member of a non-class value")
                }
            }
            case ExprKind.Index(object, index) -> {
                if (let some(src) = movedFrom) {
                    this.errNote(target.span, "cannot store `#[manualAlloc]` value `{src}` in a managed collection", "an owned value must stay in an owned position")
                }
                let otIdx = this.checkExpr(object)
                let itIdx = this.checkExpr(index)
                match (otIdx) {
                    case Ty.List(_) -> {
                        if (itIdx != Ty.Unknown && itIdx != Ty.Int) {
                            this.err(target.span, "index must be an `int`")
                        }
                    }
                    case Ty.Range(_) -> {
                        if (itIdx != Ty.Unknown && itIdx != Ty.Int) {
                            this.err(target.span, "index must be an `int`")
                        }
                    }
                    case Ty.Map(k, _) -> {
                        if (itIdx != Ty.Unknown) {
                            this.checkMapIndex(k, itIdx, index, target.span)
                        }
                    }
                    case _ -> {}
                }
                var elemTy = Ty.Unknown
                match (otIdx) {
                    case Ty.List(inner) -> elemTy = inner
                    case Ty.Map(_, v) -> elemTy = v
                    case Ty.String -> elemTy = Ty.Byte
                    case Ty.Ptr(inner) -> {
                        if (itIdx != Ty.Unknown && itIdx != Ty.Int) {
                            this.err(target.span, "pointer index must be an `int`")
                        }
                        if (this.unsafeDepth == 0) {
                            this.err(object.span, "pointer stores may only be used inside an `unsafe` block")
                        }
                        var scalarPt = false
                        match (inner) {
                            case Ty.Int -> scalarPt = true
                            case Ty.Float -> scalarPt = true
                            case Ty.Bool -> scalarPt = true
                            case Ty.Char -> scalarPt = true
                            case Ty.Byte -> scalarPt = true
                            case _ -> {}
                        }
                        if (scalarPt) {
                            elemTy = inner
                        } else {
                            this.err(target.span, "storing through a pointer to a `{bareName(inner)}` value is not supported yet")
                            elemTy = Ty.Unknown
                        }
                    }
                    case Ty.Ref(_) -> {
                        this.err(target.span, "cannot write through an immutable reference (`&T`)")
                        elemTy = Ty.Unknown
                    }
                    case _ -> {
                        this.err(target.span, "index assignment target must be a List, Map, string, or pointer")
                        elemTy = Ty.Unknown
                    }
                }
                this.types[spanKey(target.span)] = elemTy
                this.checkAssignRhs(elemTy, vt, value, target.span, "assignment")
            }
            case _ -> {
                this.err(target.span, "assignment target must be a variable, member, or index")
            }
        }
        let _ = e.span
        vt
    }

    fn checkLambda( e: Expr, params: List<Param>, returnTy: TypeExpr?, isAsync: bool, body: FnBody) -> Ty {
        let _ = isAsync
        this.pushScope()
        var paramTys = emptyTyList()
        for (p in params) {
            let pt = this.resolveParamTy(p)
            paramTys.push(pt)
            this.declare(p.name, pt, true)
        }
        let savedRet = this.retTy
        var ret = Ty.Unknown
        if (let some(ty) = returnTy) {
            this.retTy = this.resolvedFnTy(ty, copyStrList(this.fnGenerics))
            this.guardRefUse(this.retTy, e.span, "a lambda return type")
        } else {
            this.retTy = Ty.Unknown
        }
        this.checkFnBody(body)
        if (let some(ty) = returnTy) {
            ret = this.resolvedFnTy(ty, copyStrList(this.fnGenerics))
        } else {
            // No annotation: infer the return type from the body tail, exactly
            // like the emitter's pre-pass will for the hoisted function.
            match (body) {
                case FnBody.Expr(be) -> {
                    if (let some(t) = this.types.get(spanKey(be.span))) {
                        ret = t
                    } else {
                        ret = Ty.Empty
                    }
                }
                case FnBody.Block(bb) -> {
                    if (let some(be) = bb.expr) {
                        if (let some(t) = this.types.get(spanKey(be.span))) {
                            ret = t
                        } else {
                            ret = Ty.Empty
                        }
                    } else {
                        ret = Ty.Empty
                    }
                }
            }
        }
        this.retTy = savedRet
        this.popScope()
        let _ = e.span
        Ty.Fn(paramTys, ret)
    }

    fn checkAbs( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`abs(x)` takes exactly one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let at = this.checkExpr(args[0].value)
        match (at) {
            case Ty.Int -> at
            case Ty.Float -> at
            case Ty.Unknown -> at
            case _ -> {
                this.err(args[0].value.span, "`abs` requires an `int` or `float` argument")
                Ty.Unknown
            }
        }
    }

    /// `min(a, b)` / `max(a, b)`: two arguments of the same numeric type;
    /// the result has that type.
    fn checkMinmax( e: Expr, bname: string, args: List<CallArg>) -> Ty {
        if (len(args) != 2) {
            this.err(e.span, "`{bname}(a, b)` takes exactly two arguments")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        if (!isNoneStr(args[0].name) || args[0].spread || !isNoneStr(args[1].name) || args[1].spread) {
            this.err(e.span, "`{bname}(a, b)` takes exactly two arguments")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let lt = this.checkExpr(args[0].value)
        let rt = this.checkExpr(args[1].value)
        let ltGood = match (lt) {
            case Ty.Int -> true
            case Ty.Float -> true
            case Ty.Unknown -> true
            case _ -> false
        }
        let rtGood = match (rt) {
            case Ty.Int -> true
            case Ty.Float -> true
            case Ty.Unknown -> true
            case _ -> false
        }
        if (!ltGood || !rtGood) {
            this.err(e.span, "`{bname}` requires two `int` or `float` arguments")
            return Ty.Unknown
        }
        if (lt == Ty.Float || rt == Ty.Float) {
            Ty.Float
        } else if (lt == Ty.Int || rt == Ty.Int) {
            Ty.Int
        } else {
            Ty.Unknown
        }
    }

    /// `clamp(x, lo, hi)`: three arguments of the same numeric type;
    /// the result has that type.
    fn checkClamp( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 3) {
            this.err(e.span, "`clamp(x, lo, hi)` takes exactly three arguments")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        for (a in args) {
            if (!isNoneStr(a.name) || a.spread) {
                this.err(e.span, "`clamp(x, lo, hi)` takes exactly three arguments")
                for (b in args) {
                    let _ = this.checkExpr(b.value)
                }
                return Ty.Unknown
            }
        }
        var t = Ty.Unknown
        for (a in args) {
            let at = this.checkExpr(a.value)
            if (!(at == Ty.Int || at == Ty.Float || at == Ty.Unknown)) {
                this.err(a.value.span, "`clamp` arguments must be `int` or `float`")
                return Ty.Unknown
            }
            if (at == Ty.Float) {
                t = Ty.Float
            } else if (at == Ty.Int && t != Ty.Float) {
                t = Ty.Int
            }
        }
        t
    }

    /// `str(x)`: an `int`, `float`, `bool`, or `char` value rendered as
    /// `string` (matching the runtime's `pickle_str_from_*` family).
    fn checkStr( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`str(x)` takes exactly one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let at = this.checkExpr(args[0].value)
        match (at) {
            case Ty.Int -> Ty.String
            case Ty.Float -> Ty.String
            case Ty.Bool -> Ty.String
            case Ty.Char -> Ty.String
            case Ty.Unknown -> Ty.String
            case Ty.List(inner) -> {
                if (inner == Ty.Byte) {
                    Ty.String
                } else {
                    this.err(args[0].value.span, "`str` requires an `int`, `float`, `bool`, `char`, or `List<byte>` argument")
                    Ty.Unknown
                }
            }
            case _ -> {
                this.err(args[0].value.span, "`str` requires an `int`, `float`, `bool`, `char`, or `List<byte>` argument")
                Ty.Unknown
            }
        }
    }

    fn checkBytes( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`bytes(s)` takes exactly one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let at = this.checkExpr(args[0].value)
        if (!(at == Ty.String || at == Ty.Unknown)) {
            this.err(args[0].value.span, "`bytes` requires a `string` argument")
        }
        Ty.List(Ty.Byte)
    }

    fn checkRange( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) == 0 || len(args) > 3) {
            this.err(e.span, "`range(end)`, `range(start, end)`, or `range(start, end, step)` expected")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        for (a in args) {
            if (!isNoneStr(a.name) || a.spread) {
                this.err(a.span, "`range` takes only plain positional arguments")
            }
            let at = this.checkExpr(a.value)
            if (!(at == Ty.Int || at == Ty.Unknown)) {
                this.err(a.value.span, "`range` bounds must be integers")
            }
        }
        Ty.List(Ty.Int)
    }

    /// `read_file(path)`: reads a whole file as `string`, or `none` when the
    /// file cannot be read. Errors are values (no exceptions).
    fn checkReadFile( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`read_file(path)` takes exactly one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let at = this.checkExpr(args[0].value)
        if (!(at == Ty.String || at == Ty.Unknown)) {
            this.err(args[0].value.span, "`read_file` requires a `string` path")
            return Ty.Unknown
        }
        Ty.Option(Ty.String)
    }

    /// `write_file(path, text)`: overwrites `path` with `text`'s UTF-8 bytes
    /// and returns `true` on success, `false` on failure.
    fn checkWriteFile( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 2) {
            this.err(e.span, "`write_file(path, text)` takes exactly two arguments")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        if (!isNoneStr(args[0].name) || args[0].spread || !isNoneStr(args[1].name) || args[1].spread) {
            this.err(e.span, "`write_file(path, text)` takes exactly two arguments")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        var i = 0
        while (i < len(args)) {
            let at = this.checkExpr(args[i].value)
            if (!(at == Ty.String || at == Ty.Unknown)) {
                var which = "path"
                if (i != 0) {
                    which = "text"
                }
                this.err(args[i].value.span, "`write_file` argument {which} must be a `string`")
                return Ty.Unknown
            }
            i = i + 1
        }
        Ty.Bool
    }

    /// `file_exists(path)`: whether the path exists on the filesystem.
    fn checkFileExists( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`file_exists(path)` takes exactly one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let at = this.checkExpr(args[0].value)
        if (!(at == Ty.String || at == Ty.Unknown)) {
            this.err(args[0].value.span, "`file_exists` requires a `string` path")
            return Ty.Unknown
        }
        Ty.Bool
    }

    /// `delete(path)`: removes a file at `path`; `false` when it is missing or
    /// cannot be removed.
    fn checkDelete( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`delete(path)` takes exactly one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let at = this.checkExpr(args[0].value)
        if (!(at == Ty.String || at == Ty.Unknown)) {
            this.err(args[0].value.span, "`delete` requires a `string` path")
            return Ty.Unknown
        }
        Ty.Bool
    }

    /// `mkdir(path)`: creates a directory at `path`; `false` when it already
    /// exists or cannot be created.
    fn checkMkdir( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`mkdir(path)` takes exactly one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let at = this.checkExpr(args[0].value)
        if (!(at == Ty.String || at == Ty.Unknown)) {
            this.err(args[0].value.span, "`mkdir` requires a `string` path")
            return Ty.Unknown
        }
        Ty.Bool
    }

    /// `list_dir(path)`: lists a directory as `List<string>?` of child paths
    /// (full paths), or `none` when the path is not a readable directory.
    fn checkListDir( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`list_dir(path)` takes exactly one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let at = this.checkExpr(args[0].value)
        if (!(at == Ty.String || at == Ty.Unknown)) {
            this.err(args[0].value.span, "`list_dir` requires a `string` path")
            return Ty.Unknown
        }
        Ty.Option(Ty.List(Ty.String))
    }

    /// `stream_open_read/write/append(path)`: opens a buffered file stream,
    /// returning `Stream?` (`none` when the path cannot be opened).
    fn checkStreamOpen( e: Expr, bname: string, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`{bname}(path)` takes exactly one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let at = this.checkExpr(args[0].value)
        if (!(at == Ty.String || at == Ty.Unknown)) {
            this.err(args[0].value.span, "`{bname}` requires a `string` path")
            return Ty.Unknown
        }
        Ty.Option(Ty.Stream)
    }

    /// `stdout_stream()` / `stderr_stream()`: a write-only console stream.
    fn checkStreamSingleton( e: Expr, bname: string, args: List<CallArg>) -> Ty {
        if (len(args) > 0) {
            this.err(e.span, "`{bname}()` takes no arguments")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        Ty.Stream
    }

    /// `args()`: the program's command-line arguments (excluding the program
    /// name) as a `List<string>`.
    fn checkArgsBuiltin( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) > 0) {
            this.err(e.span, "`args()` takes no arguments")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        Ty.List(Ty.String)
    }

    /// `exit(code)`: terminate the process with a numeric exit code.
    fn checkExit( e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`exit(code)` takes exactly one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let codeTy = this.checkExpr(args[0].value)
        if (!(codeTy == Ty.Int || codeTy == Ty.Unknown)) {
            this.err(args[0].value.span, "`exit` requires an `int` exit code")
            return Ty.Unknown
        }
        Ty.Empty
    }

    /// `thread_spawn(body)` and `once_run(o, body)`. `bodyIndex` is the
    /// argument that has to be a zero-argument function: a lambda, or a name
    /// bound to one. The other arguments are handles (`int`).
    fn checkTaskBody( e: Expr, bname: string, args: List<CallArg>, bodyIndex: int) -> Ty {
        var label = "`thread_spawn(body)`"
        if (bodyIndex != 0) {
            label = "`once_run(once, body)`"
        }
        if (!(len(args) == bodyIndex + 1)) {
            this.err(e.span, "{label} takes exactly one body argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        var bi = 0
        for (a in args) {
            if (bi == bodyIndex) {
                bi = bi + 1
                continue
            }
            let t = this.checkExpr(a.value)
            if (!(t == Ty.Int || t == Ty.Unknown)) {
                this.err(a.value.span, "a synchronisation handle is an `int`")
                return Ty.Unknown
            }
            bi = bi + 1
        }
        let body = this.checkExpr(args[bodyIndex].value)
        match (body) {
            case Ty.Fn(params, ret) -> {
                if (len(params) != 0) {
                    this.err(args[bodyIndex].value.span, "{label}'s body must take no parameters")
                } else if (!(ret == Ty.Empty || ret == Ty.Unknown)) {
                    this.err(args[bodyIndex].value.span, "{label}'s body must return nothing")
                }
            }
            case Ty.Unknown -> {}
            case other -> {
                this.err(args[bodyIndex].value.span, "{label}'s body must be a function, found `{bareName(other)}`")
            }
        }
        if (bname == "once_run") {
            Ty.Bool
        } else {
            Ty.Int
        }
    }

    /// `captureBegin()`: enter the test-harness capture mode (turns failing
    /// asserts into recorded failures) without clearing any pending message.
    fn checkCaptureBegin( e: Expr, args: List<CallArg>) -> Ty {
        if (!(len(args) == 0)) {
            this.err(e.span, "`captureBegin()` takes no arguments")
            return Ty.Unknown
        }
        Ty.Empty
    }

    /// `captureTake()`: drain the captured failure message as `string?`, or
    /// `none` when nothing was recorded.
    fn checkCaptureTake( e: Expr, args: List<CallArg>) -> Ty {
        if (!(len(args) == 0)) {
            this.err(e.span, "`captureTake()` takes no arguments")
            return Ty.Unknown
        }
        Ty.Option(Ty.String)
    }

    /// A process-handle operand: `h` must be a `Stream` (or untyped).
    fn checkHandle( a: CallArg) -> bool {
        let at = this.checkExpr(a.value)
        match (at) {
            case Ty.Stream -> { return true }
            case Ty.Unknown -> { return true }
            case _ -> {}
        }
        this.err(a.value.span, "the process handle must be a `Stream`")
        false
    }

    /// `run_cmd(argv, cwd, envs, env_removes, stdin_bytes, max_out,
    /// timeout_ms, inherit_io)`: runs a subprocess to completion and returns
    /// `(int?, string, string, bool)?` -- exit code, stdout, stderr, and a
    /// timeout flag -- or `none` when the program cannot be spawned.
    fn checkRunCmd( e: Expr, args: List<CallArg>) -> Ty {
        var special = false
        for (a in args) {
            if (!isNoneStr(a.name) || a.spread) {
                special = true
            }
        }
        if (len(args) != 8 || special) {
            this.err(e.span, "`run_cmd(argv, cwd, envs, env_removes, stdin_bytes, max_out, timeout_ms, inherit_io)` takes exactly eight argument(s)")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let av = this.checkExpr(args[0].value)
        var ok = false
        match (av) {
            case Ty.List(it) -> {
                match (it) {
                    case Ty.String -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case Ty.Unknown -> { ok = true }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[0].value.span, "`run_cmd`'s `argv` must be a `List<string>`")
            return Ty.Unknown
        }
        let cwd = this.checkExpr(args[1].value)
        ok = false
        match (cwd) {
            case Ty.String -> { ok = true }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.String -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[1].value.span, "`run_cmd`'s `cwd` must be a `string` or `none`")
            return Ty.Unknown
        }
        let envs = this.checkExpr(args[2].value)
        ok = false
        match (envs) {
            case Ty.Map(k, v) -> {
                var kk = false
                match (k) {
                    case Ty.String -> { kk = true }
                    case Ty.Unknown -> { kk = true }
                    case _ -> {}
                }
                var vv = false
                match (v) {
                    case Ty.String -> { vv = true }
                    case Ty.Unknown -> { vv = true }
                    case _ -> {}
                }
                if (kk && vv) {
                    ok = true
                }
            }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(_) -> { ok = true }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[2].value.span, "`run_cmd`'s `envs` must be a `Map<string, string>` or `none`")
            return Ty.Unknown
        }
        let rm = this.checkExpr(args[3].value)
        ok = false
        match (rm) {
            case Ty.List(it) -> {
                match (it) {
                    case Ty.String -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.List(jt) -> {
                        match (jt) {
                            case Ty.String -> { ok = true }
                            case Ty.Unknown -> { ok = true }
                            case _ -> {}
                        }
                    }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[3].value.span, "`run_cmd`'s `env_removes` must be a `List<string>` or `none`")
            return Ty.Unknown
        }
        let si = this.checkExpr(args[4].value)
        ok = false
        match (si) {
            case Ty.List(it) -> {
                match (it) {
                    case Ty.Byte -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.List(jt) -> {
                        match (jt) {
                            case Ty.Byte -> { ok = true }
                            case Ty.Unknown -> { ok = true }
                            case _ -> {}
                        }
                    }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[4].value.span, "`run_cmd`'s `stdin_bytes` must be a `List<byte>` or `none`")
            return Ty.Unknown
        }
        let mx = this.checkExpr(args[5].value)
        ok = false
        match (mx) {
            case Ty.Int -> { ok = true }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.Int -> { ok = true }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[5].value.span, "`run_cmd`'s `max_out` must be an `int` or `none`")
            return Ty.Unknown
        }
        let tm = this.checkExpr(args[6].value)
        ok = false
        match (tm) {
            case Ty.Int -> { ok = true }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.Int -> { ok = true }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[6].value.span, "`run_cmd`'s `timeout_ms` must be an `int` or `none`")
            return Ty.Unknown
        }
        let inh = this.checkExpr(args[7].value)
        match (inh) {
            case Ty.Bool -> {}
            case Ty.Unknown -> {}
            case _ -> {
                this.err(args[7].value.span, "`run_cmd`'s `inherit_io` must be a `bool`")
                return Ty.Unknown
            }
        }
        Ty.Option(Ty.Tuple([Ty.Option(Ty.Int), Ty.String, Ty.String, Ty.Bool]))
    }

    /// `run_spawn(argv, cwd, envs, env_removes, max_out)`: start a child and
    /// return a `Stream?` handle for asynchronous `proc_*` access.
    fn checkRunSpawn( e: Expr, args: List<CallArg>) -> Ty {
        var special = false
        for (a in args) {
            if (!isNoneStr(a.name) || a.spread) {
                special = true
            }
        }
        if (len(args) != 5 || special) {
            this.err(e.span, "`run_spawn(argv, cwd, envs, env_removes, max_out)` takes exactly five arguments")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        let av = this.checkExpr(args[0].value)
        var ok = false
        match (av) {
            case Ty.List(it) -> {
                match (it) {
                    case Ty.String -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case Ty.Unknown -> { ok = true }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[0].value.span, "`run_spawn`'s `argv` must be a `List<string>`")
            return Ty.Unknown
        }
        let cwd = this.checkExpr(args[1].value)
        ok = false
        match (cwd) {
            case Ty.String -> { ok = true }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.String -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[1].value.span, "`run_spawn`'s `cwd` must be a `string` or `none`")
            return Ty.Unknown
        }
        let envs = this.checkExpr(args[2].value)
        ok = false
        match (envs) {
            case Ty.Map(k, v) -> {
                var kk = false
                match (k) {
                    case Ty.String -> { kk = true }
                    case Ty.Unknown -> { kk = true }
                    case _ -> {}
                }
                var vv = false
                match (v) {
                    case Ty.String -> { vv = true }
                    case Ty.Unknown -> { vv = true }
                    case _ -> {}
                }
                if (kk && vv) {
                    ok = true
                }
            }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(_) -> { ok = true }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[2].value.span, "`run_spawn`'s `envs` must be a `Map<string, string>` or `none`")
            return Ty.Unknown
        }
        let rm = this.checkExpr(args[3].value)
        ok = false
        match (rm) {
            case Ty.List(it) -> {
                match (it) {
                    case Ty.String -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.List(jt) -> {
                        match (jt) {
                            case Ty.String -> { ok = true }
                            case Ty.Unknown -> { ok = true }
                            case _ -> {}
                        }
                    }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[3].value.span, "`run_spawn`'s `env_removes` must be a `List<string>` or `none`")
            return Ty.Unknown
        }
        let mx = this.checkExpr(args[4].value)
        ok = false
        match (mx) {
            case Ty.Int -> { ok = true }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.Int -> { ok = true }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[4].value.span, "`run_spawn`'s `max_out` must be an `int` or `none`")
            return Ty.Unknown
        }
        Ty.Option(Ty.Stream)
    }

    /// `proc_wait(h)` / `proc_running(h)` / `proc_code(h)` / `proc_kill(h)` /
    /// `proc_in_close(h)`: single-handle process queries.
    fn checkProcHandle( e: Expr, bname: string, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            this.err(e.span, "`" + bname + "(handle)` takes exactly one argument")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        if (!this.checkHandle(args[0])) {
            return Ty.Unknown
        }
        if (bname == "proc_code") {
            return Ty.Option(Ty.Int)
        }
        Ty.Bool
    }

    /// `proc_out_read(h, n)` / `proc_err_read(h, n)`: drained bytes as
    /// `List<byte>?`.
    fn checkProcRead( e: Expr, bname: string, args: List<CallArg>) -> Ty {
        var special = false
        for (a in args) {
            if (!isNoneStr(a.name) || a.spread) {
                special = true
            }
        }
        if (len(args) != 2 || special) {
            this.err(e.span, "`" + bname + "(handle, n)` takes exactly two arguments")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        if (!this.checkHandle(args[0])) {
            return Ty.Unknown
        }
        let n = this.checkExpr(args[1].value)
        match (n) {
            case Ty.Int -> {}
            case Ty.Unknown -> {}
            case _ -> {
                this.err(args[1].value.span, "`" + bname + "`'s `n` must be an `int`")
                return Ty.Unknown
            }
        }
        Ty.Option(Ty.List(Ty.Byte))
    }

    /// `proc_in_write(h, b)`: write `b` (a `List<byte>`) to the child's stdin,
    /// returning the number of bytes written.
    fn checkProcWrite( e: Expr, args: List<CallArg>) -> Ty {
        var special = false
        for (a in args) {
            if (!isNoneStr(a.name) || a.spread) {
                special = true
            }
        }
        if (len(args) != 2 || special) {
            this.err(e.span, "`proc_in_write(handle, b)` takes exactly two arguments")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        if (!this.checkHandle(args[0])) {
            return Ty.Unknown
        }
        let b = this.checkExpr(args[1].value)
        var ok = false
        match (b) {
            case Ty.List(it) -> {
                match (it) {
                    case Ty.Byte -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case Ty.Unknown -> { ok = true }
            case _ -> {}
        }
        if (!ok) {
            this.err(args[1].value.span, "`proc_in_write`'s `b` must be a `List<byte>`")
            return Ty.Unknown
        }
        Ty.Int
    }

    /// `current_dir()`: the workspace directory as `string?`.
    fn checkCurrentDir( e: Expr, args: List<CallArg>) -> Ty {
        if (!(len(args) == 0)) {
            this.err(e.span, "`current_dir()` takes no arguments")
            for (a in args) {
                let _ = this.checkExpr(a.value)
            }
            return Ty.Unknown
        }
        Ty.Option(Ty.String)
    }

    fn checkIf( e: Expr, cond: IfCond, thenBlock: Block, elseExpr: Expr?) -> Ty {
        // For `if (let pattern = value)` the binding stays in scope for the
        // then-block only: a failing pattern skips the binding entirely, so
        // the else branch must not see it.
        var bindScope = false
        match (cond) {
            case IfCond.Cond(c) -> {
                this.checkBoolCond(c)
            }
            case IfCond.Binding(pattern, value) -> {
                let vt = this.checkExpr(value)
                this.checkMatchPattern(pattern, vt, value.span)
                this.pushScope()
                this.bindPattern(pattern, vt, false, value.span)
                bindScope = true
            }
        }
        // Analyze each branch from the same entry state and merge the moved
        // bits, so a value moved on one path is treated as moved afterwards
        // without falsely rejecting a move that happens on both paths.
        let before = this.captureMoved()
        let tt = this.checkBlock(thenBlock)
        var after = this.captureMoved()
        if (bindScope) {
            this.popScope()
        }
        let _ = e.span
        if (let some(elseE) = elseExpr) {
            this.setMoved(before)
            let et = this.checkExpr(elseE)
            let afterElse = this.captureMoved()
            this.unionMoved(after, afterElse)
            if (tt != Ty.Empty && et != Ty.Empty) {
                if (let some(merged) = mergeFlowTypes(tt, et)) {
                    this.setMoved(after)
                    return merged
                } else {
                    this.errNote(elseE.span, "`if` branches have mismatched types: `{bareName(tt)}` and `{bareName(et)}`", "both branches of an if-expression must produce the same type")
                }
            }
            this.setMoved(after)
            tt
        } else {
            this.setMoved(after)
            Ty.Empty
        }
    }

    fn checkMatch( e: Expr, scrutinee: Expr, arms: List<MatchArm>) -> Ty {
        let st = this.checkExpr(scrutinee)
        var result = Ty.Empty
        let before = this.captureMoved()
        var merged: List<Map<string, MovedBits>>? = none
        for (arm in arms) {
            this.setMoved(before)
            this.pushScope()
            this.checkMatchPattern(arm.pattern, st, arm.span)
            this.bindPattern(arm.pattern, st, false, arm.span)
            if (let some(g) = arm.guard) {
                this.checkBoolCond(g)
            }
            let bt = this.checkExpr(arm.body)
            this.popScope()
            let afterArm = this.captureMoved()
            if (let some(acc) = merged) {
                this.unionMoved(acc, afterArm)
            } else {
                merged = afterArm
            }
            if (result == Ty.Empty) {
                result = bt
            } else if (bt != Ty.Empty) {
                if (let some(m) = mergeFlowTypes(result, bt)) {
                    result = m
                } else {
                    this.errNote(arm.span, "match arms produce inconsistent types: `{bareName(result)}` and `{bareName(bt)}`", "all arms of a match expression must produce the same type")
                }
            }
        }
        if (let some(acc) = merged) {
            this.setMoved(acc)
        }
        let _ = e.span
        result
    }

    /// Validate that a match arm's pattern can actually match a scrutinee of
    /// type `st`. Binding/wildcard/tuple patterns are structurally fine;
    /// literals must share the scrutinee's domain, and string patterns may
    /// not interpolate.
    fn checkMatchPattern( p: Pattern, st: Ty, span: Span) {
        let skip = match (st) {
            case Ty.Unknown -> true
            case Ty.Var(_) -> true
            case _ -> false
        }
        if (skip) {
            return
        }
        match (p) {
            case Pattern.Wildcard -> {}
            case Pattern.Binding(_, _) -> {}
            case Pattern.Tuple(parts) -> {
                match (st) {
                    case Ty.Tuple(tys) -> {
                        if (len(tys) != len(parts)) {
                            this.errNote(span, "a {len(parts)}-element tuple pattern cannot match a {len(tys)}-tuple", "tuple patterns must line up with the scrutinee's arity")
                        } else {
                            var i = 0
                            while (i < len(parts)) {
                                this.checkMatchPattern(parts[i], tys[i], span)
                                i = i + 1
                            }
                        }
                    }
                    case other -> {
                        this.errNote(span, "a tuple pattern cannot match a value of type `{bareName(other)}`", "tuple patterns require a tuple scrutinee")
                    }
                }
            }
            case Pattern.Or(alts) -> {
                for (a in alts) {
                    this.checkMatchPattern(a, st, span)
                }
                var anyBinds = false
                for (a in alts) {
                    if (patternIntroducesBinding(a)) {
                        anyBinds = true
                    }
                }
                if (anyBinds) {
                    this.errNote(span, "an or-pattern alternative may not bind a name", "`a | b` joins patterns that only test values (literals, `_`, `some(_)`, `Tag(_)`)")
                }
            }
            case Pattern.Literal(l) -> this.checkMatchLiteral(l, st, span)
            case Pattern.Variant(path, payloads) -> {
                if (len(path) == 1 && path[0] == "some") {
                    if (!isOption(st)) {
                        this.errNote(span, "`some` patterns require an option value, not `{bareName(st)}`", "match `none`/`some(v)` against an option scrutinee")
                    } else {
                        let inner = if (let some(x) = innerOption(st)) { x } else { Ty.Unknown }
                        for (pl in payloads) {
                            this.checkMatchPattern(pl, inner, span)
                        }
                    }
                    return
                }
                // A variant path on a non-enum, non-option scrutinee is a
                // mismatch; enum variants are validated while binding.
                let isEnumSt = match (st) {
                    case Ty.Enum(_, _) -> true
                    case _ -> false
                }
                if (!isOption(st) && !isEnumSt && len(path) >= 2) {
                    this.err(span, "variant pattern `" + joinStrs(path, ".") + "` cannot match a value of type `" + bareName(st) + "`")
                }
                if (isOption(st) && !(len(path) == 1 && path[0] == "some")) {
                    this.err(span, "patterns on an option value must be `some(v)`, `none`, or `_`")
                }
            }
        }
    }

    fn checkMatchLiteral( l: Lit, st: Ty, span: Span) {
        var ok = false
        match (st) {
            case Ty.Int -> {
                match (l) {
                    case Lit.Int(_) -> ok = true
                    case Lit.Float(_) -> ok = true
                    case _ -> {}
                }
            }
            case Ty.Float -> {
                match (l) {
                    case Lit.Int(_) -> ok = true
                    case Lit.Float(_) -> ok = true
                    case _ -> {}
                }
            }
            case Ty.Byte -> {
                match (l) {
                    case Lit.Int(_) -> ok = true
                    case Lit.Float(_) -> ok = true
                    case Lit.Char(c) -> {
                        if ((c as int) <= 0x7F) {
                            ok = true
                        }
                    }
                    case _ -> {}
                }
            }
            case Ty.Char -> {
                match (l) {
                    case Lit.Char(_) -> ok = true
                    case _ -> {}
                }
            }
            case Ty.Bool -> {
                match (l) {
                    case Lit.Bool(_) -> ok = true
                    case _ -> {}
                }
            }
            case Ty.String -> {
                match (l) {
                    case Lit.String(parts) -> {
                        ok = true
                        for (pt in parts) {
                            match (pt) {
                                case StrPart.Expr(_) -> ok = false
                                case _ -> {}
                            }
                        }
                    }
                    case _ -> {}
                }
            }
            case _ -> {
                if (isOption(st)) {
                    match (l) {
                        case Lit.None -> ok = true
                        case _ -> {}
                    }
                }
            }
        }
        if (ok) {
            return
        }
        var hasInterp = false
        match (l) {
            case Lit.String(parts) -> {
                for (pt in parts) {
                    match (pt) {
                        case StrPart.Expr(_) -> hasInterp = true
                        case _ -> {}
                    }
                }
            }
            case _ -> {}
        }
        if (hasInterp) {
            this.errNote(span, "string match patterns may not interpolate", "compare a literal inside the arm body instead")
            return
        }
        var what = ""
        match (l) {
            case Lit.Int(_) -> what = "an integer"
            case Lit.Float(_) -> what = "a float"
            case Lit.Bool(_) -> what = "`true`/`false`"
            case Lit.Char(_) -> what = "a character literal"
            case Lit.String(_) -> what = "a string literal"
            case Lit.None -> what = "`none`"
        }
        this.errNote(span, "{what} pattern cannot match a value of type `{bareName(st)}`", "match patterns must share the scrutinee's type")
    }

    fn checkCast( e: Expr, expr: Expr, ty: TypeExpr, kind: CastKind) -> Ty {
        let src = this.checkExpr(expr)
        let target = this.resolvedFnTy(ty, this.instantiatedGenerics(this.fnGenerics))
        if (kind == CastKind.Is) {
            // `is` must check against a type the source can actually be.
            if (src != Ty.Unknown && target != Ty.Unknown && !this.castRelated(src, target)) {
                this.errNote(e.span, "`{bareName(src)} is {bareName(target)}` can never succeed", "cast target must be assignable from, or an ancestor/descendant of, the source")
            }
            Ty.Bool
        } else {
            // As | TryAs
            var charRel = (src == Ty.Char && (target == Ty.Int || target == Ty.Byte)) || ((src == Ty.Int || src == Ty.Byte) && target == Ty.Char)
            if (src != Ty.Unknown && target != Ty.Unknown && !this.castRelated(src, target) && !charRel) {
                this.errNote(e.span, "cannot cast `{bareName(src)}` to `{bareName(target)}`", "cast target must be assignable from, or an ancestor/descendant of, the source")
            }
            if (kind == CastKind.TryAs) {
                optOf(target)
            } else {
                target
            }
        }
    }

    /// Whether `from` can be safely cast to `to`: numeric conversions,
    /// option<->inner, class inheritance (either direction), and
    /// conforming interfaces.
    fn castRelated( fromTy: Ty, toTy: Ty) -> bool {
        if (tyEq(fromTy, toTy)) {
            return true
        }
if (isNumeric(fromTy) && isNumeric(toTy)) {
                  return true
              }
              // A raw pointer and `int` are both single 64-bit words in the IR
              // domain, and every container ABI body needs to move an object
              // address between a `*T` value and a word slot (`list[5] = data`).
              // Without this the port cannot express a single list/map/object
              // runtime symbol; see PICKLE_AUDIT.md 17.1. Identity lowering in
              // `convert`, so no trap representation is invented.
              if (isPtr(fromTy) && toTy == Ty.Int) {
                  return true
              }
              if (fromTy == Ty.Int && isPtr(toTy)) {
                  return true
              }
              // A function value is also a single 64-bit word in the IR domain
              // (the raw code address, the same word `IrConst::FuncAddr` bakes
              // into registration calls). The GC engine keeps registered
              // `deinit` finalizers as int words and casts them back to a
              // callable only at invocation, so `int` and `fn` need the same
              // word-move relation pointers have. Identity lowering in
              // `convert`; no trap representation is invented.
              if (isFnValue(fromTy) && toTy == Ty.Int) {
                  return true
              }
              if (fromTy == Ty.Int && isFnValue(toTy)) {
                  return true
              }
        // Unwrap option layers on either side.
        if (let some(inner) = innerOption(fromTy)) {
            if (this.castRelated(inner, toTy)) {
                return true
            }
        }
        if (let some(inner) = innerOption(toTy)) {
            if (this.castRelated(fromTy, inner)) {
                return true
            }
        }
        // Same-kind structural/type relations.
        var rel = false
        match (fromTy) {
            case Ty.Class(a, _) -> {
                match (toTy) {
                    case Ty.Class(b, _) -> rel = a == b || this.isAncestor(a, b) || this.isAncestor(b, a) || this.conformsTo(fromTy, toTy) || this.conformsTo(toTy, fromTy)
                    case Ty.Interface(b, _) -> rel = this.implementsInterface(a, b)
                    case _ -> {}
                }
            }
            case Ty.Struct(a, _) -> {
                match (toTy) {
                    case Ty.Struct(b, _) -> rel = a == b || this.isAncestor(a, b) || this.isAncestor(b, a) || this.conformsTo(fromTy, toTy) || this.conformsTo(toTy, fromTy)
                    case Ty.Interface(b, _) -> rel = this.implementsInterface(a, b)
                    case _ -> {}
                }
            }
            case Ty.Interface(a, _) -> {
                match (toTy) {
                    case Ty.Interface(b, _) -> rel = a == b || this.conformsTo(fromTy, toTy) || this.conformsTo(toTy, fromTy)
                    case Ty.Class(b, _) -> rel = this.implementsInterface(b, a)
                    case Ty.Struct(b, _) -> rel = this.implementsInterface(b, a)
                    case _ -> {}
                }
            }
            case Ty.Enum(a, _) -> {
                match (toTy) {
                    case Ty.Enum(b, _) -> rel = a == b
                    case _ -> {}
                }
            }
            case Ty.List(aa) -> {
                match (toTy) {
                    case Ty.List(bb) -> rel = this.castRelated(aa, bb)
                    case _ -> {}
                }
            }
            case Ty.Range(aa) -> {
                match (toTy) {
                    case Ty.Range(bb) -> rel = this.castRelated(aa, bb)
                    case _ -> {}
                }
            }
            case Ty.Map(ka, va) -> {
                match (toTy) {
                    case Ty.Map(kb, vb) -> rel = this.castRelated(ka, kb) && this.castRelated(va, vb)
                    case _ -> {}
                }
            }
            case Ty.Fn(pa, ra) -> {
                match (toTy) {
                    case Ty.Fn(pb, rb) -> {
                        if (len(pa) != len(pb)) {
                            rel = false
                        } else {
                            var ok2 = true
                            var xi = 0
                            while (xi < len(pa)) {
                                if (!this.castRelated(pa[xi], pb[xi])) {
                                    ok2 = false
                                }
                                xi = xi + 1
                            }
                            rel = ok2 && this.castRelated(ra, rb)
                        }
                    }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        rel
    }
}

/// Merge the types produced by two flow branches. A bare value promotes to
/// an option when exactly one side is `none` (or when one side is the
/// option of the other); `Unknown` absorbs everything. Returns `none` when
/// the types are genuinely incompatible.
fn mergeFlowTypes(a: Ty, b: Ty) -> Ty? {
    if (tyEq(a, b)) {
        return a
    }
    match (a) {
        case Ty.None -> {
            match (b) {
                case Ty.None -> { return Ty.None }
                case _ -> { return optOf(b) }
            }
        }
        case _ -> {}
    }
    match (b) {
        case Ty.None -> { return optOf(a) }
        case _ -> {}
    }
    match (a) {
        case Ty.Option(ia) -> {
            if (tyEq(ia, b)) {
                return a
            }
        }
        case _ -> {}
    }
    match (b) {
        case Ty.Option(ib) -> {
            if (tyEq(ib, a)) {
                return b
            }
        }
        case _ -> {}
    }
    if (a == Ty.Unknown || b == Ty.Unknown) {
        return Ty.Unknown
    }
    none
}

/// True when a pattern names a binding at any depth (so it cannot appear
/// as an or-pattern alternative, which would otherwise need identical
/// bindings in every arm).
fn patternIntroducesBinding(p: Pattern) -> bool {
    match (p) {
        case Pattern.Binding(_, _) -> true
        case Pattern.Wildcard -> false
        case Pattern.Literal(_) -> false
        case Pattern.Variant(_path, payloads) -> {
            var any = false
            for (pl in payloads) {
                if (patternIntroducesBinding(pl)) {
                    any = true
                }
            }
            any
        }
        case Pattern.Tuple(parts) -> {
            var any = false
            for (pt in parts) {
                if (patternIntroducesBinding(pt)) {
                    any = true
                }
            }
            any
        }
        case Pattern.Or(alts) -> {
            var any = false
            for (at in alts) {
                if (patternIntroducesBinding(at)) {
                    any = true
                }
            }
            any
        }
    }
}