    /// Check a fixed-arity builtin's arguments and evaluate them left to
    /// right. Mirrors `positional_args` in emit.rs.
    fn positionalArgs(e: Expr, name: string, args: List<CallArg>, params: List<string>) -> List<int>? {
        var special = false
        for (a in args) {
            if (let some(_) = a.name) {
                special = true
            }
            if (a.spread) {
                special = true
            }
        }
        if (!(len(args) == len(params)) || special) {
            var word = "arguments"
            if (len(params) == 1) {
                word = "argument"
            }
            var shown = ""
            var first = true
            for (p in params) {
                if (first) {
                    first = false
                    shown = p
                } else {
                    shown = shown + ", " + p
                }
            }
            this.bad(e.span, "`" + name + "(" + shown + ")` takes exactly " + str(len(params)) + " " + word)
            return none
        }
        var temps = emptyInts()
        for (a in args) {
            if (let some(t) = this.expr(a.value)) {
                temps.push(t)
            } else {
                return none
            }
        }
        temps
    }

    /// Whether `name` resolves to a top-level generic user function (as opposed
    /// to a builtin or a non-generic overridden callable). Mirrors
    /// `generic_user_fn` in emit.rs.
    fn genericUserFn(name: string) -> bool {
        if (let some(infos) = this.resolved.fns.get(name)) {
            for (c in infos) {
                if (!(c.span.start == 0 && c.span.end == 0)) {
                    return len(c.generics) > 0
                }
            }
        }
        false
    }

    /// The name of the generic class/struct whose instantiated member body is
    /// currently being built (materialized generics contain the `<` type
    /// argument separator), or `none`. Mirrors `generic_owner` in emit.rs.
    fn genericOwner() -> string? {
        if (let some(cid) = this.owner) {
            var name = this.classOfName(cid)
            if (containsStr(name, "<")) {
                return name
            }
        }
        none
    }

    /// `Enum.Variant(...)`: an attributed enum constructor call. Payload
    /// scalars are boxed exactly like list elements; the value is a managed
    /// object whose tag is the variant index and whose fields are the boxed
    /// args. Mirrors `enum_ctor` in emit.rs.
    fn enumCtor(e: Expr, t: EnumTable, name: string, args: List<CallArg>) -> int? {
        for (a in args) {
            if (a.spread) {
                this.bad(e.span, "spread arguments are not lowered yet")
                return none
            }
        }
        var vi = -1
        var ftypes = emptyTys()
        var found = false
        var i = 0
        for (v in t.variants) {
            if (v.name == name) {
                vi = i
                ftypes = v.fields
                found = true
                break
            }
            i = i + 1
        }
        if (!found) {
            this.bad(e.span, "enum `" + t.name + "` has no variant `" + name + "`")
            return none
        }
        var n = len(ftypes)
        if (!(len(args) == n)) {
            this.bad(e.span, "`" + name + "` takes " + str(n) + " argument(s), got " + str(len(args)))
            return none
        }
        var tag = this.temp()
        this.instr(IrInstr.Const(tag, IrConst.Int(vi)))
        var count = this.temp()
        this.instr(IrInstr.Const(count, IrConst.Int(n)))
        var obj = this.externCallT1("pickle_enum_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [tag, count])
        var i2 = 0
        for (a in args) {
            var ft = ftypes[i2]
            var rp = this.elemRep(ft, e.span)
            if (let some(rep) = rp) {
                var v = this.expr(a.value)
                if (let some(v) = v) {
                    var vt = Ty.Unknown
                    if (let some(vt2) = this.tyOf(a.value.span)) {
                        vt = vt2
                    }
                    var packed = this.packForPointerBoundary(rep, v, vt, e.span)
                    if (let some(packed) = packed) {
                        var boxed = this.boxForStore(rep, packed, elemIr(ft))
                        if (let some(boxed) = boxed) {
                            var idx = this.temp()
                            this.instr(IrInstr.Const(idx, IrConst.Int(i2)))
                            this.externCallVoid("pickle_enum_set_field", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, idx, boxed])
                        } else {
                            return none
                        }
                    } else {
                        return none
                    }
                } else {
                    return none
                }
            } else {
                return none
            }
            i2 = i2 + 1
        }
        obj
    }

    /// `xs.push(v)` and `xs.pop()` for `List<T>` receivers. The full method
    /// call tower: `Type.staticMethod(...)`, instance methods (virtual when
    /// overridden somewhere), fn-typed fields, interface dispatch, and the
    /// `Map`/`List`/`Stream` methods. Mirrors `method_call` in emit.rs.
fn methodCall(e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        if (this.iceDepth > 150) {
            return none
        }
        this.iceDepth = this.iceDepth + 1
        this.icePath.push("methodCall")
        var r = this.methodCall1(e, object, name, args)
        this.iceDepth = this.iceDepth - 1
        r
    }

fn methodCall1(e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        if (!this.icePoke("methodCall1")) {
            return none
        }
        var ot = this.tyOf(object.span)
        var tnameO = exprKindIdentName(object)
        if (let some(tname) = tnameO) {
            var cidO = this.classByName.get(tname)
            if (let some(cid) = cidO) {
                var ncO = this.namedCtorIds.get(pairKey(str(cid), name))
                if (let some(fid) = ncO) {
                    if (anySpread(args)) {
                        this.bad(e.span, "spreading into a named constructor is not lowered yet")
                        return none
                    }
                    return this.callMethod(e, fid, args, none)
                }
                var mrO = this.methodIds.get(pairKey(str(cid), name))
                if (let some(mr) = mrO) {
                    if (!mr.isStatic) {
                        this.bad(e.span, "instance method `" + name + "` must be called on an instance of `" + tname + "`")
                        return none
                    }
                    if (anySpread(args)) {
                        var pty = this.srcParamList(mr.fid)
                        var rt = this.callRetFor(mr.fid)
                        return this.spreadStaticCall(e, e.span, mr.fid, pty, rt, none, args)
                    }
                    return this.callMethod(e, mr.fid, args, none)
                }
                this.bad(e.span, "`" + tname + "` has no static method `" + name + "`")
                return none
            }
        }
        var cid: int? = none
        if (let some(pt) = ot) {
            var isCS = false
            match (pt) {
                case Ty.Class(_, _) -> isCS = true
                case Ty.Struct(_, _) -> isCS = true
                case _ -> {}
            }
            if (isCS) {
                cid = this.classIdOf(pt, e.span)
            } else {
                var inner: Ty? = none
                match (pt) {
                    case Ty.Ref(iner) -> inner = iner
                    case _ -> {}
                }
                if (let some(iner) = inner) {
                    var isCS2 = false
                    match (iner) {
                        case Ty.Class(_, _) -> isCS2 = true
                        case Ty.Struct(_, _) -> isCS2 = true
                        case _ -> {}
                    }
                    if (isCS2) {
                        cid = this.classIdOf(iner, e.span)
                    }
                }
            }
        }
        if (let some(cc) = cid) {
            var mrO = this.methodIds.get(pairKey(str(cc), name))
            if (let some(mr) = mrO) {
                if (mr.isStatic) {
                    this.bad(e.span, "static method `" + name + "` must be called on the type, not an instance")
                    return none
                }
var receiverOpt = this.expr(object)
                if (let some(receiver) = receiverOpt) {
                    var isSuper = false
                    match (object.kind) {
                        case ExprKind.Super -> isSuper = true
                        case _ -> {}
                    }
                    var vb: List<DispatchBranch>? = none
                    if (!isSuper) {
                        vb = this.virtualDispatch.get(pairKey(str(cc), name))
                    }
                    if (let some(branches) = vb) {
                        if (len(branches) > 0) {
                            return this.virtualMethodCall(e, mr.fid, args, receiver, branches)
                        }
                    }
                    var mfid = mr.fid
                    return this.callMethod(e, mfid, args, receiver)
                }
                return none
            }
            var slotO = this.instanceFieldIndex(cc, name)
            if (let some(slot) = slotO) {
                var ft = this.fieldAt(cc, slot).ty
                var isFn = false
                match (ft) {
                    case Ty.Fn(_, _) -> isFn = true
                    case _ -> {}
                }
                if (isFn) {
                    var owner = this.expr(object)
                    if (let some(owner) = owner) {
                        var fv = this.fieldRead(e.span, owner, ft, slot)
                        if (let some(fv) = fv) {
                            return this.fnValueCallFrom(e, fv, ft, args)
                        }
                        return none
                    }
                    return none
                }
                this.bad(e.span, "field `" + name + "` of `" + this.classOfName(cc) + "` is not callable")
                return none
            }
this.bad(e.span, "`" + this.classOfName(cc) + "` has no method `" + name + "`")
            return none
        }

        // Receive-receiver (interface/list/map/stream/...) methods reject
        // spreads: only class/struct methods are wired through
        // `spreadStaticCall`. Mirrors emit.rs `method_call`.
        if (anySpread(args)) {
            this.bad(e.span, "spread arguments are not lowered for this receiver")
            return none
        }
        var hasIface = false
        if (let some(pt) = ot) {
            if (let some(_) = ifaceOf(pt)) {
                hasIface = true
            }
        }
        if (hasIface) {
            if (let some(pt) = ot) {
                return this.interfaceMethodCall(e, pt, object, name, args)
            }
            return none
        }
        var isMap = false
        var mapK = Ty.Unknown
        var mapV = Ty.Unknown
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Map(k, v) -> {
                    mapK = k
                    mapV = v
                    isMap = true
                }
                case _ -> {}
            }
        }
        if (isMap) {
            var kr = this.keyRep(mapK, object.span)
            if (let some(krep) = kr) {
                var vr = this.elemRep(mapV, e.span)
                if (let none = vr) {
                    return none
                }
                var obj = this.expr(object)
                if (let some(obj) = obj) {
                    match (name) {
                        case "has" -> {
                            if (!(len(args) == 1)) {
                                this.bad(e.span, "`has` takes one argument")
                                return none
                            }
var kt = this.expr(args[0].value)
                            if (let some(kt) = kt) {
                                var aTy = mapK
                                var aTyO = this.tyOf(args[0].value.span)
                                if (let some(t) = aTyO) {
                                    aTy = t
                                }
                                var keyO = this.packMapKey(krep, kt, aTy, args[0].value.span)
                                if (let some(key) = keyO) {
                                    return this.externCallT1("pickle_map_has", [IrTy.Ptr, IrTy.Ptr], IrTy.Bool, [obj, key])
                                }
                                return none
                            }
                            return none
                        }
                        case "get" -> {
                            if (!(len(args) == 1)) {
                                this.bad(e.span, "`get` takes one argument (a key)")
                                return none
                            }
var k = this.expr(args[0].value)
                            if (let some(k) = k) {
                                var aTy = mapK
                                var aTyO = this.tyOf(args[0].value.span)
                                if (let some(t) = aTyO) {
                                    aTy = t
                                }
                                var keyO = this.packMapKey(krep, k, aTy, args[0].value.span)
                                if (let some(key) = keyO) {
                                    return this.externCallT1("pickle_map_get", [IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key])
                                }
                                return none
                            }
                            return none
                        }
                        case "remove" -> {
                            if (!(len(args) == 1)) {
                                this.bad(e.span, "`remove` takes one argument (a key)")
                                return none
                            }
var k = this.expr(args[0].value)
                            if (let some(k) = k) {
                                var aTy = mapK
                                var aTyO = this.tyOf(args[0].value.span)
                                if (let some(t) = aTyO) {
                                    aTy = t
                                }
                                var keyO = this.packMapKey(krep, k, aTy, args[0].value.span)
                                if (let some(key) = keyO) {
                                    return this.externCallT1("pickle_map_remove", [IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key])
                                }
                                return none
                            }
                            return none
                        }
                        case "keys" -> {
                            if (!(len(args) == 0)) {
                                this.bad(e.span, "`keys` takes no arguments")
                                return none
                            }
                            return this.externCallT1("pickle_map_keys", [IrTy.Ptr], IrTy.Ptr, [obj])
                        }
                        case "values" -> {
                            if (!(len(args) == 0)) {
                                this.bad(e.span, "`values` takes no arguments")
                                return none
                            }
                            return this.externCallT1("pickle_map_values", [IrTy.Ptr], IrTy.Ptr, [obj])
                        }
                        case _ -> {
                            this.bad(e.span, "`" + name + "` method on `Map` is not lowered yet")
                            return none
                        }
                    }
                }
                return none
            }
            return none
        }
        var isList = false
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.List(_) -> isList = true
                case _ -> {}
            }
        }
        if (isList) {
            return this.listMethodCall(e, object, name, args)
        }
        var isStream = false
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Stream -> isStream = true
                case _ -> {}
            }
        }
        if (isStream) {
            return this.streamMethodCall(e, object, name, args)
        }
        this.bad(e.span, "method calls on this type are not lowered yet")
        none
    }

    /// Emit a call to a class method function, passing the receiver first for
    /// instance methods. Mirrors `call_method` in emit.rs.
fn callMethod(e: Expr, fid: int, args: List<CallArg>, receiver: int?) -> int? {
        if (!this.icePoke("callMethod")) {
            return none
        }
        if (anySpread(args)) {
            var pty = this.srcParamList(fid)
            var rt = this.callRetFor(fid)
            return this.spreadStaticCall(e, e.span, fid, pty, rt, receiver, args)
        }
var callArgs = emptyInts()
        var ca = this.marshalMethodArgs(e, fid, args, receiver)
        if (let some(c) = ca) {
            callArgs = c
        } else {
            return none
        }
        this.emitCallTo(fid, callArgs, e)
    }

    /// Marshal a method call's receiver (first for instance methods) and
    /// argument values into the callee's calling-convention temp list. A
    /// parameter declared `T` with a `T?` option-typed callee slot gets its
    /// scalar lifted via `option_wrap`. Mirrors `marshal_method_args`.
fn marshalMethodArgs(e: Expr, fid: int, args: List<CallArg>, receiver: int?) -> List<int>? {
        if (!this.icePoke("marshalMethodArgs")) {
            return none
        }
        let _ = e
        var fparams = this.irModule.funcs[fid].params
        var callArgs = emptyInts()
        if (let some(r) = receiver) {
            callArgs.push(r)
        }
        var base = len(callArgs)
        var i = 0
        for (a in args) {
var src: Ty? = none
            if (let some(sps) = this.srcParamTys.get(fid)) {
                if (i < len(sps)) {
                    src = sps[i]
                }
            }
            var isRef = false
            if (let some(s) = src) {
                match (s) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
var t = this.borrowArg(src, a)
            if (let some(t) = t) {
                var fparamTy: IrTy? = none
                if (base + i < len(fparams)) {
                    fparamTy = fparams[base + i].ty
                } else {
                    if (let some(s) = src) {
                        fparamTy = this.mapTy(s, a.value.span)
                    }
                }
                var wantsWrap = false
                if (!isRef) {
                    if (let some(ft) = fparamTy) {
                        if (irTyTag(ft) == irTyTag(IrTy.Ptr)) {
                            wantsWrap = true
                        }
                    }
                }
                if (wantsWrap) {
                    var vt = Ty.Unknown
                    if (let some(v) = this.tyOf(a.value.span)) {
                        vt = v
                    }
                    var ov = this.optionWrap(t, vt, a.value.span)
                    if (let some(o) = ov) {
                        callArgs.push(o)
                    } else {
                        return none
                    }
                } else {
                    callArgs.push(t)
                }
            } else {
                return none
            }
            i = i + 1
        }
        callArgs
    }

    /// Emit the `Call` instruction of an already-marshaled method call.
    fn emitCallTo(fid: int, callArgs: List<int>, e: Expr) -> int {
        let _ = e
        var dst = this.temp()
        this.instr(IrInstr.Call(dst, Callee.Func(fid), callArgs))
        // A Pickle-level `throw` is cooperative: the callee returns normally
        // with the pending flag set instead of unwinding, so the call site has
        // to notice and leave before anyone reads `dst`.
        this.guardPropagation(fid)
        dst
    }

    /// Emit the pending check after a call to `fid`, if that call can propagate.
    /// After a call that may leave a throw pending, either record the edge (on
    /// the analysis pass) or emit the check (on the real one).
    ///
    /// Recording happens even when the enclosing function will turn out not to
    /// need a check at all: the call really is a call, so it really is an edge.
    /// Keeping every edge is what makes the fixed point safe, since the answer
    /// is only ever used to *remove* a check.
    fn guardPropagation(fid: int) {
        if (this.analyzing) {
            if (let some(caller) = this.currentFid) {
                match (this.callEdges.get(caller)) {
                    case some(callees) -> callees.push(fid)
                    case none -> this.callEdges[caller] = [fid]
                }
            }
            return
        }
        if (this.checkPropagates(fid)) {
            this.checkPending()
        }
    }

    /// Can a call to `fid` leave a throw pending?
    ///
    /// A program with no `throw` anywhere cannot propagate one, so it skips
    /// every check. Otherwise this is the fixed point from `solveMayThrow`, and
    /// anything it does not know -- a function the analysis pass could not reach
    /// -- is assumed to propagate. That direction only ever costs a predictable
    /// branch, whereas guessing "no" would lose a throw.
    fn checkPropagates(fid: int) -> bool {
        if (!this.progMayThrow) {
            return false
        }
        // A `finally` running on a throw path already has the flag set; a check
        // there would see the throw we are transferring on, not a new one.
        if (this.inThrowTransfer) {
            return false
        }
        if (let some(v) = this.mayThrow.get(fid)) {
            v
        } else {
            true
        }
    }

    /// After a call that may have thrown, branch to the innermost `catch` in
    /// this function or out of it. The flag stays set until someone consumes it.
    fn checkPending() {
        let pending = this.externCallT1(EXC_PENDING, emptyIrTys(), IrTy.Bool, emptyInts())
        let thrown = this.newBlock()
        let resume = this.newBlock()
        this.term(IrTerm.BranchIf(pending, thrown, resume))
        this.cur = thrown
        this.transferToHandlerOrPropagate()
        this.cur = resume
    }

    /// Compute the transitive may-throw answer for every function the analysis
    /// pass lowered.
    ///
    /// `directThrow` seeds the set with the functions containing a `throw` of
    /// their own; `callEdges` then carries that backwards along every recorded
    /// call, to a fixed point.
    ///
    /// The result records an answer for *every* function the analysis pass
    /// lowered, including the ones that came out `false`. That is the whole
    /// point: `checkPropagates` treats an absent id as propagating, so recording
    /// only the throwing set would leave every safe callee looking unknown and
    /// every call site checked. Only a function the pass never reached stays
    /// absent, and that can only cost a branch.
    fn solveMayThrow() {
        var throws = emptyIntBoolMap()
        for (fid in this.directThrow.keys()) {
            throws[fid] = true
        }
        var changed = true
        while (changed) {
            changed = false
            for (caller in this.callEdges.keys()) {
                var alreadyThrows = false
                if (let some(already) = throws.get(caller)) {
                    alreadyThrows = already
                }
                if (alreadyThrows) {
                    continue
                }
                if (let some(callees) = this.callEdges.get(caller)) {
                    for (callee in callees) {
                        var calleeThrows = false
                        if (let some(c) = throws.get(callee)) {
                            calleeThrows = c
                        }
                        if (calleeThrows) {
                            throws[caller] = true
                            changed = true
                        }
                    }
                }
            }
        }
        var result = emptyIntBoolMap()
        for (fid in this.fidList) {
            var v = false
            if (let some(hit) = throws.get(fid)) {
                v = hit
            }
            result[fid] = v
        }
        this.mayThrow = result
    }

    /// A zero constant of the function's return type, for a propagating exit.
    /// Infallible, unlike `zeroScalar`: an unhandled type falls back to `Int(0)`
    /// rather than reporting, because a propagate that could not build its zero
    /// would fail the whole function.
    fn exitZero() -> int? {
        var c = IrConst.Int(0)
        match (this.fret) {
            case IrTy.Bool -> c = IrConst.Bool(false)
            case IrTy.Char -> c = IrConst.Char(0 as char)
            case IrTy.Float -> c = IrConst.Float(0.0)
            case _ -> c = IrConst.Int(0)
        }
        this.constTemp(c)
    }

    /// The exit itself, once every `finally` has run.
    fn performExit(exit: Exit) {
        match (exit) {
            case Exit.Return(v) -> {
                this.term(IrTerm.Return(v))
            }
            case Exit.Branch(target) -> {
                this.term(IrTerm.Branch(target))
            }
            case Exit.Propagate -> {
                var v: int? = none
                if (irTyTag(this.fret) == irTyTag(IrTy.Unit)) {
                    v = none
                } else if (irTyTag(this.fret) == irTyTag(IrTy.Ptr)) {
                    v = this.nullTemp()
                } else {
                    v = this.exitZero()
                }
                this.term(IrTerm.Return(v))
            }
        }
        this.cur = this.newBlock()
    }

    /// Run every `finally` still owed on the way out, innermost first, then take
    /// the exit itself.
    fn exitThroughFinallys(exit: Exit) {
        if (len(this.finallys) == 0) {
            this.performExit(exit)
            return
        }
        let chain = this.finallys
        this.finallys = emptyBlocks()
        // The flag is set on every path that reaches here through a throw, so the
        // `finally` bodies run with propagation checks suppressed.
        let saved = this.inThrowTransfer
        this.inThrowTransfer = true
        var i = len(chain) - 1
        while (i >= 0) {
            // One copy of the `finally` per level, then on to the next level.
            let after = this.newBlock()
            this.pushScope()
            this.blockBodyOnly(chain[i])
            this.popScope()
            this.term(IrTerm.Branch(after))
            this.cur = after
            i = i - 1
        }
        this.inThrowTransfer = saved
        this.finallys = chain
        this.performExit(exit)
    }

    /// Leave the current block for the innermost `catch` in this function, or out
    /// of the function when there is none.
    ///
    /// The `finally`s still owed on the way are only the ones from *inside* the
    /// handler's own `try`, and they run innermost first. The handler's own
    /// `finally` is deliberately left on the stack: `tryStmt` emits it once, after
    /// the handler body, on the path this branch takes.
    ///
    /// This only *emits*; it never mutates the `handlers`/`finallys` stacks. Both
    /// callers lower a path that does not necessarily commit -- a `checkPending`
    /// guard resumes into the same handler scope afterwards, and a `throw`
    /// statement is only one of several statements still to be emitted -- so a
    /// transfer that consumed the enclosing context would strand every later
    /// `throw` in the same body. `tryStmt` balances its own push once, when the
    /// body and the handler are both fully emitted.
    fn transferToHandlerOrPropagate() {
        if (len(this.handlers) == 0) {
            this.exitThroughFinallys(Exit.Propagate)
            return
        }
        let handler = this.handlers[len(this.handlers) - 1]
        let chain = this.finallys
        this.finallys = emptyBlocks()
        // The `try` emits its own `finally` after the handler body, not before,
        // so the first `finally` still owed on the way is one past it when the
        // owning `try` has one of its own, and exactly at the base when it does
        // not -- an inner `try`'s `finally` then occupies the base itself.
        var innerBase = handler.finBase
        if (handler.ownFinally) {
            innerBase = innerBase + 1
        }
        // The flag is still set here, so the inner `finally` bodies run with
        // propagation checks suppressed: a check would see the throw we are
        // transferring on and divert straight to the handler, skipping the
        // remaining `finally`s.
        let saved = this.inThrowTransfer
        this.inThrowTransfer = true
        var i = len(chain) - 1
        while (i >= innerBase) {
            let after = this.newBlock()
            this.pushScope()
            this.blockBodyOnly(chain[i])
            this.popScope()
            this.term(IrTerm.Branch(after))
            this.cur = after
            i = i - 1
        }
        this.inThrowTransfer = saved
        // The whole chain goes back, including the handler's own `finally`: the
        // handler body is emitted with it live, so a `return` inside the handler
        // still runs it.
        this.finallys = chain
        this.term(IrTerm.Branch(handler.target))
        this.cur = this.newBlock()
    }

    /// `throw EXPR`. The parser stays permissive about the operand's type, so the
    /// value here is a temp of whatever `expr` produced; the checker has already
    /// established that it is a `string`.
    fn throwStmt(value: Expr, _span: Span) -> bool {
        if (let some(t) = this.expr(value)) {
            var payload = t
            if (irTyTag(this.fret) == irTyTag(IrTy.Ptr)) {
                var vt = Ty.Unknown
                if (let some(gt) = this.tyOf(value.span)) {
                    vt = gt
                }
                if (let some(w) = this.optionWrap(payload, vt, value.span)) {
                    payload = w
                } else {
                    return false
                }
            }
            this.throwWith(payload)
            true
        } else {
            false
        }
    }

    /// Publish `payload` and transfer control.
    ///
    /// With an enclosing `catch` in this function, control branches straight to it
    /// after running any `finally` from *inside* that `catch`'s own `try`, so a
    /// local `throw` costs no flag round-trip. The payload still goes through
    /// `pickle_exc_throw`, which roots it in the GC for the jump and lets the
    /// handler's `pickle_exc_take` release it. With no `catch` here the flag
    /// stays set and the caller observes it after the call.
    fn throwWith(payload: int) {
        if (this.analyzing) {
            // A `throw` in this body is the seed for its own fixed point; the
            // transfer that follows is pass 2's problem.
            if (let some(fid) = this.currentFid) {
                this.directThrow[fid] = true
            }
            return
        }
        this.externCallVoid(EXC_THROW, [IrTy.Ptr], [payload])
        this.transferToHandlerOrPropagate()
    }

    /// `try BODY catch (BINDER)? BLOCK finally BLOCK?`
    ///
    /// `body` is emitted inline. The end of `body` checks the pending flag and
    /// either falls through to `finally` or enters the handler, which consumes
    /// the flag and binds the payload to a frame slot (the IR has no block
    /// parameters, so the `logic` idiom of a `Slot` written in one block and read
    /// in another is what carries the value across the branch). A `throw` written
    /// inside `body` skips the flag and branches to the handler directly.
    ///
    /// All three ways out -- body normal, handler, and a propagating throw -- run
    /// `fin`, so `fin` is emitted once per way out. The owning `try`'s `finally`
    /// is on the `finallys` stack while `body` and the handler are emitted, so a
    /// `return` inside either runs it; a single pop then balances it before the
    /// fall-through copies are emitted, so those copies cannot re-enter it.
    fn tryStmt(body: Block, binder: string?, handler: Block?, fin: Block?, _span: Span, res: int?) -> bool {
        let afterBody = this.newBlock()
        let handlerId = this.newBlock()
        let handlerFinId = this.newBlock()
        let endId = this.newBlock()
        var hasHandler = false
        var hasFinally = false
        if (let some(_) = handler) {
            hasHandler = true
        }
        if (let some(_) = fin) {
            hasFinally = true
        }

        // A `throw` in the body targets the handler directly, so its context must
        // be in scope while the body is emitted.
        let finBase = len(this.finallys)
        if (let some(f) = fin) {
            this.finallys.push(f)
        }
        if (hasHandler) {
            this.handlers.push(HandlerCtx(handlerId, finBase, hasFinally))
        }

        this.pushScope()
        if (!(this.blockIntoSlot(body, res))) {
            this.popScope()
            return false
        }
        this.popScope()

        if (hasHandler) {
            // A call in the body may have thrown: hand over to the handler.
            let pending = this.externCallT1(EXC_PENDING, emptyIrTys(), IrTy.Bool, emptyInts())
            this.term(IrTerm.BranchIf(pending, handlerId, afterBody))
        } else {
            this.term(IrTerm.Branch(afterBody))
        }

        // The body can no longer `throw` to this handler, so a `throw` in the
        // handler propagates outward instead. Only the context this `try` pushed
        // goes away: a `try` with no `catch` of its own must leave an enclosing
        // handler in scope for the code that follows it.
        if (hasHandler) {
            this.handlers.pop()
        }

        this.cur = handlerId
        if (let some(h) = handler) {
            // Consume the throw: this both clears the flag and yields the payload,
            // and it is the only thing that unroots the payload.
            let payload = this.externCallT1(EXC_TAKE, emptyIrTys(), IrTy.Ptr, emptyInts())
            this.pushScope()
            if (let some(name) = binder) {
                let slot = this.newSlot(IrTy.Ptr)
                this.instr(IrInstr.StoreSlot(slot, payload))
                this.declare(name, slot)
            }
            if (!(this.blockIntoSlot(h, res))) {
                this.popScope()
                return false
            }
            this.popScope()
        }

        if (let some(f) = fin) {
            // A single compile-time pop balances the push from before the body.
            // The handler's fall-through copy and the body's fall-through copy are
            // two emissions of the *same* `finally`, so the stack is already
            // balanced by the time the body copy is emitted.
            this.finallys.pop()
            if (hasHandler) {
                this.term(IrTerm.Branch(handlerFinId))
                this.cur = handlerFinId
                this.pushScope()
                this.blockBodyOnly(f)
                this.popScope()
            }
        }
        this.term(IrTerm.Branch(endId))

        this.cur = afterBody
        if (let some(f) = fin) {
            this.pushScope()
            this.blockBodyOnly(f)
            this.popScope()
        }
        this.term(IrTerm.Branch(endId))
        this.cur = endId
        true
    }

    /// Lower an instance call to a method overridden somewhere in the program:
    /// `pickle_class_is(receiver, D_cid)` checks deepest-derived-first, each
    /// branching to that descendant's own implementation and joining on a
    /// result slot; a receiver that is an instance of no overriding descendant
    /// falls through to the statically-resolved `fallback_fid`. Mirrors
    /// `virtual_method_call`.
fn virtualMethodCall(e: Expr, fallbackFid: int, args: List<CallArg>, receiver: int, branches: List<DispatchBranch>) -> int? {
        if (anySpread(args)) {
            this.bad(e.span, "spread arguments cannot dispatch virtually (the method is overridden)")
            return none
        }
        var rt = IrTy.Unit
        if (let some(r) = this.irty(e.span)) {
            rt = r
        } else {
            return none
        }
        var retSlot = this.newSlot(rt)
        var join = this.newBlock()
        for (b in branches) {
            var cb = this.newBlock()
            var next = this.newBlock()
            var dc = this.intConst(b.cid)
            var found = this.externCallT1("pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [receiver, dc])
            this.term(IrTerm.BranchIf(found, cb, next))
            this.cur = cb
            var callArgs = emptyInts()
            var ca1 = this.marshalMethodArgs(e, b.fid, args, receiver)
            if (let some(c1) = ca1) {
                callArgs = c1
            } else {
                return none
            }
            var val = this.emitCallTo(b.fid, callArgs, e)
            this.instr(IrInstr.StoreSlot(retSlot, val))
            this.term(IrTerm.Branch(join))
            this.cur = next
        }
        var fallbackArgs = emptyInts()
        var caf = this.marshalMethodArgs(e, fallbackFid, args, receiver)
        if (let some(cf) = caf) {
            fallbackArgs = cf
        } else {
            return none
        }
        var val = this.emitCallTo(fallbackFid, fallbackArgs, e)
        this.instr(IrInstr.StoreSlot(retSlot, val))
        this.term(IrTerm.Branch(join))
        this.cur = join
        var dst = this.temp()
        this.instr(IrInstr.LoadSlot(dst, retSlot))
        dst
    }

    /// Lower `object.name(...)` where the receiver's static type is an
    /// interface. The dispatch core is shared with the `Iterable`/`Iterator`
    /// protocol calls; see `interfaceDispatch`. Mirrors `interface_method_call`.
    fn interfaceMethodCall(e: Expr, ift: Ty, object: Expr, name: string, args: List<CallArg>) -> int? {
        var receiver = this.expr(object)
        if (let some(receiver) = receiver) {
            var rt = IrTy.Unit
            if (let some(r) = this.irty(e.span)) {
                rt = r
            } else {
                return none
            }
            return this.interfaceDispatch(e, e.span, ift, receiver, name, args, rt)
        }
        none
    }

    /// Shared core of an interface-dispatched `.name(args)` call against an
    /// already-lowered receiver. A compile-time chain of
    /// `pickle_class_is(receiver, D_cid)` checks over every registered class
    /// that transitively implements the interface, deepest-derived-first, each
    /// branching to that class's own resolved implementation and joining on a
    /// result slot; a runtime fallback `pickle_iface_method(receiver,
    /// iface_id, m_idx)` reads the receiver's own class's method-table entry
    /// and indirect-calls it. Mirrors `interface_dispatch`.
    fn interfaceDispatch(e: Expr, span2: Span, ift: Ty, receiver: int, name: string, args: List<CallArg>, retTy: IrTy) -> int? {
        var ifaceName = ""
        var ifaceArgs = emptyTys()
        var isIface = false
        if (let some(ir) = ifaceOf(ift)) {
            ifaceName = ir.name
            ifaceArgs = ir.args
            isIface = true
        }
        if (!isIface) {
            this.bad(span2, "receiver type is not an interface")
            return none
        }
        var ifaceId = 0
        if (let some(id) = this.ifaceIdFor(ifaceName, ifaceArgs, span2)) {
            ifaceId = id
        } else {
            return none
        }
        var mIdx = -1
        var foundM = false
        var msO = this.ifaceMembers.get(ifaceId)
        if (let some(members) = msO) {
            for (m in members) {
                if (m.name == name) {
                    mIdx = m.index
                    foundM = true
                    break
                }
            }
        }
        if (!foundM) {
            this.bad(span2, "`" + ifaceName + "` has no method `" + name + "`")
            return none
        }
        var branches = emptyIfaceDepths()
        for (p in this.classes) {
            if (!this.classImplementsIface(p.classId, ifaceId)) {
                continue
            }
            var mrO = this.methodIds.get(pairKey(str(p.classId), name))
            if (let none = mrO) {
                continue
            }
            if (let some(mr) = mrO) {
                if (mr.isStatic) {
                    this.bad(span2, "interface method `" + name + "` is static on `" + p.name + "`")
                    return none
                }
                var depth = len(this.ancestry(p.name))
                branches.push(IfaceDepthBranch(depth, p.classId, mr.fid))
            }
        }
        if (len(branches) == 0) {
            this.bad(span2, "`" + ifaceName + "." + name + "` is implemented by no class in this program")
            return none
        }
        sortIfaceBranches(branches)
        var retSlot = this.newSlot(retTy)
        var join = this.newBlock()
        for (b in branches) {
            var cb = this.newBlock()
            var next = this.newBlock()
            var dc = this.intConst(b.cid)
            var found = this.externCallT1("pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [receiver, dc])
            this.term(IrTerm.BranchIf(found, cb, next))
            this.cur = cb
            var callArgs2 = emptyInts()
            var ca2 = this.marshalMethodArgs(e, b.fid, args, receiver)
            if (let some(c2) = ca2) {
                callArgs2 = c2
            } else {
                return none
            }
            var val = this.emitCallTo(b.fid, callArgs2, e)
            this.instr(IrInstr.StoreSlot(retSlot, val))
            this.term(IrTerm.Branch(join))
            this.cur = next
        }
        var iid = this.intConst(ifaceId)
        var midx = this.intConst(mIdx)
        var fp = this.externCallT1("pickle_iface_method", [IrTy.Ptr, IrTy.Int, IrTy.Int], IrTy.Int, [receiver, iid, midx])
        var isZeroO = this.cmpZero(fp, IrBinOp.Eq, false)
        var isZero = -1
        if (let some(z) = isZeroO) {
            isZero = z
        } else {
            return none
        }
        var ok = this.newBlock()
        var guard = this.newBlock()
        this.term(IrTerm.BranchIf(isZero, guard, ok))
        this.cur = guard
        this.externCallVoid("pickle_panic_no_iface_method", emptyIrTys(), emptyInts())
        this.term(IrTerm.Branch(join))
        this.cur = ok
        var prototype = branches[0].fid
        var protoArgs = emptyInts()
        var cap = this.marshalMethodArgs(e, prototype, args, receiver)
        if (let some(cp) = cap) {
            protoArgs = cp
        } else {
            return none
        }
        var params = emptyIrTys()
        params.push(IrTy.Ptr)
        var spsO = this.srcParamTys.get(prototype)
        if (let some(src) = spsO) {
            for (t in src) {
                var mt = this.mapTy(t, span2)
                if (let some(m) = mt) {
                    params.push(m)
                } else {
                    params.push(IrTy.Ptr)
                }
            }
        }
        var dst = this.temp()
        this.instr(IrInstr.CallInd(dst, fp, params, retTy, protoArgs))
        this.instr(IrInstr.StoreSlot(retSlot, dst))
        this.term(IrTerm.Branch(join))
        this.cur = join
        var out = this.temp()
        this.instr(IrInstr.LoadSlot(out, retSlot))
        out
    }


    /// A zero-argument interface call against an already-lowered receiver,
    /// used by the `Iterable`/`Iterator` protocol surface in `for_in_protocol`.
    /// Mirrors `interface_zero_arg_call` in emit.rs.
    fn interfaceZeroArgCall(span2: Span, ift: Ty, rec: int, name: string, retTy: IrTy) -> int? {
        var dummy = Expr(span2, ExprKind.Ident(""))
        this.interfaceDispatch(dummy, span2, ift, rec, name, emptyCallArgs(), retTy)
    }

    /// `xs.push(v)` and `xs.pop()` for `List<T>` receivers. Mirrors
    /// `list_method_call` in emit.rs.
    fn listMethodCall(e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        var elem = Ty.Unknown
        var isList = false
        if (let some(pt) = this.tyOf(object.span)) {
            match (pt) {
                case Ty.List(inner) -> {
                    elem = inner
                    isList = true
                }
                case _ -> {}
            }
        }
        if (!isList) {
            this.bad(e.span, "receiver is not a `List`")
            return none
        }
        var obj = this.expr(object)
        if (let some(obj) = obj) {
            match (name) {
                case "push" -> {
                    if (!(len(args) == 1)) {
                        this.bad(e.span, "`push` takes one argument")
                        return none
                    }
                    var rp = this.elemRep(elem, e.span)
                    if (let some(rep) = rp) {
                        var v = this.expr(args[0].value)
                        if (let some(v) = v) {
                            var pushV = v
                            if (!(rep.isPtr)) {
                                var vt = this.irty(args[0].value.span)
                                if (let some(vt) = vt) {
                                    pushV = this.externCallT1(rep.boxSym, [vt], IrTy.Ptr, [v])
                                } else {
                                    return none
                                }
                            }
                            this.externCallVoid("pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [obj, pushV])
                            return this.unitTemp()
                        }
                        return none
                    }
                    return none
                }
                case "pop" -> {
                    if (!(len(args) == 0)) {
                        this.bad(e.span, "`pop` takes no arguments")
                        return none
                    }
                    var rp = this.elemRep(elem, e.span)
                    if (let some(rep) = rp) {
                        var raw = this.externCallT1("pickle_list_pop", [IrTy.Ptr], IrTy.Ptr, [obj])
                        if (rep.isPtr) {
                            return raw
                        }
                        return this.externCallT1(rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
                    }
                    return none
                }
                case "remove" -> {
                    if (!(len(args) == 1)) {
                        this.bad(e.span, "`remove` takes one argument (an index)")
                        return none
                    }
                    var rp = this.elemRep(elem, e.span)
                    if (let some(rep) = rp) {
                        var index = this.expr(args[0].value)
                        if (let some(index) = index) {
                            var raw = this.externCallT1("pickle_list_remove", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, index])
                            if (rep.isPtr) {
                                return raw
                            }
                            return this.externCallT1(rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
                        }
                        return none
                    }
                    return none
                }
                case "insert" -> {
                    if (!(len(args) == 2)) {
                        this.bad(e.span, "`insert` takes an index and a value")
                        return none
                    }
                    var rp = this.elemRep(elem, e.span)
                    if (let some(rep) = rp) {
                        var index = this.expr(args[0].value)
                        if (let some(index) = index) {
                            var v = this.expr(args[1].value)
                            if (let some(v) = v) {
                                var insV = v
                                if (!(rep.isPtr)) {
                                    var vt = this.irty(args[1].value.span)
                                    if (let some(vt) = vt) {
                                        insV = this.externCallT1(rep.boxSym, [vt], IrTy.Ptr, [v])
                                    } else {
                                        return none
                                    }
                                }
                                this.externCallVoid("pickle_list_insert", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, index, insV])
                                return this.unitTemp()
                            }
                            return none
                        }
                        return none
                    }
                    return none
                }
                case "sort" -> {
                    if (!(len(args) == 0)) {
                        this.bad(e.span, "`sort` takes no arguments")
                        return none
                    }
                    var kv = this.sortKind(elem, e.span)
                    if (let some(kind) = kv) {
                        this.externCallVoid("pickle_list_sort", [IrTy.Ptr, IrTy.Int], [obj, kind])
                        return this.unitTemp()
                    }
                    return none
                }
                case _ -> {
                    this.bad(e.span, "`" + name + "` method on `List` is not lowered yet")
                    return none
                }
            }
        }
        none
    }

    /// Comparison kind for `pickle_list_sort`: 0 = int/byte/char/bool boxed
    /// payloads, 1 = float bits, 2 = string bytes. Mirrors `sort_kind`.
    fn sortKind(elem: Ty, span: Span) -> int? {
        var kind = -1
        var ok = true
        match (elem) {
            case Ty.Int | Ty.Byte | Ty.Char | Ty.Bool -> {
                kind = 0
                ok = true
            }
            case Ty.Float -> {
                kind = 1
                ok = true
            }
            case Ty.String -> {
                kind = 2
                ok = true
            }
            case _ -> ok = false
        }
        if (!ok) {
            this.bad(span, "`sort` is not lowered for `List<" + bareName(elem) + ">`")
            return none
        }
        this.constTemp(IrConst.Int(kind))
    }

    /// Lower a `Stream` method call. `Stream` is carried at the ABI as a raw
    /// object pointer; every method takes that pointer as its receiver. Mirrors
    /// `stream_method_call` in emit.rs.
    fn streamMethodCall(e: Expr, object: Expr, name: string, args: List<CallArg>) -> int? {
        var obj = this.expr(object)
        if (let some(obj) = obj) {
            match (name) {
                case "read" -> {
                    if (!(len(args) == 1)) {
                        this.bad(e.span, "`read` takes one argument (a byte count)")
                        return none
                    }
                    var n = this.expr(args[0].value)
                    if (let some(n) = n) {
                        return this.externCallT1("pickle_stream_read", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, n])
                    }
                    return none
                }
                case "write" -> {
                    if (!(len(args) == 1)) {
                        this.bad(e.span, "`write` takes one argument (a `List<byte>`)")
                        return none
                    }
                    var bytes = this.expr(args[0].value)
                    if (let some(bytes) = bytes) {
                        return this.externCallT1("pickle_stream_write", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [obj, bytes])
                    }
                    return none
                }
                case "flush" -> {
                    if (!(len(args) == 0)) {
                        this.bad(e.span, "`flush` takes no arguments")
                        return none
                    }
                    return this.externCallT1("pickle_stream_flush", [IrTy.Ptr], IrTy.Bool, [obj])
                }
                case "close" -> {
                    if (!(len(args) == 0)) {
                        this.bad(e.span, "`close` takes no arguments")
                        return none
                    }
                    return this.externCallT1("pickle_stream_close", [IrTy.Ptr], IrTy.Bool, [obj])
                }
                case _ -> {
                    this.bad(e.span, "`" + name + "` method on `Stream` is not lowered yet")
                    return none
                }
            }
        }
        none
    }

    /// Whether a registered class (or one of its ancestors) directly declared
    /// `implements` for `iface_id`. Mirrors `class_implements_iface`.
    fn classImplementsIface(cid: int, ifaceId: int) -> bool {
        var cur: int? = cid
        var guard = 0
        while (guard < 64) {
            guard = guard + 1
            if (let none = cur) {
                return false
            }
            if (let some(c) = cur) {
                var bucketsO = this.classIfaceBuckets.get(c)
                if (let some(buckets) = bucketsO) {
                    for (b in buckets) {
                        if (b.ifaceId == ifaceId) {
                            return true
                        }
                    }
                }
                cur = none
                for (p in this.classes) {
                    if (p.classId == c) {
                        cur = p.parent
                        break
                    }
                }
            }
        }
        false
    }

    /// `name<Type,...>(args)`: an explicit generic user-function (or generic
    /// class/struct ctor) call. The call is monomorphized: the generic callee
    /// is instantiated over the resolved type arguments (substituted under the
    /// enclosing instantiation, if any), and the call is emitted as a static
    /// call to that concrete function. Mirrors `generic_call` in emit.rs.
    fn genericCall(e: Expr, name: string, typeArgs: List<TypeExpr>, args: List<CallArg>) -> int? {
        // `Box<int>(...)`: a generic class/struct constructor call. The name
        // shares the generic-call surface with generic functions, but
        // resolves through the type table.
        var table = seedClassTable()
        var isEntry = false
        if (let some(entry) = this.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    table = t
                    isEntry = true
                }
                case TypeTableEntry.Struct(t) -> {
                    table = t
                    isEntry = true
                }
                case _ -> {}
            }
        }
        if (isEntry) {
            return this.genericClassCall(e, name, table, typeArgs, args)
        }
        var info = this.userCallableFirst(name)
        if (let none = info) {
            this.bad(e.span, "unknown generic function `" + name + "`")
            return none
        }
        var inf = seedCallableInfo()
        if (let some(x) = info) {
            inf = x
        }
        var argTys = emptyTys()
        for (te in typeArgs) {
            var t = this.resolved.resolveTy(te, this.fnGenerics, this.diags)
            argTys.push(this.substTy(t))
        }
        if (!(len(argTys) == len(inf.generics))) {
            this.bad(e.span, "`" + name + "` takes " + str(len(inf.generics)) + " type argument(s), found " + str(len(argTys)))
            return none
        }
        this.genericFnCall(e, inf, argTys, args)
    }

    /// Core of a monomorphized generic-function call, shared by the explicit
    /// `name<T,...>(args)` form and the argument-driven `name(args)` form.
    /// Mirrors `generic_fn_call` in emit.rs.
    fn genericFnCall(e: Expr, info: CallableInfo, argTys: List<Ty>, args: List<CallArg>) -> int? {
        var name = info.name
        if (anyHasVar(argTys)) {
            this.bad(e.span, "cannot instantiate `" + name + "` with unresolved type arguments; specify them explicitly like `" + name + "<...>(...)`")
            return none
        }
        var map = emptyStringTyMap()
        var zi = 0
        while (zi < len(info.generics) && zi < len(argTys)) {
            map[info.generics[zi]] = argTys[zi]
            zi = zi + 1
        }
        var key2 = instKey(name, argTys)
        var fid = 0
        var fidO = this.instantiations.get(key2)
        if (let some(f) = fidO) {
            fid = f
        } else {
            var ifg = this.instantiateGenericFn(e.span, info, name, argTys, map)
            if (let some(f2) = ifg) {
                fid = f2
            } else {
                return none
            }
        }
// Mirror the plain user-function call: borrow `&T` reference params,
        // wrap optional params, and store the result.
        if (anySpread(args)) {
            var pty = this.srcParamList(fid)
            var rt = this.callRetFor(fid)
            return this.spreadStaticCall(e, e.span, fid, pty, rt, none, args)
        }
        var argTemps = emptyInts()
        var i = 0
        while (i < len(args)) {
            var a = args[i]
            var srcO: Ty? = none
            if (let some(v) = this.srcParamTys.get(fid)) {
                if (i < len(v)) {
                    srcO = v[i]
                }
            }
            var isRef = false
            if (let some(sr) = srcO) {
                match (sr) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
            var isOpt = false
            if (let some(sr2) = srcO) {
                match (sr2) {
                    case Ty.Option(_) -> isOpt = true
                    case Ty.None -> isOpt = true
                    case _ -> {}
                }
            }
            var t = -1
            if (let some(tv) = this.borrowArg(srcO, a)) {
                t = tv
            } else {
                return none
            }
            var finalT = t
            if (!isRef && isOpt) {
                var vt = Ty.Unknown
                if (let some(gvt) = this.tyOf(a.value.span)) {
                    vt = gvt
                }
                var tw = this.optionWrap(t, vt, a.value.span)
                if (let some(twc) = tw) {
                    finalT = twc
                } else {
                    return none
                }
            }
            argTemps.push(finalT)
            i = i + 1
        }
        var dst = this.temp()
        this.instr(IrInstr.Call(dst, Callee.Func(fid), argTemps))
        this.guardPropagation(fid)
        dst
    }

    /// Lower `name<Type,...>` used as a VALUE (not called): the explicit type
    /// arguments pick the concrete instantiation, which is wrapped in the same
    /// zero-capture closure a plain function value gets, so it can be stored,
    /// passed around, and called through the regular dynamic call convention.
    /// Mirrors `generic_fn_value` in emit.rs.
    fn genericFnValue(e: Expr, name: string, typeArgs: List<TypeExpr>) -> int? {
        var info = this.userCallableFirst(name)
        if (let none = info) {
            this.bad(e.span, "unknown generic function `" + name + "`")
            return none
        }
        var inf = seedCallableInfo()
        if (let some(x) = info) {
            inf = x
        }
        var argTys = emptyTys()
        for (te in typeArgs) {
            var t = this.resolved.resolveTy(te, this.fnGenerics, this.diags)
            argTys.push(this.substTy(t))
        }
        if (!(len(argTys) == len(inf.generics))) {
            this.bad(e.span, "`" + name + "` takes " + str(len(inf.generics)) + " type argument(s), found " + str(len(argTys)))
            return none
        }
        this.genericFnValueFor(e, inf, argTys)
    }

    /// Materialize a generic function as a value over concrete `arg_tys`:
    /// create (or reuse) the instantiation, wrap it in a zero-capture closure
    /// whose slot 0 holds a forwarder trampoline's address, and return the
    /// closure object. Mirrors `generic_fn_value_for` in emit.rs.
    fn genericFnValueFor(e: Expr, info: CallableInfo, argTys: List<Ty>) -> int? {
        if (anyHasVar(argTys)) {
            this.bad(e.span, "cannot use the generic function `" + info.name + "` as a value with unresolved type arguments")
            return none
        }
        var name = info.name
        var map = emptyStringTyMap()
        var zi = 0
        while (zi < len(info.generics) && zi < len(argTys)) {
            map[info.generics[zi]] = argTys[zi]
            zi = zi + 1
        }
        var key2 = instKey(name, argTys)
        var fid = 0
        var fidO = this.instantiations.get(key2)
        if (let some(f) = fidO) {
            fid = f
        } else {
            var ifg = this.instantiateGenericFn(e.span, info, name, argTys, map)
            if (let some(f2) = ifg) {
                fid = f2
            } else {
                return none
            }
        }
        var tramp = 0
        var tg = this.valueTrampoline(e.span, fid)
        if (let some(t) = tg) {
            tramp = t
        } else {
            return none
        }
        this.closureObj(e, tramp, emptyCaptures())
    }

    /// The forwarder trampoline a generic instantiation value is wrapped in:
    /// one per target instantiation, always forwarding the concrete
    /// substituted signature recorded in `finfo`. Mirrors `value_trampoline`
    /// in emit.rs.
    fn valueTrampoline(span: Span, target: int) -> int? {
        if (let some(t) = this.trampFids.get(target)) {
            return t
        }
        var info = seedCallableInfo()
        var infO = this.finfo.get(target)
        if (let none = infO) {
            this.bad(span, "no signature recorded for instantiated function FuncId(" + str(target) + ")")
            return none
        }
        if (let some(x) = infO) {
            info = x
        }
        var pty = emptyTys()
        for (p in info.params) {
            pty.push(p.ty)
        }
        var ret = info.ret
        var anyBad = false
        for (pt in pty) {
            if (let none = this.mapTy(pt, span)) {
                anyBad = true
            }
        }
        if (anyBad) {
            this.bad(span, "cannot map an instantiated function value's parameters")
            return none
        }
        if (let none = this.mapTy(ret, span)) {
            this.bad(span, "cannot map an instantiated function value's return type")
            return none
        }
        var t = this.pushClassFunc("fn.value", "pkl_tramp_" + str(target), FnSource.Trampoline(span, target, pty, ret))
        this.trampFids[target] = t
        t
    }

    /// Infer the type arguments of a generic user function `name(args)` from
    /// the argument expressions' recorded types, exactly as the checker does
    /// (`ty::infer_from`). Every generic parameter must be pinned by at least
    /// one argument; an unpinned one bails with a message mirroring the
    /// checker's. Clean programs never reach this failure (the checker
    /// reports it), so the message is a defensive fallback. Mirrors
    /// `infer_generic_fn_args` in emit.rs.
    fn inferGenericFnArgs(span: Span, info: CallableInfo, args: List<CallArg>) -> List<Ty>? {
        var map = emptyStringTyMap()
        var i = 0
        while (i < len(args)) {
            var a = args[i]
            if (a.spread) {
                this.bad(a.span, "spread arguments are not lowered yet")
                return none
            }
            if (let none = a.name) {
                if (i < len(info.params)) {
                    var want = info.params[i]
                    var got = Ty.Unknown
                    if (let some(t) = this.tyOf(a.value.span)) {
                        got = t
                    }
                    inferFrom(want.ty, got, map)
                }
            }
            i = i + 1
        }
        var missing = emptyStrs()
        for (g in info.generics) {
            if (!(map.has(g))) {
                missing.push(g)
            }
        }
        if (!(len(missing) == 0)) {
            var plural = ""
            if (len(missing) == 1) {
                plural = ""
            } else {
                plural = "s"
            }
            var names = ""
            var mi = 0
            for (g in missing) {
                if (mi > 0) {
                    names = names + ", "
                }
                names = names + "`" + g + "`"
                mi = mi + 1
            }
            this.bad(span, "cannot infer the type argument" + plural + " " + names + " for `" + info.name + "`; specify them explicitly like `" + info.name + "<...>(...)`")
            return none
        }
        var out = emptyTys()
        for (g in info.generics) {
            var got = Ty.Unknown
            if (let some(t) = map.get(g)) {
                got = t
            }
            out.push(got)
        }
        out
    }

    /// A generic class/struct constructor call `Box<int>(arg, ...)`. Resolves
    /// the concrete type arguments, materializes the instantiation plan, and
    /// calls its implicit constructor exactly like a plain `TypeName(arg)`
    /// call. Mirrors `generic_class_call` in emit.rs.
    fn genericClassCall(e: Expr, name: string, cls: ClassTable, typeArgs: List<TypeExpr>, args: List<CallArg>) -> int? {
        var argTys = emptyTys()
        for (te in typeArgs) {
            var t = this.resolved.resolveTy(te, this.fnGenerics, this.diags)
            argTys.push(this.substTy(t))
        }
        if (!(len(argTys) == len(cls.generics))) {
            this.bad(e.span, "`" + name + "` takes " + str(len(cls.generics)) + " type argument(s), found " + str(len(argTys)))
            return none
        }
        var key2 = instKey(name, argTys)
        var cid = 0
        var cidO = this.classInstByArgs.get(key2)
        if (let some(c) = cidO) {
            cid = c
        } else {
            var cg = this.registerClassInstantiation(name, argTys, e.span)
            if (let some(c2) = cg) {
                cid = c2
            } else {
                return none
            }
        }
        var fid = 0
        var fO = this.ctorIds.get(cid)
        if (let none = fO) {
            return none
        }
        if (let some(f2) = fO) {
            fid = f2
        }
        // Mirror the plain class-constructor call: borrow `&T` reference
        // parameters, wrap optional parameters, and store the result.
        var fparams = this.irModule.funcs[fid].params
        var argTemps = emptyInts()
        var i = 0
        while (i < len(args)) {
            var a = args[i]
            if (a.spread) {
                this.bad(a.span, "spread arguments are not lowered yet")
                return none
            }
            var srcO: Ty? = none
            if (let some(v) = this.srcParamTys.get(fid)) {
                if (i < len(v)) {
                    srcO = v[i]
                }
            }
            var isRef = false
            if (let some(sr) = srcO) {
                match (sr) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
            var t = -1
            if (let some(tv) = this.borrowArg(srcO, a)) {
                t = tv
            } else {
                return none
            }
            var fparamIsPtr = false
            if (i < len(fparams)) {
                if (irTyTag(fparams[i].ty) == irTyTag(IrTy.Ptr)) {
                    fparamIsPtr = true
                }
            }
            var finalT = t
            if (!isRef && fparamIsPtr) {
                var vt = Ty.Unknown
                if (let some(gt) = this.tyOf(a.value.span)) {
                    vt = gt
                }
                if (let some(w) = this.optionWrap(t, vt, a.value.span)) {
                    finalT = w
                } else {
                    return none
                }
            }
            argTemps.push(finalT)
            i = i + 1
        }
        var dst = this.temp()
        this.instr(IrInstr.Call(dst, Callee.Func(fid), argTemps))
        this.guardPropagation(fid)
        dst
    }

    /// Create the concrete instantiation of a generic function over `map`
    /// (generic parameter -> concrete type), registering its signature under
    /// `key`, and return its function id. Later calls with the same key reuse
    /// the existing function. Mirrors `instantiate_generic_fn` in emit.rs.
    fn instantiateGenericFn(span: Span, info: CallableInfo, keyName: string, keyTys: List<Ty>, map: Map<string, Ty>) -> int? {
        var name = info.name
        var fO = this.fnDecls.get(name)
        if (let none = fO) {
            this.bad(span, "no declaration for generic function `" + name + "`")
            return none
        }
        var f = seedFnDecl()
        if (let some(d) = fO) {
            f = d
        }
        var hasDefRest = false
        for (p in f.params) {
            if (p.rest) {
                hasDefRest = true
            }
            if (let some(_) = p.default) {
                hasDefRest = true
            }
        }
        if (hasDefRest) {
            this.bad(span, "generic function `" + name + "` with default or rest parameters is not lowered yet")
            return none
        }
        var params = emptyParamInfos()
        for (p in info.params) {
            params.push(ParamInfo(p.name, subst(p.ty, map), p.hasDefault, p.rest, p.span))
        }
        var ret = subst(info.ret, map)
        var symbol = "pkl_" + name + "__"
        var si = 0
        for (t in keyTys) {
            if (si > 0) {
                symbol = symbol + "_"
            }
            symbol = symbol + sanitizeSymbol(bareName(t))
            si = si + 1
        }
        var n = 0
        var symTaken = false
        var fj = 0
        while (fj < len(this.irModule.funcs)) {
            if (this.irModule.funcs[fj].symbol == symbol) {
                symTaken = true
                break
            }
            fj = fj + 1
        }
        while (symTaken) {
            n = n + 1
            symbol = symbol + "_v" + str(n)
            symTaken = false
            var fk = 0
            while (fk < len(this.irModule.funcs)) {
                if (this.irModule.funcs[fk].symbol == symbol) {
                    symTaken = true
                    break
                }
                fk = fk + 1
            }
        }
        if (f.isAsync) {
            // The instantiation is the wrapper; a hidden future body (with the
            // lambda ABI) is registered first so the wrapper can name it. Both
            // carry the substitution, mirroring the non-generic pair.
            var hiddenSymbol = symbol + "__future"
            var hidden = len(this.irModule.funcs)
            this.irModule.funcs.push(IrFunc(name + "__future", hiddenSymbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), false, false, emptyStrs()))
            this.fidList.push(hidden)
            var htys = emptyTys()
            for (p in params) {
                htys.push(p.ty)
            }
            this.fsource[hidden] = FnSource.AsyncBody(f, htys, ret)
            var hiddenInfo = CallableInfo(info.name, info.span, info.visibility, info.isAsync, info.isStatic, info.isOverride, info.isAbstract, info.operator, info.generics, emptyParamInfos(), info.ret)
            this.finfo[hidden] = hiddenInfo
            this.instantonSubst[hidden] = map
            var hg = emptyStrs()
            for (g in f.generics) {
                hg.push(g.name)
            }
            this.fidGenerics[hidden] = hg
            var wfid = len(this.irModule.funcs)
            this.irModule.funcs.push(IrFunc(name, symbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), false, false, emptyStrs()))
            this.fidList.push(wfid)
            this.fsource[wfid] = FnSource.AsyncFn(f, hidden)
            this.finfo[wfid] = CallableInfo(info.name, info.span, info.visibility, info.isAsync, info.isStatic, info.isOverride, info.isAbstract, info.operator, info.generics, params, ret)
            var stys = emptyTys()
            for (p in params) {
                stys.push(p.ty)
            }
            this.srcParamTys[wfid] = stys
            this.instantonSubst[wfid] = map
            var wg = emptyStrs()
            for (g in f.generics) {
                wg.push(g.name)
            }
            this.fidGenerics[wfid] = wg
            this.instantiations[instKey(keyName, keyTys)] = wfid
            return wfid
        }
        var fid = len(this.irModule.funcs)
        this.irModule.funcs.push(IrFunc(name, symbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), false, false, emptyStrs()))
        this.fidList.push(fid)
        this.fsource[fid] = FnSource.TopLevel(f)
        this.finfo[fid] = CallableInfo(info.name, info.span, info.visibility, info.isAsync, info.isStatic, info.isOverride, info.isAbstract, info.operator, info.generics, params, ret)
        var stys = emptyTys()
        for (p in info.params) {
            stys.push(subst(p.ty, map))
        }
        this.srcParamTys[fid] = stys
        this.instantonSubst[fid] = map
        this.instantiations[instKey(keyName, keyTys)] = fid
        fid
    }

    /// A closure-valued callee: evaluate it, check its `fn` signature, then
    /// dispatch indirectly. Mirrors `fn_value_call` in emit.rs.
    fn fnValueCall(e: Expr, callee: Expr, args: List<CallArg>) -> int? {
        var fnty = Ty.Unknown
        if (let some(t) = this.tyOf(callee.span)) {
            fnty = t
        }
        var isFn = false
        match (fnty) {
            case Ty.Fn(_, _) -> isFn = true
            case _ -> {}
        }
        if (!isFn) {
            this.bad(callee.span, "function-valued call has no signature")
            return none
        }
        var obj = 0
        if (let some(o) = this.expr(callee)) {
            obj = o
        } else {
            return none
        }
        this.fnValueCallFrom(e, obj, fnty, args)
    }

    /// Core dynamic dispatch for a closure-valued callee whose object was
    /// already evaluated (`fv`) together with its `fn` type: load the hoisted
    /// body address out of closure slot 0 and call it indirectly with the
    /// closure object first, then the real arguments. Mirrors
    /// `fn_value_call_from` in emit.rs.
    fn fnValueCallFrom(e: Expr, fv: int, fty: Ty, args: List<CallArg>) -> int? {
        var pty = emptyTys()
        var prt = Ty.None
        var isFn = false
        match (fty) {
            case Ty.Fn(pts, r) -> {
                pty = pts
                prt = r
                isFn = true
            }
            case _ -> {}
        }
        if (!isFn) {
            this.bad(e.span, "function-valued call has no signature")
            return none
        }
        var zero = this.intConst(0)
        var addrBoxed = this.externCallT1("pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [fv, zero])
        var fnAddr = this.externCallT1("pickle_unbox_i64", [IrTy.Ptr], IrTy.Int, [addrBoxed])
        var irParams = [IrTy.Ptr]
        var iargs = [fv]
        var i = 0
        while (i < len(args)) {
            var a = args[i]
            if (a.spread) {
                this.bad(a.span, "spread arguments are not lowered yet")
                return none
            }
            var src: Ty? = none
            if (i < len(pty)) {
                src = pty[i]
            }
            var isRef = false
            if (let some(st) = src) {
                match (st) {
                    case Ty.Ref(_) -> isRef = true
                    case _ -> {}
                }
            }
            var t = 0
            var bt = this.borrowArg(src, a)
            if (let some(tv) = bt) {
                t = tv
            } else {
                return none
            }
            var mapsPtr = false
            if (let some(st) = src) {
                var mir = this.mapTy(st, a.span)
                if (let some(ir) = mir) {
                    if (irTyTag(ir) == irTyTag(IrTy.Ptr)) {
                        mapsPtr = true
                    }
                }
            }
            if (!isRef && mapsPtr) {
                var vt = Ty.Unknown
                if (let some(v) = this.tyOf(a.value.span)) {
                    vt = v
                }
                var tw = this.optionWrap(t, vt, a.value.span)
                if (let some(twc) = tw) {
                    t = twc
                } else {
                    return none
                }
            }
            var ir = IrTy.Ptr
            if (let some(st) = src) {
                var mir = this.mapTy(st, a.span)
                if (let some(ir2) = mir) {
                    ir = ir2
                }
            }
            irParams.push(ir)
            iargs.push(t)
            i = i + 1
        }
        var irRet = IrTy.Unit
        var mret = this.mapTy(prt, e.span)
        if (let some(ir) = mret) {
            irRet = ir
        }
        var dst = this.temp()
        this.instr(IrInstr.CallInd(dst, fnAddr, irParams, irRet, iargs))
        dst
    }

    /// A closure object holding `fid`'s code address (boxed) in slot 0 and the
    /// given captures (boxed like list elements) in slots 1..N; the slot layout
    /// must match the hoisted body's reads. Mirrors `closure_obj` in emit.rs.
    fn closureObj(e: Expr, fid: int, captures: List<Capture>) -> int? {
        var cid = 0
        if (let some(c) = this.registerClosureClass(len(captures), e.span)) {
            cid = c
        } else {
            return none
        }
        var cidT = this.intConst(cid)
        var nT = this.intConst(len(captures) + 1)
        var obj = this.externCallT1("pickle_class_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [cidT, nT])
        var addr = this.temp()
        this.instr(IrInstr.Const(addr, IrConst.FuncAddr(fid)))
        var boxed = this.externCallT1("pickle_box_i64", [IrTy.Int], IrTy.Ptr, [addr])
        var zero = this.intConst(0)
        this.externCallVoid("pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, zero, boxed])
        var i = 0
        while (i < len(captures)) {
            var cap = captures[i]
            var slot = -1
            if (let some(s) = this.lookup(cap.name)) {
                slot = s
            } else {
                this.bad(cap.span, "cannot capture `" + cap.name + "` (not in scope here)")
                return none
            }
            var v = this.load(slot)
            var vt = cap.ty
            if (let some(t) = this.tyOf(cap.span)) {
                vt = t
            }
            var rep = ElemRep.ptr()
            if (let some(r) = this.elemRep(cap.ty, cap.span)) {
                rep = r
            } else {
                return none
            }
            var packed = 0
            var pf = this.packForPointerBoundary(rep, v, vt, cap.span)
            if (let some(p) = pf) {
                packed = p
            } else {
                return none
            }
            var boxed2 = 0
            var bf = this.boxForStore(rep, packed, elemIr(cap.ty))
            if (let some(b) = bf) {
                boxed2 = b
            } else {
                return none
            }
            var idx = this.intConst(1 + i)
            this.externCallVoid("pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, idx, boxed2])
            i = i + 1
        }
        obj
    }

    /// Lower a lambda expression to a closure object whose slot 0 holds the
    /// address of its pre-registered hoisted body. A lambda inside a generic
    /// function body registers a per-instantiation copy under that enclosing
    /// function id (substituting the instantiation into the signature,
    /// captures, and return type). Mirrors `lambda_value` in emit.rs.
    fn lambdaValue(e: Expr) -> int? {
        var baseKey = lambdaKey(none, e.span)
        var hasInst = false
        if (let some(_) = this.currentFid) {
            hasInst = true
        }
        var instKeyStr = baseKey
        if (hasInst) {
            instKeyStr = lambdaKey(this.currentFid, e.span)
        }
        var fid: int? = none
        if (hasInst) {
            var f1 = this.lambdaFids.get(instKeyStr)
            if (let some(v) = f1) {
                fid = v
            }
        }
        if (let none = fid) {
            var f2 = this.lambdaFids.get(baseKey)
            if (let some(v) = f2) {
                fid = v
            }
        }
        if (let none = fid) {
            if (let some(cls) = this.genericOwner()) {
                this.bad(e.span, "a lambda inside the generic class/struct `" + cls + "` is not lowered yet")
                return none
            }
            var inst = 0
            var instOk = false
            if (let some(i) = this.currentFid) {
                if (len(this.currentSubst) == 0) {
                    instOk = instOk
                } else {
                    inst = i
                    instOk = true
                }
            }
            if (!instOk) {
                this.bad(e.span, "this lambda was not registered for lowering")
                return none
            }
            var caps0 = emptyCaptures()
            var cg = this.lambdaCaps.get(baseKey)
            if (let some(c) = cg) {
                caps0 = c
            }
            var owner: int? = none
            var og = this.lambdaOwners.get(spanKey(e.span))
            if (let some(o) = og) {
                owner = o
            }
            var sub = emptyStringTyMap()
            var sg = this.instantonSubst.get(inst)
            if (let some(s) = sg) {
                sub = s
            }
            var le2 = Expr(Span(0, 0), ExprKind.This)
            var lg = this.lambdaExprs.get(spanKey(e.span))
            if (let some(l) = lg) {
                le2 = l
            } else {
                this.bad(e.span, "this lambda was not registered for lowering")
                return none
            }
            var base: int? = none
            base = inst
            fid = this.registerLambdaAt(le2, caps0, owner, sub, base)
        }
        if (let none = fid) {
            this.bad(e.span, "this lambda was not registered for lowering")
            return none
        }
        var caps = emptyCaptures()
        var gotCaps = false
        if (hasInst) {
            var c1 = this.lambdaCaps.get(instKeyStr)
            if (let some(c) = c1) {
                caps = c
                gotCaps = true
            }
        }
        if (!gotCaps) {
            var c2 = this.lambdaCaps.get(baseKey)
            if (let some(c) = c2) {
                caps = c
            }
        }
        var fidV = 0
        if (let some(f) = fid) {
            fidV = f
        } else {
            this.bad(e.span, "this lambda was not registered for lowering")
            return none
        }
        this.closureObj(e, fidV, caps)
    }

    /// A top-level function referenced as a value: wrap its forwarder trampoline
    /// (not the function itself) in a zero-capture closure object, so the
    /// dynamic-call convention -- closure object first, then the real
    /// arguments -- applies to module functions exactly as to hoisted lambda
    /// bodies. Mirrors `fn_value_closure` in emit.rs.
    fn fnValueClosure(e: Expr, fid: int) -> int? {
        let _ = fid
        var tramp = 0
        var tg = this.fnTramp.get(spanKey(e.span))
        if (let some(t) = tg) {
            tramp = t
        } else {
            this.bad(e.span, "function value was not registered for dynamic dispatch")
            return none
        }
        return this.closureObj(e, tramp, emptyCaptures())
    }

    /// When a call argument is a *generic user function* given bare (no type
    /// arguments) and the expected parameter type is `fn`, infer the function's
    /// type arguments from that fn type and materialize the concrete
    /// instantiation as a value. `some(t)` means materialized; `none` lets the
    /// regular argument path handle it (a `funcs_by_name` member, or the clean
    /// "as a value is not lowered yet" diagnostic). Mirrors
    /// `generic_fn_arg_value` in emit.rs.
    fn genericFnArgValue(v: Expr, hint: Ty) -> int? {
        var name = ""
        var isIdent = false
        match (v.kind) {
            case ExprKind.Ident(n) -> {
                name = n
                isIdent = true
            }
            case _ -> {}
        }
        if (!isIdent) {
            return none
        }
        var info = this.userCallableFirst(name)
        if (let none = info) {
            return none
        }
        var inf = seedCallableInfo()
        if (let some(x) = info) {
            inf = x
        }
        if (len(inf.generics) == 0) {
            return none
        }
        var pty = emptyTys()
        for (p in inf.params) {
            pty.push(p.ty)
        }
        var sig = Ty.Fn(pty, inf.ret)
        var map = emptyStringTyMap()
        inferFrom(sig, hint, map)
        var argTys = emptyTys()
        for (g in inf.generics) {
            var got = Ty.Unknown
            if (let some(t) = map.get(g)) {
                got = t
            }
            argTys.push(got)
        }
        var hasBadArg = false
        for (at in argTys) {
            var badKind = false
            match (at) {
                case Ty.Unknown -> badKind = true
                case Ty.Var(_) -> badKind = true
                case _ -> {}
            }
            if (hasVar(at) || badKind) {
                hasBadArg = true
            }
        }
        if (hasBadArg) {
            return none
        }
        this.genericFnValueFor(v, inf, argTys)
    }

    /// An instance method bound to a receiver, used as a value: a one-capture
    /// closure object whose slot 0 is the method trampoline and whose slot 1 is
    /// the receiver object, so `fn_value_call` dispatches through it exactly
    /// like a lambda capture. Mirrors `bound_method_value` in emit.rs.
    fn boundMethodValue(e: Expr, object: Expr) -> int? {
        var tramp = 0
        var tg = this.fnTramp.get(spanKey(e.span))
        if (let some(t) = tg) {
            tramp = t
        } else {
            this.bad(e.span, "bound method was not registered for dynamic dispatch")
            return none
        }
        var cid = 0
        if (let some(c) = this.registerClosureClass(1, e.span)) {
            cid = c
        } else {
            return none
        }
        var cidT = this.intConst(cid)
        var nT = this.intConst(2)
        var obj = this.externCallT1("pickle_class_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [cidT, nT])
        var addr = this.temp()
        this.instr(IrInstr.Const(addr, IrConst.FuncAddr(tramp)))
        var boxed = this.externCallT1("pickle_box_i64", [IrTy.Int], IrTy.Ptr, [addr])
        var zero = this.intConst(0)
        this.externCallVoid("pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, zero, boxed])
        var recv = 0
        if (let some(r) = this.expr(object)) {
            recv = r
        } else {
            return none
        }
        var recvTy = Ty.Unknown
        if (let some(t) = this.tyOf(object.span)) {
            recvTy = t
        }
        var packed = 0
        var pf = this.packForPointerBoundary(ElemRep.ptr(), recv, recvTy, e.span)
        if (let some(p) = pf) {
            packed = p
        } else {
            return none
        }
        var one = this.intConst(1)
        this.externCallVoid("pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, one, packed])
        obj
    }

    // ---- literals: tuple / array / map ----

    /// `(a, b, c)` tuple literal: allocate a tuple and set each field, boxing
    /// scalars. Mirrors `tuple_literal` in emit.rs.
    fn tupleLiteral(e: Expr, items: List<Expr>) -> int? {
        var tys = emptyTys()
        var isTuple = false
        if (let some(t) = this.tyOf(e.span)) {
            match (t) {
                case Ty.Tuple(parts) -> {
                    tys = parts
                    isTuple = true
                }
                case _ -> {}
            }
        }
        if (!isTuple) {
            this.bad(e.span, "tuple literal does not have a `Tuple` type")
            return none
        }
        if (len(items) == 0) {
            this.bad(e.span, "empty tuple values are not lowered yet")
            return none
        }
        if (len(tys) != len(items)) {
            this.bad(e.span, "tuple literal element/type count mismatch")
            return none
        }
        var nn = this.intConst(len(items))
        var tv = this.externCallT1("pickle_tuple_new", [IrTy.Int], IrTy.Ptr, [nn])
        var i = 0
        for (it in items) {
            var v = this.expr(it)
            if (let some(v) = v) {
                var rp = this.elemRep(tys[i], e.span)
                if (let some(rep) = rp) {
                    var storeV = v
                    if (!(rep.isPtr)) {
                        var vTy = this.irty(it.span)
                        if (let some(vTy) = vTy) {
                            storeV = this.externCallT1(rep.boxSym, [vTy], IrTy.Ptr, [v])
                        } else {
                            return none
                        }
                    }
                    var idx = this.intConst(i)
                    this.externCallVoid("pickle_tuple_set_field", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [tv, idx, storeV])
                } else {
                    return none
                }
            } else {
                return none
            }
            i = i + 1
        }
        tv
    }

    /// `[a, b, c]` array literal: build a `List` by pushing each element,
    /// boxing scalars. Mirrors `array_literal`.
    fn arrayLiteral(e: Expr, items: List<Expr>) -> int? {
        var elemTy = Ty.Unknown
        var isList = false
        if (let some(t) = this.tyOf(e.span)) {
            match (t) {
                case Ty.List(inner) -> {
                    elemTy = inner
                    isList = true
                }
                case _ -> {}
            }
        }
        if (!isList) {
            this.bad(e.span, "array literal does not have a `List` type")
            return none
        }
        if (len(items) == 0) {
            this.bad(e.span, "empty array literal cannot be typed; add an element to infer `List<T>`")
            return none
        }
        var rp = this.elemRep(elemTy, e.span)
        if (let some(rep) = rp) {
            var cap = this.intConst(len(items))
            var list = this.externCallT1("pickle_list_new", [IrTy.Int], IrTy.Ptr, [cap])
            for (it in items) {
                var v = this.expr(it)
                if (let some(v) = v) {
                    var pushV = v
                    if (!(rep.isPtr)) {
                        var vTy = this.irty(it.span)
                        if (let some(vTy) = vTy) {
                            pushV = this.externCallT1(rep.boxSym, [vTy], IrTy.Ptr, [v])
                        } else {
                            return none
                        }
                    }
                    this.externCallVoid("pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [list, pushV])
                } else {
                    return none
                }
            }
            return list
        }
        none
    }

    /// `{ "k": v, ... }` map literal: build a `Map` by inserting each entry,
    /// boxing scalar values and scalar keys. Mirrors `map_literal`.
    fn mapLiteral(e: Expr, entries: List<MapEntry>) -> int? {
        var kty = Ty.Unknown
        var vty = Ty.Unknown
        var isMap = false
        if (let some(t) = this.tyOf(e.span)) {
            match (t) {
                case Ty.Map(k, v) -> {
                    kty = k
                    vty = v
                    isMap = true
                }
                case _ -> {}
            }
        }
        if (!isMap) {
            this.bad(e.span, "map literal does not have a `Map` type")
            return none
        }
        var kp = this.keyRep(kty, e.span)
        var vp = this.elemRep(vty, e.span)
        if (let some(krep) = kp) {
            if (let some(vrep) = vp) {
                var cap = this.intConst(0)
                var mp = this.externCallT1("pickle_map_new", [IrTy.Int], IrTy.Ptr, [cap])
for (entry in entries) {
                    var k = this.expr(entry.key)
                    if (let some(k) = k) {
                        var kTy = kty
                        var kTyO = this.tyOf(entry.key.span)
                        if (let some(t) = kTyO) {
                            kTy = t
                        }
                        var keyO = this.packMapKey(krep, k, kTy, entry.key.span)
                        if (let some(key) = keyO) {
                            var vt = this.expr(entry.value)
                                if (let some(vt) = vt) {
                                    var boxed = vt
                                    if (!(vrep.isPtr)) {
                                        var vTy = this.irty(entry.value.span)
                                        if (let some(vTy) = vTy) {
                                            boxed = this.externCallT1(vrep.boxSym, [vTy], IrTy.Ptr, [vt])
                                        } else {
                                            return none
                                        }
                                    }
                                    this.externCallVoid("pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [mp, key, boxed])
} else {
                                    return none
                                }
                            } else {
                                return none
                            }
                    } else {
                        return none
                    }
                }
                return mp
            }
            return none
        }
        none
    }

/// Box a scalar so it can be stored in a List/Map, or pass a pointer type
    /// through untouched. Mirrors `box_for_store`.
    fn boxForStore(rep: ElemRep, v: int, vTy: IrTy) -> int? {
        if (rep.isPtr) {
            return v
        }
        this.externCallT1(rep.boxSym, [vTy], IrTy.Ptr, [v])
    }

    /// The `key` operand for a map op. Scalar keys are boxed; `Ptr` keys
    /// (option/tuple/composite/string) pass through as the managed pointer,
    /// except a raw scalar operand that must be lifted to its canonical
    /// `Option<T>` pointer form first (e.g. `m[5]` on a `Map<int?, V>`).
    /// Mirrors `pack_map_key` in emit.rs.
    fn packMapKey(rep: ElemRep, v: int, vt: Ty, span: Span) -> int? {
        if (rep.isPtr) {
            this.optionWrap(v, vt, span)
        } else {
            var vIrO = this.mapTy(vt, span)
            if (let none = vIrO) {
                return none
            }
            var vIr = IrTy.Int
            if (let some(t) = vIrO) {
                vIr = t
            }
            this.externCallT1(rep.boxSym, [vIr], IrTy.Ptr, [v])
        }
    }

    // ---- indexes ----

    /// `a[i]` reads: `Map<K, V>`, `&Map`, scalar `&T`/`T&` raw loads, `List<T>`
    /// and `&List`, and `String`. Mirrors `index_read`/`map_index_read`.
    fn indexRead(e: Expr, object: Expr, index: Expr) -> int? {
        if (let some(t) = this.tyOf(object.span)) {
            match (t) {
                case Ty.Map(k, v) -> {
                    return this.mapIndexRead(e, object, index, k, v)
                }
                case _ -> {}
            }
        }
        if (let some(t) = this.tyOf(object.span)) {
            match (t) {
                case Ty.Ref(iner) -> {
                    match (iner) {
                        case Ty.Map(k, v) -> {
                        return this.mapIndexRead(e, object, index, k, v)
                    }
                        case _ -> {}
                    }
                }
                case _ -> {}
            }
        }
        var elemTy = Ty.Unknown
        var didList = false
        var ot = this.tyOf(object.span)
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Ptr(iner) -> {
                    if (let some(el) = scalarIr(iner)) {
                        var base = this.expr(object)
                        if (let some(base) = base) {
                            var idx = this.expr(index)
                            if (let some(idx) = idx) {
                                var addr = this.ptrElementAddr(base, idx, el, e.span)
                                if (let some(addr) = addr) {
                                    var dst = this.temp()
                                    this.instr(IrInstr.LoadRaw(dst, addr, el))
                                    return dst
                                }
                                return none
                            }
                            return none
                        }
                        return none
                    }
                }
                case Ty.Ref(iner) -> {
                    if (let some(el) = scalarIr(iner)) {
                        var base = this.expr(object)
                        if (let some(base) = base) {
                            var idx = this.expr(index)
                            if (let some(idx) = idx) {
                                var addr = this.ptrElementAddr(base, idx, el, e.span)
                                if (let some(addr) = addr) {
                                    var dst = this.temp()
                                    this.instr(IrInstr.LoadRaw(dst, addr, el))
                                    return dst
                                }
                                return none
                            }
                            return none
                        }
                        return none
                    }
                }
                case Ty.List(iner) -> {
                    elemTy = iner
                    didList = true
                }
                case Ty.String -> {
                    var obj = this.expr(object)
                    if (let some(obj) = obj) {
                        var idx = this.expr(index)
                        if (let some(idx) = idx) {
                            return this.externCallT1("pickle_str_get", [IrTy.Ptr, IrTy.Int], IrTy.Int, [obj, idx])
                        }
                        return none
                    }
                    return none
                }
                case _ -> {}
            }
        }
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Ref(iner) -> {
                    match (iner) {
                        case Ty.List(el) -> {
                            elemTy = el
                            didList = true
                        }
                        case Ty.String -> {
                            var obj = this.expr(object)
                            if (let some(obj) = obj) {
                                var idx = this.expr(index)
                                if (let some(idx) = idx) {
                                    return this.externCallT1("pickle_str_get", [IrTy.Ptr, IrTy.Int], IrTy.Int, [obj, idx])
                                }
                                return none
                            }
                            return none
                        }
                        case _ -> {}
                    }
                }
                case _ -> {}
            }
        }
        if (!didList) {
            this.bad(e.span, "indexing this type is not lowered yet")
            return none
        }
        var rp = this.elemRep(elemTy, e.span)
        if (let some(rep) = rp) {
            var obj = this.expr(object)
            if (let some(obj) = obj) {
                var idx = this.expr(index)
                if (let some(idx) = idx) {
                    var raw = this.externCallT1("pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idx])
                    if (rep.isPtr) {
                        return raw
                    }
                    return this.externCallT1(rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
                }
                return none
            }
            return none
        }
        none
    }

    /// `m[k]` read for a `Map<K, V>` / scalar-keyed map. Absent keys yield the
    /// value type's default via the runtime's boxed get. Mirrors
    /// `map_index_read`.
    fn mapIndexRead(e: Expr, object: Expr, index: Expr, kty: Ty, vty: Ty) -> int? {
        var kp = this.keyRep(kty, index.span)
        var vp = this.elemRep(vty, e.span)
        if (let some(krep) = kp) {
            if (let some(vrep) = vp) {
var obj = this.expr(object)
                if (let some(obj) = obj) {
                    var k = this.expr(index)
                    if (let some(k) = k) {
                        var kTy = kty
                        var kTyO = this.tyOf(index.span)
                        if (let some(t) = kTyO) {
                            kTy = t
                        }
                        var keyO = this.packMapKey(krep, k, kTy, index.span)
                        if (let some(key) = keyO) {
                                var defaultVal = 0
                                var haveDefault = false
                                if (!(vrep.isPtr)) {
                                    var zero = this.zeroScalar(vrep.ir, index.span)
                                    if (let some(zero) = zero) {
                                        defaultVal = this.externCallT1(vrep.boxSym, [vrep.ir], IrTy.Ptr, [zero])
                                        haveDefault = true
                                    } else {
                                        return none
                                    }
                                } else if (vty == Ty.String) {
                                    var sl = this.stringLiteral(emptyStrParts())
                                    if (let some(sl) = sl) {
                                        defaultVal = sl
                                        haveDefault = true
                                    } else {
                                        return none
                                    }
                                } else {
                                    var nul = this.nullTemp()
                                    if (let some(nul) = nul) {
                                        defaultVal = this.externCallT1("pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, nul])
                                        haveDefault = true
                                    } else {
                                        return none
                                    }
                                }
                                if (haveDefault) {
                                    var raw = this.externCallT1("pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, defaultVal])
                                    if (vrep.isPtr) {
                                        return raw
                                    }
                                    return this.externCallT1(vrep.unboxSym, [IrTy.Ptr], vrep.ir, [raw])
                                }
                                return none
                            }
                            return none
                        }
                        return none
                    }
                    return none
}
                return none
            }
            none
    }

    /// `base + idx * stride` ???????? the address of element `idx` of a raw pointer to
    /// a scalar `element`. Mirrors `ptr_element_addr`.
    fn ptrElementAddr(base: int, idx: int, elem: IrTy, span: Span) -> int? {
        var stride = -1
        if (irTyTag(elem) == irTyTag(IrTy.Bool)) {
            stride = 1
        } else if (irTyTag(elem) == irTyTag(IrTy.Char)) {
            stride = 4
        } else if (irTyTag(elem) == irTyTag(IrTy.Int)) {
            stride = 8
        } else if (irTyTag(elem) == irTyTag(IrTy.Float)) {
            stride = 8
        }
        if (stride < 0) {
            this.bad(span, "this pointee type is not indexed yet")
            return none
        }
        var s = this.intConst(stride)
        var off = this.temp()
        this.instr(IrInstr.BinOp(off, IrBinOp.Mul, idx, s))
        var addr = this.temp()
        this.instr(IrInstr.BinOp(addr, IrBinOp.Add, base, off))
        addr
    }

    // ---- static fields / class consts ----

    /// Read a static field cell: box scalars are unboxed after
    /// `pickle_static_get(cid, slot, v)`. Mirrors `static_read`.
    fn staticRead(span: Span, cid: int, slot: int, fieldTy: Ty) -> int? {
        var rp = this.elemRep(fieldTy, span)
        if (let some(rep) = rp) {
            var c = this.intConst(cid)
            var s = this.intConst(slot)
            var raw = this.externCallT1("pickle_static_get", [IrTy.Int, IrTy.Int], IrTy.Ptr, [c, s])
            if (rep.isPtr) {
                return raw
            }
            return this.externCallT1(rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
        }
        none
    }

    /// Static-field store: box scalars, then `pickle_static_set(cid, slot, v)`.
    fn staticStore(cid: int, slot: int, boxed: int) {
        var c = this.intConst(cid)
        var s = this.intConst(slot)
        this.externCallVoid("pickle_static_set", [IrTy.Int, IrTy.Int, IrTy.Ptr], [c, s, boxed])
    }

    /// Inline a class constant's initializer at a use site. Returns `none`
    /// when `name` is not a constant of class `cid` (or an ancestor). Mirrors
    /// `read_class_const`.
    fn readClassConst(span: Span, cid: int, name: string) -> int? {
        var plan: ClassPlan? = none
        for (p in this.classes) {
            if (p.classId == cid) {
                plan = p
                break
            }
        }
        if (let none = plan) {
            return none
        }
        var pname = ""
        if (let some(p) = plan) {
            pname = p.name
        }
        var chain = this.ancestry(pname)
        var ci = len(chain)
        while (ci >= 1) {
            ci = ci - 1
            var cn = chain[ci]
            var dcO = this.classByName.get(cn)
            if (let some(dc) = dcO) {
                var k = pairKey(str(dc), name)
                if (this.classConsts.has(k)) {
                    var key = this.classOfName(dc) + "." + name
                    if (strListHas(this.constInlining, key)) {
                        this.bad(span, "cyclic `const` initialization of `" + key + "`")
                        return none
                    }
                    this.constInlining.push(key)
                    var savedOwner = this.owner
                    this.owner = dc
                    var ccO = this.classConsts.get(k)
                    if (let some(cc) = ccO) {
                        var tv = this.expr(cc.init)
                        this.owner = savedOwner
                        this.constInlining.pop()
                        return tv
                    }
                    this.owner = savedOwner
                    this.constInlining.pop()
                    return none
                }
            }
        }
        none
    }

    /// Parent-first run of `cname`'s instance fields including inherited ones.
    /// Mirrors `all_instance_fields`.
    fn allInstanceFields(cname: string) -> List<FieldInfo> {
        var out = emptyFieldInfos()
        for (cn in this.ancestry(cname)) {
            var own = this.ownInstanceFields(cn)
            for (f in own) {
                out.push(f)
            }
        }
        out
    }

    /// The `FieldInfo` for instance field slot `idx` of class `cid` (parent-
    /// first layout).
    fn fieldAt(cid: int, idx: int) -> FieldInfo {
        for (p in this.classes) {
            if (p.classId == cid) {
                var all = this.allInstanceFields(p.name)
                if (idx < len(all)) {
                    return all[idx]
                }
                return seedFieldInfo()
            }
        }
        seedFieldInfo()
    }

    /// The display name of a registered class id.
    fn classOfName(cid: int) -> string {
        for (p in this.classes) {
            if (p.classId == cid) {
                return p.name
            }
        }
        "class#" + str(cid)
    }

    // ---- statements ----

    /// Lower one statement into the current block. `true` on success; hard
    /// errors set `this.failed` through `bad` and return `false`.
fn stmt(s: Stmt) -> bool {
        if (this.iceDepth > 150) {
            return false
        }
        this.iceDepth = this.iceDepth + 1
        this.icePath.push("stmt")
        var r = this.stmt1(s)
        this.iceDepth = this.iceDepth - 1
        r
    }

fn stmt1(s: Stmt) -> bool {
        if (!this.icePoke("stmt1")) {
            return false
        }
        match (s) {
            case Stmt.Let(pattern, ty, init, _mutable, attrs, span) -> {
                var manual = false
                for (a in attrs) {
                    if (a.name == "manualAlloc") {
                        manual = true
                    }
                }
                match (pattern) {
                    case Pattern.Binding(nm, patTy) -> {
                        var annot = ty
                        if (let some(pt) = patTy) {
                            annot = pt
                        }
                        var annOption = false
                        if (let some(at) = annot) {
                            match (at.kind) {
                                case TypeExprKind.Option(_) -> annOption = true
                                case _ -> {}
                            }
                        }
                        var slotTy = IrTy.Ptr
                        if (annOption) {
                            slotTy = IrTy.Ptr
                        } else {
                            if (let some(i) = init) {
                                if (let some(it) = this.irty(i.span)) {
                                    slotTy = it
                                } else {
                                    return false
                                }
                            } else {
                                if (let none = this.annotTy(annot, span)) {
                                    return false
                                }
                                if (let some(at2) = this.annotTy(annot, span)) {
                                    slotTy = at2
                                }
                            }
                        }
                        var slot = this.newSlot(slotTy)
                        if (let some(e) = init) {
                            var t = -1
                            if (let some(tv) = this.expr(e)) {
                                t = tv
                            } else {
                                return false
                            }
                            var v = t
                            if (irTyTag(slotTy) == irTyTag(IrTy.Ptr)) {
                                var vt = Ty.Unknown
                                if (let some(gt) = this.tyOf(e.span)) {
                                    vt = gt
                                }
                                if (let some(w) = this.optionWrap(v, vt, e.span)) {
                                    v = w
                                } else {
                                    return false
                                }
                            }
                            if (manual) {
                                v = this.externCallT1("pickle_manual_adopt", [IrTy.Ptr], IrTy.Ptr, [v])
                            }
                            this.instr(IrInstr.StoreSlot(slot, v))
                        }
                        this.declare(nm, slot)
                        if (manual) {
                            this.declareManual(nm)
                        }
                        true
                    }
                    case Pattern.Wildcard -> {
                        if (let some(e) = init) {
                            if (let none = this.expr(e)) {
                                return false
                            }
                        }
                        true
                    }
case Pattern.Tuple(_) -> {
                        if (let none = init) {
                            this.bad(span, "destructuring patterns require an initializer")
                            return false
                        }
                        var st = Ty.Unknown
                        if (let some(it) = init) {
                            if (let some(gt) = this.tyOf(it.span)) {
                                st = gt
                            }
                        }
                        if (let some(e) = init) {
                            var v = -1
                            if (let some(t) = this.expr(e)) {
                                v = t
                            } else {
                                return false
                            }
                            if (!(this.bindMatchValue(pattern, st, v, e.span))) {
                                return false
                            }
                        }
                        true
                    }
                    case _ -> {
                        this.bad(span, "destructuring patterns are not lowered yet")
                        false
                    }
                }
            }
            case Stmt.Const(name, _ty, value, _span) -> {
                var t = -1
                if (let some(tv) = this.expr(value)) {
                    t = tv
                } else {
                    return false
                }
                var ty2 = IrTy.Ptr
                if (let some(it) = this.irty(value.span)) {
                    ty2 = it
                } else {
                    return false
                }
                var slot = this.newSlot(ty2)
                var v = t
                if (irTyTag(ty2) == irTyTag(IrTy.Ptr)) {
                    var vt = Ty.Unknown
                    if (let some(gt) = this.tyOf(value.span)) {
                        vt = gt
                    }
                    if (let some(w) = this.optionWrap(v, vt, value.span)) {
                        v = w
                    } else {
                        return false
                    }
                }
                this.instr(IrInstr.StoreSlot(slot, v))
                this.declare(name, slot)
                true
            }
            case Stmt.Return(value, _span) -> {
                var v: int? = none
                if (let some(e) = value) {
                    var t = -1
                    if (let some(tv) = this.expr(e)) {
                        t = tv
                    } else {
                        return false
                    }
                    if (irTyTag(this.fret) == irTyTag(IrTy.Ptr)) {
                        var vt = Ty.Unknown
                        if (let some(gt) = this.tyOf(e.span)) {
                            vt = gt
                        }
                        if (let some(w) = this.optionWrap(t, vt, e.span)) {
                            v = w
                        } else {
                            return false
                        }
                    } else {
                        v = t
                    }
                }
                this.exitThroughFinallys(Exit.Return(v))
                true
            }
            case Stmt.Break(_span) -> {
                if (let none = this.loopBreakTarget()) {
                    this.badSpanNote("unbalanced `break`")
                    return false
                }
                var target = -1
                if (let some(t) = this.loopBreakTarget()) {
                    target = t
                }
                this.exitThroughFinallys(Exit.Branch(target))
                true
            }
            case Stmt.Continue(_span) -> {
                if (let none = this.loopContinueTarget()) {
                    this.badSpanNote("unbalanced `continue`")
                    return false
                }
                var target = -1
                if (let some(t) = this.loopContinueTarget()) {
                    target = t
                }
                this.exitThroughFinallys(Exit.Branch(target))
                true
            }
            case Stmt.While(cond, body, span) -> this.whileStmt(cond, body, span)
            case Stmt.For(header, body, span) -> this.forStmt(header, body, span)
            case Stmt.Try(body, binder, handler, fin, span) -> this.tryStmt(body, binder, handler, fin, span, none)
            case Stmt.Throw(value, span) -> this.throwStmt(value, span)
            case Stmt.Expr(e) -> {
                if (let none = this.expr(e)) {
                    return false
                }
                true
            }
            case Stmt.Empty(_span) -> true
        }
    }

    /// `while (cond)` lowering: the `cond` block branches into the body, which
    /// back-edges to `cond`.
    fn whileStmt(cond: Expr, body: Block, span: Span) -> bool {
        let _ = span
        var condId = this.newBlock()
        var bodyId = this.newBlock()
        var endId = this.newBlock()
        this.term(IrTerm.Branch(condId))
        this.cur = condId
        var c = -1
        if (let some(cv) = this.expr(cond)) {
            c = cv
        } else {
            return false
        }
        this.term(IrTerm.BranchIf(c, bodyId, endId))
        this.cur = bodyId
        this.pushLoop(endId, condId)
        this.pushScope()
        if (!(this.blockBodyOnly(body))) {
            this.popScope()
            this.loops.pop()
            return false
        }
        this.popScope()
        this.loops.pop()
        this.term(IrTerm.Branch(condId))
        this.cur = endId
        true
    }

    /// `for` loops: header initialization, a condition block, a body, and a
    /// step block (`continue` targets the step so it still runs).
    fn forStmt(header: ForHeader, body: Block, span: Span) -> bool {
        match (header) {
            case ForHeader.Range(init, cond, step) -> {
                if (!(this.stmt(init))) {
                    return false
                }
                var condId = this.newBlock()
                var bodyId = this.newBlock()
                var stepId = this.newBlock()
                var endId = this.newBlock()
                this.term(IrTerm.Branch(condId))
                this.cur = condId
                var c = -1
                if (let some(cv) = this.expr(cond)) {
                    c = cv
                } else {
                    return false
                }
                this.term(IrTerm.BranchIf(c, bodyId, endId))
                this.cur = bodyId
                this.pushLoop(endId, stepId)
                this.pushScope()
                if (!(this.blockBodyOnly(body))) {
                    this.popScope()
                    this.loops.pop()
                    return false
                }
                this.popScope()
                this.loops.pop()
                this.term(IrTerm.Branch(stepId))
                this.cur = stepId
                if (let none = this.expr(step)) {
                    return false
                }
                this.term(IrTerm.Branch(condId))
                this.cur = endId
                true
            }
case ForHeader.In(pattern, seq) -> this.forIn(pattern, seq, body, span)
        }
    }

    /// `for (x in seq)` / `for ((k, v) in m)`: dispatch on the sequence type,
    /// mirroring `for_in` in emit.rs. A `List` iterates by index; a `String`
    /// iterates bytes; a `Map` with a `(k, v)` binding iterates map entries
    /// (in lockstep key/value snapshots) and otherwise iterates its values; an
    /// `Iterable<T>` falls back to the protocol loop; integer ranges lower to
    /// an index loop with an inclusive/exclusive bound.
    fn forIn(pattern: Pattern, sequence: Expr, body: Block, span: Span) -> bool {
        var seqOt = this.forInSeqTy(sequence.span)
        if (let some(ot) = seqOt) {
            match (ot) {
                case Ty.Map(k, v) -> {
                    match (pattern) {
                        case Pattern.Tuple(parts) -> {
                            if (!(len(parts) == 2)) {
                                return this.bad(span, "map entries pattern must bind exactly two names `(k, v)`")
                            }
                            var kname = ""
                            match (parts[0]) {
                                case Pattern.Binding(nm, _) -> kname = nm
                                case _ -> {
                                    return this.bad(span, "map entries sub-patterns must be plain names")
                                }
                            }
                            var vname = ""
                            match (parts[1]) {
                                case Pattern.Binding(nm, _) -> vname = nm
                                case _ -> {
                                    return this.bad(span, "map entries sub-patterns must be plain names")
                                }
                            }
                            var mapT = -1
                            if (let some(mt) = this.expr(sequence)) {
                                mapT = mt
                            } else {
                                return false
                            }
                            return this.forInMapEntries(kname, vname, mapT, k, v, body, span)
                        }
                        case _ -> {}
                    }
                }
                case _ -> {}
            }
        }
        var seqOt2 = this.forInSeqTy(sequence.span)
        if (let some(ot) = seqOt2) {
            match (ot) {
                case Ty.String -> {
                    var nm = ""
                    match (pattern) {
                        case Pattern.Binding(nm2, _) -> nm = nm2
                        case _ -> {
                            return this.bad(span, "iteration patterns other than a binding are not lowered yet")
                        }
                    }
                    var seqT = -1
                    if (let some(st) = this.expr(sequence)) {
                        seqT = st
                    } else {
                        return false
                    }
                    return this.forInString(nm, seqT, body)
                }
                case Ty.List(inner) -> {
                    var elemT = inner
                    var seqT = -1
                    if (let some(st) = this.expr(sequence)) {
                        seqT = st
                    } else {
                        return false
                    }
                    return this.forInValues(pattern, seqT, elemT, body, span)
                }
                case Ty.Range(inner) -> {
                    var elemT = inner
                    var seqT = -1
                    if (let some(st) = this.expr(sequence)) {
                        seqT = st
                    } else {
                        return false
                    }
                    return this.forInValues(pattern, seqT, elemT, body, span)
                }
                case Ty.Map(_, v) -> {
                    var isBind = false
                    match (pattern) {
                        case Pattern.Binding(_, _) -> isBind = true
                        case _ -> {}
                    }
                    if (!isBind) {
                        return this.bad(span, "iteration patterns other than a binding are not lowered yet")
                    }
                    var mapT = -1
                    if (let some(mt) = this.expr(sequence)) {
                        mapT = mt
                    } else {
                        return false
                    }
                    var vals = this.externCallT1("pickle_map_values", [IrTy.Ptr], IrTy.Ptr, [mapT])
                    return this.forInValues(pattern, vals, v, body, span)
                }
                case _ -> {}
            }
        }
        var iterElemTy = Ty.Unknown
        if (let some(ot) = seqOt2) {
            iterElemTy = ot
        }
        if (let some(el) = this.iterableElem(iterElemTy)) {
            var seqT = -1
            if (let some(st) = this.expr(sequence)) {
                seqT = st
            } else {
                return false
            }
            return this.forInProtocol(pattern, el, seqT, body, span)
        }
        var start: Expr? = none
        var end: Expr? = none
        var incl = false
        var isRange = false
        match (sequence.kind) {
            case ExprKind.Binary(op, lhs, rhs) -> {
                if (op == BinOp.Range) {
                    start = lhs
                    end = rhs
                    isRange = true
                }
                if (op == BinOp.RangeIncl) {
                    start = lhs
                    end = rhs
                    incl = true
                    isRange = true
                }
            }
            case _ -> {}
        }
        if (!isRange) {
            return this.bad(sequence.span, "`for (x in ...)` over non-range, non-list sequences is not lowered yet")
        }
        if (let none = start) {
            return this.bad(sequence.span, "`for (x in ...)` over non-range, non-list sequences is not lowered yet")
        }
        if (let none = end) {
            return this.bad(sequence.span, "`for (x in ...)` over non-range, non-list sequences is not lowered yet")
        }
        var startE: Expr? = start
        var endE: Expr? = end
        if (let some(s) = startE) {
            if (!(this.ensureInt(s))) {
                return false
            }
        }
        if (let some(e) = endE) {
            if (!(this.ensureInt(e))) {
                return false
            }
        }
        var startT = -1
        var endT = -1
        if (let some(s) = startE) {
            if (let some(st) = this.expr(s)) {
                startT = st
            } else {
                return false
            }
        }
        if (let some(e) = endE) {
            if (let some(et) = this.expr(e)) {
                endT = et
            } else {
                return false
            }
        }
        var idx = this.newSlot(IrTy.Int)
        var endSlot = this.newSlot(IrTy.Int)
        this.instr(IrInstr.StoreSlot(idx, startT))
        this.instr(IrInstr.StoreSlot(endSlot, endT))

        var condId = this.newBlock()
        var bodyId = this.newBlock()
        var nextId = this.newBlock()
        var endId = this.newBlock()
        this.term(IrTerm.Branch(condId))
        this.cur = condId
        var curT = this.load(idx)
        var endL = this.load(endSlot)
        var cmpOp = IrBinOp.Lt
        if (incl) {
            cmpOp = IrBinOp.Le
        }
        var cmp = this.temp()
        this.instr(IrInstr.BinOp(cmp, cmpOp, curT, endL))
        this.term(IrTerm.BranchIf(cmp, bodyId, endId))
        this.cur = bodyId
        this.pushLoop(endId, nextId)
        this.pushScope()
        var nm2 = ""
        match (pattern) {
            case Pattern.Binding(nm3, _) -> nm2 = nm3
            case _ -> {
                return this.bad(span, "iteration patterns other than a binding are not lowered yet")
            }
        }
        this.declare(nm2, idx)
        if (!(this.blockBodyOnly(body))) {
            this.popScope()
            this.loops.pop()
            return false
        }
        this.popScope()
        this.loops.pop()
        this.term(IrTerm.Branch(nextId))
        this.cur = nextId
        var c = this.load(idx)
        var one = this.temp()
        this.instr(IrInstr.Const(one, IrConst.Int(1)))
        var nxt = this.temp()
        this.instr(IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        this.instr(IrInstr.StoreSlot(idx, nxt))
        this.term(IrTerm.Branch(condId))
        this.cur = endId
        true
    }

    /// `ty_of(span)`, unwrapping a `&T` reference so a `for` over a reference
    /// iterates the referenced sequence. Mirrors the `Ty::Ref` unwrap at the
    /// top of `for_in` in emit.rs.
    fn forInSeqTy(span: Span) -> Ty? {
        if (let some(t) = this.tyOf(span)) {
            match (t) {
                case Ty.Ref(inner) -> inner
                case other -> other
            }
        } else {
            none
        }
    }

    /// `for (x in seq)` over a sequence value: by-index iteration over a
    /// managed list pointer, unboxing scalar elements per trip as
    /// `for_in_values` does.
    fn forInValues(pattern: Pattern, seqT: int, elem: Ty, body: Block, span: Span) -> bool {
        var rp = this.elemRep(elem, span)
        if (let none = rp) {
            return false
        }
        var rep = ElemRep.ptr()
        if (let some(r) = rp) {
            rep = r
        }
        var elemIrTy = elemIr(elem)
        var seqSlot = this.newSlot(IrTy.Ptr)
        var idxSlot = this.newSlot(IrTy.Int)
        var lenSlot = this.newSlot(IrTy.Int)
        this.instr(IrInstr.StoreSlot(seqSlot, seqT))
        var zero = this.temp()
        this.instr(IrInstr.Const(zero, IrConst.Int(0)))
        this.instr(IrInstr.StoreSlot(idxSlot, zero))
        var seqL = this.load(seqSlot)
        var lenT = this.externCallT1("pickle_list_len", [IrTy.Ptr], IrTy.Int, [seqL])
        this.instr(IrInstr.StoreSlot(lenSlot, lenT))

        var condId = this.newBlock()
        var bodyId = this.newBlock()
        var nextId = this.newBlock()
        var endId = this.newBlock()
        this.term(IrTerm.Branch(condId))
        this.cur = condId
        var curT = this.load(idxSlot)
        var endL = this.load(lenSlot)
        var cmp = this.temp()
        this.instr(IrInstr.BinOp(cmp, IrBinOp.Lt, curT, endL))
        this.term(IrTerm.BranchIf(cmp, bodyId, endId))
        this.cur = bodyId
        this.pushLoop(endId, nextId)
        this.pushScope()
        var curI = this.load(idxSlot)
        var seqL2 = this.load(seqSlot)
        var raw = this.externCallT1("pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [seqL2, curI])
        var v = raw
        if (!(rep.isPtr)) {
            v = this.externCallT1(rep.unboxSym, [IrTy.Ptr], elemIrTy, [raw])
        }
        var elemSlot = this.newSlot(elemIrTy)
        this.instr(IrInstr.StoreSlot(elemSlot, v))
        match (pattern) {
            case Pattern.Binding(nm, _) -> this.declare(nm, elemSlot)
            case Pattern.Tuple(_) -> {
                var ev = this.load(elemSlot)
                if (!(this.bindMatchValue(pattern, elem, ev, span))) {
                    this.popScope()
                    this.loops.pop()
                    return false
                }
            }
            case _ -> {
                this.popScope()
                this.loops.pop()
                return this.bad(span, "iteration patterns other than a binding or tuple are not lowered yet")
            }
        }
        if (!(this.blockBodyOnly(body))) {
            this.popScope()
            this.loops.pop()
            return false
        }
        this.popScope()
        this.loops.pop()
        this.term(IrTerm.Branch(nextId))
        this.cur = nextId
        var c = this.load(idxSlot)
        var one = this.temp()
        this.instr(IrInstr.Const(one, IrConst.Int(1)))
        var nxt = this.temp()
        this.instr(IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        this.instr(IrInstr.StoreSlot(idxSlot, nxt))
        this.term(IrTerm.Branch(condId))
        this.cur = endId
        true
    }

    /// `for ((k, v) in m)`: bind key and value per trip from lockstep
    /// `pickle_map_keys` / `pickle_map_values` snapshots, unboxing keys and
    /// values per their `ElemRep`. Mirrors `for_in_map_entries` in emit.rs.
    fn forInMapEntries(kname: string, vname: string, mapT: int, kty: Ty, vty: Ty, body: Block, span: Span) -> bool {
        var vrpo = this.elemRep(vty, span)
        if (let none = vrpo) {
            return false
        }
        var vrep = ElemRep.ptr()
        if (let some(r) = vrpo) {
            vrep = r
        }
        var vIr = elemIr(vty)
        var krpo = this.keyRep(kty, span)
        if (let none = krpo) {
            return false
        }
        var krep = ElemRep.ptr()
        if (let some(r) = krpo) {
            krep = r
        }
        var kIr = krep.ir
        if (krep.isPtr) {
            kIr = IrTy.Ptr
        }
        var mapSlot = this.newSlot(IrTy.Ptr)
        var keysSlot = this.newSlot(IrTy.Ptr)
        var valsSlot = this.newSlot(IrTy.Ptr)
        var idxSlot = this.newSlot(IrTy.Int)
        var lenSlot = this.newSlot(IrTy.Int)
        this.instr(IrInstr.StoreSlot(mapSlot, mapT))
        var mapL = this.load(mapSlot)
        var keysT = this.externCallT1("pickle_map_keys", [IrTy.Ptr], IrTy.Ptr, [mapL])
        var valsT = this.externCallT1("pickle_map_values", [IrTy.Ptr], IrTy.Ptr, [mapL])
        this.instr(IrInstr.StoreSlot(keysSlot, keysT))
        this.instr(IrInstr.StoreSlot(valsSlot, valsT))
        var zero = this.temp()
        this.instr(IrInstr.Const(zero, IrConst.Int(0)))
        this.instr(IrInstr.StoreSlot(idxSlot, zero))
        var keysL = this.load(keysSlot)
        var lenT = this.externCallT1("pickle_list_len", [IrTy.Ptr], IrTy.Int, [keysL])
        this.instr(IrInstr.StoreSlot(lenSlot, lenT))

        var condId = this.newBlock()
        var bodyId = this.newBlock()
        var nextId = this.newBlock()
        var endId = this.newBlock()
        this.term(IrTerm.Branch(condId))
        this.cur = condId
        var curT = this.load(idxSlot)
        var endL = this.load(lenSlot)
        var cmp = this.temp()
        this.instr(IrInstr.BinOp(cmp, IrBinOp.Lt, curT, endL))
        this.term(IrTerm.BranchIf(cmp, bodyId, endId))
        this.cur = bodyId
        this.pushLoop(endId, nextId)
        this.pushScope()
        var i = this.load(idxSlot)
        var keysL2 = this.load(keysSlot)
        var valsL2 = this.load(valsSlot)
        var kraw = this.externCallT1("pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [keysL2, i])
        var k = kraw
        if (!(krep.isPtr)) {
            k = this.externCallT1(krep.unboxSym, [IrTy.Ptr], kIr, [kraw])
        }
        var kSlot = this.newSlot(kIr)
        this.instr(IrInstr.StoreSlot(kSlot, k))
        this.declare(kname, kSlot)
        var vraw = this.externCallT1("pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [valsL2, i])
        var v = vraw
        if (!(vrep.isPtr)) {
            v = this.externCallT1(vrep.unboxSym, [IrTy.Ptr], vIr, [vraw])
        }
        var vSlot = this.newSlot(vIr)
        this.instr(IrInstr.StoreSlot(vSlot, v))
        this.declare(vname, vSlot)
        if (!(this.blockBodyOnly(body))) {
            this.popScope()
            this.loops.pop()
            return false
        }
        this.popScope()
        this.loops.pop()
        this.term(IrTerm.Branch(nextId))
        this.cur = nextId
        var c = this.load(idxSlot)
        var one = this.temp()
        this.instr(IrInstr.Const(one, IrConst.Int(1)))
        var nxt = this.temp()
        this.instr(IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        this.instr(IrInstr.StoreSlot(idxSlot, nxt))
        this.term(IrTerm.Branch(condId))
        this.cur = endId
        true
    }

    /// `for (x in s)` over a string: iterates byte indices, binding the raw
    /// 0..=255 byte from `pickle_str_get` as a `byte` (`int` ABI). Mirrors
    /// `for_in_string` in emit.rs.
    fn forInString(name: string, seqT: int, body: Block) -> bool {
        var seqSlot = this.newSlot(IrTy.Ptr)
        var idxSlot = this.newSlot(IrTy.Int)
        var lenSlot = this.newSlot(IrTy.Int)
        this.instr(IrInstr.StoreSlot(seqSlot, seqT))
        var zero = this.temp()
        this.instr(IrInstr.Const(zero, IrConst.Int(0)))
        this.instr(IrInstr.StoreSlot(idxSlot, zero))
        var seqL = this.load(seqSlot)
        var lenT = this.externCallT1("pickle_str_len", [IrTy.Ptr], IrTy.Int, [seqL])
        this.instr(IrInstr.StoreSlot(lenSlot, lenT))

        var condId = this.newBlock()
        var bodyId = this.newBlock()
        var nextId = this.newBlock()
        var endId = this.newBlock()
        this.term(IrTerm.Branch(condId))
        this.cur = condId
        var curT = this.load(idxSlot)
        var endL = this.load(lenSlot)
        var cmp = this.temp()
        this.instr(IrInstr.BinOp(cmp, IrBinOp.Lt, curT, endL))
        this.term(IrTerm.BranchIf(cmp, bodyId, endId))
        this.cur = bodyId
        this.pushLoop(endId, nextId)
        this.pushScope()
        var curI = this.load(idxSlot)
        var seqL2 = this.load(seqSlot)
        var v = this.externCallT1("pickle_str_get", [IrTy.Ptr, IrTy.Int], IrTy.Int, [seqL2, curI])
        var elemSlot = this.newSlot(IrTy.Int)
        this.instr(IrInstr.StoreSlot(elemSlot, v))
        this.declare(name, elemSlot)
        if (!(this.blockBodyOnly(body))) {
            this.popScope()
            this.loops.pop()
            return false
        }
        this.popScope()
        this.loops.pop()
        this.term(IrTerm.Branch(nextId))
        this.cur = nextId
        var c = this.load(idxSlot)
        var one = this.temp()
        this.instr(IrInstr.Const(one, IrConst.Int(1)))
        var nxt = this.temp()
        this.instr(IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        this.instr(IrInstr.StoreSlot(idxSlot, nxt))
        this.term(IrTerm.Branch(condId))
        this.cur = endId
        true
    }

    /// `for (x in seq)` over an `Iterable<T>` protocol value: `iterator()` then
    /// `next()`, with `continue` re-testing the option and `break`/completion
    /// leaving the loop. Mirrors `for_in_protocol` in emit.rs.
    fn forInProtocol(pattern: Pattern, elem: Ty, seqT: int, body: Block, span: Span) -> bool {
        if (let none = this.elemRep(elem, span)) {
            return false
        }
        var iterableIft = Ty.Interface("Iterable", [elem])
        var itvO = this.interfaceZeroArgCall(span, iterableIft, seqT, "iterator", IrTy.Ptr)
        if (let none = itvO) {
            return false
        }
        var itv = -1
        if (let some(v) = itvO) {
            itv = v
        }
        var itSlot = this.newSlot(IrTy.Ptr)
        this.instr(IrInstr.StoreSlot(itSlot, itv))

        var iteratorIft = Ty.Interface("Iterator", [elem])
        var elemIrTy = elemIr(elem)
        var optSlot = this.newSlot(IrTy.Ptr)

        var condId = this.newBlock()
        var bodyId = this.newBlock()
        var endId = this.newBlock()
        this.term(IrTerm.Branch(condId))
        this.cur = condId
        var it = this.load(itSlot)
        var nextVO = this.interfaceZeroArgCall(span, iteratorIft, it, "next", IrTy.Ptr)
        if (let none = nextVO) {
            return false
        }
        var nextV = -1
        if (let some(v) = nextVO) {
            nextV = v
        }
        this.instr(IrInstr.StoreSlot(optSlot, nextV))
        var opt = this.load(optSlot)
        var presentO = this.optIsPresent(opt)
        if (let none = presentO) {
            return false
        }
        var present = -1
        if (let some(p) = presentO) {
            present = p
        }
        this.term(IrTerm.BranchIf(present, bodyId, endId))

        this.cur = bodyId
        this.pushLoop(endId, condId)
        this.pushScope()
        var raw = this.load(optSlot)
        var vO = this.optResolve(raw, elem, span)
        if (let none = vO) {
            this.popScope()
            this.loops.pop()
            return false
        }
        var v = -1
        if (let some(x) = vO) {
            v = x
        }
        var elemSlot = this.newSlot(elemIrTy)
        this.instr(IrInstr.StoreSlot(elemSlot, v))
        match (pattern) {
            case Pattern.Binding(nm, _) -> this.declare(nm, elemSlot)
            case Pattern.Tuple(_) -> {
                var ev = this.load(elemSlot)
                if (!(this.bindMatchValue(pattern, elem, ev, span))) {
                    this.popScope()
                    this.loops.pop()
                    return false
                }
            }
            case _ -> {
                this.popScope()
                this.loops.pop()
                return this.bad(span, "iteration patterns other than a binding or tuple are not lowered yet")
            }
        }
        if (!(this.blockBodyOnly(body))) {
            this.popScope()
            this.loops.pop()
            return false
        }
        this.popScope()
        this.loops.pop()
        this.term(IrTerm.Branch(condId))
        this.cur = endId
        true
    }

    /// Emit a block's statements only (loop bodies, where the tail is
    /// discarded).
    fn blockBodyOnly(b: Block) -> bool {
        for (s in b.stmts) {
            if (!(this.stmt(s))) {
                return false
            }
        }
        if (let some(e) = b.expr) {
            if (let none = this.expr(e)) {
                return false
            }
        }
        true
    }

    /// `block_value`: lower a block and produce its value (the tail expression
    /// or a unit temp).
    fn blockValue(b: Block) -> int? {
        for (s in b.stmts) {
            if (!(this.stmt(s))) {
                return none
            }
        }
        if (let some(e) = b.expr) {
            return this.expr(e)
        }
        this.unitTemp()
    }

    /// A `try` is a statement, but the last one in a block is also that block's
    /// value, so it needs a slot to hand the result back in.
    ///
    /// Peek before emitting: on a miss the caller still has to emit the whole
    /// sequence itself, and emitting it twice would duplicate effects. Returns
    /// the slot holding the `try`'s value, having emitted everything.
    fn stmtsWithTryTail(stmts: List<Stmt>, want: IrTy) -> int? {
        if (len(stmts) == 0) {
            return none
        }
        let last = stmts[len(stmts) - 1]
        // Peek before emitting: on a miss the caller still has to emit the whole
        // sequence itself, and emitting it twice would duplicate effects.
        var isTry = false
        match (last) {
            case Stmt.Try(_, _, _, _, _) -> isTry = true
            case _ -> {}
        }
        if (!isTry) {
            return none
        }
        for (i in range(0, len(stmts) - 1)) {
            if (!(this.stmt(stmts[i]))) {
                return none
            }
        }
        let slot = this.newSlot(want)
        var slotOpt: int? = none
        slotOpt = slot
        var ok = false
        match (last) {
            case Stmt.Try(body, binder, handler, fin, span) -> ok = this.tryStmt(body, binder, handler, fin, span, slotOpt)
            case _ -> {}
        }
        if (!ok) {
            return none
        }
        slotOpt
    }

    /// Lower a block, optionally storing its tail into a result slot (used by
    /// `if`/`if let`/match arm values). The tail is lifted when the slot is a
    /// `Ptr` (option-typed result).
    fn blockIntoSlot(b: Block, resSlot: int?) -> bool {
        if (let some(slot) = resSlot) {
            var want = IrTy.Unit
            if (slot < len(this.fslots)) {
                want = this.fslots[slot]
            }
            if (let some(trySlot) = this.stmtsWithTryTail(b.stmts, want)) {
                let t = this.load(trySlot)
                this.instr(IrInstr.StoreSlot(slot, t))
                return true
            }
        } else {
            let noResTry = this.stmtsWithTryTail(b.stmts, IrTy.Unit)
            if (let some(_) = noResTry) {
                return true
            }
        }
        for (s in b.stmts) {
            if (!(this.stmt(s))) {
                return false
            }
        }
        if (let some(e) = b.expr) {
            var t = -1
            if (let some(tv) = this.expr(e)) {
                t = tv
            } else {
                return false
            }
            if (let some(slot) = resSlot) {
                var isPtrSlot = false
                if (slot < len(this.fslots)) {
                    if (irTyTag(this.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                        isPtrSlot = true
                    }
                }
                if (isPtrSlot) {
                    var vt = Ty.Unknown
                    if (let some(gt) = this.tyOf(e.span)) {
                        vt = gt
                    }
                    var w = -1
                    if (let some(wv) = this.optionWrap(t, vt, e.span)) {
                        w = wv
                    } else {
                        return false
                    }
                    this.instr(IrInstr.StoreSlot(slot, w))
                } else {
                    this.instr(IrInstr.StoreSlot(slot, t))
                }
            }
        }
        true
    }

    /// After a block body, close the current block: run statements, then make
    /// the tail expression the return value (or discard it).
fn blockTailAsReturn(b: Block) {
        let trySlot = this.stmtsWithTryTail(b.stmts, this.fret)
        if (let some(ts) = trySlot) {
            // `blockIntoSlot` already option-boxed a scalar tail into a `Ptr`
            // result slot, so the loaded value matches `fret` as-is.
            let t = this.load(ts)
            this.term(IrTerm.Return(t))
            return
        }
        for (s in b.stmts) {
            if (this.stmt(s)) {
                continue
            }
            return
        }
        if (let some(e) = b.expr) {
            if (!(irTyTag(this.fret) == irTyTag(IrTy.Unit))) {
                if (let some(t) = this.expr(e)) {
                    var tv = t
                    if (irTyTag(this.fret) == irTyTag(IrTy.Ptr)) {
                        var vt = Ty.Unknown
                        if (let some(gt) = this.tyOf(e.span)) {
                            vt = gt
                        }
                        if (let some(w) = this.optionWrap(tv, vt, e.span)) {
                            tv = w
                        }
                    }
                    this.term(IrTerm.Return(tv))
                }
            } else {
                let _ = this.expr(e)
                this.term(IrTerm.Return(none))
            }
        } else {
            if (irTyTag(this.fret) == irTyTag(IrTy.Unit)) {
                this.term(IrTerm.Return(none))
            }
        }
    }

    /// Ensure the final block is closed: only unit functions get the trailing
    /// empty `return`; dead value-returning blocks stay `Unreachable`.
    fn tailCleanup() -> bool {
        var dead = false
        match (this.blocks[this.cur].term) {
            case IrTerm.Unreachable -> dead = true
            case _ -> {}
        }
        if (dead && irTyTag(this.fret) == irTyTag(IrTy.Unit)) {
            this.blocks[this.cur].term = IrTerm.Return(none)
        }
        true
    }

    // ---- body builders (incremental port; filled in by later sub-slices) ----

    /// Build the hoisted body of a top-level `fn`/`test`. Mirrors `emit_body`.
fn emitBody(body: FnBody?) -> bool {
        this.iceSeq = emptyStrs()
        if (let some(b) = body) {
            match (b) {
                case FnBody.Block(bb) -> {
                    this.pushScope()
                    this.blockTailAsReturn(bb)
                    this.popScope()
                }
                case FnBody.Expr(e) -> {
                    if (irTyTag(this.fret) == irTyTag(IrTy.Unit)) {
                        let _ = this.expr(e)
                    } else {
                        if (let some(t) = this.expr(e)) {
                            var tv = t
                            if (irTyTag(this.fret) == irTyTag(IrTy.Ptr)) {
                                var vt = Ty.Unknown
                                if (let some(gt) = this.tyOf(e.span)) {
                                    vt = gt
                                }
                                if (let some(w) = this.optionWrap(tv, vt, e.span)) {
                                    tv = w
                                }
                            }
                            this.term(IrTerm.Return(tv))
                        }
                    }
                }
            }
        }
        this.tailCleanup()
    }

    // ---- body builders (incremental port; filled in by later sub-slices) ----

    /// Build the hoisted body of a lambda. The closure object occupies slot 0
    /// (`env`), parameters come at slots 1..=n, then captures are copied out of
    /// the closure after every parameter.
    fn buildLambdaBody(lambda: Expr, captures: List<Capture>, pty: List<Ty>, ret: Ty, owner: int?, fid: int) {
        let _ = fid
        var params = emptyParams()
        var lb = FnBody.Expr(Expr(Span(0, 0), ExprKind.This))
        match (lambda.kind) {
            case ExprKind.Lambda(ps, _rt, _ia, b) -> {
                params = ps
                lb = b
            }
            case _ -> {
                this.bad(lambda.span, "lambda lost its body")
                return
            }
        }
        var ptys = pty
        if (len(ptys) == 0) {
            var known = false
            if (let some(t) = this.types.get(spanKey(lambda.span))) {
                match (t) {
                    case Ty.Fn(pts, _) -> {
                        ptys = pts
                        known = true
                    }
                    case _ -> {}
                }
            }
            if (!known) {
                this.bad(lambda.span, "lambda parameter types are not statically known")
                return
            }
        }
        if (let some(ir) = this.mapTy(ret, lambda.span)) {
            this.fret = ir
        }
        this.owner = owner

        // Slot 0 is the closure object; it must stay at fparam index 0 so the
        // JIT hands the closure to slot 0.
        var envIr = IrTy.Ptr
        var envSlot = this.newSlot(envIr)
        this.fparams.push(IrParam("env", envIr))
        this.declare("env", envSlot)
        var envObj = this.load(envSlot)

        // The lambda's own parameters, typed from the checker's Fn signature,
        // occupy slots 1..=n matching their argument order.
        var i = 0
        while (i < len(params)) {
            var p = params[i]
            var t = Ty.Unknown
            if (i < len(ptys)) {
                t = ptys[i]
            }
            var ir = IrTy.Ptr
            if (let some(r) = this.mapTy(t, p.span)) {
                ir = r
            }
            var slot = this.newSlot(ir)
            this.fparams.push(IrParam(p.name, ir))
            this.declare(p.name, slot)
            i = i + 1
        }

        // Captured values go into fresh slots after every parameter; a capture
        // whose name a parameter shadows is skipped.
        var ci = 0
        while (ci < len(captures)) {
            var cap = captures[ci]
            var v = -1
            if (let some(fv) = this.fieldRead(cap.span, envObj, cap.ty, 1 + ci)) {
                v = fv
            } else {
                return
            }
            var ir = IrTy.Ptr
            if (let some(r) = this.mapTy(cap.ty, cap.span)) {
                ir = r
            }
            var slot = this.newSlot(ir)
            this.instr(IrInstr.StoreSlot(slot, v))
            var shadowed = len(this.env) == 0
            if (!shadowed) {
                for (p in params) {
                    if (p.name == cap.name) {
                        shadowed = true
                        break
                    }
                }
            }
            if (!shadowed) {
                this.declare(cap.name, slot)
            }
            ci = ci + 1
        }
        let _ = this.emitBody(lb)
    }

/// Build a spread trampoline: a dynamically-callable forwarder whose
    /// parameters are `(recv?, boxed)` Ã¢â‚¬â€ the receiver when present (slot 0),
    /// then the boxed `List` of the spread elements. The body loads the list,
    /// unboxes one element per target parameter (by that parameter's own
    /// element representation), and calls the target directly, returning its
    /// result. Mirrors `build_spread_trampoline` in emit.rs.
    fn buildSpreadTrampoline(span: Span, target: int, pty: List<Ty>, ret: Ty, receiver: bool) {
        var m = this.mapTy(ret, span)
        if (let some(r) = m) {
            this.fret = r
        }
        var recvSlot = 0
        if (receiver) {
            recvSlot = this.newSlot(IrTy.Ptr)
            this.fparams.push(IrParam("recv", IrTy.Ptr))
            this.declare("recv", recvSlot)
        }
        var listSlot = this.newSlot(IrTy.Ptr)
        this.fparams.push(IrParam("boxed", IrTy.Ptr))
        this.declare("boxed", listSlot)
        var list = this.load(listSlot)
        var real = emptyInts()
        var i = 0
        while (i < len(pty)) {
            var idx = this.intConst(i)
            var raw = this.externCallT1("pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [list, idx])
            var rep = this.elemRep(pty[i], span)
            if (let some(re) = rep) {
                if (re.isPtr) {
                    real.push(raw)
                } else {
                    var v = this.externCallT1(re.unboxSym, [IrTy.Ptr], re.ir, [raw])
                    real.push(v)
                }
            } else {
                return
            }
            i = i + 1
        }
        var args = emptyInts()
        if (receiver) {
            args.push(this.load(recvSlot))
        }
        for (r in real) {
            args.push(r)
        }
        if (irTyTag(this.fret) == irTyTag(IrTy.Unit)) {
            this.instr(IrInstr.Call(none, Callee.Func(target), args))
            this.term(IrTerm.Return(none))
        } else {
            var dst = this.temp()
            this.instr(IrInstr.Call(dst, Callee.Func(target), args))
            this.term(IrTerm.Return(dst))
        }
    }

    /// Build a function-value trampoline: `(env, args...) -> ret` calling the
    /// wrapped top-level function.
    fn buildTrampoline(span: Span, target: int, pty: List<Ty>, ret: Ty) {
        var m = this.mapTy(ret, span)
        if (let some(r) = m) {
            this.fret = r
        }
        var envSlot = this.newSlot(IrTy.Ptr)
        this.fparams.push(IrParam("env", IrTy.Ptr))
        this.declare("env", envSlot)
        var args = emptyInts()
        for (t in pty) {
            var it = this.mapTy(t, span)
            var ir = IrTy.Ptr
            if (let some(r) = it) {
                ir = r
            }
            var slot = this.newSlot(ir)
            var pname = "arg" + str(len(this.fparams) - 1)
            this.fparams.push(IrParam(pname, ir))
            this.declare(pname, slot)
            args.push(this.load(slot))
        }
        if (irTyTag(this.fret) == irTyTag(IrTy.Unit)) {
            this.instr(IrInstr.Call(none, Callee.Func(target), args))
            this.term(IrTerm.Return(none))
        } else {
            var dst = this.temp()
            this.instr(IrInstr.Call(dst, Callee.Func(target), args))
            this.term(IrTerm.Return(dst))
        }
    }

    /// Build the hidden future body of an `async fn`: a 0-arg hoisted body whose
    /// closure slots 1..N hold each parameter under its own name. The body is
    /// then lowered exactly like a top-level function body, so `return`/`await`
    /// inside it work normally. Mirrors `build_async_body` in emit.rs.
    fn buildAsyncBody(f: FnDecl, pty: List<Ty>, ret: Ty) -> bool {
        var m = this.mapTy(ret, f.span)
        if (let some(r) = m) {
            this.fret = r
        }
        this.owner = none
        var envIr = IrTy.Ptr
        var envSlot = this.newSlot(envIr)
        this.fparams.push(IrParam("env", envIr))
        this.declare("env", envSlot)
        var envObj = this.load(envSlot)
        var i = 0
        while (i < len(f.params)) {
            var p = f.params[i]
            var t = Ty.Unknown
            if (i < len(pty)) {
                t = pty[i]
            }
            var v = 0
            var fr = this.fieldRead(p.span, envObj, t, 1 + i)
            if (let none = fr) {
                return false
            }
            if (let some(x) = fr) {
                v = x
            }
            var ir = IrTy.Ptr
            var mt = this.mapTy(t, p.span)
            if (let some(r2) = mt) {
                ir = r2
            }
            var slot = this.newSlot(ir)
            this.instr(IrInstr.StoreSlot(slot, v))
            this.declare(p.name, slot)
            i = i + 1
        }
        this.emitBody(f.body)
        this.tailCleanup()
        true
    }

    /// Build the visible wrapper of an `async` method: it has the method's real
    /// ABI (`this` at slot 0 for instance methods, then the parameters, exactly
    /// like `buildMethodBody`) but returns the future Ã¢â‚¬â€ a closure over the
    /// receiver (if any) and the parameters Ã¢â‚¬â€ without running the body.
    /// Mirrors `build_async_method_wrapper` in emit.rs.
    fn buildAsyncMethodWrapper(md: MethodDecl, info: CallableInfo, hidden: int, isStatic: bool, thisTy: Ty?) -> bool {
        var d = 0
        var captures = emptyCaptures()
        if (!isStatic) {
            this.fslots.push(IrTy.Ptr)
            this.fparams.push(IrParam("this", IrTy.Ptr))
            this.declare("this", 0)
            var ct = Ty.Unknown
            if (let some(t) = thisTy) {
                ct = t
            }
            captures.push(Capture("this", ct, md.span))
            d = 1
        }
        var i = 0
        while (i < len(info.params)) {
            var p = info.params[i]
            var ir = IrTy.Ptr
            if (let some(r) = this.mapTy(p.ty, p.span)) {
                ir = r
            }
            var slot = d + i
            this.fslots.push(ir)
            this.fparams.push(IrParam(p.name, ir))
            this.declare(p.name, slot)
            captures.push(Capture(p.name, p.ty, p.span))
            i = i + 1
        }
        this.fret = IrTy.Ptr
        if (let some(obj) = this.closureObj(Expr(md.span, ExprKind.Ident("")), hidden, captures)) {
            this.term(IrTerm.Return(obj))
        }
        true
    }

    /// Build the hidden future body of an `async` method. The closure slots hold
    /// the receiver (instance methods) then the parameters; the receiver is
    /// re-declared as `this` so the body's receiver-fallback operates exactly as
    /// in a regular method body. Mirrors `build_async_method_body` in emit.rs.
    fn buildAsyncMethodBody(md: MethodDecl, pty: List<Ty>, ret: Ty, isStatic: bool) -> bool {
        var m = this.mapTy(ret, md.span)
        if (let some(r) = m) {
            this.fret = r
        }
        var envIr = IrTy.Ptr
        var envSlot = this.newSlot(envIr)
        this.fparams.push(IrParam("env", envIr))
        this.declare("env", envSlot)
        var envObj = this.load(envSlot)
        var base = 0
        if (!isStatic) {
            base = 1
        }
        if (!isStatic) {
            var t = Ty.Unknown
            if (len(pty) > 0) {
                t = pty[0]
            }
            var v = 0
            var fr = this.fieldRead(md.span, envObj, t, 1)
            if (let none = fr) {
                return false
            }
            if (let some(x) = fr) {
                v = x
            }
            var ir = IrTy.Ptr
            var mt = this.mapTy(t, md.span)
            if (let some(r2) = mt) {
                ir = r2
            }
            var slot = this.newSlot(ir)
            this.instr(IrInstr.StoreSlot(slot, v))
            this.declare("this", slot)
        }
        var i = 0
        while (i < len(md.params)) {
            var p = md.params[i]
            var t = Ty.Unknown
            if (i + base < len(pty)) {
                t = pty[i + base]
            }
            var v = 0
            var fr = this.fieldRead(p.span, envObj, t, 1 + base + i)
            if (let none = fr) {
                return false
            }
            if (let some(x) = fr) {
                v = x
            }
            var ir = IrTy.Ptr
            var mt = this.mapTy(t, p.span)
            if (let some(r2) = mt) {
                ir = r2
            }
            var slot = this.newSlot(ir)
            this.instr(IrInstr.StoreSlot(slot, v))
            this.declare(p.name, slot)
            i = i + 1
        }
        this.emitBody(md.body)
        this.tailCleanup()
        true
    }

    /// Build a bound-method trampoline: a forwarder with the hoisted-lambda
    /// signature `(env, args...) -> ret` whose closure slot 1 holds the bound
    /// receiver. The body loads that receiver and calls the wrapped instance
    /// method `target` with it first, then returns the result; when `branches`
    /// is non-empty it dispatches on the runtime class first. Mirrors
    /// `build_method_trampoline` in emit.rs.
    fn buildMethodTrampoline(span: Span, target: int, pty: List<Ty>, ret: Ty, branches: List<DispatchBranch>) {
        var m = this.mapTy(ret, span)
        if (let some(r) = m) {
            this.fret = r
        }
        var envIr = IrTy.Ptr
        var envSlot = this.newSlot(envIr)
        this.fparams.push(IrParam("env", envIr))
        this.declare("env", envSlot)
        var env = this.load(envSlot)
        var one = this.intConst(1)
        var receiver = this.externCallT1("pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [env, one])
        var real = emptyInts()
        var i = 0
        while (i < len(pty)) {
            var t = pty[i]
            var ir = IrTy.Ptr
            var mt = this.mapTy(t, span)
            if (let some(r) = mt) {
                ir = r
            }
            var slot = this.newSlot(ir)
            var pname = "arg" + str(i)
            this.fparams.push(IrParam(pname, ir))
            this.declare(pname, slot)
            real.push(this.load(slot))
            i = i + 1
        }
        if (len(branches) == 0) {
            var args = emptyInts()
            args.push(receiver)
            for (r in real) {
                args.push(r)
            }
            if (irTyTag(this.fret) == irTyTag(IrTy.Unit)) {
                this.instr(IrInstr.Call(none, Callee.Func(target), args))
                this.term(IrTerm.Return(none))
            } else {
                var dst = this.temp()
                this.instr(IrInstr.Call(dst, Callee.Func(target), args))
                this.term(IrTerm.Return(dst))
            }
            return
        }
        var anchor = Expr(span, ExprKind.Ident(""))
        var retSlot = this.newSlot(this.fret)
        var join = this.newBlock()
        for (b in branches) {
            var cb = this.newBlock()
            var next = this.newBlock()
            var dc = this.intConst(b.cid)
            var found = this.externCallT1("pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [receiver, dc])
            this.term(IrTerm.BranchIf(found, cb, next))
            this.cur = cb
            var bargs = emptyInts()
            bargs.push(receiver)
            for (r in real) {
                bargs.push(r)
            }
            var val = this.emitCallTo(b.fid, bargs, anchor)
            this.instr(IrInstr.StoreSlot(retSlot, val))
            this.term(IrTerm.Branch(join))
            this.cur = next
        }
        var fargs = emptyInts()
        fargs.push(receiver)
        for (r in real) {
            fargs.push(r)
        }
        var fval = this.emitCallTo(target, fargs, anchor)
        this.instr(IrInstr.StoreSlot(retSlot, fval))
        this.term(IrTerm.Branch(join))
        this.cur = join
        var dst = this.temp()
        this.instr(IrInstr.LoadSlot(dst, retSlot))
        this.term(IrTerm.Return(dst))
    }

    /// The nearest explicit-primary-constructor ancestor of `name` (the
    /// deepest class in the chain that declares a primary `constructor`),
    /// together with the absolute end slot of that ancestor's own instance
    /// fields. Classes with only *named* constructors are still synthesized,
    /// so they never count as explicit here. Mirrors
    /// `nearest_explicit_primary_ancestor`.
    fn nearestExplicitPrimaryAncestor(name: string) -> AncestorMeta? {
        var found: AncestorMeta? = none
        var base = 0
        for (cname in this.ancestry(name)) {
            var own = this.ownInstanceFields(cname)
            var hasCtor = false
            if (let some(t) = this.tableOf(cname)) {
                if (let some(_) = t.ctor) {
                    hasCtor = true
                }
            }
            if (hasCtor) {
                found = AncestorMeta(cname, base + len(own))
            }
            base = base + len(own)
        }
        found
    }

    /// Total instance-field slot count of `name` including inherited fields.
    /// Mirrors `total_instance_slot_count`.
    fn totalInstanceSlotCount(name: string) -> int {
        var total = 0
        for (c in this.ancestry(name)) {
            total = total + len(this.ownInstanceFields(c))
        }
        total
    }

    /// Parameter metadata for a synthesized constructor of `name`, in
    /// parameter order: the absolute instance-field slot each parameter must
    /// be stored into (`-1` = a leading explicit-ancestor constructor
    /// parameter, forwarded to the chained `super(...)`), plus the nearest
    /// explicit-primary ancestor to chain into and how many leading
    /// parameters that chain consumes. With no explicit-primary ancestor the
    /// whole chain's uninitialized fields become the parameters (one per
    /// field slot) and nothing is chained. Mirrors
    /// `synthesized_ctor_param_meta`.
    fn synthesizedCtorParamMeta(name: string) -> CtorParamMeta {
        var cc = this.collectInstanceInits(name)
        var empty = emptyInts()
        for (si in cc) {
            empty.push(si.slot)
        }
        var slots = emptyInts()
        var cparamCount = 0
        var cutBase = 0
        var anc = this.nearestExplicitPrimaryAncestor(name)
        var hasAnc = false
        if (let some(a) = anc) {
            hasAnc = true
            if (let some(t) = this.tableOf(a.name)) {
                if (let some(c) = t.ctor) {
                    cparamCount = len(c.params)
                    var k = 0
                    while (k < cparamCount) {
                        slots.push(-1)
                        k = k + 1
                    }
                }
            }
            cutBase = a.endSlot
        }
        var base = 0
        for (cname in this.ancestry(name)) {
            var own = this.ownInstanceFields(cname)
            var contribute = false
            if (hasAnc) {
                if (base >= cutBase) {
                    contribute = true
                }
            } else {
                contribute = true
            }
            if (contribute) {
                var i = 0
                while (i < len(own)) {
                    var abs = base + i
                    var hasInit = false
                    for (e in empty) {
                        if (e == abs) {
                            hasInit = true
                            break
                        }
                    }
                    if (!hasInit) {
                        slots.push(abs)
                    }
                    i = i + 1
                }
            }
            base = base + len(own)
        }
        var chainName = ""
        var chainCount = 0
        if (let some(a2) = anc) {
            chainName = a2.name
            chainCount = cparamCount
        }
        CtorParamMeta(slots, chainName, chainCount)
    }

    /// Run a constructor `Block` whose tail expression is NOT the function's
    /// return value (used for constructor bodies and `init` blocks, where the
    /// constructor always returns `this`). Mirrors `emit_ctor_block`.
    fn emitCtorBlock(b: Block) -> bool {
        this.emitCtorBlockFrom(b, 0)
    }

    /// Run a constructor `Block` starting at statement `from`, skipping the
    /// leading statements (i.e. the consumed `super(...)` delegation).
    /// Mirrors `emit_ctor_block_from`.
    fn emitCtorBlockFrom(b: Block, fromIdx: int) -> bool {
        this.pushScope()
        var i = fromIdx
        while (i < len(b.stmts)) {
            if (!this.stmt(b.stmts[i])) {
                this.popScope()
                return false
            }
            i = i + 1
        }
        if (let some(e) = b.expr) {
            let _ = this.expr(e)
        }
        this.popScope()
        true
    }

    /// Lower a `super(...)` delegation at the front of a primary constructor
    /// body: evaluate the arguments in the current scope, then inline the
    /// parent's constructor chain. Mirrors `emit_super_chain`.
    fn emitSuperChain(ownerName: string, delegation: Expr) -> bool {
        var args = emptyCallArgs()
        var isCall = false
        match (delegation.kind) {
            case ExprKind.Call(_super, a) -> {
                args = a
                isCall = true
            }
            case _ -> {}
        }
        if (!isCall) {
            return this.bad(delegation.span, "`super(...)` delegation is malformed")
        }
        var parent = ""
        var hasParent = false
        if (let some(t) = this.tableOf(ownerName)) {
            if (let some(ext) = t.extends) {
                if (let some(p) = named(ext)) {
                    parent = p
                    hasParent = true
                }
            }
        }
        if (!hasParent) {
            return this.bad(delegation.span, "`super(...)` requires a superclass")
        }
        var pt: ClassTable? = this.tableOf(parent)
        if (let none = pt) {
            return this.bad(delegation.span, "`" + parent + "` is not a class")
        }
        var vals = emptyCtorArgVals()
        for (a in args) {
            if (a.spread) {
                return this.bad(a.span, "spread arguments are not lowered yet")
            }
            var vO = this.expr(a.value)
            if (let none = vO) {
                return false
            }
            var v = 0
            if (let some(x) = vO) {
                v = x
            }
            var ty = Ty.Unknown
            if (let some(t) = this.tyOf(a.value.span)) {
                ty = t
            }
            vals.push(CtorArgVal(v, ty, a.value.span))
        }
        var ptable = seedClassTable()
        if (let some(t) = pt) {
            ptable = t
        }
        this.emitCtorChain(parent, ptable, vals, delegation.span)
    }

    /// Lower the synthesized `super(...)` of a class with no explicit
    /// constructor that sits below an explicit-primary ancestor: forward the
    /// first `count` constructor parameters (already in the function's local
    /// slots) to the ancestor's inlined constructor chain. Mirrors
    /// `emit_synthesized_super_chain`.
    fn emitSynthesizedSuperChain(ancestor: string, count: int) -> bool {
        var at: ClassTable? = this.tableOf(ancestor)
        if (let none = at) {
            return true
        }
        var atable = seedClassTable()
        if (let some(t) = at) {
            atable = t
        }
        var cparams = emptyParamInfos()
        if (let some(c) = atable.ctor) {
            cparams = c.params
        }
        var vals = emptyCtorArgVals()
        var i = 0
        while (i < count && i < len(cparams)) {
            var p = cparams[i]
            var v = this.load(i)
            vals.push(CtorArgVal(v, p.ty, p.span))
            i = i + 1
        }
        this.emitCtorChain(ancestor, atable, vals, atable.span)
    }

    /// Run the constructor chain for class `cname`, whose constructor receives
    /// the already-evaluated `vals`. An explicit constructor has its
    /// parameters bound to the values (option-wrapped where the parameter is a
    /// pointer) and its body emitted, recursing on a leading `super(...)`. A
    /// synthesized constructor stores the values into its uninitialized
    /// instance-field slots. `this` stays live in the current scope because
    /// the chain is inlined into the leaf constructor. Field initializers and
    /// `init` blocks for the whole hierarchy are run by the leaf constructor,
    /// so they are not repeated here. Mirrors `emit_ctor_chain`.
    fn emitCtorChain(cname: string, ct: ClassTable, vals: List<CtorArgVal>, span: Span) -> bool {
        this.pushScope()
        var cd: ConstructorDecl? = none
        if (let some(decl) = this.classDecls.get(cname)) {
            for (m in decl.members) {
                match (m) {
                    case ClassMember.Constructor(c) -> {
                        if (let none = c.name) {
                            cd = c
                            break
                        }
                    }
                    case _ -> {}
                }
            }
        }
        var hasCtCtor = false
        if (let some(_) = ct.ctor) {
            hasCtCtor = true
        }
        if (hasCtCtor) {
            if (let none = cd) {
                this.popScope()
                return this.bad(span, "`" + cname + "` primary constructor is missing")
            }
            var ctorDecl = seedConstructorDecl()
            if (let some(x) = cd) {
                ctorDecl = x
            }
            var cparams = emptyParamInfos()
            if (let some(c) = ct.ctor) {
                cparams = c.params
            }
            if (!(len(cparams) == len(vals))) {
                this.popScope()
                return this.bad(span, "`super(...)` passes " + str(len(vals)) + " argument(s) but `" + cname + "` expects " + str(len(cparams)))
            }
            var w = 0
            while (w < len(cparams)) {
                var pr = cparams[w]
                var av = vals[w]
                var ir = IrTy.Ptr
                if (let some(r) = this.mapTy(pr.ty, pr.span)) {
                    ir = r
                }
                var slot = this.newSlot(ir)
                var stored = av.v
                if (irTyTag(ir) == irTyTag(IrTy.Ptr)) {
                    var wrapped = this.optionWrap(av.v, av.ty, av.span)
                    if (let none = wrapped) {
                        this.popScope()
                        return false
                    }
                    var wv = 0
                    if (let some(x) = wrapped) {
                        wv = x
                    }
                    stored = wv
                }
                this.instr(IrInstr.StoreSlot(slot, stored))
                this.declare(pr.name, slot)
                w = w + 1
            }
            var hasDel = false
            var del = ctorSuperDelegation(ctorDecl.body)
            if (let some(dg) = del) {
                hasDel = true
                if (!this.emitSuperChain(cname, dg)) {
                    this.popScope()
                    return false
                }
            }
            if (hasDel) {
                if (!this.emitCtorBlockFrom(ctorDecl.body, 1)) {
                    this.popScope()
                    return false
                }
            } else {
                if (!this.emitCtorBlock(ctorDecl.body)) {
                    this.popScope()
                    return false
                }
            }
        } else {
            var meta = this.synthesizedCtorParamMeta(cname)
            if (!(len(meta.slots) == len(vals))) {
                this.popScope()
                return this.bad(span, "`super(...)` passes " + str(len(vals)) + " argument(s) but `" + cname + "` expects " + str(len(meta.slots)))
            }
            var thisSlotO = this.lookup("this")
            if (let none = thisSlotO) {
                this.popScope()
                return this.bad(span, "`this` is not available in the constructor chain")
            }
            var thisSlot = 0
            if (let some(s) = thisSlotO) {
                thisSlot = s
            }
            var thisObj = this.load(thisSlot)
            if (!(meta.chainName == "")) {
                var candVals = emptyCtorArgVals()
                var kk = 0
                while (kk < meta.chainCount && kk < len(vals)) {
                    candVals.push(vals[kk])
                    kk = kk + 1
                }
                if (let some(at2) = this.tableOf(meta.chainName)) {
                    this.emitCtorChain(meta.chainName, at2, candVals, span)
                }
            }
            var ifields = this.allInstanceFields(cname)
            var z = 0
            while (z < len(meta.slots)) {
                var slot2 = meta.slots[z]
                if (slot2 < 0) {
                    z = z + 1
                    continue
                }
                var av2 = vals[z]
                var f = ifields[slot2]
                var repO = this.elemRep(f.ty, f.span)
                if (let none = repO) {
                    this.popScope()
                    return false
                }
                var rep = ElemRep.ptr()
                if (let some(r) = repO) {
                    rep = r
                }
                var packedO = this.packForPointerBoundary(rep, av2.v, av2.ty, av2.span)
                if (let none = packedO) {
                    this.popScope()
                    return false
                }
                var packed = 0
                if (let some(p) = packedO) {
                    packed = p
                }
                var boxedO = this.boxForStore(rep, packed, elemIr(f.ty))
                if (let none = boxedO) {
                    this.popScope()
                    return false
                }
                var boxed = 0
                if (let some(b) = boxedO) {
                    boxed = b
                }
                this.fieldStore(thisObj, slot2, f.ty, boxed)
                z = z + 1
            }
        }
        this.popScope()
        true
    }

    /// Build an explicit/implicit constructor. Mirrors `build_ctor_body`.
    fn buildCtorBody(table: ClassTable, inits: List<SlotInit>, initBlocks: List<Block>, ctor: ConstructorDecl?) -> bool {
        var ifields = this.allInstanceFields(table.name)
        var params = emptyCtorParams()
        var meta = this.synthesizedCtorParamMeta(table.name)
        var hasCtor = false
        if (let some(_) = table.ctor) {
            hasCtor = true
        }
        if (hasCtor) {
            var ctorParams = emptyParamInfos()
            if (let some(c) = table.ctor) {
                ctorParams = c.params
            }
            for (p in ctorParams) {
                params.push(CtorParam(p.name, p.ty, p.span, -1))
            }
        } else {
            var anc = this.nearestExplicitPrimaryAncestor(table.name)
            if (let some(a) = anc) {
                if (let some(t) = this.tableOf(a.name)) {
                    if (let some(c2) = t.ctor) {
                        for (p in c2.params) {
                            params.push(CtorParam(p.name, p.ty, p.span, -1))
                        }
                    }
                }
            }
            for (slot in meta.slots) {
                if (slot < 0) {
                    continue
                }
                var f = ifields[slot]
                params.push(CtorParam(f.name, f.ty, f.span, slot))
            }
        }
        var i = 0
        while (i < len(params)) {
            var pm = params[i]
            var ir = IrTy.Ptr
            if (let some(r) = this.mapTy(pm.ty, table.span)) {
                ir = r
            }
            this.fslots.push(ir)
            this.fparams.push(IrParam(pm.name, ir))
            this.declare(pm.name, i)
            i = i + 1
        }
        this.fret = IrTy.Ptr

        var cid = PICKLE_CLASS_USER_BASE
        if (let some(o) = this.owner) {
            cid = o
        }
        var thisSlot = this.newSlot(IrTy.Ptr)
        this.declare("this", thisSlot)

        var cidT = this.intConst(cid)
        var nT = this.intConst(len(ifields))
        var created = this.externCallT1("pickle_class_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [cidT, nT])
        this.instr(IrInstr.StoreSlot(thisSlot, created))

        var thisObj = this.load(thisSlot)

        for (si in inits) {
            var slot = si.slot
            var f = ifields[slot]
            var ty = f.ty
            var manual = f.manual
            var vO = this.expr(si.init)
            if (let none = vO) {
                return false
            }
            var v = 0
            if (let some(x) = vO) {
                v = x
            }
            if (manual) {
                v = this.externCallT1("pickle_manual_adopt", [IrTy.Ptr], IrTy.Ptr, [v])
            }
            var repO = this.elemRep(ty, table.span)
            if (let none = repO) {
                return false
            }
            var rep = ElemRep.ptr()
            if (let some(r) = repO) {
                rep = r
            }
            var vt = Ty.Unknown
            if (let some(t) = this.tyOf(si.init.span)) {
                vt = t
            }
            var packedO = this.packForPointerBoundary(rep, v, vt, si.init.span)
            if (let none = packedO) {
                return false
            }
            var packed = 0
            if (let some(p) = packedO) {
                packed = p
            }
            var boxedO = this.boxForStore(rep, packed, elemIr(ty))
            if (let none = boxedO) {
                return false
            }
            var boxed = 0
            if (let some(b) = boxedO) {
                boxed = b
            }
            this.fieldStore(thisObj, slot, ty, boxed)
        }

        var j = 0
        while (j < len(params)) {
            var pm2 = params[j]
            if (pm2.fieldSlot >= 0) {
                var v2 = this.load(j)
                var rep2O = this.elemRep(pm2.ty, pm2.span)
                if (let none = rep2O) {
                    return false
                }
                var rep2 = ElemRep.ptr()
                if (let some(r) = rep2O) {
                    rep2 = r
                }
                var packed2O = this.packForPointerBoundary(rep2, v2, pm2.ty, pm2.span)
                if (let none = packed2O) {
                    return false
                }
                var packed2 = 0
                if (let some(p) = packed2O) {
                    packed2 = p
                }
                var boxed2O = this.boxForStore(rep2, packed2, elemIr(pm2.ty))
                if (let none = boxed2O) {
                    return false
                }
                var boxed2 = 0
                if (let some(b) = boxed2O) {
                    boxed2 = b
                }
                this.fieldStore(thisObj, pm2.fieldSlot, pm2.ty, boxed2)
            }
            j = j + 1
        }

        if (let some(cd) = ctor) {
            var del = ctorSuperDelegation(cd.body)
            if (let some(dg) = del) {
                if (!this.emitSuperChain(table.name, dg)) {
                    return false
                }
                if (!this.emitCtorBlockFrom(cd.body, 1)) {
                    return false
                }
            } else {
                if (!this.emitCtorBlock(cd.body)) {
                    return false
                }
            }
        }
        if (let none = ctor) {
            if (!(meta.chainName == "")) {
                if (!this.emitSynthesizedSuperChain(meta.chainName, meta.chainCount)) {
                    return false
                }
            }
        }
        for (b in initBlocks) {
            if (!this.emitCtorBlock(b)) {
                return false
            }
        }

        var done = this.load(thisSlot)
        this.term(IrTerm.Return(done))
        this.tailCleanup()
        true
    }

    /// Build a named constructor: a static factory that evaluates the
    /// delegation arguments and calls the primary constructor. Mirrors
    /// `build_named_ctor`.
    fn buildNamedCtor(table: ClassTable, cd: ConstructorDecl) -> bool {
        var info: CtorInfo? = none
        if (let some(n) = cd.name) {
            for (nc in table.namedCtors) {
                if (nc.name == n) {
                    info = nc.ctor
                    break
                }
            }
        }
        var params = emptyParamInfos()
        if (let some(c) = info) {
            params = c.params
        }
        var i = 0
        while (i < len(params)) {
            var p = params[i]
            var ir = IrTy.Ptr
            if (let some(r) = this.mapTy(p.ty, p.span)) {
                ir = r
            }
            this.fslots.push(ir)
            this.fparams.push(IrParam(p.name, ir))
            this.declare(p.name, i)
            i = i + 1
        }
        this.fret = IrTy.Ptr

        var dg: Expr? = namedCtorDelegation(cd.body)
        if (let none = dg) {
            return this.bad(cd.span, "named constructor body must be a single `this(...)` delegation to the primary constructor")
        }
        var delegation = Expr(Span(0, 0), ExprKind.Ident("x"))
        if (let some(d2) = dg) {
            delegation = d2
        }
        var args = emptyCallArgs()
        var isCall = false
        match (delegation.kind) {
            case ExprKind.Call(_callee, a) -> {
                args = a
                isCall = true
            }
            case _ -> {}
        }
        if (!isCall) {
            return this.bad(cd.span, "named constructor delegation is malformed")
        }

        var cid = PICKLE_CLASS_USER_BASE
        if (let some(c2) = this.classByName.get(table.name)) {
            cid = c2
        }
        var primaryOpt: int? = this.ctorIds.get(cid)
        if (let none = primaryOpt) {
            return this.bad(cd.span, "`" + table.name + "` has no constructor")
        }
        var primary = 0
        if (let some(p2) = primaryOpt) {
            primary = p2
        }
        var fparams = this.irModule.funcs[primary].params
        var argTemps = emptyInts()
        var ai = 0
        while (ai < len(args)) {
            var a = args[ai]
            if (a.spread) {
                return this.bad(a.span, "spread arguments are not lowered yet")
            }
            var tO = this.expr(a.value)
            if (let none = tO) {
                return false
            }
            var t = 0
            if (let some(x) = tO) {
                t = x
            }
            var isPtr = false
            if (ai < len(fparams)) {
                if (irTyTag(fparams[ai].ty) == irTyTag(IrTy.Ptr)) {
                    isPtr = true
                }
            }
            if (isPtr) {
                var vt = Ty.Unknown
                if (let some(gt) = this.tyOf(a.value.span)) {
                    vt = gt
                }
                var wrapped = this.optionWrap(t, vt, a.value.span)
                if (let none = wrapped) {
                    return false
                }
                var wv = 0
                if (let some(x) = wrapped) {
                    wv = x
                }
                t = wv
            }
            argTemps.push(t)
            ai = ai + 1
        }
        var dst = this.temp()
        this.instr(IrInstr.Call(dst, Callee.Func(primary), argTemps))
        this.term(IrTerm.Return(dst))
        true
    }

    /// Lower a `deinit` finalizer: slot 0 is `this`, the body runs with `this`
    /// live, and the function returns unit. Deinit runs off the allocation path
    /// during GC sweep. Mirrors `build_deinit_body`.
    fn buildDeinitBody(table: ClassTable, body: Block) -> bool {
        let _ = table
        this.fslots.push(IrTy.Ptr)
        this.fparams.push(IrParam("this", IrTy.Ptr))
        this.declare("this", 0)
        this.fret = IrTy.Unit
        if (!this.emitCtorBlock(body)) {
            return false
        }
        this.tailCleanup()
        true
    }

    /// Lower a method: slot 0 is `this` (instance methods), followed by the
    /// declared parameters. Mirrors `build_method_body`.
    fn buildMethodBody(table: ClassTable, md: MethodDecl, info: CallableInfo) -> bool {
        let _ = table
        var d = 0
        if (!info.isStatic) {
            this.fslots.push(IrTy.Ptr)
            this.fparams.push(IrParam("this", IrTy.Ptr))
            this.declare("this", 0)
            d = 1
        }
        var i = 0
        while (i < len(info.params)) {
            var p = info.params[i]
            var ir = IrTy.Ptr
            if (let some(r) = this.mapTy(p.ty, p.span)) {
                ir = r
            }
            var slot = d + i
            this.fslots.push(ir)
            this.fparams.push(IrParam(p.name, ir))
            this.declare(p.name, slot)
            i = i + 1
        }
        var mret = this.mapTy(info.ret, md.span)
        if (let some(r) = mret) {
            this.fret = r
        } else {
            this.fret = IrTy.Unit
        }
this.emitBody(md.body)
        this.tailCleanup()
        true
    }

    /// Lower a property accessor. The getter returns the property value; the
    /// setter takes `value` in the slot after `this` (if any), runs the
    /// accessor body, and returns unit. Mirrors `build_property_body`.
    fn buildPropertyBody(table: ClassTable, pd: PropertyDecl, info: PropertyInfo, isSet: bool, isStatic: bool) -> bool {
        let _ = table
        var d = 0
        if (!isStatic) {
            this.fslots.push(IrTy.Ptr)
            this.fparams.push(IrParam("this", IrTy.Ptr))
            this.declare("this", 0)
            d = 1
        }
        if (isSet) {
            var ir = IrTy.Ptr
            if (let some(r) = this.mapTy(info.ty, pd.span)) {
                ir = r
            }
            this.fslots.push(ir)
            this.fparams.push(IrParam("value", ir))
            this.declare("value", d)
            this.fret = IrTy.Unit
        } else {
            var gret = this.mapTy(info.ty, pd.span)
            if (let some(r) = gret) {
                this.fret = r
            } else {
                this.fret = IrTy.Ptr
            }
        }
        var accessor: PropertyAccessor? = none
        if (isSet) {
            accessor = pd.set
        } else {
            accessor = pd.get
        }
        if (let some(a) = accessor) {
            match (a) {
                case PropertyAccessor.Expr(e) -> {
                    if (irTyIsUnit(this.fret)) {
                        let _ = this.expr(e)
                        this.term(IrTerm.Return(none))
                    } else {
                        if (let some(t) = this.expr(e)) {
                            this.term(IrTerm.Return(t))
                        }
                    }
                }
                case PropertyAccessor.Block(b) -> {
                    this.emitBody(FnBody.Block(b))
                }
            }
        }
        this.tailCleanup()
        true
    }

    /// The synthesized static-field initializer function: default-initialize
    /// every cell, then run the non-`none` initializers in order.
    fn buildStaticInit(inits: List<StaticInitEntry>) {
        this.fret = IrTy.Unit
        for (e in inits) {
            this.buildStaticDefault(e.cid, e.slot)
            if (this.failed) {
                return
            }
        }
        for (e in inits) {
            if (let some(x) = e.value) {
                this.owner = e.cid
                this.buildStaticInitOne(e.cid, e.slot, x)
                if (this.failed) {
                    return
                }
            }
        }
        this.term(IrTerm.Return(none))
    }

    /// Root every managed top-level slot, then run the initializers.
    /// Mirrors `build_globals_init` in emit.rs.
    ///
    /// Every root is registered before any initializer runs, because an
    /// initializer is the first code that can allocate and therefore the first
    /// point at which the collector could run.
    fn buildGlobalsInit(inits: List<ManagedGlobalInit>) {
        this.fret = IrTy.Unit
        var rootAddId = this.externId("pickle_gc_root_add", [IrTy.Int], IrTy.Int)
        for (init in inits) {
            var slotAddress = this.temp()
            this.instr(IrInstr.GlobalAddr(slotAddress, init.gid))
            this.instr(IrInstr.Call(none, Callee.Extern(rootAddId), [slotAddress]))
        }
        for (init in inits) {
            if (let some(value) = this.expr(init.value)) {
                this.instr(IrInstr.StoreGlobal(init.gid, value, init.ty))
            } else {
                if (this.failed) {
                    return
                }
            }
        }
        this.term(IrTerm.Return(none))
    }

    /// Store the default (zero scalar / null pointer) into one static cell.
    /// Mirrors `build_static_default` in emit.rs.
    fn buildStaticDefault(cid: int, slot: int) {
        if (let some(info) = this.staticFieldAt(cid, slot)) {
            var fieldTy = info.ty
            if (let some(rep) = this.elemRep(fieldTy, info.span)) {
                var def = 0
                if (rep.isPtr) {
                    if (let some(n) = this.nullTemp()) {
                        def = n
                    }
                } else {
                    if (let some(z) = this.zeroScalar(elemIr(fieldTy), info.span)) {
                        def = z
                    }
                }
                if (let some(b) = this.boxForStore(rep, def, elemIr(fieldTy))) {
                    this.staticStore(cid, slot, b)
                }
            }
        }
    }

    /// Evaluate one static-field initializer and store it. Mirrors
    /// `build_static_init_one` in emit.rs.
    fn buildStaticInitOne(cid: int, slot: int, x: Expr) {
        if (let some(info) = this.staticFieldAt(cid, slot)) {
            var fieldTy = info.ty
            var vO = this.expr(x)
            if (let some(v) = vO) {
                var vt = Ty.Unknown
                if (let some(t) = this.tyOf(x.span)) {
                    vt = t
                }
                let _ = this.staticAssign(x.span, AssignOp.Assign, cid, slot, fieldTy, v, vt)
            }
        }
    }

    /// Register every user class descriptor at the top of `main`'s entry block.
    /// Each is a `pickle_class_register(name_ptr, name_len, slot_count, mask,
    /// owned_mask, finalizer, parent)` void call; the returned id is discarded
    /// (call sites hardcode it, exactly like the runtime's allocation order).
    /// Interface buckets get `pickle_class_add_interface` plus one
    /// `pickle_class_add_iface_method` per dispatch method. Mirrors
    /// `inject_class_registrations`.
    fn injectClassRegistrations() {
        if (len(this.classes) == 0 && isNoneInt(this.staticInitId) && isNoneInt(this.globalsInitId) && len(this.extraSetups) == 0) {
            return
        }
        var plans = emptyRegPlans()
        for (p in this.classes) {
            var fields = this.allInstanceFields(p.name)
            var owned = 0
            var fi = 0
            while (fi < len(fields)) {
                if (fields[fi].manual && fi < 64) {
                    owned = owned | (1 << fi)
                }
                fi = fi + 1
            }
            var parentCid = 0
            if (let some(pv) = p.parent) {
                parentCid = pv
            }
            plans.push(RegPlan(p.name, this.totalInstanceSlotCount(p.name), p.classId, parentCid, owned))
        }
        var instrs = emptyIrInstrs()
        for (rp in plans) {
            var sid = this.internString(rp.name)
            var addr = this.temp()
            instrs.push(IrInstr.Const(addr, IrConst.StrAddr(sid)))
            var addrLen = this.temp()
            instrs.push(IrInstr.Const(addrLen, IrConst.Int(len(bytesOf(rp.name)))))
            var countT = this.temp()
            instrs.push(IrInstr.Const(countT, IrConst.Int(rp.fieldCount)))
            var maskT = this.temp()
            var m = -1
            if (rp.fieldCount < 64) {
                m = (1 << rp.fieldCount) - 1
            }
            instrs.push(IrInstr.Const(maskT, IrConst.Int(m)))
            var ownedT = this.temp()
            instrs.push(IrInstr.Const(ownedT, IrConst.Int(rp.owned)))
            var finT = this.temp()
            var deinitO = this.deinitIds.get(rp.cid)
            if (let some(fid2) = deinitO) {
                instrs.push(IrInstr.Const(finT, IrConst.FuncAddr(fid2)))
            } else {
                instrs.push(IrInstr.Const(finT, IrConst.Int(0)))
            }
            var parT = this.temp()
            instrs.push(IrInstr.Const(parT, IrConst.Int(rp.parent)))
            var ex = this.externId("pickle_class_register", [IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int], IrTy.Unit)
            instrs.push(IrInstr.Call(none, Callee.Extern(ex), [addr, addrLen, countT, maskT, ownedT, finT, parT]))
            var buckets = emptyIfaceBuckets()
            if (let some(b) = this.classIfaceBuckets.get(rp.cid)) {
                buckets = b
            }
            for (bk in buckets) {
                var cidT = this.temp()
                instrs.push(IrInstr.Const(cidT, IrConst.Int(rp.cid)))
                var iidT = this.temp()
                instrs.push(IrInstr.Const(iidT, IrConst.Int(bk.ifaceId)))
                var exMark = this.externId("pickle_class_add_interface", [IrTy.Int, IrTy.Int], IrTy.Unit)
                instrs.push(IrInstr.Call(none, Callee.Extern(exMark), [cidT, iidT]))
                for (db in bk.methods) {
                    var idxT = this.temp()
                    instrs.push(IrInstr.Const(idxT, IrConst.Int(db.cid)))
                    var fnT = this.temp()
                    instrs.push(IrInstr.Const(fnT, IrConst.FuncAddr(db.fid)))
                    var exM = this.externId("pickle_class_add_iface_method", [IrTy.Int, IrTy.Int, IrTy.Int, IrTy.Int], IrTy.Unit)
                    instrs.push(IrInstr.Call(none, Callee.Extern(exM), [cidT, iidT, idxT, fnT]))
                }
            }
        }
        // Managed global roots are registered before `pkl_static_init` so a
        // static initializer can never observe an unrooted slot. It runs after
        // class registration because a `Ptr` initializer may call a constructor,
        // which reads the descriptor that registration creates.
        if (let some(fid4) = this.globalsInitId) {
            instrs.push(IrInstr.Call(none, Callee.Func(fid4), emptyInts()))
        }
        // Peer objects' setup functions (split link): their classes are
        // registered and their globals rooted before this object's static
        // initializers run, because a static initializer may call into a peer.
        for (s in this.extraSetups) {
            var exU = this.externId(s, emptyIrTys(), IrTy.Unit)
            instrs.push(IrInstr.Call(none, Callee.Extern(exU), emptyInts()))
        }
        if (let some(fid3) = this.staticInitId) {
            instrs.push(IrInstr.Call(none, Callee.Func(fid3), emptyInts()))
        }
        var ni = emptyIrInstrs()
        for (x in instrs) {
            ni.push(x)
        }
        for (o in this.blocks[0].instrs) {
            ni.push(o)
        }
        this.blocks[0].instrs = ni
    }
}
