            }
            case _ -> {
                if (let some(fb) = flatBuiltin(name)) {
                    match (fb) {
                        case (sym, params, returns, ret, pnames) -> {
                            if (let some(ts) = this.positionalArgs(e, name, args, pnames)) {
                                if (returns) {
                                    return this.externCallT1(sym, params, ret, ts)
                                } else {
                                    this.externCallVoid(sym, params, ts)
                                    return this.unitTemp()
