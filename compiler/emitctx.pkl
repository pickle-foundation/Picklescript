// PickleScript compiler: emitter context - the Emitter state object that the
// lowering family modules (emitmatch, emitspread, ...) share via one-way import.
// emit.pkl imports this for the class; family modules never import back.
module compiler.emitctx

import * from compiler.ast
import { Span, Diagnostic, DiagnosticSink } from compiler.diag
import { IrBlock, IrFunc, IrGlobal, IrModule, IrParam, IrTy, emptyIrBlocks, emptyIrGlobals, emptyIrParams, emptyIrTys, emptyModule, irTyStr, irxParseFloat } from compiler.ir
import { CallableInfo, ClassTable, CtorInfo, EnumTable, FieldInfo, ParamInfo, PropertyInfo, ResolvedProgram, TypeTableEntry, entryGenerics } from compiler.resolve
import { collectExprTypes, containsStr, isNoneStr, spanKey } from compiler.check
import * from compiler.ty
import { f64ToBits } from compiler.x64
import * from compiler.emitutil

// ---- the emitter ---------------------------------------------------------

/// The compiler's IR emitter: walks the checked AST, lowers every expression
/// and statement to flat block/slot/temp IR, and assembles the `IrModule`.
/// Mirrors `struct Emitter` in emit.rs (the compound-key maps Rust models as
/// `HashMap<(A, B), _>` become single-string-key maps via `pairKey` etc.).
class Emitter {
    var prog: Program
    var resolved: ResolvedProgram
    var diags: DiagnosticSink
var types: Map<string, Ty>
    var irModule: IrModule
    var strIds: Map<string, int>
    var constsInits: Map<string, Expr>
    /// Top-level `var` name -> global id. Kept separate from `constsInits`
    /// because a global is *not* inlined: it becomes a data symbol.
    var globalIds: Map<string, int>
    var globalDecls: Map<string, GlobalDecl>
    /// Globals whose init could not be reduced to bytes, for diagnostics.
    var globalFailures: List<GlobalFailure>
    var classConsts: Map<string, ClassConst>
    var constInlining: List<string>
    var fidList: List<int>
    var fsource: Map<int, FnSource>
    var finfo: Map<int, CallableInfo>
    var srcParamTys: Map<int, List<Ty>>
    var fnDecls: Map<string, FnDecl>
    var instantiations: Map<string, int>
    var instantonSubst: Map<int, Map<string, Ty>>
    var classes: List<ClassPlan>
    var classByName: Map<string, int>
    var classDecls: Map<string, ClassDecl>
    var genericTypeMembers: Map<string, List<ClassMember>>
    var structMembers: Map<string, List<ClassMember>>
    var classInstByArgs: Map<string, int>
    var classInstSubst: Map<int, Map<string, Ty>>
    var fidOwner: Map<int, int>
    var fidGenerics: Map<int, List<string>>
    var genericCtxName: string?
    var genericFnCtx: string?
    var classAttempted: List<string>
    var ctorIds: Map<int, int>
    var namedCtorIds: Map<string, int>
    var deinitIds: Map<int, int>
    var methodIds: Map<string, MethodRef>
    var methodSeq: List<MethodEntry>
    var virtualDispatch: Map<string, List<DispatchBranch>>
    var nextIfaceId: int
    var ifaceInstIds: Map<string, int>
    var ifaceMembers: Map<int, List<IfaceMember>>
    var classIfaceBuckets: Map<int, List<IfaceBucket>>
    var propertyIds: Map<string, int>
    var staticPropertyIds: Map<string, int>
    var propertySeq: List<PropertyEntry>
    var staticPropSeq: List<PropertyEntry>
    var staticInits: List<StaticInitEntry>
    var staticInitId: int?
    var globalsInitId: int?
    var managedGlobalInits: List<ManagedGlobalInit>
    var testSetupId: int?
    /// Â§17.1 split-link options. `cidSalt` offsets this object's user class
    /// ids so that when several objects link into one exe, each object's
    /// compile-time class table matches the order `pickle_class_register`
    /// actually assigns at run time (program first, then members in link
    /// order). `moduleSetupSymbol`, when non-empty, synthesizes a callable
    /// function carrying this object's registration/globals/static preamble â€”
    /// a module with no `main` has nowhere else to hang it. `extraSetups`
    /// names peer objects' setup functions; they are called from this
    /// object's preamble after globals are rooted and before static
    /// initializers run.
    var cidSalt: int
    var moduleSetupSymbol: string
    var extraSetups: List<string>
    var owner: int?
    var closureTables: Map<string, ClassTable>
    var lambdaFids: Map<string, int>
    var lambdaCaps: Map<string, List<Capture>>
    var lambdaOwners: Map<string, int?>
    var lambdaExprs: Map<string, Expr>
    var collectWrites: bool
    var nextClosure: int
    /// ABI symbols this module declared with `#[symbol("...")]`, recorded as
    /// each top-level callable is registered (the only place the attribute is
    /// still in hand). This is the set the linker hands to `linkExe` as
    /// `progOverrides` so a program definition displaces the archive body of
    /// the same name. It deliberately excludes every compiler-synthesized
    /// symbol (closures `pkl_closure_N`, methods, ctors, trampolines, ...):
    /// those are derived from the emitter's own naming, not from an attribute,
    /// and a symbol like `pkl_closure_0` legitimately exists in both a program
    /// and a runtime member. Reading symbols back off the IR cannot tell the
    /// two apart, which is why the set is captured here instead.
    var overrides: List<string>
var trampFids: Map<int, int>
    var methodTrampFids: Map<string, int>
    var spreadTramps: Map<int, int>
    var fnTramp: Map<string, int>
    var fname: string
    var symbol: string
    var currentSubst: Map<string, Ty>
    var currentFid: int?
    var fnGenerics: List<string>
    var fparams: List<IrParam>
    var fret: IrTy
    var fslots: List<IrTy>
    var env: List<Map<string, int>>
    var manualEnv: List<Map<string, bool>>
    var blocks: List<IrBlock>
    var cur: int
    var nextBlock: int
    var nextTemp: int
    var loops: List<LoopCtx>
var failed: bool
    var iceDepth: int
    var icePath: List<string>
    // ---- exception lowering ---------------------------------------------
    // `finally` bodies owed on the way out of the current block, outermost
    // first. A `return`/`break`/`continue`/`throw` runs them all, innermost
    // last, before it actually leaves.
    var finallys: List<Block>
    // The `catch`es in scope for the code being emitted, innermost last. A
    // `throw` here branches straight to the last one.
    var handlers: List<HandlerCtx>
    // Set while emitting a `finally` on a path that a throw is already
    // travelling down. The pending flag is still set there, so a propagation
    // check would see the throw we are transferring on and divert straight to
    // the handler, skipping the `finally`s that are still owed.
    var inThrowTransfer: bool
    // Pass 1 of two: lower every body with the propagation checks suppressed,
    // purely to record call edges and which bodies contain a `throw`.
    var analyzing: bool
    // `Map<int, bool>` rather than a set: the self-hosted language has no
    // `Set`, and membership is all this needs.
    var directThrow: Map<int, bool>
    var callEdges: Map<int, List<int>>
    var mayThrow: Map<int, bool>
    var progMayThrow: bool
    var currentBuildFid: int?
    // Diagnostics found during pass 1, replayed if pass 2 never runs.
    var suppressed: List<Diagnostic>
    var iceSeq: List<string>

    constructor(prog: Program, resolved: ResolvedProgram, diags: DiagnosticSink, types: Map<string, Ty>) {
        this.prog = prog
        this.resolved = resolved
        this.diags = diags
        this.types = types
        this.irModule = emptyModule()
        this.strIds = emptyStringIntMap()
        this.constsInits = emptyExprMap()
        this.globalIds = emptyStringIntMap()
        this.globalDecls = emptyGlobalDeclMap()
        this.globalFailures = emptyGlobalFailures()
        this.classConsts = emptyClassConstMap()
        this.constInlining = emptyStrs()
        this.fidList = emptyInts()
        this.fsource = emptyFnSourceMap()
        this.finfo = emptyCallableInfoMap()
        this.srcParamTys = emptyIntTyListMap()
        this.fnDecls = emptyFnDeclMap()
        this.instantiations = emptyStringIntMap()
        this.instantonSubst = emptyIntSubstMap()
        this.classes = emptyClassPlans()
        this.classByName = emptyStringIntMap()
        this.classDecls = emptyClassDeclMap()
        this.genericTypeMembers = emptyMemberListMap()
        this.structMembers = emptyMemberListMap()
        this.classInstByArgs = emptyStringIntMap()
        this.classInstSubst = emptyIntSubstMap()
        this.fidOwner = emptyIntIntMap()
        this.fidGenerics = emptyIntStrListMap()
        this.genericCtxName = none
        this.genericFnCtx = none
        this.classAttempted = emptyStrs()
        this.ctorIds = emptyIntIntMap()
        this.namedCtorIds = emptyStringIntMap()
        this.deinitIds = emptyIntIntMap()
        this.methodIds = emptyMethodRefMap()
        this.methodSeq = emptyMethodEntries()
        this.virtualDispatch = emptyDispatchMap()
        this.nextIfaceId = 1
        this.ifaceInstIds = emptyStringIntMap()
        this.ifaceMembers = emptyIfaceMemberMap()
        this.classIfaceBuckets = emptyIfaceBucketMap()
        this.propertyIds = emptyStringIntMap()
        this.staticPropertyIds = emptyStringIntMap()
        this.propertySeq = emptyPropertyEntries()
        this.staticPropSeq = emptyPropertyEntries()
        this.staticInits = emptyStaticInitEntries()
        this.staticInitId = none
        this.globalsInitId = none
        this.managedGlobalInits = emptyManagedGlobalInits()
        this.testSetupId = none
        this.cidSalt = 0
        this.moduleSetupSymbol = ""
        this.extraSetups = emptyStrs()
        this.owner = none
        this.closureTables = emptyClassTableMap()
        this.lambdaFids = emptyStringIntMap()
        this.lambdaCaps = emptyCaptureListMap()
        this.lambdaOwners = emptyStringIntOptMap()
        this.lambdaExprs = emptyExprMap()
        this.collectWrites = false
        this.nextClosure = 0
        this.overrides = emptyStrs()
this.trampFids = emptyIntIntMap()
        this.methodTrampFids = emptyStringIntMap()
        this.spreadTramps = emptyIntIntMap()
        this.fnTramp = emptyStringIntMap()
        this.fname = ""
        this.symbol = ""
        this.currentSubst = emptyStringTyMap()
        this.currentFid = none
        this.fnGenerics = emptyStrs()
        this.fparams = emptyIrParams()
        this.fret = IrTy.Unit
        this.fslots = emptyIrTys()
        this.env = emptyIntScopeMap()
        this.manualEnv = emptyScopeMaps()
        this.blocks = emptyIrBlocks()
        this.cur = 0
        this.nextBlock = 0
        this.nextTemp = 0
        this.loops = emptyLoopCtxs()
this.failed = false
        this.iceDepth = 0
        this.icePath = emptyStrs()
        this.iceSeq = emptyStrs()
        this.finallys = emptyBlocks()
        this.handlers = emptyHandlerCtxs()
        this.inThrowTransfer = false
        this.analyzing = false
        this.directThrow = emptyIntBoolMap()
        this.callEdges = emptyIntIntListMap()
        this.mayThrow = emptyIntBoolMap()
        this.progMayThrow = false
        this.currentBuildFid = none
        this.suppressed = emptyDiagnostics()
    }

    /// Record the initializer of a top-level `const`. Void so the arm of the
    /// registration match stays unit-typed.
fn recordConstInit(name: string, value: Expr) {
   this.constsInits[name] = value
   }

   /// Allocate global ids in source order and push one `IrGlobal` per top-level
   /// `var`. Globals have no body, so this only has to validate the type and
   /// reduce the initializer; failures are recorded and reported once every
   /// body is built, so one bad global does not mask unrelated problems.
   ///
   /// `resolved.globals` is already in source order and carries the resolved
   /// type; `globalDecls` supplies the initializer expression, which the
   /// resolver deliberately does not keep (it is not part of the type surface).
   fn registerGlobals() {
   var next = 0
   for (info in this.resolved.globals) {
   let name = info.name
   if (this.globalIds.has(name)) {
   this.globalFailures.push(GlobalFailure(name, info.span, "top-level `var " + name + "` is declared more than once"))
   continue
   }
   var slot: IrTy? = none
   if (let some(t) = globalIrTy(info.ty)) {
   slot = t
   } else {
   this.globalFailures.push(GlobalFailure(name, info.span, "top-level `var " + name + "` has type `" + tyDbg(info.ty) + "`, which has no global lowering yet"))
   continue
   }
   var decl: GlobalDecl? = none
   if (this.globalDecls.has(name)) {
   decl = this.globalDecls[name]
   }
   if (let some(d) = decl) {
   if (let some(ity) = slot) {
   var res = globalInitBytes(d.value, ity, name)
if (res.err != "") {
    this.globalFailures.push(GlobalFailure(name, info.span, res.err))
    continue
}
let gid = next
     next += 1
     this.globalIds[name] = gid
     this.irModule.globals.push(IrGlobal(globalSymbol(name), ity, hasTypeExpr(d.ty), res.bytes))
if (ity == IrTy.Str || ity == IrTy.Ptr) {
    // A managed initializer is real run-time code, so it may call and allocate,
    // but it may not read another global. `pkl_globals_init` roots every slot
    // before it evaluates any initializer, so every slot is still null while
    // initializers run; reject the read here rather than hand back a null
    // dereference.
    //
    // The slot and its id are registered above, before this check, exactly as on
    // the native path. A rejected global is still a declared global, so a later
    // read of it must not turn into a second, misleading "not lowered yet"
    // diagnostic -- only the root cause should be reported.
    if (let some(other) = this.globalInitReadsGlobal(d.value)) {
        this.globalFailures.push(GlobalFailure(name, info.span,
            "the initializer of top-level `var " + name + "` reads `" + other + "`, but global initializers run after every slot is rooted and before any is filled, so it would read a null value"))
        continue
    }
        this.managedGlobalInits.push(ManagedGlobalInit(gid, ity, d.value))
     }
   }
   } else {
   this.globalFailures.push(GlobalFailure(name, info.span, "top-level `var " + name + "` has no initializer"))
   continue
   }
   }
   }

    /// Name of the first top-level global this initializer reads, if any.
    ///
    /// `pkl_globals_init` roots every managed slot before it evaluates any
    /// initializer, because an initializer is the first code that can allocate and
    /// therefore the first point at which the collector could run. That ordering
    /// also means every slot is still null while initializers run, so an
    /// initializer that reads another global would dereference null. Catching it
    /// here is the only way to keep it out of the generated program.
    ///
    /// A bare `Ident` counts only when it names a top-level `var`. Anything the
    /// resolver cannot resolve is already reported as an undefined name, and a
    /// local cannot appear in a global initializer.
    ///
    /// Mirrors `Emitter::global_init_reads_global` in emit.rs.
    fn globalInitReadsGlobal(e: Expr): string? {
        var found: string? = none
        match (e.kind) {
            case ExprKind.Ident(name) -> {
                if (this.globalDecls.has(name)) {
                    found = name
                }
            }
            case ExprKind.Lit(_) -> {}
            case ExprKind.This -> {}
            case ExprKind.Super -> {}
            case ExprKind.Call(callee, args) -> {
                found = this.globalInitReadsGlobal(callee)
                if (isNoneStr(found)) {
                    found = this.callArgsReadGlobal(args)
                }
            }
            case ExprKind.Member(object, _) -> found = this.globalInitReadsGlobal(object)
            case ExprKind.OptAccess(object, _) -> found = this.globalInitReadsGlobal(object)
            case ExprKind.Index(object, index) -> {
                found = this.globalInitReadsGlobal(object)
                if (isNoneStr(found)) {
                    found = this.globalInitReadsGlobal(index)
                }
            }
            case ExprKind.Unary(_, operand) -> found = this.globalInitReadsGlobal(operand)
            case ExprKind.Await(inner) -> found = this.globalInitReadsGlobal(inner)
            case ExprKind.Cast(expr, _, _) -> found = this.globalInitReadsGlobal(expr)
            case ExprKind.OptUnwrap(inner) -> found = this.globalInitReadsGlobal(inner)
            case ExprKind.Binary(_, lhs, rhs) -> {
                found = this.globalInitReadsGlobal(lhs)
                if (isNoneStr(found)) {
                    found = this.globalInitReadsGlobal(rhs)
                }
            }
            case ExprKind.Range(start, end, _) -> {
                found = this.globalInitReadsGlobal(start)
                if (isNoneStr(found)) {
                    found = this.globalInitReadsGlobal(end)
                }
            }
            case ExprKind.Assign(target, _, value) -> {
                found = this.globalInitReadsGlobal(target)
                if (isNoneStr(found)) {
                    found = this.globalInitReadsGlobal(value)
                }
            }
            case ExprKind.If(cond, then, elseElse) -> {
                found = this.ifCondReadsGlobal(cond)
                if (isNoneStr(found)) {
                    found = this.blockReadsGlobal(then)
                }
                if (isNoneStr(found)) {
                    found = this.globalInitReadsGlobalOpt(elseElse)
                }
            }
            case ExprKind.Match(scrutinee, arms) -> {
                found = this.globalInitReadsGlobal(scrutinee)
                if (isNoneStr(found)) {
                    for (arm in arms) {
                        found = this.globalInitReadsGlobalOpt(arm.guard)
                        if (isNoneStr(found)) {
                            found = this.globalInitReadsGlobal(arm.body)
                        }
                        if (!isNoneStr(found)) {
                            break
                        }
                    }
                }
            }
            case ExprKind.Block(b) -> found = this.blockReadsGlobal(b)
            case ExprKind.Unsafe(b) -> found = this.blockReadsGlobal(b)
            case ExprKind.Array(parts) -> {
                for (p in parts) {
                    found = this.globalInitReadsGlobal(p)
                    if (!isNoneStr(found)) {
                        break
                    }
                }
            }
            case ExprKind.Tuple(parts) -> {
                for (p in parts) {
                    found = this.globalInitReadsGlobal(p)
                    if (!isNoneStr(found)) {
                        break
                    }
                }
            }
            case ExprKind.Map(entries) -> {
                for (en in entries) {
                    found = this.globalInitReadsGlobal(en.key)
                    if (isNoneStr(found)) {
                        found = this.globalInitReadsGlobal(en.value)
                    }
                    if (!isNoneStr(found)) {
                        break
                    }
                }
            }
            // A lambda body is a separate function: it cannot run during global
            // initialization, so nothing in it can observe an unfilled slot. A
            // module-scope lambda cannot capture a global either -- `decideCaptures`
            // rejects that -- so no global read can hide in here. The `GenericCall`
            // name is a top-level `fn`, not a `var`.
            case ExprKind.Lambda(_, _, _, _) -> {}
            case ExprKind.GenericCall(_, _) -> {}
        }
        return found
    }

    fn globalInitReadsGlobalOpt(e: Expr?): string? {
        if (let some(inner) = e) {
            return this.globalInitReadsGlobal(inner)
        }
        return none
    }

    fn ifCondReadsGlobal(cond: IfCond): string? {
        match (cond) {
            case IfCond.Cond(e) -> this.globalInitReadsGlobal(e)
            case IfCond.Binding(_, value) -> this.globalInitReadsGlobal(value)
        }
    }

    fn callArgsReadGlobal(args: List<CallArg>): string? {
        var found: string? = none
        for (a in args) {
            found = this.globalInitReadsGlobal(a.value)
            if (!isNoneStr(found)) {
                break
            }
        }
        return found
    }

    fn blockReadsGlobal(b: Block): string? {
        var found: string? = none
        for (st in b.stmts) {
            found = this.stmtReadsGlobal(st)
            if (!isNoneStr(found)) {
                break
            }
        }
        if (isNoneStr(found)) {
            found = this.globalInitReadsGlobalOpt(b.expr)
        }
        return found
    }

    fn blockReadsGlobalOpt(b: Block?): string? {
        if (let some(inner) = b) {
            return this.blockReadsGlobal(inner)
        }
        return none
    }

    fn stmtReadsGlobal(st: Stmt): string? {
        match (st) {
            case Stmt.Let(_, _, init, _, _) -> this.globalInitReadsGlobalOpt(init)
            case Stmt.Const(_, _, value, _) -> this.globalInitReadsGlobal(value)
            case Stmt.Expr(e) -> this.globalInitReadsGlobal(e)
            case Stmt.Return(value, _) -> this.globalInitReadsGlobalOpt(value)
            case Stmt.Throw(value, _) -> this.globalInitReadsGlobal(value)
            case Stmt.While(cond, body, _) -> {
                var found = this.globalInitReadsGlobal(cond)
                if (isNoneStr(found)) {
                    found = this.blockReadsGlobal(body)
                }
                found
            }
            case Stmt.For(header, body, _) -> {
                var found = this.forHeaderReadsGlobal(header)
                if (isNoneStr(found)) {
                    found = this.blockReadsGlobal(body)
                }
                found
            }
            case Stmt.Try(body, _, handler, fin, _) -> {
                var found = this.blockReadsGlobal(body)
                if (isNoneStr(found)) {
                    found = this.blockReadsGlobalOpt(handler)
                }
                if (isNoneStr(found)) {
                    found = this.blockReadsGlobalOpt(fin)
                }
                found
            }
            case Stmt.Break(_) -> none
            case Stmt.Continue(_) -> none
            case Stmt.Empty(_) -> none
        }
    }

    fn forHeaderReadsGlobal(header: ForHeader): string? {
        match (header) {
            case ForHeader.In(_, sequence) -> this.globalInitReadsGlobal(sequence)
            case ForHeader.Range(init, cond, step) -> {
                var found = this.stmtReadsGlobal(init)
                if (isNoneStr(found)) {
                    found = this.globalInitReadsGlobal(cond)
                }
                if (isNoneStr(found)) {
                    found = this.globalInitReadsGlobal(step)
                }
                found
            }
        }
    }

    fn recordFnDecl(name: string, f: FnDecl) {
        this.fnDecls[name] = f
    }

    fn recordClassDecl(name: string, c: ClassDecl) {
        this.classDecls[name] = c
    }

    /// Register functions, classes, structs, and enums in source order, and
    /// then build all their bodies. Mirrors `Emitter::emit()` in emit.rs.
fn emit() {
             // A well-formed integer literal that does not fit i64. Parsing
             // degrades such a literal to 0, so this is the only thing standing
             // between an out-of-range literal and a silently wrong constant.
             // The Rust emitter rejects it in `lit`, where the literal's own span
             // is out of reach, hence the zero span; bail before emitting anything
             // so a rejected module never reaches the linker.
             if (this.prog.intLiteralOverflow) {
                 this.bad(Span(0, 0), "integer literal out of range for i64")
                 return
             }
             for (item in this.prog.items) {
               match (item.kind) {
                   case ItemKind.Global(g) -> this.globalDecls[g.name] = g
                   case _ -> {}
               }
           }
           this.registerGlobals()
           for (item in this.prog.items) {
               match (item.kind) {
                   case ItemKind.Const(c) -> this.recordConstInit(c.name, c.value)
                   case ItemKind.Fn(f) -> this.recordFnDecl(f.name, f)
                   case ItemKind.Test(f) -> this.recordFnDecl(f.name, f)
                   case ItemKind.Class(c) -> this.recordClassDecl(c.name, c)
                   case _ -> {}
               }
           }
        for (item in this.prog.items) {
            var itName = "?"
            match (item.kind) {
                case ItemKind.Fn(f) -> {
                    itName = f.name
                    this.registerFn(f, false, item.attrs)
                }
                case ItemKind.Test(f) -> {
                    itName = f.name
                    this.registerFn(f, true, item.attrs)
                }
                case ItemKind.Class(c) -> {
                    itName = c.name
                    this.registerClassByName(c.name)
                }
                case ItemKind.Struct(s) -> this.registerStructItem(s)
                case _ -> {}
            }
            if (this.failed) {
                break
            }
        }
        // Every class is now registered. Discover which instance methods are
        // overridden so calls through ancestor-typed receivers can route them
        // on the runtime class id.
        this.buildVirtualDispatch()
        // Static fields are initialized once at program start. Register the
        // initializer only after every class id is assigned.
        if (!(len(this.staticInits) == 0)) {
            var inits = this.staticInits
this.staticInits = emptyStaticInitEntries()
            this.staticInitId = this.pushClassFunc("static.init", "pkl_static_init", FnSource.StaticInit(inits))
        }
        // Managed top-level `var`s have no static bytes. Register every slot as a
        // GC root first, then store each initializer, because an initializer is
        // the first code that can allocate.
        if (!(len(this.managedGlobalInits) == 0)) {
            var ginits = this.managedGlobalInits
            this.managedGlobalInits = emptyManagedGlobalInits()
            this.globalsInitId = this.pushClassFunc("globals.init", "pkl_globals_init", FnSource.GlobalsInit(ginits))
        }
        // Test modules have no `main`, so the class-registration preamble
        // cannot ride on one; synthesize `pkl_test_setup` when there is
        // anything to set up.
        var hasTests = false
        for (item in this.prog.items) {
            match (item.kind) {
                case ItemKind.Test(_) -> hasTests = true
                case _ -> {}
            }
        }
        if (hasTests && (!(len(this.classes) == 0) || isSomeInt(this.staticInitId) || isSomeInt(this.globalsInitId))) {
            this.testSetupId = this.pushClassFunc("test.setup", "pkl_test_setup", FnSource.TestSetup)
        }
        // A split-linked module (a runtime member with no `main`) still needs
        // its registration/globals/static preamble callable from the linking
        // program. The symbol is created even when there is nothing to set up
        // so references to it always bind; the body early-returns empty.
        if (!(this.moduleSetupSymbol == "")) {
            this.pushClassFunc("module.setup", this.moduleSetupSymbol, FnSource.TestSetup)
        }
        this.registerLambdas()
        // Instantiated generic functions are registered lazily while their
        // callers compile, so keep consuming newly-appended function ids.
        //
        // Pass 1: lower every body with the propagation checks suppressed, purely
        // to record which function calls which and which bodies contain a `throw`
        // of their own. Pass 2 re-runs the same loop for real. `buildFunc`
        // replaces each function entry wholesale and every cache that hands out a
        // `FuncId` is keyed, so re-running over the same ids overwrites pass 1
        // cleanly instead of appending to it.
        this.analyzing = true
        this.buildAll()
        this.analyzing = false
        if (this.failed) {
            // Nothing to re-lower: report what the analysis pass found.
            for (d in this.suppressed) {
                this.diags.emit(d)
            }
            this.suppressed = emptyDiagnostics()
            return
        }
        this.suppressed = emptyDiagnostics()
        this.progMayThrow = len(this.directThrow.keys()) > 0
        if (this.progMayThrow) {
            this.solveMayThrow()
        }
        this.buildAll()
    }

    /// Lower every registered function body, including any registered lazily by
    /// an earlier one.
    fn buildAll() {
        var ix = 0
        while (ix < len(this.fidList)) {
            var fid = this.fidList[ix]
            this.buildFunc(fid)
            ix = ix + 1
        }
    }

    // ---- registration ----

    /// Record one instance/static method definition, first-wins (mirrors the
    /// `or_insert` used for `method_ids` in Rust), and append the walked method
    /// table so `build_virtual_dispatch` can iterate every receiver entry.
    fn methodDef(cid: int, mname: string, fid: int, isStatic: bool) {
        var key = pairKey(str(cid), mname)
        if (!this.methodIds.has(key)) {
            this.methodIds[key] = MethodRef(fid, isStatic)
            this.methodSeq.push(MethodEntry(cid, mname, fid, isStatic))
        }
    }

    /// Register a top-level function (or test) that has an unambiguous user
    /// callable and fully low-level parameter/return types. Mirrors
    /// `register_fn` in emit.rs.
    fn registerFn(f: FnDecl, isTest: bool, attrs: List<Attribute>) -> bool {
        if (!(len(f.generics) == 0)) {
            return false
        }
        var hasDefaultOrRest = false
        for (p in f.params) {
            if (p.rest) {
                hasDefaultOrRest = true
            } else if (let none = p.default) {
                // no default value
            } else {
                hasDefaultOrRest = true
            }
        }
        if (hasDefaultOrRest) {
            return false
        }
        if (let some(info) = this.userCallable(f.name)) {
            var okParams = true
            for (p in info.params) {
                if (let none = this.mapTy(p.ty, f.span)) {
                    okParams = false
                }
            }
            var okRet = true
            if (let none = this.mapTy(info.ret, f.span)) {
                okRet = false
            }
            if (!okParams || !okRet) {
                return false
            }
            if (f.isAsync) {
                this.registerAsyncFn(f, isTest, attrs, info)
                return true
            }
            var fid = len(this.irModule.funcs)
            var symbol = this.symbolForAttrs(f.name, isTest, attrs)
            this.irModule.funcsByName[f.name] = fid
            this.irModule.funcs.push(IrFunc(f.name, symbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), !isTest && f.name == "main", isTest, itemTags(attrs)))
            this.fidList.push(fid)
            this.fsource[fid] = FnSource.TopLevel(f)
            this.finfo[fid] = info
            var stys = emptyTys()
            for (p in info.params) {
                stys.push(p.ty)
            }
            this.srcParamTys[fid] = stys
            return true
        }
        false
    }

    /// Register an `async fn` as two lowerable functions:
    ///
    ///   * the hidden future body Ã¢â‚¬â€ a 0-arg hoisted body with the lambda ABI
    ///     (`env` = closure object), whose closure slots 1..N snapshot each of
    ///     the async fn's parameters under its own name; and
    ///   * the visible wrapper Ã¢â‚¬â€ a normal module function with the async fn's
    ///     real ABI that allocates that closure and returns it. Calling it runs
    ///     no user code; the body runs only when `await` drives the future's
    ///     0-arg call.
    ///
    /// The hidden entry is registered first so the wrapper can name it.
    /// Mirrors `register_async_fn` in emit.rs.
    fn registerAsyncFn(f: FnDecl, isTest: bool, attrs: List<Attribute>, info: CallableInfo) {
        var symbol = this.symbolForAttrs(f.name, isTest, attrs)
        var hiddenName = f.name + "__future"
        var hiddenSymbol = symbol + "__future"
        var hidden = len(this.irModule.funcs)
        this.irModule.funcsByName[hiddenName] = hidden
        this.irModule.funcs.push(IrFunc(hiddenName, hiddenSymbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), false, false, emptyStrs()))
        this.fidList.push(hidden)
        var htys = emptyTys()
        for (p in info.params) {
            htys.push(p.ty)
        }
        this.fsource[hidden] = FnSource.AsyncBody(f, htys, info.ret)
        var hiddenInfo = CallableInfo(info.name, info.span, info.visibility, info.isAsync, info.isStatic, info.isOverride, info.isAbstract, info.operator, info.generics, emptyParamInfos(), info.ret)
        this.finfo[hidden] = hiddenInfo
        var wfid = len(this.irModule.funcs)
        this.irModule.funcsByName[f.name] = wfid
        this.irModule.funcs.push(IrFunc(f.name, symbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), !isTest && f.name == "main", isTest, itemTags(attrs)))
        this.fidList.push(wfid)
        this.fsource[wfid] = FnSource.AsyncFn(f, hidden)
        this.finfo[wfid] = info
        var stys = emptyTys()
        for (p in info.params) {
            stys.push(p.ty)
        }
        this.srcParamTys[wfid] = stys
    }

    /// Register an `async` method as two lowerable functions, mirroring
    /// `register_async_fn` for methods:
    ///
    ///   * the hidden future body, whose closure slots hold the receiver
    ///     (`this`, instance methods) followed by the parameters; and
    ///   * the visible wrapper Ã¢â‚¬â€ the method itself Ã¢â‚¬â€ with the method's real ABI
    ///     (receiver-first for instance methods), allocating that closure and
    ///     returning it. `methodIds` maps the method name to the wrapper, so
    ///     instance/static calls and (via inheritance + virtual dispatch)
    ///     overrides dispatch exactly like regular methods.
    ///
    /// `thisTy` is the instantiated receiver type (`None` for static), `suffix`
    /// disambiguates generic-class instantiation symbols, and `map` carries the
    /// substitution when the receiver class is a generic instantiation.
    /// Mirrors `register_async_method` in emit.rs.
    fn registerAsyncMethod(cname: string, table: ClassTable, md: MethodDecl, info: CallableInfo, cid: int, args: List<Ty>, isStruct: bool, suffix: string, map: Map<string, Ty>?) {
        var thisTy: Ty? = none
        if (!info.isStatic) {
            if (isStruct) {
                thisTy = Ty.Struct(cname, args)
            } else {
                thisTy = Ty.Class(cname, args)
            }
        }
        var pty = emptyTys()
        if (let some(t) = thisTy) {
            pty.push(t)
        }
        for (p in info.params) {
            pty.push(p.ty)
        }
        var stem = ""
        if (info.isStatic) {
            stem = "pkl_" + cname + "_sm_" + md.name
        } else {
            stem = "pkl_" + cname + "_" + md.name
        }
        var hidden = this.pushClassFunc(cname + "." + md.name + ".future", stem + suffix + "__future", FnSource.AsyncMethodBody(table, md, pty, info.ret, info.isStatic))
        var hiddenInfo = CallableInfo(info.name, info.span, info.visibility, info.isAsync, info.isStatic, info.isOverride, info.isAbstract, info.operator, info.generics, emptyParamInfos(), info.ret)
        this.finfo[hidden] = hiddenInfo
        this.fidOwner[hidden] = cid
        if (let some(s) = map) {
            this.instantonSubst[hidden] = s
            this.fidGenerics[hidden] = table.generics
        }
        var wfid = this.pushClassFunc(cname + "." + md.name, stem + suffix, FnSource.AsyncMethod(table, md, hidden, info.isStatic, thisTy))
        this.finfo[wfid] = info
        var stys = emptyTys()
        for (p in info.params) {
            stys.push(p.ty)
        }
        this.srcParamTys[wfid] = stys
        this.methodDef(cid, md.name, wfid, info.isStatic)
        this.fidOwner[wfid] = cid
        if (let some(s) = map) {
            this.instantonSubst[wfid] = s
            this.fidGenerics[wfid] = table.generics
        }
    }


    /// Register a class and, first, its ancestors, so a superclass always has a
    /// lower class id than its subclasses. Mirrors `register_class_by_name`.
    fn registerClassByName(name: string) -> bool {
        if (hasStr(this.classAttempted, name)) {
            return false
        }
        this.classAttempted.push(name)
        if (let some(decl) = this.classDecls.get(name)) {
            if (let some(table) = this.classEntry(name)) {
                if (let some(ext) = table.extends) {
                    if (let some(p) = named(ext)) {
                        if (this.classDecls.has(p)) {
                            this.registerClassByName(p)
                        }
                    }
                }
                this.maybeRegisterClass(name, decl.members, table, decl.span)
                return true
            }
        }
        false
    }

    /// The resolver's `ClassTable` for a class name (classes only, not
    /// structs ???????? the caller has already looked the decl up).
    fn classEntry(name: string) -> ClassTable? {
        if (let some(entry) = this.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    return t
                }
                case _ -> {}
            }
        }
        none
    }

    /// Register a struct (structs have no inheritance, so no ancestor walk).
    /// Mirrors `register_struct_item` in emit.rs.
    fn registerStructItem(s: StructDecl) -> bool {
        this.structMembers[s.name] = s.members
        if (let some(entry) = this.resolved.types.get(s.name)) {
            match (entry) {
                case TypeTableEntry.Struct(t) -> this.maybeRegisterClass(s.name, s.members, t, s.span)
                case _ -> {}
            }
        }
        true
    }

    /// Build the class/struct table for `name` from the resolver, or from the
    /// emitter's own tables for synthetic/generic plans. Mirrors `table_of`.
    fn tableOf(name: string) -> ClassTable? {
        if (let some(entry) = this.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    return t
                }
                case TypeTableEntry.Struct(t) -> {
                    return t
                }
                case _ -> {}
            }
        }
        for (p in this.classes) {
            if (p.name == name) {
                return p.table
            }
        }
        if (this.closureTables.has(name)) {
            return this.closureTables.get(name)
        }
        none
    }

    /// The superclass name of `name`, when it extends another class.
    fn parentName(name: string) -> string? {
        if (let some(t) = this.tableOf(name)) {
            if (let some(ext) = t.extends) {
                return named(ext)
            }
        }
        none
    }

    /// Ancestry from the rootmost superclass down to `name` inclusive.
    fn ancestry(name: string) -> List<string> {
        var chain = [name]
        var cur = name
        var guard = 0
        while (guard < 64) {
            guard = guard + 1
            if (let some(p) = this.parentName(cur)) {
                chain.push(p)
                cur = p
            } else {
                break
            }
        }
        var reversed = emptyStrs()
        var i = len(chain) - 1
        while (i >= 0) {
            reversed.push(chain[i])
            i = i - 1
        }
        reversed
    }

    /// True when `anc` is `desc` itself or one of its ancestors.
    fn isAncestor(anc: string, desc: string) -> bool {
        var chain = this.ancestry(desc)
        var i = 0
        while (i < len(chain)) {
            if (chain[i] == anc) {
                return true
            }
            i = i + 1
        }
        false
    }




    /// Discover every instance method overridden somewhere in the program and
    /// record, per static receiver class, the descendant classes that provide a
    /// different implementation (deepest-derived first). Mirrors
    /// `build_virtual_dispatch` in emit.rs.
    fn buildVirtualDispatch() {
        var visible: Map<int, List<NamedFid>> = emptyNamedFidMap()
        for (me in this.methodSeq) {
            if (!me.isStatic) {
                if (let some(l) = visible.get(me.cid)) {
                    l.push(NamedFid(me.name, me.fid))
                } else {
                    var nf = [NamedFid(me.name, me.fid)]
                    visible[me.cid] = nf
                }
            }
        }
        var mixedCname = ""
        var mixedMname = ""
        for (p in this.classes) {
            if (let none = visible.get(p.classId)) {
                continue
            }
            if (let some(names) = visible.get(p.classId)) {
                for (nm in names) {
                    var branches = emptyDispatchDepths()
                    for (d in this.classes) {
                        if (d.classId == p.classId) {
                            continue
                        }
                        if (!this.isAncestor(p.name, d.name)) {
                            continue
                        }
                        if (let some(dt) = this.tableOf(d.name)) {
                            if (hasMethodName(dt, nm.name)) {
                                if (let some(mr) = this.methodIds.get(pairKey(str(d.classId), nm.name))) {
                                    if (mr.isStatic) {
                                        if (mixedCname == "") {
                                            mixedCname = d.name
                                            mixedMname = nm.name
                                        }
                                    } else if (!(mr.fid == nm.fid)) {
                                        var depth = chainDepth(this.ancestry(d.name), p.name)
                                        branches.push(DispatchBranchDepth(d.classId, depth, mr.fid))
                                    }
                                }
                            }
                        }
                    }
                    if (len(branches) == 0) {
                        continue
                    }
                    sortBranches(branches)
                    var db = emptyDispatchBranches()
                    for (b in branches) {
                        db.push(DispatchBranch(b.dcid, b.dfid))
                    }
                    this.virtualDispatch[pairKey(str(p.classId), nm.name)] = db
                }
            }
        }
        if (!(mixedCname == "")) {
            if (let some(sp) = this.classDecls.get(mixedCname)) {
                this.bad(sp.span, "`override` mixing static and instance methods (`" + mixedCname + "." + mixedMname + "`) is not lowered yet")
            } else {
                this.bad(Span(0, 0), "`override` mixing static and instance methods (`" + mixedCname + "." + mixedMname + "`) is not lowered yet")
            }
        }
    }

    /// Record one property-accessor definition (instanced), first-wins, and
    /// append it to the walked table so superclass slots can be inherited.
    fn propDef(cid: int, name: string, isSet: bool, fid: int) {
        var key = tripleKey(str(cid), name, str(isSet))
        if (!this.propertyIds.has(key)) {
            this.propertyIds[key] = fid
            this.propertySeq.push(PropertyEntry(cid, name, isSet, fid))
        }
    }

    /// Record one static property-accessor definition, first-wins, and append
    /// it to the walked table.
    fn staticPropDef(cid: int, name: string, isSet: bool, fid: int) {
        var key = tripleKey(str(cid), name, str(isSet))
        if (!this.staticPropertyIds.has(key)) {
            this.staticPropertyIds[key] = fid
            this.staticPropSeq.push(PropertyEntry(cid, name, isSet, fid))
        }
    }

    /// A class/struct's own (non-inherited) instance fields.
    fn ownInstanceFields(name: string) -> List<FieldInfo> {
        if (let some(t) = this.tableOf(name)) {
            var out = emptyFieldInfos()
            for (f in t.fields) {
                if (!f.isStatic) {
                    out.push(f)
                }
            }
            out
        } else {
            emptyFieldInfos()
        }
    }


    /// Instance-field initializers for `name` and its ancestors, root first,
    /// recorded at absolute slot numbers.
    fn collectInstanceInits(name: string) -> List<SlotInit> {
        var out = emptySlotInits()
        var base = 0
        for (cname in this.ancestry(name)) {
            var own = this.ownInstanceFields(cname)
            var decl = planName(cname)
            var members: List<ClassMember>? = none
            if (let some(d) = this.classDecls.get(decl)) {
                members = d.members
            } else if (this.structMembers.has(decl)) {
                members = this.structMembers.get(decl)
            }
            if (let some(ms) = members) {
                for (m in ms) {
                    match (m) {
                        case ClassMember.Field(fname, ty, init, vis, isSt, isCn, attrs, fspan) -> {
                            if (!isSt) {
                                if (let some(x) = init) {
                                    var i = 0
                                    var found = false
                                    while (i < len(own)) {
                                        if (own[i].name == fname) {
                                            found = true
                                            break
                                        }
                                        i = i + 1
                                    }
                                    if (found) {
                                        out.push(SlotInit(base + i, x))
                                    }
                                }
                            }
                        }
                        case _ -> {}
                    }
                }
            }
            base = base + len(own)
        }
        out
    }

    /// `init` blocks for `name` and its ancestors, root first.
    fn collectInitBlocks(name: string) -> List<Block> {
        var out = emptyBlocks()
        for (cname in this.ancestry(name)) {
            var decl = planName(cname)
            var members: List<ClassMember>? = none
            if (let some(d) = this.classDecls.get(decl)) {
                members = d.members
            } else if (this.structMembers.has(decl)) {
                members = this.structMembers.get(decl)
            }
            if (let some(ms) = members) {
                for (m in ms) {
                    match (m) {
                        case ClassMember.Init(b) -> out.push(b)
                        case _ -> {}
                    }
                }
            }
        }
        out
    }

    /// Resolve an interface instantiation `name<args>` to its runtime id,
    /// assigning a fresh one on first use and recording its member plan.
    fn ifaceIdFor(name: string, args: List<Ty>, span: Span) -> int? {
        var key = instKey(name, args)
        if (let some(id) = this.ifaceInstIds.get(key)) {
            return id
        }
        var iface: InterfaceTable? = none
        if (let some(entry) = this.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Interface(t) -> iface = t
                case _ -> {}
            }
        }
        if (let some(t) = iface) {
            var id = this.nextIfaceId
            this.nextIfaceId = this.nextIfaceId + 1
            if (!this.ifaceMembers.has(id)) {
                var plan = emptyIfaceMemberList()
                var mi = 0
                for (m in t.members) {
                    if (!m.isProperty) {
                        plan.push(IfaceMember(m.name, mi))
                        mi = mi + 1
                    }
                }
                this.ifaceMembers[id] = plan
            }
            this.ifaceInstIds[key] = id
            return id
        }
        this.bad(span, "`" + name + "` is not an interface")
        none
    }

    /// Record a class's own `implements` declarations into its runtime bucket.
    fn registerImplements(cname: string, cid: int, ifaces: List<Ty>, span: Span) -> bool {
        for (t in ifaces) {
            if (let some(ir) = ifaceOf(t)) {
                if (let some(id) = this.ifaceIdFor(ir.name, ir.args, span)) {
                    var slots = emptyDispatchBranches()
                    var members = this.ifaceMembers.get(id)
                    if (let some(ms) = members) {
                        for (m in ms) {
                            if (let some(mr) = this.methodIds.get(pairKey(str(cid), m.name))) {
                                if (mr.isStatic) {
                                    this.bad(span, "interface method `" + m.name + "` must be an instance method on `" + cname + "`")
                                    return false
                                }
                                slots.push(DispatchBranch(m.index, mr.fid))
                            } else {
                                this.bad(span, "`" + cname + "` implements `" + ir.name + "` but has no method `" + m.name + "`")
                                return false
                            }
                        }
                    }
                    if (let some(b) = this.classIfaceBuckets.get(cid)) {
                        b.push(IfaceBucket(id, slots))
                    } else {
                        this.classIfaceBuckets[cid] = [IfaceBucket(id, slots)]
                    }
                } else {
                    return false
                }
            } else {
                this.bad(span, "`" + cname + "` declares `implements` on a non-interface type `" + bareName(t) + "`")
                return false
            }
        }
        true
    }

    /// Lower a class/struct into a `ClassPlan`, recursively building its
    /// constructors, methods, and property accessors. Mirrors
    /// `maybe_register_class` in emit.rs.
    fn maybeRegisterClass(name: string, members: List<ClassMember>, table: ClassTable, span: Span) -> bool {
        if (!(len(table.generics) == 0)) {
            this.genericTypeMembers[name] = members
            return true
        }
        var parent: string? = none
        if (let some(ext) = table.extends) {
            if (let some(nm) = named(ext)) {
                parent = nm
            }
        }
        var parentCid: int? = none
        if (let some(p) = parent) {
            if (let some(pcid) = this.classByName.get(p)) {
                parentCid = pcid
            } else {
                return true
            }
        }
        var parentMsg = ""
        if (let some(p) = parent) {
            parentMsg = p
        }
        var ctorDecl: ConstructorDecl? = none
        for (m in members) {
            match (m) {
                case ClassMember.Constructor(c) -> {
                    if (let none = c.name) {
                        ctorDecl = c
                    }
                }
                case _ -> {}
            }
        }
        var parentExplicit = false
        if (let some(p) = parent) {
            if (let some(pt) = this.tableOf(p)) {
                if (let some(_) = pt.ctor) {
                    parentExplicit = true
                }
            }
        }
        if (let some(cd) = ctorDecl) {
            if (parentExplicit) {
                if (let none = ctorSuperDelegation(cd.body)) {
                    this.bad(cd.span, "`" + name + "` constructor must call `super(...)` first to chain into `" + parentMsg + "`")
                    return false
                }
            }
        }
        var inits = this.collectInstanceInits(name)
        var initBlocks = this.collectInitBlocks(name)
        var deinitBlock: Block? = none
        for (m in members) {
            match (m) {
                case ClassMember.Deinit(b) -> deinitBlock = b
                case _ -> {}
            }
        }
        var statics = emptyStaticSlotInits()
        for (f in table.fields) {
            if (f.isStatic) {
                if (let some(slot) = staticFieldSlot(table, f.name)) {
                    var init: Expr? = none
                    for (m in members) {
                        match (m) {
                            case ClassMember.Field(fname, ty, finit, vis, isSt, isCn, attrs, fspan) -> {
                                if (isSt && fname == f.name) {
                                    init = finit
                                }
                            }
                            case _ -> {}
                        }
                    }
                    statics.push(StaticSlotInit(slot, init))
                }
            }
        }
        var cid = PICKLE_CLASS_USER_BASE + this.cidSalt + len(this.classes)
        for (si in statics) {
            this.staticInits.push(StaticInitEntry(cid, si.slot, si.value))
        }
        for (f in table.consts) {
            var value: Expr? = none
            for (m in members) {
                match (m) {
                    case ClassMember.Const(cname, cvis, cty, cvalue, cspan) -> {
                        if (cname == f.name) {
                            value = cvalue
                        }
                    }
                    case _ -> {}
                }
            }
            if (let some(v) = value) {
                this.classConsts[pairKey(str(cid), f.name)] = ClassConst(f, v)
            }
        }
        var ctorFid = this.pushClassFunc(name + ".new", "pkl_" + name + "_new", FnSource.Ctor(table, inits, initBlocks, ctorDecl))
        this.ctorIds[cid] = ctorFid
        var ctorParams = emptyTys()
        if (let some(c) = table.ctor) {
            for (p in c.params) {
                ctorParams.push(p.ty)
            }
        }
        this.srcParamTys[ctorFid] = ctorParams
        for (m in members) {
            match (m) {
                case ClassMember.Constructor(c) -> {
                    if (let some(cname) = c.name) {
                        var fid = this.pushClassFunc(name + "." + cname, "pkl_" + name + "_nc_" + cname, FnSource.NamedCtor(table, c))
                        this.namedCtorIds[pairKey(str(cid), cname)] = fid
                        var ncinfo: NamedCtorInfo? = none
                        for (nc in table.namedCtors) {
                            if (nc.name == cname) {
                                ncinfo = nc
                            }
                        }
                        var ps = emptyTys()
                        if (let some(cinfo) = ncinfo) {
                            for (p in cinfo.ctor.params) {
                                ps.push(p.ty)
                            }
                        }
                        this.srcParamTys[fid] = ps
                    }
                }
                case _ -> {}
            }
        }
        if (let some(body) = deinitBlock) {
            var fid = this.pushClassFunc(name + ".deinit", "pkl_" + name + "_deinit", FnSource.Deinit(table, body))
            this.deinitIds[cid] = fid
        }
        for (m in members) {
            match (m) {
                case ClassMember.Method(md) -> {
                    var noBody = false
                    if (let none = md.body) {
                        noBody = true
                    }
                    if (noBody || !(len(md.generics) == 0)) {
                        continue
                    }
                    var info: CallableInfo? = none
                    for (i in table.methods) {
                        if (i.name == md.name) {
                            info = i
                        }
                    }
                    if (let none = info) {
                        continue
                    }
                    if (let some(inf) = info) {
                        var skip = false
                        for (p in inf.params) {
                            if (p.hasDefault || p.rest) {
                                skip = true
                            }
                        }
                        if (skip) {
                            continue
                        }
                        if (md.isAsync) {
                            this.registerAsyncMethod(name, table, md, inf, cid, emptyTys(), false, "", none)
                            continue
                        }
                        var symbol = ""
                        if (inf.isStatic) {
                            symbol = "pkl_" + name + "_sm_" + md.name
                        } else {
                            symbol = "pkl_" + name + "_" + md.name
                        }
                        var mid = this.pushClassFunc(name + "." + md.name, symbol, FnSource.Method(table, md))
                        this.finfo[mid] = inf
                        var ps = emptyTys()
                        for (p in inf.params) {
                            ps.push(p.ty)
                        }
                        this.srcParamTys[mid] = ps
                        this.methodDef(cid, md.name, mid, inf.isStatic)
                    }
                }
                case _ -> {}
            }
        }
        for (m in members) {
            match (m) {
                case ClassMember.Property(pd) -> {
                    var info: PropertyInfo? = none
                    for (i in table.properties) {
                        if (i.name == pd.name) {
                            info = i
                        }
                    }
                    if (let none = info) {
                        continue
                    }
                    if (let some(pinf) = info) {
                        var stem = ""
                        if (pd.isStatic) {
                            stem = "pkl_" + name + "_sm_" + pd.name + "_"
                        } else {
                            stem = "pkl_" + name + "_" + pd.name + "_"
                        }
                        if (pinf.hasGet) {
                            var fid = this.pushClassFunc(name + "." + pd.name + ".get", stem + "get", FnSource.Property(table, pd, pinf, false, pd.isStatic))
                            if (pd.isStatic) {
                                this.staticPropDef(cid, pd.name, false, fid)
                            } else {
                                this.propDef(cid, pd.name, false, fid)
                            }
                        }
                        if (pinf.hasSet) {
                            var fid2 = this.pushClassFunc(name + "." + pd.name + ".set", stem + "set", FnSource.Property(table, pd, pinf, true, pd.isStatic))
                            if (pd.isStatic) {
                                this.staticPropDef(cid, pd.name, true, fid2)
                            } else {
                                this.propDef(cid, pd.name, true, fid2)
                            }
                        }
                    }
                }
                case _ -> {}
            }
        }
        if (let some(pcid) = parentCid) {
            for (me in this.methodSeq) {
                if (me.cid == pcid) {
                    this.methodDef(cid, me.name, me.fid, me.isStatic)
                }
            }
            for (pe in this.propertySeq) {
                if (pe.cid == pcid) {
                    this.propDef(cid, pe.name, pe.isSet, pe.fid)
                }
            }
            for (pe in this.staticPropSeq) {
                if (pe.cid == pcid) {
                    this.staticPropDef(cid, pe.name, pe.isSet, pe.fid)
                }
            }
        }
        var implements = table.implements
        this.classes.push(ClassPlan(name, cid, parentCid, table))
        this.classByName[name] = cid
        if (!(len(implements) == 0)) {
            this.registerImplements(name, cid, implements, span)
        }
        true
    }

    fn registerLambdas() {
        for (item in this.prog.items) {
            var fnItem: FnDecl? = none
            match (item.kind) {
                case ItemKind.Fn(f) -> fnItem = f
                case ItemKind.Test(f) -> fnItem = f
                case ItemKind.Class(c) -> this.walkClassMembers(c.members, c.name)
                case ItemKind.Struct(s) -> this.walkClassMembers(s.members, s.name)
case ItemKind.Const(c) -> {
                        var scope = emptyScopeMaps()
                        var acc = emptyNameRefs()
                        this.walkExpr(c.value, none, none, 0, scope, acc)
                    }
                    // A managed global's initializer is real code evaluated by
                    // `pkl_globals_init`, so a lambda in it needs its hoisted body
                    // and closure class registered exactly like one in a function
                    // body. Scalar globals fold to bytes and cannot contain one.
                    case ItemKind.Global(g) -> {
                        var scope = emptyScopeMaps()
                        var acc = emptyNameRefs()
                        this.walkExpr(g.value, none, none, 0, scope, acc)
                    }
                case _ -> {}
            }
            if (let some(f) = fnItem) {
                var scope = emptyScopeMaps()
                var acc = emptyNameRefs()
                if (let some(b) = f.body) {
                    var generic = !(len(f.generics) == 0)
                    var saved = this.genericFnCtx
                    if (generic) {
                        this.genericFnCtx = f.name
                    }
                    this.walkFnBody(b, none, none, 0, scope, acc)
                    this.genericFnCtx = saved
                }
            }
        }
    }

    /// Whether `cls` is a generic class/struct whose member bodies carry `Var`s
    /// that only an instantiation can substitute (lambdas inside them are
    /// rejected loudly).
    fn genericClassCtx(cls: string) -> bool {
        if (let some(entry) = this.resolved.types.get(cls)) {
            match (entry) {
                case TypeTableEntry.Class(c) -> { return !(len(c.generics) == 0) }
                case TypeTableEntry.Struct(s) -> { return !(len(s.generics) == 0) }
                case _ -> { return false }
            }
        }
        false
    }

    /// Walk every lambda-holding member body of a class/struct with the class
    /// as owner (so statics/consts/fields resolve through it). Generics carry
    /// `Var`s, so a lambda inside a generic class is rejected by `walk_expr`.
    fn walkClassMembers(members: List<ClassMember>, cls: string) {
        var genericCtx = this.genericClassCtx(cls)
        var savedCtx = this.genericCtxName
        if (genericCtx) {
            this.genericCtxName = cls
        }
        var ocid: int? = this.classByName.get(cls)
        for (m in members) {
            var scope = emptyScopeMaps()
            var acc = emptyNameRefs()
            match (m) {
                case ClassMember.Field(fname, _, finit, _, _, _, _, _) -> {
                    if (let some(e) = finit) {
                        this.walkExpr(e, ocid, cls, 0, scope, acc)
                    }
                }
                case ClassMember.Field(_, _, _, _, _, _, _, _) | ClassMember.Constructor(_) -> {}
                case ClassMember.Method(md) -> {
                    if (let some(b) = md.body) {
                        this.walkFnBody(b, ocid, cls, 0, scope, acc)
                    }
                }
                case ClassMember.Property(pd) -> {
                    if (let some(a) = pd.get) {
                        this.walkAccessor(a, ocid, cls)
                    }
                    if (let some(a2) = pd.set) {
                        this.walkAccessor(a2, ocid, cls)
                    }
                }
                case ClassMember.Init(b2) -> this.walkBlock(b2, ocid, cls, 0, scope, acc)
                case ClassMember.Deinit(b2) -> this.walkBlock(b2, ocid, cls, 0, scope, acc)
                case ClassMember.Const(_, _, _, cvalue, _) -> this.walkExpr(cvalue, ocid, cls, 0, scope, acc)
            }
        }
        for (m in members) {
            match (m) {
                case ClassMember.Constructor(cd) -> {
                    var scope = emptyScopeMaps()
                    var acc = emptyNameRefs()
                    this.walkBlock(cd.body, ocid, cls, 0, scope, acc)
                }
                case _ -> {}
            }
        }
        this.genericCtxName = savedCtx
    }

    fn walkAccessor(a: PropertyAccessor, ownerCid: int?, ownerName: string?) {
        var scope = emptyScopeMaps()
        var acc = emptyNameRefs()
        match (a) {
            case PropertyAccessor.Expr(e) -> this.walkExpr(e, ownerCid, ownerName, 0, scope, acc)
            case PropertyAccessor.Block(b) -> this.walkBlock(b, ownerCid, ownerName, 0, scope, acc)
        }
    }

    fn walkFnBody(fb: FnBody, ownerCid: int?, ownerName: string?, lmark: int, scope: List<Map<string, bool>>, acc: List<NameRef>) {
        match (fb) {
            case FnBody.Block(b) -> this.walkBlock(b, ownerCid, ownerName, lmark, scope, acc)
            case FnBody.Expr(e) -> this.walkExpr(e, ownerCid, ownerName, lmark, scope, acc)
        }
    }

    fn walkBlock(b: Block, ownerCid: int?, ownerName: string?, lmark: int, scope: List<Map<string, bool>>, acc: List<NameRef>) {
        for (s in b.stmts) {
            this.walkStmt(s, ownerCid, ownerName, lmark, scope, acc)
        }
        if (let some(e) = b.expr) {
            this.walkExpr(e, ownerCid, ownerName, lmark, scope, acc)
        }
    }

    fn walkStmt(s: Stmt, ownerCid: int?, ownerName: string?, lmark: int, scope: List<Map<string, bool>>, acc: List<NameRef>) {
        match (s) {
            case Stmt.Let(pattern, _, init, _, _, _) -> {
                if (let some(e) = init) {
                    this.walkExpr(e, ownerCid, ownerName, lmark, scope, acc)
                }
                for (n in patternBinds(pattern)) {
                    scopeBind(scope, n)
                }
            }
            case Stmt.Const(cname, _, cvalue, _) -> {
                this.walkExpr(cvalue, ownerCid, ownerName, lmark, scope, acc)
                scopeBind(scope, cname)
            }
            case Stmt.Return(value, _) -> {
                if (let some(e) = value) {
                    this.walkExpr(e, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case Stmt.Return(_, _) | Stmt.Break(_) | Stmt.Continue(_) | Stmt.Empty(_) -> {}
            case Stmt.Throw(value, _) -> this.walkExpr(value, ownerCid, ownerName, lmark, scope, acc)
            case Stmt.Try(body4, binder, handler, fin, _) -> {
                // Each block gets its own scope, so a name bound inside a `try`
                // body, handler, or `finally` never leaks out of it -- and the
                // catch binder is only in scope for the handler body.
                scope.push(emptyScopeMap())
                this.walkBlock(body4, ownerCid, ownerName, lmark, scope, acc)
                scope.pop()
                if (let some(h) = handler) {
                    scope.push(emptyScopeMap())
                    if (let some(name) = binder) {
                        scopeBind(scope, name)
                    }
                    this.walkBlock(h, ownerCid, ownerName, lmark, scope, acc)
                    scope.pop()
                }
                if (let some(f) = fin) {
                    scope.push(emptyScopeMap())
                    this.walkBlock(f, ownerCid, ownerName, lmark, scope, acc)
                    scope.pop()
                }
            }
            case Stmt.Expr(e) -> this.walkExpr(e, ownerCid, ownerName, lmark, scope, acc)
            case Stmt.While(cond, body2, _) -> {
                this.walkExpr(cond, ownerCid, ownerName, lmark, scope, acc)
                scope.push(emptyScopeMap())
                this.walkBlock(body2, ownerCid, ownerName, lmark, scope, acc)
                scope.pop()
            }
            case Stmt.For(header, body3, _) -> {
                match (header) {
                    case ForHeader.In(pattern, sequence) -> {
                        this.walkExpr(sequence, ownerCid, ownerName, lmark, scope, acc)
                        scope.push(emptyScopeMap())
                        for (n in patternBinds(pattern)) {
                            scopeBind(scope, n)
                        }
                        this.walkBlock(body3, ownerCid, ownerName, lmark, scope, acc)
                        scope.pop()
                    }
                    case ForHeader.Range(init, cond, step) -> {
                        scope.push(emptyScopeMap())
                        this.walkStmt(init, ownerCid, ownerName, lmark, scope, acc)
                        this.walkExpr(cond, ownerCid, ownerName, lmark, scope, acc)
                        this.walkExpr(step, ownerCid, ownerName, lmark, scope, acc)
                        this.walkBlock(body3, ownerCid, ownerName, lmark, scope, acc)
                        scope.pop()
                    }
                }
            }
        }
    }

    fn walkExpr(e: Expr, ownerCid: int?, ownerName: string?, lmark: int, scope: List<Map<string, bool>>, acc: List<NameRef>) {
        match (e.kind) {
            case ExprKind.Ident(name) -> {
                if (this.collectWrites) {
                    return
                }
                if (!scopeContainsFrom(scope, lmark, name)) {
                    acc.push(NameRef(name, e.span))
                }
                var shadowed = false
                if (len(scope) >= 1) {
                    shadowed = scope[len(scope) - 1].has(name)
                }
                if (!shadowed && this.irModule.funcsByName.has(name) && this.isFnTy(e.span)) {
                    this.registerTrampoline(e.span, name)
                }
            }
            case ExprKind.This -> acc.push(NameRef("this", e.span))
            case ExprKind.Super -> acc.push(NameRef("__super", e.span))
            case ExprKind.Lit(_) | ExprKind.GenericCall(_, _) -> {}
            case ExprKind.Call(callee, args) -> {
                this.walkExpr(callee, ownerCid, ownerName, lmark, scope, acc)
                for (ca in args) {
                    this.walkExpr(ca.value, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case ExprKind.Member(object, name) -> {
                this.walkExpr(object, ownerCid, ownerName, lmark, scope, acc)
                var ot: Ty? = this.types.get(spanKey(object.span))
                if (let some(otv) = ot) {
                    var isCs = false
                    match (otv) {
                        case Ty.Class(_, _) -> isCs = true
                        case Ty.Struct(_, _) -> isCs = true
                        case _ -> {}
                    }
                    if (isCs) {
                        var cidOpt: int? = this.classIdOf(otv, object.span)
                        if (let some(cid) = cidOpt) {
                            var mrOpt: MethodRef? = this.methodIds.get(pairKey(str(cid), name))
                            if (let some(mr) = mrOpt) {
                                if (!mr.isStatic && this.isFnTy(e.span)) {
                                    this.registerMethodTrampoline(e.span, mr.fid, cid, name)
                                }
                            }
                        }
                    }
                }
            }
            case ExprKind.Index(object, index) -> {
                this.walkExpr(object, ownerCid, ownerName, lmark, scope, acc)
                this.walkExpr(index, ownerCid, ownerName, lmark, scope, acc)
            }
            case ExprKind.Binary(_, lhs, rhs) -> {
                this.walkExpr(lhs, ownerCid, ownerName, lmark, scope, acc)
                this.walkExpr(rhs, ownerCid, ownerName, lmark, scope, acc)
            }
            case ExprKind.Unary(_, operand) -> this.walkExpr(operand, ownerCid, ownerName, lmark, scope, acc)
            case ExprKind.Assign(target, _, value) -> {
                if (this.collectWrites) {
                    var tgtIsIdent = false
                    var tgtName = ""
                    match (target.kind) {
                        case ExprKind.Ident(n) -> {
                            tgtIsIdent = true
                            tgtName = n
                        }
                        case _ -> {}
                    }
                    if (tgtIsIdent) {
                        if (!scopeContainsFrom(scope, lmark, tgtName)) {
                            acc.push(NameRef(tgtName, target.span))
                        }
                    }
                    return
                }
                this.walkExpr(target, ownerCid, ownerName, lmark, scope, acc)
                this.walkExpr(value, ownerCid, ownerName, lmark, scope, acc)
            }
            case ExprKind.Lambda(lparams, _, isAsync, lbody) -> {
                if (this.collectWrites) {
                    return
                }
                if (let some(cls2) = this.genericCtxName) {
                    this.bad(e.span, "a lambda inside the generic class/struct `" + cls2 + "` is not lowered yet")
                    return
                }
                if (isAsync) {
                    this.bad(e.span, "async lambdas are not lowered yet")
                    return
                }
                for (p in lparams) {
                    var pBad = false
                    if (let some(_) = p.default) {
                        pBad = true
                    }
                    if (p.rest || pBad) {
                        this.bad(p.span, "lambda parameters cannot have defaults or rest markers")
                        return
                    }
                }
                var childMarker = len(scope)
                var before = len(acc)
                scope.push(boundParams(lparams))
                this.walkFnBody(lbody, ownerCid, ownerName, childMarker, scope, acc)
                var freeNames = splitOff(acc, before)
                var before2 = len(acc)
                this.collectWrites = true
                this.walkFnBody(lbody, ownerCid, ownerName, childMarker, scope, acc)
                this.collectWrites = false
                var written = splitOff(acc, before2)
                for (w in written) {
                    if (this.isEnclosingGlobal(w.name)) {
                        continue
                    }
                    var skipWrite = false
                    if (let some(cid) = ownerCid) {
                        var isField = false
                        if (let some(_) = this.instanceFieldIndex(cid, w.name)) {
                            isField = true
                        }
                        var isProp = this.propertyIds.has(tripleKey(str(cid), w.name, "false"))
                        var isStaticF = false
                        if (let some(_) = this.staticField(cid, w.name)) {
                            isStaticF = true
                        }
                        if (isField || isProp || isStaticF || this.classConstDefined(cid, w.name)) {
                            skipWrite = true
                        }
                    }
                    if (skipWrite) {
                        continue
                    }
                    this.bad(w.span, "assigning to `" + w.name + "` inside a lambda is not lowered yet: it is captured by value, and a hoisted body cannot mutate the enclosing binding (assign through a captured object's field instead)")
                    return
                }
                scope.pop()
                var capsOpt: List<Capture>? = this.decideCaptures(freeNames, ownerCid, ownerName, e.span)
                var chosen: List<Capture> = emptyCaptures()
                if (let some(c2) = capsOpt) {
                    chosen = c2
                } else {
                    return
                }
                if (let some(_) = this.genericFnCtx) {
                    this.lambdaCaps[lambdaKey(none, e.span)] = chosen
                    this.lambdaOwners[spanKey(e.span)] = ownerCid
                    this.lambdaExprs[spanKey(e.span)] = e
                } else {
                    this.registerLambda(e, chosen, ownerCid)
                }
                for (n in freeNames) {
                    if (!scopeContainsFrom(scope, lmark, n.name)) {
                        acc.push(NameRef(n.name, n.span))
                    }
                }
            }
            case ExprKind.If(cond, then, elseElse) -> {
match (cond) {
                    case IfCond.Cond(c) -> {
                        this.walkExpr(c, ownerCid, ownerName, lmark, scope, acc)
                        this.walkBlock(then, ownerCid, ownerName, lmark, scope, acc)
                    }
                    case IfCond.Binding(pattern, value) -> {
                        this.walkExpr(value, ownerCid, ownerName, lmark, scope, acc)
                        scope.push(emptyScopeMap())
                        for (n in patternBinds(pattern)) {
                            scopeBind(scope, n)
                        }
                        this.walkBlock(then, ownerCid, ownerName, lmark, scope, acc)
                        scope.pop()
                    }
                }
                if (let some(ee) = elseElse) {
                    this.walkExpr(ee, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case ExprKind.Match(scrutinee, arms) -> {
                this.walkExpr(scrutinee, ownerCid, ownerName, lmark, scope, acc)
                for (arm in arms) {
                    scope.push(emptyScopeMap())
                    for (n in patternBinds(arm.pattern)) {
                        scopeBind(scope, n)
                    }
                    if (let some(g) = arm.guard) {
                        this.walkExpr(g, ownerCid, ownerName, lmark, scope, acc)
                    }
                    this.walkExpr(arm.body, ownerCid, ownerName, lmark, scope, acc)
                    scope.pop()
                }
            }
            case ExprKind.Await(x) -> this.walkExpr(x, ownerCid, ownerName, lmark, scope, acc)
            case ExprKind.Cast(expr, _, _) -> this.walkExpr(expr, ownerCid, ownerName, lmark, scope, acc)
            case ExprKind.Unsafe(b) -> {
                scope.push(emptyScopeMap())
                this.walkBlock(b, ownerCid, ownerName, lmark, scope, acc)
                scope.pop()
            }
            case ExprKind.Block(b) -> {
                scope.push(emptyScopeMap())
                this.walkBlock(b, ownerCid, ownerName, lmark, scope, acc)
                scope.pop()
            }
            case ExprKind.Tuple(parts) -> {
                for (x in parts) {
                    this.walkExpr(x, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case ExprKind.Array(parts) -> {
                for (x in parts) {
                    this.walkExpr(x, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case ExprKind.Map(entries) -> {
                for (kv in entries) {
                    this.walkExpr(kv.key, ownerCid, ownerName, lmark, scope, acc)
                    this.walkExpr(kv.value, ownerCid, ownerName, lmark, scope, acc)
                }
            }
            case ExprKind.OptAccess(object, _) -> this.walkExpr(object, ownerCid, ownerName, lmark, scope, acc)
            case ExprKind.OptUnwrap(inner) -> this.walkExpr(inner, ownerCid, ownerName, lmark, scope, acc)
            case ExprKind.Range(start, end, _) -> {
                this.walkExpr(start, ownerCid, ownerName, lmark, scope, acc)
                this.walkExpr(end, ownerCid, ownerName, lmark, scope, acc)
            }
        }
    }

    /// Whether the type inferred for `span` is a function type.
    fn isFnTy(span: Span) -> bool {
        if (let some(t) = this.types.get(spanKey(span))) {
            match (t) {
                case Ty.Fn(_, _) -> { return true }
                case _ -> { return false }
            }
        }
        false
    }

    /// Decide which free names a lambda really captures (globals and the
    /// owner class's statics/consts resolve statically; instance members ride
    /// along as `this`), sorted deterministically for slot assignment.
    fn decideCaptures(free: List<NameRef>, ownerCid: int?, ownerName: string?, span: Span) -> List<Capture>? {
        var seen = emptyScopeMap()
        var caps = emptyCaptures()
        var needsThis = false
        for (fr in free) {
            if (fr.name == "__super") {
                this.bad(fr.span, "`super` inside a lambda is not lowered yet")
                return none
            }
            if (seen.has(fr.name)) {
                continue
            }
            seen[fr.name] = true
            if (this.isEnclosingGlobal(fr.name)) {
                continue
            }
            if (let some(cid) = ownerCid) {
                var isField = false
                if (let some(_) = this.instanceFieldIndex(cid, fr.name)) {
                    isField = true
                }
                var isProp = this.propertyIds.has(tripleKey(str(cid), fr.name, "false"))
                var isMethod = false
                var mvO2 = this.methodIds.get(pairKey(str(cid), fr.name))
                if (let some(mv2) = mvO2) {
                    if (!(mv2.isStatic)) {
                        isMethod = true
                    }
                }
                if (isField || isProp || isMethod) {
                    needsThis = true
                    continue
                }
                var isStaticF = false
                if (let some(_) = this.staticField(cid, fr.name)) {
                    isStaticF = true
                }
                if (isStaticF || this.classConstDefined(cid, fr.name)) {
                    continue
                }
            }
            var ty: Ty = Ty.Unknown
            if (let some(t2) = this.types.get(spanKey(fr.span))) {
                ty = t2
            } else {
                this.bad(fr.span, "cannot infer the type of captured `" + fr.name + "`")
                return none
            }
            caps.push(Capture(fr.name, ty, fr.span))
        }
        if (needsThis) {
            var oname = ""
            if (let some(on) = ownerName) {
                oname = on
            }
            if (oname == "") {
                this.bad(span, "internal: owner member with no owner name")
                return none
            }
            caps.push(Capture("this", Ty.Class(oname, emptyTys()), span))
        }
        var i = 1
        while (i < len(caps)) {
            var j = i
            while (j >= 1 && strLess(caps[j].name, caps[j - 1].name)) {
                var tmp = caps[j]
                caps[j] = caps[j - 1]
                caps[j - 1] = tmp
                j = j - 1
            }
            i = i + 1
        }
        if (len(caps) > MAX_LAMBDA_CAPTURES) {
            this.bad(span, "this lambda captures " + str(len(caps)) + " values, more than the supported limit of " + str(MAX_LAMBDA_CAPTURES))
            return none
        }
        caps
    }

    fn isEnclosingGlobal(name: string) -> bool {
        if (this.irModule.funcsByName.has(name) || this.classDecls.has(name) || this.constsInits.has(name)) {
            return true
        }
        match (name) {
            case "print" -> true
            case "println" -> true
            case "len" -> true
            case "alloc" -> true
            case "free" -> true
            case "view" -> true
            case "assert" -> true
            case "expect" -> true
            case "abs" -> true
            case "range" -> true
            case "min" -> true
            case "max" -> true
            case "clamp" -> true
            case "str" -> true
            case "bytes" -> true
            case "read_file" -> true
            case "write_file" -> true
            case "file_exists" -> true
            case "delete" -> true
            case "list_dir" -> true
            case "mkdir" -> true
            case "stream_open_read" -> true
            case "stream_open_write" -> true
            case "stream_open_append" -> true
case "stdout_stream" -> true
            case "stderr_stream" -> true
            case "args" -> true
            case "exit" -> true
            case "run_cmd" -> true
            case "run_spawn" -> true
            case "proc_wait" -> true
            case "proc_running" -> true
            case "proc_code" -> true
            case "proc_kill" -> true
            case "proc_out_read" -> true
            case "proc_err_read" -> true
            case "proc_in_write" -> true
            case "proc_in_close" -> true
            case "current_dir" -> true
            case "captureBegin" -> true
            case "captureTake" -> true
            case "thread_spawn" -> true
            case "thread_join" -> true
            case "thread_finished" -> true
            case "thread_message" -> true
            case "thread_count" -> true
            case "thread_current" -> true
            case "sleep_ms" -> true
            case "thread_yield" -> true
            case "mutex_new" -> true
            case "mutex_lock" -> true
            case "mutex_trylock" -> true
            case "mutex_unlock" -> true
            case "cond_new" -> true
            case "cond_signal" -> true
            case "cond_broadcast" -> true
            case "cond_wait" -> true
            case "sem_new" -> true
            case "sem_acquire" -> true
            case "sem_try_acquire" -> true
            case "sem_release" -> true
            case "atomic_new" -> true
            case "atomic_load" -> true
            case "atomic_store" -> true
            case "atomic_add" -> true
            case "atomic_cas" -> true
            case "once_new" -> true
            case "once_done" -> true
            case "once_run" -> true
            case "channel_new" -> true
            case "channel_cap" -> true
            case "channel_len" -> true
            case "channel_send" -> true
            case "channel_try_send" -> true
            case "channel_recv" -> true
            case "channel_try_recv" -> true
            case "channel_close" -> true
            case "channel_closed" -> true
            case "gcCollect" -> true
            case _ -> false
        }
    }

    /// A lambda body's inferred return type: its trailing expression, or unit
    /// when none (checked annotations win first, in `registerLambdaAt`).
    fn inferLambdaRet(body: FnBody) -> Ty {
        match (body) {
            case FnBody.Expr(e) -> {
                if (let some(t) = this.types.get(spanKey(e.span))) {
                    return t
                }
                Ty.Unknown
            }
            case FnBody.Block(b) -> {
                match (b.expr) {
                    case some(e2) -> {
                        if (let some(t) = this.types.get(spanKey(e2.span))) {
                            return t
                        }
                        Ty.Empty
                    }
                    case none -> Ty.Empty
                }
            }
        }
    }

    /// Register a lambda's hoisted body and its closure class.
    fn registerLambda(lambda: Expr, captures: List<Capture>, ownerCid: int?) {
        this.registerLambdaAt(lambda, captures, ownerCid, emptyStringTyMap(), none)
    }

    /// Register a hoisted lambda body under the (enclosing function, span) key,
    /// substituting `smap` into the signature, captures, and return type.
    fn registerLambdaAt(lambda: Expr, captures: List<Capture>, ownerCid: int?, smap: Map<string, Ty>, base: int?) -> int? {
        var lbody: FnBody = FnBody.Block(Block(emptyStmts(), none, Span(0, 0)))
        match (lambda.kind) {
            case ExprKind.Lambda(_, _, _, b) -> lbody = b
            case _ -> { return none }
        }
        this.registerClosureClass(len(captures), lambda.span)
        var fnty: Ty = Ty.Unknown
        if (let some(t) = this.types.get(spanKey(lambda.span))) {
            fnty = t
        }
        var pts: List<Ty> = emptyTys()
        var isFnTy = false
        match (fnty) {
            case Ty.Fn(pts0, _) -> {
                pts = pts0
                isFnTy = true
            }
            case _ -> {}
        }
        if (!isFnTy) {
            return none
        }
        if (paramsLen(lambda) != len(pts)) {
            return none
        }
        var subbedPts = emptyTys()
        for (pt in pts) {
            subbedPts.push(subst(pt, smap))
        }
        var anyBad = false
        for (pt in subbedPts) {
            if (let none = this.mapTy(pt, lambda.span)) {
                anyBad = true
                break
            }
        }
        if (anyBad) {
            return none
        }
        var ret: Ty = Ty.Unknown
        var isKnown = false
        match (fnty) {
            case Ty.Fn(_, r) -> {
                var rIsUnknown = false
                match (r) {
                    case Ty.Unknown -> rIsUnknown = true
                    case _ -> {}
                }
                if (!rIsUnknown) {
                    ret = r
                    isKnown = true
                }
            }
            case _ -> {}
        }
        if (!isKnown) {
            ret = this.inferLambdaRet(lbody)
        }
        var retIsUnknown = false
        match (ret) {
            case Ty.Unknown -> retIsUnknown = true
            case _ -> {}
        }
        if (retIsUnknown) {
            ret = this.inferLambdaRet(lbody)
        }
        var subbedRet = subst(ret, smap)
        if (let none = this.mapTy(subbedRet, lambda.span)) {
            return none
        }
        var subbedCaps = emptyCaptures()
        for (c in captures) {
            subbedCaps.push(Capture(c.name, subst(c.ty, smap), c.span))
        }
        var fid = this.pushClassFunc("lambda", "pkl_closure_" + str(this.nextClosure), FnSource.Lambda(lambda, subbedCaps, subbedPts, subbedRet, ownerCid))
        this.nextClosure = this.nextClosure + 1
        this.instantonSubst[fid] = smap
        this.lambdaFids[lambdaKey(base, lambda.span)] = fid
        this.lambdaCaps[lambdaKey(base, lambda.span)] = subbedCaps
        fid
    }

    /// Register the synthetic `__closure_N` class (or return its id). Slot 0
    /// holds the hoisted body's code address; slots 1..N the captured values.
    fn registerClosureClass(captureCount: int, span: Span) -> int? {
        if (captureCount > MAX_LAMBDA_CAPTURES) {
            this.bad(span, "this lambda captures " + str(captureCount) + " values, more than the supported limit of " + str(MAX_LAMBDA_CAPTURES))
            return none
        }
        var name2 = CLOSURE_CLASS_PREFIX + str(captureCount)
        if (let some(cid) = this.classByName.get(name2)) {
            return cid
        }
        var fields = emptyFieldInfos()
        var fl = 0
        while (fl <= captureCount) {
            var fname = ""
            if (fl == CLOSURE_FN_SLOT) {
                fname = "__fn"
            } else {
                fname = "__c" + str(fl - 1)
            }
            fields.push(FieldInfo(fname, Visibility.Private, false, false, false, false, Ty.Int, span))
            fl = fl + 1
        }
        var table = ClassTable(name2, span, Visibility.Private, emptyStrs(), none, emptyTys(), fields, emptyCallableInfos(), emptyPropertyInfos(), none, emptyNamedCtorInfos(), emptyFieldInfos())
        var cid2 = PICKLE_CLASS_USER_BASE + this.cidSalt + len(this.classes)
        this.closureTables[name2] = table
        this.classByName[name2] = cid2
        this.classes.push(ClassPlan(name2, cid2, none, table))
        cid2
    }

    /// Register the forwarder letting a top-level function be called through a
    /// closure object, keyed so every value-use site maps to the same trampoline.
    fn registerTrampoline(span: Span, fnName: string) {
        var fidOpt: int? = this.irModule.funcsByName.get(fnName)
        if (let none = fidOpt) {
            return
        }
        var fid = 0
        if (let some(fv) = fidOpt) {
            fid = fv
        }
        var pty: List<Ty> = emptyTys()
        var ret: Ty = Ty.Unknown
        var hasFn = false
        if (let some(t) = this.types.get(spanKey(span))) {
            match (t) {
                case Ty.Fn(pts, r) -> {
                    pty = pts
                    ret = r
                    hasFn = true
                }
                case _ -> {}
            }
        }
        if (!hasFn) {
            return
        }
        var anyBad = false
        for (pt in pty) {
            if (let none = this.mapTy(pt, span)) {
                anyBad = true
                break
            }
        }
        if (anyBad) {
            return
        }
        if (let none = this.mapTy(ret, span)) {
            return
        }
        var tramp = 0
        if (let some(t) = this.trampFids.get(fid)) {
            tramp = t
        } else {
            tramp = this.pushClassFunc("fn.value", "pkl_tramp_" + str(fid), FnSource.Trampoline(span, fid, pty, ret))
            this.trampFids[fid] = tramp
        }
        this.fnTramp[spanKey(span)] = tramp
    }

    /// Register the forwarder letting an instance method bound to a receiver
    /// be used as a value; dispatches on the receiver's runtime class when the
    /// receiver class records overrides for the method.
    fn registerMethodTrampoline(span: Span, fid: int, cid: int, name: string) {
        var pty: List<Ty> = emptyTys()
        var ret: Ty = Ty.Unknown
        var hasFn = false
        if (let some(t) = this.types.get(spanKey(span))) {
            match (t) {
                case Ty.Fn(pts, r) -> {
                    pty = pts
                    ret = r
                    hasFn = true
                }
                case _ -> {}
            }
        }
        if (!hasFn) {
            return
        }
        var anyBad = false
        for (pt in pty) {
            if (let none = this.mapTy(pt, span)) {
                anyBad = true
                break
            }
        }
        if (anyBad) {
            return
        }
        if (let none = this.mapTy(ret, span)) {
            return
        }
        var branches = emptyDispatchBranches()
        if (let some(b) = this.virtualDispatch.get(pairKey(str(cid), name))) {
            branches = b
        }
        var key = tripleKey(str(cid), name, str(fid))
        var tramp = 0
        if (let some(t) = this.methodTrampFids.get(key)) {
            tramp = t
        } else {
            tramp = this.pushClassFunc("fn.method.value", "pkl_mtramp_" + str(cid) + "_" + name + "_" + str(fid), FnSource.MethodTrampoline(span, fid, pty, ret, branches))
            this.methodTrampFids[key] = tramp
        }
        this.fnTramp[spanKey(span)] = tramp
    }

    /// The runtime slot of instance field `name` on class `cid`, following the
    /// parent-first layout, when registered.
    fn instanceFieldIndex(cid: int, name: string) -> int? {
        var plan: ClassPlan? = none
        for (p in this.classes) {
            if (p.classId == cid) {
                plan = p
                break
            }
        }
        if (let none = plan) {
            return none
        }
        var pname = ""
        if (let some(p) = plan) {
            pname = p.name
        }
        this.absInstanceFieldSlot(pname, name)
    }

    /// Absolute (parent-first) slot of instance field `field` reachable from
    /// `cname`, whether declared on it or inherited.
    fn absInstanceFieldSlot(cname: string, field: string) -> int? {
        var base = 0
        for (a in this.ancestry(cname)) {
            var own = this.ownInstanceFields(a)
            var i = 0
            var found = false
            while (i < len(own)) {
                if (own[i].name == field) {
                    found = true
                    break
                }
                i = i + 1
            }
            if (found) {
                return base + i
            }
            base = base + len(own)
        }
        none
    }

    /// The static slot of static field `name` on class `cid`, with its declared
    /// type and the *declaring* class's id, when registered. Own declarations
    /// win, then up the ancestry.
    fn staticField(cid: int, name: string) -> StaticFieldLoc? {
        var plan: ClassPlan? = none
        for (p in this.classes) {
            if (p.classId == cid) {
                plan = p
                break
            }
        }
        if (let none = plan) {
            return none
        }
        var pname = ""
        if (let some(p) = plan) {
            pname = p.name
        }
        var chain = this.ancestry(pname)
        var ci = len(chain)
        while (ci >= 1) {
            ci = ci - 1
            var cn = chain[ci]
            if (let some(tb) = this.tableOf(cn)) {
                var slot: int? = staticFieldSlot(tb, name)
                if (let some(sl) = slot) {
                    var info: FieldInfo? = staticFieldInfo(tb, name)
                    if (let some(inf) = info) {
                        var dcid: int? = this.classByName.get(cn)
                        if (let some(dc) = dcid) {
                            return StaticFieldLoc(dc, sl, inf)
                        }
                    }
                }
            }
        }
        none
    }

    /// Whether `name` is a `const` declared on `cid` or any ancestor.
    fn classConstDefined(cid: int, name: string) -> bool {
        var plan: ClassPlan? = none
        for (p in this.classes) {
            if (p.classId == cid) {
                plan = p
                break
            }
        }
        if (let none = plan) {
            return false
        }
        var pname = ""
        if (let some(p) = plan) {
            pname = p.name
        }
        var chain = this.ancestry(pname)
        var ci = len(chain)
        while (ci >= 1) {
            ci = ci - 1
            var cn = chain[ci]
            if (let some(dc) = this.classByName.get(cn)) {
                if (this.classConsts.has(pairKey(str(dc), name))) {
                    return true
                }
            }
        }
        false
    }

    /// The registered runtime class id of a resolved class/struct type.
    /// Non-generic types resolve through `classByName`; a generic type with
    /// concrete arguments materializes its instantiation on first use.
fn classIdOf(ty: Ty, span: Span) -> int? {
        var n = ""
        var args = emptyTys()
        var isTy = false
        match (ty) {
            case Ty.Class(nm, a) -> {
                n = nm
                args = a
                isTy = true
            }
            case Ty.Struct(nm, a) -> {
                n = nm
                args = a
                isTy = true
            }
            case _ -> {}
        }
        if (!isTy) {
            return none
        }
        for (a in args) {
            if (hasVar(a)) {
                return none
            }
        }
        if (len(args) == 0) {
            return this.classByName.get(n)
        }
        var tableGenerics = -1
        if (let some(entry) = this.resolved.types.get(n)) {
            match (entry) {
                case TypeTableEntry.Class(c) -> tableGenerics = len(c.generics)
                case TypeTableEntry.Struct(s) -> tableGenerics = len(s.generics)
                case _ -> {}
            }
        }
        if (tableGenerics == -1) {
            return none
        }
        if (tableGenerics != len(args)) {
            return none
        }
        if (let some(cid) = this.classInstByArgs.get(instKey(n, args))) {
            return cid
        }
        this.registerClassInstantiation(n, args, span)
    }

    /// Materialize one concrete instantiation of a generic class/struct under
    /// its mangled display name, registering its ctor and instance methods.
    fn registerClassInstantiation(name: string, args: List<Ty>, span: Span) -> int? {
        if (let some(cid0) = this.classInstByArgs.get(instKey(name, args))) {
            return cid0
        }
        var table = seedClassTable()
        var isTable = false
        if (let some(entry) = this.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Class(c) -> {
                    table = c
                    isTable = true
                }
                case TypeTableEntry.Struct(s) -> {
                    table = s
                    isTable = true
                }
                case _ -> {}
            }
        }
        if (!isTable) {
            this.bad(span, "`" + name + "` is not a class or struct")
            return none
        }
        if (len(table.generics) != len(args)) {
            this.bad(span, "`" + name + "` takes " + str(len(table.generics)) + " type argument(s), found " + str(len(args)))
            return none
        }
        var members2: List<ClassMember>? = none
        if (let some(gm) = this.genericTypeMembers.get(name)) {
            members2 = gm
        }
        if (let none = members2) {
            this.bad(span, "`" + name + "` is not lowerable")
            return none
        }
        var ms = emptyClassMembers()
        if (let some(x) = members2) {
            ms = x
        }
        if (let some(_) = table.extends) {
            this.bad(span, "`" + name + "` with `extends` is not lowered yet")
            return none
        }
        var hasOverride = false
        for (m in ms) {
            match (m) {
                case ClassMember.Method(md) -> {
                    if (md.isOverride) {
                        hasOverride = true
                    }
                }
                case _ -> {}
            }
        }
        if (hasOverride) {
            this.bad(span, "`" + name + "` uses `override`, which is not lowered yet")
            return none
        }
        var hasNamedCtor = false
        for (m in ms) {
            match (m) {
                case ClassMember.Constructor(cd2) -> {
                    if (let some(_) = cd2.name) {
                        hasNamedCtor = true
                    }
                }
                case _ -> {}
            }
        }
        if (hasNamedCtor) {
            this.bad(span, "`" + name + "` uses named constructors, which are not lowered yet")
            return none
        }
        var hasDeinit = false
        for (m in ms) {
            match (m) {
                case ClassMember.Deinit(_) -> hasDeinit = true
                case _ -> {}
            }
        }
        if (hasDeinit) {
            this.bad(span, "`" + name + "` uses `deinit`, which is not lowered yet for generic classes/structs")
            return none
        }
        var hasProp = false
        for (m in ms) {
            match (m) {
                case ClassMember.Property(_) -> hasProp = true
                case _ -> {}
            }
        }
        if (hasProp) {
            this.bad(span, "`" + name + "` uses properties, which are not lowered yet for generic classes/structs")
            return none
        }
        var hasStatic = !(len(table.consts) == 0)
        for (f in table.fields) {
            if (f.isStatic) {
                hasStatic = true
            }
        }
        if (hasStatic) {
            this.bad(span, "`" + name + "` uses static state, which is not lowered yet for generic classes/structs")
            return none
        }
        var map = emptyStringTyMap()
        var gi = 0
        while (gi < len(table.generics) && gi < len(args)) {
            map[table.generics[gi]] = args[gi]
            gi = gi + 1
        }
        var implements = emptyTys()
        for (t in table.implements) {
            implements.push(subst(t, map))
        }
        var suffix = ""
        var fi = 0
        for (a in args) {
            if (fi > 0) {
                suffix = suffix + "_"
            }
            suffix = suffix + sanitizeSymbol(bareName(a))
            fi = fi + 1
        }
        var display = name + "<"
        var di = 0
        for (a in args) {
            if (di > 0) {
                display = display + ", "
            }
            display = display + bareName(a)
            di = di + 1
        }
        display = display + ">"
        var stabFields = emptyFieldInfos()
        for (f in table.fields) {
            var fsub = subst(f.ty, map)
            stabFields.push(FieldInfo(f.name, f.visibility, f.isStatic, f.mutable, f.const_, f.manual, fsub, f.span))
        }
        var stabMethods = emptyCallableInfos()
        for (m in table.methods) {
            var nps = emptyParamInfos()
            for (p in m.params) {
                nps.push(ParamInfo(p.name, subst(p.ty, map), p.hasDefault, p.rest, p.span))
            }
            stabMethods.push(CallableInfo(m.name, m.span, m.visibility, m.isAsync, m.isStatic, m.isOverride, m.isAbstract, m.operator, m.generics, nps, subst(m.ret, map)))
        }
        var stabCtor: CtorInfo? = none
        if (let some(c) = table.ctor) {
            var nps2 = emptyParamInfos()
            for (p in c.params) {
                nps2.push(ParamInfo(p.name, subst(p.ty, map), p.hasDefault, p.rest, p.span))
            }
            stabCtor = CtorInfo(c.span, c.visibility, nps2)
        }
        var stable = ClassTable(display, table.span, table.visibility, table.generics, none, emptyTys(), stabFields, stabMethods, emptyPropertyInfos(), stabCtor, emptyNamedCtorInfos(), emptyFieldInfos())
        var ctorDecl: ConstructorDecl? = none
        for (m in ms) {
            match (m) {
                case ClassMember.Constructor(cd) -> {
                    if (let none = cd.name) {
                        ctorDecl = cd
                        break
                    }
                }
                case _ -> {}
            }
        }
        var inits = this.collectInstanceInits(name)
        var initBlocks = this.collectInitBlocks(name)
        var cid = PICKLE_CLASS_USER_BASE + this.cidSalt + len(this.classes)
        var ctorSymbol = this.uniqSymbol("pkl_" + name + "_new__" + suffix)
        var ctorFid = this.pushClassFunc(display + ".new", ctorSymbol, FnSource.Ctor(stable, inits, initBlocks, ctorDecl))
        this.ctorIds[cid] = ctorFid
        var sps = emptyParamInfos()
        if (let some(c) = stable.ctor) {
            sps = c.params
        }
        var srctys = emptyTys()
        for (p in sps) {
            srctys.push(p.ty)
        }
        this.srcParamTys[ctorFid] = srctys
        this.instantonSubst[ctorFid] = map
        this.fidOwner[ctorFid] = cid
        this.fidGenerics[ctorFid] = table.generics
        for (m in ms) {
            match (m) {
                case ClassMember.Method(md) -> {
                    if (md.isOverride || !(len(md.generics) == 0)) {
                        continue
                    }
                    if (let none = md.body) {
                        continue
                    }
                    var minfo: CallableInfo? = none
                    for (mm in stable.methods) {
                        if (mm.name == md.name) {
                            minfo = mm
                        }
                    }
                    if (let none = minfo) {
                        continue
                    }
var m2 = seedCallableInfo()
                    if (let some(x) = minfo) {
                        m2 = x
                    }
                    var hasDefRest = false
                    for (p in m2.params) {
                        if (p.hasDefault || p.rest) {
                            hasDefRest = true
                        }
                    }
                    if (hasDefRest) {
                        continue
                    }
                    if (md.isAsync) {
                        var isStruct = false
                        if (let some(entry) = this.resolved.types.get(name)) {
                            match (entry) {
                                case TypeTableEntry.Struct(_) -> isStruct = true
                                case _ -> {}
                            }
                        }
                        this.registerAsyncMethod(display, stable, md, m2, cid, args, isStruct, "_" + suffix, map)
                        continue
                    }
                    var tref = "pkl_" + name + "_" + md.name + "_" + suffix
                    if (m2.isStatic) {
                        tref = "pkl_" + name + "_sm_" + md.name + "_" + suffix
                    }
                    var symbol = this.uniqSymbol(tref)
                    var mid = this.pushClassFunc(display + "." + md.name, symbol, FnSource.Method(stable, md))
                    this.finfo[mid] = m2
                    var mtys = emptyTys()
                    for (p in m2.params) {
                        mtys.push(p.ty)
                    }
                    this.srcParamTys[mid] = mtys
                    this.methodIds[pairKey(str(cid), md.name)] = MethodRef(mid, m2.isStatic)
                    this.instantonSubst[mid] = map
                    this.fidOwner[mid] = cid
                    this.fidGenerics[mid] = table.generics
                }
                case _ -> {}
            }
        }
        this.classes.push(ClassPlan(display, cid, none, stable))
        this.classInstByArgs[instKey(name, args)] = cid
        this.classInstSubst[cid] = map
        if (!(len(implements) == 0)) {
            this.registerImplements(display, cid, implements, span)
        }
        cid
    }

    /// A symbol unique among the already-pushed module functions.
    fn uniqSymbol(base: string) -> string {
        var symbol = base
        var n = 0
        var taken = true
        while (taken) {
            taken = false
            for (f in this.irModule.funcs) {
                if (f.symbol == symbol) {
                    taken = true
                    break
                }
            }
            if (taken) {
                n = n + 1
                symbol = base + "_v" + str(n)
            }
        }
        symbol
    }

    fn buildFunc(fid: int) {
        this.fname = this.irModule.funcs[fid].name
        this.symbol = this.irModule.funcs[fid].symbol
        this.fparams = emptyIrParams()
        this.fslots = emptyIrTys()
        this.env = emptyIntScopeMap()
        this.env.push(seedIntScopeMap())
        this.manualEnv = emptyScopeMaps()
        this.manualEnv.push(seedScopeMap())
        this.blocks = emptyIrBlocks()
        this.blocks.push(IrBlock(0, emptyIrInstrs(), IrTerm.Unreachable))
        this.nextBlock = 1
        this.nextTemp = 0
        this.loops = emptyLoopCtxs()
        this.cur = 0
        // Reset the exception context per function alongside `loops`. Both stacks
        // balance themselves on a clean lowering, but a pass that bailed out
        // early can leave them dirty -- and the two-pass driver re-runs this
        // function, so pass 2 must not inherit that.
        this.finallys = emptyBlocks()
        this.handlers = emptyHandlerCtxs()
        this.inThrowTransfer = false
        this.owner = none
        this.currentFid = fid
        this.iceDepth = 0
        this.icePath = emptyStrs()
        this.iceSeq = emptyStrs()

        if (let some(s) = this.instantonSubst.get(fid)) {
            this.currentSubst = s
        } else {
            this.currentSubst = emptyStringTyMap()
        }
        var fg = emptyStrs()
        if (let some(g) = this.fidGenerics.get(fid)) {
            fg = g
        } else {
            if (let some(s) = this.fsource.get(fid)) {
                var tl: FnDecl? = none
                match (s) {
                    case FnSource.TopLevel(f) -> tl = f
                    case _ -> {}
                }
                if (let some(t) = tl) {
                    for (g in t.generics) {
                        fg.push(g.name)
                    }
                }
            }
        }
        this.fnGenerics = fg

var isMain = this.irModule.funcs[fid].isMain
        if (let some(src) = this.fsource.get(fid)) {
            match (src) {
                case FnSource.TopLevel(f) -> {
                    var infoOpt: CallableInfo? = none
                    if (let some(i) = this.finfo.get(fid)) {
                        infoOpt = i
                    }
                    if (let none = infoOpt) {
                        return
                    }
                    var info = seedCallableInfo()
                    if (let some(i) = infoOpt) {
                        info = i
                    }
                    this.declareParams(info.params)
                    this.adoptManualParams(f.params)
                    var m = this.mapTy(info.ret, f.span)
                    if (let some(r) = m) {
                        this.fret = r
                    } else {
                        this.fret = IrTy.Unit
                    }
                    this.emitBody(f.body)
                }
                case FnSource.Lambda(lambda, caps, pts, rt, owner) -> this.buildLambdaBody(lambda, caps, pts, rt, owner, fid)
                case FnSource.Trampoline(span, target, pts, rt) -> {
                    this.owner = none
                    this.buildTrampoline(span, target, pts, rt)
                }
case FnSource.MethodTrampoline(span, target, pts, rt, branches) -> {
                    this.owner = none
                    this.buildMethodTrampoline(span, target, pts, rt, branches)
                }
                case FnSource.SpreadTrampoline(span, target, pts, rt, recv) -> {
                    this.owner = none
                    this.buildSpreadTrampoline(span, target, pts, rt, recv)
                }
                case FnSource.Ctor(table, inits, initBlocks, cd) -> {
                    this.owner = this.ownerFor(fid, table.name)
                    this.buildCtorBody(table, inits, initBlocks, cd)
                }
                case FnSource.NamedCtor(table, cd) -> {
                    this.owner = this.ownerFor(fid, table.name)
                    this.buildNamedCtor(table, cd)
                }
                case FnSource.Deinit(table, body) -> {
                    this.owner = this.ownerFor(fid, table.name)
                    this.buildDeinitBody(table, body)
                }
                case FnSource.Method(table, md) -> {
                    var infoOpt2: CallableInfo? = none
                    if (let some(i) = this.finfo.get(fid)) {
                        infoOpt2 = i
                    }
                    if (let none = infoOpt2) {
                        return
                    }
                    var info2 = seedCallableInfo()
                    if (let some(i) = infoOpt2) {
                        info2 = i
                    }
                    this.owner = this.ownerFor(fid, table.name)
                    this.buildMethodBody(table, md, info2)
                }
                case FnSource.AsyncFn(f, hidden) -> {
                    var infoOpt3: CallableInfo? = none
                    if (let some(i) = this.finfo.get(fid)) {
                        infoOpt3 = i
                    }
                    if (let none = infoOpt3) {
                        return
                    }
                    var info3 = seedCallableInfo()
                    if (let some(i) = infoOpt3) {
                        info3 = i
                    }
                    this.declareParams(info3.params)
                    this.adoptManualParams(f.params)
                    // The wrapper returns the future: a closure snapshotting
                    // each parameter under its own name (slot 0 is the hidden
                    // body). Runs no user code.
                    this.fret = IrTy.Ptr
                    var captures = emptyCaptures()
                    for (p in info3.params) {
                        captures.push(Capture(p.name, p.ty, p.span))
                    }
                    if (let some(obj) = this.closureObj(Expr(f.span, ExprKind.Ident("")), hidden, captures)) {
                        this.term(IrTerm.Return(obj))
                    }
                }
                case FnSource.AsyncBody(f, pts, rt) -> this.buildAsyncBody(f, pts, rt)
                case FnSource.AsyncMethod(table, md, hidden, isStatic, thisTy) -> {
                    var infoOpt4: CallableInfo? = none
                    if (let some(i) = this.finfo.get(fid)) {
                        infoOpt4 = i
                    }
                    if (let none = infoOpt4) {
                        return
                    }
                    var info4 = seedCallableInfo()
                    if (let some(i) = infoOpt4) {
                        info4 = i
                    }
                    this.owner = this.ownerFor(fid, table.name)
                    this.buildAsyncMethodWrapper(md, info4, hidden, isStatic, thisTy)
                }
                case FnSource.AsyncMethodBody(table, md, pts, rt, isStatic) -> {
                    this.owner = this.ownerFor(fid, table.name)
                    this.buildAsyncMethodBody(md, pts, rt, isStatic)
                }
                case FnSource.Property(table, pd, pinfo, isSet, isStatic) -> {
                    this.owner = this.ownerFor(fid, table.name)
                    this.buildPropertyBody(table, pd, pinfo, isSet, isStatic)
                }
                case FnSource.StaticInit(inits) -> this.buildStaticInit(inits)
                case FnSource.GlobalsInit(inits) -> this.buildGlobalsInit(inits)
                case FnSource.TestSetup -> {
                    this.fret = IrTy.Unit
                    this.injectClassRegistrations()
                    this.term(IrTerm.Return(none))
                }
            }
        }
        if (this.failed) {
            return
        }

        var isFirstTest = !(isSomeInt(this.testSetupId)) && this.irModule.funcs[fid].isTest
        if (isFirstTest) {
            var k = 0
            while (k < fid) {
                if (this.irModule.funcs[k].isTest) {
                    isFirstTest = false
                    break
                }
                k = k + 1
            }
        }
        if (isMain || isFirstTest) {
            this.injectClassRegistrations()
        }

        var rname = this.irModule.funcs[fid].name
        var rsym = this.irModule.funcs[fid].symbol
        var rmain = this.irModule.funcs[fid].isMain
        var rtest = this.irModule.funcs[fid].isTest
        var rtags = this.irModule.funcs[fid].tags
        this.irModule.funcs[fid] = IrFunc(this.fname, this.symbol, this.fparams, this.fret, this.fslots, 0, this.blocks, rmain, rtest, rtags)
    }

    /// The owner class/struct id of a class-level function, resolved from the
    /// recorded owner, falling back to the class name. Mirrors the
    /// `fid_owner.get().or_else(class_by_name)` chain in `build_func`.
    fn ownerFor(fid: int, cname: string) -> int? {
        if (let some(o) = this.fidOwner.get(fid)) {
            return o
        }
        if (let some(o2) = this.classByName.get(cname)) {
            return o2
        }
        none
    }

    // ---- function registration helpers ----

    /// Append a class-level function (ctor, method, property accessor,
    /// `static.init`, `test.setup`, ...) to the module and record its source.
    fn pushClassFunc(name: string, symbol: string, src: FnSource) -> int {
        var fid = len(this.irModule.funcs)
        this.irModule.funcs.push(IrFunc(name, symbol, emptyIrParams(), IrTy.Unit, emptyIrTys(), 0, emptyIrBlocks(), false, false, emptyStrs()))
        this.fidList.push(fid)
        this.fsource[fid] = src
        fid
    }


    /// The runtime symbol for a top-level callable, honoring an
    /// `#[symbol("...")]` attribute override so a function can claim an exact ABI
    /// symbol (e.g. a ported runtime's `pickle_str_len`).
    fn symbolForAttrs(name: string, isTest: bool, attrs: List<Attribute>) -> string {
        if (let some(s) = itemSymbol(attrs)) {
            this.overrides.push(s)
            return s
        }
        symbolFor(name, isTest)
    }


    /// The single user (non-builtin, non-overloaded) callable for `name`.
    fn userCallable(name: string) -> CallableInfo? {
        if (let some(infos) = this.resolved.fns.get(name)) {
            var users = emptyCallableInfos()
            for (c in infos) {
                if (!(c.span.start == 0 && c.span.end == 0)) {
                    users.push(c)
                }
            }
            if (len(users) == 1) {
                return users[0]
            }
        }
        none
    }

    // ---- diagnostics & type lowering ----

    fn bad(span: Span, msg: string) -> bool {
        this.failed = true
        var d = Diagnostic.errorAt(span, "codegen: " + msg)
        if (containsStr(msg, "not lowered yet")) {
            d = d.withCode("E0900")
        }
        this.report(d)
        false
    }

    fn badSpanNote(msg: string) -> bool {
        this.failed = true
        var d = Diagnostic.errorAt(Span(0, 0), "codegen: " + msg)
        if (containsStr(msg, "not lowered yet")) {
            d = d.withCode("E0900")
        }
        this.report(d)
        false
    }

    /// Hand a diagnostic to the sink, unless pass 1 is still running.
    ///
    /// Pass 1 exists only to measure call edges, so anything it has to say is
    /// either going to be said again by pass 2 or never true. Buffering keeps a
    /// diagnostic from being emitted twice in the case where pass 1 both reports
    /// it and fails: `emit` replays the buffer and returns without running pass 2.
    /// A pass 1 that reports nothing still clears the buffer, since a clean
    /// pass 1 means there was nothing to hold on to.
    fn report(d: Diagnostic) {
        if (this.analyzing) {
            this.suppressed.push(d)
        } else {
            this.diags.emit(d)
        }
    }

    /// The inferred type of an expression span, substituted through the active
    /// generic instantiation.
    fn tyOf(span: Span) -> Ty? {
        if (let some(t) = this.types.get(spanKey(span))) {
            return this.substTy(t)
        }
        none
    }

    /// Apply the active generic-parameter substitution to an inferred type.
    /// No-op outside instantiated generic bodies.
    fn substTy(ty: Ty) -> Ty {
        if (len(this.currentSubst) == 0) {
            return ty
        }
        subst(ty, this.currentSubst)
    }


/// Lower a checked type to its IR type.
    fn mapTy(t: Ty, span: Span) -> IrTy? {
        match (t) {
            case Ty.Bool -> IrTy.Bool
            case Ty.Char -> IrTy.Char
            case Ty.Byte -> IrTy.Int
            case Ty.Int -> IrTy.Int
            case Ty.Float -> IrTy.Float
            case Ty.String -> IrTy.Str
            case Ty.None | Ty.Empty -> IrTy.Unit
            case Ty.Ptr(inner) -> refIrTy(inner)
            case Ty.Ref(inner) -> refIrTy(inner)
            case Ty.Fn(_, _) -> IrTy.Ptr
            case Ty.Option(_) | Ty.Class(_, _) | Ty.Struct(_, _) | Ty.Enum(_, _) | Ty.Interface(_, _) | Ty.List(_) | Ty.Map(_, _) | Ty.Tuple(_) | Ty.Range(_) | Ty.Stream -> IrTy.Ptr
            case Ty.Unknown -> {
                this.bad(span, "untyped expression cannot be lowered")
                none
            }
            case Ty.Var(_) -> {
                this.bad(span, "generic functions are not lowered yet")
                none
            }
        }
    }


    /// Lower the inferred type of an expression span.
    fn irty(span: Span) -> IrTy? {
        if (let some(t) = this.tyOf(span)) {
            return this.mapTy(t, span)
        }
        this.bad(span, "no inferred type available for this expression")
        none
    }

    /// Lower an explicit type annotation to its IR type. Mirrors `annot_ty`
    /// in emit.rs.
    fn annotTy(ty: TypeExpr?, span: Span) -> IrTy? {
        if (let some(te) = ty) {
            match (te.kind) {
                case TypeExprKind.Path(parts) -> {
                    if (len(parts) == 1) {
                        match (parts[0]) {
                            case "Int" -> IrTy.Int
                            case "Float" -> IrTy.Float
                            case "Bool" -> IrTy.Bool
                            case "Char" -> IrTy.Char
                            case "String" -> IrTy.Str
                            case _ -> IrTy.Ptr
                        }
                    } else {
                        IrTy.Ptr
                    }
                }
                case TypeExprKind.Pointer(inner) -> this.refAnnot(inner, span)
                case TypeExprKind.Ref(inner) -> this.refAnnot(inner, span)
                case _ -> {
                    this.bad(span, "this type annotation is not lowered yet")
                    none
                }
            }
        } else {
            this.bad(span, "`let` requires an initializer or a type annotation")
            none
        }
    }

    fn refAnnot(inner: TypeExpr, span: Span) -> IrTy? {
        var opt: TypeExpr? = inner
        var base = this.annotTy(opt, span)
        match (base) {
            case some(_) -> IrTy.Ptr
            case none -> none
        }
    }

    fn ensureInt(e: Expr) -> bool {
        match (this.tyOf(e.span)) {
            case some(Ty.Int) -> true
            case _ -> {
                this.bad(e.span, "range bounds must be `int`")
                false
            }
        }
    }

    // ---- allocation helpers ----

    /// A fresh virtual register id for a value produced one instruction at a
    /// time (the IR's `Temp`).
    fn temp() -> int {
        var t = this.nextTemp
        this.nextTemp = this.nextTemp + 1
        t
    }

    /// A register holding the value-typed `0` (Pk's unit representation). Lets
    /// `Temp` and `Slot` helpers avoid an `Option` round-trip.
    fn unitTemp() -> int {
        var t = this.temp()
        this.instr(IrInstr.Const(t, IrConst.Int(0)))
        t
    }

    /// Append a slot and return its index (`Slot`).
    fn newSlot(ty: IrTy) -> int {
        var s = len(this.fslots)
        this.fslots.push(ty)
        s
    }

    /// Load an already-declared slot into a fresh temp.
    fn load(slot: int) -> int {
        var d = this.temp()
        this.instr(IrInstr.LoadSlot(d, slot))
        d
    }

    /// A fresh block id appended to `blocks` with an `Unreachable` terminator.
    fn newBlock() -> int {
        var id = this.nextBlock
        this.nextBlock = this.nextBlock + 1
        this.blocks.push(IrBlock(id, emptyIrInstrs(), IrTerm.Unreachable))
        id
    }

    /// Append an instruction to the current block.
    fn instr(i: IrInstr) {
        this.blocks[this.cur].instrs.push(i)
    }

    /// Set the current block's terminator.
    fn term(t: IrTerm) {
        this.blocks[this.cur].term = t
    }

    /// Enter a new lexical scope for the build environment.
    fn pushScope() {
        this.env.push(seedIntScopeMap())
        this.manualEnv.push(seedScopeMap())
    }

    /// Leave the current build-environment scope.
    fn popScope() {
        this.env.pop()
        this.manualEnv.pop()
    }

    /// Bind a name to a slot in the innermost scope.
    fn declare(name: string, slot: int) {
        var scope = this.env[len(this.env) - 1]
        scope[name] = slot
    }

    /// Record `name` as a `#[manualAlloc]` binding in the current scope.
    fn declareManual(name: string) {
        var scope = this.manualEnv[len(this.manualEnv) - 1]
        scope[name] = true
    }

    /// Is `name` a `#[manualAlloc]` binding in any enclosing scope?
    fn isManual(name: string) -> bool {
        var i = len(this.manualEnv) - 1
        while (i >= 0) {
            if (this.manualEnv[i].has(name)) {
                return true
            }
            i = i - 1
        }
        false
    }

    /// Walk the build environment scopes (innermost first) for a name's slot.
    fn lookup(name: string) -> int? {
        var i = len(this.env) - 1
        while (i >= 0) {
            if (this.env[i].has(name)) {
                return this.env[i][name]
            }
            i = i - 1
        }
        none
    }

    /// Bind the resolved parameter list at function entry. Slots are the
    /// parameter indices (0-based), matching the callee ABI.
    fn declareParams(params: List<ParamInfo>) {
        var i = 0
        while (i < len(params)) {
            var p = params[i]
            var m = this.mapTy(p.ty, p.span)
            var ir = IrTy.Ptr
            if (let some(r) = m) {
                ir = r
            }
            var slot = i
            this.fslots.push(ir)
            this.fparams.push(IrParam(p.name, ir))
            this.declare(p.name, slot)
            i = i + 1
        }
    }

    /// Adopt every `#[manualAlloc]` parameter at function entry so the callee
    /// owns (and is responsible for freeing) the incoming allocation.
    fn adoptManualParams(params: List<Param>) {
        for (p in params) {
            var hasManual = false
            for (a in p.attrs) {
                if (a.name == "manualAlloc") {
                    hasManual = true
                }
            }
            if (!hasManual) {
                continue
            }
            if (let none = this.lookup(p.name)) {
                continue
            }
            var slot = 0
            if (let some(s) = this.lookup(p.name)) {
                slot = s
            }
            var v = this.load(slot)
            var a2 = this.externCallT1("pickle_manual_adopt", [IrTy.Ptr], IrTy.Ptr, [v])
            this.instr(IrInstr.StoreSlot(slot, a2))
            this.declareManual(p.name)
        }
    }

    /// Declare an extern's id, deduplicating by `(symbol, params, ret)`.
    fn externId(symbol: string, params: List<IrTy>, ret: IrTy) -> int {
        var i = 0
        while (i < len(this.irModule.externs)) {
            var ex = this.irModule.externs[i]
            if (ex.symbol == symbol && irTysEqual(ex.params, params) && irTyTag(ex.ret) == irTyTag(ret)) {
                return i
            }
            i = i + 1
        }
        this.irModule.externs.push(IrExtern(symbol, params, ret))
        len(this.irModule.externs) - 1
    }

    /// Emit a call to an extern taking one value, producing one value.
    fn externCallT1(symbol: string, params: List<IrTy>, ret: IrTy, args: List<int>) -> int {
        var ex = this.externId(symbol, params, ret)
        var dst = this.temp()
        this.instr(IrInstr.Call(dst, Callee.Extern(ex), args))
        dst
    }

    /// Lift a scalar value to the managed-pointer representation used for
    /// `Option<T>` (and pointer-typed boundaries). `none`/already-managed
    /// values pass through untouched; scalars are boxed. Mirrors `option_wrap`.
    fn optionWrap(v: int, ty: Ty, span: Span) -> int? {
        match (ty) {
            case Ty.Int -> this.externCallT1("pickle_box_i64", [IrTy.Int], IrTy.Ptr, [v])
            case Ty.Float -> this.externCallT1("pickle_box_f64", [IrTy.Float], IrTy.Ptr, [v])
            case Ty.Bool -> this.externCallT1("pickle_box_bool", [IrTy.Bool], IrTy.Ptr, [v])
            case Ty.Byte -> this.externCallT1("pickle_box_i64", [IrTy.Int], IrTy.Ptr, [v])
            case Ty.Char -> this.externCallT1("pickle_box_char", [IrTy.Char], IrTy.Ptr, [v])
            case _ -> {
                let _ = span
                v
            }
        }
    }

    /// Mirror of `boxForStore` for boundaries that are not list/map element
    /// slots: when the destination representation is `Ptr`, a scalar source
    /// (e.g. `let m: int? = 5`) must be lifted via `optionWrap` first.
    fn packForPointerBoundary(rep: ElemRep, v: int, vt: Ty, span: Span) -> int? {
        if (rep.isPtr) {
            this.optionWrap(v, vt, span)
        } else {
            v
        }
    }

    /// The zero value of a scalar type, as an IR temp.
    fn zeroScalar(ir: IrTy, span: Span) -> int? {
        var dst = this.temp()
        var c = IrConst.Int(0)
        var ok = true
        match (ir) {
            case IrTy.Int -> {
                c = IrConst.Int(0)
                ok = true
            }
            case IrTy.Float -> {
                c = IrConst.Float(0.0)
                ok = true
            }
            case IrTy.Bool -> {
                c = IrConst.Bool(false)
                ok = true
            }
            case IrTy.Char -> {
                c = IrConst.Char(0 as char)
                ok = true
            }
            case _ -> ok = false
        }
        if (!ok) {
            this.bad(span, "no zero value for this IR type")
            return none
        }
        this.instr(IrInstr.Const(dst, c))
        dst
    }

    /// A null pointer constant (`IrConst::Null`).
    fn nullTemp() -> int? {
        var dst = this.temp()
        this.instr(IrInstr.Const(dst, IrConst.Null))
        dst
    }

/// The lowered parameter types of `fid` (empty before the callee's body is
    /// emitted). Mirrors reading `src_param_tys` from `emit.rs`.
    fn srcParamList(fid: int) -> List<Ty> {
        var p = emptyTys()
        if (let some(v) = this.srcParamTys.get(fid)) {
            p = v
        }
        p
    }

    /// The resolved return type of `fid`.
    fn callRetFor(fid: int) -> Ty {
        var ret = Ty.Unknown
        if (let some(i) = this.finfo.get(fid)) {
            ret = i.ret
        }
        ret
    }

    /// How a `List<T>` element is represented at the runtime boundary.
    fn elemRep(elem: Ty, span: Span) -> ElemRep? {
        match (elem) {
            case Ty.Int -> ElemRep.scalar("pickle_box_i64", "pickle_unbox_i64", IrTy.Int)
            case Ty.Float -> ElemRep.scalar("pickle_box_f64", "pickle_unbox_f64", IrTy.Float)
            case Ty.Bool -> ElemRep.scalar("pickle_box_bool", "pickle_unbox_bool", IrTy.Bool)
            case Ty.Byte -> ElemRep.scalar("pickle_box_i64", "pickle_unbox_i64", IrTy.Int)
            case Ty.Char -> ElemRep.scalar("pickle_box_char", "pickle_unbox_char", IrTy.Char)
case Ty.String | Ty.Option(_) | Ty.Class(_, _) | Ty.Struct(_, _) | Ty.Enum(_, _) | Ty.Interface(_, _) | Ty.List(_) | Ty.Map(_, _) | Ty.Tuple(_) | Ty.Range(_) | Ty.Stream | Ty.Ptr(_) | Ty.Fn(_, _) -> ElemRep.ptr()
            case Ty.Ref(inner) -> {
                if (let some(_) = scalarIr(inner)) {
                    ElemRep.scalar("pickle_box_i64", "pickle_unbox_i64", IrTy.Int)
                } else {
                    ElemRep.ptr()
                }
            }
            case Ty.None | Ty.Empty -> {
                this.bad(span, "a list of `none` has no element representation")
                none
            }
            case Ty.Unknown -> {
                this.bad(span, "list element type is not statically known")
                none
            }
            case Ty.Var(_) -> {
                this.bad(span, "generic element types are not lowered yet")
                none
            }
        }
    }

    /// How a `Map<K, ...>` key is represented at the runtime boundary. Mirrors
    /// `key_rep` in emit.rs.
    fn keyRep(kty: Ty, span: Span) -> ElemRep? {
        match (kty) {
            case Ty.String -> ElemRep.ptr()
            case Ty.Int -> ElemRep.scalar("pickle_box_i64", "pickle_unbox_i64", IrTy.Int)
            case Ty.Float -> ElemRep.scalar("pickle_box_f64", "pickle_unbox_f64", IrTy.Float)
            case Ty.Bool -> ElemRep.scalar("pickle_box_bool", "pickle_unbox_bool", IrTy.Bool)
            case Ty.Byte -> ElemRep.scalar("pickle_box_i64", "pickle_unbox_i64", IrTy.Int)
            case Ty.Char -> ElemRep.scalar("pickle_box_char", "pickle_unbox_char", IrTy.Char)
case Ty.List(_) | Ty.Map(_, _) | Ty.Class(_, _) | Ty.Struct(_, _) | Ty.Enum(_, _) | Ty.Interface(_, _) | Ty.Range(_) | Ty.Option(_) | Ty.Tuple(_) -> ElemRep.ptr()
            case Ty.Stream -> {
                this.bad(span, "`Stream` map keys are not lowered yet")
                none
            }
            case Ty.Ref(_) -> {
                this.bad(span, "`&T` map keys are not lowered yet")
                none
            }
            case Ty.None | Ty.Empty -> {
                this.bad(span, "a map key of type `none` is impossible")
                none
            }
            case Ty.Unknown -> {
                this.bad(span, "map key type is not statically known")
                none
            }
            case Ty.Var(_) -> {
                this.bad(span, "generic map key types are not lowered yet")
                none
            }
            case Ty.Ptr(_) -> {
                this.bad(span, "`T*` map keys are not lowered yet")
                none
            }
            case Ty.Fn(_, _) -> {
                this.bad(span, "function map keys are not lowered yet")
                none
            }
        }
    }

/// The element type `T` of an `Iterable<T>` value (mirror of the
    /// checker's rule): either the interface type `Iterable<int>` directly, or
    /// a class/struct that transitively declares `implements Iterable<...>`
    /// with its own generic args substituted (so `MyList<string>` yields
    /// `string`). `none` when the value is not iterable via the protocol.
    /// Mirrors `iterable_elem` in emit.rs.
    fn iterableElem(ty: Ty) -> Ty? {
        match (ty) {
            case Ty.Interface(n, args) -> {
                if (n == "Iterable") {
                    if (len(args) > 0) {
                        return args[0]
                    }
                    return Ty.Unknown
                }
                return none
            }
            case _ -> {}
        }
        var name = ""
        var args = emptyTys()
        match (ty) {
            case Ty.Class(n, a) -> {
                name = n
                args = a
            }
            case Ty.Struct(n, a) -> {
                name = n
                args = a
            }
            case _ -> {
                return none
            }
        }
        var argsMap = emptyStringTyMap()
        if (let some(entry) = this.resolved.types.get(name)) {
            var gs = entryGenerics(entry)
            var i = 0
            while (i < len(gs)) {
                if (i < len(args)) {
                    argsMap[gs[i]] = args[i]
                } else {
                    argsMap[gs[i]] = Ty.Unknown
                }
                i = i + 1
            }
        }
        var chain = emptyStrs()
        var seen = emptyStrs()
        chain.push(name)
        while (len(chain) > 0) {
            var cname = chain[len(chain) - 1]
            chain.pop()
            if (strListHas(seen, cname)) {
                continue
            }
            seen.push(cname)
            var table: ClassTable? = none
            match (this.resolved.types.get(cname)) {
                case some(TypeTableEntry.Class(t)) -> table = t
                case some(TypeTableEntry.Struct(t)) -> table = t
                case _ -> {}
            }
            if (let none = table) {
                continue
            }
            if (let some(t) = table) {
                for (i2 in t.implements) {
                    match (i2) {
                        case Ty.Interface(iname, iargs) -> {
                            if (iname == "Iterable") {
                                var el = Ty.Unknown
                                if (len(iargs) > 0) {
                                    el = iargs[0]
                                }
                                return subst(el, argsMap)
                            }
                        }
                        case _ -> {}
                    }
                }
                if (let some(p) = t.extends) {
                    if (let some(nm) = named(p)) {
                        chain.push(nm)
                    }
                }
            }
        }
        none
    }

    /// Read one field slot of a managed object: `pickle_obj_slot_get` (mdv-63
    /// `mdv_09 slot`), unboxed when the field carries a scalar boundary type.
fn fieldRead(span: Span, obj: int, fieldTy: Ty, slot: int) -> int? {
        var rep = ElemRep.ptr()
        if (let some(r) = this.elemRep(fieldTy, span)) {
            rep = r
        } else {
            return none
        }
        var idx = this.intConst(slot)
        var raw = this.externCallT1("pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idx])
        if (rep.isPtr) {
            return raw
        }
        this.externCallT1(rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
    }

    /// Push a `break`/`continue` target pair for a loop.
    fn pushLoop(bt: int, ct: int) {
        this.loops.push(LoopCtx(ct, bt))
    }

    /// The innermost loop's `break` target, if inside a loop.
    fn loopBreakTarget() -> int? {
        if (len(this.loops) == 0) {
            return none
        }
        this.loops[len(this.loops) - 1].breakTarget
    }

    /// The innermost loop's `continue` target, if inside a loop.
    fn loopContinueTarget() -> int? {
        if (len(this.loops) == 0) {
            return none
        }
        this.loops[len(this.loops) - 1].continueTarget
    }

/// Intern a string into the module's string table, returning its id.
    fn internString(s: string) -> int {
        if (let some(id) = this.strIds.get(s)) {
            id
        } else {
            var bs = bytesOf(s)
            this.irModule.strings.push(bs)
            var id = len(this.irModule.strings) - 1
            this.strIds[s] = id
            id
        }
    }

    /// Emit a `Const Str` temp for `text`.
    fn strConst(text: string) -> int {
        var t = this.temp()
        this.instr(IrInstr.Const(t, IrConst.Str(this.internString(text))))
        t
    }

    /// Emit a `Const Int` temp for `v`.
    fn intConst(v: int) -> int {
        var t = this.temp()
        this.instr(IrInstr.Const(t, IrConst.Int(v)))
        t
    }

    /// Emit a `Const Bool` temp for `b`.
    fn boolConst(b: bool) -> int {
        var t = this.temp()
        this.instr(IrInstr.Const(t, IrConst.Bool(b)))
        t
    }

    /// Emit a `Const Char` temp for code point `v`.
    fn charConst(v: int) -> int {
        var t = this.temp()
        this.instr(IrInstr.Const(t, IrConst.Char(v as char)))
        t
    }

    /// Emit a `Const Float` temp for `v`.
    fn floatConst(v: float) -> int {
        var t = this.temp()
        this.instr(IrInstr.Const(t, IrConst.Float(v)))
        t
    }

    /// Emit any `IrConst` as a fresh temp.
    fn constTemp(c: IrConst) -> int {
        var t = this.temp()
        this.instr(IrInstr.Const(t, c))
        t
    }


    /// `extern_call_void`: a call whose result is discarded (returns unit).
    fn externCallVoid(symbol: string, params: List<IrTy>, args: List<int>) {
        var ex = this.externId(symbol, params, IrTy.Unit)
        this.instr(IrInstr.Call(none, Callee.Extern(ex), args))
    }

    /// Report a non-exhaustive enum match that fell through the whole chain.
    fn panicNoMatchAt(span: Span, sv: int) {
        this.externCallVoid("pickle_panic_no_match", emptyIrTys(), emptyInts())
    }


    /// Fold a string temp list with `pickle_str_concat`. Mirrors `concat_strs`.
    fn concatStr(parts: List<int>) -> int? {
        if (len(parts) == 0) {
            return this.strConst("")
        }
        var acc = parts[0]
        var i = 1
        while (i < len(parts)) {
            acc = this.externCallT1("pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [acc, parts[i]])
            i = i + 1
        }
        acc
    }

    /// Lower a string literal: plain text becomes a `Const Str` temp;
    /// interpolated sub-expressions are stringified with the `pickle_str_from_*`
    /// helpers and concatenated. Mirrors `string_literal` in emit.rs.
    fn stringLiteral(parts: List<StrPart>) -> int? {
        var acc = -1
        var hasAcc = false
        for (part in parts) {
            var v = -1
            match (part) {
                case StrPart.Text(text) -> {
                    var t = this.temp()
                    this.instr(IrInstr.Const(t, IrConst.Str(this.internString(text))))
                    v = t
                }
                case StrPart.Expr(e) -> {
                    var vx = -1
                    if (let some(te) = this.expr(e)) {
                        vx = te
                    } else {
                        return none
                    }
                    var isByte = false
                    if (let some(bt) = this.tyOf(e.span)) {
                        match (bt) {
                            case Ty.Byte -> isByte = true
                            case _ -> {}
                        }
                    }
                    if (isByte) {
                        vx = this.externCallT1("pickle_str_from_byte", [IrTy.Int], IrTy.Str, [vx])
                    } else {
                        var kind = -1
                        if (let some(it) = this.irty(e.span)) {
                            kind = irTyTag(it)
                        } else {
                            return none
                        }
                        if (kind == irTyTag(IrTy.Int)) {
                            vx = this.externCallT1("pickle_str_from_i64", [IrTy.Int], IrTy.Str, [vx])
                        } else if (kind == irTyTag(IrTy.Float)) {
                            vx = this.externCallT1("pickle_str_from_f64", [IrTy.Float], IrTy.Str, [vx])
                        } else if (kind == irTyTag(IrTy.Bool)) {
                            vx = this.externCallT1("pickle_str_from_bool", [IrTy.Bool], IrTy.Str, [vx])
                        } else if (kind == irTyTag(IrTy.Char)) {
                            vx = this.externCallT1("pickle_str_from_char", [IrTy.Char], IrTy.Str, [vx])
                        } else if (kind != irTyTag(IrTy.Str)) {
                            this.bad(e.span, "interpolation of this IR type is not lowered yet")
                            return none
                        }
                    }
                    v = vx
                }
            }
            if (!hasAcc) {
                acc = v
            } else {
                acc = this.externCallT1("pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [acc, v])
            }
            hasAcc = true
        }
        if (!hasAcc) {
            var t2 = this.temp()
            this.instr(IrInstr.Const(t2, IrConst.Str(this.internString(""))))
            return t2
        }
        acc
    }

    /// Lower a literal expression. Float literals defer to a pure text-to-float
    /// conversion (`floatVal`).
    fn lit(l: Lit) -> int? {
        match (l) {
            case Lit.Int(value) -> this.intConst(value)
            case Lit.Float(text) -> this.floatConst(floatVal(text))
            case Lit.Bool(b) -> this.boolConst(b)
            case Lit.Char(c) -> this.charConst(c as int)
            case Lit.String(parts) -> {
                var ph = this.temp()
                this.stringLiteral(parts)
            }
case Lit.None -> {
                var ph = this.temp()
                this.nullTemp()
            }
        }
    }

    // ---- expression hub ----

    /// The expression lowering hub (mirror of `expr` in emit.rs). Kinds whose
    /// lowering lives in later sub-slices (calls, binary/unary/assign, if/let,
/// Ice guard: deep recursion without `TRICK_COUNT` pops means the ported
    /// emitter re-entered a cycle. Report the tail of the route taken.
    fn icePathTail() -> string {
        var tail = ""
        var n = len(this.icePath)
        var start = 0
        if (n > 24) {
            start = n - 24
        }
        var k = start
        while (k < n) {
            tail += this.icePath[k] + " -> "
            k = k + 1
        }
        tail
    }

    /// Catches an unwrapped recursion cycle by looking for a short repeating
    /// period in the monotonic ledger of hot lowering-function entries. Pk's
    /// explicit-return style defeats entry/exit bookkeeping, so this uses the
    /// repetition itself: a runaway loop prints itself within a few laps,
    /// well before the native stack bottoms out.
    fn icePoke(g: string) -> bool {
        if (len(this.iceSeq) > 1000) {
            var nxt = emptyStrs()
            var start = len(this.iceSeq) - 400
            var i = start
            while (i < len(this.iceSeq)) {
                nxt.push(this.iceSeq[i])
                i = i + 1
            }
            this.iceSeq = nxt
        }
        this.iceSeq.push(g)
        var n = len(this.iceSeq)
        var maxP = 60
        var minLaps = 100000
        if (n <= maxP * 2) {
            return true
        }
        var p = 2
        while (p <= maxP) {
            var ok = true
            var j = 0
            while (j < p) {
                if (this.iceSeq[n - p - 1 - j] != this.iceSeq[n - 1 - j]) {
                    ok = false
                    j = p
                }
                j = j + 1
            }
            if (ok) {
                var laps = 1
                var back = 2 * p
                while (back + p <= n) {
                    var still = true
                    var m = 0
                    while (m < p) {
                        if (this.iceSeq[n - back - m] != this.iceSeq[n - back + p - m]) {
                            still = false
                            m = p
                        }
                        m = m + 1
                    }
                    if (!(still)) {
                        back = n + p
                    } else {
                        laps = laps + 1
                        back = back + p
                    }
                }
                if (laps >= minLaps) {
                    return false
                }
            }
            p = p + 1
        }
        true
    }

fn expr(e: Expr) -> int? {
        if (this.iceDepth > 150) {
            return none
        }
        this.iceDepth = this.iceDepth + 1
        this.icePath.push("expr")
        var r = this.expr1(e)
        this.iceDepth = this.iceDepth - 1
        r
    }

fn expr1(e: Expr) -> int? {
        if (!this.icePoke("expr1")) {
            return none
        }
        if (let none = this.irty(e.span)) {
            return none
        }
        match (e.kind) {
            case ExprKind.Lit(l) -> this.lit(l)
            case ExprKind.Ident(name) -> this.identExpr(e, name)
            case ExprKind.Call(callee, args) -> this.call(e, callee, args)
            case ExprKind.Binary(op, lhs, rhs) -> this.binary(e, op, lhs, rhs)
            case ExprKind.Unary(op, operand) -> this.unary(e, op, operand)
            case ExprKind.Assign(target, op, value) -> this.assign(e, target, op, value)
            case ExprKind.If(cond, then, elseElse) -> this.ifExpr(e, cond, then, elseElse)
            case ExprKind.Block(b) -> {
                this.pushScope()
                var r = this.blockValue(b)
                this.popScope()
                r
            }
            case ExprKind.This -> this.thisValue(e)
            case ExprKind.Super -> this.thisValue(e)
            case ExprKind.Member(object, name) -> this.memberValue(e, object, name)
            case ExprKind.Index(object, index) -> this.indexRead(e, object, index)
            case ExprKind.OptAccess(object, name) -> this.optAccess(e, object, name)
            case ExprKind.OptUnwrap(inner) -> this.optUnwrap(e, inner)
            case ExprKind.Lambda(_p, _r, _a, _b) -> this.lambdaValue(e)
            case ExprKind.Match(scrutinee, arms) -> this.matchExpr(e, scrutinee, arms)
            case ExprKind.Await(inner) -> {
                var t0: Ty? = none
                if (let some(t) = this.tyOf(inner.span)) {
                    t0 = t
                }
                // A future is a captured zero-argument closure (`() -> R`):
                // drive it by calling it with no arguments.
                var emptyFn = false
                var prt = Ty.None
                match (t0) {
                    case some(Ty.Fn(ps, r)) -> {
                        if (len(ps) == 0) {
                            emptyFn = true
                            prt = r
                        }
                    }
                    case _ -> {}
                }
                if (emptyFn) {
                    var obj = 0
                    if (let some(o) = this.expr(inner)) {
                        obj = o
                    } else {
                        return none
                    }
                    return this.fnValueCallFrom(e, obj, Ty.Fn(emptyTyList(), prt), emptyCallArgs())
                }
                match (t0) {
                    case some(Ty.Unknown) -> {
                        this.bad(inner.span, "cannot `await` a value whose type is unknown; an `async fn` call returns a `() -> T` future")
                    }
                    case some(Ty.Fn(_, _)) -> {
                        this.bad(inner.span, "a function taking arguments; a future is a zero-argument function")
                    }
                    case some(t2) -> {
                        this.bad(inner.span, "cannot `await` a value of type `{bareName(t2)}`; a future is the `() -> T` value returned by an `async fn`")
                    }
                    case none -> {
                        this.bad(inner.span, "an untyped value")
                    }
                }
                none
            }
            case ExprKind.GenericCall(name, typeArgs) -> this.genericFnValue(e, name, typeArgs)
            case ExprKind.Cast(ex, ty, k) -> this.cast(e, ex, ty, k)
            case ExprKind.Unsafe(b) -> {
                this.pushScope()
                var r = this.blockValue(b)
                this.popScope()
                r
            }
            case ExprKind.Tuple(items) -> this.tupleLiteral(e, items)
            case ExprKind.Array(items) -> this.arrayLiteral(e, items)
            case ExprKind.Map(entries) -> this.mapLiteral(e, entries)
            case ExprKind.Range(_s, _e, _i) -> {
                this.bad(e.span, "range values are not lowered yet")
                none
            }
        }
    }

    /// `this` / bare-name locals in instance context: read a bare field; the
    /// getter for a bare property; a static field of the enclosing class; or a
    /// class constant of the enclosing class. Mirrors `ident_expr` in emit.rs.
fn identExpr(e: Expr, name: string) -> int? {
   if (let some(slot) = this.lookup(name)) {
   return this.load(slot)
   }
   // A top-level `var` is a real data slot: read it. This must be checked
   // *before* the const inline so a global is never mistaken for a value.
   if (this.globalIds.has(name)) {
   var gid: int? = none
   gid = this.globalIds[name]
   if (let some(id) = gid) {
   var ty = this.irModule.globals[id].ty
   var dst = this.temp()
   this.instr(IrInstr.LoadGlobal(dst, id, ty))
   return dst
   }
   }
   if (this.constsInits.has(name)) {
            if (strListHas(this.constInlining, name)) {
                this.bad(e.span, "cyclic `const` initialization of `" + name + "`")
                return none
            }
            this.constInlining.push(name)
            var ini = this.constsInits.get(name)
            if (let some(ini) = ini) {
                var t = this.expr(ini)
                this.constInlining.pop()
                return t
            }
            this.constInlining.pop()
            return none
        }
        if (let some(cid) = this.owner) {
            if (let some(slot) = this.instanceFieldIndex(cid, name)) {
                var fieldTy = this.fieldAt(cid, slot).ty
                var tv = this.thisValue(e)
                if (let some(tv) = tv) {
                    return this.fieldRead(e.span, tv, fieldTy, slot)
                }
                return none
            }
            if (let some(fid) = this.propertyIds.get(tripleKey(str(cid), name, str(false)))) {
                var tthis = this.thisValue(e)
                if (let some(tthis) = tthis) {
                    return this.callMethod(e, fid, emptyCallArgs(), tthis)
                }
                return none
            }
            if (let some(sf) = this.staticField(cid, name)) {
                return this.staticRead(e.span, sf.dcid, sf.slot, sf.info.ty)
            }
            if (let some(r) = this.readClassConst(e.span, cid, name)) {
                return r
            }
        }
        if (let some(fid) = this.irModule.funcsByName.get(name)) {
            return this.fnValueClosure(e, fid)
        }
        if (this.genericUserFn(name)) {
            this.bad(e.span, "using the generic function `" + name + "` as a value is not lowered yet; call it with explicit type arguments instead")
            return none
        }
        this.bad(e.span, "using `" + name + "` as a value is not lowered yet")
        none
    }

    /// The current receiver `this`, when available. Mirrors `this_value`.
    fn thisValue(e: Expr) -> int? {
        if (let some(slot) = this.lookup("this")) {
            return this.load(slot)
        }
        this.bad(e.span, "`this` is not available here")
        none
    }

    /// `object.name`: enum variants, class/struct instance fields, instance
    /// properties (deferred), bound methods (deferred), and `Type.member`
    /// static reads/class consts. Mirrors `member_value` in emit.rs.
    fn memberValue(e: Expr, object: Expr, name: string) -> int? {
        if (let some(en) = exprKindIdentName(object)) {
            if (let some(entry) = this.resolved.types.get(en)) {
                match (entry) {
                    case TypeTableEntry.Enum(t) -> {
                        var vix = -1
                        var found = false
                        var hasPayload = false
                        var i = 0
                        for (v in t.variants) {
                            if (v.name == name) {
                                vix = i
                                found = true
                                hasPayload = len(v.fields) > 0
                                break
                            }
                            i = i + 1
                        }
                        if (!found) {
                            this.bad(e.span, "enum `" + t.name + "` has no variant `" + name + "`")
                            return none
                        }
                        if (hasPayload) {
                            this.bad(e.span, "variant `" + name + "` carries " + str(len(t.variants[vix].fields)) + " payload field(s) and needs `" + name + "(...)`")
                            return none
                        }
                        var tag = this.intConst(vix)
                        var zero = this.intConst(0)
                        return this.externCallT1("pickle_enum_new", [IrTy.Int, IrTy.Int], IrTy.Ptr, [tag, zero])
                    }
                    case _ -> {}
                }
            }
        }
        var ot = this.tyOf(object.span)
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Ptr(iner) -> ot = iner
                case Ty.Ref(iner) -> ot = iner
                case _ -> {}
            }
        }
        var cid: int? = none
        if (let some(pt) = ot) {
            match (pt) {
                case Ty.Class(_, _) -> cid = this.classIdOf(pt, e.span)
                case Ty.Struct(_, _) -> cid = this.classIdOf(pt, e.span)
                case _ -> {}
            }
        }
        if (let some(cc) = cid) {
            if (let some(slot) = this.instanceFieldIndex(cc, name)) {
                var fieldTy = this.fieldAt(cc, slot).ty
                var obj = this.expr(object)
                if (let some(obj) = obj) {
                    return this.fieldRead(e.span, obj, fieldTy, slot)
                }
                return none
            }
            if (let some(fid) = this.propertyIds.get(tripleKey(str(cc), name, str(false)))) {
                var obj = this.expr(object)
                if (let some(obj) = obj) {
                    return this.callMethod(e, fid, emptyCallArgs(), obj)
                }
                return none
            }
            if (let some(mref) = this.methodIds.get(pairKey(str(cc), name))) {
                if (mref.isStatic) {
                    this.bad(e.span, "static method `" + name + "` cannot be used as a value")
                    return none
                }
                return this.boundMethodValue(e, object)
            }
            this.bad(e.span, "method `" + name + "` of `" + this.classOfName(cc) + "` cannot be used as a value")
            return none
        }
        if (let some(tname) = exprKindIdentName(object)) {
            if (let some(cx) = this.classByName.get(tname)) {
                if (let some(fid) = this.staticPropertyIds.get(tripleKey(str(cx), name, str(false)))) {
                    return this.callMethod(e, fid, emptyCallArgs(), none)
                }
                if (let some(sf) = this.staticField(cx, name)) {
                    return this.staticRead(e.span, sf.dcid, sf.slot, sf.info.ty)
                }
                if (let some(r) = this.readClassConst(e.span, cx, name)) {
                    return r
                }
                this.bad(e.span, "static member `" + name + "` on `" + tname + "` is not lowered yet")
                return none
            }
        }
        this.bad(e.span, "member access is not lowered yet")
        none
    }

    // ---- option expressions ----

    /// `p != null`: whether an option pointer is present.
    fn optIsPresent(p: int) -> int? {
        var nul = this.nullTemp()
        if (let some(n) = nul) {
            var dst = this.temp()
            this.instr(IrInstr.BinOp(dst, IrBinOp.Ne, p, n))
            return dst
        }
        none
    }

    /// Resolve a present option pointer to its inner value: scalars are
    /// unboxed to the element IR type; managed values pass through. Mirrors
    /// `opt_resolve` in emit.rs.
    fn optResolve(p: int, inner: Ty, span: Span) -> int? {
        var ir = this.mapTy(inner, span)
        if (let some(ir) = ir) {
            if (irTyTag(ir) == irTyTag(IrTy.Int)) {
                return this.externCallT1("pickle_unbox_i64", [IrTy.Ptr], IrTy.Int, [p])
            } else if (irTyTag(ir) == irTyTag(IrTy.Float)) {
                return this.externCallT1("pickle_unbox_f64", [IrTy.Ptr], IrTy.Float, [p])
            } else if (irTyTag(ir) == irTyTag(IrTy.Bool)) {
                return this.externCallT1("pickle_unbox_bool", [IrTy.Ptr], IrTy.Bool, [p])
            } else if (irTyTag(ir) == irTyTag(IrTy.Char)) {
                return this.externCallT1("pickle_unbox_char", [IrTy.Ptr], IrTy.Char, [p])
            }
            return p
        }
        none
    }

    /// `a ?? b`: yield the unwrapped `a` when present, else `b`. Mirrors
    /// `null_coalesce` in emit.rs.
fn nullCoalesce(e: Expr, lhs: Expr, rhs: Expr) -> int? {
        var innerTy = Ty.Unknown
        var got = false
        if (let some(t) = this.tyOf(lhs.span)) {
            if (let some(i) = innerOption(t)) {
                innerTy = i
                got = true
            }
        }
        if (!got) {
            this.bad(e.span, "left side of `??` is not an option")
            return none
        }
        var resIr0 = this.mapTy(innerTy, e.span)
        if (let none = resIr0) {
            return none
        }
        var resIr = IrTy.Unit
        if (let some(x) = resIr0) {
            resIr = x
        }
        var resSlot = this.newSlot(resIr)
        var a0 = this.expr(lhs)
        if (let none = a0) {
            return none
        }
        var a = 0
        if (let some(v) = a0) {
            a = v
        }
        var present0 = this.optIsPresent(a)
        if (let none = present0) {
            return none
        }
        var present = 0
        if (let some(p) = present0) {
            present = p
        }
        var someId = this.newBlock()
        var rhsId = this.newBlock()
        var join = this.newBlock()
        this.term(IrTerm.BranchIf(present, someId, rhsId))
        this.cur = someId
        var av0 = this.optResolve(a, innerTy, e.span)
        if (let none = av0) {
            return none
        }
        var av = 0
        if (let some(v) = av0) {
            av = v
        }
        this.instr(IrInstr.StoreSlot(resSlot, av))
        this.term(IrTerm.Branch(join))
        this.cur = rhsId
        var bv = this.expr(rhs)
        if (let none = bv) {
            return none
        }
        var b = 0
        if (let some(v) = bv) {
            b = v
        }
        if (irTyTag(resIr) == irTyTag(IrTy.Ptr)) {
            var vt = Ty.Unknown
            if (let some(gt) = this.tyOf(rhs.span)) {
                vt = gt
            }
            var wv = this.optionWrap(b, vt, rhs.span)
            if (let none = wv) {
                return none
            }
            if (let some(w) = wv) {
                b = w
            }
        }
        this.instr(IrInstr.StoreSlot(resSlot, b))
        this.term(IrTerm.Branch(join))
        this.cur = join
        return this.load(resSlot)
    }

    /// `a?`: unwrap `a` to its inner value, panicking on `none`. Mirrors
    /// `opt_unwrap`.

    fn optUnwrap(e: Expr, operand: Expr) -> int? {
        var innerTy = Ty.Unknown
        var got = false
        if (let some(t) = this.tyOf(operand.span)) {
            if (let some(i) = innerOption(t)) {
                innerTy = i
                got = true
            }
        }
        if (!got) {
            this.bad(e.span, "`?` operand is not an option")
            return none
        }
        var p = this.expr(operand)
        if (let some(p) = p) {
            return this.optUnwrapVal(e.span, p, innerTy)
        }
        none
    }

    /// Unwrap an already-evaluated option pointer `p` to its inner value,
    /// panicking on `none`. Mirrors `opt_unwrap_val`.
    fn optUnwrapVal(span: Span, p: int, inner: Ty) -> int? {
        var resIr0 = this.mapTy(inner, span)
        if (let some(resIr) = resIr0) {
            var resSlot = this.newSlot(resIr)
            var present = this.optIsPresent(p)
            if (let some(present) = present) {
                var someId = this.newBlock()
                var noneId = this.newBlock()
                var join = this.newBlock()
                this.term(IrTerm.BranchIf(present, someId, noneId))
                this.cur = noneId
                this.externCallVoid("pickle_panic_none_unwrap", emptyIrTys(), emptyInts())
                this.term(IrTerm.Branch(join))
                this.cur = someId
                var v = this.optResolve(p, inner, span)
                if (let some(v) = v) {
                    this.instr(IrInstr.StoreSlot(resSlot, v))
                    this.term(IrTerm.Branch(join))
                    this.cur = join
                    return this.load(resSlot)
                }
                return none
            }
            return none
        }
        none
    }

    /// `a?.name`: when `a` is present, read `name` off the receiver and lift it
    /// to `T?`; when it is `none`, the result is `none`. Mirrors `opt_access`.
    fn optAccess(e: Expr, object: Expr, name: string) -> int? {
        var innerTy = Ty.Unknown
        var got = false
        if (let some(t) = this.tyOf(object.span)) {
            if (let some(i) = innerOption(t)) {
                innerTy = i
                got = true
            }
        }
        if (!got) {
            this.bad(e.span, "`?.` requires an option receiver")
            return none
        }
        var o = this.expr(object)
        if (let some(o) = o) {
            var resSlot = this.newSlot(IrTy.Ptr)
            var present = this.optIsPresent(o)
            if (let some(present) = present) {
                var someId = this.newBlock()
                var noneId = this.newBlock()
                var join = this.newBlock()
                this.term(IrTerm.BranchIf(present, someId, noneId))
                this.cur = noneId
                var n = this.nullTemp()
                if (let some(n) = n) {
                    this.instr(IrInstr.StoreSlot(resSlot, n))
                    this.term(IrTerm.Branch(join))
                    this.cur = someId
                    var mr = this.optMemberRead(e, o, innerTy, name)
                    if (let some(mr) = mr) {
                        var wrapper = this.optionWrap(mr.v, mr.ty, e.span)
                        if (let some(w) = wrapper) {
                            this.instr(IrInstr.StoreSlot(resSlot, w))
                            this.term(IrTerm.Branch(join))
                            this.cur = join
                            return this.load(resSlot)
                        }
                        return none
                    }
                    return none
                }
                return none
            }
            return none
        }
        none
    }

    /// Read field `name` (or dispatch the getter for property `name`) from an
    /// already-evaluated class/struct receiver (property getters deferred).
    /// Mirrors `opt_member_read`.
    fn optMemberRead(e: Expr, obj: int, recvTy: Ty, name: string) -> OptMemberVal? {
        var cid: int? = none
        var cname = ""
        match (recvTy) {
            case Ty.Class(cn, _) -> {
                cid = this.classIdOf(recvTy, e.span)
                cname = cn
            }
            case Ty.Struct(cn, _) -> {
                cid = this.classIdOf(recvTy, e.span)
                cname = cn
            }
            case _ -> {}
        }
if (let some(cc) = cid) {
            if (let some(slot) = this.instanceFieldIndex(cc, name)) {
                var fieldTy = this.fieldAt(cc, slot).ty
                var v = this.fieldRead(e.span, obj, fieldTy, slot)
                if (let some(v) = v) {
                    return OptMemberVal(fieldTy, v)
                }
                return none
            }
            if (let some(fid) = this.propertyIds.get(tripleKey(str(cc), name, str(false)))) {
                var pty = this.propertyTyOf(cname, name)
                var v = this.callMethod(e, fid, emptyCallArgs(), obj)
                if (let some(v) = v) {
                    return OptMemberVal(pty, v)
                }
                return none
            }
        }
        this.bad(e.span, "no field or property `" + name + "` for optional access")
        none
    }

    /// The declared type of property `name` on class `cname`.
    fn propertyTyOf(cname: string, name: string) -> Ty {
        if (let some(entry) = this.resolved.types.get(cname)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    for (p in t.properties) {
                        if (p.name == name) {
                            return p.ty
                        }
                    }
                    return Ty.Unknown
                }
                case TypeTableEntry.Struct(t) -> {
                    for (p in t.properties) {
                        if (p.name == name) {
                            return p.ty
                        }
                    }
                    return Ty.Unknown
                }
                case _ -> {}
            }
        }
        Ty.Unknown
    }

    // ---- unary / binary / logic / casts / assigns --------------------------

    /// The class id of a non-generic `Ty::Class(n, [])`, or `none` when `ty`
    /// is not such a type (mirrors `user_class_id`).
    fn userClassId(ty: Ty) -> UserClassRef? {
        match (ty) {
            case Ty.Class(n, args) -> {
                if (len(args) == 0) {
                    var cidO = this.classByName.get(n)
                    if (let some(cid) = cidO) {
                        return UserClassRef(n, cid)
                    }
                }
                none
            }
            case _ -> none
        }
    }

    /// An ASCII `char` literal re-read as the `int` it represents, or `none`
    /// for anything else. Used so a `byte` compared against an ASCII `char`
    /// literal shares the `i64` ABI (mirrors the `ascii_lit_int` closure).
    fn asciiLitInt(x: Expr) -> int? {
        match (x.kind) {
            case ExprKind.Lit(Lit.Char(c)) -> {
                if ((c as int) <= 0x7F) {
                    return this.intConst(c as int)
                }
                none
            }
            case _ -> none
        }
    }

    /// `-x` / `~x` / `!x` / `*p` / `&x`. Mirrors `unary` in emit.rs.
    fn unary(e: Expr, op: UnOp, operand: Expr) -> int? {
        match (op) {
            case UnOp.Neg | UnOp.BitNot -> {
                var v = this.expr(operand)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dst = this.temp()
                if (op == UnOp.Neg) {
                    this.instr(IrInstr.UnOp(dst, IrUnOp.Neg, vId))
                } else {
                    this.instr(IrInstr.UnOp(dst, IrUnOp.BitNot, vId))
                }
                dst
            }
            case UnOp.Not -> {
                var v = this.expr(operand)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dst = this.temp()
                this.instr(IrInstr.UnOp(dst, IrUnOp.Not, vId))
                dst
            }
            case UnOp.Deref -> {
                var scalar: IrTy? = none
                if (let some(t) = this.tyOf(operand.span)) {
                    match (t) {
                        case Ty.Ptr(pr) -> scalar = scalarIr(pr)
                        case Ty.Ref(pr) -> scalar = scalarIr(pr)
                        case _ -> {}
                    }
                }
                if (let some(ty) = scalar) {
                    var addr = this.expr(operand)
                    if (let none = addr) {
                        return none
                    }
                    var addrId = 0
                    if (let some(aa) = addr) {
                        addrId = aa
                    }
                    var dst = this.temp()
                    this.instr(IrInstr.LoadRaw(dst, addrId, ty))
                    return dst
                }
                this.expr(operand)
            }
            case UnOp.AddrOf -> {
                var t = this.tyOf(operand.span)
                var tScalar = false
                if (let some(tt) = t) {
                    if (let some(_) = scalarIr(tt)) {
                        tScalar = true
                    }
                }
                if (tScalar) {
                    var nameO = exprKindIdentName(operand)
                    if (let none = nameO) {
                        this.bad(e.span, "`&` of a scalar requires a local variable")
                        return none
                    }
                    var name = ""
                    if (let some(n) = nameO) {
                        name = n
                    }
                    var slotO = this.lookup(name)
                    if (let some(s) = slotO) {
                        var dst = this.temp()
                        this.instr(IrInstr.LocalAddr(dst, s))
                        return dst
                    }
                    // A top-level `var` is addressable too: the cell lives in the
                    // image's `.data`, so `&g` is the address of that symbol and a
                    // write through it lands in the global, not a copy. This is
                    // what lets a ported runtime pass a mutable cell to an extern
                    // (e.g. a per-thread frame head) instead of returning a value.
                    if (this.globalIds.has(name)) {
                        var gidO = this.globalIds.get(name)
                        if (let some(gid) = gidO) {
                            var dst2 = this.temp()
                            this.instr(IrInstr.GlobalAddr(dst2, gid))
                            return dst2
                        }
                    }
                    this.bad(e.span, "`&` of an unknown local")
                    return none
                }
                var ok = false
                if (let some(tt) = t) {
                    match (tt) {
                        case Ty.Class(_, _) -> ok = true
                        case Ty.Struct(_, _) -> ok = true
                        case Ty.Ptr(_) -> ok = true
                        // The checker already types `&str` as `*string`
                        // (see `check.pkl`), so the emitter has to lower it
                        // the same way: the value *is* the object pointer.
                        case Ty.String -> ok = true
                        case _ -> {}
                    }
                }
                if (ok) {
                    return this.expr(operand)
                }
                this.bad(e.span, "`&` currently only supports class, struct, pointer, and scalar local variables")
                none
            }
        }
    }

    /// Binary arithmetic/comparison/boolean expressions. Mirrors `binary` in
    /// emit.rs (order matters: string/enum special cases first, then the Itof
    /// promotion pair, then the ASCII-byte trick, then the defensive check).
    fn binary(e: Expr, op: BinOp, lhs: Expr, rhs: Expr) -> int? {
        var lt = this.tyOf(lhs.span)
        var rt = this.tyOf(rhs.span)
        var bothStr = false
        if (let some(l) = lt) {
            if (let some(r) = rt) {
                if (l == Ty.String && r == Ty.String) {
                    bothStr = true
                }
            }
        }
        var bothEnum = false
        if (let some(l) = lt) {
            match (l) {
                case Ty.Enum(_, _) -> {
                    if (let some(r) = rt) {
                        match (r) {
                            case Ty.Enum(_, _) -> bothEnum = true
                            case _ -> {}
                        }
                    }
                }
                case _ -> {}
            }
        }
        match (op) {
            case BinOp.And | BinOp.Or -> {
                return this.logic(e, op, lhs, rhs)
            }
            case BinOp.NullCoalesce -> {
                return this.nullCoalesce(e, lhs, rhs)
            }
case BinOp.Range | BinOp.RangeIncl -> {
                if (!this.ensureInt(lhs)) {
                    return none
                }
                if (!this.ensureInt(rhs)) {
                    return none
                }
                var start = this.expr(lhs)
                if (let none = start) {
                    return none
                }
                var end = this.expr(rhs)
                if (let none = end) {
                    return none
                }
                var startV = 0
                if (let some(v) = start) {
                    startV = v
                }
                var endV = 0
                if (let some(v) = end) {
                    endV = v
                }
                var one = this.intConst(1)
                if (op == BinOp.Range) {
                    return this.externCallT1("pickle_range", [IrTy.Int, IrTy.Int, IrTy.Int], IrTy.Ptr, [startV, endV, one])
                }
                var end1 = this.temp()
                this.instr(IrInstr.BinOp(end1, IrBinOp.Add, endV, one))
                return this.externCallT1("pickle_range", [IrTy.Int, IrTy.Int, IrTy.Int], IrTy.Ptr, [startV, end1, one])
            }
            case BinOp.Pow -> {
                return this.emitPow(e, lhs, rhs)
            }
            case BinOp.In -> {
                return this.emitIn(e, lhs, rhs)
            }
            case BinOp.Send -> {
                return this.emitSend(lhs, rhs)
            }
            case BinOp.Is -> {
                this.bad(e.span, "the `is` operator is not lowered yet")
                return none
            }
            case BinOp.Add -> {
                if (bothStr) {
                    var a = this.expr(lhs)
                    if (let none = a) {
                        return none
                    }
                    var b = this.expr(rhs)
                    if (let none = b) {
                        return none
                    }
                    var aId = 0
                    if (let some(v) = a) {
                        aId = v
                    }
                    var bId = 0
                    if (let some(v) = b) {
                        bId = v
                    }
                    return this.externCallT1("pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [aId, bId])
                }
            }
            case BinOp.Eq | BinOp.Ne -> {
                if (bothStr) {
                    var a = this.expr(lhs)
                    if (let none = a) {
                        return none
                    }
                    var b = this.expr(rhs)
                    if (let none = b) {
                        return none
                    }
                    var aId = 0
                    if (let some(v) = a) {
                        aId = v
                    }
                    var bId = 0
                    if (let some(v) = b) {
                        bId = v
                    }
                    var cmp = this.externCallT1("pickle_str_cmp", [IrTy.Str, IrTy.Str], IrTy.Int, [aId, bId])
                    var zero = this.temp()
                    this.instr(IrInstr.Const(zero, IrConst.Int(0)))
                    var dst = this.temp()
                    var eqOp = IrBinOp.Eq
                    if (op == BinOp.Ne) {
                        eqOp = IrBinOp.Ne
                    }
                    this.instr(IrInstr.BinOp(dst, eqOp, cmp, zero))
                    return dst
                }
                if (bothEnum) {
                    var a = this.expr(lhs)
                    if (let none = a) {
                        return none
                    }
                    var b = this.expr(rhs)
                    if (let none = b) {
                        return none
                    }
                    var aId = 0
                    if (let some(v) = a) {
                        aId = v
                    }
                    var bId = 0
                    if (let some(v) = b) {
                        bId = v
                    }
                    var eq = this.externCallT1("pickle_enum_eq", [IrTy.Ptr, IrTy.Ptr], IrTy.Bool, [aId, bId])
                    if (op == BinOp.Eq) {
                        return eq
                    }
                    var dst = this.temp()
                    this.instr(IrInstr.UnOp(dst, IrUnOp.Not, eq))
                    return dst
                }
            }
            case _ -> {}
        }
        var a = this.expr(lhs)
        if (let none = a) {
            return none
        }
        var b = this.expr(rhs)
        if (let none = b) {
            return none
        }
        var aId = 0
        if (let some(v) = a) {
            aId = v
        }
        var bId = 0
        if (let some(v) = b) {
            bId = v
        }
        var aty = this.irty(lhs.span)
        var bty = this.irty(rhs.span)
        var aFloat = false
        var bInt = false
        if (let some(t) = aty) {
            if (t == IrTy.Float) {
                aFloat = true
            }
        }
        if (let some(t) = bty) {
            if (t == IrTy.Int) {
                bInt = true
            }
        }
        if (aFloat && bInt) {
            var t = this.temp()
            this.instr(IrInstr.Itof(t, bId))
            bId = t
        } else {
            var aInt = false
            var bFloat = false
            if (let some(t) = aty) {
                if (t == IrTy.Int) {
                    aInt = true
                }
            }
            if (let some(t) = bty) {
                if (t == IrTy.Float) {
                    bFloat = true
                }
            }
            if (aInt && bFloat) {
                var t = this.temp()
                this.instr(IrInstr.Itof(t, aId))
                aId = t
            }
        }
        var aByte = false
        if (let some(t) = lt) {
            if (t == Ty.Byte) {
                aByte = true
            }
        }
        var bByte = false
        if (let some(t) = rt) {
            if (t == Ty.Byte) {
                bByte = true
            }
        }
        if (aByte || bByte) {
            if (aByte) {
                var asciiB = this.asciiLitInt(rhs)
                if (let some(t) = asciiB) {
                    bId = t
                    bty = IrTy.Int
                }
            } else {
                var asciiA = this.asciiLitInt(lhs)
                if (let some(t) = asciiA) {
                    aId = t
                    aty = IrTy.Int
                }
            }
        }
        var isCmp = false
        match (op) {
            case BinOp.Lt | BinOp.Le | BinOp.Gt | BinOp.Ge | BinOp.Eq | BinOp.Ne -> isCmp = true
            case _ -> {}
        }
        if (isCmp) {
            var aTag = -1
            var bTag = -1
            if (let some(t) = aty) {
                aTag = irTyTag(t)
            }
            if (let some(t) = bty) {
                bTag = irTyTag(t)
            }
            if (!cmpTypesCompatible(aTag, bTag)) {
                this.bad(e.span, "comparison `" + binOpName(op) + "` with incompatible operand types is not lowered yet")
                return none
            }
        }
        var dst = this.temp()
        this.instr(IrInstr.BinOp(dst, binaryOpcode(op), aId, bId))
        dst
    }

    /// Short-circuit `&&` / `||` through a result slot. Mirrors `logic` in
    /// emit.rs.
    fn logic(e: Expr, op: BinOp, lhs: Expr, rhs: Expr) -> int? {
        var res = this.newSlot(IrTy.Bool)
        var isAnd = op == BinOp.And
        var a = this.expr(lhs)
        if (let none = a) {
            return none
        }
        var aId = 0
        if (let some(v) = a) {
            aId = v
        }
        var rhsId = this.newBlock()
        var shortId = this.newBlock()
        var join = this.newBlock()
        if (isAnd) {
            this.term(IrTerm.BranchIf(aId, rhsId, shortId))
        } else {
            this.term(IrTerm.BranchIf(aId, shortId, rhsId))
        }
        this.cur = rhsId
        var b = this.expr(rhs)
        if (let none = b) {
            return none
        }
        var bId = 0
        if (let some(v) = b) {
            bId = v
        }
        this.instr(IrInstr.StoreSlot(res, bId))
        this.term(IrTerm.Branch(join))
        this.cur = shortId
        var sv = this.temp()
        this.instr(IrInstr.Const(sv, IrConst.Bool(!isAnd)))
        this.instr(IrInstr.StoreSlot(res, sv))
        this.term(IrTerm.Branch(join))
        this.cur = join
        this.load(res)
    }

    /// Combine two boolean temps (`&&` when `isAnd`, otherwise `||`) into one
    /// `Bool` temp. Mirrors `combine_cond` in emit.rs.
    fn combineCond(isAnd: bool, a: int, b: int) -> int {
        var res = this.newSlot(IrTy.Bool)
        var rhsId = this.newBlock()
        var shortId = this.newBlock()
        var join = this.newBlock()
        if (isAnd) {
            this.term(IrTerm.BranchIf(a, rhsId, shortId))
        } else {
            this.term(IrTerm.BranchIf(a, shortId, rhsId))
        }
        this.cur = rhsId
        this.instr(IrInstr.StoreSlot(res, b))
        this.term(IrTerm.Branch(join))
        this.cur = shortId
        var sv = this.temp()
        this.instr(IrInstr.Const(sv, IrConst.Bool(!isAnd)))
        this.instr(IrInstr.StoreSlot(res, sv))
        this.term(IrTerm.Branch(join))
        this.cur = join
        this.load(res)
    }

    // ---- casts ----

    /// `x is T` / `x as T` / `x as? T`. The result stays in the typed IR value
    /// domain: `is` -> bool, `as` -> `T`, `as?` -> `T?` (a pointer). Mirrors
    /// `cast` in emit.rs.
    fn cast(e: Expr, operand: Expr, ty: TypeExpr, kind: CastKind) -> int? {
        var src = Ty.Unknown
        if (let some(t) = this.tyOf(operand.span)) {
            src = t
        }
        var dst = this.resolved.resolveTy(ty, emptyStrs(), this.diags)
        match (kind) {
            case CastKind.Is -> this.castIs(e, operand, src, dst)
            case CastKind.As -> this.castAs(e, operand, src, dst)
            case CastKind.TryAs -> {
                var v = this.expr(operand)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var inner = dst
                if (let some(i) = innerOption(dst)) {
                    inner = i
                }
                this.castToOption(e.span, vId, src, inner)
            }
        }
    }

    /// `x is T`: compare underlying (option-stripped) types. Mirrors `cast_is`.
    fn castIs(e: Expr, operand: Expr, src: Ty, dst: Ty) -> int? {
        var srcOpt = innerOption(src)
        var dstOpt = innerOption(dst)
        var baseSrc = src
        var baseDst = dst
        if (let some(s) = srcOpt) {
            baseSrc = s
        }
        if (let some(d) = dstOpt) {
            baseDst = d
        }
        var v = this.expr(operand)
        if (let none = v) {
            return none
        }
        var vId = 0
        if (let some(vv) = v) {
            vId = vv
        }
        if (tyEq(baseSrc, baseDst)) {
            var srcIsOpt = true
            var dstIsOpt = true
            if (let none = srcOpt) {
                srcIsOpt = false
            }
            if (let none = dstOpt) {
                dstIsOpt = false
            }
            if (srcIsOpt && !dstIsOpt) {
                return this.optIsPresent(vId)
            }
            return this.boolConst(true)
        }
        if (isNumeric(baseSrc) && isNumeric(baseDst)) {
            return this.boolConst(false)
        }
        var srcRef = this.userClassId(baseSrc)
        var dstRef = this.userClassId(baseDst)
        if (let some(sr) = srcRef) {
            if (let some(dr) = dstRef) {
                if (this.isAncestor(dr.name, sr.name)) {
                    return this.boolConst(true)
                }
                if (this.isAncestor(sr.name, dr.name)) {
                    var dc = this.intConst(dr.id)
                    return this.externCallT1("pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [vId, dc])
                }
                return this.boolConst(false)
            }
        }
        var dstIf = ifaceOf(baseDst)
        if (let some(di) = dstIf) {
            var ifaceId = this.ifaceIdFor(di.name, di.args, e.span)
            if (let some(id) = ifaceId) {
                var dc = this.intConst(id)
                return this.externCallT1("pickle_class_implements", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [vId, dc])
            }
            return none
        }
        if (let some(_) = ifaceOf(baseSrc)) {
            var dRef = this.userClassId(baseDst)
            if (let none = dRef) {
                this.bad(e.span, "`" + bareName(src) + " is " + bareName(dst) + "` is not lowered yet")
                return none
            }
            var drId = 0
            if (let some(dr2) = dRef) {
                drId = dr2.id
            }
            var dc = this.intConst(drId)
            return this.externCallT1("pickle_class_is", [IrTy.Ptr, IrTy.Int], IrTy.Bool, [vId, dc])
        }
        this.bad(e.span, "`" + bareName(src) + " is " + bareName(dst) + "` is not lowered yet (class/interface tests need inheritance)")
        none
    }

    /// `x as T`: unpreserving, but `T?` targets never panic. Mirrors `cast_as`.
    fn castAs(e: Expr, operand: Expr, src: Ty, dst: Ty) -> int? {
        var v = this.expr(operand)
        if (let none = v) {
            return none
        }
        var vId = 0
        if (let some(vv) = v) {
            vId = vv
        }
        if (let some(inner) = innerOption(dst)) {
            return this.castToOption(e.span, vId, src, inner)
        }
        if (let some(si) = innerOption(src)) {
            var ival = this.optUnwrapVal(e.span, vId, si)
            if (let none = ival) {
                return none
            }
            var iv = 0
            if (let some(ivv) = ival) {
                iv = ivv
            }
            return this.convert(e.span, iv, si, dst)
        }
        this.convert(e.span, vId, src, dst)
    }

    /// Produce the option `inner?` from an already-evaluated `v` of type `src`.
    /// A managed source passes through; scalars are boxed. When `src` is itself
    /// an option, `none` is preserved and the present value is converted.
    /// Mirrors `cast_to_option`.
    fn castToOption(span: Span, v: int, src: Ty, inner: Ty) -> int? {
        if (let some(si) = innerOption(src)) {
            if (tyEq(si, inner)) {
                return v
            }
            if (!(isNumeric(si) && isNumeric(inner))) {
                this.bad(span, "`" + bareName(src) + " as? " + bareName(inner) + "` is not lowered yet")
                return none
            }
            var resSlot = this.newSlot(IrTy.Ptr)
            var present = this.optIsPresent(v)
            if (let none = present) {
                return none
            }
            var presentId = 0
            if (let some(p) = present) {
                presentId = p
            }
            var someId = this.newBlock()
            var noneId = this.newBlock()
            var join = this.newBlock()
            this.term(IrTerm.BranchIf(presentId, someId, noneId))
            this.cur = noneId
            var n = this.nullTemp()
            if (let none = n) {
                return none
            }
            var nId = 0
            if (let some(nn) = n) {
                nId = nn
            }
            this.instr(IrInstr.StoreSlot(resSlot, nId))
            this.term(IrTerm.Branch(join))
            this.cur = someId
            var iv = this.optResolve(v, si, span)
            if (let none = iv) {
                return none
            }
            var ivId = 0
            if (let some(ivv) = iv) {
                ivId = ivv
            }
            var cv = this.convert(span, ivId, si, inner)
            if (let none = cv) {
                return none
            }
            var cvId = 0
            if (let some(c) = cv) {
                cvId = c
            }
            var wrapped = this.optionWrap(cvId, inner, span)
            if (let none = wrapped) {
                return none
            }
            var wId = 0
            if (let some(w) = wrapped) {
                wId = w
            }
            this.instr(IrInstr.StoreSlot(resSlot, wId))
            this.term(IrTerm.Branch(join))
            this.cur = join
            return this.load(resSlot)
        }
        var cv = this.convert(span, v, src, inner)
        if (let none = cv) {
            return none
        }
        var cvId = 0
        if (let some(c) = cv) {
            cvId = c
        }
        this.optionWrap(cvId, inner, span)
    }

    /// Convert a non-option value between related (non-option) types. Identity
    /// and numeric conversions are supported; anything else bails. Mirrors
    /// `convert` in emit.rs.
    fn convert(span: Span, v: int, src: Ty, to: Ty) -> int? {
if (tyEq(src, to)) {
                  return v
              }
              // `*T` and `int` are the same machine word. `castRelated` allows the
              // pair so container ABI bodies can store an object address in a word
              // slot; the move is a plain register copy, with no trap value and no
              // new representation.
              if ((isPtr(src) && to == Ty.Int) || (src == Ty.Int && isPtr(to))) {
                  return v
              }
              // A function value is a raw 64-bit code address in the IR domain
              // - the same word `IrConst::FuncAddr` bakes into
              // `pickle_class_register` calls. Moving the word between an `fn`
              // value and an `int` slot is a plain register copy; the GC engine
              // stores `deinit` addresses as int words and casts them back to
              // callables only at invocation.
              if ((isFnValue(src) && to == Ty.Int) || (src == Ty.Int && isFnValue(to))) {
                  return v
              }
        if (isNumeric(src) && isNumeric(to)) {
            if ((src == Ty.Int || src == Ty.Byte) && (to == Ty.Int || to == Ty.Byte)) {
                return v
            }
            if (src == Ty.Int && to == Ty.Float) {
                var dst = this.temp()
                this.instr(IrInstr.Itof(dst, v))
                return dst
            }
            if (src == Ty.Float && to == Ty.Int) {
                var dst = this.temp()
                this.instr(IrInstr.Ftoi(dst, v))
                return dst
            }
            this.bad(span, "cannot cast `" + bareName(src) + "` to `" + bareName(to) + "`")
            return none
        }
        if (src == Ty.Char && (to == Ty.Int || to == Ty.Byte)) {
            var dst = this.temp()
            this.instr(IrInstr.Chartoi(dst, v))
            return dst
        }
        if ((src == Ty.Int || src == Ty.Byte) && to == Ty.Char) {
            var dst = this.temp()
            this.instr(IrInstr.Itochar(dst, v))
            return dst
        }
        var fromRef = this.userClassId(src)
        var toRef = this.userClassId(to)
        if (let some(fr) = fromRef) {
            if (let some(tr) = toRef) {
                if (this.isAncestor(tr.name, fr.name)) {
                    return v
                }
                var dc = this.intConst(tr.id)
                return this.externCallT1("pickle_class_cast", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [v, dc])
            }
        }
        var toIf = ifaceOf(to)
        if (let some(ti) = toIf) {
            var ifaceId = this.ifaceIdFor(ti.name, ti.args, span)
            if (let some(id) = ifaceId) {
                var dc = this.intConst(id)
                return this.externCallT1("pickle_iface_cast", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [v, dc])
            }
            return none
        }
        if (let some(_) = ifaceOf(src)) {
            var toCid = this.userClassId(to)
            if (let none = toCid) {
                this.bad(span, "`" + bareName(src) + " as " + bareName(to) + "` is not lowered yet")
                return none
            }
            var tcId = 0
            if (let some(tc) = toCid) {
                tcId = tc.id
            }
            var dc = this.intConst(tcId)
            return this.externCallT1("pickle_class_cast", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [v, dc])
        }
        this.bad(span, "`" + bareName(src) + " as " + bareName(to) + "` is not lowered yet (class/interface casts need inheritance)")
        none
    }

    // ---- assignments ----

    /// `target = value`, `target op= value`, `*p = value`, `xs[i] ... = value`,
    /// `obj.field ... = value`. Mirrors `assign` in emit.rs.
    fn assign(e: Expr, target: Expr, op: AssignOp, value: Expr) -> int? {
        var span = target.span
        var derefOperand: Expr? = none
        match (target.kind) {
            case ExprKind.Unary(UnOp.Deref, operand) -> derefOperand = operand
            case _ -> {}
        }
if (let some(operand) = derefOperand) {
            var pt = Ty.Unknown
            if (let some(t) = this.tyOf(operand.span)) {
                pt = t
            }
            var scalar: IrTy? = none
            match (pt) {
                case Ty.Ptr(pr) -> scalar = scalarIr(pr)
                case _ -> {}
            }
            if (let some(ty) = scalar) {
                var addr = this.expr(operand)
                if (let none = addr) {
                    return none
                }
                var addrId = 0
                if (let some(aa) = addr) {
                    addrId = aa
                }
                if (op == AssignOp.Assign) {
                    var v = this.expr(value)
                    if (let none = v) {
                        return none
                    }
                    var vId = 0
                    if (let some(vv) = v) {
                        vId = vv
                    }
                    this.instr(IrInstr.StoreRaw(addrId, vId, ty))
                    return vId
                }
                // `*p op= v`: read-modify-write on the dereferenced cell.
                var cur = this.temp()
                this.instr(IrInstr.LoadRaw(cur, addrId, ty))
                var v = this.expr(value)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dst = this.temp()
                this.instr(IrInstr.BinOp(dst, assignOpcode(op), cur, vId))
                this.instr(IrInstr.StoreRaw(addrId, dst, ty))
                return dst
            }
            if (op != AssignOp.Assign) {
                this.bad(span, "compound assignment through a raw pointer is not lowered yet")
                return none
            }
            match (pt) {
                case Ty.Class(_, _) -> {
                    return this.assign(e, operand, op, value)
                }
                case Ty.Struct(_, _) -> {
                    return this.assign(e, operand, op, value)
                }
                case Ty.Ptr(_) -> {
                    return this.assign(e, operand, op, value)
                }
                case Ty.Ref(_) -> {
                    this.bad(span, "cannot write through an immutable reference (`&T`)")
                    return none
                }
                case _ -> {
                    this.bad(span, "assignment through a raw pointer is only supported for class, struct, pointer, and scalar values")
                    return none
                }
            }
        }
        match (target.kind) {
            case ExprKind.Index(object, index) -> {
                return this.indexAssign(e, op, object, index, value)
            }
            case _ -> {}
        }
        match (target.kind) {
            case ExprKind.Member(object, name) -> {
                return this.memberAssign(e, op, object, name, value)
            }
            case _ -> {}
        }
        var name = ""
        match (target.kind) {
            case ExprKind.Ident(n) -> name = n
            case _ -> {
                this.bad(span, "assignment targets other than names are not lowered yet")
                return none
            }
        }
        var v = this.expr(value)
        if (let none = v) {
            return none
        }
        var vId = 0
        if (let some(vv) = v) {
            vId = vv
        }
        var vt = Ty.Unknown
        if (let some(t) = this.tyOf(value.span)) {
            vt = t
        }
        var slotO = this.lookup(name)
        if (let some(slot) = slotO) {
            if (op == AssignOp.Assign) {
                var sv = vId
                if (irTyTag(this.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                    var w = this.optionWrap(vId, vt, value.span)
                    if (let none = w) {
                        return none
                    }
                    if (let some(wv) = w) {
                        sv = wv
                    }
                }
                this.instr(IrInstr.StoreSlot(slot, sv))
                return vId
            }
            var cur = this.load(slot)
            var dst = 0
            if (irTyTag(this.fslots[slot]) == irTyTag(IrTy.Str)) {
                dst = this.externCallT1("pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [cur, vId])
            } else {
                var t = this.temp()
                this.instr(IrInstr.BinOp(t, assignOpcode(op), cur, vId))
                dst = t
            }
            this.instr(IrInstr.StoreSlot(slot, dst))
            return dst
        }
        // A top-level `var` write goes to the data symbol. Compound forms
        // are read-modify-write against the slot, so `g += 1` is a load then
        // a store, never a blind store of `v`.
        if (this.globalIds.has(name)) {
            var gid: int? = none
            gid = this.globalIds[name]
            if (let some(id) = gid) {
                var ty = this.irModule.globals[id].ty
                var stored = vId
                if (op != AssignOp.Assign) {
                    var cur = this.temp()
                    this.instr(IrInstr.LoadGlobal(cur, id, ty))
                    if (irTyTag(ty) == irTyTag(IrTy.Str)) {
                        var cc = this.externCallT1("pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [cur, vId])
                        stored = cc
                    } else {
                        var t = this.temp()
                        this.instr(IrInstr.BinOp(t, assignOpcode(op), cur, vId))
                        stored = t
                    }
                }
                this.instr(IrInstr.StoreGlobal(id, stored, ty))
                return stored
            }
        }
        if (let some(cid) = this.owner) {
            var idxO = this.instanceFieldIndex(cid, name)
            if (let some(idx) = idxO) {
                var fieldTy = this.fieldAt(cid, idx).ty
                var owned = this.fieldAt(cid, idx).manual
                var thO = this.thisValue(e)
                if (let none = thO) {
                    return none
                }
                var th = 0
                if (let some(thv) = thO) {
                    th = thv
                }
                return this.fieldAssign(e.span, op, th, fieldTy, idx, vId, vt, owned)
            }
            var sfo = this.staticField(cid, name)
            if (let some(sf) = sfo) {
                if (!sf.info.mutable) {
                    this.bad(span, "cannot assign to immutable static field `" + name + "`")
                    return none
                }
                return this.staticAssign(span, op, sf.dcid, sf.slot, sf.info.ty, vId, vt)
            }
        }
this.bad(span, "cannot assign to `" + name + "`")
        none
    }

/// `obj.field` and `obj.field op= value` on class/struct instances.
    /// Mirrors `member_assign` in emit.rs.
    fn tyDbg(t: Ty?) -> string {
        var out = "<none>"
        if (let some(tt) = t) {
            match (tt) {
                case Ty.Ptr(pr) -> out = "<ptr:" + this.tyDbg(pr) + ">"
                case Ty.Class(n, a) -> out = "<class:" + n + ":" + str(len(a)) + ">"
                case Ty.Struct(n, a) -> out = "<struct:" + n + ":" + str(len(a)) + ">"
                case Ty.Var(n) -> out = "<var:" + n + ">"
                case _ -> out = "<other>"
            }
        }
        out
    }

    fn memberAssign(e: Expr, op: AssignOp, object: Expr, name: string, value: Expr) -> int? {
        // `Type.staticProperty = v` dispatches the receiver-less setter.
        var tname = ""
        var isType = false
        match (object.kind) {
            case ExprKind.Ident(n) -> {
                tname = n
                isType = true
            }
            case _ -> {}
        }
        if (isType) {
            var cidO = this.classByName.get(tname)
            if (let some(cid) = cidO) {
var fidO = this.staticPropertyIds.get(tripleKey(str(cid), name, str(true)))
                if (let some(fid) = fidO) {
                    if (op != AssignOp.Assign) {
                        // `Type.prop op= value`: read through the getter,
                        // combine, call the setter with the result.
                        var getFidO = this.staticPropertyIds.get(tripleKey(str(cid), name, str(false)))
                        if (let none = getFidO) {
                            this.bad(e.span, "static property `" + name + "` has no getter")
                            return none
                        }
                        var getFid = 0
                        if (let some(g) = getFidO) {
                            getFid = g
                        }
                        var ptyTy = this.propertyTyOf(tname, name)
                        var curO = this.callMethod(e, getFid, emptyCallArgs(), none)
                        if (let none = curO) {
                            return none
                        }
                        var cur = 0
                        if (let some(c) = curO) {
                            cur = c
                        }
                        var v = this.expr(value)
                        if (let none = v) {
                            return none
                        }
                        var vId = 0
                        if (let some(vv) = v) {
                            vId = vv
                        }
                        var dstO = this.combineCompound(e.span, op, ptyTy, cur, vId, "static property")
                        if (let none = dstO) {
                            return none
                        }
                        var dst = 0
                        if (let some(d) = dstO) {
                            dst = d
                        }
                        var packed = dst
                        if (irTyTag(this.irModule.funcs[fid].params[0].ty) == irTyTag(IrTy.Ptr)) {
                            var w = this.optionWrap(dst, ptyTy, value.span)
                            if (let none = w) {
                                return none
                            }
                            if (let some(wv) = w) {
                                packed = wv
                            }
                        }
                            var dsti = this.temp()
                            this.instr(IrInstr.Call(dsti, Callee.Func(fid), [packed]))
                            // `Type.prop = v`: same as the instance case, the setter
                            // is a call that can throw. Nothing reads `dsti` here, but
                            // the pending check still has to fire before the next
                            // statement.
                            this.guardPropagation(fid)
                            return dst
                    }
                    var v = this.expr(value)
                    if (let none = v) {
                        return none
                    }
                    var vId = 0
                    if (let some(vv) = v) {
                        vId = vv
                    }
                    var vt = Ty.Unknown
                    if (let some(t) = this.tyOf(value.span)) {
                        vt = t
                    }
                    var packed = vId
                    if (irTyTag(this.irModule.funcs[fid].params[0].ty) == irTyTag(IrTy.Ptr)) {
                        var w = this.optionWrap(vId, vt, value.span)
                        if (let none = w) {
                            return none
                        }
                        if (let some(wv) = w) {
                            packed = wv
                        }
                    }
                        var dst = this.temp()
                        this.instr(IrInstr.Call(dst, Callee.Func(fid), [packed]))
                        // As with the static setter: a throwing accessor has to
                        // leave before the compound assignment is considered done.
                        this.guardPropagation(fid)
                        return vId
                }
                var sfo = this.staticField(cid, name)
                if (let some(sf) = sfo) {
                    if (!sf.info.mutable) {
                        this.bad(e.span, "cannot assign to immutable static field `" + name + "`")
                        return none
                    }
                    var v = this.expr(value)
                    if (let none = v) {
                        return none
                    }
                    var vId = 0
                    if (let some(vv) = v) {
                        vId = vv
                    }
                    var vt = Ty.Unknown
                    if (let some(t) = this.tyOf(value.span)) {
                        vt = t
                    }
                    return this.staticAssign(e.span, op, sf.dcid, sf.slot, sf.info.ty, vId, vt)
                }
                this.bad(e.span, "`" + tname + "` has no settable static member `" + name + "`")
                return none
            }
        }
var ot = this.tyOf(object.span)
        var o2: Ty? = none
        if (let some(tt) = ot) {
            match (tt) {
                case Ty.Ptr(pr) -> o2 = pr
                case _ -> o2 = tt
            }
        }
        var cidVal = -1
        if (let some(oo) = o2) {
            match (oo) {
                case Ty.Class(_, _) -> {
                    var co = this.classIdOf(oo, e.span)
                    if (let some(c) = co) {
                        cidVal = c
                    }
                }
                case Ty.Struct(_, _) -> {
                    var co = this.classIdOf(oo, e.span)
                    if (let some(c) = co) {
                        cidVal = c
                    }
                }
                case _ -> {}
            }
        }
if (cidVal < 0) {
            this.bad(e.span, "assignment over this member type is not lowered yet")
            return none
        }
        var idxO = this.instanceFieldIndex(cidVal, name)
        if (let some(idx) = idxO) {
            var fieldTy = this.fieldAt(cidVal, idx).ty
            var owned = this.fieldAt(cidVal, idx).manual
            var v = this.expr(value)
            if (let none = v) {
                return none
            }
            var vId = 0
            if (let some(vv) = v) {
                vId = vv
            }
            var vvt = Ty.Unknown
            if (let some(t) = this.tyOf(value.span)) {
                vvt = t
            }
            var obj = this.expr(object)
            if (let none = obj) {
                return none
            }
            var objId = 0
            if (let some(o) = obj) {
                objId = o
            }
            return this.fieldAssign(e.span, op, objId, fieldTy, idx, vId, vvt, owned)
        }
// `obj.prop = value` dispatches the property's setter.
        var fidO = this.propertyIds.get(tripleKey(str(cidVal), name, str(true)))
        if (let some(fid) = fidO) {
            if (op != AssignOp.Assign) {
                // `obj.prop op= value`: read through the getter, combine,
                // call the setter with the result.
                var getFidO = this.propertyIds.get(tripleKey(str(cidVal), name, str(false)))
                if (let none = getFidO) {
                    this.bad(e.span, "property `" + name + "` has no getter")
                    return none
                }
                var getFid = 0
                if (let some(g) = getFidO) {
                    getFid = g
                }
                var obj = this.expr(object)
                if (let none = obj) {
                    return none
                }
                var objId = 0
                if (let some(o) = obj) {
                    objId = o
                }
                var ptyTy = this.propertyTyOf(this.classOfName(cidVal), name)
                var curO = this.callMethod(e, getFid, emptyCallArgs(), objId)
                if (let none = curO) {
                    return none
                }
                var cur = 0
                if (let some(c) = curO) {
                    cur = c
                }
                var v = this.expr(value)
                if (let none = v) {
                    return none
                }
                var vId = 0
                if (let some(vv) = v) {
                    vId = vv
                }
                var dstO = this.combineCompound(e.span, op, ptyTy, cur, vId, "property")
                if (let none = dstO) {
                    return none
                }
                var dst = 0
                if (let some(d) = dstO) {
                    dst = d
                }
                var packed = dst
                if (irTyTag(this.irModule.funcs[fid].params[1].ty) == irTyTag(IrTy.Ptr)) {
                    var w = this.optionWrap(dst, ptyTy, value.span)
                    if (let none = w) {
                        return none
                    }
                    if (let some(wv) = w) {
                        packed = wv
                    }
                }
                var dsti = this.temp()
                this.instr(IrInstr.Call(dsti, Callee.Func(fid), [objId, packed]))
                // A property setter is a real call: a throwing accessor leaves the
                // flag set, and the assignment's result is meaningless until we
                // have left.
                this.guardPropagation(fid)
                return dst
            }
            var obj = this.expr(object)
            if (let none = obj) {
                return none
            }
            var objId = 0
            if (let some(o) = obj) {
                objId = o
            }
            var v = this.expr(value)
            if (let none = v) {
                return none
            }
            var vId = 0
            if (let some(vv) = v) {
                vId = vv
            }
            var vt = Ty.Unknown
            if (let some(t) = this.tyOf(value.span)) {
                vt = t
            }
            var packed = vId
            if (irTyTag(this.irModule.funcs[fid].params[1].ty) == irTyTag(IrTy.Ptr)) {
                var w = this.optionWrap(vId, vt, value.span)
                if (let none = w) {
                    return none
                }
                if (let some(wv) = w) {
                    packed = wv
                }
            }
            var dst = this.temp()
            this.instr(IrInstr.Call(dst, Callee.Func(fid), [objId, packed]))
            // Same for the compound form: the read-modify-write calls a setter,
            // which is where the read-modify-write result comes back through.
            this.guardPropagation(fid)
            return vId
        }
        this.bad(e.span, "`" + name + "` is not a field or settable property of this `" + this.classOfName(cidVal) + "`")
        none
    }

    /// Read-modify-write/plain store of one field slot. Mirrors `field_assign`.
    fn fieldAssign(span: Span, op: AssignOp, obj: int, fieldTy: Ty, slot: int, v: int, vt: Ty, owned: bool) -> int? {
        var repO = this.elemRep(fieldTy, span)
        if (let none = repO) {
            return none
        }
        var rep = ElemRep.ptr()
        if (let some(r) = repO) {
            rep = r
        }
        if (op == AssignOp.Assign) {
            if (owned) {
                var idxc = this.intConst(slot)
                var old = this.externCallT1("pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idxc])
                var vOwn = this.externCallT1("pickle_manual_adopt", [IrTy.Ptr], IrTy.Ptr, [v])
                var packed = this.packForPointerBoundary(rep, vOwn, vt, span)
                if (let none = packed) {
                    return none
                }
                var packedId = 0
                if (let some(p) = packed) {
                    packedId = p
                }
                var boxed = this.boxForStore(rep, packedId, elemIr(fieldTy))
                var storeId = 0
                if (let some(b) = boxed) {
                    storeId = b
                } else {
                    return none
                }
                this.fieldStore(obj, slot, fieldTy, storeId)
                this.externCallVoid("pickle_manual_free", [IrTy.Ptr], [old])
                return vOwn
            }
            var packed = this.packForPointerBoundary(rep, v, vt, span)
            if (let none = packed) {
                return none
            }
            var packedId = 0
            if (let some(p) = packed) {
                packedId = p
            }
            var boxed = this.boxForStore(rep, packedId, elemIr(fieldTy))
            var storeId = 0
            if (let some(b) = boxed) {
                storeId = b
            } else {
                return none
            }
            this.fieldStore(obj, slot, fieldTy, storeId)
            return v
        }
if (rep.isPtr) {
            if (fieldTy != Ty.String) {
                this.bad(span, "compound assignment to a non-scalar field is not lowered yet")
                return none
            }
            // String field: read the current string, concatenate, store back.
            var idxc = this.intConst(slot)
            var cur = this.externCallT1("pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idxc])
            var dstO = this.combineCompound(span, op, fieldTy, cur, v, "field")
            if (let none = dstO) {
                return none
            }
            var dst = 0
            if (let some(d) = dstO) {
                dst = d
            }
            var boxed = this.boxForStore(rep, dst, elemIr(fieldTy))
            var storeId = 0
            if (let some(b) = boxed) {
                storeId = b
            } else {
                return none
            }
            this.fieldStore(obj, slot, fieldTy, storeId)
            return dst
        }
        var idxc = this.intConst(slot)
        var raw = this.externCallT1("pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idxc])
        var cur = this.externCallT1(rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
        var dst = this.temp()
        this.instr(IrInstr.BinOp(dst, assignOpcode(op), cur, v))
        var boxed = this.boxForStore(rep, dst, elemIr(fieldTy))
        var storeId = 0
        if (let some(b) = boxed) {
            storeId = b
        } else {
            return none
        }
        this.fieldStore(obj, slot, fieldTy, storeId)
        dst
    }

/// Emit `pickle_obj_slot_set(obj, slot, boxed)`. Mirrors `field_store`.
    fn fieldStore(obj: int, slot: int, fieldTy: Ty, boxed: int) {
        var idx = this.intConst(slot)
        this.externCallVoid("pickle_obj_slot_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, idx, boxed])
        let _ = fieldTy
    }

    /// Combine the current value `cur` of a compound-assignment target with the
    /// RHS `v` for operator `op`, where the target's declared type is `ty`.
    /// Scalar targets use the arithmetic binary op; `string` targets
    /// concatenate (`pickle_str_concat`), gated on `+=` because the checker
    /// does not validate compound operators, so any other operator on a string
    /// bails instead of being silently interpreted as concatenation. Other
    /// pointer-shape targets (`Option`, `List`, class instances, ...) have no
    /// compound operator and keep bailing. `what` names the target for the
    /// not-lowered diagnostic. Mirrors `combine_compound` in emit.rs.
    fn combineCompound(span: Span, op: AssignOp, ty: Ty, cur: int, v: int, what: string) -> int? {
        match (ty) {
            case Ty.String -> {
                if (op != AssignOp.Add) {
                    this.bad(span, "compound assignment on this string only supports `+=`")
                    return none
                }
                return this.externCallT1("pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str, [cur, v])
            }
            case _ -> {}
        }
        var scalar = scalarIr(ty)
        if (let some(_) = scalar) {
            var dst = this.temp()
            this.instr(IrInstr.BinOp(dst, assignOpcode(op), cur, v))
            return dst
        }
        this.bad(span, "compound assignment to a non-scalar " + what + " is not lowered yet")
        none
    }

    /// Declared info of the static field at static slot `slot` of class `cid`.
    /// Mirrors `static_field_at`.
    fn staticFieldAt(cid: int, slot: int) -> FieldInfo? {
        for (p in this.classes) {
            if (p.classId == cid) {
                var count = 0
                for (f in p.table.fields) {
                    if (f.isStatic) {
                        if (count == slot) {
                            return f
                        }
                        count = count + 1
                    }
                }
                return none
            }
        }
        none
    }

    /// Plain or compound (`op=`) store of one static field cell. Mirrors
    /// `static_assign`.
    fn staticAssign(span: Span, op: AssignOp, cid: int, slot: int, fieldTy: Ty, v: int, vt: Ty) -> int? {
        var repO = this.elemRep(fieldTy, span)
        if (let none = repO) {
            return none
        }
        var rep = ElemRep.ptr()
        if (let some(r) = repO) {
            rep = r
        }
        if (op == AssignOp.Assign) {
            var packed = this.packForPointerBoundary(rep, v, vt, span)
            if (let none = packed) {
                return none
            }
            var packedId = 0
            if (let some(p) = packed) {
                packedId = p
            }
            var boxed = this.boxForStore(rep, packedId, elemIr(fieldTy))
            var storeId = 0
            if (let some(b) = boxed) {
                storeId = b
            } else {
                return none
            }
            this.staticStore(cid, slot, storeId)
            return v
        }
if (rep.isPtr) {
            if (fieldTy != Ty.String) {
                this.bad(span, "compound assignment to a non-scalar static field is not lowered yet")
                return none
            }
            // String static field: read the current string, concatenate, store back.
            var c = this.intConst(cid)
            var s = this.intConst(slot)
            var cur = this.externCallT1("pickle_static_get", [IrTy.Int, IrTy.Int], IrTy.Ptr, [c, s])
            var dstO = this.combineCompound(span, op, fieldTy, cur, v, "static field")
            if (let none = dstO) {
                return none
            }
            var dst = 0
            if (let some(d) = dstO) {
                dst = d
            }
            var boxed = this.boxForStore(rep, dst, elemIr(fieldTy))
            var storeId = 0
            if (let some(b) = boxed) {
                storeId = b
            } else {
                return none
            }
            this.staticStore(cid, slot, storeId)
            return dst
        }
        var c = this.intConst(cid)
        var s = this.intConst(slot)
        var raw = this.externCallT1("pickle_static_get", [IrTy.Int, IrTy.Int], IrTy.Ptr, [c, s])
        var cur = this.externCallT1(rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
        var dst = this.temp()
        this.instr(IrInstr.BinOp(dst, assignOpcode(op), cur, v))
        var boxed = this.boxForStore(rep, dst, elemIr(fieldTy))
        var storeId = 0
        if (let some(b) = boxed) {
            storeId = b
        } else {
            return none
        }
        this.staticStore(cid, slot, storeId)
        dst
    }

    // ---- index assignment ----

    /// `xs[i] = v` / `xs[i] op= v` over lists, maps, string-typed targets and
    /// raw pointer elements. Mirrors `index_assign` in emit.rs.
    fn indexAssign(e: Expr, op: AssignOp, object: Expr, index: Expr, value: Expr) -> int? {
        var ot = this.tyOf(object.span)
        if (let some(t) = ot) {
            match (t) {
                case Ty.Map(k, v) -> {
                    return this.mapIndexAssign(op, object, index, value, k, v)
                }
                case _ -> {}
            }
        }
        var elemOpt: Ty? = none
        if (let some(t) = ot) {
            match (t) {
                case Ty.Ptr(pr) -> {
                    var scalarO = scalarIr(pr)
                    if (let none = scalarO) {
                        this.bad(e.span, "storing through a pointer to a managed value is not lowered yet")
                        return none
                    }
                    var ty = IrTy.Int
                    if (let some(s) = scalarO) {
                        ty = s
                    }
                    var baseO = this.expr(object)
                    if (let none = baseO) {
                        return none
                    }
                    var base = 0
                    if (let some(v) = baseO) {
                        base = v
                    }
                    var idxO = this.expr(index)
                    if (let none = idxO) {
                        return none
                    }
                    var idx = 0
                    if (let some(v) = idxO) {
                        idx = v
                    }
                    var addrO = this.ptrElementAddr(base, idx, ty, e.span)
                    if (let none = addrO) {
                        return none
                    }
                    var addr = 0
                    if (let some(v) = addrO) {
                        addr = v
                    }
                    if (op == AssignOp.Assign) {
                        var vO = this.expr(value)
                        if (let none = vO) {
                            return none
                        }
                        var v = 0
                        if (let some(vv) = vO) {
                            v = vv
                        }
                        this.instr(IrInstr.StoreRaw(addr, v, ty))
                        return v
                    }
                    var cur = this.temp()
                    this.instr(IrInstr.LoadRaw(cur, addr, ty))
                    var vO = this.expr(value)
                    if (let none = vO) {
                        return none
                    }
                    var v = 0
                    if (let some(vv) = vO) {
                        v = vv
                    }
                    var dst = this.temp()
                    this.instr(IrInstr.BinOp(dst, assignOpcode(op), cur, v))
                    this.instr(IrInstr.StoreRaw(addr, dst, ty))
                    return dst
                }
                case Ty.Ref(_) -> {
                    this.bad(e.span, "cannot write through an immutable reference (`&T`)")
                    return none
                }
                case Ty.String -> {
                    return this.strIndexAssign(e, op, object, index, value)
                }
                case Ty.List(pr) -> elemOpt = pr
                case _ -> {
                    this.bad(e.span, "index assignment over this type is not lowered yet")
                    return none
                }
            }
        }
        if (let none = elemOpt) {
            this.bad(e.span, "index assignment over this type is not lowered yet")
            return none
        }
        var elem = Ty.Unknown
        if (let some(x) = elemOpt) {
            elem = x
        }
        var repO = this.elemRep(elem, e.span)
        if (let none = repO) {
            return none
        }
        var rep = ElemRep.ptr()
        if (let some(r) = repO) {
            rep = r
        }
        var objO = this.expr(object)
        if (let none = objO) {
            return none
        }
        var obj = 0
        if (let some(v) = objO) {
            obj = v
        }
        var idxO = this.expr(index)
        if (let none = idxO) {
            return none
        }
        var idx = 0
        if (let some(v) = idxO) {
            idx = v
        }
        if (op == AssignOp.Assign) {
            var vO = this.expr(value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var ok = this.listStore(obj, idx, rep, elem, v)
            if (let none = ok) {
                return none
            }
            return v
        }
if (rep.isPtr) {
            if (elem != Ty.String) {
                this.bad(e.span, "compound assignment to a non-scalar list element is not lowered yet")
                return none
            }
            // String element: read the current string, concatenate, store back.
            var cur = this.externCallT1("pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idx])
            var vO = this.expr(value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var dstO = this.combineCompound(e.span, op, elem, cur, v, "list element")
            if (let none = dstO) {
                return none
            }
            var dst = 0
            if (let some(d) = dstO) {
                dst = d
            }
            var ok = this.listStore(obj, idx, rep, elem, dst)
            if (let none = ok) {
                return none
            }
            return dst
        }
        var cur = this.externCallT1("pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [obj, idx])
        var curV = this.externCallT1(rep.unboxSym, [IrTy.Ptr], rep.ir, [cur])
        var vO = this.expr(value)
        if (let none = vO) {
            return none
        }
        var v = 0
        if (let some(vv) = vO) {
            v = vv
        }
        var dst = this.temp()
        this.instr(IrInstr.BinOp(dst, assignOpcode(op), curV, v))
        var ok = this.listStore(obj, idx, rep, elem, dst)
        if (let none = ok) {
            return none
        }
        dst
    }

    /// `pickle_list_set(obj, idx, boxed)`: boxes a scalar element first.
    /// Mirrors `list_store`.
    fn listStore(obj: int, idx: int, rep: ElemRep, elem: Ty, v: int) -> int? {
        var boxed = 0
        if (rep.isPtr) {
            boxed = v
        } else {
            boxed = this.externCallT1(rep.boxSym, [elemIr(elem)], IrTy.Ptr, [v])
        }
        this.externCallVoid("pickle_list_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], [obj, idx, boxed])
        0
    }

    /// `m[k] = v` / `m[k] op= v` over a `Map<K, V>`. Mirrors `map_index_assign`.
    fn mapIndexAssign(op: AssignOp, object: Expr, index: Expr, value: Expr, kty: Ty, vty: Ty) -> int? {
        var krepO = this.keyRep(kty, index.span)
        if (let none = krepO) {
            return none
        }
        var krep = ElemRep.ptr()
        if (let some(r) = krepO) {
            krep = r
        }
        var vrepO = this.elemRep(vty, object.span)
        if (let none = vrepO) {
            return none
        }
        var vrep = ElemRep.ptr()
        if (let some(r) = vrepO) {
            vrep = r
        }
        var objO = this.expr(object)
        if (let none = objO) {
            return none
        }
        var obj = 0
        if (let some(v) = objO) {
            obj = v
        }
        var kO = this.expr(index)
        if (let none = kO) {
            return none
        }
        var k = 0
        if (let some(v) = kO) {
            k = v
        }
var kTy = kty
        var kTyO = this.tyOf(index.span)
        if (let some(t) = kTyO) {
            kTy = t
        }
        var keyO = this.packMapKey(krep, k, kTy, index.span)
        if (let none = keyO) {
            return none
        }
        var key = 0
        if (let some(kk) = keyO) {
            key = kk
        }
        if (op == AssignOp.Assign) {
            var vO = this.expr(value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var vTy = IrTy.Int
            if (let some(t) = this.irty(value.span)) {
                vTy = t
            }
            var boxedO = this.boxForStore(vrep, v, vTy)
            if (let none = boxedO) {
                return none
            }
            var boxed = 0
            if (let some(b) = boxedO) {
                boxed = b
            }
            this.externCallVoid("pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [obj, key, boxed])
            return v
        }
if (vrep.isPtr) {
            if (vty != Ty.String) {
                this.bad(object.span, "compound assignment to a non-scalar map value is not lowered yet")
                return none
            }
            // String value: an absent key reads as `""`, then the current
            // string is concatenated with the RHS and stored back.
            var defaultO = this.stringLiteral(emptyStrParts())
            if (let none = defaultO) {
                return none
            }
            var default = 0
            if (let some(d) = defaultO) {
                default = d
            }
            var cur = this.externCallT1("pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, default])
            var vO = this.expr(value)
            if (let none = vO) {
                return none
            }
            var v = 0
            if (let some(vv) = vO) {
                v = vv
            }
            var dstO = this.combineCompound(object.span, op, vty, cur, v, "map value")
            if (let none = dstO) {
                return none
            }
            var dst = 0
            if (let some(d) = dstO) {
                dst = d
            }
            this.externCallVoid("pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [obj, key, dst])
            return dst
        }
        var zero = this.zeroScalar(vrep.ir, object.span)
        if (let none = zero) {
            return none
        }
        var zeroId = 0
        if (let some(z) = zero) {
            zeroId = z
        }
        var default = this.externCallT1(vrep.boxSym, [vrep.ir], IrTy.Ptr, [zeroId])
        var curPtr = this.externCallT1("pickle_map_get_boxed", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], IrTy.Ptr, [obj, key, default])
        var cur = this.externCallT1(vrep.unboxSym, [IrTy.Ptr], vrep.ir, [curPtr])
        var vO = this.expr(value)
        if (let none = vO) {
            return none
        }
        var v = 0
        if (let some(vv) = vO) {
            v = vv
        }
        var dst = this.temp()
        this.instr(IrInstr.BinOp(dst, assignOpcode(op), cur, v))
        var boxed = this.externCallT1(vrep.boxSym, [vrep.ir], IrTy.Ptr, [dst])
        this.externCallVoid("pickle_map_set", [IrTy.Ptr, IrTy.Ptr, IrTy.Ptr], [obj, key, boxed])
        dst
    }

    /// `s[i] = v` / `s[i] op= v` over a string: copy-on-write through
    /// `pickle_str_set`, storing back into the name/field the string came from.
    /// Mirrors `str_index_assign`.
    fn strIndexAssign(e: Expr, op: AssignOp, object: Expr, index: Expr, value: Expr) -> int? {
        match (object.kind) {
            case ExprKind.Ident(name) -> {
                var sO = this.expr(object)
                if (let none = sO) {
                    return none
                }
                var s = 0
                if (let some(v) = sO) {
                    s = v
                }
                var iO = this.expr(index)
                if (let none = iO) {
                    return none
                }
                var i = 0
                if (let some(v) = iO) {
                    i = v
                }
                var vO = this.byteRhs(value)
                if (let none = vO) {
                    return none
                }
                var v = 0
                if (let some(vv) = vO) {
                    v = vv
                }
                var byte = this.strIndexByte(op, s, i, v)
                var nsO = this.externCallT1("pickle_str_set", [IrTy.Ptr, IrTy.Int, IrTy.Int], IrTy.Str, [s, i, byte])
                var ns = nsO
                var slotO = this.lookup(name)
                if (let some(slot) = slotO) {
                    this.instr(IrInstr.StoreSlot(slot, ns))
                    return ns
                }
                if (let some(cid) = this.owner) {
                    var idxO = this.instanceFieldIndex(cid, name)
                    if (let some(idx) = idxO) {
                        var fieldTy = this.fieldAt(cid, idx).ty
                        var owned = this.fieldAt(cid, idx).manual
                        var thO = this.thisValue(e)
                        if (let none = thO) {
                            return none
                        }
                        var th = 0
                        if (let some(thv) = thO) {
                            th = thv
                        }
                        var vt = Ty.String
                        if (let some(t) = this.tyOf(object.span)) {
                            vt = t
                        }
                        return this.fieldAssign(e.span, AssignOp.Assign, th, fieldTy, idx, ns, vt, owned)
                    }
                    var sfo = this.staticField(cid, name)
                    if (let some(sf) = sfo) {
                        if (!sf.info.mutable) {
                            this.bad(e.span, "cannot assign to immutable static field `" + name + "`")
                            return none
                        }
                        var vt = Ty.String
                        if (let some(t) = this.tyOf(object.span)) {
                            vt = t
                        }
                        return this.staticAssign(e.span, AssignOp.Assign, sf.dcid, sf.slot, sf.info.ty, ns, vt)
                    }
                }
                this.bad(e.span, "cannot assign to `" + name + "`")
                none
            }
case ExprKind.Member(mobj, mname) -> {
                var ot = this.tyOf(mobj.span)
                var o2: Ty? = ot
                if (let some(tt) = ot) {
                    match (tt) {
                        case Ty.Ptr(pr) -> o2 = pr
                        case _ -> {}
                    }
                }
                var cidVal = -1
                if (let some(oo) = o2) {
                    match (oo) {
                        case Ty.Class(_, _) -> {
                            var co = this.classIdOf(oo, e.span)
                            if (let some(c) = co) {
                                cidVal = c
                            }
                        }
                        case Ty.Struct(_, _) -> {
                            var co = this.classIdOf(oo, e.span)
                            if (let some(c) = co) {
                                cidVal = c
                            }
                        }
                        case _ -> {}
                    }
                }
                if (cidVal < 0) {
                    this.bad(e.span, "string index assignment over this member type is not lowered yet")
                    return none
                }
                var idxO = this.instanceFieldIndex(cidVal, mname)
                if (let none = idxO) {
                    this.bad(e.span, "`" + mname + "` is not a field of this `" + this.classOfName(cidVal) + "`")
                    return none
                }
                var idx = 0
                if (let some(v) = idxO) {
                    idx = v
                }
                var fieldTy = this.fieldAt(cidVal, idx).ty
                var owned = this.fieldAt(cidVal, idx).manual
                var moO = this.expr(mobj)
                if (let none = moO) {
                    return none
                }
                var mo = 0
                if (let some(v) = moO) {
                    mo = v
                }
                var idxc = this.intConst(idx)
                var raw = this.externCallT1("pickle_obj_slot_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [mo, idxc])
                var iO = this.expr(index)
                if (let none = iO) {
                    return none
                }
                var i = 0
                if (let some(v) = iO) {
                    i = v
                }
                var vO = this.byteRhs(value)
                if (let none = vO) {
                    return none
                }
                var v = 0
                if (let some(vv) = vO) {
                    v = vv
                }
                var byte = this.strIndexByte(op, raw, i, v)
                var ns = this.externCallT1("pickle_str_set", [IrTy.Ptr, IrTy.Int, IrTy.Int], IrTy.Str, [raw, i, byte])
                var vt = Ty.String
                if (let some(t) = this.tyOf(object.span)) {
                    vt = t
                }
                return this.fieldAssign(e.span, AssignOp.Assign, mo, fieldTy, idx, ns, vt, owned)
            }
            case _ -> {
                this.bad(e.span, "string index assignment over a non-variable target is not lowered yet (strings are copy-on-write)")
                none
            }
        }
    }

    /// The byte (int ABI) to write into the string: an ASCII `char` literal
    /// lowers directly to its 0..=255 value; anything else lowers as its own
    /// value expression. Mirrors `byte_rhs`.
    fn byteRhs(value: Expr) -> int? {
        match (value.kind) {
            case ExprKind.Lit(Lit.Char(c)) -> {
                if ((c as int) <= 0x7F) {
                    return this.intConst(c as int)
                }
                this.expr(value)
            }
            case _ -> this.expr(value)
        }
    }

    /// The byte to write back for `s[i] op= v`: `v` itself for a plain store,
    /// or the current byte combined with `v` for a compound operator. Mirrors
    /// `str_index_byte`.
    fn strIndexByte(op: AssignOp, s: int, i: int, v: int) -> int {
        if (op == AssignOp.Assign) {
            return v
        }
        var cur = this.externCallT1("pickle_str_get", [IrTy.Ptr, IrTy.Int], IrTy.Int, [s, i])
        var dst = this.temp()
        this.instr(IrInstr.BinOp(dst, assignOpcode(op), cur, v))
        dst
    }


    /// Lower `if (cond) { then } else { other }`. A binding condition
    /// delegates to `if_let_expr`; otherwise the condition branches between
    /// the then-block and the else side (or the join when no else exists), and
    /// the matching side stores its value into `res_slot`. Mirrors `if_expr`
    /// in emit.rs.
    fn ifExpr(e: Expr, cond: IfCond, then: Block, elseElse: Expr?) -> int? {
        match (cond) {
            case IfCond.Binding(pattern, value) -> this.ifLetExpr(e, pattern, value, then, elseElse)
            case IfCond.Cond(c) -> {
                var condT = this.expr(c)
                if (let none = condT) {
                    return none
                }
                var condTV = 0
                if (let some(v) = condT) {
                    condTV = v
                }
                var resTy = this.irty(e.span)
                var needSlot = false
                if (matchResultNeedsSlot(resTy)) {
                    if (let some(_) = elseElse) {
                        needSlot = true
                    }
                }
                var resSlot: int? = none
                if (needSlot) {
                    var rt = IrTy.Unit
                    if (let some(x) = resTy) {
                        rt = x
                    }
                    resSlot = this.newSlot(rt)
                }
                var thenId = this.newBlock()
                var elseId: int? = none
                if (let some(_) = elseElse) {
                    elseId = this.newBlock()
                }
                var join = this.newBlock()
                var eid = join
                if (let some(x) = elseId) {
                    eid = x
                }
                this.term(IrTerm.BranchIf(condTV, thenId, eid))
                this.cur = thenId
                this.pushScope()
                if (!(this.blockIntoSlot(then, resSlot))) {
                    this.popScope()
                    return none
                }
                this.popScope()
                this.term(IrTerm.Branch(join))
                if (let some(ee) = elseElse) {
                    var els = join
                    if (let some(x) = elseId) {
                        els = x
                    }
                    this.cur = els
                    if (let some(slot) = resSlot) {
                        var t = this.expr(ee)
                        if (let none = t) {
                            return none
                        }
                        var tv = 0
                        if (let some(x) = t) {
                            tv = x
                        }
                        var isPtrSlot = false
                        if (slot < len(this.fslots)) {
                            if (irTyTag(this.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                                isPtrSlot = true
                            }
                        }
                        if (isPtrSlot) {
                            var ty = Ty.Unknown
                            if (let some(gt) = this.tyOf(ee.span)) {
                                ty = gt
                            }
                            var wv = this.optionWrap(tv, ty, ee.span)
                            if (let none = wv) {
                                return none
                            }
                            var vv = 0
                            if (let some(x) = wv) {
                                vv = x
                            }
                            this.instr(IrInstr.StoreSlot(slot, vv))
                        } else {
                            this.instr(IrInstr.StoreSlot(slot, tv))
                        }
                    } else {
                        if (let none = this.expr(ee)) {
                            return none
                        }
                    }
                    this.term(IrTerm.Branch(join))
                }
                this.cur = join
                if (let some(slot) = resSlot) {
                    return this.load(slot)
                }
                this.unitTemp()
            }
        }
    }

    /// Lower `if (let pattern = value) { then } [else ...]`: the value is
    /// evaluated once into a slot, `pattern_test_cond` gates the then-block
    /// (always-true binding/wildcard patterns need no branch), and bindings
    /// are scoped to the then-block only. Mirrors `if_let_expr` in emit.rs.
    fn ifLetExpr(e: Expr, pattern: Pattern, value: Expr, then: Block, elseElse: Expr?) -> int? {
        var st = Ty.Unknown
        if (let some(t) = this.tyOf(value.span)) {
            st = t
        }
        var sIr = this.matchScrutineeIr(st)
        var sIrV = IrTy.Ptr
        if (let some(x) = sIr) {
            sIrV = x
        }
        var v = this.expr(value)
        if (let none = v) {
            return none
        }
        var vv = 0
        if (let some(x) = v) {
            vv = x
        }
        var sSlot = this.newSlot(sIrV)
        this.instr(IrInstr.StoreSlot(sSlot, vv))
        var resTy = this.irty(e.span)
        var needSlot = false
        if (matchResultNeedsSlot(resTy)) {
            if (let some(_) = elseElse) {
                needSlot = true
            }
        }
        var resSlot: int? = none
        if (needSlot) {
            var rt = IrTy.Unit
            if (let some(x) = resTy) {
                rt = x
            }
            resSlot = this.newSlot(rt)
        }
        var always = false
        match (pattern) {
            case Pattern.Binding(_, _) -> always = true
            case Pattern.Wildcard -> always = true
            case _ -> {}
        }
        var thenId = this.newBlock()
        var elseId: int? = none
        if (let some(_) = elseElse) {
            elseId = this.newBlock()
        }
        var join = this.newBlock()
        if (always) {
            this.term(IrTerm.Branch(thenId))
            this.cur = thenId
            this.pushScope()
            var bv = this.load(sSlot)
            if (!(this.bindMatchValue(pattern, st, bv, value.span))) {
                this.popScope()
                return none
            }
            if (!(this.blockIntoSlot(then, resSlot))) {
                this.popScope()
                return none
            }
            this.popScope()
            this.term(IrTerm.Branch(join))
        } else {
            var sv = this.load(sSlot)
            var cond = this.patternTestCond(pattern, st, sv, value.span)
            if (let none = cond) {
                return none
            }
            var condV = 0
            if (let some(c) = cond) {
                condV = c
            }
            var eid = join
            if (let some(x) = elseId) {
                eid = x
            }
            this.term(IrTerm.BranchIf(condV, thenId, eid))
            this.cur = thenId
            this.pushScope()
            var bv = this.load(sSlot)
            if (!(this.bindMatchValue(pattern, st, bv, value.span))) {
                this.popScope()
                return none
            }
            if (!(this.blockIntoSlot(then, resSlot))) {
                this.popScope()
                return none
            }
            this.popScope()
            this.term(IrTerm.Branch(join))
        }
        if (let some(ee) = elseElse) {
            var els = join
            if (let some(x) = elseId) {
                els = x
            }
            this.cur = els
            if (let some(slot) = resSlot) {
                var t = this.expr(ee)
                if (let none = t) {
                    return none
                }
                var tv = 0
                if (let some(x) = t) {
                    tv = x
                }
                var isPtrSlot = false
                if (slot < len(this.fslots)) {
                    if (irTyTag(this.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                        isPtrSlot = true
                    }
                }
                if (isPtrSlot) {
                    var ty = Ty.Unknown
                    if (let some(gt) = this.tyOf(ee.span)) {
                        ty = gt
                    }
                    var wv = this.optionWrap(tv, ty, ee.span)
                    if (let none = wv) {
                        return none
                    }
                    var vv = 0
                    if (let some(x) = wv) {
                        vv = x
                    }
                    this.instr(IrInstr.StoreSlot(slot, vv))
                } else {
                    this.instr(IrInstr.StoreSlot(slot, tv))
                }
            } else {
                if (let none = this.expr(ee)) {
                    return none
                }
            }
            this.term(IrTerm.Branch(join))
        }
        this.cur = join
        if (let some(slot) = resSlot) {
            return this.load(slot)
        }
        this.unitTemp()
    }

    /// Lower `match` over any scrutinee. Enum scrutinees use tag equality to
    /// route each `Enum.Variant(..)`/or-pattern arm; everything else delegates
    /// to `lower_generic_match`. A non-exhaustive chain panics at runtime.
    /// Mirrors `match_expr` in emit.rs.
    fn matchExpr(e: Expr, scrutinee: Expr, arms: List<MatchArm>) -> int? {
        var st0 = this.tyOf(scrutinee.span)
        if (let none = st0) {
            this.bad(e.span, "matching over non-enum values is not lowered yet")
            return none
        }
        var st = Ty.Unknown
        if (let some(s) = st0) {
            st = s
        }
        var isEnum = false
        match (st) {
            case Ty.Enum(_, _) -> isEnum = true
            case _ -> {}
        }
        if (!isEnum) {
            return this.lowerGenericMatch(e, scrutinee, arms, st)
        }
        var enumName = ""
        match (st) {
            case Ty.Enum(en, _) -> enumName = en
            case _ -> {}
        }
        var tableO: EnumTable? = none
        if (let some(entry) = this.resolved.types.get(enumName)) {
            match (entry) {
                case TypeTableEntry.Enum(t) -> tableO = t
                case _ -> {}
            }
        }
        if (let none = tableO) {
            this.bad(e.span, "unknown enum type `" + enumName + "`")
            return none
        }
        if (let some(t) = tableO) {
            return this.lowerEnumMatchTable(e, scrutinee, arms, enumName, t)
        }
        none
    }

    /// The enum-tag `match` lowering (Rust `match_expr` with the `ty_of` /
    /// table lookup already resolved). The scrutinee lives in a `Ptr` slot;
    /// arms branch on `pickle_enum_tag` equality, bind payloads, and join at
    /// a common block.
    fn lowerEnumMatchTable(e: Expr, scrutinee: Expr, arms: List<MatchArm>, enumName: string, table: EnumTable) -> int? {
        var s = this.expr(scrutinee)
        if (let none = s) {
            return none
        }
        var sV = 0
        if (let some(x) = s) {
            sV = x
        }
        var sSlot = this.newSlot(IrTy.Ptr)
        this.instr(IrInstr.StoreSlot(sSlot, sV))
        var resTy = this.irty(e.span)
        var resSlot: int? = none
        if (matchResultNeedsSlot(resTy)) {
            var rt = IrTy.Unit
            if (let some(x) = resTy) {
                rt = x
            }
            resSlot = this.newSlot(rt)
        }
        var sv = this.load(sSlot)
        var tag = this.externCallT1("pickle_enum_tag", [IrTy.Ptr], IrTy.Int, [sv])
        var join = this.newBlock()
        var cur = this.cur
        var chainLive = true
        for (arm in arms) {
            var body = this.newBlock()
            var guard = arm.guard
            var hasPayloadCond = false
            match (arm.pattern) {
                case Pattern.Variant(_, pl) -> {
                    for (plp in pl) {
                        var isPlSimple = false
                        match (plp) {
                            case Pattern.Wildcard -> isPlSimple = true
                            case Pattern.Binding(_, _) -> isPlSimple = true
                            case _ -> {}
                        }
                        if (!isPlSimple) {
                            hasPayloadCond = true
                        }
                    }
                }
                case _ -> {}
            }
            var guardIn = body
            if (let some(_) = guard) {
                guardIn = this.newBlock()
            } else {
                if (hasPayloadCond) {
                    guardIn = this.newBlock()
                }
            }
            var isCatchAll = false
            var bindName: string? = none
            match (arm.pattern) {
                case Pattern.Wildcard -> isCatchAll = true
                case Pattern.Binding(nm, _) -> {
                    bindName = nm
                    isCatchAll = true
                }
                case _ -> {}
            }
            if (isCatchAll) {
                if (let some(g) = guard) {
                    if (chainLive) {
                        this.cur = cur
                        this.term(IrTerm.Branch(guardIn))
                        cur = this.newBlock()
                        this.cur = guardIn
                        this.pushScope()
                        if (let some(nm) = bindName) {
                            var slot = this.newSlot(IrTy.Ptr)
                            var bv = this.load(sSlot)
                            this.instr(IrInstr.StoreSlot(slot, bv))
                            this.declare(nm, slot)
                        }
                        var cond = this.expr(g)
                        if (let none = cond) {
                            this.popScope()
                            return none
                        }
                        var condV = 0
                        if (let some(x) = cond) {
                            condV = x
                        }
                        this.term(IrTerm.BranchIf(condV, body, cur))
                        this.cur = body
                        if (!(this.matchArmBody(arm.body, resSlot))) {
                            this.popScope()
                            return none
                        }
                        this.popScope()
                        this.term(IrTerm.Branch(join))
                    } else {
                        this.cur = guardIn
                        this.pushScope()
                        if (let some(nm) = bindName) {
                            var slot = this.newSlot(IrTy.Ptr)
                            var bv = this.load(sSlot)
                            this.instr(IrInstr.StoreSlot(slot, bv))
                            this.declare(nm, slot)
                        }
                        var cond = this.expr(g)
                        if (let none = cond) {
                            this.popScope()
                            return none
                        }
                        var condV = 0
                        if (let some(x) = cond) {
                            condV = x
                        }
                        this.term(IrTerm.BranchIf(condV, body, join))
                        this.cur = body
                        if (!(this.matchArmBody(arm.body, resSlot))) {
                            this.popScope()
                            return none
                        }
                        this.popScope()
                        this.term(IrTerm.Branch(join))
                    }
                    continue
                }
                if (chainLive) {
                    this.cur = cur
                    this.term(IrTerm.Branch(body))
                    chainLive = false
                }
                this.cur = body
                this.pushScope()
                if (let some(nm) = bindName) {
                    var slot = this.newSlot(IrTy.Ptr)
                    var bv = this.load(sSlot)
                    this.instr(IrInstr.StoreSlot(slot, bv))
                    this.declare(nm, slot)
                }
                if (!(this.matchArmBody(arm.body, resSlot))) {
                    this.popScope()
                    return none
                }
                this.popScope()
                this.term(IrTerm.Branch(join))
            } else {
                match (arm.pattern) {
                    case Pattern.Variant(path, payloads) -> {
                        var vname = ""
                        var isPath = false
                        if (len(path) == 2) {
                            vname = path[1]
                            isPath = true
                        }
                        if (len(path) == 1) {
                            vname = path[0]
                            isPath = true
                        }
                        if (!isPath) {
                            this.bad(arm.span, "invalid enum variant pattern")
                            return none
                        }
                        var vi = -1
                        var vfound = false
                        var vii = 0
                        for (v in table.variants) {
                            if (v.name == vname) {
                                vi = vii
                                vfound = true
                                break
                            }
                            vii = vii + 1
                        }
                        if (!vfound) {
                            this.bad(arm.span, "enum `" + enumName + "` has no variant `" + vname + "`")
                            return none
                        }
                        if (chainLive) {
                            this.cur = cur
                            var viT = this.temp()
                            this.instr(IrInstr.Const(viT, IrConst.Int(vi)))
                            var c = this.temp()
                            this.instr(IrInstr.BinOp(c, IrBinOp.Eq, tag, viT))
                            var next = this.newBlock()
                            this.term(IrTerm.BranchIf(c, guardIn, next))
                            cur = next
                        }
                        this.cur = guardIn
                        this.pushScope()
                        var payloadCond = this.bindEnumPayloads(arm.span, table, vi, payloads, sSlot)
                        if (let none = payloadCond) {
                            this.popScope()
                            return none
                        }
                        var cf = -1
                        if (let some(pc) = payloadCond) {
                            cf = pc
                        }
                        if (let some(g) = guard) {
                            var cond = this.expr(g)
                            if (let none = cond) {
                                this.popScope()
                                return none
                            }
                            var condV = 0
                            if (let some(x) = cond) {
                                condV = x
                            }
                            if (cf == -1) {
                                cf = condV
                            } else {
                                cf = this.combineCond(true, cf, condV)
                            }
                        }
                        if (!(cf == -1)) {
                            var fall = join
                            if (chainLive) {
                                fall = cur
                            }
                            this.term(IrTerm.BranchIf(cf, body, fall))
                            this.cur = body
                        }
                        if (!(this.matchArmBody(arm.body, resSlot))) {
                            this.popScope()
                            return none
                        }
                        this.popScope()
                        this.term(IrTerm.Branch(join))
                    }
                    case Pattern.Or(alts) -> {
                        if (chainLive) {
                            this.cur = cur
                        }
                        var tagTest: int? = none
                        for (alt in alts) {
                            match (alt) {
                                case Pattern.Variant(p, pl) -> {
                                    for (pla in pl) {
                                        match (pla) {
                                            case Pattern.Wildcard -> {}
                                            case _ -> {
                                                this.bad(arm.span, "enum or-pattern alternatives may only use `_` payloads")
                                                return none
                                            }
                                        }
                                    }
                                    var ovn = ""
                                    var ois = false
                                    if (len(p) == 2) {
                                        ovn = p[1]
                                        ois = true
                                    }
                                    if (len(p) == 1) {
                                        ovn = p[0]
                                        ois = true
                                    }
                                    if (!ois) {
                                        this.bad(arm.span, "invalid enum variant pattern")
                                        return none
                                    }
                                    var ovi = -1
                                    var ofound = false
                                    var oi = 0
                                    for (v in table.variants) {
                                        if (v.name == ovn) {
                                            ovi = oi
                                            ofound = true
                                            break
                                        }
                                        oi = oi + 1
                                    }
                                    if (!ofound) {
                                        this.bad(arm.span, "enum `" + enumName + "` has no variant `" + ovn + "`")
                                        return none
                                    }
                                    var viT = this.constTemp(IrConst.Int(ovi))
                                    var c = this.temp()
                                    this.instr(IrInstr.BinOp(c, IrBinOp.Eq, tag, viT))
                                    if (let some(prev) = tagTest) {
                                        tagTest = this.combineCond(false, prev, c)
                                    } else {
                                        tagTest = c
                                    }
                                }
                                case _ -> {
                                    this.bad(arm.span, "enum or-pattern alternatives must be variant patterns")
                                    return none
                                }
                            }
                        }
                        var condV = 0
                        if (let some(cv) = tagTest) {
                            condV = cv
                        } else {
                            this.bad(arm.span, "an or-pattern has no alternatives")
                            return none
                        }
                        if (chainLive) {
                            var next = this.newBlock()
                            this.term(IrTerm.BranchIf(condV, guardIn, next))
                            cur = next
                        }
                        this.cur = guardIn
                        this.pushScope()
                        if (let some(g) = guard) {
                            var cond = this.expr(g)
                            if (let none = cond) {
                                this.popScope()
                                return none
                            }
                            var cv2 = 0
                            if (let some(x) = cond) {
                                cv2 = x
                            }
                            var fall = join
                            if (chainLive) {
                                fall = cur
                            }
                            this.term(IrTerm.BranchIf(cv2, body, fall))
                            this.cur = body
                        }
                        if (!(this.matchArmBody(arm.body, resSlot))) {
                            this.popScope()
                            return none
                        }
                        this.popScope()
                        this.term(IrTerm.Branch(join))
                    }
                    case _ -> {
                        this.bad(arm.span, "this match pattern is not lowered yet")
                        return none
                    }
                }
            }
        }
        if (chainLive) {
            this.cur = cur
            this.panicNoMatchAt(e.span, sv)
            this.term(IrTerm.Branch(join))
        }
        this.cur = join
        if (let some(slot) = resSlot) {
            return this.load(slot)
        }
        this.unitTemp()
    }

    /// Lower `match` over non-enum scrutinees: numeric scalars, `bool`,
    /// `char`, `byte`, `string`, and options (`some(v)`/`none`). Literal
    /// patterns become equality tests against the scrutinee slot; a
    /// binding/wildcard arm catches everything that reaches it. A
    /// non-exhaustive chain fails loudly at runtime. Mirrors
    /// `lower_generic_match` in emit.rs.
    fn lowerGenericMatch(e: Expr, scrutinee: Expr, arms: List<MatchArm>, st: Ty) -> int? {
        var sIr = this.matchScrutineeIr(st)
        if (let none = sIr) {
            this.bad(e.span, "matching over `" + bareName(st) + "` values is not lowered yet")
            return none
        }
        var sIrV = IrTy.Unit
        if (let some(x) = sIr) {
            sIrV = x
        }
        var s = this.expr(scrutinee)
        if (let none = s) {
            return none
        }
        var sV = 0
        if (let some(x) = s) {
            sV = x
        }
        var sSlot = this.newSlot(sIrV)
        this.instr(IrInstr.StoreSlot(sSlot, sV))
        var resTy = this.irty(e.span)
        var resSlot: int? = none
        if (matchResultNeedsSlot(resTy)) {
            var rt = IrTy.Unit
            if (let some(x) = resTy) {
                rt = x
            }
            resSlot = this.newSlot(rt)
        }
        var join = this.newBlock()
        var cur = this.cur
        var chainLive = true
for (arm in arms) {
            var body = this.newBlock()
            var guard = arm.guard
            var guardIn = body
            if (let some(_) = guard) {
                guardIn = this.newBlock()
            }
            var testable: Pattern? = none
            match (arm.pattern) {
                case Pattern.Wildcard -> {}
                case Pattern.Binding(_, _) -> {}
                case other -> testable = other
            }
            if (let some(p) = testable) {
                if (chainLive) {
                    this.cur = cur
                    var sv = this.load(sSlot)
                    var cond = this.patternTestCond(p, st, sv, arm.span)
                    if (let none = cond) {
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    var next = this.newBlock()
                    this.term(IrTerm.BranchIf(condV, guardIn, next))
                    cur = next
                }
                this.cur = guardIn
                this.pushScope()
                var bv = this.load(sSlot)
                if (!(this.bindMatchValue(arm.pattern, st, bv, arm.span))) {
                    this.popScope()
                    return none
                }
                if (let some(g) = guard) {
                    var cond = this.expr(g)
                    if (let none = cond) {
                        this.popScope()
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    var fall = join
                    if (chainLive) {
                        fall = cur
                    }
                    this.term(IrTerm.BranchIf(condV, body, fall))
                    this.cur = body
                }
                if (!(this.matchArmBody(arm.body, resSlot))) {
                    this.popScope()
                    return none
                }
                this.popScope()
                this.term(IrTerm.Branch(join))
                continue
            }
            if (let some(g) = guard) {
                if (chainLive) {
                    this.cur = cur
                    this.term(IrTerm.Branch(guardIn))
                    cur = this.newBlock()
                    this.cur = guardIn
                    this.pushScope()
                    var bv = this.load(sSlot)
                    if (!(this.bindMatchValue(arm.pattern, st, bv, arm.span))) {
                        this.popScope()
                        return none
                    }
                    var cond = this.expr(g)
                    if (let none = cond) {
                        this.popScope()
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    this.term(IrTerm.BranchIf(condV, body, cur))
                    this.cur = body
                    if (!(this.matchArmBody(arm.body, resSlot))) {
                        this.popScope()
                        return none
                    }
                    this.popScope()
                    this.term(IrTerm.Branch(join))
                } else {
                    this.cur = guardIn
                    this.pushScope()
                    var bv = this.load(sSlot)
                    if (!(this.bindMatchValue(arm.pattern, st, bv, arm.span))) {
                        this.popScope()
                        return none
                    }
                    var cond = this.expr(g)
                    if (let none = cond) {
                        this.popScope()
                        return none
                    }
                    var condV = 0
                    if (let some(x) = cond) {
                        condV = x
                    }
                    this.term(IrTerm.BranchIf(condV, body, join))
                    this.cur = body
                    if (!(this.matchArmBody(arm.body, resSlot))) {
                        this.popScope()
                        return none
                    }
                    this.popScope()
                    this.term(IrTerm.Branch(join))
                }
                continue
            }
            if (chainLive) {
                this.cur = cur
                this.term(IrTerm.Branch(body))
                chainLive = false
            }
            this.cur = body
            this.pushScope()
            var bv = this.load(sSlot)
            if (!(this.bindMatchValue(arm.pattern, st, bv, arm.span))) {
                this.popScope()
                return none
            }
            if (!(this.matchArmBody(arm.body, resSlot))) {
                this.popScope()
                return none
            }
            this.popScope()
            this.term(IrTerm.Branch(join))
        }
        if (chainLive) {
            this.cur = cur
            this.externCallVoid("pickle_panic_no_match", emptyIrTys(), emptyInts())
            this.term(IrTerm.Branch(join))
        }
        this.cur = join
        if (let some(slot) = resSlot) {
            return this.load(slot)
        }
        this.unitTemp()
    }

    /// The branch condition under which `p` matches the scrutinee value `a`
    /// (already loaded): `none` tests absence; `some(payload)` tests presence
    /// (recursing for nested payload patterns); tuple patterns AND each
    /// element; `a | b` ORs alternatives; literal patterns test equality.
    /// Mirrors `pattern_test_cond` in emit.rs.
    fn patternTestCond(p: Pattern, st: Ty, a: int, span: Span) -> int? {
        match (p) {
            case Pattern.Literal(lit) -> {
                var noneLit = false
                match (lit) {
                    case Lit.None -> noneLit = true
                    case _ -> {}
                }
                if (noneLit && isOption(st)) {
                    var present = this.optIsPresent(a)
                    if (let none = present) {
                        return none
                    }
                    var pv = 0
                    if (let some(x) = present) {
                        pv = x
                    }
                    var f = this.constTemp(IrConst.Bool(false))
                    var dst = this.temp()
                    this.instr(IrInstr.BinOp(dst, IrBinOp.Eq, pv, f))
                    return dst
                }
                var isStr = false
                match (st) {
                    case Ty.String -> isStr = true
                    case _ -> {}
                }
                if (isStr) {
                    var text = ""
                    var stringOk = true
                    match (lit) {
                        case Lit.String(parts) -> {
                            for (part in parts) {
                                match (part) {
                                    case StrPart.Text(t) -> text = text + t
                                    case StrPart.Expr(_) -> {
                                        this.bad(span, "string match patterns may not interpolate")
                                        return none
                                    }
                                }
                            }
                        }
                        case _ -> {
                            this.bad(span, "this match pattern is not lowered yet")
                            return none
                        }
                    }
                    let _ = stringOk
                    var b = this.strConst(text)
                    var cmp = this.externCallT1("pickle_str_cmp", [IrTy.Str, IrTy.Str], IrTy.Int, [a, b])
                    var zero = this.intConst(0)
                    var dst = this.temp()
                    this.instr(IrInstr.BinOp(dst, IrBinOp.Eq, cmp, zero))
                    return dst
                }
                var lb = this.patternLiteralTemp(lit, st, span)
                if (let none = lb) {
                    return none
                }
                var lbV = 0
                if (let some(x) = lb) {
                    lbV = x
                }
                var dst = this.temp()
                this.instr(IrInstr.BinOp(dst, IrBinOp.Eq, a, lbV))
                return dst
            }
            case Pattern.Variant(path, payloads) -> {
                var isSomeOpt = false
                if (len(path) == 1) {
                    if (path[0] == "some" && isOption(st)) {
                        isSomeOpt = true
                    }
                }
                if (!isSomeOpt) {
                    var isEnumTy = false
                    match (st) {
                        case Ty.Enum(_, _) -> isEnumTy = true
                        case _ -> {}
                    }
                    if (isEnumTy) {
                        return this.enumVariantCond(p, st, a, span)
                    }
                    this.bad(span, "this match pattern is not lowered yet")
                    return none
                }
                var inner = Ty.Unknown
                if (let some(i) = innerOption(st)) {
                    inner = i
                }
                var present = this.optIsPresent(a)
                if (let none = present) {
                    return none
                }
                var presentV = 0
                if (let some(x) = present) {
                    presentV = x
                }
                var needsNested = false
                var payloadP = Pattern.Wildcard
                if (len(payloads) >= 1) {
                    var pl = payloads[0]
                    var simple = false
                    match (pl) {
                        case Pattern.Wildcard -> simple = true
                        case Pattern.Binding(_, _) -> simple = true
                        case _ -> {}
                    }
                    payloadP = pl
                    needsNested = !(simple)
                }
                if (!needsNested) {
                    return presentV
                }
                var resSlot = this.newSlot(IrTy.Bool)
                var onPresent = this.newBlock()
                var onAbsent = this.newBlock()
                var bjoin = this.newBlock()
                this.term(IrTerm.BranchIf(presentV, onPresent, onAbsent))
                this.cur = onPresent
                var resolved = this.optResolve(a, inner, span)
                if (let none = resolved) {
                    return none
                }
                var resolvedV = 0
                if (let some(x) = resolved) {
                    resolvedV = x
                }
                var innerCond = this.patternTestCond(payloadP, inner, resolvedV, span)
                if (let none = innerCond) {
                    return none
                }
                var icv = 0
                if (let some(x) = innerCond) {
                    icv = x
                }
                this.instr(IrInstr.StoreSlot(resSlot, icv))
                this.term(IrTerm.Branch(bjoin))
                this.cur = onAbsent
                var f = this.constTemp(IrConst.Bool(false))
                this.instr(IrInstr.StoreSlot(resSlot, f))
                this.term(IrTerm.Branch(bjoin))
                this.cur = bjoin
                return this.load(resSlot)
            }
            case Pattern.Tuple(parts) -> {
                var tupleTys: List<Ty> = emptyTys()
                match (st) {
                    case Ty.Tuple(tt) -> tupleTys = tt
                    case _ -> {
                        this.bad(span, "a tuple pattern requires a tuple scrutinee")
                        return none
                    }
                }
                if (len(tupleTys) != len(parts)) {
                    this.bad(span, "tuple pattern arity does not match the scrutinee type")
                    return none
                }
var acc: int? = none
                var i = 0
                while (i < len(parts)) {
                    var c = this.tuplePartCond(parts[i], tupleTys[i], a, i, span)
                    if (let some(cv) = c) {
                        if (let some(prev) = acc) {
                            acc = this.combineCond(true, prev, cv)
                        } else {
                            acc = cv
                        }
                    }
                    i = i + 1
                }
                if (let some(v) = acc) {
                    return v
                }
                this.constTemp(IrConst.Bool(true))
            }
            case Pattern.Or(alts) -> {
                var acc: int? = none
                for (alt in alts) {
                    var c = this.patternTestCond(alt, st, a, span)
                    if (let none = c) {
                        return none
                    }
                    var cv = 0
                    if (let some(x) = c) {
                        cv = x
                    }
                    if (let some(prev) = acc) {
                        acc = this.combineCond(false, prev, cv)
                    } else {
                        acc = cv
                    }
                }
                if (let some(v) = acc) {
                    return v
                }
                this.bad(span, "an or-pattern has no alternatives")
                none
            }
            case _ -> {
                this.bad(span, "this match pattern is not lowered yet")
                none
            }
        }
    }

    /// The match condition contributed by tuple element `i` (read from the
    /// tuple pointer `a`): bindings/wildcards are always true; a testable
    /// nested pattern is unboxed to the element's IR domain and recursed.
    /// Mirrors `tuple_part_cond` in emit.rs.
    fn tuplePartCond(part: Pattern, elem: Ty, a: int, i: int, span: Span) -> int? {
        var isSimple = false
        match (part) {
            case Pattern.Binding(_, _) -> isSimple = true
            case Pattern.Wildcard -> isSimple = true
            case _ -> {}
        }
        if (isSimple) {
            return none
        }
        var idx = this.constTemp(IrConst.Int(i))
        var rep = this.elemRep(elem, span)
        if (let none = rep) {
            return none
        }
        var repV = ElemRep.ptr()
        if (let some(r) = rep) {
            repV = r
        }
        var raw = this.externCallT1("pickle_tuple_field", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [a, idx])
        var un = raw
        if (!(repV.isPtr)) {
            un = this.externCallT1(repV.unboxSym, [IrTy.Ptr], repV.ir, [raw])
        }
        this.patternTestCond(part, elem, un, span)
    }

    /// Build a constant in the scrutinee's domain for a literal pattern. A
    /// float scrutinee widens integer literals; a byte scrutinee accepts
    /// ASCII char literals. Mirrors `pattern_literal_temp` in emit.rs (the
    /// float-to-int path uses a truncate-and-round-trip check because Pk
    /// floats expose no `trunc`).
    fn patternLiteralTemp(lit: Lit, st: Ty, span: Span) -> int? {
        match (lit) {
            case Lit.Int(value) -> {
                var isFloat = false
                match (st) {
                    case Ty.Float -> isFloat = true
                    case _ -> {}
                }
                if (isFloat) {
                    var i = this.constTemp(IrConst.Int(value))
                    var d = this.temp()
                    this.instr(IrInstr.Itof(d, i))
                    return d
                }
                this.constTemp(IrConst.Int(value))
            }
            case Lit.Float(text) -> {
                var isIntOrByte = false
                match (st) {
                    case Ty.Int -> isIntOrByte = true
                    case Ty.Byte -> isIntOrByte = true
                    case _ -> {}
                }
                var value = floatVal(text)
                if (isIntOrByte) {
                    var iv = value as int
                    var back = iv as float
                    if (back == value) {
                        return this.constTemp(IrConst.Int(iv))
                    }
                    this.bad(span, "float pattern does not represent an integer")
                    return none
                }
                this.constTemp(IrConst.Float(value))
            }
            case Lit.Bool(b) -> {
                var isBool = false
                match (st) {
                    case Ty.Bool -> isBool = true
                    case _ -> {}
                }
                if (isBool) {
                    return this.constTemp(IrConst.Bool(b))
                }
                this.bad(span, "this match pattern is not lowered yet")
                none
            }
            case Lit.Char(c) -> {
                var isChar = false
                var isByte = false
                match (st) {
                    case Ty.Char -> isChar = true
                    case Ty.Byte -> isByte = true
                    case _ -> {}
                }
                if (isChar) {
                    return this.constTemp(IrConst.Char(c))
                }
                if (isByte) {
                    if ((c as int) <= 0x7F) {
                        return this.constTemp(IrConst.Int(c as int))
                    }
                    this.bad(span, "a non-ASCII char pattern has no `byte` value")
                    return none
                }
                this.bad(span, "this match pattern is not lowered yet")
                none
            }
            case _ -> {
                this.bad(span, "this match pattern is not lowered yet")
                none
            }
        }
    }


    /// The IR domain a match scrutinee (`match`/`if let`) is kept in: scalars
    /// as themselves, strings as `Str` foreign pointers, and every composite
    /// (option/list/map/class/struct/enum/interface/tuple/range) as a managed
    /// `Ptr`. Mirrors `match_scrutinee_ir` in emit.rs.
    fn matchScrutineeIr(st: Ty) -> IrTy? {
        match (st) {
            case Ty.Int -> scalarIrOf(st)
            case Ty.Byte -> scalarIrOf(st)
            case Ty.Float -> scalarIrOf(st)
            case Ty.Bool -> scalarIrOf(st)
            case Ty.Char -> scalarIrOf(st)
            case Ty.String -> IrTy.Str
            case Ty.Option(_) -> IrTy.Ptr
            case Ty.Class(_, _) -> IrTy.Ptr
            case Ty.Struct(_, _) -> IrTy.Ptr
            case Ty.Enum(_, _) -> IrTy.Ptr
            case Ty.Interface(_, _) -> IrTy.Ptr
            case Ty.List(_) -> IrTy.Ptr
            case Ty.Map(_, _) -> IrTy.Ptr
            case Ty.Tuple(_) -> IrTy.Ptr
            case Ty.Range(_) -> IrTy.Ptr
            case _ -> none
        }
    }

    /// Bind the names an arm pattern introduces to the scrutinee value `v`
    /// (already loaded, of type `st`) in the current block. Bindings declare
    /// under `map_ty`; `some(v)` unboxes the present option; tuple patterns
    /// unbox each element; or-patterns bind nothing (the checker only admits
    /// name-free or-patterns); `_`/literals bind nothing. Mirrors
    /// `bind_match_value` in emit.rs.
    fn bindMatchValue(p: Pattern, st: Ty, v: int, span: Span) -> bool {
        match (p) {
            case Pattern.Wildcard -> true
            case Pattern.Literal(_) -> true
            case Pattern.Binding(name, _) -> {
                var ir = IrTy.Str
                match (st) {
                    case Ty.String -> {}
                    case _ -> {
                        var m = this.mapTy(st, span)
                        if (let none = m) {
                            return false
                        }
                        if (let some(mv) = m) {
                            ir = mv
                        }
                    }
                }
                this.declareBinding(name, ir, v)
                true
            }
            case Pattern.Variant(path, payloads) -> {
                var isSomeOpt = false
                if (len(path) == 1) {
                    if (path[0] == "some" && isOption(st)) {
                        isSomeOpt = true
                    }
                }
                if (!isSomeOpt) {
                    var isEnumTy = false
                    match (st) {
                        case Ty.Enum(_, _) -> isEnumTy = true
                        case _ -> {}
                    }
                    if (!isEnumTy) {
                        this.bad(span, "this match pattern is not lowered yet")
                        return false
                    }
                    var ename = ""
                    match (st) {
                        case Ty.Enum(en, _) -> ename = en
                        case _ -> {}
                    }
                    var tableO: EnumTable? = none
                    if (let some(entry) = this.resolved.types.get(ename)) {
                        match (entry) {
                            case TypeTableEntry.Enum(t) -> tableO = t
                            case _ -> {}
                        }
                    }
                    if (let none = tableO) {
                        this.bad(span, "unknown enum type `" + ename + "`")
                        return false
                    }
                    if (let some(table) = tableO) {
                        var vname = ""
                        var valid = false
                        if (len(path) == 2) {
                            vname = path[1]
                            valid = true
                        }
                        if (len(path) == 1) {
                            vname = path[0]
                            valid = true
                        }
                        if (!valid) {
                            this.bad(span, "invalid enum variant pattern")
                            return false
                        }
                        var vi = -1
                        var found = false
                        var ix = 0
                        for (variant in table.variants) {
                            if (variant.name == vname) {
                                vi = ix
                                found = true
                                break
                            }
                            ix = ix + 1
                        }
                        if (!found) {
                            this.bad(span, "enum `" + ename + "` has no variant `" + vname + "`")
                            return false
                        }
                        var ftypes = table.variants[vi].fields
                        var pi = 0
                        while (pi < len(payloads)) {
                            var ft = Ty.Unknown
                            if (pi < len(ftypes)) {
                                ft = ftypes[pi]
                            }
                            var idx = this.constTemp(IrConst.Int(pi))
                            var raw = this.externCallT1("pickle_enum_field", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [v, idx])
                            var pv = raw
                            var rep = this.elemRep(ft, span)
                            if (let none = rep) {
                                return false
                            }
                            var repV = ElemRep.ptr()
                            if (let some(r) = rep) {
                                repV = r
                            }
                            if (!(repV.isPtr)) {
                                pv = this.externCallT1(repV.unboxSym, [IrTy.Ptr], repV.ir, [raw])
                            }
                            if (!(this.bindPatternValue(payloads[pi], ft, pv, span))) {
                                return false
                            }
                            pi = pi + 1
                        }
                        return true
                    }
                    return false
                }
                var inner = Ty.Unknown
                if (let some(i) = innerOption(st)) {
                    inner = i
                }
                var resolved = this.optResolve(v, inner, span)
                if (let none = resolved) {
                    return false
                }
                var resolvedV = 0
                if (let some(x) = resolved) {
                    resolvedV = x
                }
                if (len(payloads) == 0) {
                    return true
                }
                this.bindPatternValue(payloads[0], inner, resolvedV, span)
            }
            case Pattern.Tuple(parts) -> {
                var tupleTys: List<Ty> = emptyTys()
                match (st) {
                    case Ty.Tuple(tt) -> tupleTys = tt
                    case _ -> {
                        this.bad(span, "a tuple pattern requires a tuple scrutinee")
                        return false
                    }
                }
                if (len(tupleTys) != len(parts)) {
                    this.bad(span, "tuple pattern arity does not match the scrutinee type")
                    return false
                }
                var i = 0
                while (i < len(parts)) {
                    var idx = this.constTemp(IrConst.Int(i))
                    var raw = this.externCallT1("pickle_tuple_field", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [v, idx])
                    var pv = raw
                    var rep = this.elemRep(tupleTys[i], span)
                    if (let none = rep) {
                        return false
                    }
                    var repV = ElemRep.ptr()
                    if (let some(r) = rep) {
                        repV = r
                    }
                    if (!(repV.isPtr)) {
                        pv = this.externCallT1(repV.unboxSym, [IrTy.Ptr], repV.ir, [raw])
                    }
                    if (!(this.bindPatternValue(parts[i], tupleTys[i], pv, span))) {
                        return false
                    }
                    i = i + 1
                }
                true
            }
            case Pattern.Or(_) -> true
        }
    }

    /// Bind a nested pattern to a value `v` of type `ty` already in IR form
    /// (a `some` payload or a tuple element). Mirrors `bind_pattern_value`
    /// in emit.rs.
    fn bindPatternValue(p: Pattern, ty: Ty, v: int, span: Span) -> bool {
        this.bindMatchValue(p, ty, v, span)
    }

    /// Declare `name` to a fresh slot already holding `v`. Mirrors
    /// `declare_binding` in emit.rs.
    fn declareBinding(name: string, ir: IrTy, v: int) {
        var slot = this.newSlot(ir)
        this.instr(IrInstr.StoreSlot(slot, v))
        this.declare(name, slot)
    }

    /// Store an arm body's value into the match's result slot, lifting scalar
    /// values when the slot is a `Ptr` (an option-typed result). Mirrors
    /// `match_arm_body` in emit.rs.
    fn matchArmBody(body: Expr, resSlot: int?) -> bool {
        var bt = this.expr(body)
        if (let none = bt) {
            return false
        }
        var btv = 0
        if (let some(x) = bt) {
            btv = x
        }
        if (let some(slot) = resSlot) {
            var isPtrSlot = false
            if (slot < len(this.fslots)) {
                if (irTyTag(this.fslots[slot]) == irTyTag(IrTy.Ptr)) {
                    isPtrSlot = true
                }
            }
            if (isPtrSlot) {
                var btTy = Ty.Unknown
                if (let some(t) = this.tyOf(body.span)) {
                    btTy = t
                }
                var wv = this.optionWrap(btv, btTy, body.span)
                if (let none = wv) {
                    return false
                }
                var wvv = 0
                if (let some(x) = wv) {
                    wvv = x
                }
                this.instr(IrInstr.StoreSlot(slot, wvv))
            } else {
                this.instr(IrInstr.StoreSlot(slot, btv))
            }
        }
        true
    }

    /// Bind the payload fields of variant `vi` of `table` into fresh slots for
    /// `Color.Rgb(r, g, b)` patterns, and return the folded match condition
    /// contributed by any nested (non-binding) payload patterns. A `-1`
    /// return means no condition (every payload bound a name or `_`); `none`
    /// reports an emission error. Fields are boxed in the object, so each is
    /// unboxed to its element IR type; nested patterns bind the names they
    /// introduce and contribute a condition. Mirrors `bind_enum_payloads` in
    /// emit.rs.
    fn bindEnumPayloads(span: Span, table: EnumTable, vi: int, payloads: List<Pattern>, sSlot: int) -> int? {
        var ftypes = table.variants[vi].fields
var acc: int? = none
        var pi = 0
        while (pi < len(payloads)) {
            var p = payloads[pi]
            var ft = Ty.Unknown
            if (pi < len(ftypes)) {
                ft = ftypes[pi]
            }
            var rep = this.elemRep(ft, span)
            if (let none = rep) {
                return none
            }
            var repV = ElemRep.ptr()
            if (let some(r) = rep) {
                repV = r
            }
            var idx = this.temp()
            this.instr(IrInstr.Const(idx, IrConst.Int(pi)))
            var sv = this.load(sSlot)
            var raw = this.externCallT1("pickle_enum_field", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [sv, idx])
            var ir = IrTy.Ptr
            var val = raw
            if (!(repV.isPtr)) {
                val = this.externCallT1(repV.unboxSym, [IrTy.Ptr], repV.ir, [raw])
                ir = repV.ir
            }
            match (p) {
                case Pattern.Wildcard -> {}
                case Pattern.Binding(name, _) -> {
                    var slot = this.newSlot(ir)
                    this.instr(IrInstr.StoreSlot(slot, val))
                    this.declare(name, slot)
                }
                case _ -> {
                    if (!(this.bindPatternValue(p, ft, val, span))) {
                        return none
                    }
                    var root = this.newSlot(IrTy.Ptr)
                    this.instr(IrInstr.StoreSlot(root, val))
var rv = this.load(root)
                    var c = this.patternTestCond(p, ft, rv, span)
                    if (let none = c) {
                        return none
                    }
                    var cv = 0
                    if (let some(x) = c) {
                        cv = x
                    }
                    if (let some(prev) = acc) {
                        acc = this.combineCond(true, prev, cv)
                    } else {
                        acc = cv
                    }
                }
            }
            pi = pi + 1
        }
        if (let some(v) = acc) {
            return v
        }
        -1
    }

    /// The match condition for an enum variant pattern: the scrutinee value
    /// `v` (of enum type `st`) must carry the variant's tag, and nested
    /// payload conditions are folded in. Payload fields are read only inside a
    /// block guarded by the tag equality, so a mismatched variant is never
    /// dereferenced. Mirrors `enum_variant_cond` in emit.rs.
    fn enumVariantCond(p: Pattern, st: Ty, v: int, span: Span) -> int? {
        var path: List<string> = emptyStrs()
        var payloads: List<Pattern> = emptyPatterns()
        match (p) {
            case Pattern.Variant(pa, pl) -> {
                path = pa
                payloads = pl
            }
            case _ -> {
                this.bad(span, "this match pattern is not lowered yet")
                return none
            }
        }
        var isEnumTy = false
        match (st) {
            case Ty.Enum(_, _) -> isEnumTy = true
            case _ -> {}
        }
        if (!isEnumTy) {
            this.bad(span, "this match pattern is not lowered yet")
            return none
        }
        var ename = ""
        match (st) {
            case Ty.Enum(en, _) -> ename = en
            case _ -> {}
        }
        var tableO: EnumTable? = none
        if (let some(entry) = this.resolved.types.get(ename)) {
            match (entry) {
                case TypeTableEntry.Enum(t) -> tableO = t
                case _ -> {}
            }
        }
        if (let none = tableO) {
            this.bad(span, "unknown enum type `" + ename + "`")
            return none
        }
        if (let some(table) = tableO) {
            var vname = ""
            var valid = false
            if (len(path) == 2) {
                vname = path[1]
                valid = true
            }
            if (len(path) == 1) {
                vname = path[0]
                valid = true
            }
            if (!valid) {
                this.bad(span, "invalid enum variant pattern")
                return none
            }
            var vi = -1
            var found = false
            var ix = 0
            for (variant in table.variants) {
                if (variant.name == vname) {
                    vi = ix
                    found = true
                    break
                }
                ix = ix + 1
            }
            if (!found) {
                this.bad(span, "enum `" + ename + "` has no variant `" + vname + "`")
                return none
            }
            var tag = this.externCallT1("pickle_enum_tag", [IrTy.Ptr], IrTy.Int, [v])
            var viT = this.constTemp(IrConst.Int(vi))
            var eq = this.temp()
            this.instr(IrInstr.BinOp(eq, IrBinOp.Eq, tag, viT))
            var testable = false
            for (pl in payloads) {
                var simple = false
                match (pl) {
                    case Pattern.Binding(_, _) -> simple = true
                    case Pattern.Wildcard -> simple = true
                    case _ -> {}
                }
                if (!simple) {
                    testable = true
                    break
                }
            }
            if (!testable) {
                return eq
            }
            var root = this.newSlot(IrTy.Ptr)
            this.instr(IrInstr.StoreSlot(root, v))
            var resSlot = this.newSlot(IrTy.Bool)
            var onMatch = this.newBlock()
            var onOther = this.newBlock()
            var bjoin = this.newBlock()
            this.term(IrTerm.BranchIf(eq, onMatch, onOther))
            this.cur = onMatch
            var innerConds = this.bindEnumPayloadCond(span, table, vi, payloads, root)
            if (let none = innerConds) {
                return none
            }
            var val = this.constTemp(IrConst.Bool(true))
            if (let some(ic) = innerConds) {
                val = ic
            }
            this.instr(IrInstr.StoreSlot(resSlot, val))
            this.term(IrTerm.Branch(bjoin))
            this.cur = onOther
            var f = this.constTemp(IrConst.Bool(false))
            this.instr(IrInstr.StoreSlot(resSlot, f))
            this.term(IrTerm.Branch(bjoin))
            this.cur = bjoin
            return this.load(resSlot)
        }
        none
    }

    /// Fold the extra match conditions contributed by the nested (non-binding)
    /// payload patterns of enum variant `vi`, whose object pointer sits in the
    /// rooted slot `vSlot`. Binding names are declared separately by
    /// `bindEnumPayloads`; a `-1` return means every payload was a name or
    /// `_`. Mirrors `bind_enum_payload_cond` in emit.rs.
    fn bindEnumPayloadCond(span: Span, table: EnumTable, vi: int, payloads: List<Pattern>, vSlot: int) -> int? {
        var ftypes = table.variants[vi].fields
        var acc: int? = none
        var pi = 0
        while (pi < len(payloads)) {
            var p = payloads[pi]
            var simple = false
            match (p) {
                case Pattern.Binding(_, _) -> simple = true
                case Pattern.Wildcard -> simple = true
                case _ -> {}
            }
            if (simple) {
                pi = pi + 1
                continue
            }
            var ft = Ty.Unknown
            if (pi < len(ftypes)) {
                ft = ftypes[pi]
            }
            var idx = this.constTemp(IrConst.Int(pi))
            var sv = this.load(vSlot)
            var raw = this.externCallT1("pickle_enum_field", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [sv, idx])
            var pv = raw
            var rep = this.elemRep(ft, span)
            if (let none = rep) {
                return none
            }
            var repV = ElemRep.ptr()
            if (let some(r) = rep) {
                repV = r
            }
            if (!(repV.isPtr)) {
                pv = this.externCallT1(repV.unboxSym, [IrTy.Ptr], repV.ir, [raw])
            }
            var root = this.newSlot(IrTy.Ptr)
            this.instr(IrInstr.StoreSlot(root, pv))
            var rv = this.load(root)
            var isEnumAndVariant = false
            match (ft) {
                case Ty.Enum(_, _) -> {
                    var isVariant = false
                    match (p) {
                        case Pattern.Variant(_, _) -> isVariant = true
                        case _ -> {}
                    }
                    if (isVariant) {
                        isEnumAndVariant = true
                    }
                }
                case _ -> {}
            }
            var c = this.patternTestCond(p, ft, rv, span)
            if (isEnumAndVariant) {
                c = this.enumVariantCond(p, ft, rv, span)
            }
            if (let none = c) {
                return none
            }
            var cv = 0
            if (let some(x) = c) {
                cv = x
            }
            if (let some(prev) = acc) {
                acc = this.combineCond(true, prev, cv)
            } else {
                acc = cv
            }
            pi = pi + 1
        }
        if (let some(v) = acc) {
            return v
        }
        -1
    }

    // ---- calls ----

    /// The first user (non-builtin, non-overloaded) callable for `name`.
    /// Rust's `infos.iter().find(|c| !(c.span.file.0 == 0 && c.span.end == 0))`.
    fn userCallableFirst(name: string) -> CallableInfo? {
        if (let some(infos) = this.resolved.fns.get(name)) {
            for (c in infos) {
                if (!(c.span.start == 0 && c.span.end == 0)) {
                    return c
                }
            }
        }
        none
    }

    /// Is `callee` a general function-typed expression (as opposed to a plain
    /// named user/ctor/builtin call, which has its own static paths)? Mirrors
    /// `is_fn_dispatchable` in emit.rs.
    fn isFnDispatchable(callee: Expr) -> bool {
        match (callee.kind) {
            case ExprKind.Ident(name) -> {
                if (this.irModule.funcsByName.has(name)) {
                    return false
                }
                if (this.classByName.has(name)) {
                    return false
                }
                if (strListHas(["print", "println", "len", "alloc", "free", "view", "assert", "expect", "abs", "range", "min", "max", "clamp", "str", "bytes", "read_file", "write_file", "file_exists", "delete", "list_dir", "mkdir", "stream_open_read", "stream_open_write", "stream_open_append", "stdout_stream", "stderr_stream", "args", "exit", "run_cmd", "run_spawn", "proc_wait", "proc_running", "proc_code", "proc_kill", "proc_out_read", "proc_err_read", "proc_in_write", "proc_in_close", "current_dir", "captureBegin", "captureTake", "gcCollect", "gcAllocationsSinceGc", "gcBytesSinceGc", "gcCollectionCount", "gcSetThreshold"], name)) {
                    return false
                }
            }
            case ExprKind.GenericCall(_, _) -> {
                return false
            }
            case _ -> {}
        }
        var isFn = false
        if (let some(t) = this.types.get(spanKey(callee.span))) {
            match (t) {
                case Ty.Fn(_, _) -> isFn = true
                case _ -> {}
            }
        }
        isFn
    }

    /// The value argument of the outermost `expect(...)` in an assertion chain,
    /// plus whether a `.not()` flips the expectation. Mirrors `peel_expect`.
    fn peelExpect(e: Expr) -> ExpectPeel? {
        match (e.kind) {
            case ExprKind.Call(callee, args) -> {
                var unnamed = false
                if (len(args) == 1) {
                    if (let none = args[0].name) {
                        unnamed = true
                    }
                }
                if (len(args) == 1 && !(args[0].spread) && unnamed) {
                    var calledExpect = false
                    match (callee.kind) {
                        case ExprKind.Ident(n) -> {
                            if (n == "expect") {
                                calledExpect = true
                            }
                        }
                        case _ -> {}
                    }
                    if (calledExpect) {
                        return ExpectPeel(args[0].value, false)
                    }
                }
                if (len(args) == 0) {
                    match (callee.kind) {
                        case ExprKind.Member(object, name) -> {
                            if (name == "not") {
                                var p = this.peelExpect(object)
                                if (let some(pp) = p) {
                                    return ExpectPeel(pp.value, !(pp.negated))
                                }
                            }
                        }
                        case _ -> {}
                    }
                }
                none
            }
            case _ -> none
        }
    }

    /// The value argument of a positional-only one-arg expectation method, or
    /// `none` after emitting a diagnostic. Mirrors `expect_single_arg`.
    fn expectSingleArg(e: Expr, method: string, args: List<CallArg>) -> CallArg? {
        if (!(len(args) == 1)) {
            this.bad(e.span, "`.`" + method + "(expected)` takes exactly one argument")
            return none
        }
        var named = false
        if (let some(_) = args[0].name) {
            named = true
        }
        if (named || args[0].spread) {
            this.bad(args[0].span, "`.`" + method + "()` takes a plain positional argument")
            return none
        }
        args[0]
    }

    /// Reject any argument list for a zero-arg expectation method. Returns
    /// `false` (after a diagnostic) when the list is non-empty.
    fn expectNoArgs(e: Expr, method: string, args: List<CallArg>) -> bool {
        if (len(args) == 0) {
            return true
        }
        this.bad(e.span, "`.`" + method + "()` takes no arguments")
        false
    }

    /// `(res OP 0)` with OP flipped by `.not()`. Mirrors `cmp_zero`.
    fn cmpZero(res: int, op: IrBinOp, negated: bool) -> int? {
        var dst = this.temp()
        var zero = this.intConst(0)
        this.instr(IrInstr.BinOp(dst, flipCmp(op, negated), res, zero))
        dst
    }

    /// Hash-identity or structural equality condition for `toBe`/`toEqual`.
    /// Mirrors `expect_eq_cond`.
    fn expectEqCond(v: int, it: IrTy, w: int, wit: IrTy, negated: bool, span: Span) -> int? {
        if (managedIr(it) || managedIr(wit)) {
            var res = this.externCallT1("pickle_expect_obj_eq", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, w])
            return this.cmpZero(res, IrBinOp.Ne, negated)
        }
        var vf = v
        var wf = w
        var unFloat = irTyTag(it) == irTyTag(IrTy.Float) || irTyTag(wit) == irTyTag(IrTy.Float)
        if (unFloat) {
            if (!(irTyTag(it) == irTyTag(IrTy.Float))) {
                if (let some(f) = this.floatCast(v)) {
                    vf = f
                } else {
                    return none
                }
            }
            if (!(irTyTag(wit) == irTyTag(IrTy.Float))) {
                if (let some(f) = this.floatCast(w)) {
                    wf = f
                } else {
                    return none
                }
            }
        }
        var dst = this.temp()
        this.instr(IrInstr.BinOp(dst, flipCmp(IrBinOp.Eq, negated), vf, wf))
        dst
    }

    /// `int` -> `float` promotion (the IR `Itof`). Mirrors `float_cast`.
    fn floatCast(v: int) -> int? {
        var dst = this.temp()
        this.instr(IrInstr.Itof(dst, v))
        dst
    }

    /// Promote `v` to `float` unless its IR type is already `Float`. Mirrors
    /// `emit.rs::coerce_to_float`.
    fn coerceToFloat(v: int, ty: IrTy?) -> int {
        var isFloat = false
        if (let some(t) = ty) {
            match (t) {
                case IrTy.Float -> isFloat = true
                case _ -> {}
            }
        }
        if (isFloat) {
            return v
        }
        var d = this.floatCast(v)
        if (let some(x) = d) {
            return x
        }
        return v
    }

    /// `**`: integer operands stay integral (`pickle_int_pow`); a float on
    /// either side routes through `pickle_float_pow`, promoting the other
    /// operand with an `Itof`. Mirrors `emit.rs` `AstBinOp::Pow`.
    fn emitPow(e: Expr, lhs: Expr, rhs: Expr) -> int? {
        var aO = this.expr(lhs)
        if (let none = aO) {
            return none
        }
        var bO = this.expr(rhs)
        if (let none = bO) {
            return none
        }
        var a = 0
        if (let some(v) = aO) {
            a = v
        }
        var b = 0
        if (let some(v) = bO) {
            b = v
        }
        var aT = this.irty(lhs.span)
        var bT = this.irty(rhs.span)
        var useFloat = false
        if (let some(t) = aT) {
            match (t) {
                case IrTy.Float -> useFloat = true
                case _ -> {}
            }
        }
        if (let some(t) = bT) {
            match (t) {
                case IrTy.Float -> useFloat = true
                case _ -> {}
            }
        }
        if (useFloat) {
            var af = this.coerceToFloat(a, aT)
            var bf = this.coerceToFloat(b, bT)
            return this.externCallT1("pickle_float_pow", [IrTy.Float, IrTy.Float], IrTy.Float, [af, bf])
        }
        return this.externCallT1("pickle_int_pow", [IrTy.Int, IrTy.Int], IrTy.Int, [a, b])
    }

    /// `in`: the right operand selects the container. Mirrors `emit.rs`
    /// `AstBinOp::In` - a `Map` keys through `pickle_map_has`, a `List` routes
    /// through `pickle_list_contains`, a `string` through `pickle_str_contains`.
    fn emitIn(e: Expr, lhs: Expr, rhs: Expr) -> int? {
        if (let some(t) = this.tyOf(rhs.span)) {
            match (t) {
                case Ty.Map(k, _) -> {
                    if (let some(krep) = this.keyRep(k, rhs.span)) {
                        return this.emitInContains(e, lhs, rhs, krep, k, "pickle_map_has")
                    }
                    return none
                }
                case Ty.List(el) -> {
                    if (let some(erep) = this.elemRep(el, rhs.span)) {
                        return this.emitInContains(e, lhs, rhs, erep, el, "pickle_list_contains")
                    }
                    return none
                }
                case Ty.String -> {
                    var needle = this.expr(lhs)
                    if (let some(nv) = needle) {
                        var hay = this.expr(rhs)
                        if (let some(hv) = hay) {
                            return this.externCallT1("pickle_str_contains", [IrTy.Str, IrTy.Str], IrTy.Bool, [hv, nv])
                        }
                    }
                    return none
                }
                case _ -> {}
            }
        }
        this.bad(e.span, "`in` requires a `List`, `Map`, or `string` on the right")
        return none
    }

    /// Shared tail of the `Map`/`List` `in` arms: evaluate the needle and the
    /// container, box the needle to the container's element representation, and
    /// emit the containment call.
    fn emitInContains(e: Expr, lhs: Expr, rhs: Expr, rep: ElemRep, elemTy: Ty, symbol: string) -> int? {
        var needle = this.expr(lhs)
        if (let none = needle) {
            return none
        }
        var coll = this.expr(rhs)
        if (let none = coll) {
            return none
        }
        var nv = 0
        if (let some(v) = needle) {
            nv = v
        }
        var cv = 0
        if (let some(v) = coll) {
            cv = v
        }
        var nTy = elemTy
        if (let some(x) = this.tyOf(lhs.span)) {
            nTy = x
        }
        if (let some(key) = this.packMapKey(rep, nv, nTy, lhs.span)) {
            return this.externCallT1(symbol, [IrTy.Ptr, IrTy.Ptr], IrTy.Bool, [cv, key])
        }
        return none
    }

    /// `<-`: a channel send, a statement with a unit result. The compiler
    /// yields the value-typed `0` so an expression position stays well-formed.
    /// Mirrors `emit.rs` `AstBinOp::Send`.
    fn emitSend(lhs: Expr, rhs: Expr) -> int? {
        var ch = this.expr(lhs)
        if (let none = ch) {
            return none
        }
        var v = this.expr(rhs)
        if (let none = v) {
            return none
        }
        var chV = 0
        if (let some(x) = ch) {
            chV = x
        }
        var vV = 0
        if (let some(x) = v) {
            vV = x
        }
        this.externCallVoid("pickle_channel_send", [IrTy.Int, IrTy.Int], [chV, vV])
        return this.intConst(0)
    }

    /// Truthiness as a branchable condition of a raw value temp. `need` is
    /// `true` when a truthy value passes (folded through `.not()`). Mirrors
    /// `expect_truthy`.
    fn expectTruthy(v: int, it: IrTy, need: bool, span: Span) -> int? {
        match (it) {
            case IrTy.Bool -> {
                var dst = this.temp()
                var z = this.boolConst(false)
                this.instr(IrInstr.BinOp(dst, flipCmp(IrBinOp.Ne, !need), v, z))
                dst
            }
            case IrTy.Char -> {
                var dst = this.temp()
                var z = this.charConst(0)
                this.instr(IrInstr.BinOp(dst, flipCmp(IrBinOp.Ne, !need), v, z))
                dst
            }
            case IrTy.Int -> {
                var dst = this.temp()
                var zero = this.intConst(0)
                this.instr(IrInstr.BinOp(dst, flipCmp(IrBinOp.Ne, !need), v, zero))
                dst
            }
            case IrTy.Float -> {
                var dst = this.temp()
                var z = this.floatConst(0.0)
                this.instr(IrInstr.BinOp(dst, flipCmp(IrBinOp.Ne, !need), v, z))
                dst
            }
            case IrTy.Str | IrTy.Ptr -> {
                var lenv = this.externCallT1("pickle_str_len", [IrTy.Ptr], IrTy.Int, [v])
                this.cmpZero(lenv, IrBinOp.Ne, !need)
            }
            case IrTy.Unit -> this.cmpZero(this.intConst(0), IrBinOp.Ne, !need)
        }
    }

    /// Render a value temp as text for an `Expected:`/`Received:` line.
    /// Mirrors `expect_str`.
    fn expectStr(t: int, it: IrTy, span: Span) -> int? {
        match (it) {
            case IrTy.Int -> this.externCallT1("pickle_str_from_i64", [IrTy.Int], IrTy.Str, [t])
            case IrTy.Float -> this.externCallT1("pickle_str_from_f64", [IrTy.Float], IrTy.Str, [t])
            case IrTy.Bool -> this.externCallT1("pickle_str_from_bool", [IrTy.Bool], IrTy.Str, [t])
            case IrTy.Char -> this.externCallT1("pickle_str_from_char", [IrTy.Char], IrTy.Str, [t])
            case IrTy.Str | IrTy.Ptr -> this.externCallT1("pickle_expect_display", [IrTy.Ptr], IrTy.Str, [t])
            case IrTy.Unit -> this.strConst("none")
        }
    }

    /// Lower one `expect(...)` assertion: the `(ok, expected, received)` triple
    /// decoded by the method name, a `pickle_test_fail_obj(msg)` failure branch,
    /// and the "Expected:/Received:" message rendering. Mirrors `expect_assert`.
fn expectAssert(e: Expr, value: Expr, method: string, args: List<CallArg>, negated: bool) -> int? {
        if (!this.icePoke("expectAssert")) {
            return none
        }
for (a in args) {
            var named = false
            if (let some(_) = a.name) {
                named = true
            }
            if (a.spread || named) {
                this.bad(e.span, "expectation methods take plain positional arguments")
                return none
            }
        }
        var vt = Ty.Unknown
        if (let some(t) = this.tyOf(value.span)) {
            vt = t
        }
        var it = IrTy.Unit
        if (let some(iv) = this.irty(value.span)) {
            it = iv
        } else {
            return none
        }
        var v = -1
        if (let some(vv) = this.expr(value)) {
            v = vv
        } else {
            return none
        }
        var ok = -1
        var expected = -1
        var received = -1
        var badMethod = ""
        match (method) {
            case "toBe" | "toEqual" -> {
                var av = this.expectSingleArg(e, method, args)
                if (let some(arg) = av) {
                    var at = -1
                    if (let some(avt) = this.expr(arg.value)) {
                        at = avt
                    } else {
                        return none
                    }
                    var aIt = IrTy.Unit
                    if (let some(iv) = this.irty(arg.value.span)) {
                        aIt = iv
                    } else {
                        return none
                    }
                    var ev = -1
                    if (let some(x) = this.expectStr(at, aIt, arg.value.span)) {
                        ev = x
                    } else {
                        return none
                    }
                    var rv = -1
                    if (let some(x) = this.expectStr(v, it, value.span)) {
                        rv = x
                    } else {
                        return none
                    }
                    var okv = this.expectEqCond(v, it, at, aIt, negated, e.span)
                    if (let some(o) = okv) {
                        ok = o
                    } else {
                        return none
                    }
                    expected = ev
                    received = rv
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toBeTruthy" | "toBeFalsy" -> {
                if (this.expectNoArgs(e, method, args)) {
                    var rvT = -1
                    if (let some(x) = this.expectStr(v, it, value.span)) {
                        rvT = x
                    } else {
                        return none
                    }
                    var wantTruthy = method == "toBeTruthy"
                    var need = (wantTruthy && !(negated)) || (!(wantTruthy) && negated)
                    var okT = this.expectTruthy(v, it, need, e.span)
                    if (let some(o) = okT) {
                        ok = o
                    } else {
                        return none
                    }
                    if (wantTruthy) {
                        expected = this.strConst("true")
                    } else {
                        expected = this.strConst("false")
                    }
                    received = rvT
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toBeNull" -> {
                if (this.expectNoArgs(e, method, args)) {
                    var rvN = -1
                    if (let some(x) = this.expectStr(v, it, value.span)) {
                        rvN = x
                    } else {
                        return none
                    }
                    var nul = this.nullTemp()
                    if (let some(n) = nul) {
                        var res = this.externCallT1("pickle_expect_obj_eq", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, n])
                        var okN = this.cmpZero(res, IrBinOp.Ne, negated)
                        if (let some(o) = okN) {
                            ok = o
                        } else {
                            return none
                        }
                        expected = this.strConst("none")
                        received = rvN
                    } else {
                        return none
                    }
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toExist" -> {
                if (this.expectNoArgs(e, method, args)) {
                    var rvE = -1
                    if (let some(x) = this.expectStr(v, it, value.span)) {
                        rvE = x
                    } else {
                        return none
                    }
                    var nul = this.nullTemp()
                    if (let some(n) = nul) {
                        var res = this.externCallT1("pickle_expect_obj_eq", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, n])
                        var okE = this.cmpZero(res, IrBinOp.Eq, negated)
                        if (let some(o) = okE) {
                            ok = o
                        } else {
                            return none
                        }
                        expected = this.strConst("a non-none value")
                        received = rvE
                    } else {
                        return none
                    }
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toHaveLength" -> {
                var avL = this.expectSingleArg(e, method, args)
                if (let some(arg) = avL) {
                    var n = -1
                    if (let some(nv) = this.expr(arg.value)) {
                        n = nv
                    } else {
                        return none
                    }
                    var nIt = IrTy.Unit
                    if (let some(iv) = this.irty(arg.value.span)) {
                        nIt = iv
                    } else {
                        return none
                    }
                    var lenT = -1
                    var badLen = false
                    match (vt) {
                        case Ty.String -> lenT = this.externCallT1("pickle_str_len", [IrTy.Str], IrTy.Int, [v])
                        case Ty.List(_) -> lenT = this.externCallT1("pickle_list_len", [IrTy.Ptr], IrTy.Int, [v])
                        case Ty.Map(_, _) -> lenT = this.externCallT1("pickle_map_len", [IrTy.Ptr], IrTy.Int, [v])
                        case _ -> {
                            badLen = true
                            lenT = lenT
                        }
                    }
                    if (badLen) {
                        this.bad(value.span, "`.toHaveLength()` needs a string, list, or map value")
                        return none
                    }
                    var eq = this.temp()
                    this.instr(IrInstr.BinOp(eq, flipCmp(IrBinOp.Eq, negated), lenT, n))
                    ok = eq
                    var evL = -1
                    if (let some(x) = this.expectStr(n, nIt, arg.value.span)) {
                        evL = x
                    } else {
                        return none
                    }
                    var rvL = -1
                    if (let some(x) = this.expectStr(lenT, IrTy.Int, value.span)) {
                        rvL = x
                    } else {
                        return none
                    }
                    expected = evL
                    received = rvL
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toContain" -> {
                var avC = this.expectSingleArg(e, method, args)
                if (let some(arg) = avC) {
                    var needle = -1
                    if (let some(nv) = this.expr(arg.value)) {
                        needle = nv
                    } else {
                        return none
                    }
                    var needleIt = IrTy.Unit
                    if (let some(iv) = this.irty(arg.value.span)) {
                        needleIt = iv
                    } else {
                        return none
                    }
                    var res = -1
                    var badContain = false
                    match (vt) {
                        case Ty.String -> res = this.externCallT1("pickle_expect_str_contains", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, needle])
                        case Ty.List(_) -> {
                            var nty = Ty.Unknown
                            if (let some(gt) = this.tyOf(arg.value.span)) {
                                nty = gt
                            }
                            var nd = -1
                            if (let some(w) = this.optionWrap(needle, nty, arg.value.span)) {
                                nd = w
                            } else {
                                return none
                            }
                            res = this.externCallT1("pickle_expect_list_contains", [IrTy.Ptr, IrTy.Ptr], IrTy.Int, [v, nd])
                        }
                        case _ -> {
                            badContain = true
                            res = res
                        }
                    }
                    if (badContain) {
                        this.bad(value.span, "`.toContain()` needs a string or list value")
                        return none
                    }
                    var okC = this.cmpZero(res, IrBinOp.Ne, negated)
                    if (let some(o) = okC) {
                        ok = o
                    } else {
                        return none
                    }
                    var evC = -1
                    if (let some(x) = this.expectStr(needle, needleIt, arg.value.span)) {
                        evC = x
                    } else {
                        return none
                    }
                    var rvC = -1
                    if (let some(x) = this.expectStr(v, it, value.span)) {
                        rvC = x
                    } else {
                        return none
                    }
                    expected = evC
                    received = rvC
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case "toBeGreaterThan" | "toBeLessThan" -> {
                var avG = this.expectSingleArg(e, method, args)
                if (let some(arg) = avG) {
                    var at = -1
                    if (let some(av) = this.expr(arg.value)) {
                        at = av
                    } else {
                        return none
                    }
                    var aIt = IrTy.Unit
                    if (let some(iv) = this.irty(arg.value.span)) {
                        aIt = iv
                    } else {
                        return none
                    }
                    var vf = v
                    var af = at
                    var unFloat = irTyTag(it) == irTyTag(IrTy.Float) || irTyTag(aIt) == irTyTag(IrTy.Float)
                    if (unFloat) {
                        if (!(irTyTag(it) == irTyTag(IrTy.Float))) {
                            if (let some(f) = this.floatCast(v)) {
                                vf = f
                            } else {
                                return none
                            }
                        }
                        if (!(irTyTag(aIt) == irTyTag(IrTy.Float))) {
                            if (let some(f) = this.floatCast(at)) {
                                af = f
                            } else {
                                return none
                            }
                        }
                    }
                    var cmp = this.temp()
                    var cmpOp = IrBinOp.Gt
                    if (method == "toBeLessThan") {
                        cmpOp = IrBinOp.Lt
                    }
                    this.instr(IrInstr.BinOp(cmp, flipCmp(cmpOp, negated), vf, af))
                    var opTxt = -1
                    if (method == "toBeGreaterThan") {
                        opTxt = this.strConst("> ")
                    } else {
                        opTxt = this.strConst("< ")
                    }
                    var dv = -1
                    if (let some(x) = this.expectStr(at, aIt, arg.value.span)) {
                        dv = x
                    } else {
                        return none
                    }
                    var evG = -1
                    if (let some(x) = this.concatStr([opTxt, dv])) {
                        evG = x
                    } else {
                        return none
                    }
                    var rvG = -1
                    if (let some(x) = this.expectStr(v, it, value.span)) {
                        rvG = x
                    } else {
                        return none
                    }
                    ok = cmp
                    expected = evG
                    received = rvG
                } else {
                    return none
                }
                badMethod = badMethod
            }
            case other -> {
                this.bad(e.span, "unknown expectation method `.`" + other + "()`")
                badMethod = other
            }
        }
        if (len(badMethod) > 0) {
            return none
        }
        var head = this.strConst("Expected:\n")
        var mid = this.strConst("\n\nReceived:\n")
        var tail = this.strConst("\n")
        var msg = -1
        if (let some(mv) = this.concatStr([head, expected, mid, received, tail])) {
            msg = mv
        } else {
            return none
        }
        var cont = this.newBlock()
        var fail = this.newBlock()
        this.term(IrTerm.BranchIf(ok, cont, fail))
        this.cur = fail
        this.externCallVoid("pickle_test_fail_obj", [IrTy.Ptr], [msg])
        this.term(IrTerm.Branch(cont))
        this.cur = cont
        return this.unitTemp()
    }

    /// The argument of a call into a `&T` parameter slot: an explicit/expected
    /// reference is passed by identity (managed) or by address (scalar local),
    /// anything else by value. Mirrors `borrow_arg` in emit.rs.
fn borrowArg(src: Ty?, a: CallArg) -> int? {
        if (!this.icePoke("borrowArg")) {
            return none
        }
        if (let some(hint) = src) {
            var isFn = false
            match (hint) {
                case Ty.Fn(_, _) -> isFn = true
                case _ -> {}
            }
            if (isFn) {
                var gv = this.genericFnArgValue(a.value, hint)
                if (let some(vv) = gv) {
                    return vv
                }
            }
        }
        if (let some(rf) = src) {
            var inner = Ty.Unknown
            var isRef = false
            match (rf) {
                case Ty.Ref(iner) -> {
                    inner = iner
                    isRef = true
                }
                case _ -> {}
            }
            if (isRef) {
                var at = this.tyOf(a.value.span)
                if (let some(at2) = at) {
                    if (tyEq(at2, inner)) {
                        if (let none = scalarIr(inner)) {
                            return this.expr(a.value)
                        }
                        match (a.value.kind) {
                            case ExprKind.Ident(name) -> {
                                var slotO = this.lookup(name)
                                if (let some(slot) = slotO) {
                                    var dst = this.temp()
                                    this.instr(IrInstr.LocalAddr(dst, slot))
                                    return dst
                                }
                                this.bad(a.value.span, "cannot borrow unknown `" + name + "`")
                                return none
                            }
                            case _ -> {
                                this.bad(a.value.span, "implicitly borrowing a scalar needs a plain local variable")
                                return none
                            }
                        }
                    }
                }
            }
        }
        this.expr(a.value)
    }

/// Lower a call whose arguments include a spread (`...list`): build the
    /// boxed argument list, check the spread element count at runtime, and
    /// call the shared spread trampoline of the target. Mirrors
    /// `spread_static_call` in emit.rs.
    fn spreadStaticCall(e: Expr, span: Span, fid: int, pty: List<Ty>, ret: Ty, receiver: int?, args: List<CallArg>) -> int? {
        var refParam = false
        for (t in pty) {
            match (t) {
                case Ty.Ref(_) -> refParam = true
                case _ -> {}
            }
        }
        if (refParam) {
            this.bad(span, "spreading into a `&T` parameter is not lowered yet")
            return none
        }
        var fs = this.fsource.get(fid)
        if (let some(src) = fs) {
            var tl: FnDecl? = none
            match (src) {
                case FnSource.TopLevel(f) -> tl = f
                case _ -> {}
            }
            if (let some(f) = tl) {
                var hasDef = false
                for (p in f.params) {
                    if (let some(_) = p.default) {
                        hasDef = true
                    }
                }
                if (hasDef) {
                    this.bad(span, "spreading into a parameter with a default value is not lowered yet")
                    return none
                }
            }
        }
        var finf = this.finfo.get(fid)
        if (let some(info) = finf) {
            var hasRest = false
            for (p in info.params) {
                if (p.rest) {
                    hasRest = true
                }
            }
            if (hasRest) {
                this.bad(span, "spreading into a rest parameter is only lowered for `println`")
                return none
            }
        }
        var m = 0
        while (m < len(args) && !args[m].spread) {
            m = m + 1
        }
        if (m > len(pty)) {
            this.bad(span, "too many arguments for this call")
            return none
        }
        var spArgO: CallArg? = none
        if (m < len(args)) {
            spArgO = args[m]
        }
        var foundSpread = false
        if (let some(sa) = spArgO) {
            if (sa.spread) {
                foundSpread = true
            }
        }
        if (!foundSpread) {
            this.bad(span, "internal error: missing spread argument")
            return none
        }
        var spArg = CallArg(none, Expr(span, ExprKind.Ident("")), true, span)
        if (let some(sa) = spArgO) {
            spArg = sa
        }
        var matchedList = false
        var elemTy = Ty.Unknown
        if (let some(t) = this.tyOf(spArg.value.span)) {
            match (t) {
                case Ty.List(inner) -> {
                    matchedList = true
                    elemTy = inner
                }
                case _ -> {}
            }
        }
        if (!matchedList) {
            this.bad(spArg.span, "a spread argument must be a `List`")
            return none
        }
        var erepO = this.elemRep(elemTy, spArg.span)
        if (let none = erepO) {
            return none
        }
        var erep = ElemRep.ptr()
        if (let some(re) = erepO) {
            erep = re
        }
        var j = m
        while (j < len(pty)) {
            var pre = this.elemRep(pty[j], spArg.span)
            if (let none = pre) {
                return none
            }
            var prev = ElemRep.ptr()
            if (let some(re) = pre) {
                prev = re
            }
            if (!elemRepSame(prev, erep)) {
                this.bad(span, "spreading over parameters with mixed element representations is not lowered yet")
                return none
            }
            j = j + 1
        }
        var retM = this.mapTy(ret, span)
        if (let none = retM) {
            this.bad(span, "spread call return type is not lowered yet")
            return none
        }
        var retIr = IrTy.Unit
        if (let some(r) = retM) {
            retIr = r
        }
        var tramp = 0
        var trampO = this.spreadTramps.get(fid)
        if (let some(t) = trampO) {
            tramp = t
        } else {
            var recvFlag = false
            if (let some(_) = receiver) {
                recvFlag = true
            }
            tramp = this.pushClassFunc("fn.spread", "pkl_sptramp_" + str(fid), FnSource.SpreadTrampoline(span, fid, pty, ret, recvFlag))
            this.spreadTramps[fid] = tramp
        }
        var resSlot = this.newSlot(retIr)
        var cap = this.intConst(len(pty))
        var xs = this.externCallT1("pickle_list_new", [IrTy.Int], IrTy.Ptr, [cap])
        var base = 0
        if (let some(_) = receiver) {
            base = 1
        }
        var fparams = this.irModule.funcs[fid].params
        var i = 0
        while (i < m) {
            var a = args[i]
            var srcO: Ty? = none
            if (let some(v) = this.srcParamTys.get(fid)) {
                if (i < len(v)) {
                    srcO = v[i]
                }
            }
            var t = -1
            if (let some(tv) = this.borrowArg(srcO, a)) {
                t = tv
            } else {
                return none
            }
            var fparamTy: IrTy? = none
            if (base + i < len(fparams)) {
                fparamTy = fparams[base + i].ty
            } else {
                if (let some(s) = srcO) {
                    fparamTy = this.mapTy(s, a.value.span)
                }
            }
            var isRef2 = false
            if (let some(sr) = srcO) {
                match (sr) {
                    case Ty.Ref(_) -> isRef2 = true
                    case _ -> {}
                }
            }
            var srcVal = t
            if (!isRef2) {
                var fparamIsPtr = false
                if (let some(ft) = fparamTy) {
                    if (irTyTag(ft) == irTyTag(IrTy.Ptr)) {
                        fparamIsPtr = true
                    }
                }
                if (fparamIsPtr) {
                    var vt = Ty.Unknown
                    if (let some(gt) = this.tyOf(a.value.span)) {
                        vt = gt
                    }
                    var w = this.optionWrap(t, vt, a.value.span)
                    if (let some(wv) = w) {
                        srcVal = wv
                    } else {
                        return none
                    }
                }
            }
            var repI = this.elemRep(pty[i], a.value.span)
            if (let none = repI) {
                return none
            }
            var repV = ElemRep.ptr()
            if (let some(re) = repI) {
                repV = re
            }
            if (repV.isPtr) {
                this.externCallVoid("pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [xs, srcVal])
            } else {
                var bx = this.externCallT1(repV.boxSym, [repV.ir], IrTy.Ptr, [srcVal])
                this.externCallVoid("pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [xs, bx])
            }
            i = i + 1
        }
        var sp = this.expr(spArg.value)
        if (let none = sp) {
            return none
        }
        var spV = 0
        if (let some(sv) = sp) {
            spV = sv
        }
        var n = this.externCallT1("pickle_list_len", [IrTy.Ptr], IrTy.Int, [spV])
        var r = this.intConst(len(pty) - m)
        var ok = this.temp()
        this.instr(IrInstr.BinOp(ok, IrBinOp.Eq, n, r))
        var rOk = this.newBlock()
        var rPanic = this.newBlock()
        var join = this.newBlock()
        this.term(IrTerm.BranchIf(ok, rOk, rPanic))
        this.cur = rPanic
        this.externCallVoid("pickle_panic_arity_diff", emptyIrTys(), emptyInts())
        this.term(IrTerm.Branch(join))
        this.cur = rOk
        var rMissing = len(pty) - m
        var k = 0
        while (k < rMissing) {
            var idx = this.intConst(k)
            var raw = this.externCallT1("pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [spV, idx])
            this.externCallVoid("pickle_list_push", [IrTy.Ptr, IrTy.Ptr], [xs, raw])
            k = k + 1
        }
        var callArgs = emptyInts()
        if (let some(recv) = receiver) {
            callArgs.push(recv)
        }
        callArgs.push(xs)
        var dst = this.temp()
        this.instr(IrInstr.Call(dst, Callee.Func(tramp), callArgs))
        // The trampoline tail-calls the target, so a throw from the callee comes
        // back with the flag set on *this* function, and the store below would
        // otherwise write a garbage result into the slot.
        this.guardPropagation(tramp)
        this.instr(IrInstr.StoreSlot(resSlot, dst))
        this.term(IrTerm.Branch(join))
        this.cur = join
        this.load(resSlot)
    }

    /// `...xs` as a `print`/`println` operand: emit a runtime loop that
    /// prints every element individually, unboxing scalar element reps and
    /// passing managed elements straight to `pickle_print_obj`. An empty
    /// spread prints nothing. Mirrors `print_spread_list` in emit.rs.
    fn printSpreadList(span: Span, sp: int, elem: Ty) -> bool {
        var sym = "pickle_print_obj"
        var printIr = IrTy.Ptr
        match (elem) {
            case Ty.Int -> {
                sym = "pickle_print_i64"
                printIr = IrTy.Int
            }
            case Ty.Float -> {
                sym = "pickle_print_f64"
                printIr = IrTy.Float
            }
            case Ty.Bool -> {
                sym = "pickle_print_bool"
                printIr = IrTy.Bool
            }
            case Ty.Byte -> {
                sym = "pickle_print_byte"
                printIr = IrTy.Int
            }
            case Ty.Char -> {
                sym = "pickle_print_char"
                printIr = IrTy.Char
            }
            case _ -> {}
        }
        var repO = this.elemRep(elem, span)
        if (let none = repO) {
            return false
        }
        var rep = ElemRep.ptr()
        if (let some(re) = repO) {
            rep = re
        }
        var seqSlot = this.newSlot(IrTy.Ptr)
        var idxSlot = this.newSlot(IrTy.Int)
        var lenSlot = this.newSlot(IrTy.Int)
        this.instr(IrInstr.StoreSlot(seqSlot, sp))
        var zero = this.temp()
        this.instr(IrInstr.Const(zero, IrConst.Int(0)))
        this.instr(IrInstr.StoreSlot(idxSlot, zero))
        var seqL = this.load(seqSlot)
        var lenT = this.externCallT1("pickle_list_len", [IrTy.Ptr], IrTy.Int, [seqL])
        this.instr(IrInstr.StoreSlot(lenSlot, lenT))
        var condId = this.newBlock()
        var bodyId = this.newBlock()
        var nextId = this.newBlock()
        var endId = this.newBlock()
        this.term(IrTerm.Branch(condId))
        this.cur = condId
        var curT = this.load(idxSlot)
        var endL = this.load(lenSlot)
        var cmp = this.temp()
        this.instr(IrInstr.BinOp(cmp, IrBinOp.Lt, curT, endL))
        this.term(IrTerm.BranchIf(cmp, bodyId, endId))
        this.cur = bodyId
        var curI = this.load(idxSlot)
        var seqL2 = this.load(seqSlot)
        var raw = this.externCallT1("pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr, [seqL2, curI])
        var isScalarElem = false
        match (elem) {
            case Ty.Int | Ty.Float | Ty.Bool | Ty.Byte | Ty.Char -> isScalarElem = true
            case _ -> {}
        }
        var v = raw
        if (!rep.isPtr && isScalarElem) {
            v = this.externCallT1(rep.unboxSym, [IrTy.Ptr], rep.ir, [raw])
        }
        this.externCallVoid(sym, [printIr], [v])
        this.term(IrTerm.Branch(nextId))
        this.cur = nextId
        var c = this.load(idxSlot)
        var one = this.temp()
        this.instr(IrInstr.Const(one, IrConst.Int(1)))
        var nxt = this.temp()
        this.instr(IrInstr.BinOp(nxt, IrBinOp.Add, c, one))
        this.instr(IrInstr.StoreSlot(idxSlot, nxt))
        this.term(IrTerm.Branch(condId))
        this.cur = endId
        true
    }

    /// The call-lowering hub. Mirrors `call` in emit.rs: expect-method
    /// dispatch, `.free()` on `#[manualAlloc]`, `Enum.Variant(...)` ctors,
    /// plain member calls, generic calls (explicit and inferred), fn-value
    /// dispatch, plain user functions, class/struct ctors, then the builtins.
fn call(e: Expr, callee: Expr, args: List<CallArg>) -> int? {
        if (this.iceDepth > 150) {
            return none
        }
        this.iceDepth = this.iceDepth + 1
        this.icePath.push("call")
        var r = this.call1(e, callee, args)
        this.iceDepth = this.iceDepth - 1
        r
    }

fn call1(e: Expr, callee: Expr, args: List<CallArg>) -> int? {
        if (!this.icePoke("call1")) {
            return none
        }
        match (callee.kind) {
            case ExprKind.Member(object, name) -> {
                if (isExpectMethod(name)) {
                    var p = this.peelExpect(object)
                    if (let some(pe) = p) {
                        return this.expectAssert(e, pe.value, name, args, pe.negated)
                    }
                }
                if (name == "free") {
                    match (object.kind) {
                        case ExprKind.Ident(id) -> {
                            if (this.isManual(id)) {
                                if (!(len(args) == 0)) {
                                    this.bad(e.span, "`free()` takes no arguments")
                                    return none
                                }
                                var obj = -1
                                if (let some(ov) = this.expr(object)) {
                                    obj = ov
                                } else {
                                    return none
                                }
                                this.externCallVoid("pickle_manual_free", [IrTy.Ptr], [obj])
                                return this.unitTemp()
                            }
                        }
                        case _ -> {}
                    }
                }
                var enO = exprKindIdentName(object)
                if (let some(enumName) = enO) {
                    if (let some(entry) = this.resolved.types.get(enumName)) {
                        match (entry) {
                            case TypeTableEntry.Enum(t) -> {
                                return this.enumCtor(e, t, name, args)
                            }
                            case _ -> {}
                        }
                    }
                }
                return this.methodCall(e, object, name, args)
            }
            case ExprKind.GenericCall(name2, typeArgs) -> {
                return this.genericCall(e, name2, typeArgs, args)
            }
            case ExprKind.Ident(cname) -> {
                var inf = this.userCallableFirst(cname)
                if (let some(info) = inf) {
                    if (!(len(info.generics) == 0)) {
                        var argTys = this.inferGenericFnArgs(e.span, info, args)
                        if (let some(aa) = argTys) {
                            return this.genericFnCall(e, info, aa, args)
                        }
                        return none
                    }
                }
            }
            case _ -> {}
        }
        if (let some(cid) = this.owner) {
            var enM = exprKindIdentName(callee)
            if (let some(mname) = enM) {
                var mvO = this.methodIds.get(pairKey(str(cid), mname))
                if (let some(mv) = mvO) {
                    if (mv.isStatic) {
                        return this.callMethod(e, mv.fid, args, none)
                    }
                    var th = this.thisValue(e)
                    if (let none = th) {
                        return none
                    }
                    var thV = 0
                    if (let some(t) = th) {
                        thV = t
                    }
                    var vb = this.virtualDispatch.get(pairKey(str(cid), mname))
                    if (let some(branches) = vb) {
                        if (!(len(branches) == 0)) {
                            return this.virtualMethodCall(e, mv.fid, args, thV, branches)
                        }
                    }
                    return this.callMethod(e, mv.fid, args, thV)
                }
            }
        }
        if (this.isFnDispatchable(callee)) {
            return this.fnValueCall(e, callee, args)
        }
        var enO2 = exprKindIdentName(callee)
        if (let none = enO2) {
            this.bad(e.span, "only plain function calls are lowered yet")
            return none
        }
        var name = ""
        if (let some(nm) = enO2) {
            name = nm
        }
var fidO = this.irModule.funcsByName.get(name)
        if (let some(fid) = fidO) {
            if (anySpread(args)) {
                var pty = this.srcParamList(fid)
                var rt = this.callRetFor(fid)
                return this.spreadStaticCall(e, e.span, fid, pty, rt, none, args)
            }
            var fparams = this.irModule.funcs[fid].params
            var argTemps = emptyInts()
            var i = 0
            while (i < len(args)) {
                var a = args[i]
                var srcO: Ty? = none
                if (let some(v) = this.srcParamTys.get(fid)) {
                    if (i < len(v)) {
                        srcO = v[i]
                    }
                }
                var isRef = false
                if (let some(sr) = srcO) {
                    match (sr) {
                        case Ty.Ref(_) -> isRef = true
                        case _ -> {}
                    }
                }
                var t = -1
                if (let some(tv) = this.borrowArg(srcO, a)) {
                    t = tv
                } else {
                    return none
                }
                var fparamIsPtr = false
                if (i < len(fparams)) {
                    if (irTyTag(fparams[i].ty) == irTyTag(IrTy.Ptr)) {
                        fparamIsPtr = true
                    }
                }
                var finalT = t
                if (!isRef && fparamIsPtr) {
                    var vt = Ty.Unknown
                    if (let some(gt) = this.tyOf(a.value.span)) {
                        vt = gt
                    }
                    if (let some(w) = this.optionWrap(t, vt, a.value.span)) {
                        finalT = w
                    } else {
                        return none
                    }
                }
                argTemps.push(finalT)
                i = i + 1
            }
            var dst = this.temp()
            this.instr(IrInstr.Call(dst, Callee.Func(fid), argTemps))
            this.guardPropagation(fid)
            return dst
        }
var cidO = this.classByName.get(name)
        if (let some(cid) = cidO) {
            var ctorO = this.ctorIds.get(cid)
            if (let some(fid) = ctorO) {
                if (anySpread(args)) {
                    var pty = this.srcParamList(fid)
                    return this.spreadStaticCall(e, e.span, fid, pty, Ty.Class(name, emptyTys()), none, args)
                }
                var fparams = this.irModule.funcs[fid].params
                var argTemps = emptyInts()
                var i = 0
                while (i < len(args)) {
                    var a = args[i]
                    var srcO: Ty? = none
                    if (let some(v) = this.srcParamTys.get(fid)) {
                        if (i < len(v)) {
                            srcO = v[i]
                        }
                    }
                    var isRef = false
                    if (let some(sr) = srcO) {
                        match (sr) {
                            case Ty.Ref(_) -> isRef = true
                            case _ -> {}
                        }
                    }
                    var t = -1
                    if (let some(tv) = this.borrowArg(srcO, a)) {
                        t = tv
                    } else {
                        return none
                    }
                    var fparamIsPtr = false
                    if (i < len(fparams)) {
                        if (irTyTag(fparams[i].ty) == irTyTag(IrTy.Ptr)) {
                            fparamIsPtr = true
                        }
                    }
                    var finalT = t
                    if (!isRef && fparamIsPtr) {
                        var vt = Ty.Unknown
                        if (let some(gt) = this.tyOf(a.value.span)) {
                            vt = gt
                        }
                        if (let some(w) = this.optionWrap(t, vt, a.value.span)) {
                            finalT = w
                        } else {
                            return none
                        }
                    }
                    argTemps.push(finalT)
                    i = i + 1
                }
                var dst = this.temp()
                this.instr(IrInstr.Call(dst, Callee.Func(fid), argTemps))
                this.guardPropagation(fid)
                return dst
            }
            this.bad(e.span, "`" + name + "` has no constructor")
            return none
        }
        match (name) {
            case "assert" -> {
                if (len(args) == 0 || len(args) > 2) {
                    this.bad(e.span, "`assert(cond, msg?)` takes a condition and an optional message")
                    return none
                }
                var cond = -1
                if (let some(cv) = this.expr(args[0].value)) {
                    cond = cv
                } else {
                    return none
                }
                var cont = this.newBlock()
                var fail = this.newBlock()
                this.term(IrTerm.BranchIf(cond, cont, fail))
                this.cur = fail
                var msg = -1
                if (len(args) == 2) {
                    if (let some(mv) = this.expr(args[1].value)) {
                        msg = mv
                    } else {
                        return none
                    }
                } else {
                    if (let some(nv) = this.nullTemp()) {
                        msg = nv
                    } else {
                        return none
                    }
                }
                this.externCallVoid("pickle_test_fail_obj", [IrTy.Ptr], [msg])
                this.term(IrTerm.Branch(cont))
                this.cur = cont
                return this.unitTemp()
            }
            case "expect" -> {
                if (!(len(args) == 1)) {
                    this.bad(e.span, "`expect(value)` takes exactly one value")
                    return none
                }
                var namedE = false
                if (let some(_) = args[0].name) {
                    namedE = true
                }
                if (namedE || args[0].spread) {
                    this.bad(e.span, "`expect(value)` takes exactly one value")
                    return none
                }
                return this.expr(args[0].value)
            }
case "print" | "println" -> {
                var newline = name == "println"
                for (a in args) {
                    if (a.spread) {
                        var listMatched = false
                        var elemT = Ty.Unknown
                        if (let some(gt) = this.tyOf(a.value.span)) {
                            match (gt) {
                                case Ty.List(inner) -> {
                                    listMatched = true
                                    elemT = inner
                                }
                                case _ -> {}
                            }
                        }
                        if (!listMatched) {
                            this.bad(a.span, "spread argument in `print` must be a `List`")
                            return none
                        }
                        var spv = -1
                        if (let some(sv) = this.expr(a.value)) {
                            spv = sv
                        } else {
                            return none
                        }
                        if (!this.printSpreadList(a.span, spv, elemT)) {
                            return none
                        }
                    } else {
                    var t = -1
                    if (let some(tv) = this.expr(a.value)) {
                        t = tv
                    } else {
                        return none
                    }
                    var sym = ""
                    var pty = IrTy.Ptr
                    var unsupported = false
                    if (let some(gt) = this.tyOf(a.value.span)) {
                        match (gt) {
                            case Ty.Int -> {
                                sym = "pickle_print_i64"
                                pty = IrTy.Int
                            }
                            case Ty.Float -> {
                                sym = "pickle_print_f64"
                                pty = IrTy.Float
                            }
                            case Ty.Bool -> {
                                sym = "pickle_print_bool"
                                pty = IrTy.Bool
                            }
                            case Ty.Byte -> {
                                sym = "pickle_print_byte"
                                pty = IrTy.Int
                            }
                            case Ty.Char -> {
                                sym = "pickle_print_char"
                                pty = IrTy.Char
                            }
                            case Ty.String | Ty.List(_) | Ty.Map(_, _) | Ty.Enum(_, _, _) | Ty.Class(_, _) | Ty.Struct(_, _) -> {
                                sym = "pickle_print_obj"
                                pty = IrTy.Ptr
                            }
                            case _ -> {
                                unsupported = true
                                pty = pty
                            }
                        }
                    } else {
                        unsupported = true
                        pty = pty
                    }
                    if (unsupported) {
                        this.bad(a.value.span, "unsupported `print` argument type")
                        return none
                    }
                    this.externCallVoid(sym, [pty], [t])
                    }
                }
                if (newline) {
                    this.externCallVoid("pickle_print_newline", emptyIrTys(), emptyInts())
                }
                return this.unitTemp()
            }
            case "alloc" -> {
                if (!(len(args) == 2)) {
                    this.bad(e.span, "`alloc(T, count)` takes two arguments")
                    return none
                }
                var stride = 0
                var badAlloc = false
                if (let some(gt) = this.tyOf(args[0].value.span)) {
                    match (gt) {
                        case Ty.Int | Ty.Float -> stride = 8
                        case Ty.Char -> stride = 4
                        case Ty.Bool -> stride = 1
                        case _ -> {
                            badAlloc = true
                            stride = stride
                        }
                    }
                } else {
                    badAlloc = true
                    stride = stride
                }
                if (badAlloc) {
                    this.bad(args[0].span, "`alloc` currently only supports scalar element types (int, float, bool, char)")
                    return none
                }
                var count = -1
                if (let some(cv) = this.expr(args[1].value)) {
                    count = cv
                } else {
                    return none
                }
                var s = this.intConst(stride)
                var size = this.temp()
                this.instr(IrInstr.BinOp(size, IrBinOp.Mul, count, s))
                return this.externCallT1("pickle_raw_alloc", [IrTy.Int], IrTy.Int, [size])
            }
            case "view" -> {
                if (len(args) != 1) {
                    this.bad(e.span, "`view(obj)` takes one argument")
                    return none
                }
                var v = 0
                if (let some(pv) = this.expr(args[0].value)) {
                    v = pv
                } else {
                    return none
                }
                // A managed value already evaluates to its object address in
                // IR; the form simply re-types it as a raw `*int` for the
                // caller. No runtime call, no copy.
                return v
            }
            case "free" -> {
                if (!(len(args) == 1)) {
                    this.bad(e.span, "`free(p)` takes one argument")
                    return none
                }
                var p = -1
                if (let some(pv) = this.expr(args[0].value)) {
                    p = pv
                } else {
                    return none
                }
                this.externCallVoid("pickle_raw_free", [IrTy.Int], [p])
                return this.unitTemp()
            }
            case "len" -> {
                if (!(len(args) == 1)) {
                    this.bad(e.span, "`len` takes one argument")
                    return none
                }
                var t = -1
                if (let some(tv) = this.expr(args[0].value)) {
                    t = tv
                } else {
                    return none
                }
                if (let some(gt) = this.tyOf(args[0].value.span)) {
                    match (gt) {
                        case Ty.String -> { return this.externCallT1("pickle_str_len", [IrTy.Str], IrTy.Int, [t]) }
                        case Ty.List(_) -> { return this.externCallT1("pickle_list_len", [IrTy.Ptr], IrTy.Int, [t]) }
                        case Ty.Map(_, _) -> { return this.externCallT1("pickle_map_len", [IrTy.Ptr], IrTy.Int, [t]) }
                        case _ -> {}
                    }
                }
                this.bad(e.span, "`len` over this type is not lowered yet")
                none
            }
            case "abs" -> {
                if (!(len(args) == 1)) {
                    this.bad(e.span, "`abs(x)` takes exactly one argument")
                    return none
                }
                var namedA = false
                if (let some(_) = args[0].name) {
                    namedA = true
                }
                if (namedA || args[0].spread) {
                    this.bad(e.span, "`abs(x)` takes exactly one argument")
                    return none
                }
                var v = -1
                if (let some(vv) = this.expr(args[0].value)) {
                    v = vv
                } else {
                    return none
                }
                var vit = IrTy.Unit
                if (let some(iv) = this.irty(args[0].value.span)) {
                    vit = iv
                } else {
                    return none
                }
                var zero = -1
                var badAbs = false
                match (vit) {
                    case IrTy.Int -> zero = this.intConst(0)
                    case IrTy.Float -> zero = this.floatConst(0.0)
                    case _ -> {
                        badAbs = true
                        zero = zero
                    }
                }
                if (badAbs) {
                    this.bad(args[0].value.span, "`abs` requires an `int` or `float` argument")
                    return none
                }
                var isNeg = this.temp()
                this.instr(IrInstr.BinOp(isNeg, IrBinOp.Lt, v, zero))
                var negV = this.temp()
                this.instr(IrInstr.UnOp(negV, IrUnOp.Neg, v))
                var resSlot = this.newSlot(vit)
                var negB = this.newBlock()
                var posB = this.newBlock()
                var join = this.newBlock()
                this.term(IrTerm.BranchIf(isNeg, negB, posB))
                this.cur = negB
                this.instr(IrInstr.StoreSlot(resSlot, negV))
                this.term(IrTerm.Branch(join))
                this.cur = posB
                this.instr(IrInstr.StoreSlot(resSlot, v))
                this.term(IrTerm.Branch(join))
                this.cur = join
                return this.load(resSlot)
            }
            case "min" | "max" -> {
                if (!(len(args) == 2)) {
                    this.bad(e.span, "`" + name + "(a, b)` takes exactly two arguments")
                    return none
                }
                var namedM0 = false
                if (let some(_) = args[0].name) {
                    namedM0 = true
                }
                var namedM1 = false
                if (let some(_) = args[1].name) {
                    namedM1 = true
                }
                if (namedM0 || args[0].spread || namedM1 || args[1].spread) {
                    this.bad(e.span, "`" + name + "(a, b)` takes exactly two arguments")
                    return none
                }
                var it = IrTy.Unit
                if (let some(iv) = this.irty(args[0].value.span)) {
                    it = iv
                } else {
                    return none
                }
                var badMinMax = false
                if (!(irTyTag(it) == irTyTag(IrTy.Int)) && !(irTyTag(it) == irTyTag(IrTy.Float))) {
                    badMinMax = true
                }
                if (badMinMax) {
                    this.bad(e.span, "`min`/`max` requires `int` or `float` arguments")
                    return none
                }
                var a = -1
                if (let some(av) = this.expr(args[0].value)) {
                    a = av
                } else {
                    return none
                }
                var b = -1
                if (let some(bv) = this.expr(args[1].value)) {
                    b = bv
                } else {
                    return none
                }
                var pickA = this.temp()
                var op = IrBinOp.Gt
                if (name == "min") {
                    op = IrBinOp.Lt
                }
                this.instr(IrInstr.BinOp(pickA, op, a, b))
                var resSlot = this.newSlot(it)
                var aB = this.newBlock()
                var bB = this.newBlock()
                var join = this.newBlock()
                this.term(IrTerm.BranchIf(pickA, aB, bB))
                this.cur = aB
                this.instr(IrInstr.StoreSlot(resSlot, a))
                this.term(IrTerm.Branch(join))
                this.cur = bB
                this.instr(IrInstr.StoreSlot(resSlot, b))
                this.term(IrTerm.Branch(join))
                this.cur = join
                return this.load(resSlot)
            }
            case "clamp" -> {
                if (!(len(args) == 3)) {
                    this.bad(e.span, "`clamp(x, lo, hi)` takes exactly three arguments")
                    return none
                }
                var badClamp = false
                for (a in args) {
                    var named = false
                    if (let some(_) = a.name) {
                        named = true
                    }
                    if (named || a.spread) {
                        badClamp = true
                    }
                }
                if (badClamp) {
                    this.bad(e.span, "`clamp(x, lo, hi)` takes exactly three arguments")
                    return none
                }
                var it = IrTy.Unit
                if (let some(iv) = this.irty(args[0].value.span)) {
                    it = iv
                } else {
                    return none
                }
                var badType = false
                if (!(irTyTag(it) == irTyTag(IrTy.Int)) && !(irTyTag(it) == irTyTag(IrTy.Float))) {
                    badType = true
                }
                if (badType) {
                    this.bad(e.span, "`clamp` requires `int` or `float` arguments")
                    return none
                }
                var x = -1
                if (let some(xv) = this.expr(args[0].value)) {
                    x = xv
                } else {
                    return none
                }
                var lo = -1
                if (let some(lv) = this.expr(args[1].value)) {
                    lo = lv
                } else {
                    return none
                }
                var hi = -1
                if (let some(hv) = this.expr(args[2].value)) {
                    hi = hv
                } else {
                    return none
                }
                var maxCond = this.temp()
                this.instr(IrInstr.BinOp(maxCond, IrBinOp.Gt, x, lo))
                var mid = this.newSlot(it)
                var takeX = this.newBlock()
                var takeLo = this.newBlock()
                var maxJoin = this.newBlock()
                this.term(IrTerm.BranchIf(maxCond, takeX, takeLo))
                this.cur = takeX
                this.instr(IrInstr.StoreSlot(mid, x))
                this.term(IrTerm.Branch(maxJoin))
                this.cur = takeLo
                this.instr(IrInstr.StoreSlot(mid, lo))
                this.term(IrTerm.Branch(maxJoin))
                this.cur = maxJoin
                var maxv = this.load(mid)
                var minCond = this.temp()
                this.instr(IrInstr.BinOp(minCond, IrBinOp.Lt, maxv, hi))
                var resSlot = this.newSlot(it)
                var takeMax = this.newBlock()
                var takeHi = this.newBlock()
                var join = this.newBlock()
                this.term(IrTerm.BranchIf(minCond, takeMax, takeHi))
                this.cur = takeMax
                this.instr(IrInstr.StoreSlot(resSlot, maxv))
                this.term(IrTerm.Branch(join))
                this.cur = takeHi
                this.instr(IrInstr.StoreSlot(resSlot, hi))
                this.term(IrTerm.Branch(join))
                this.cur = join
                return this.load(resSlot)
            }
            case "str" -> {
                if (!(len(args) == 1)) {
                    this.bad(e.span, "`str(x)` takes exactly one argument")
                    return none
                }
                var namedS = false
                if (let some(_) = args[0].name) {
                    namedS = true
                }
                if (namedS || args[0].spread) {
                    this.bad(e.span, "`str(x)` takes exactly one argument")
                    return none
                }
                var v = -1
                if (let some(vv) = this.expr(args[0].value)) {
                    v = vv
                } else {
                    return none
                }
                var isByteList = false
                if (let some(gt) = this.tyOf(args[0].value.span)) {
                    match (gt) {
                        case Ty.List(inner) -> {
                            match (inner) {
                                case Ty.Byte -> isByteList = true
                                case _ -> {}
                            }
                        }
                        case _ -> {}
                    }
                }
                if (isByteList) {
                    return this.externCallT1("pickle_str_from_list", [IrTy.Ptr], IrTy.Str, [v])
                }
                if (let some(iv) = this.irty(args[0].value.span)) {
                    match (iv) {
case IrTy.Int -> { return this.externCallT1("pickle_str_from_i64", [IrTy.Int], IrTy.Str, [v]) }
                    case IrTy.Float -> { return this.externCallT1("pickle_str_from_f64", [IrTy.Float], IrTy.Str, [v]) }
