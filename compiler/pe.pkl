module compiler.pe

import { buildExe, FailBox } from compiler.pelink
import { coffRead } from compiler.objread

fn listFrom(s: string) -> List<int> {
    var out = [0]
    out.pop()
    var i = 0
    while (i < len(s)) {
        out.push(s[i] as int)
        i = i + 1
    }
    out
}

fn main() {
    let argv = args()
    if (len(argv) < 2) {
        println("PE NO ARGS")
        return
    }
    if (let some(src) = read_file(argv[0])) {
        let ob = coffRead(argv[0], listFrom(src))
        let fb = FailBox()
        if (let some(blob) = buildExe(ob, "pickle_main", fb)) {
            if (write_file(argv[1], strFrom(blob))) {
                println("PE WROTE " + str(len(blob)) + " bytes")
            } else {
                println("PE WRITE FAIL")
            }
        } else {
            println("PE FAIL: " + fb.text)
        }
    } else {
        println("PE READ FAIL")
    }
}

fn strFrom(bs: List<int>) -> string {
    var sb = StringBuilder()
    var i = 0
    while (i < len(bs)) {
        sb.appendByte(bs[i] as byte)
        i = i + 1
    }
    sb.toString()
}