module compiler.parserbag

import * from compiler.ast
import { Span, Diagnostic, DiagnosticSink } from compiler.diag
import { LexedToken, StrLit, StrSeg, Tok, plainTok } from compiler.token

// ==== parser bag (classes/enums) ====

class BinopInfo {
    var prec: int
    var op: BinOp

    constructor(prec: int, op: BinOp) {
        this.prec = prec
        this.op = op
    }
}

class CallParts {
    var callee: string
    var args: List<CallArg>

    constructor(callee: string, args: List<CallArg>) {
        this.callee = callee
        this.args = args
    }
}

class Parser {
    var tokens: List<LexedToken>
    var pos: int
    var diags: DiagnosticSink
    var failed: bool
    var intLiteralOverflow: bool

    constructor(tokens: List<LexedToken>, diags: DiagnosticSink) {
        this.tokens = tokens
        this.pos = 0
        this.diags = diags
        this.failed = false
        this.intLiteralOverflow = false
    }

    // ---------- token helpers ----------















    /// Value of an integer literal `Number` token. The lexer rejects a literal
    /// that overflows i64 by leaving `ival` unset, but it leaves it unset for
    /// malformed digits too; without this check `?? 0` would silently turn
    /// `99999999999999999999999` into `0`. A well-formed overflow is recorded for
    /// codegen to reject (see `Program.intLiteralOverflow`) and the literal
    /// degrades to 0 in the meantime; malformed digits stay 0 quietly, which is
    /// what the Rust front end does with them too.


    // Skip newlines if the preceding token implies expression continuation.

    // True when an operator-prefixed next line should be glued onto the
    // expression currently being parsed.





    // ---------- program ----------













    // ---------- items ----------


















    /// `try BODY catch (BINDER)? BLOCK finally BLOCK?`
    ///
    /// The binder is optional, so `catch { ... }` is a handler that discards
    /// the payload. A `try` with neither a `catch` nor a `finally` is an
    /// error rather than a silent no-op, and a second `catch` is rejected
    /// rather than dropped, both matching `parser.rs::parse_try_stmt`.

    /// `throw EXPR`. The value is any expression, but the checker requires it
    /// to be a `string`; the parser stays permissive so the diagnostic points at
    /// the type rather than the syntax.




    /// A top-level `var name[: T] = expr` declaration. The initializer is
    /// required: there is no separate declaration-then-assign form at top
    /// level, and the emitted symbol is always in `.data` or `.bss`.

    // ---------- types ----------






    // ---------- patterns ----------



    // ---------- expressions ----------














    /// `async fn (...) [-> R] { ... }` / `=> expr`, lowered into two nested
    /// ordinary lambdas so the existing closure machinery handles everything
    /// downstream:
    ///
    /// async fn (p1, ...) -> R { body }
    ///   == fn (p1, ...) { fn () -> R { body } }
    ///
    /// Calling the outer lambda returns the inner zero-argument closure (the
    /// future) without running `body`; `await` drives it.

    /// The token that follows a `<` has to be able to open a type, or this is a
    /// comparison and not a generic instantiation.
    ///
    /// Without this, `if (a < 1) { x } else if (b > 2) { y }` parses the first
    /// `<` as a generic argument list, because the `>` in `b > 2` balances it.
    /// `parseTypePrefix` accepts `*`, `&`, `fn`, `(`, an identifier, and `_`;
    /// this is that same set, so a valid `name<T>` still takes this path.







    // ---------- type declarations ----------











}

enum GenericCallFlavor {
    Call
    Value
    None
}
