module compiler.irop_test

import * from compiler.ir
import { optimizeModule } from compiler.irop

fn deadChainFunc() -> IrFunc {
    var ins = [IrInstr.Const(0, IrConst.Int(1))]
    var i = 1
    while (i <= 12) {
        ins.push(IrInstr.Copy(i, i - 1))
        i = i + 1
    }
    let block = IrBlock(0, ins, IrTerm.Return(none))
    IrFunc("dead_chain", "dead_chain", [], IrTy.Unit, [], 0, [block], false, false, [])
}

test fn dce_reaches_a_fixed_point_beyond_eight_definitions() {
    let f = deadChainFunc()
    let m = IrModule([f], [], {"::seed::": 0}, [], [])
    let out = optimizeModule(m)
    expect(len(out.funcs[0].blocks[0].instrs)).toBe(0)
}
