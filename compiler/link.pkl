module compiler.link

import { CoffObj, CoffSection, CoffSym, ArInfo, ArMember, coffRead, arRead, blobFrom, hex4 } from compiler.objread

fn main() {
    let argv = args()
    if (len(argv) < 2) {
        println("LINKREAD NO ARGS")
        return
    }
    var ok = true
    if (let some(os) = read_file(argv[0])) {
        let ob = coffRead(argv[0], blobFrom(os))
        println("OBJ " + argv[0])
        println("  machine=0x" + hex4(ob.machine) + " secs=" + str(len(ob.secs)) + " syms=" + str(len(ob.syms)))
        var i = 0
        while (i < len(ob.secs)) {
            let cs = ob.secs[i]
            println("  SEC " + cs.name + " raw=" + str(cs.sizeRaw) + " nreloc=" + str(cs.nReloc))
            i = i + 1
        }
        var s = 0
        while (s < len(ob.syms)) {
            let sy = ob.syms[s]
            println("  SYM " + sy.name + " sec=" + str(sy.sec) + " val=" + str(sy.value) + " scl=" + str(sy.scl))
            s = s + 1
        }
    } else {
        println("OBJ READ FAIL")
        ok = false
    }
    if (let some(ars) = read_file(argv[1])) {
        let a = arRead(blobFrom(ars))
        var m = 0
        while (m < len(a.members)) {
            println("AR " + str(m) + " " + a.members[m].name + " size=" + str(len(a.members[m].data)))
            m = m + 1
        }
    } else {
        println("AR READ FAIL")
        ok = false
    }
    if (ok) {
        println("LINKREAD OK")
    } else {
        println("LINKREAD FAIL")
    }
}