fn checkTaskBody(ck: Checker, e: Expr, bname: string, args: List<CallArg>, bodyIndex: int) -> Ty {
        var label = "`thread_spawn(body)`"
        if (bodyIndex != 0) {
            label = "`once_run(once, body)`"
        }
        if (!(len(args) == bodyIndex + 1)) {
            err(ck, e.span, "{label} takes exactly one body argument")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        var bi = 0
        for (a in args) {
            if (bi == bodyIndex) {
                bi = bi + 1
                continue
            }
            let t = checkExpr(ck, a.value)
            if (!(t == Ty.Int || t == Ty.Unknown)) {
                err(ck, a.value.span, "a synchronisation handle is an `int`")
                return Ty.Unknown
            }
            bi = bi + 1
        }
        let body = checkExpr(ck, args[bodyIndex].value)
        match (body) {
            case Ty.Fn(params, ret) -> {
                if (len(params) != 0) {
                    err(ck, args[bodyIndex].value.span, "{label}'s body must take no parameters")
                } else if (!(ret == Ty.Empty || ret == Ty.Unknown)) {
                    err(ck, args[bodyIndex].value.span, "{label}'s body must return nothing")
                }
            }
            case Ty.Unknown -> {}
            case other -> {
                err(ck, args[bodyIndex].value.span, "{label}'s body must be a function, found `{bareName(other)}`")
            }
        }
        if (bname == "once_run") {
            Ty.Bool
        } else {
            Ty.Int
        }
}

