fn checkHandle(ck: Checker, a: CallArg) -> bool {
        let at = checkExpr(ck, a.value)
        match (at) {
            case Ty.Stream -> { return true }
            case Ty.Unknown -> { return true }
            case _ -> {}
        }
        err(ck, a.value.span, "the process handle must be a `Stream`")
        false
}

fn checkRunCmd(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        var special = false
        for (a in args) {
            if (!isNoneStr(a.name) || a.spread) {
                special = true
            }
        }
        if (len(args) != 8 || special) {
            err(ck, e.span, "`run_cmd(argv, cwd, envs, env_removes, stdin_bytes, max_out, timeout_ms, inherit_io)` takes exactly eight argument(s)")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        let av = checkExpr(ck, args[0].value)
        var ok = false
        match (av) {
            case Ty.List(it) -> {
                match (it) {
                    case Ty.String -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case Ty.Unknown -> { ok = true }
            case _ -> {}
        }
        if (!ok) {
            err(ck, args[0].value.span, "`run_cmd`'s `argv` must be a `List<string>`")
            return Ty.Unknown
        }
        let cwd = checkExpr(ck, args[1].value)
        ok = false
        match (cwd) {
            case Ty.String -> { ok = true }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.String -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            err(ck, args[1].value.span, "`run_cmd`'s `cwd` must be a `string` or `none`")
            return Ty.Unknown
        }
        let envs = checkExpr(ck, args[2].value)
        ok = false
        match (envs) {
            case Ty.Map(k, v) -> {
                var kk = false
                match (k) {
                    case Ty.String -> { kk = true }
                    case Ty.Unknown -> { kk = true }
                    case _ -> {}
                }
                var vv = false
                match (v) {
                    case Ty.String -> { vv = true }
                    case Ty.Unknown -> { vv = true }
                    case _ -> {}
                }
                if (kk && vv) {
                    ok = true
                }
            }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(_) -> { ok = true }
            case _ -> {}
        }
        if (!ok) {
            err(ck, args[2].value.span, "`run_cmd`'s `envs` must be a `Map<string, string>` or `none`")
            return Ty.Unknown
        }
        let rm = checkExpr(ck, args[3].value)
        ok = false
        match (rm) {
            case Ty.List(it) -> {
                match (it) {
                    case Ty.String -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.List(jt) -> {
                        match (jt) {
                            case Ty.String -> { ok = true }
                            case Ty.Unknown -> { ok = true }
                            case _ -> {}
                        }
                    }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            err(ck, args[3].value.span, "`run_cmd`'s `env_removes` must be a `List<string>` or `none`")
            return Ty.Unknown
        }
        let si = checkExpr(ck, args[4].value)
        ok = false
        match (si) {
            case Ty.List(it) -> {
                match (it) {
                    case Ty.Byte -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.List(jt) -> {
                        match (jt) {
                            case Ty.Byte -> { ok = true }
                            case Ty.Unknown -> { ok = true }
                            case _ -> {}
                        }
                    }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            err(ck, args[4].value.span, "`run_cmd`'s `stdin_bytes` must be a `List<byte>` or `none`")
            return Ty.Unknown
        }
        let mx = checkExpr(ck, args[5].value)
        ok = false
        match (mx) {
            case Ty.Int -> { ok = true }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.Int -> { ok = true }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            err(ck, args[5].value.span, "`run_cmd`'s `max_out` must be an `int` or `none`")
            return Ty.Unknown
        }
        let tm = checkExpr(ck, args[6].value)
        ok = false
        match (tm) {
            case Ty.Int -> { ok = true }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.Int -> { ok = true }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            err(ck, args[6].value.span, "`run_cmd`'s `timeout_ms` must be an `int` or `none`")
            return Ty.Unknown
        }
        let inh = checkExpr(ck, args[7].value)
        match (inh) {
            case Ty.Bool -> {}
            case Ty.Unknown -> {}
            case _ -> {
                err(ck, args[7].value.span, "`run_cmd`'s `inherit_io` must be a `bool`")
                return Ty.Unknown
            }
        }
        Ty.Option(Ty.Tuple([Ty.Option(Ty.Int), Ty.String, Ty.String, Ty.Bool]))
}

