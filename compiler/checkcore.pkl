module compiler.checkcore

import * from compiler.ast
import { Span, Diagnostic, DiagnosticSink } from compiler.diag
import * from compiler.ty
import { entryName } from compiler.resolvecore
import * from compiler.resolvebag
import * from compiler.checkbag
import { entryGenerics } from compiler.resolvebag

// ==== check core (free fns + Checker methods as free fns, receiver = ck) ====

fn containsStr(hay: string, needle: string) -> bool {
    let hb = bytes(hay)
    let nb = bytes(needle)
    if (len(nb) == 0) {
        return true
    }
    if (len(nb) > len(hb)) {
        return false
    }
    var i = 0
    while (i <= len(hb) - len(nb)) {
        var j = 0
        var ok = true
        while (j < len(nb)) {
            if (hb[i + j] != nb[j]) {
                ok = false
            }
            j = j + 1
        }
        if (ok) {
            return true
        }
        i = i + 1
    }
    false
}

fn joinStrs(ts: List<string>, sep: string) -> string {
    var out = ""
    var i = 0
    while (i < len(ts)) {
        if (i > 0) {
            out += sep
        }
        out += ts[i]
        i = i + 1
    }
    out
}

fn listHasStr(l: List<string>, s: string) -> bool {
    var i = 0
    while (i < len(l)) {
        if (l[i] == s) {
            return true
        }
        i = i + 1
    }
    false
}

fn listRemoveStr(l: List<string>, s: string) {
    var i = 0
    while (i < len(l)) {
        if (l[i] == s) {
            var j = i
            while (j + 1 < len(l)) {
                l[j] = l[j + 1]
                j = j + 1
            }
            l.pop()
            return
        }
        i = i + 1
    }
}

fn listHasTy(l: List<Ty>, t: Ty) -> bool {
    var i = 0
    while (i < len(l)) {
        if (l[i] == t) {
            return true
        }
        i = i + 1
    }
    false
}

fn absDiffInt(a: int, b: int) -> int {
    if (a >= b) {
        a - b
    } else {
        b - a
    }
}

fn isAbiSymbol(s: string) -> bool {
    if (s == "") {
        return false
    }
    var i = 0
    while (i < len(s)) {
        let c = s[i] as int
        let isDigit = c >= 48 && c <= 57
        let isUpper = c >= 65 && c <= 90
        let isLower = c >= 97 && c <= 122
        let isUnd = c == 95
        if (!(isDigit || isUpper || isLower || isUnd)) {
            return false
        }
        i = i + 1
    }
    let first = s[0] as int
    !(first >= 48 && first <= 57)
}

fn spanKey(s: Span) -> string {
    "{s.start}:{s.end}"
}

fn binOpName(op: BinOp) -> string {
    match (op) {
        case BinOp.Add -> "Add"
        case BinOp.Sub -> "Sub"
        case BinOp.Mul -> "Mul"
        case BinOp.Div -> "Div"
        case BinOp.Mod -> "Mod"
        case BinOp.Pow -> "Pow"
        case BinOp.Shl -> "Shl"
        case BinOp.Shr -> "Shr"
        case BinOp.BitAnd -> "BitAnd"
        case BinOp.BitOr -> "BitOr"
        case BinOp.BitXor -> "BitXor"
        case BinOp.Lt -> "Lt"
        case BinOp.Le -> "Le"
        case BinOp.Gt -> "Gt"
        case BinOp.Ge -> "Ge"
        case BinOp.Eq -> "Eq"
        case BinOp.Ne -> "Ne"
        case BinOp.And -> "And"
        case BinOp.Or -> "Or"
        case BinOp.Range -> "Range"
        case BinOp.RangeIncl -> "RangeIncl"
        case BinOp.NullCoalesce -> "NullCoalesce"
        case BinOp.Send -> "Send"
        case BinOp.Is -> "Is"
        case BinOp.In -> "In"
    }
}

fn unOpName(op: UnOp) -> string {
    match (op) {
        case UnOp.Neg -> "Neg"
        case UnOp.Not -> "Not"
        case UnOp.BitNot -> "BitNot"
        case UnOp.Deref -> "Deref"
        case UnOp.AddrOf -> "AddrOf"
    }
}

fn strPartsText(parts: List<StrPart>) -> string {
    var out = ""
    var isPlain = true
    for (p in parts) {
        match (p) {
            case StrPart.Text(t) -> {
                out += t
                false
            }
            case StrPart.Expr(_) -> {
                isPlain = false
                false
            }
        }
    }
    if (isPlain) {
        out
    } else {
        ""
    }
}

fn isNoneStr(s: string?) -> bool {
    match (s) {
        case none -> true
        case some(_) -> false
    }
}

fn isNoneExpr(e: Expr?) -> bool {
    match (e) {
        case none -> true
        case some(_) -> false
    }
}

fn classifyMessage(msg: string) -> string? {
    let table = [
        ["not lowered yet", "E0900"],
        ["after `free()`", "E0501"],
        ["after it was moved", "E0501"],
        ["was already freed", "E0502"],
        ["`free` is only available on a `#[manualAlloc]` binding", "E0503"],
        ["cannot store `#[manualAlloc]`", "E0504"],
        ["cannot assign `#[manualAlloc]`", "E0504"],
        ["cannot bind `#[manualAlloc]`", "E0504"],
        ["takes ownership of its argument", "E0504"],
        ["cannot overwrite `#[manualAlloc]` binding", "E0505"],
        ["cannot return `#[manualAlloc]` value", "E0505"],
        ["`#[manualAlloc]` takes no arguments", "E0401"],
        ["`#[manualAlloc]` attribute", "E0401"],
        ["is not supported on static fields", "E0401"],
        ["is not supported on constants", "E0401"],
        ["requires an allocation initializer", "E0401"],
        ["requires a class or struct type", "E0401"],
        ["requires a class or struct return type", "E0401"],
        ["must be a class or struct type", "E0401"],
        ["owned field `", "E0401"],
        ["unknown attribute `#[", "E0400"],
        ["`#[tag", "E0400"],
        ["attempt to call a non-function", "E0411"],
        ["unknown generic function `", "E0410"],
        [" argument(s), found ", "E0410"],
        ["missing argument", "E0410"],
        ["too many arguments in call", "E0410"],
        ["named argument `", "E0410"],
        ["cannot access member `", "E0420"],
        ["left side of `??` is not", "E0430"],
        ["`?.` on a non-option value", "E0430"],
        ["cannot unwrap non-option value", "E0430"],
        ["requires numeric or string operands", "E0430"],
        ["bitwise operators require", "E0430"],
        ["unary `", "E0430"],
        ["requires a numeric operand", "E0430"],
        ["requires a `bool` operand", "E0430"],
        ["requires an `int` operand", "E0430"],
        ["of a scalar requires a local variable", "E0430"],
        ["currently only supports class, struct, pointer", "E0430"],
        ["cannot dereference a value of type", "E0430"],
        ["`alloc(T, count)`", "E0440"],
        ["`alloc` element type", "E0440"],
        ["`alloc` count must be an `int`", "E0440"],
        ["`alloc` currently only supports scalar element types", "E0440"],
        ["`free(p)` takes one argument", "E0440"],
        ["`free` expects a pointer argument", "E0440"],
        ["`free()` takes no arguments", "E0440"],
        ["`view(obj)` takes one argument", "E0440"],
        ["`view` needs a managed value", "E0440"],
        ["may only be used inside an `unsafe` block", "E0520"],
        ["type mismatch in ", "E0308"],
        ["cannot return a value from a function with no return type", "E0310"],
        ["`if` branches have mismatched types", "E0310"],
        ["match arms produce inconsistent types", "E0310"],
        ["condition must be a `bool`", "E0340"],
        ["used outside of a loop", "E0320"],
        ["`for (x in ...)` requires a sequence", "E0341"],
        ["map keys must be `string` values", "E0342"],
        ["map keys must be `", "E0342"],
        ["index must be an `int`", "E0343"],
        ["map index must be a `string`", "E0343"],
        ["map index must be a `", "E0343"],
        ["string index must be an `int`", "E0343"],
        ["pointer index must be an `int`", "E0343"],
        ["cannot index a value of type", "E0343"],
        ["index assignment target must be a List", "E0343"],
        ["indexing a pointer to a", "E0343"],
        ["storing through a pointer to a", "E0343"],
        ["use of undeclared name `", "E0351"],
        ["cannot assign to undeclared name `", "E0351"],
        ["no member `", "E0352"],
        ["no assignable member `", "E0352"],
        ["has no variant", "E0353"],
        ["payload field(s); use `", "E0353"],
        ["enum variant pattern requires a value of enum type", "E0353"],
        ["cannot be constructed directly", "E0354"],
        ["cannot assign to a member of a non-class value", "E0355"],
        ["declares `implements", "E0360"],
        ["`this` used outside of a class body", "E0361"],
        ["`super` used outside of a class body", "E0361"],
        ["no parent to call `super`", "E0361"],
        ["can only be used as a named constructor's delegation", "E0361"],
        ["may only delegate to `this(...)`", "E0361"],
        ["cannot assign to immutable", "E0362"],
        ["must be assigned on an instance", "E0362"],
        ["must be assigned on the type", "E0362"],
        ["has no setter", "E0362"],
        ["assignment target must be a variable, member, or index", "E0362"],
        ["cannot write through an immutable reference", "E0362"],
        ["cannot write to a field", "E0362"],
        ["can never succeed", "E0363"],
        ["cannot cast `", "E0363"],
        ["references are supported only as function parameter types", "E0700"],
    ]
    for (row in table) {
        if (containsStr(msg, row[0])) {
            return row[1]
        }
    }
    none
}

fn emptyMapStrMoved() -> Map<string, MovedBits> {
    let m = {"::seed::": MovedBits(false, false)}
    m.remove("::seed::")
    m
}

fn emptyLocalList() -> List<Local> {
    var l = [Local(Ty.Int, false, false, false, false)]
    l.pop()
    l
}

fn emptyMovedList() -> List<Map<string, MovedBits>> {
    var l = [emptyMapStrMoved()]
    l.pop()
    l
}

fn copySpanList(l: List<Span>) -> List<Span> {
    var out = emptySpanList()
    for (s in l) {
        out.push(s)
    }
    out
}

fn copyStrList(l: List<string>) -> List<string> {
    var out = emptyStrList()
    for (s in l) {
        out.push(s)
    }
    out
}

fn spanEq(a: Span, b: Span) -> bool {
    a.start == b.start && a.end == b.end
}

fn hasSpan(l: List<Span>, s: Span) -> bool {
    for (x in l) {
        if (spanEq(x, s)) {
            return true
        }
    }
    false
}

fn removeSpan(l: List<Span>, s: Span) -> bool {
    var i = 0
    while (i < len(l)) {
        if (spanEq(l[i], s)) {
            l.remove(i)
            return true
        }
        i = i + 1
    }
    false
}

fn emptyTyList() -> List<Ty> {
    var l = [Ty.Int]
    l.pop()
    l
}

fn tyVars(names: List<string>) -> List<Ty> {
    var out = emptyTyList()
    for (n in names) {
        out.push(Ty.Var(n))
    }
    out
}

fn isClassOrStruct(t: Ty) -> bool {
    match (t) {
        case Ty.Class(_, _) -> true
        case Ty.Struct(_, _) -> true
        case _ -> false
    }
}

fn isThisCall(e: Expr) -> bool {
    match (e.kind) {
        case ExprKind.Call(callee, _) -> match (callee.kind) {
            case ExprKind.This -> true
            case _ -> false
        }
        case _ -> false
    }
}

fn namedCtorDelegation(body: Block) -> Expr? {
    if (len(body.stmts) == 0) {
        if (let some(t) = body.expr) {
            if (isThisCall(t)) {
                t
            } else {
                none
            }
        } else {
            none
        }
    } else if (len(body.stmts) == 1) {
        if (let none = body.expr) {
            let s = body.stmts[0]
            match (s) {
                case Stmt.Expr(e) -> {
                    if (isThisCall(e)) {
                        e
                    } else {
                        none
                    }
                }
                case _ -> none
            }
        } else {
            none
        }
    } else {
        none
    }
}

fn isListSortable(t: Ty) -> bool {
    match (t) {
        case Ty.Int -> true
        case Ty.Float -> true
        case Ty.Byte -> true
        case Ty.Char -> true
        case Ty.Bool -> true
        case Ty.String -> true
        case _ -> false
    }
}

fn checkProgram(prog: Program, resolved: ResolvedProgram, diags: DiagnosticSink) {
    let ck = Checker(prog, resolved, diags)
    check(ck)
}

fn collectExprTypes(prog: Program, resolved: ResolvedProgram, diags: DiagnosticSink) -> Map<string, Ty> {
    let ck = Checker(prog, resolved, diags)
    check(ck)
    ck.types
}

fn mergeFlowTypes(a: Ty, b: Ty) -> Ty? {
    if (tyEq(a, b)) {
        return a
    }
    match (a) {
        case Ty.None -> {
            match (b) {
                case Ty.None -> { return Ty.None }
                case _ -> { return optOf(b) }
            }
        }
        case _ -> {}
    }
    match (b) {
        case Ty.None -> { return optOf(a) }
        case _ -> {}
    }
    match (a) {
        case Ty.Option(ia) -> {
            if (tyEq(ia, b)) {
                return a
            }
        }
        case _ -> {}
    }
    match (b) {
        case Ty.Option(ib) -> {
            if (tyEq(ib, a)) {
                return b
            }
        }
        case _ -> {}
    }
    if (a == Ty.Unknown || b == Ty.Unknown) {
        return Ty.Unknown
    }
    none
}

fn patternIntroducesBinding(p: Pattern) -> bool {
    match (p) {
        case Pattern.Binding(_, _) -> true
        case Pattern.Wildcard -> false
        case Pattern.Literal(_) -> false
        case Pattern.Variant(_path, payloads) -> {
            var any = false
            for (pl in payloads) {
                if (patternIntroducesBinding(pl)) {
                    any = true
                }
            }
            any
        }
        case Pattern.Tuple(parts) -> {
            var any = false
            for (pt in parts) {
                if (patternIntroducesBinding(pt)) {
                    any = true
                }
            }
            any
        }
        case Pattern.Or(alts) -> {
            var any = false
            for (at in alts) {
                if (patternIntroducesBinding(at)) {
                    any = true
                }
            }
            any
        }
    }
}

fn check(ck: Checker) {
        for (item in ck.prog.items) {
            let isFn = match (item.kind) {
                case ItemKind.Fn(_) -> true
                case ItemKind.Test(_) -> true
                case _ -> false
            }
            let isTest = match (item.kind) {
                case ItemKind.Test(_) -> true
                case _ -> false
            }
            for (a in item.attrs) {
                if (a.name == "manualAlloc" && isFn) {
                    if (len(a.args) > 0) {
                        err(ck, a.span, "`#[manualAlloc]` takes no arguments")
                    }
                } else if (a.name == "symbol" && isFn) {
                    if (!(len(a.args) == 1)) {
                        err(ck, a.span, "`#[symbol(...)]` takes exactly one string literal")
                    } else {
                        match (a.args[0].kind) {
                            case ExprKind.Lit(lit) -> {
                                match (lit) {
                                    case Lit.String(parts) -> {
                                        let text = strPartsText(parts)
                                        if (text == "") {
                                            err(ck, a.args[0].span, "`#[symbol(...)]` requires a non-empty string literal")
                                        } else if (!isAbiSymbol(text)) {
                                            err(ck, a.args[0].span, "`#[symbol(...)]` must be a C identifier (letters, digits, underscore; not starting with a digit)")
                                        }
                                    }
                                    case _ -> {
                                        err(ck, a.args[0].span, "`#[symbol(...)]` requires a non-empty string literal")
                                    }
                                }
                            }
                            case _ -> {
                                err(ck, a.args[0].span, "`#[symbol(...)]` requires a non-empty string literal")
                            }
                        }
                    }
                } else if (a.name == "symbol") {
                    err(ck, a.span, "`#[symbol(...)]` is only allowed on functions")
                } else if (a.name == "tag" && isTest) {
                    if (len(a.args) == 0) {
                        err(ck, a.span, "`#[tag(...)]` needs at least one tag")
                    }
                    for (arg in a.args) {
                        match (arg.kind) {
                            case ExprKind.Lit(lit) -> {
                                match (lit) {
                                    case Lit.String(parts) -> {
                                        let text = strPartsText(parts)
                                        if (text == "") {
                                            err(ck, arg.span, "`#[tag(...)]` arguments must be non-empty string literals")
                                        }
                                    }
                                    case _ -> {
                                        err(ck, arg.span, "`#[tag(...)]` arguments must be string literals")
                                    }
                                }
                            }
                            case _ -> {
                                err(ck, arg.span, "`#[tag(...)]` arguments must be string literals")
                            }
                        }
                    }
                } else if (a.name == "tag") {
                    err(ck, a.span, "`#[tag(...)]` is only allowed on test items")
                } else {
                    err(ck, a.span, "attributes on declarations are not lowered yet (`#[{a.name}]`)")
                }
            }
            match (item.kind) {
                case ItemKind.Fn(f) -> checkFnSignatureBodies(ck, f, item.attrs)
                case ItemKind.Test(f) -> checkFnSignatureBodies(ck, f, item.attrs)
                case ItemKind.Const(c) -> {
                    var ty = Ty.Unknown
                    var i = 0
                    while (i < len(ck.resolved.consts)) {
                        if (ck.resolved.consts[i].name == c.name) {
                            ty = ck.resolved.consts[i].ty
                        }
                        i = i + 1
                    }
                    let got = checkExpr(ck, c.value)
                    guardRefUse(ck, ty, c.span, "a `const` binding")
                    checkAssignable(ck, ty, got, c.span, "const initializer")
                }
                case ItemKind.Class(c) -> checkClassBodies(ck, c)
                case ItemKind.Struct(s) -> checkStructBodies(ck, s)
                case ItemKind.Enum(_) -> {}
                case ItemKind.Interface(_) -> {}
                case ItemKind.Global(g) -> {
                    var ty = Ty.Unknown
                    var i = 0
                    while (i < len(ck.resolved.globals)) {
                        if (ck.resolved.globals[i].name == g.name) {
                            ty = ck.resolved.globals[i].ty
                        }
                        i = i + 1
                    }
                    let got = checkExpr(ck, g.value)
                    guardRefUse(ck, ty, g.span, "a `var` binding")
                    checkAssignable(ck, ty, got, g.span, "global initializer")
                }
            }
        }
        checkInterfaceConformance(ck)
}

fn pushScope(ck: Checker) {
        ck.scopes.push(emptyMapLocal())
}

fn popScope(ck: Checker) {
        ck.scopes.pop()
}

fn declare(ck: Checker, name: string, ty: Ty, mutable: bool) {
        ck.scopes[len(ck.scopes) - 1][name] = Local(ty, mutable, false, false, false)
}

fn checkLetAttributes(ck: Checker, attrs: List<Attribute>) -> bool {
        var manual = false
        for (a in attrs) {
            if (a.name == "manualAlloc") {
                if (len(a.args) > 0) {
                    err(ck, a.span, "`#[manualAlloc]` takes no arguments")
                }
                if (manual) {
                    err(ck, a.span, "duplicate `#[manualAlloc]` attribute")
                }
                manual = true
            } else {
                err(ck, a.span, "unknown attribute `#[{a.name}]`")
            }
        }
        manual
}

fn markManual(ck: Checker, name: string) {
        var i = len(ck.scopes) - 1
        while (i >= 0) {
            if (let some(l) = ck.scopes[i].get(name)) {
                l.manual = true
                return
            }
            i = i - 1
        }
}

fn isManual(ck: Checker, name: string) -> bool {
        if (let some(l) = lookup(ck, name)) {
            l.manual
        } else {
            false
        }
}

fn isFreed(ck: Checker, name: string) -> bool {
        if (let some(l) = lookup(ck, name)) {
            l.freed
        } else {
            false
        }
}

fn markMoved(ck: Checker, name: string) {
        var i = len(ck.scopes) - 1
        while (i >= 0) {
            if (let some(l) = ck.scopes[i].get(name)) {
                l.moved = true
                return
            }
            i = i - 1
        }
}

fn manualMoveSource(ck: Checker, e: Expr) -> string? {
        match (e.kind) {
            case ExprKind.Ident(name) -> {
                if (let some(l) = lookup(ck, name)) {
                    if (l.manual && !l.moved && !l.freed) {
                        name
                    } else {
                        none
                    }
                } else {
                    none
                }
            }
            case _ -> none
        }
}

fn consumeOwned(ck: Checker, e: Expr) {
        removeSpan(ck.pendingOwnedCalls, e.span)
}

fn isFreshAllocation(ck: Checker, e: Expr) -> bool {
        if (hasSpan(ck.pendingOwnedCalls, e.span)) {
            return true
        }
        match (e.kind) {
            case ExprKind.Call(callee, _) -> match (callee.kind) {
                case ExprKind.Ident(name) -> {
                    if (ck.resolved.types.has(name)) {
                        if (let some(t) = ck.types.get(spanKey(e.span))) {
                            match (t) {
                                case Ty.Class(_, _) -> true
                                case Ty.Struct(_, _) -> true
                                case _ -> false
                            }
                        } else {
                            false
                        }
                    } else {
                        false
                    }
                }
                case _ -> false
            }
            case _ -> false
        }
}

fn checkManualArgs(ck: Checker, flags: List<bool>, args: List<CallArg>) {
        var i = 0
        while (i < len(args)) {
            if (i >= len(flags) || !flags[i]) {
                i = i + 1
                continue
            }
            let a = args[i]
            if (let some(name) = manualMoveSource(ck, a.value)) {
                markMoved(ck, name)
            } else if (isFreshAllocation(ck, a.value)) {
                consumeOwned(ck, a.value)
            } else {
                errNote(ck, 
                    a.span,
                    "parameter #{(i + 1)} is `#[manualAlloc]` and takes ownership of its argument",
                    "pass a `#[manualAlloc]` binding or a fresh allocation",
                )
            }
            i = i + 1
        }
}

fn captureMoved(ck: Checker) -> List<Map<string, MovedBits>> {
        var out = emptyMovedList()
        for (s in ck.scopes) {
            var snap = emptyMapStrMoved()
            for (k in s.keys()) {
                snap[k] = MovedBits(s[k].moved, s[k].freed)
            }
            out.push(snap)
        }
        out
}

fn setMoved(ck: Checker, state: List<Map<string, MovedBits>>) {
        var i = 0
        while (i < len(ck.scopes) && i < len(state)) {
            let scope = ck.scopes[i]
            for (k in scope.keys()) {
                if (let some(bits) = state[i].get(k)) {
                    scope[k].moved = bits.moved
                    scope[k].freed = bits.freed
                }
            }
            i = i + 1
        }
}

fn unionMoved(ck: Checker, a: List<Map<string, MovedBits>>, b: List<Map<string, MovedBits>>) {
        var i = 0
        while (i < len(a) && i < len(b)) {
            let sa = a[i]
            let sb = b[i]
            for (k in sb.keys()) {
                let bm = sb[k]
                if (let some(am) = sa.get(k)) {
                    let nm = MovedBits(am.moved || bm.moved, am.freed || bm.freed)
                    sa[k] = nm
                } else {
                    sa[k] = MovedBits(bm.moved, bm.freed)
                }
            }
            i = i + 1
        }
}

fn markFreed(ck: Checker, name: string) {
        var i = len(ck.scopes) - 1
        while (i >= 0) {
            if (let some(l) = ck.scopes[i].get(name)) {
                l.freed = true
                return
            }
            i = i - 1
        }
}

fn lookup(ck: Checker, name: string) -> Local? {
        var i = len(ck.scopes) - 1
        while (i >= 0) {
            if (let some(l) = ck.scopes[i].get(name)) {
                return l
            }
            i = i - 1
        }
        none
}

fn err(ck: Checker, span: Span, msg: string) {
        if (let some(code) = classifyMessage(msg)) {
            ck.diags.emit(Diagnostic.errorAt(span, msg).withCode(code))
        } else {
            ck.diags.emit(Diagnostic.errorAt(span, msg))
        }
}

fn errNote(ck: Checker, span: Span, msg: string, note: string) {
        if (let some(code) = classifyMessage(msg)) {
            ck.diags.emit(Diagnostic.errorAt(span, msg).withCode(code).note(note))
        } else {
            ck.diags.emit(Diagnostic.errorAt(span, msg).note(note))
        }
}

fn okTypes(ck: Checker, want: Ty, got: Ty) -> bool {
        if (got == Ty.Unknown || want == Ty.Unknown) {
            return true
        }
        match (want) {
            case Ty.Var(_) -> { return true }
            case _ -> {}
        }
        if (tyEq(got, want)) {
            return true
        }
        // `&T` reference parameters accept the bare value `T` by implicit
        // borrow; a raw `*T` argument is NOT accepted.
        match (want) {
            case Ty.Ref(inner) -> {
                if (okTypes(ck, inner, got)) {
                    return true
                }
            }
            case _ -> {}
        }
        // none -> T?
        if (isNone(got) && isOption(want)) {
            return true
        }
        if (isOption(want)) {
            if (isOption(got)) {
                let wi = innerOption(want)
                let gi = innerOption(got)
                if (let some(w) = wi) {
                    if (let some(g) = gi) {
                        return okTypes(ck, w, g)
                    }
                }
            }
            if (let some(w) = innerOption(want)) {
                return okTypes(ck, w, got)
            }
        }
        // A `Map` widens when its key or value types widen through the same
        // option rules (e.g. a `Map<int, V>` literal satisfies a
        // `Map<int?, V>` binding). Container covariance is otherwise rejected.
        match (want) {
            case Ty.Map(kw, vw) -> match (got) {
                case Ty.Map(kg, vg) -> {
                    var keyOpt = isOption(kw) || isOption(kg)
                    var valOpt = isOption(vw) || isOption(vg)
                    if ((keyOpt || valOpt) && okTypes(ck, kw, kg) && okTypes(ck, vw, vg)) {
                        return true
                    }
                }
                case _ -> {}
            }
            case _ -> {}
        }
        // class implements interface?
        if (let some(gotn) = named(got)) {
            if (let some(wantn) = named(want)) {
                if (gotn != wantn) {
                    if (implementsInterface(ck, gotn, wantn)) {
                        return true
                    }
                    if (conformsTo(ck, got, want)) {
                        return true
                    }
                }
                // A subclass/descendant `got` is assignable to an ancestor.
                match (want) {
                    case Ty.Class(_, _) -> {
                        if (isAncestor(ck, wantn, gotn)) {
                            return true
                        }
                    }
                    case Ty.Struct(_, _) -> {
                        if (isAncestor(ck, wantn, gotn)) {
                            return true
                        }
                    }
                    case _ -> {}
                }
            }
        }
        // Function types: parameters are contravariant, result covariant.
        match (got) {
            case Ty.Fn(gp, gr) -> match (want) {
                case Ty.Fn(wp, wr) -> {
                    if (len(gp) != len(wp)) {
                        return false
                    }
                    var i = 0
                    while (i < len(gp)) {
                        if (gp[i] == Ty.Unknown || wp[i] == Ty.Unknown) {
                            i = i + 1
                            continue
                        }
                        // contravariance: callee params may accept a wider type
                        if (!okTypes(ck, gp[i], wp[i])) {
                            return false
                        }
                        i = i + 1
                    }
                    if (gr == Ty.Unknown || wr == Ty.Unknown) {
                        return true
                    }
                    return okTypes(ck, gr, wr)
                }
                case _ -> {}
            }
            case _ -> {}
        }
        false
}

fn checkAssignable(ck: Checker, want: Ty, got: Ty, span: Span, what: string) {
        if (!okTypes(ck, want, got)) {
            errNote(ck, 
                span,
                "type mismatch in {what}: expected `{bareName(want)}`, found `{bareName(got)}`",
                "`{bareName(got)}` does not satisfy `{bareName(want)}`; use `as` for an explicit conversion",
            )
        }
}

fn checkAssignRhs(ck: Checker, want: Ty, got: Ty, value: Expr, span: Span, what: string) {
        if (want == Ty.Byte) {
            match (value.kind) {
                case ExprKind.Lit(lit) -> {
                    let fitsByte = match (lit) {
                        case Lit.Int(v) -> v >= 0 && v <= 255
                        case Lit.Char(c) -> (c as int) <= 0x7F
                        case _ -> false
                    }
                    if (fitsByte) {
                        return
                    }
                }
                case _ -> {}
            }
        }
        checkAssignable(ck, want, got, span, what)
}

fn guardRefUse(ck: Checker, ty: Ty, span: Span, whereStr: string) {
        match (ty) {
            case Ty.Ref(_) -> {
                err(ck, span, "`&T` references are supported only as function parameter types ({whereStr})")
            }
            case _ -> {}
        }
}

fn classTable(ck: Checker, name: string) -> ClassTable? {
        if (let some(e) = ck.resolved.types.get(name)) {
            match (e) {
                case TypeTableEntry.Class(t) -> t
                case TypeTableEntry.Struct(t) -> t
                case _ -> none
            }
        } else {
            none
        }
}

fn substTy(ck: Checker, ty: Ty, args: Map<string, Ty>) -> Ty {
        subst(ty, args)
}

fn typeKey(ck: Checker, ty: Ty) -> TypeKey? {
        match (ty) {
            case Ty.Class(n, a) -> typeKeyNamed(ck, n, a)
            case Ty.Struct(n, a) -> typeKeyNamed(ck, n, a)
            case Ty.Enum(n, a) -> typeKeyNamed(ck, n, a)
            case Ty.Interface(n, _) -> TypeKey(n, emptyMapStrTy())
            case _ -> none
        }
}

fn typeKeyNamed(ck: Checker, n: string, a: List<Ty>) -> TypeKey {
        var params = emptyStrList()
        if (let some(e) = ck.resolved.types.get(n)) {
            params = entryGenerics(e)
        }
        var map = emptyMapStrTy()
        var i = 0
        while (i < len(params)) {
            if (i < len(a)) {
                map[params[i]] = a[i]
            } else {
                map[params[i]] = Ty.Unknown
            }
            i = i + 1
        }
        TypeKey(n, map)
}

fn implementsInterface(ck: Checker, cls: string, iface: string) -> bool {
        var pending = [cls]
        var seen = emptyStrList()
        while (len(pending) > 0) {
            let name = pending[len(pending) - 1]
            pending.pop()
            if (listHasStr(seen, name)) {
                continue
            }
            seen.push(name)
            let table = classTable(ck, name)
            if (let none = table) {
                continue
            }
            if (let some(t) = table) {
                var foundIface = false
                for (i in t.implements) {
                    if (let some(nm) = named(i)) {
                        if (nm == iface) {
                            foundIface = true
                        }
                    }
                }
                if (foundIface) {
                    return true
                }
                if (let some(p) = t.extends) {
                    if (let some(nm) = named(p)) {
                        pending.push(nm)
                    }
                }
            }
        }
        false
}

fn iterableElem(ck: Checker, ty: Ty) -> Ty? {
        match (ty) {
            case Ty.Interface(n, args) -> {
                if (n == "Iterable") {
                    if (len(args) > 0) {
                        return args[0]
                    } else {
                        return Ty.Unknown
                    }
                } else {
                    return none
                }
            }
            case _ -> {}
        }
        if (let none = typeKey(ck, ty)) {
            return none
        }
        match (typeKey(ck, ty)) {
            case some(tk) -> {
                var chain = [tk.name]
                var seen = emptyStrList()
                while (len(chain) > 0) {
                    let cname = chain[len(chain) - 1]
                    chain.pop()
                    if (listHasStr(seen, cname)) {
                        continue
                    }
                    seen.push(cname)
                    match (classTable(ck, cname)) {
                        case some(t) -> {
                            for (i in t.implements) {
                                match (i) {
                                    case Ty.Interface(iname, iargs) -> {
                                        if (iname == "Iterable") {
                                            var el = Ty.Unknown
                                            if (len(iargs) > 0) {
                                                el = iargs[0]
                                            }
                                            return substTy(ck, el, tk.args)
                                        }
                                    }
                                    case _ -> {}
                                }
                            }
                            if (let some(p) = t.extends) {
                                if (let some(nm) = named(p)) {
                                    chain.push(nm)
                                }
                            }
                        }
                        case none -> {}
                    }
                }
            }
            case none -> {}
        }
        none
}

fn isAncestor(ck: Checker, anc: string, desc: string) -> bool {
        var pending = [desc]
        var seen = emptyStrList()
        while (len(pending) > 0) {
            let name = pending[len(pending) - 1]
            pending.pop()
            if (name == anc) {
                return true
            }
            if (listHasStr(seen, name)) {
                continue
            }
            seen.push(name)
            if (let some(t) = classTable(ck, name)) {
                if (let some(p) = t.extends) {
                    if (let some(nm) = named(p)) {
                        pending.push(nm)
                    }
                }
            }
        }
        false
}

fn conformsTo(ck: Checker, got: Ty, want: Ty) -> bool {
        match (named(got)) {
            case some(gotn) -> {
                match (named(want)) {
                    case some(wantn) -> {
                        if (wantn == gotn) {
                            return true
                        }
                        let isIface = match (want) {
                            case Ty.Interface(_, _) -> true
                            case _ -> false
                        }
                        if (!isIface) {
                            return false
                        }
                        implementsInterface(ck, gotn, wantn)
                    }
                    case none -> false
                }
            }
            case none -> false
        }
}

fn findField(ck: Checker, cls: string, name: string, args: Map<string, Ty>) -> FieldInfo? {
        var chain = [cls]
        var seen = emptyStrList()
        while (len(chain) > 0) {
            let cname = chain[len(chain) - 1]
            chain.pop()
            if (listHasStr(seen, cname)) {
                continue
            }
            seen.push(cname)
            match (classTable(ck, cname)) {
                case some(t) -> {
                    for (f in t.fields) {
                        if (f.name == name) {
                            return f
                        }
                    }
                    for (f in t.consts) {
                        if (f.name == name) {
                            return f
                        }
                    }
                    if (let some(p) = t.extends) {
                        if (let some(nm) = named(p)) {
                            chain.push(nm)
                        }
                    }
                }
                case none -> {}
            }
        }
        let _ = args
        none
}

fn findMethod(ck: Checker, cls: string, name: string) -> CallableInfo? {
        var chain = [cls]
        var seen = emptyStrList()
        while (len(chain) > 0) {
            let cname = chain[len(chain) - 1]
            chain.pop()
            if (listHasStr(seen, cname)) {
                continue
            }
            seen.push(cname)
            match (classTable(ck, cname)) {
                case some(t) -> {
                    for (m in t.methods) {
                        if (m.name == name) {
                            return m
                        }
                    }
                    if (let some(p) = t.extends) {
                        if (let some(nm) = named(p)) {
                            chain.push(nm)
                        }
                    }
                }
                case none -> {}
            }
        }
        none
}

fn findProperty(ck: Checker, cls: string, name: string) -> PropertyInfo? {
        if (let some(t) = classTable(ck, cls)) {
            for (p in t.properties) {
                if (p.name == name) {
                    return p
                }
            }
        }
        none
}

fn findNamedCtor(ck: Checker, cls: string, name: string) -> CtorInfo? {
        if (let some(t) = classTable(ck, cls)) {
            for (nc in t.namedCtors) {
                if (nc.name == name) {
                    return nc.ctor
                }
            }
        }
        none
}

fn initializedFields(ck: Checker, name: string) -> List<string> {
        var members: List<ClassMember>? = none
        for (item in ck.prog.items) {
            match (item.kind) {
                case ItemKind.Class(c) -> {
                    if (c.name == name) {
                        members = c.members
                    }
                }
                case ItemKind.Struct(s) -> {
                    if (s.name == name) {
                        members = s.members
                    }
                }
                case _ -> {}
            }
        }
        var out = emptyStrList()
        if (let some(ms) = members) {
            for (m in ms) {
                match (m) {
                    case ClassMember.Field(name, _, init, _, isStatic, _, _, _) -> {
                        if (let some(_) = init) {
                            if (!isStatic) {
                                out.push(name)
                            }
                        }
                    }
                    case _ -> {}
                }
            }
        }
        out
}

fn primaryCtorParamTys(ck: Checker, table: ClassTable) -> List<Ty> {
        if (let some(c) = table.ctor) {
            var out = emptyTys()
            for (p in c.params) {
                out.push(p.ty)
            }
            out
        } else {
            synthesizedCtorParamTys(ck, table.name)
        }
}

fn nearestExplicitPrimaryFieldCount(ck: Checker, name: string) -> FieldCount? {
        var chain = [name]
        var cur = name
        var done = false
        while (len(chain) < 64 && !done) {
            let t = classTable(ck, cur)
            let parent = none
            if (let some(tb) = t) {
                if (let some(e) = tb.extends) {
                    if (let some(nm) = named(e)) {
                        chain.push(nm)
                        cur = nm
                        continue
                    }
                }
            }
            let _ = parent
            done = true
        }
        var rev = emptyStrList()
        var c = len(chain) - 1
        while (c >= 0) {
            rev.push(chain[c])
            c = c - 1
        }
        var found: FieldCount? = none
        var count = 0
        for (cname in rev) {
            let t = classTable(ck, cname)
            var own = 0
            if (let some(tb) = t) {
                for (f in tb.fields) {
                    if (!f.isStatic) {
                        own = own + 1
                    }
                }
            }
            if (let some(tb) = t) {
                if (let some(_) = tb.ctor) {
                    found = FieldCount(cname, count + own)
                }
            }
            count = count + own
        }
        found
}

fn synthesizedCtorParamTys(ck: Checker, name: string) -> List<Ty> {
        var out = emptyTys()
        var cut = 0
        if (let some(fc) = nearestExplicitPrimaryFieldCount(ck, name)) {
            if (let some(t) = classTable(ck, fc.name)) {
                if (let some(c) = t.ctor) {
                    for (p in c.params) {
                        out.push(p.ty)
                    }
                }
            }
            cut = fc.count
        }
        var chain = [name]
        var cur = name
        while (len(chain) < 64) {
            if (let some(t) = classTable(ck, cur)) {
                if (let some(e) = t.extends) {
                    if (let some(nm) = named(e)) {
                        chain.push(nm)
                        cur = nm
                        continue
                    }
                }
            }
            break
        }
        var rev = emptyStrList()
        var c = len(chain) - 1
        while (c >= 0) {
            rev.push(chain[c])
            c = c - 1
        }
        var count = 0
        for (cname in rev) {
            if (let some(t) = classTable(ck, cname)) {
                var own = 0
                for (f in t.fields) {
                    if (!f.isStatic) {
                        own = own + 1
                    }
                }
                if (count >= cut) {
                    let initialized = initializedFields(ck, cname)
                    for (f in t.fields) {
                        if (!f.isStatic && !listHasStr(initialized, f.name)) {
                            out.push(f.ty)
                        }
                    }
                }
                count = count + own
            }
        }
        out
}

fn checkNamedCtorBody(ck: Checker, cd: ConstructorDecl, table: ClassTable) {
        match (namedCtorDelegation(cd.body)) {
            case none -> {
                err(ck, cd.span, "named constructor body must be a single `this(...)` delegation to the primary constructor")
            }
            case some(call) -> {
                let params = primaryCtorParamTys(ck, table)
                ck.namedCtorParams = params
                ck.namedCtorDelegated = false
                let _ = checkExpr(ck, call)
                ck.namedCtorParams = none
                ck.namedCtorDelegated = false
            }
        }
}

fn checkParamAttributes(ck: Checker, p: Param) -> bool {
        var manual = false
        for (a in p.attrs) {
            if (a.name == "manualAlloc") {
                if (len(a.args) > 0) {
                    err(ck, a.span, "`#[manualAlloc]` takes no arguments")
                }
                if (manual) {
                    err(ck, a.span, "duplicate `#[manualAlloc]` attribute")
                }
                manual = true
            } else {
                err(ck, a.span, "unknown attribute `#[{a.name}]`")
            }
        }
        manual
}

fn checkFieldAttributes(ck: Checker, attrs: List<Attribute>, ty: Ty?, isStatic: bool, isConst: bool, span: Span) -> bool {
        var manual = false
        for (a in attrs) {
            if (a.name == "manualAlloc") {
                if (len(a.args) > 0) {
                    err(ck, a.span, "`#[manualAlloc]` takes no arguments")
                }
                if (manual) {
                    err(ck, a.span, "duplicate `#[manualAlloc]` attribute")
                }
                manual = true
            } else {
                err(ck, a.span, "unknown attribute `#[{a.name}]`")
            }
        }
        if (manual) {
            if (isStatic) {
                err(ck, span, "`#[manualAlloc]` is not supported on static fields")
            }
            if (isConst) {
                err(ck, span, "`#[manualAlloc]` is not supported on constants")
            }
            if (let some(t) = ty) {
                if (!isClassOrStruct(t)) {
                    errNote(ck, 
                        span,
                        "`#[manualAlloc]` field must be a class or struct type, found `{bareName(t)}`",
                        "ownership applies to class/struct instances",
                    )
                }
            }
        }
        manual
}

fn consumeIntoOwned(ck: Checker, value: Expr, span: Span, what: string) {
        if (let some(src) = manualMoveSource(ck, value)) {
            markMoved(ck, src)
        } else if (isFreshAllocation(ck, value)) {
            consumeOwned(ck, value)
        } else {
            errNote(ck, 
                span,
                "{what} takes ownership of its value",
                "assign a `#[manualAlloc]` binding or a fresh allocation",
            )
        }
}

fn resolvedFnTy(ck: Checker, te: TypeExpr, generics: List<string>) -> Ty {
        // Resolve against the final module tables, so user-defined types and
        // this module's generics are visible.
        var g = copyStrList(generics)
        if (let some(sty) = ck.selfTy) {
            if (let some(gt) = typeKey(ck, sty)) {
                for (k in gt.args.keys()) {
                    if (!listHasStr(g, k)) {
                        g.push(k)
                    }
                }
            }
        }
        ck.resolved.resolveTy(te, instantiatedGenerics(ck, g), ck.diags)
}

fn instantiatedGenerics(ck: Checker, generics: List<string>) -> List<string> {
        generics
}

fn resolveParamTy(ck: Checker, p: Param) -> Ty {
        if (let some(te) = p.ty) {
            var generics = copyStrList(ck.fnGenerics)
            if (let some(sty) = ck.selfTy) {
                if (let some(gt) = typeKey(ck, sty)) {
                    for (k in gt.args.keys()) {
                        generics.push(k)
                    }
                }
            }
            resolvedFnTy(ck, te, generics)
        } else {
            Ty.Unknown
        }
}

fn checkFnSignatureBodies(ck: Checker, f: FnDecl, attrs: List<Attribute>) {
        pushScope(ck)
        ck.fnGenerics = emptyStrList()
        for (g in f.generics) {
            ck.fnGenerics.push(g.name)
        }
        ck.retTy = Ty.Empty
        if (let some(fns) = ck.resolved.fns.get(f.name)) {
            if (len(fns) > 0) {
                ck.retTy = fns[0].ret
            }
        }
        guardRefUse(ck, ck.retTy, f.span, "a return type")
        ck.retManual = false
        for (a in attrs) {
            if (a.name == "manualAlloc") {
                ck.retManual = true
            }
        }
        if (ck.retManual && !isClassOrStruct(ck.retTy)) {
            errNote(ck, 
                f.span,
                "`#[manualAlloc]` on a function requires a class or struct return type",
                "the caller receives ownership of the returned instance",
            )
        }
        for (p in f.params) {
            let manual = checkParamAttributes(ck, p)
            let ty = resolveParamTy(ck, p)
            declare(ck, p.name, ty, true)
            if (manual) {
                if (!isClassOrStruct(ty)) {
                    errNote(ck, 
                        p.span,
                        "`#[manualAlloc]` parameter `{p.name}` must be a class or struct type",
                        "ownership applies to class/struct instances",
                    )
                }
                markManual(ck, p.name)
            }
            if (let some(d) = p.default) {
                let dt = checkExpr(ck, d)
                checkAssignable(ck, resolveParamTy(ck, p), dt, p.span, "default argument")
            }
        }
        if (let some(body) = f.body) {
            checkFnBody(ck, body)
        }
        ck.retTy = Ty.Empty
        ck.retManual = false
        ck.fnGenerics = emptyStrList()
        popScope(ck)
}

fn checkFnBody(ck: Checker, body: FnBody) {
        match (body) {
            case FnBody.Block(b) -> {
                let exprTy = checkBlock(ck, b)
                checkReturnExpr(ck, exprTy, b.span)
                if (let some(e) = b.expr) {
                    checkOwnedTail(ck, e)
                }
            }
            case FnBody.Expr(e) -> {
                let t = checkExpr(ck, e)
                checkReturnExpr(ck, t, e.span)
                checkOwnedTail(ck, e)
            }
        }
}

fn checkOwnedTail(ck: Checker, e: Expr) {
        if (ck.retManual) {
            consumeOwned(ck, e)
        } else if (removeSpan(ck.pendingOwnedCalls, e.span)) {
            errNote(ck, 
                e.span,
                "result of a `#[manualAlloc]` function is owned by the caller",
                "bind it with `#[manualAlloc] let`, pass it to an owned parameter, or return it",
            )
        }
}

fn checkReturnExpr(ck: Checker, got: Ty, span: Span) {
        if (ck.retTy != Ty.Empty && got != Ty.Empty) {
            checkAssignable(ck, ck.retTy, got, span, "return value")
        }
}

fn checkBlock(ck: Checker, b: Block) -> Ty {
        pushScope(ck)
        var last = Ty.Empty
        for (s in b.stmts) {
            last = checkStmt(ck, s)
        }
        if (let some(e) = b.expr) {
            last = checkExpr(ck, e)
        }
        popScope(ck)
        last
}

fn checkStmt(ck: Checker, s: Stmt) -> Ty {
        let before = copySpanList(ck.pendingOwnedCalls)
        let t = checkStmtInner(ck, s)
        var leaked = emptySpanList()
        for (sp in ck.pendingOwnedCalls) {
            if (!hasSpan(before, sp)) {
                leaked.push(sp)
            }
        }
        for (sp in leaked) {
            errNote(ck, 
                sp,
                "result of a `#[manualAlloc]` function is owned by the caller",
                "bind it with `#[manualAlloc] let`, pass it to an owned parameter, or return it",
            )
            removeSpan(ck.pendingOwnedCalls, sp)
        }
        t
}

fn checkStmtInner(ck: Checker, s: Stmt) -> Ty {
        match (s) {
            case Stmt.Let(pattern, ty, init, mutable, attrs, span) -> {
                let manual = checkLetAttributes(ck, attrs)
                var hasAnnotated = false
                var annotatedTy = Ty.Unknown
                if (let some(te) = ty) {
                    hasAnnotated = true
                    annotatedTy = resolvedFnTy(ck, te, ck.fnGenerics)
                }
                match (pattern) {
                    case Pattern.Binding(_, ann) -> {
                        if (let some(ae) = ann) {
                            let at = resolvedFnTy(ck, ae, ck.fnGenerics)
                            guardRefUse(ck, at, span, "a `let` binding")
                        }
                    }
                    case _ -> {}
                }
                if (hasAnnotated) {
                    guardRefUse(ck, annotatedTy, span, "a `let` binding")
                }
                var hasInferred = false
                var inferredTy = Ty.Unknown
                if (let some(e) = init) {
                    hasInferred = true
                    inferredTy = checkExpr(ck, e)
                }
                var finalTy = Ty.Unknown
                if (hasAnnotated && hasInferred) {
                    checkAssignable(ck, annotatedTy, inferredTy, span, "initializer")
                    finalTy = annotatedTy
                } else if (hasAnnotated) {
                    finalTy = annotatedTy
                } else if (hasInferred) {
                    finalTy = inferredTy
                } else {
                    finalTy = Ty.Unknown
                }
                let movedFrom = if (let some(e) = init) { manualMoveSource(ck, e) } else { none }
                if (manual) {
                    if (let some(src) = movedFrom) {
                        // Ownership transfer: `#[manualAlloc] let y = x`
                        // moves the allocation out of `x`.
                        markMoved(ck, src)
                    } else if (let none = init) {
                        err(ck, span, "`#[manualAlloc]` requires an allocation initializer")
                    } else if (!isClassOrStruct(finalTy)) {
                        errNote(ck, 
                            span,
                            "`#[manualAlloc]` requires a class or struct type, found `{bareName(finalTy)}`",
                            "manual allocation applies to class/struct instances",
                        )
                    } else if (let some(i) = init) {
                        // A `#[manualAlloc]` function result is consumed here.
                        consumeOwned(ck, i)
                    }
                } else if (let some(src) = movedFrom) {
                    errNote(ck, 
                        span,
                        "cannot bind `#[manualAlloc]` value `{src}` to a managed binding",
                        "take ownership with `#[manualAlloc] let ... = {src}`, or `{src}.free()`",
                    )
                }
                bindPattern(ck, pattern, finalTy, mutable, span)
                if (manual) {
                    match (pattern) {
                        case Pattern.Binding(name, _) -> markManual(ck, name)
                        case _ -> {}
                    }
                }
                finalTy
            }
            case Stmt.Const(name, ty, value, span) -> {
                let vt = checkExpr(ck, value)
                if (let some(t) = ty) {
                    let tt = resolvedFnTy(ck, t, ck.fnGenerics)
                    guardRefUse(ck, tt, span, "a `const` binding")
                    checkAssignable(ck, tt, vt, span, "const initializer")
                    declare(ck, name, tt, false)
                } else {
                    declare(ck, name, vt, false)
                }
                vt
            }
            case Stmt.Return(value, span) -> {
                let vt = if (let some(e) = value) { checkExpr(ck, e) } else { Ty.Empty }
                let movedFrom = if (let some(e) = value) { manualMoveSource(ck, e) } else { none }
                if (let some(src) = movedFrom) {
                    if (ck.retManual) {
                        // Ownership passes to the caller.
                        markMoved(ck, src)
                    } else {
                        errNote(ck, 
                            span,
                            "cannot return `#[manualAlloc]` value `{src}` from a function that does not own its result",
                            "mark the function `#[manualAlloc]` to transfer `{src}` to the caller",
                        )
                    }
                } else if (ck.retManual) {
                    // A `#[manualAlloc]` function may return a fresh allocation
                    // or another owned call directly.
                    if (let some(e) = value) {
                        consumeOwned(ck, e)
                    }
                }
                if (ck.retTy == Ty.Empty) {
                    if (!isNoneExpr(value)) {
                        errNote(ck, 
                            span,
                            "cannot return a value from a function with no return type",
                            "declare a return type with `-> T`, or remove the value",
                        )
                    }
                } else {
                    checkAssignable(ck, ck.retTy, vt, span, "return value")
                }
                Ty.Empty
            }
            case Stmt.Break(span) -> {
                if (ck.loopDepth == 0) {
                    err(ck, span, "`break`/`continue` used outside of a loop")
                }
                Ty.Empty
            }
            case Stmt.Continue(span) -> {
                if (ck.loopDepth == 0) {
                    err(ck, span, "`break`/`continue` used outside of a loop")
                }
                Ty.Empty
            }
            case Stmt.While(cond, body, _span) -> {
                checkBoolCond(ck, cond)
                ck.loopDepth = ck.loopDepth + 1
                checkBlock(ck, body)
                ck.loopDepth = ck.loopDepth - 1
                Ty.Empty
            }
            case Stmt.For(header, body, _span) -> {
                checkForHeader(ck, header)
                ck.loopDepth = ck.loopDepth + 1
                checkBlock(ck, body)
                ck.loopDepth = ck.loopDepth - 1
                Ty.Empty
            }
            case Stmt.Try(body, binder, handler, fin, _span) -> {
                checkTry(ck, body, binder, handler, fin)
                Ty.Empty
            }
            case Stmt.Throw(value, span) -> {
                let t = checkExpr(ck, value)
                if (t != Ty.Unknown && t != Ty.String) {
                    errNote(ck, span, "a `throw` payload must be a `string`", "found `{bareName(t)}`")
                }
                Ty.Empty
            }
            case Stmt.Expr(e) -> {
                let _ = checkExpr(ck, e)
                Ty.Empty
            }
            case Stmt.Empty(_span) -> Ty.Empty
        }
}

fn checkTry(ck: Checker, body: Block, binder: string?, handler: Block?, fin: Block?) {
        checkBlock(ck, body)
        var hasHandler = false
        if (let some(h) = handler) {
            hasHandler = true
            if (let some(name) = binder) {
                pushScope(ck)
                declare(ck, name, Ty.String, false)
                checkBlock(ck, h)
                popScope(ck)
            } else {
                checkBlock(ck, h)
            }
        }
        if (let some(f) = fin) {
            checkBlock(ck, f)
        }
}

fn checkBoolCond(ck: Checker, e: Expr) {
        let t = checkExpr(ck, e)
        if (t != Ty.Unknown && t != Ty.Bool) {
            errNote(ck, e.span, "condition must be a `bool`", "found `{bareName(t)}`")
        }
}

fn checkForHeader(ck: Checker, header: ForHeader) {
        match (header) {
            case ForHeader.In(pattern, sequence) -> {
                // Iterating an immutable `&T` borrow iterates its referent.
                var st = checkExpr(ck, sequence)
                match (st) {
                    case Ty.Ref(inner) -> {
                        st = inner
                    }
                    case _ -> {}
                }
                let elemT = match (st) {
                    case Ty.List(_) -> {
                        if (let some(e) = elem(st)) {
                            e
                        } else {
                            Ty.Unknown
                        }
                    }
                    case Ty.Range(_) -> {
                        if (let some(e) = elem(st)) {
                            e
                        } else {
                            Ty.Unknown
                        }
                    }
                    case Ty.Map(k, v) -> {
                        let mapElem = if (let some(e) = elem(st)) { e } else { Ty.Unknown }
                        match (pattern) {
                            case Pattern.Tuple(parts) -> {
                                if (len(parts) != 2) {
                                    err(ck, sequence.span, "map entries pattern must bind exactly two names `(k, v)`")
                                    Ty.Unknown
                                } else {
                                    Ty.Tuple([k, v])
                                }
                            }
                            case _ -> mapElem
                        }
                    }
                    case Ty.String -> Ty.Byte
                    case Ty.Unknown -> Ty.Unknown
                    case _ -> {
                        if (let some(e) = iterableElem(ck, st)) {
                            e
                        } else {
                            errNote(ck, 
                                sequence.span,
                                "`for (x in ...)` requires a sequence (List, string, Map, range, or an `Iterable<T>`), found `{bareName(st)}`",
                                "found `{bareName(st)}`",
                            )
                            Ty.Unknown
                        }
                    }
                }
                bindPattern(ck, pattern, elemT, true, sequence.span)
            }
            case ForHeader.Range(init, cond, step) -> {
                let _ = checkStmt(ck, init)
                checkBoolCond(ck, cond)
                let _ = checkExpr(ck, step)
            }
        }
}

fn bindPattern(ck: Checker, p: Pattern, ty: Ty, mutable: bool, span: Span) {
        match (p) {
            case Pattern.Wildcard -> {}
            case Pattern.Binding(name, ann) -> {
                // A pattern annotation like `let m: int?` is parsed into the
                // pattern; it wins over the inferred value type and is checked
                // against it.
                if (let some(te) = ann) {
                    let at = resolvedFnTy(ck, te, ck.fnGenerics)
                    if (ty != Ty.Unknown) {
                        checkAssignable(ck, at, ty, span, "binding")
                    }
                    declare(ck, name, at, mutable)
                } else {
                    declare(ck, name, ty, mutable)
                }
            }
            case Pattern.Literal(_l) -> {}
            case Pattern.Tuple(parts) -> {
                match (ty) {
                    case Ty.Tuple(tys) -> {
                        var i = 0
                        while (i < len(parts)) {
                            let pt = if (i < len(tys)) { tys[i] } else { Ty.Unknown }
                            bindPattern(ck, parts[i], pt, mutable, span)
                            i = i + 1
                        }
                    }
                    case _ -> {
                        if (ty != Ty.Unknown) {
                            err(ck, span, "tuple pattern does not match a tuple value")
                        }
                    }
                }
            }
            case Pattern.Variant(path, payloads) -> {
                // `some(v)` binds the payload against an option scrutinee.
                if (len(path) == 1 && path[0] == "some" && isOption(ty)) {
                    let inner = if (let some(x) = innerOption(ty)) { x } else { Ty.Unknown }
                    if (len(payloads) != 1) {
                        err(ck, span, "`some` pattern takes exactly one payload binding")
                    } else {
                        bindPattern(ck, payloads[0], inner, mutable, span)
                    }
                } else {
                    // `Enum.Variant(p1, p2)` binding. If only the variant name
                    // is given, the enum type is inferred from the value.
                    var enumName = ""
                    var variantName = ""
                    var resolvedName = true
                    if (len(path) == 2) {
                        enumName = path[0]
                        variantName = path[1]
                        false
                    } else if (len(path) == 1) {
                        match (ty) {
                            case Ty.Enum(en, _) -> {
                                enumName = en
                                variantName = path[0]
                                false
                            }
                            case _ -> {
                                if (ty != Ty.Unknown) {
                                    err(ck, span, "enum variant pattern requires a value of enum type")
                                }
                                resolvedName = false
                                false
                            }
                        }
                    } else {
                        resolvedName = false
                    }
                    if (resolvedName && ty != Ty.Unknown) {
                        if (let some(entry) = ck.resolved.types.get(enumName)) {
                            match (entry) {
                                case TypeTableEntry.Enum(t) -> {
                                    var variant: EnumVariantInfo? = none
                                    for (v in t.variants) {
                                        if (v.name == variantName) {
                                            variant = v
                                        }
                                    }
                                    if (let some(v) = variant) {
                                        var i = 0
                                        while (i < len(payloads)) {
                                            let ft = if (i < len(v.fields)) { v.fields[i] } else { Ty.Unknown }
                                            bindPattern(ck, payloads[i], ft, mutable, span)
                                            i = i + 1
                                        }
                                    } else {
                                        err(ck, span, "enum `{enumName}` has no variant `{variantName}`")
                                    }
                                }
                                case _ -> {}
                            }
                        }
                    }
                }
            }
            case Pattern.Or(parts) -> {
                for (part in parts) {
                    bindPattern(ck, part, ty, mutable, span)
                }
            }
        }
}

fn checkFieldDecl(ck: Checker, typeName: string, fname: string, fty: TypeExpr?, init: Expr?, isStatic: bool, isConst: bool, attrs: List<Attribute>, span: Span, generics: List<string>) {
        match (init) {
            case some(e) -> {
                let ft = checkExpr(ck, e)
                var w = Ty.Unknown
                if (let some(te) = fty) {
                    w = resolvedFnTy(ck, te, generics)
                    guardRefUse(ck, w, span, "a field")
                }
                if (let none = fty) {
                    // Fall back to the resolved table's field type, with the
                    // class generics substituted.
                    if (let some(entry) = ck.resolved.types.get(typeName)) {
                        match (entry) {
                            case TypeTableEntry.Class(t) -> {
                                for (f in t.fields) {
                                    if (f.name == fname) {
                                        w = substTy(ck, f.ty, ck.selfArgs)
                                    }
                                }
                            }
                            case TypeTableEntry.Struct(t) -> {
                                for (f in t.fields) {
                                    if (f.name == fname) {
                                        w = substTy(ck, f.ty, ck.selfArgs)
                                    }
                                }
                            }
                            case _ -> {}
                        }
                    }
                }
                if (w == Ty.Unknown) {
                    w = ft
                }
                let manual = checkFieldAttributes(ck, attrs, w, isStatic, isConst, span)
                if (manual) {
                    if (let none = fty) {
                        err(ck, span, "owned field `{fname}` needs an explicit type annotation")
                    }
                }
                checkAssignable(ck, w, ft, span, "field initializer")
                if (manual) {
                    consumeIntoOwned(ck, e, span, "owned field")
                }
            }
            case none -> {
                var w0 = Ty.Unknown
                if (let some(te) = fty) {
                    w0 = resolvedFnTy(ck, te, generics)
                    guardRefUse(ck, w0, span, "a field")
                }
                let wOpt = if (w0 == Ty.Unknown) { none } else { w0 }
                let manual = checkFieldAttributes(ck, attrs, wOpt, isStatic, isConst, span)
                if (manual) {
                    errNote(ck, 
                        span,
                        "owned field `{fname}` must be initialized where it is declared",
                        "give it an initializer such as `= Node(...)`",
                    )
                }
            }
        }
}

fn checkClassBodies(ck: Checker, c: ClassDecl) {
        if (let some(table) = classTable(ck, c.name)) {
            ck.selfTy = Ty.Class(c.name, tyVars(table.generics))
            var args = emptyMapStrTy()
            for (g in table.generics) {
                args[g] = Ty.Var(g)
            }
            ck.selfArgs = args
            for (m in c.members) {
                match (m) {
                    case ClassMember.Field(name, fty, init, _visibility, isStatic, isConst, attrs, span) -> {
                        checkFieldDecl(ck, c.name, name, fty, init, isStatic, isConst, attrs, span, table.generics)
                    }
                    case ClassMember.Const(_cname, _visibility, cty, value, cspan) -> {
                        let vt = checkExpr(ck, value)
                        if (let some(t) = cty) {
                            let tt = resolvedFnTy(ck, t, table.generics)
                            checkAssignable(ck, tt, vt, cspan, "const initializer")
                        }
                    }
                    case ClassMember.Method(md) -> checkMethodBody(ck, md, table)
                    case ClassMember.Constructor(cd) -> {
                        pushScope(ck)
                        ck.retTy = Ty.Empty
                        ck.fnGenerics = emptyStrList()
                        for (p in cd.params) {
                            let pt = resolveParamTy(ck, p)
                            declare(ck, p.name, pt, true)
                        }
                        if (let some(_nn) = cd.name) {
                            checkNamedCtorBody(ck, cd, table)
                        } else {
                            // A `super(...)` delegation is only valid inside a
                            // primary constructor body of a class with a parent.
                            ck.superCtorParams = none
                            if (let some(ps) = table.extends) {
                                if (let some(n) = named(ps)) {
                                    if (let some(pt) = classTable(ck, n)) {
                                        ck.superCtorParams = primaryCtorParamTys(ck, pt)
                                    }
                                }
                            }
                            checkBlock(ck, cd.body)
                            ck.superCtorParams = none
                        }
                        popScope(ck)
                    }
                    case ClassMember.Init(b) -> {
                        pushScope(ck)
                        ck.retTy = Ty.Empty
                        ck.fnGenerics = emptyStrList()
                        let _ = checkBlock(ck, b)
                        popScope(ck)
                    }
                    case ClassMember.Deinit(b) -> {
                        pushScope(ck)
                        ck.retTy = Ty.Empty
                        ck.fnGenerics = emptyStrList()
                        let _ = checkBlock(ck, b)
                        popScope(ck)
                    }
                    case ClassMember.Property(p) -> checkPropertyBodies(ck, p, table.generics)
                }
            }
            ck.selfTy = none
            ck.selfArgs = emptyMapStrTy()
        }
}

fn checkStructBodies(ck: Checker, s: StructDecl) {
        if (let some(table) = classTable(ck, s.name)) {
            ck.selfTy = Ty.Struct(s.name, tyVars(table.generics))
            var args = emptyMapStrTy()
            for (g in table.generics) {
                args[g] = Ty.Var(g)
            }
            ck.selfArgs = args
            for (m in s.members) {
                match (m) {
                    case ClassMember.Field(name, fty, init, _visibility, isStatic, isConst, attrs, span) -> {
                        checkFieldDecl(ck, s.name, name, fty, init, isStatic, isConst, attrs, span, table.generics)
                    }
                    case ClassMember.Method(md) -> checkMethodBody(ck, md, table)
                    case ClassMember.Property(p) -> checkPropertyBodies(ck, p, table.generics)
                    case _ -> {}
                }
            }
            ck.selfTy = none
            ck.selfArgs = emptyMapStrTy()
        }
}

fn checkMethodBody(ck: Checker, md: MethodDecl, table: ClassTable) {
        pushScope(ck)
        ck.fnGenerics = emptyStrList()
        for (g in md.generics) {
            ck.fnGenerics.push(g.name)
        }
        ck.retTy = Ty.Empty
        if (let some(entry) = ck.resolved.types.get(table.name)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    for (m in t.methods) {
                        if (m.name == md.name) {
                            ck.retTy = m.ret
                        }
                    }
                }
                case TypeTableEntry.Struct(t) -> {
                    for (m in t.methods) {
                        if (m.name == md.name) {
                            ck.retTy = m.ret
                        }
                    }
                }
                case _ -> {}
            }
        }
        guardRefUse(ck, ck.retTy, md.span, "a return type")
        // Declare `this` in scope.
        if (let some(st) = ck.selfTy) {
            declare(ck, "this", st, false)
        }
        for (p in md.params) {
            let pt = resolveParamTy(ck, p)
            declare(ck, p.name, pt, true)
            if (let some(d) = p.default) {
                let dt = checkExpr(ck, d)
                checkAssignable(ck, pt, dt, p.span, "default argument")
            }
        }
        if (let some(body) = md.body) {
            checkFnBody(ck, body)
        }
        ck.retTy = Ty.Empty
        ck.fnGenerics = emptyStrList()
        popScope(ck)
}

fn checkPropertyBodies(ck: Checker, p: PropertyDecl, generics: List<string>) {
        let pty = if (let some(te) = p.ty) { resolvedFnTy(ck, te, generics) } else { Ty.Unknown }
        if (let some(get) = p.get) {
            pushScope(ck)
            ck.fnGenerics = emptyStrList()
            ck.retTy = pty
            if (let some(st) = ck.selfTy) {
                if (!p.isStatic) {
                    declare(ck, "this", st, false)
                }
            }
            let t = match (get) {
                case PropertyAccessor.Expr(e) -> checkExpr(ck, e)
                case PropertyAccessor.Block(b) -> checkBlock(ck, b)
            }
            if (t != Ty.Empty) {
                checkAssignable(ck, pty, t, p.span, "property getter")
            }
            popScope(ck)
        }
        if (let some(set) = p.set) {
            pushScope(ck)
            ck.fnGenerics = emptyStrList()
            ck.retTy = Ty.Empty
            if (let some(st) = ck.selfTy) {
                if (!p.isStatic) {
                    declare(ck, "this", st, false)
                }
            }
            declare(ck, "value", pty, true)
            let _ = match (set) {
                case PropertyAccessor.Expr(e) -> checkExpr(ck, e)
                case PropertyAccessor.Block(b) -> checkBlock(ck, b)
            }
            popScope(ck)
        }
}

fn checkInterfaceConformance(ck: Checker) {
        for (entry in ck.resolved.types.values()) {
            var cname = ""
            var impls = emptyTyList()
            var skip = false
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    cname = t.name
                    impls = t.implements
                    skip
                }
                case TypeTableEntry.Struct(t) -> {
                    cname = t.name
                    impls = t.implements
                    skip
                }
                case TypeTableEntry.Enum(t) -> {
                    cname = t.name
                    impls = t.implements
                    skip
                }
                case TypeTableEntry.Interface(_) -> skip = true
            }
            if (skip) {
                continue
            }
            for (i in impls) {
                let ifaceName = if (let some(n) = named(i)) { n } else { "" }
                if (ifaceName == "") {
                    continue
                }
                if (let some(entry2) = ck.resolved.types.get(ifaceName)) {
                    match (entry2) {
                        case TypeTableEntry.Interface(iface) -> {
                            for (member in iface.members) {
                                if (member.isProperty) {
                                    var hasProp = findProperty(ck, cname, member.name)
                                    if (let none = hasProp) {
                                        if (let none = findField(ck, cname, member.name, emptyMapStrTy())) {
                                            err(ck, member.span, "`{cname}` declares `implements {ifaceName}` but has no member `{member.name}`")
                                        }
                                    }
                                } else if (let none = findMethod(ck, cname, member.name)) {
                                    err(ck, member.span, "`{cname}` declares `implements {ifaceName}` but has no method `{member.name}`")
                                }
                            }
                        }
                        case _ -> {}
                    }
                }
            }
        }
}

fn checkExpr(ck: Checker, e: Expr) -> Ty {
        let t = checkExprImpl(ck, e)
        ck.types[spanKey(e.span)] = t
        t
}

fn checkExprImpl(ck: Checker, e: Expr) -> Ty {
        match (e.kind) {
            case ExprKind.Lit(Lit.String(parts)) -> stringTy(ck, parts)
            case ExprKind.Lit(l) -> litTy(ck, l)
            case ExprKind.Ident(name) -> identTy(ck, e, name)
            case ExprKind.This -> {
                if (let some(st) = ck.selfTy) {
                    st
                } else {
                    err(ck, e.span, "`this` used outside of a class body")
                    Ty.Unknown
                }
            }
            case ExprKind.Super -> superTy(ck, e)
            case ExprKind.Block(b) -> checkBlock(ck, b)
            case ExprKind.Tuple(parts) -> {
                var ts = emptyTyList()
                for (p in parts) {
                    ts.push(checkExpr(ck, p))
                }
                Ty.Tuple(ts)
            }
            case ExprKind.Array(parts) -> {
                if (len(parts) == 0) {
                    Ty.List(Ty.Unknown)
                } else {
                    let elem = checkExpr(ck, parts[0])
                    var i = 1
                    while (i < len(parts)) {
                        let t = checkExpr(ck, parts[i])
                        checkAssignable(ck, elem, t, parts[i].span, "array element")
                        i = i + 1
                    }
                    Ty.List(elem)
                }
            }
            case ExprKind.Map(pairs) -> {
                if (len(pairs) == 0) {
                    Ty.Map(Ty.Unknown, Ty.Unknown)
                } else {
                    let k = checkExpr(ck, pairs[0].key)
                    if (k != Ty.Unknown) {
                        var keyOk = false
                        match (k) {
                            case Ty.String -> keyOk = true
                            case Ty.Int -> keyOk = true
                            case Ty.Float -> keyOk = true
                            case Ty.Bool -> keyOk = true
                            case Ty.Char -> keyOk = true
                            case Ty.Byte -> keyOk = true
                            case Ty.List(_) -> keyOk = true
                            case Ty.Map(_, _) -> keyOk = true
                            case Ty.Class(_, _) -> keyOk = true
                            case Ty.Struct(_, _) -> keyOk = true
                            case Ty.Enum(_, _) -> keyOk = true
                            case Ty.Interface(_, _) -> keyOk = true
                            case Ty.Range(_) -> keyOk = true
                            case Ty.Option(_) -> keyOk = true
                            case Ty.Tuple(_) -> keyOk = true
                            case _ -> {}
                        }
                        if (!keyOk) {
                            err(ck, pairs[0].key.span, "map keys must be `string`, `int`, `float`, `bool`, `char`, `byte`, a list, a map, a class/struct, an enum, an option, or a tuple, found `{bareName(k)}`")
                        }
                    }
                    let vt = checkExpr(ck, pairs[0].value)
                    var mi = 1
                    while (mi < len(pairs)) {
                        let tk = checkExpr(ck, pairs[mi].key)
                        let tv = checkExpr(ck, pairs[mi].value)
                        checkAssignable(ck, k, tk, pairs[mi].key.span, "map key")
                        checkAssignable(ck, vt, tv, pairs[mi].value.span, "map value")
                        mi = mi + 1
                    }
                    Ty.Map(k, vt)
                }
            }
            case ExprKind.Await(x) -> {
                // `await <future>` drives a zero-argument function (a future
                // returned by an `async fn`) to completion and yields its value.
                let t = checkExpr(ck, x)
                var isEmptyFn = false
                var prt = Ty.None
                match (t) {
                    case Ty.Fn(ps, r) -> {
                        if (len(ps) == 0) {
                            isEmptyFn = true
                            prt = r
                        }
                    }
                    case _ -> {}
                }
                if (isEmptyFn) {
                    prt
                } else {
                    var isUnknown = false
                    match (t) {
                        case Ty.Unknown -> isUnknown = true
                        case _ -> {}
                    }
                    if (isUnknown) {
                        Ty.Unknown
                    } else {
                        err(ck, e.span, "cannot `await` a value of type `{bareName(t)}`; a future is a zero-argument function (`() -> T`) returned by an `async fn`")
                        Ty.Unknown
                    }
                }
            }
            case ExprKind.Unsafe(b) -> {
                ck.unsafeDepth = ck.unsafeDepth + 1
                let t = checkBlock(ck, b)
                ck.unsafeDepth = ck.unsafeDepth - 1
                t
            }
            case ExprKind.Range(start, end, _incl) -> {
                let st = checkExpr(ck, start)
                let _ = checkExpr(ck, end)
                Ty.Range(st)
            }
            case ExprKind.Assign(target, _op, value) -> checkAssign(ck, e, target, value)
            case ExprKind.Lambda(params, returnTy, isAsync, body) -> {
                let t = checkLambda(ck, e, params, returnTy, isAsync, body)
                t
            }
            case ExprKind.If(cond, thenBlock, elseExpr) -> checkIf(ck, e, cond, thenBlock, elseExpr)
            case ExprKind.Match(scrutinee, arms) -> checkMatch(ck, e, scrutinee, arms)
            case ExprKind.Call(callee, args) -> checkCall(ck, e, callee, args)
            case ExprKind.Member(object, name) -> checkMember(ck, e, object, name)
            case ExprKind.Index(object, index) -> checkIndex(ck, e, object, index)
            case ExprKind.OptAccess(object, name) -> checkOptAccess(ck, e, object, name)
            case ExprKind.OptUnwrap(x) -> checkOptUnwrap(ck, e, x)
            case ExprKind.Binary(op, lhs, rhs) -> checkBinary(ck, e, op, lhs, rhs)
            case ExprKind.Unary(op, operand) -> checkUnary(ck, e, op, operand)
            case ExprKind.Cast(expr, ty, kind) -> checkCast(ck, e, expr, ty, kind)
            case ExprKind.GenericCall(name, typeArgs) -> genericFnTy(ck, e, name, typeArgs)
            case _ -> Ty.Unknown
        }
}

fn litTy(ck: Checker, lit: Lit) -> Ty {
        match (lit) {
            case Lit.Int(_) -> Ty.Int
            case Lit.Float(_) -> Ty.Float
            case Lit.String(_) -> Ty.String
            case Lit.Char(_) -> Ty.Char
            case Lit.Bool(_) -> Ty.Bool
            case Lit.None -> Ty.None
        }
}

fn stringTy(ck: Checker, parts: List<StrPart>) -> Ty {
        var i = 0
        while (i < len(parts)) {
            let part = parts[i]
            match (part) {
                case StrPart.Expr(x) -> {
                    let _ = checkExpr(ck, x)
                }
                case _ -> {}
            }
            i = i + 1
        }
        Ty.String
}

fn identTy(ck: Checker, e: Expr, name: string) -> Ty {
        if (let some(l) = lookup(ck, name)) {
            if (l.freed) {
                err(ck, e.span, "use of `{name}` after `free()`")
            } else if (l.moved) {
                errNote(ck, e.span, "use of `{name}` after it was moved", "a `#[manualAlloc]` value has a single owner; bind the new name and use that")
            }
            return l.ty
        }
        if (let some(fns) = ck.resolved.fns.get(name)) {
            return fnTySig(ck, fns)
        }
        for (c in ck.resolved.consts) {
            if (c.name == name) {
                return c.ty
            }
        }
        for (g in ck.resolved.globals) {
            if (g.name == name) {
                return g.ty
            }
        }
        // Implicit receiver: a bare field/property/method name inside a
        // class or struct body refers to `this.name`.
        if (let some(st) = ck.selfTy) {
            if (let some(tk) = typeKey(ck, st)) {
                if (let some(f) = findField(ck, tk.name, name, tk.args)) {
                    return subst(f.ty, tk.args)
                }
                if (let some(p) = findProperty(ck, tk.name, name)) {
                    return p.ty
                }
                if (let some(m) = findMethod(ck, tk.name, name)) {
                    var mps = emptyTyList()
                    for (mp in m.params) {
                        mps.push(mp.ty)
                    }
                    return Ty.Fn(mps, methodRetTy(ck, m, emptyMapStrTy()))
                }
            }
        }
        // Type name used as a constructor/static receiver.
        if (let some(entry) = ck.resolved.types.get(name)) {
            match (entry) {
                case TypeTableEntry.Class(t) -> {
                    return Ty.Class(t.name, tyVars(t.generics))
                }
                case TypeTableEntry.Struct(t) -> {
                    return Ty.Struct(t.name, tyVars(t.generics))
                }
                case TypeTableEntry.Enum(t) -> {
                    return Ty.Enum(t.name, tyVars(t.generics))
                }
                case TypeTableEntry.Interface(t) -> {
                    return Ty.Interface(t.name, tyVars(t.generics))
                }
            }
        }
        errNote(ck, e.span, "use of undeclared name `{name}`", "names must be declared before use")
        Ty.Unknown
}

fn superTy(ck: Checker, e: Expr) -> Ty {
        if (let some(st) = ck.selfTy) {
            if (let some(tk) = typeKey(ck, st)) {
                if (let some(table) = classTable(ck, tk.name)) {
                    if (let some(p) = table.extends) {
                        return p
                    }
                    err(ck, e.span, "this class has no parent to call `super` on")
                    return Ty.Unknown
                }
            }
        }
        err(ck, e.span, "`super` used outside of a class body")
        Ty.Unknown
}

fn fnTySig(ck: Checker, fns: List<CallableInfo>) -> Ty {
        if (len(fns) == 0) {
            return Ty.Unknown
        }
        let f = fns[0]
        var ps = emptyTyList()
        for (p in f.params) {
            ps.push(p.ty)
        }
        // An `async fn` used as a value is a function returning a future
        // (`() -> R`), not the result `R` itself.
        var ret = f.ret
        if (f.isAsync && (len(f.generics) == 0)) {
            ret = Ty.Fn(emptyTyList(), f.ret)
        }
        Ty.Fn(ps, ret)
}

fn methodRetTy(ck: Checker, m: CallableInfo, map: Map<string, Ty>) -> Ty {
        var ret = subst(m.ret, map)
        if (m.isAsync) {
            ret = Ty.Fn(emptyTyList(), ret)
        }
        ret
}

fn genericFnTy(ck: Checker, e: Expr, name: string, typeArgs: List<TypeExpr>) -> Ty {
        if (let none = ck.resolved.fns.get(name)) {
            err(ck, e.span, "unknown generic function `{name}`")
            return Ty.Unknown
        }
        var f: CallableInfo? = none
        if (let some(fns) = ck.resolved.fns.get(name)) {
            for (c in fns) {
                if (!(c.span.start == 0 && c.span.end == 0)) {
                    f = c
                    break
                }
            }
            if (let none = f) {
                return fnTySig(ck, fns)
            }
        }
        if (let some(ff) = f) {
            // Instantiate the callee signature with the explicit type args.
            var argsTyp = emptyTyList()
            for (te in typeArgs) {
                argsTyp.push(resolvedFnTy(ck, te, copyStrList(ck.fnGenerics)))
            }
            if (len(ff.generics) != len(argsTyp)) {
                err(ck, e.span, "`{name}` takes {len(ff.generics)} type argument(s), found {len(argsTyp)}")
                var fps = emptyTyList()
                for (p in ff.params) {
                    fps.push(p.ty)
                }
                return Ty.Fn(fps, ff.ret)
            }
            var map: Map<string, Ty> = emptyMapStrTy()
            var gi = 0
            while (gi < len(ff.generics)) {
                map[ff.generics[gi]] = argsTyp[gi]
                gi = gi + 1
            }
            var ps2 = emptyTyList()
            for (p in ff.params) {
                ps2.push(subst(p.ty, map))
            }
            var sret = subst(ff.ret, map)
            // An `async fn` called with explicit type arguments returns a future
            // (`() -> R`), exactly like the inferred-generic path.
            if (ff.isAsync) {
                sret = Ty.Fn(emptyTyList(), sret)
            }
            return Ty.Fn(ps2, sret)
        }
        Ty.Unknown
}

fn checkCall(ck: Checker, e: Expr, callee: Expr, args: List<CallArg>) -> Ty {
        // `super(...)` inside a primary constructor body delegates to the
        // parent constructor; its arguments are checked against the parent's
        // constructor parameters.
        match (callee.kind) {
            case ExprKind.Super -> {
                if (let none = ck.superCtorParams) {
                    err(ck, e.span, "`super(...)` can only be used as a constructor delegation")
                    return Ty.Unknown
                }
                if (let some(params) = ck.superCtorParams) {
                    checkArgs(ck, e, params, args)
                }
                return Ty.Empty
            }
            case ExprKind.This -> {
                if (let none = ck.namedCtorParams) {
                    err(ck, e.span, "`this(...)` can only be used as a named constructor's delegation")
                    return Ty.Unknown
                }
                if (ck.namedCtorDelegated) {
                    err(ck, e.span, "a named constructor may only delegate to `this(...)` once")
                }
                ck.namedCtorDelegated = true
                if (let some(params) = ck.namedCtorParams) {
                    checkArgs(ck, e, params, args)
                }
                return Ty.Empty
            }
            case _ -> {}
        }
        // Raw-buffer builtins and misc named builtins.
        let isIdent = match (callee.kind) {
            case ExprKind.Ident(_) -> true
            case _ -> false
        }
        if (isIdent) {
            let bn = match (callee.kind) {
                case ExprKind.Ident(n) -> n
                case _ -> ""
            }
            if (bn == "alloc" || bn == "free") {
                return checkRawBuiltin(ck, e, bn, args)
            }
            if (bn == "view") {
                return checkView(ck, e, args)
            }
            if (bn == "assert") {
                return checkAssert(ck, e, args)
            }
            if (bn == "abs") {
                return checkAbs(ck, e, args)
            }
            if (bn == "min" || bn == "max") {
                return checkMinmax(ck, e, bn, args)
            }
            if (bn == "clamp") {
                return checkClamp(ck, e, args)
            }
            if (bn == "str") {
                return checkStr(ck, e, args)
            }
            if (bn == "range") {
                return checkRange(ck, e, args)
            }
            if (bn == "read_file") {
                return checkReadFile(ck, e, args)
            }
            if (bn == "write_file") {
                return checkWriteFile(ck, e, args)
            }
            if (bn == "file_exists") {
                return checkFileExists(ck, e, args)
            }
            if (bn == "delete") {
                return checkDelete(ck, e, args)
            }
            if (bn == "mkdir") {
                return checkMkdir(ck, e, args)
            }
            if (bn == "list_dir") {
                return checkListDir(ck, e, args)
            }
            if (bn == "bytes") {
                return checkBytes(ck, e, args)
            }
            if (bn == "stream_open_read" || bn == "stream_open_write" || bn == "stream_open_append") {
                return checkStreamOpen(ck, e, bn, args)
            }
            if (bn == "stdout_stream" || bn == "stderr_stream") {
                return checkStreamSingleton(ck, e, bn, args)
            }
            if (bn == "args") {
                return checkArgsBuiltin(ck, e, args)
            }
            if (bn == "exit") {
                return checkExit(ck, e, args)
            }
            if (bn == "run_cmd") {
                return checkRunCmd(ck, e, args)
            }
            if (bn == "run_spawn") {
                return checkRunSpawn(ck, e, args)
            }
            if (bn == "proc_wait" || bn == "proc_running" || bn == "proc_code" || bn == "proc_kill" || bn == "proc_in_close") {
                return checkProcHandle(ck, e, bn, args)
            }
            if (bn == "proc_out_read" || bn == "proc_err_read") {
                return checkProcRead(ck, e, bn, args)
            }
            if (bn == "proc_in_write") {
                return checkProcWrite(ck, e, args)
            }
            if (bn == "current_dir") {
                return checkCurrentDir(ck, e, args)
            }
            if (bn == "thread_spawn") {
                return checkTaskBody(ck, e, bn, args, 0)
            }
            if (bn == "once_run") {
                return checkTaskBody(ck, e, bn, args, 1)
            }
            if (bn == "captureBegin") {
                return checkCaptureBegin(ck, e, args)
            }
            if (bn == "captureTake") {
                return checkCaptureTake(ck, e, args)
            }
            if (bn == "expect" && !ck.resolved.fns.has("expect")) {
                return checkExpect(ck, e, args)
            }
        }
        // `expect(v).toEqual(w)` / `.not().toBe(w)` / ... chains.
        let isMember = match (callee.kind) {
            case ExprKind.Member(_, _) -> true
            case _ -> false
        }
        if (isMember) {
            let mName = match (callee.kind) {
                case ExprKind.Member(_, n) -> n
                case _ -> ""
            }
            let mObj = match (callee.kind) {
                case ExprKind.Member(o, _) -> o
                case _ -> callee
            }
            if (mName != "not" && isExpectMethod(mName) && expectChainDepth(ck, mObj) > 0) {
                if (let some(src) = expectSource(ck, mObj)) {
                    return checkExpectMethod(ck, e, src, mName, args)
                }
            }
            // `.free()` on a `#[manualAlloc]` binding.
            if (mName == "free") {
                let objIsIdent = match (mObj.kind) {
                    case ExprKind.Ident(_) -> true
                    case _ -> false
                }
                if (objIsIdent) {
                    let id = match (mObj.kind) {
                        case ExprKind.Ident(n) -> n
                        case _ -> ""
                    }
                    if (isManual(ck, id)) {
                        let _ = checkExpr(ck, mObj)
                        return checkFree(ck, e, id, args)
                    }
                }
                let rt = checkExpr(ck, mObj)
                var hasUserFree = false
                if (let some(tk) = typeKey(ck, rt)) {
                    if (let some(_m) = findMethod(ck, tk.name, "free")) {
                        hasUserFree = true
                    }
                }
                if (!hasUserFree) {
                    errNote(ck, e.span, "`free` is only available on a `#[manualAlloc]` binding", "declare the binding with `#[manualAlloc] let x = T()`")
                    return Ty.Unknown
                }
            }
        }
        // `Enum.Variant(...)` constructor call.
        if (isMember) {
            let mName2 = match (callee.kind) {
                case ExprKind.Member(_, n) -> n
                case _ -> ""
            }
            let mObj2 = match (callee.kind) {
                case ExprKind.Member(o, _) -> o
                case _ -> callee
            }
            let objIsIdent2 = match (mObj2.kind) {
                case ExprKind.Ident(_) -> true
                case _ -> false
            }
            if (objIsIdent2) {
                let enumName = match (mObj2.kind) {
                    case ExprKind.Ident(n) -> n
                    case _ -> ""
                }
                if (let some(entry) = ck.resolved.types.get(enumName)) {
                    match (entry) {
                        case TypeTableEntry.Enum(t) -> {
                            var ftypes: List<Ty>? = none
                            for (v in t.variants) {
                                if (v.name == mName2) {
                                    ftypes = v.fields
                                }
                            }
                            if (let some(ft) = ftypes) {
                                checkArgs(ck, e, ft, args)
                                return Ty.Enum(t.name, emptyTys())
                            }
                            err(ck, callee.span, "enum `{enumName}` has no variant `{mName2}`")
                            return Ty.Unknown
                        }
                        case _ -> {}
                    }
                }
            }
        }
        // A generic class/struct constructor call `Box<int>(args)`.
        let isGen = match (callee.kind) {
            case ExprKind.GenericCall(_, _) -> true
            case _ -> false
        }
        if (isGen) {
            let gName = match (callee.kind) {
                case ExprKind.GenericCall(n, _) -> n
                case _ -> ""
            }
            let gArgTys = match (callee.kind) {
                case ExprKind.GenericCall(_, t) -> t
                case _ -> emptyTypeExprs()
            }
            if (let some(entry) = ck.resolved.types.get(gName)) {
                var gCtor = false
                match (entry) {
                    case TypeTableEntry.Class(_) -> gCtor = true
                    case TypeTableEntry.Struct(_) -> gCtor = true
                    case TypeTableEntry.Enum(_) -> {}
                    case TypeTableEntry.Interface(_) -> {}
                }
                if (!gCtor) {
                    err(ck, e.span, "`{gName}` cannot be constructed directly")
                    return Ty.Unknown
                }
                var gt = emptyTyList()
                for (te in gArgTys) {
                    gt.push(resolvedFnTy(ck, te, copyStrList(ck.fnGenerics)))
                }
                if (let some(table) = classTable(ck, gName)) {
                    if (len(gt) != len(table.generics)) {
                        err(ck, e.span, "`{gName}` takes {len(table.generics)} type argument(s), found {len(gt)}")
                        return Ty.Unknown
                    }
                    var gmap: Map<string, Ty> = emptyMapStrTy()
                    var gi = 0
                    while (gi < len(table.generics)) {
                        gmap[table.generics[gi]] = gt[gi]
                        gi = gi + 1
                    }
                    var gparams = emptyTyList()
                    if (let some(ctor) = table.ctor) {
                        for (p in ctor.params) {
                            gparams.push(subst(p.ty, gmap))
                        }
                    } else {
                        let synth = synthesizedCtorParamTys(ck, gName)
                        for (s in synth) {
                            gparams.push(subst(s, gmap))
                        }
                    }
                    checkArgs(ck, e, gparams, args)
                    match (entry) {
                        case TypeTableEntry.Class(c) -> { return Ty.Class(c.name, gt) }
                        case TypeTableEntry.Struct(s) -> { return Ty.Struct(s.name, gt) }
                        case _ -> { return Ty.Unknown }
                    }
                }
                return Ty.Unknown
            }
            // Not a type name: falls through to the generic-function check.
        }
        // Constructor call: `TypeName(args)` where callee is a type name.
        if (isIdent) {
            let cname = match (callee.kind) {
                case ExprKind.Ident(n) -> n
                case _ -> ""
            }
            if (let some(entry) = ck.resolved.types.get(cname)) {
                var ct = Ty.Unknown
                var cCtor = true
                match (entry) {
                    case TypeTableEntry.Class(c) -> {
                        ct = Ty.Class(c.name, tyVars(c.generics))
                        cCtor
                    }
                    case TypeTableEntry.Struct(s) -> {
                        ct = Ty.Struct(s.name, tyVars(s.generics))
                        cCtor
                    }
                    case TypeTableEntry.Interface(_) -> {
                        cCtor = false
                        cCtor
                    }
                    case TypeTableEntry.Enum(_) -> {
                        cCtor = false
                        cCtor
                    }
                }
                if (!cCtor) {
                    err(ck, e.span, "`{cname}` cannot be constructed directly")
                    return Ty.Unknown
                }
                if (let some(tk) = typeKey(ck, ct)) {
                    if (let some(m) = findMethod(ck, tk.name, cname)) {
                        var mps = emptyTyList()
                        for (p in m.params) {
                            mps.push(p.ty)
                        }
                        checkArgs(ck, e, mps, args)
                        return m.ret
                    }
                }
                if (let some(c) = classTable(ck, cname)) {
                    if (let some(ctor) = c.ctor) {
                        var cps = emptyTyList()
                        for (p in ctor.params) {
                            cps.push(p.ty)
                        }
                        checkArgs(ck, e, cps, args)
                    } else {
                        checkArgs(ck, e, synthesizedCtorParamTys(ck, cname), args)
                    }
                }
                return ct
            }
            // Regular function call by name (user or builtin).
            if (let some(fns) = ck.resolved.fns.get(cname)) {
                var nsa = 0
                for (a in args) {
                    if (!a.spread) {
                        nsa = nsa + 1
                    }
                }
                // Prefer the signature whose fixed-param count best fits the
                // positional arguments; variadic rest stays loose.
                var bestI = 0
                var bestDiff = 1000000
                var fi = 0
                while (fi < len(fns)) {
                    var fixed = 0
                    for (p in fns[fi].params) {
                        if (!p.rest) {
                            fixed = fixed + 1
                        }
                    }
                    let d = absDiffInt(fixed, nsa)
                    if (d < bestDiff) {
                        bestDiff = d
                        bestI = fi
                    }
                    fi = fi + 1
                }
                let first = fns[bestI]
                if (len(first.generics) > 0) {
                    // A generic function called without explicit type
                    // arguments: infer them from the arguments.
                    if (let some(t) = inferGenericCall(ck, e, first, args)) {
                        if (let some(flags) = ck.manualParamFns.get(cname)) {
                            checkManualArgs(ck, flags, args)
                        }
                        if (listHasStr(ck.manualRetFns, cname)) {
                            if (!hasSpan(ck.pendingOwnedCalls, e.span)) {
                                ck.pendingOwnedCalls.push(e.span)
                            }
                        }
                        return t
                    }
                    return Ty.Unknown
                }
                checkArgsInfo(ck, e, first.params, args)
                if (let some(flags) = ck.manualParamFns.get(cname)) {
                    checkManualArgs(ck, flags, args)
                }
                if (listHasStr(ck.manualRetFns, cname)) {
                    if (!hasSpan(ck.pendingOwnedCalls, e.span)) {
                        ck.pendingOwnedCalls.push(e.span)
                    }
                }
                var retEmpty = match (first.ret) {
                    case Ty.Empty -> true
                    case _ -> false
                }
                if (first.isAsync && (len(first.generics) == 0) && !retEmpty) {
                    // Calling an `async fn` does not run the body: it returns a
                    // captured 0-arg function (the future) typed `() -> R`,
                    // which `await` drives.
                    return Ty.Fn(emptyTyList(), first.ret)
                }
                return first.ret
            }
        }
        let ct = checkExpr(ck, callee)
        match (ct) {
            case Ty.Fn(params, ret) -> {
                checkArgs(ck, e, params, args)
                ret
            }
            case Ty.Unknown -> Ty.Unknown
            case _ -> {
                errNote(ck, e.span, "attempt to call a non-function value of type `{bareName(ct)}`", "only functions and type constructors can be called")
                Ty.Unknown
            }
        }
}

fn checkView(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        if (ck.unsafeDepth == 0) {
            err(ck, e.span, "view may only be used inside an `unsafe` block")
        }
        if (len(args) != 1) {
            err(ck, e.span, "`view(obj)` takes one argument")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Ptr(Ty.Int)
        }
        let ot = checkExpr(ck, args[0].value)
        let supported = match (ot) {
            case Ty.String -> true
            case Ty.List(_) -> true
            case Ty.Map(_, _) -> true
            case Ty.Tuple(_) -> true
            case Ty.Class(_, _) -> true
            case Ty.Struct(_, _) -> true
            case Ty.Enum(_, _) -> true
            case Ty.Interface(_, _) -> true
            case Ty.Option(_) -> true
            case Ty.Range(_) -> true
            case Ty.Stream -> true
            case _ -> false
        }
        if (!supported) {
            err(ck, args[0].value.span, "`view` needs a managed value; `{bareName(ot)}` has no object bytes")
            return Ty.Ptr(Ty.Int)
        }
        return Ty.Ptr(Ty.Int)
}

fn checkRawBuiltin(ck: Checker, e: Expr, name: string, args: List<CallArg>) -> Ty {
        if (ck.unsafeDepth == 0) {
            err(ck, e.span, "`{name}` may only be used inside an `unsafe` block")
        }
        if (name == "alloc") {
            if (len(args) != 2) {
                err(ck, e.span, "`alloc(T, count)` takes two arguments")
                for (a in args) {
                    let _ = checkExpr(ck, a.value)
                }
                return Ty.Unknown
            }
            let tyArg = args[0]
            let countArg = args[1]
            let tyIsIdent = match (tyArg.value.kind) {
                case ExprKind.Ident(_) -> true
                case _ -> false
            }
            if (!tyIsIdent) {
                err(ck, tyArg.value.span, "`alloc` element type must be a type name")
                let _ = checkExpr(ck, countArg.value)
                return Ty.Unknown
            }
            let tyName = match (tyArg.value.kind) {
                case ExprKind.Ident(n) -> n
                case _ -> ""
            }
            let wrapped = TypeExpr(tyArg.value.span, TypeExprKind.Path([tyName]))
            let inner = resolvedFnTy(ck, wrapped, emptyStrList())
            ck.types[spanKey(tyArg.value.span)] = inner
            var scalarOk = false
            match (inner) {
                case Ty.Int -> scalarOk = true
                case Ty.Float -> scalarOk = true
                case Ty.Bool -> scalarOk = true
                case Ty.Char -> scalarOk = true
                case _ -> {}
            }
            if (!scalarOk) {
                err(ck, tyArg.value.span, "`alloc` currently only supports scalar element types (int, float, bool, char), found `{bareName(inner)}`")
                let _ = checkExpr(ck, countArg.value)
                return Ty.Unknown
            }
            let ct = checkExpr(ck, countArg.value)
            if (ct != Ty.Unknown && ct != Ty.Int) {
                err(ck, countArg.value.span, "`alloc` count must be an `int`")
            }
            return Ty.Ptr(inner)
        }
        // free(p)
        if (len(args) != 1) {
            err(ck, e.span, "`free(p)` takes one argument")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Empty
        }
        let p = args[0].value
        let at = checkExpr(ck, p)
        match (at) {
            case Ty.Ptr(_) -> {}
            case other -> {
                err(ck, p.span, "`free` expects a pointer argument, found `{bareName(other)}`")
            }
        }
        Ty.Empty
}

fn checkAssert(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) == 0 || len(args) > 2) {
            err(ck, e.span, "`assert(cond, msg?)` takes a condition and an optional message")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Empty
        }
        let cond = checkExpr(ck, args[0].value)
        checkAssignable(ck, Ty.Bool, cond, args[0].value.span, "assert condition")
        if (len(args) > 1) {
            let mt = checkExpr(ck, args[1].value)
            checkAssignable(ck, Ty.String, mt, args[1].value.span, "assert message")
        }
        Ty.Empty
}

fn checkExpect(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            err(ck, e.span, "`expect(value)` takes exactly one value")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        checkExpr(ck, args[0].value)
}

fn expectChainDepth(ck: Checker, e: Expr) -> int {
        match (e.kind) {
            case ExprKind.Call(callee, args) -> {
                if (len(args) == 1 && !args[0].spread && isNoneStr(args[0].name)) {
                    match (callee.kind) {
                        case ExprKind.Ident(n) -> {
                            if (n == "expect") {
                                return 1
                            }
                        }
                        case _ -> {}
                    }
                }
                if (len(args) == 0) {
                    match (callee.kind) {
                        case ExprKind.Member(object, name) -> {
                            if (name == "not") {
                                let d = expectChainDepth(ck, object)
                                if (d > 0) {
                                    return d + 1
                                }
                            }
                        }
                        case _ -> {}
                    }
                }
                0
            }
            case _ -> 0
        }
}

fn expectSource(ck: Checker, e: Expr) -> Expr? {
        match (e.kind) {
            case ExprKind.Call(callee, args) -> {
                if (len(args) == 1 && !args[0].spread && isNoneStr(args[0].name)) {
                    match (callee.kind) {
                        case ExprKind.Ident(n) -> {
                            if (n == "expect") {
                                return args[0].value
                            }
                        }
                        case _ -> {}
                    }
                    return none
                }
                if (len(args) == 0) {
                    match (callee.kind) {
                        case ExprKind.Member(object, name) -> {
                            if (name == "not") {
                                return expectSource(ck, object)
                            }
                        }
                        case _ -> {}
                    }
                }
                none
            }
            case _ -> none
        }
}

fn checkExpectMethod(ck: Checker, e: Expr, src: Expr, method: string, args: List<CallArg>) -> Ty {
        for (a in args) {
            if (a.spread) {
                err(ck, a.span, "spread arguments are not supported in an expectation")
                return Ty.Empty
            }
            if (!isNoneStr(a.name)) {
                err(ck, a.span, "named arguments are not supported in an expectation")
                return Ty.Empty
            }
        }
        let vt = checkExpr(ck, src)
        let vtNum = match (vt) {
            case Ty.Int -> true
            case Ty.Float -> true
            case _ -> false
        }
        if (method == "toBe" || method == "toEqual") {
            if (len(args) != 1) {
                err(ck, e.span, "`.{method}(expected)` takes one argument")
                for (a in args) {
                    let _ = checkExpr(ck, a.value)
                }
                return Ty.Empty
            }
            let at = checkExpr(ck, args[0].value)
            let atNum = match (at) {
                case Ty.Int -> true
                case Ty.Float -> true
                case _ -> false
            }
            // Cross-numeric (`int` vs `float`) compares are allowed.
            if (!(vtNum && atNum)) {
                checkAssignable(ck, vt, at, args[0].value.span, "expectation argument")
            }
        } else if (method == "toBeTruthy" || method == "toBeFalsy" || method == "toBeNull" || method == "toExist") {
            if (len(args) > 0) {
                err(ck, e.span, "`.{method}()` takes no arguments")
                for (a in args) {
                    let _ = checkExpr(ck, a.value)
                }
            }
        } else if (method == "toHaveLength") {
            if (len(args) != 1) {
                err(ck, e.span, "`.toHaveLength(n)` takes one argument")
                for (a in args) {
                    let _ = checkExpr(ck, a.value)
                }
                return Ty.Empty
            }
            match (vt) {
                case Ty.String -> {}
                case Ty.List(_) -> {}
                case Ty.Map(_, _) -> {}
                case Ty.Unknown -> {}
                case other -> {
                    err(ck, src.span, "`.toHaveLength()` needs a string, list, or map value, found `{bareName(other)}`")
                }
            }
            let lt = checkExpr(ck, args[0].value)
            checkAssignable(ck, Ty.Int, lt, args[0].value.span, "`.toHaveLength()` argument")
        } else if (method == "toContain") {
            if (len(args) != 1) {
                err(ck, e.span, "`.toContain(value)` takes one argument")
                for (a in args) {
                    let _ = checkExpr(ck, a.value)
                }
                return Ty.Empty
            }
            let at = checkExpr(ck, args[0].value)
            match (vt) {
                case Ty.String -> checkAssignable(ck, Ty.String, at, args[0].value.span, "`.toContain()` argument")
                case Ty.List(inner) -> checkAssignable(ck, inner, at, args[0].value.span, "`.toContain()` argument")
                case Ty.Map(k, _) -> checkAssignable(ck, k, at, args[0].value.span, "`.toContain()` argument")
                case Ty.Unknown -> {}
                case other -> {
                    err(ck, src.span, "`.toContain()` needs a string, list, or map value, found `{bareName(other)}`")
                }
            }
        } else if (method == "toBeGreaterThan" || method == "toBeLessThan") {
            if (len(args) != 1) {
                err(ck, e.span, "`.{method}(n)` takes one argument")
                for (a in args) {
                    let _ = checkExpr(ck, a.value)
                }
                return Ty.Empty
            }
            match (vt) {
                case Ty.Int -> {}
                case Ty.Float -> {}
                case Ty.Unknown -> {}
                case other -> {
                    err(ck, src.span, "`.{method}()` needs a numeric value, found `{bareName(other)}`")
                }
            }
            let at = checkExpr(ck, args[0].value)
            let atNum2 = match (at) {
                case Ty.Int -> true
                case Ty.Float -> true
                case Ty.Unknown -> true
                case _ -> false
            }
            if (!atNum2) {
                err(ck, args[0].value.span, "`.{method}()` argument must be numeric, found `{bareName(at)}`")
            }
        } else {
            err(ck, e.span, "unknown expectation method `.{method}()`")
        }
        Ty.Empty
}

fn checkFree(ck: Checker, e: Expr, name: string, args: List<CallArg>) -> Ty {
        for (a in args) {
            err(ck, a.span, "`free()` takes no arguments")
            let _ = checkExpr(ck, a.value)
        }
        if (isFreed(ck, name)) {
            err(ck, e.span, "`{name}` was already freed")
            return Ty.Empty
        }
        markFreed(ck, name)
        Ty.Empty
}

fn checkArgs(ck: Checker, e: Expr, params: List<Ty>, args: List<CallArg>) {
        var position = 0
        let fixed = len(params)
        for (a in args) {
            if (!isNoneStr(a.name)) {
                var an = ""
                if (let some(s) = a.name) {
                    an = s
                }
                errNote(ck, a.span, "named argument `" + an + "` is not supported for this call", "positional arguments are expected here")
                let _ = checkExpr(ck, a.value)
                position = position + 1
                continue
            }
            if (a.spread) {
                let _ = checkExpr(ck, a.value)
                position = position + 1
                continue
            }
            if (position < fixed) {
                let want = params[position]
                let got = checkExpr(ck, a.value)
                checkAssignable(ck, want, got, a.span, "argument")
            } else {
                let _ = checkExpr(ck, a.value)
                err(ck, e.span, "too many arguments in call")
            }
            position = position + 1
        }
        if (position < fixed) {
            err(ck, e.span, "expected {fixed} argument(s), found {position}")
        }
}

fn inferGenericCall(ck: Checker, e: Expr, f: CallableInfo, args: List<CallArg>) -> Ty? {
        var map: Map<string, Ty> = emptyMapStrTy()
        var got: Map<string, Ty> = emptyMapStrTy()
        var position = 0
        for (a in args) {
            let t = checkExpr(ck, a.value)
            got[spanKey(a.value.span)] = t
            if (isNoneStr(a.name) && !a.spread) {
                if (position < len(f.params)) {
                    inferFrom(f.params[position].ty, t, map)
                }
            }
            position = position + 1
        }
        var missing = emptyStrList()
        for (g in f.generics) {
            if (!map.has(g)) {
                missing.push(g)
            }
        }
        if (len(missing) > 0) {
            var plural = ""
            if (len(missing) != 1) {
                plural = "s"
            }
            var names = ""
            var mi = 0
            while (mi < len(missing)) {
                if (mi > 0) {
                    names = "{names}, "
                }
                names = "{names}`{missing[mi]}`"
                mi = mi + 1
            }
            err(ck, e.span, "cannot infer the type argument{plural} {names} for `{f.name}`; specify them explicitly like `{f.name}<...>(...)`")
            return none
        }
        var params = emptyTyList()
        for (p in f.params) {
            params.push(subst(p.ty, map))
        }
        checkArgsTyped(ck, e, params, args, got)
        var ret = subst(f.ret, map)
        // Calling an inferred `async fn` returns the future, not the body's
        // result: the future is a captured zero-argument function `() -> R`.
        if (f.isAsync) {
            ret = Ty.Fn(emptyTyList(), ret)
        }
        ret
}

fn checkArgsTyped(ck: Checker, e: Expr, params: List<Ty>, args: List<CallArg>, got: Map<string, Ty>) {
        var position = 0
        let fixed = len(params)
        for (a in args) {
            if (!isNoneStr(a.name)) {
                var an = ""
                if (let some(s) = a.name) {
                    an = s
                }
                errNote(ck, a.span, "named argument `" + an + "` is not supported for this call", "positional arguments are expected here")
                position = position + 1
                continue
            }
            if (a.spread) {
                position = position + 1
                continue
            }
            if (position < fixed) {
                let want = params[position]
                let gotTy = if (let some(t) = got.get(spanKey(a.value.span))) {
                    t
                } else {
                    Ty.Unknown
                }
                checkAssignable(ck, want, gotTy, a.span, "argument")
            } else {
                err(ck, e.span, "too many arguments in call")
            }
            position = position + 1
        }
        if (position < fixed) {
            err(ck, e.span, "expected {fixed} argument(s), found {position}")
        }
}

fn checkArgsInfo(ck: Checker, e: Expr, params: List<ParamInfo>, args: List<CallArg>) {
        var restTy: Ty? = none
        var pi = len(params) - 1
        while (pi >= 0) {
            if (params[pi].rest) {
                restTy = params[pi].ty
                break
            }
            pi = pi - 1
        }
        var fixed = 0
        for (p in params) {
            if (!p.rest) {
                fixed = fixed + 1
            }
        }
        var position = 0
        for (a in args) {
            if (!isNoneStr(a.name)) {
                var an = ""
                if (let some(s) = a.name) {
                    an = s
                }
                errNote(ck, a.span, "named argument `" + an + "` is not supported for this call", "positional arguments are expected here")
                let _ = checkExpr(ck, a.value)
                position = position + 1
                continue
            }
            if (a.spread) {
                let _ = checkExpr(ck, a.value)
                position = position + 1
                continue
            }
            if (position < fixed) {
                let want = params[position].ty
                let got = checkExpr(ck, a.value)
                checkAssignable(ck, want, got, a.span, "argument")
            } else if (let some(rt) = restTy) {
                let got = checkExpr(ck, a.value)
                checkAssignable(ck, rt, got, a.span, "argument")
            } else {
                let _ = checkExpr(ck, a.value)
                err(ck, e.span, "too many arguments in call")
            }
            position = position + 1
        }
        if (position < fixed) {
            var allNamed = true
            for (a in args) {
                if (isNoneStr(a.name)) {
                    allNamed = false
                }
            }
            if (allNamed) {
                var joined = ""
                var plural = ""
                var missCount = 0
                var mj = position
                while (mj < fixed) {
                    if (missCount > 0) {
                        joined = joined + ", "
                    }
                    joined = joined + "`" + params[mj].name + "`"
                    missCount = missCount + 1
                    mj = mj + 1
                }
                if (missCount != 1) {
                    plural = "s"
                }
                errNote(ck, e.span, "missing argument" + plural + " for parameter" + plural + " `" + joined + "`", "all required parameters must be supplied")
            }
        }
}

fn checkMember(ck: Checker, e: Expr, object: Expr, name: string) -> Ty {
        // Type-qualified static access: `Foo.bar`.
        let objIsIdent = match (object.kind) {
            case ExprKind.Ident(_) -> true
            case _ -> false
        }
        if (objIsIdent) {
            let tname = match (object.kind) {
                case ExprKind.Ident(n) -> n
                case _ -> ""
            }
            if (let some(entry) = ck.resolved.types.get(tname)) {
                let gname = entryName(entry)
                if (let some(f) = findField(ck, gname, name, emptyMapStrTy())) {
                    if (!f.isStatic) {
                        err(ck, e.span, "instance field `{name}` must be accessed on an instance of `{gname}`")
                        return Ty.Unknown
                    }
                    return subst(f.ty, emptyMapStrTy())
                }
                if (let some(p) = findProperty(ck, gname, name)) {
                    if (!p.isStatic) {
                        err(ck, e.span, "instance property `{name}` must be accessed on an instance of `{gname}`")
                        return Ty.Unknown
                    }
                    return p.ty
                }
                if (let some(m) = findMethod(ck, gname, name)) {
                    var mps = emptyTyList()
                    for (mp in m.params) {
                        mps.push(mp.ty)
                    }
                    return Ty.Fn(mps, methodRetTy(ck, m, emptyMapStrTy()))
                }
                if (let some(nc) = findNamedCtor(ck, gname, name)) {
                    let ret = match (entry) {
                        case TypeTableEntry.Class(c) -> Ty.Class(c.name, tyVars(c.generics))
                        case TypeTableEntry.Struct(s) -> Ty.Struct(s.name, tyVars(s.generics))
                        case _ -> Ty.Unknown
                    }
                    var nps = emptyTyList()
                    for (np in nc.params) {
                        nps.push(np.ty)
                    }
                    return Ty.Fn(nps, ret)
                }
                // Bare enum variant access: `Color.Red` when the variant has
                // no payload fields.
                match (entry) {
                    case TypeTableEntry.Enum(t) -> {
                        for (v in t.variants) {
                            if (v.name == name) {
                                if (len(v.fields) == 0) {
                                    return Ty.Enum(t.name, emptyTys())
                                }
                                err(ck, e.span, "variant `{name}` carries {len(v.fields)} payload field(s); use `{name}(...)`")
                                return Ty.Unknown
                            }
                        }
                    }
                    case _ -> {}
                }
                err(ck, e.span, "no member `{name}` on type `{tname}`")
                return Ty.Unknown
            }
        }
        let ot0 = checkExpr(ck, object)
        // Member access through a raw pointer (`p.field`) auto-dereferences
        // and needs `unsafe`; through an immutable `&T` borrow it is a safe
        // read.
        var ot = ot0
        match (ot0) {
            case Ty.Ptr(inner) -> {
                if (ck.unsafeDepth == 0) {
                    err(ck, e.span, "pointer access may only be used inside an `unsafe` block")
                }
                ot = inner
            }
            case Ty.Ref(inner) -> {
                ot = inner
            }
            case _ -> {}
        }
        match (ot) {
            case Ty.List(inner) -> {
                // Builtin list methods (slice subset).
                if (name == "push") {
                    return Ty.Fn([inner], Ty.Empty)
                }
                if (name == "pop") {
                    return Ty.Fn(emptyTyList(), inner)
                }
                if (name == "remove") {
                    return Ty.Fn([Ty.Int], inner)
                }
                if (name == "insert") {
                    var ips = emptyTyList()
                    ips.push(Ty.Int)
                    ips.push(inner)
                    return Ty.Fn(ips, Ty.Empty)
                }
                if (name == "sort" && isListSortable(inner)) {
                    return Ty.Fn(emptyTyList(), Ty.Empty)
                }
                if (name == "sort") {
                    err(ck, e.span, "`sort` needs a `List` of int, float, byte, char, bool, or string (got `List<{bareName(inner)}>`)")
                    return Ty.Unknown
                }
                err(ck, e.span, "no member `{name}` on `List<{bareName(inner)}>`")
                return Ty.Unknown
            }
            case Ty.Map(k, v) -> {
                // Builtin map methods (slice subset).
                if (name == "has") {
                    return Ty.Fn([k], Ty.Bool)
                }
                if (name == "get") {
                    return Ty.Fn([k], optOf(v))
                }
                if (name == "remove") {
                    return Ty.Fn([k], optOf(v))
                }
                if (name == "keys") {
                    return Ty.Fn(emptyTyList(), Ty.List(k))
                }
                if (name == "values") {
                    return Ty.Fn(emptyTyList(), Ty.List(v))
                }
                err(ck, e.span, "no member `{name}` on `Map<{bareName(k)}, {bareName(v)}>`")
                return Ty.Unknown
            }
            case Ty.Stream -> {
                // Builtin stream methods (buffered I/O).
                if (name == "read") {
                    var rps = [Ty.Int]
                    return Ty.Fn(rps, Ty.Option(Ty.List(Ty.Byte)))
                }
                if (name == "write") {
                    var wps = [Ty.List(Ty.Byte)]
                    return Ty.Fn(wps, Ty.Int)
                }
                if (name == "flush") {
                    return Ty.Fn(emptyTyList(), Ty.Bool)
                }
                if (name == "close") {
                    return Ty.Fn(emptyTyList(), Ty.Bool)
                }
                err(ck, e.span, "no member `{name}` on `Stream` (members are `read`, `write`, `flush`, `close`)")
                return Ty.Unknown
            }
            case Ty.Interface(iface, iargs) -> {
                // Interface members type calls on interface-typed receivers.
                var imap: Map<string, Ty> = emptyMapStrTy()
                if (let some(entry) = ck.resolved.types.get(iface)) {
                    match (entry) {
                        case TypeTableEntry.Interface(it) -> {
                            var ii = 0
                            while (ii < len(it.generics)) {
                                if (ii < len(iargs)) {
                                    imap[it.generics[ii]] = iargs[ii]
                                } else {
                                    imap[it.generics[ii]] = Ty.Unknown
                                }
                                ii = ii + 1
                            }
                        }
                        case _ -> {}
                    }
                }
                var chain = [iface]
                var seen = emptyStrList()
                while (len(chain) > 0) {
                    let iname = chain[len(chain) - 1]
                    chain.pop()
                    if (listHasStr(seen, iname)) {
                        continue
                    }
                    seen.push(iname)
                    if (let none = ck.resolved.types.get(iname)) {
                        continue
                    }
                    if (let some(entEntry) = ck.resolved.types.get(iname)) {
                        match (entEntry) {
                            case TypeTableEntry.Interface(ent) -> {
                                var foundMethod = false
                                for (mem in ent.members) {
                                    if (mem.name == name) {
                                        if (mem.isProperty) {
                                            errNote(ck, e.span, "property `{name}` on interface `{iface}`", "interface property access is not lowered yet (interface methods are); use the interface's methods")
                                            return Ty.Unknown
                                        }
                                        var mps = emptyTyList()
                                        for (mp in mem.params) {
                                            mps.push(subst(mp.ty, imap))
                                        }
                                        return Ty.Fn(mps, subst(mem.ty, imap))
                                    }
                                }
                                for (ext in ent.extends) {
                                    if (let some(n) = named(ext)) {
                                        chain.push(n)
                                    }
                                }
                            }
                            case _ -> {}
                        }
                    }
                }
                errNote(ck, e.span, "no member `{name}` on interface `{iface}`", "an interface declares method signatures; check the spelling")
                return Ty.Unknown
            }
            case _ -> {}
        }
        if (let none = typeKey(ck, ot)) {
            errNote(ck, e.span, "cannot access member `{name}` on value of type `{bareName(ot)}`", "member access requires a class, struct, enum, or interface value")
            return Ty.Unknown
        }
        if (let some(tk) = typeKey(ck, ot)) {
            if (let some(f) = findField(ck, tk.name, name, tk.args)) {
                if (f.isStatic) {
                    err(ck, e.span, "static field `{name}` must be accessed on the type `{tk.name}`, not on an instance")
                    return Ty.Unknown
                }
                return subst(f.ty, tk.args)
            }
            if (let some(p) = findProperty(ck, tk.name, name)) {
                if (p.isStatic) {
                    err(ck, e.span, "static property `{name}` must be accessed on the type `{tk.name}`, not on an instance")
                    return Ty.Unknown
                }
                return subst(p.ty, tk.args)
            }
            if (let some(m) = findMethod(ck, tk.name, name)) {
                var mps = emptyTyList()
                for (mp in m.params) {
                    mps.push(subst(mp.ty, tk.args))
                }
                return Ty.Fn(mps, methodRetTy(ck, m, tk.args))
            }
            errNote(ck, e.span, "no member `{name}` on `{tk.name}`", "`{tk.name}` defines fields, properties, and methods; check the spelling")
            return Ty.Unknown
        }
        Ty.Unknown
}

fn checkOptAccess(ck: Checker, e: Expr, object: Expr, name: string) -> Ty {
        let ot = checkExpr(ck, object)
        if (let none = innerOption(ot)) {
            errNote(ck, e.span, "`?.` on a non-option value of type `{bareName(ot)}`", "optional chaining requires an `Option` receiver")
            return Ty.Unknown
        }
        let inner = if (let some(x) = innerOption(ot)) { x } else { Ty.Unknown }
        if (let some(tk) = typeKey(ck, inner)) {
            if (let some(f) = findField(ck, tk.name, name, tk.args)) {
                return optOf(subst(f.ty, tk.args))
            }
            if (let some(p) = findProperty(ck, tk.name, name)) {
                return optOf(subst(p.ty, tk.args))
            }
            if (let some(m) = findMethod(ck, tk.name, name)) {
                var mps = emptyTyList()
                for (mp in m.params) {
                    mps.push(subst(mp.ty, tk.args))
                }
                return optOf(Ty.Fn(mps, methodRetTy(ck, m, tk.args)))
            }
            err(ck, e.span, "no member `{name}` on `{tk.name}`")
            return Ty.Unknown
        }
        Ty.Unknown
}

fn checkOptUnwrap(ck: Checker, e: Expr, inner: Expr) -> Ty {
        let t = checkExpr(ck, inner)
        if (let some(innerT) = innerOption(t)) {
            innerT
        } else {
            errNote(ck, e.span, "`?` cannot unwrap non-option value of type `{bareName(t)}`", "only `Option` values may be unwrapped")
            t
        }
}

fn checkMapIndex(ck: Checker, keyTy: Ty, indexTy: Ty, index: Expr, span: Span) {
        if (indexTy == Ty.Unknown) {
            return
        }
        if (keyTy == Ty.Byte) {
            checkAssignRhs(ck, keyTy, indexTy, index, span, "map index")
            return
        }
        if (!okTypes(ck, keyTy, indexTy)) {
            err(ck, span, "map index must be a `{bareName(keyTy)}`")
        }
}

fn checkIndex(ck: Checker, e: Expr, object: Expr, index: Expr) -> Ty {
        let ot0 = checkExpr(ck, object)
        let it = checkExpr(ck, index)
        // Indexing through an immutable `&T` borrow reads through the
        // referent: a collection/string referent is indexed exactly like the
        // value itself, a scalar referent is addressed like a pointer element.
        var ot = ot0
        match (ot0) {
            case Ty.Ref(inner) -> {
                match (inner) {
                    case Ty.Int -> {}
                    case Ty.Float -> {}
                    case Ty.Bool -> {}
                    case Ty.Char -> {}
                    case _ -> {
                        ot = inner
                    }
                }
            }
            case _ -> {}
        }
        match (ot) {
            case Ty.List(_) -> {
                if (it != Ty.Unknown && it != Ty.Int) {
                    err(ck, e.span, "index must be an `int`")
                }
                if (let some(el) = elem(ot)) {
                    el
                } else {
                    Ty.Unknown
                }
            }
            case Ty.Range(_) -> {
                if (it != Ty.Unknown && it != Ty.Int) {
                    err(ck, e.span, "index must be an `int`")
                }
                if (let some(el) = elem(ot)) {
                    el
                } else {
                    Ty.Unknown
                }
            }
            case Ty.Map(keyTy, valTy) -> {
                checkMapIndex(ck, keyTy, it, index, e.span)
                valTy
            }
            case Ty.String -> {
                if (it != Ty.Unknown && it != Ty.Int) {
                    err(ck, e.span, "string index must be an `int`")
                }
                Ty.Byte
            }
            case Ty.Tuple(items) -> Ty.Tuple(items)
            case Ty.Ptr(inner) -> {
                if (it != Ty.Unknown && it != Ty.Int) {
                    err(ck, e.span, "pointer index must be an `int`")
                }
                if (ck.unsafeDepth == 0) {
                    err(ck, e.span, "pointer indexing may only be used inside an `unsafe` block")
                }
                var scalarP = false
                match (inner) {
                    case Ty.Int -> scalarP = true
                    case Ty.Float -> scalarP = true
                    case Ty.Bool -> scalarP = true
                    case Ty.Char -> scalarP = true
                    case Ty.Byte -> scalarP = true
                    case _ -> {}
                }
                if (scalarP) {
                    inner
                } else {
                    err(ck, e.span, "indexing a pointer to a `{bareName(inner)}` value is not supported yet")
                    Ty.Unknown
                }
            }
            // Indexing through an immutable `&T` borrow reads the referent
            // (safe; no `unsafe` needed). Non-scalar referents were
            // dereferenced above, so only scalar referents reach here.
            case Ty.Ref(inner) -> {
                if (it != Ty.Unknown && it != Ty.Int) {
                    err(ck, e.span, "pointer index must be an `int`")
                }
                inner
            }
            case Ty.Unknown -> Ty.Unknown
            case other -> {
                err(ck, e.span, "cannot index a value of type `{bareName(other)}`")
                Ty.Unknown
            }
        }
}

fn checkBinary(ck: Checker, e: Expr, op: BinOp, lhs: Expr, rhs: Expr) -> Ty {
        let lt = checkExpr(ck, lhs)
        let rt = checkExpr(ck, rhs)
        if (op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div || op == BinOp.Mod || op == BinOp.Pow) {
            if (lt != Ty.Unknown && rt != Ty.Unknown) {
                if (!(isNumeric(lt) && isNumeric(rt)) && !(op == BinOp.Add && lt == Ty.String && rt == Ty.String)) {
                    errNote(ck, e.span, "operator `" + binOpName(op) + "` requires numeric or string operands, found `" + bareName(lt) + "` and `" + bareName(rt) + "`", "`+` concatenates strings; arithmetic operators need numbers")
                }
            }
            if (lt == Ty.Float || rt == Ty.Float) {
                Ty.Float
            } else if (op == BinOp.Add && (lt == Ty.String || rt == Ty.String)) {
                Ty.String
            } else {
                Ty.Int
            }
        } else if (op == BinOp.Shl || op == BinOp.Shr || op == BinOp.BitAnd || op == BinOp.BitOr || op == BinOp.BitXor) {
            if (lt != Ty.Unknown && lt != Ty.Int) {
                err(ck, e.span, "bitwise operators require `int` operands")
            }
            Ty.Int
        } else if (op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Le || op == BinOp.Gt || op == BinOp.Ge) {
            checkComparison(ck, e, op, lt, rt)
            Ty.Bool
        } else if (op == BinOp.And || op == BinOp.Or) {
            // `lt`/`rt` are already `checkExpr(lhs)`/`checkExpr(rhs)`. Calling
            // `checkBoolCond` here would re-walk both operands, which doubles
            // the work at every level of a left-leaning `a || b || c` chain
            // (T(n) = 2*T(n-1), i.e. exponential) and re-emits any diagnostic
            // the operands already produced.
            if (lt != Ty.Unknown && lt != Ty.Bool) {
                errNote(ck, lhs.span, "condition must be a `bool`", "found `{bareName(lt)}`")
            }
            if (rt != Ty.Unknown && rt != Ty.Bool) {
                errNote(ck, rhs.span, "condition must be a `bool`", "found `{bareName(rt)}`")
            }
            Ty.Bool
        } else if (op == BinOp.Range || op == BinOp.RangeIncl) {
            Ty.Range(lt)
        } else if (op == BinOp.NullCoalesce) {
            if (let some(innerT) = innerOption(lt)) {
                if (rt != Ty.Unknown) {
                    checkAssignable(ck, innerT, rt, rhs.span, "`??` default")
                }
                innerT
            } else {
                errNote(ck, e.span, "left side of `??` is not an `Option`", "`a ?? b` yields `a` when present, else `b`")
                lt
            }
        } else if (op == BinOp.Send) {
            // `channel <- value` sends and yields no value. Mirrors check.rs.
            Ty.Empty
        } else if (op == BinOp.Is) {
            Ty.Bool
        } else {
            // In
            var container = false
            match (rt) {
                case Ty.List(_) -> container = true
                case Ty.Map(_, _) -> container = true
                case Ty.String -> container = true
                case _ -> {}
            }
            if (rt != Ty.Unknown && !container) {
                errNote(ck, e.span, "right side of `in` must be a `List`, `Map`, or `string`", "found `" + bareName(rt) + "`")
            }
            Ty.Bool
        }
}

fn checkComparison(ck: Checker, e: Expr, op: BinOp, lt: Ty, rt: Ty) {
        if (lt == Ty.Unknown || rt == Ty.Unknown || hasVar(lt) || hasVar(rt)) {
            return
        }
        let eqOnly = op == BinOp.Eq || op == BinOp.Ne
        let scalar = (isNumeric(lt) && isNumeric(rt)) || (lt == Ty.Char && rt == Ty.Char)
        if (scalar) {
            return
        }
        let byteChar = (lt == Ty.Byte && rt == Ty.Char) || (lt == Ty.Char && rt == Ty.Byte)
        if (byteChar) {
            var charPart: Expr? = none
            match (e.kind) {
                case ExprKind.Binary(_op2, lhs, rhs) -> {
                    if (lt == Ty.Byte) {
                        charPart = rhs
                    } else if (rt == Ty.Byte) {
                        charPart = lhs
                    } else {
                        err(ck, e.span, "`byte` values only compare with `int`s or an ASCII `char` literal")
                        return
                    }
                }
                case _ -> {
                    err(ck, e.span, "`byte` values only compare with `int`s or an ASCII `char` literal")
                    return
                }
            }
            if (let some(cp) = charPart) {
                match (cp.kind) {
                    case ExprKind.Lit(lit) -> {
                        match (lit) {
                            case Lit.Char(c) -> {
                                if ((c as int) <= 0x7F) {
                                    return
                                }
                                err(ck, e.span, "a non-ASCII char literal has no `byte` value: `{c}` (its bytes are multi-byte UTF-8)")
                            }
                            case _ -> {
                                err(ck, e.span, "`byte` values only compare with `int`s or an ASCII `char` literal")
                            }
                        }
                    }
                    case _ -> {
                        err(ck, e.span, "`byte` values only compare with `int`s or an ASCII `char` literal")
                    }
                }
            }
            return
        }
        if (eqOnly && tyEq(lt, rt)) {
            return // identity/equality on identical types (strings, enums, ...)
        }
        if (tyEq(lt, rt)) {
            err(ck, e.span, "operator `" + binOpName(op) + "` is not supported for `" + bareName(lt) + "` operands")
        } else {
            err(ck, e.span, "operator `" + binOpName(op) + "` requires comparable operands, found `" + bareName(lt) + "` and `" + bareName(rt) + "`")
        }
}

fn checkUnary(ck: Checker, e: Expr, op: UnOp, operand: Expr) -> Ty {
        let t = checkExpr(ck, operand)
        if (op == UnOp.Neg) {
            if (t != Ty.Unknown && !isNumeric(t)) {
                err(ck, e.span, "unary `-` requires a numeric operand, found `{bareName(t)}`")
            }
            t
        } else if (op == UnOp.Not) {
            if (t != Ty.Unknown && t != Ty.Bool) {
                err(ck, e.span, "unary `!` requires a `bool` operand, found `{bareName(t)}`")
            }
            Ty.Bool
        } else if (op == UnOp.BitNot) {
            if (t != Ty.Unknown && t != Ty.Int) {
                err(ck, e.span, "unary `~` requires an `int` operand, found `{bareName(t)}`")
            }
            Ty.Int
        } else if (op == UnOp.AddrOf) {
            if (ck.unsafeDepth == 0) {
                err(ck, e.span, "`&` may only be used inside an `unsafe` block")
            }
            match (t) {
                case Ty.Class(_, _) -> Ty.Ptr(t)
                case Ty.Struct(_, _) -> Ty.Ptr(t)
                case Ty.Ptr(_) -> Ty.Ptr(t)
                case Ty.String -> Ty.Ptr(t)
                case Ty.Unknown -> Ty.Ptr(t)
                case Ty.Int -> Ty.Ptr(t)
                case Ty.Float -> Ty.Ptr(t)
                case Ty.Bool -> Ty.Ptr(t)
                case Ty.Char -> Ty.Ptr(t)
                case Ty.Byte -> Ty.Ptr(t)
                case other -> {
                    err(ck, e.span, "`&` currently only supports class, struct, pointer, and scalar values, found `{bareName(other)}`")
                    Ty.Unknown
                }
            }
        } else {
            // Deref
            let borrow = match (t) {
                case Ty.Ref(_) -> true
                case _ -> false
            }
            if (ck.unsafeDepth == 0 && !borrow) {
                err(ck, e.span, "`*` may only be used inside an `unsafe` block")
            }
            match (t) {
                case Ty.Ptr(inner) -> inner
                case Ty.Ref(inner) -> inner
                case Ty.Unknown -> Ty.Unknown
                case other -> {
                    errNote(ck, e.span, "cannot dereference a value of type `{bareName(other)}`", "only pointers (`*T`) and references (`&T`) can be dereferenced")
                    Ty.Unknown
                }
            }
        }
}

fn checkAssign(ck: Checker, e: Expr, target: Expr, value: Expr) -> Ty {
        let vt = checkExpr(ck, value)
        let movedFrom = manualMoveSource(ck, value)
        match (target.kind) {
            case ExprKind.Ident(name) -> {
                // Lexical scope wins: a fn-local (or parameter) shadows
                // session-wide globals by name, matching both identTy (reads)
                // and the emitter (writes). `resolved.globals` spans every
                // module in the compile session, so without this ordering a
                // same-named global in an imported module would hijack
                // assignments to an unrelated local.
                if (let some(l) = lookup(ck, name)) {
                    if (!l.mutable) {
                        err(ck, target.span, "cannot assign to immutable binding `{name}`")
                    }
                    if (l.manual) {
                        errNote(ck, target.span, "cannot overwrite `#[manualAlloc]` binding `{name}`", "`free()` `{name}` first, then bind a new value with `let`")
                    } else if (let some(src) = movedFrom) {
                        errNote(ck, target.span, "cannot assign `#[manualAlloc]` value `{src}` to managed binding `{name}`", "take ownership with `#[manualAlloc] let ... = {src}`, or `{src}.free()`")
                    }
                    checkAssignable(ck, l.ty, vt, target.span, "assignment")
                    return Ty.Empty
                }
                // A top-level `var` is assignable by name from anywhere in the
                // module; there is no shadow-frame entry to consult.
                var foundGlobal = false
                for (g in ck.resolved.globals) {
                    if (g.name == name) {
                        foundGlobal = true
                        // `vt` is the type of `value` computed once above;
                        // re-checking it here would double-emit diagnostics.
                        guardRefUse(ck, g.ty, target.span, "an assignment to a top-level `var`")
                        checkAssignable(ck, g.ty, vt, target.span, "assignment to a top-level `var`")
                    }
                }
                if (foundGlobal) {
                    return Ty.Empty
                }
                // Implicit receiver field assignment: `count = x`
                // inside a class body writes `this.count`.
                if (let some(st) = ck.selfTy) {
                    if (let some(tk) = typeKey(ck, st)) {
                        if (let some(f) = findField(ck, tk.name, name, tk.args)) {
                            if (!f.mutable) {
                                err(ck, target.span, "cannot assign to immutable field `{name}`")
                            }
                            if (f.manual) {
                                consumeIntoOwned(ck, value, target.span, "owned field `{name}`")
                            } else if (let some(src) = movedFrom) {
                                errNote(ck, target.span, "cannot store `#[manualAlloc]` value `{src}` in managed field `{name}`", "an owned value must stay in an owned position")
                            }
                            checkAssignable(ck, f.ty, vt, target.span, "assignment")
                            return Ty.Empty
                        }
                    }
                }
                err(ck, target.span, "cannot assign to undeclared name `{name}`")
            }
            case ExprKind.Unary(op, operand) -> {
                if (op == UnOp.Deref) {
                    // Dereferencing a raw pointer needs `unsafe`; writing
                    // through an immutable `&T` borrow is rejected outright.
                    let pt = checkExpr(ck, operand)
                    let isBorrow = match (pt) {
                        case Ty.Ref(_) -> true
                        case _ -> false
                    }
                    if (ck.unsafeDepth == 0 && !isBorrow) {
                        err(ck, target.span, "`*` may only be used inside an `unsafe` block")
                    }
                    match (pt) {
                        case Ty.Ptr(inner) -> {
                            checkAssignable(ck, inner, vt, target.span, "assignment")
                        }
                        case Ty.Ref(_) -> {
                            err(ck, target.span, "cannot write through an immutable reference (`&T`)")
                        }
                        case Ty.Unknown -> {}
                        case other -> {
                            errNote(ck, target.span, "cannot dereference a value of type `{bareName(other)}`", "only pointers (`*T`) and references (`&T`) can be dereferenced")
                        }
                    }
                } else {
                    err(ck, target.span, "assignment target must be a variable, member, or index")
                }
            }
            case ExprKind.Member(object, name) -> {
                // Type-qualified static property assignment: `Type.prop = v`.
                let objIsIdent = match (object.kind) {
                    case ExprKind.Ident(_) -> true
                    case _ -> false
                }
                if (objIsIdent) {
                    let tname = match (object.kind) {
                        case ExprKind.Ident(n) -> n
                        case _ -> ""
                    }
                    if (let some(entry) = ck.resolved.types.get(tname)) {
                        let gname = entryName(entry)
                        if (let some(f) = findField(ck, gname, name, emptyMapStrTy())) {
                            if (!f.isStatic) {
                                err(ck, target.span, "instance field `{name}` must be assigned on an instance of `{gname}`")
                            } else if (!f.mutable) {
                                err(ck, target.span, "cannot assign to immutable static field `{name}`")
                            }
                            checkAssignable(ck, f.ty, vt, target.span, "assignment")
                            return Ty.Empty
                        }
                        if (let some(p) = findProperty(ck, gname, name)) {
                            if (!p.isStatic) {
                                err(ck, target.span, "instance property `{name}` must be assigned on an instance of `{gname}`")
                            } else if (!p.hasSet) {
                                err(ck, target.span, "static property `{name}` has no setter")
                            }
                            checkAssignable(ck, p.ty, vt, target.span, "assignment")
                            return Ty.Empty
                        }
                        err(ck, target.span, "no assignable member `{name}` on `{tname}`")
                        return Ty.Empty
                    }
                }
                let otRaw = checkExpr(ck, object)
                var ot = otRaw
                match (otRaw) {
                    case Ty.Ptr(inner) -> {
                        if (ck.unsafeDepth == 0) {
                            err(ck, target.span, "pointer access may only be used inside an `unsafe` block")
                        }
                        ot = inner
                    }
                    case Ty.Ref(_) -> {
                        err(ck, target.span, "cannot write to a field `{name}` through an immutable reference (`&T`)")
                        ot = Ty.Unknown
                    }
                    case _ -> {}
                }
                if (let some(tk) = typeKey(ck, ot)) {
                    if (let some(f) = findField(ck, tk.name, name, tk.args)) {
                        if (f.isStatic) {
                            err(ck, target.span, "static field `{name}` must be assigned on the type `{tk.name}`, not on an instance")
                        } else if (!f.mutable) {
                            err(ck, target.span, "cannot assign to immutable field `{name}`")
                        } else if (f.manual) {
                            consumeIntoOwned(ck, value, target.span, "owned field `{name}`")
                        } else if (let some(src) = movedFrom) {
                            errNote(ck, target.span, "cannot store `#[manualAlloc]` value `{src}` in managed field `{name}`", "an owned value must stay in an owned position")
                        }
                        checkAssignable(ck, f.ty, vt, target.span, "assignment")
                    } else if (let some(p) = findProperty(ck, tk.name, name)) {
                        if (!p.hasSet) {
                            err(ck, target.span, "property `{name}` has no setter")
                        }
                        checkAssignable(ck, subst(p.ty, tk.args), vt, target.span, "assignment")
                    } else {
                        err(ck, target.span, "no assignable member `{name}` on `{tk.name}`")
                    }
                } else {
                    err(ck, target.span, "cannot assign to a member of a non-class value")
                }
            }
            case ExprKind.Index(object, index) -> {
                if (let some(src) = movedFrom) {
                    errNote(ck, target.span, "cannot store `#[manualAlloc]` value `{src}` in a managed collection", "an owned value must stay in an owned position")
                }
                let otIdx = checkExpr(ck, object)
                let itIdx = checkExpr(ck, index)
                match (otIdx) {
                    case Ty.List(_) -> {
                        if (itIdx != Ty.Unknown && itIdx != Ty.Int) {
                            err(ck, target.span, "index must be an `int`")
                        }
                    }
                    case Ty.Range(_) -> {
                        if (itIdx != Ty.Unknown && itIdx != Ty.Int) {
                            err(ck, target.span, "index must be an `int`")
                        }
                    }
                    case Ty.Map(k, _) -> {
                        if (itIdx != Ty.Unknown) {
                            checkMapIndex(ck, k, itIdx, index, target.span)
                        }
                    }
                    case _ -> {}
                }
                var elemTy = Ty.Unknown
                match (otIdx) {
                    case Ty.List(inner) -> elemTy = inner
                    case Ty.Map(_, v) -> elemTy = v
                    case Ty.String -> elemTy = Ty.Byte
                    case Ty.Ptr(inner) -> {
                        if (itIdx != Ty.Unknown && itIdx != Ty.Int) {
                            err(ck, target.span, "pointer index must be an `int`")
                        }
                        if (ck.unsafeDepth == 0) {
                            err(ck, object.span, "pointer stores may only be used inside an `unsafe` block")
                        }
                        var scalarPt = false
                        match (inner) {
                            case Ty.Int -> scalarPt = true
                            case Ty.Float -> scalarPt = true
                            case Ty.Bool -> scalarPt = true
                            case Ty.Char -> scalarPt = true
                            case Ty.Byte -> scalarPt = true
                            case _ -> {}
                        }
                        if (scalarPt) {
                            elemTy = inner
                        } else {
                            err(ck, target.span, "storing through a pointer to a `{bareName(inner)}` value is not supported yet")
                            elemTy = Ty.Unknown
                        }
                    }
                    case Ty.Ref(_) -> {
                        err(ck, target.span, "cannot write through an immutable reference (`&T`)")
                        elemTy = Ty.Unknown
                    }
                    case _ -> {
                        err(ck, target.span, "index assignment target must be a List, Map, string, or pointer")
                        elemTy = Ty.Unknown
                    }
                }
                ck.types[spanKey(target.span)] = elemTy
                checkAssignRhs(ck, elemTy, vt, value, target.span, "assignment")
            }
            case _ -> {
                err(ck, target.span, "assignment target must be a variable, member, or index")
            }
        }
        let _ = e.span
        vt
}

fn checkLambda(ck: Checker, e: Expr, params: List<Param>, returnTy: TypeExpr?, isAsync: bool, body: FnBody) -> Ty {
        let _ = isAsync
        pushScope(ck)
        var paramTys = emptyTyList()
        for (p in params) {
            let pt = resolveParamTy(ck, p)
            paramTys.push(pt)
            declare(ck, p.name, pt, true)
        }
        let savedRet = ck.retTy
        var ret = Ty.Unknown
        if (let some(ty) = returnTy) {
            ck.retTy = resolvedFnTy(ck, ty, copyStrList(ck.fnGenerics))
            guardRefUse(ck, ck.retTy, e.span, "a lambda return type")
        } else {
            ck.retTy = Ty.Unknown
        }
        checkFnBody(ck, body)
        if (let some(ty) = returnTy) {
            ret = resolvedFnTy(ck, ty, copyStrList(ck.fnGenerics))
        } else {
            // No annotation: infer the return type from the body tail, exactly
            // like the emitter's pre-pass will for the hoisted function.
            match (body) {
                case FnBody.Expr(be) -> {
                    if (let some(t) = ck.types.get(spanKey(be.span))) {
                        ret = t
                    } else {
                        ret = Ty.Empty
                    }
                }
                case FnBody.Block(bb) -> {
                    if (let some(be) = bb.expr) {
                        if (let some(t) = ck.types.get(spanKey(be.span))) {
                            ret = t
                        } else {
                            ret = Ty.Empty
                        }
                    } else {
                        ret = Ty.Empty
                    }
                }
            }
        }
        ck.retTy = savedRet
        popScope(ck)
        let _ = e.span
        Ty.Fn(paramTys, ret)
}

fn checkAbs(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            err(ck, e.span, "`abs(x)` takes exactly one argument")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        let at = checkExpr(ck, args[0].value)
        match (at) {
            case Ty.Int -> at
            case Ty.Float -> at
            case Ty.Unknown -> at
            case _ -> {
                err(ck, args[0].value.span, "`abs` requires an `int` or `float` argument")
                Ty.Unknown
            }
        }
}

fn checkMinmax(ck: Checker, e: Expr, bname: string, args: List<CallArg>) -> Ty {
        if (len(args) != 2) {
            err(ck, e.span, "`{bname}(a, b)` takes exactly two arguments")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        if (!isNoneStr(args[0].name) || args[0].spread || !isNoneStr(args[1].name) || args[1].spread) {
            err(ck, e.span, "`{bname}(a, b)` takes exactly two arguments")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        let lt = checkExpr(ck, args[0].value)
        let rt = checkExpr(ck, args[1].value)
        let ltGood = match (lt) {
            case Ty.Int -> true
            case Ty.Float -> true
            case Ty.Unknown -> true
            case _ -> false
        }
        let rtGood = match (rt) {
            case Ty.Int -> true
            case Ty.Float -> true
            case Ty.Unknown -> true
            case _ -> false
        }
        if (!ltGood || !rtGood) {
            err(ck, e.span, "`{bname}` requires two `int` or `float` arguments")
            return Ty.Unknown
        }
        if (lt == Ty.Float || rt == Ty.Float) {
            Ty.Float
        } else if (lt == Ty.Int || rt == Ty.Int) {
            Ty.Int
        } else {
            Ty.Unknown
        }
}

fn checkClamp(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 3) {
            err(ck, e.span, "`clamp(x, lo, hi)` takes exactly three arguments")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        for (a in args) {
            if (!isNoneStr(a.name) || a.spread) {
                err(ck, e.span, "`clamp(x, lo, hi)` takes exactly three arguments")
                for (b in args) {
                    let _ = checkExpr(ck, b.value)
                }
                return Ty.Unknown
            }
        }
        var t = Ty.Unknown
        for (a in args) {
            let at = checkExpr(ck, a.value)
            if (!(at == Ty.Int || at == Ty.Float || at == Ty.Unknown)) {
                err(ck, a.value.span, "`clamp` arguments must be `int` or `float`")
                return Ty.Unknown
            }
            if (at == Ty.Float) {
                t = Ty.Float
            } else if (at == Ty.Int && t != Ty.Float) {
                t = Ty.Int
            }
        }
        t
}

fn checkStr(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            err(ck, e.span, "`str(x)` takes exactly one argument")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        let at = checkExpr(ck, args[0].value)
        match (at) {
            case Ty.Int -> Ty.String
            case Ty.Float -> Ty.String
            case Ty.Bool -> Ty.String
            case Ty.Char -> Ty.String
            case Ty.Unknown -> Ty.String
            case Ty.List(inner) -> {
                if (inner == Ty.Byte) {
                    Ty.String
                } else {
                    err(ck, args[0].value.span, "`str` requires an `int`, `float`, `bool`, `char`, or `List<byte>` argument")
                    Ty.Unknown
                }
            }
            case _ -> {
                err(ck, args[0].value.span, "`str` requires an `int`, `float`, `bool`, `char`, or `List<byte>` argument")
                Ty.Unknown
            }
        }
}

fn checkBytes(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            err(ck, e.span, "`bytes(s)` takes exactly one argument")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        let at = checkExpr(ck, args[0].value)
        if (!(at == Ty.String || at == Ty.Unknown)) {
            err(ck, args[0].value.span, "`bytes` requires a `string` argument")
        }
        Ty.List(Ty.Byte)
}

fn checkRange(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) == 0 || len(args) > 3) {
            err(ck, e.span, "`range(end)`, `range(start, end)`, or `range(start, end, step)` expected")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        for (a in args) {
            if (!isNoneStr(a.name) || a.spread) {
                err(ck, a.span, "`range` takes only plain positional arguments")
            }
            let at = checkExpr(ck, a.value)
            if (!(at == Ty.Int || at == Ty.Unknown)) {
                err(ck, a.value.span, "`range` bounds must be integers")
            }
        }
        Ty.List(Ty.Int)
}

fn checkReadFile(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            err(ck, e.span, "`read_file(path)` takes exactly one argument")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        let at = checkExpr(ck, args[0].value)
        if (!(at == Ty.String || at == Ty.Unknown)) {
            err(ck, args[0].value.span, "`read_file` requires a `string` path")
            return Ty.Unknown
        }
        Ty.Option(Ty.String)
}

fn checkWriteFile(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        if (len(args) != 2) {
            err(ck, e.span, "`write_file(path, text)` takes exactly two arguments")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        if (!isNoneStr(args[0].name) || args[0].spread || !isNoneStr(args[1].name) || args[1].spread) {
            err(ck, e.span, "`write_file(path, text)` takes exactly two arguments")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        var i = 0
        while (i < len(args)) {
            let at = checkExpr(ck, args[i].value)
            if (!(at == Ty.String || at == Ty.Unknown)) {
                var which = "path"
                if (i != 0) {
                    which = "text"
                }
                err(ck, args[i].value.span, "`write_file` argument {which} must be a `string`")
                return Ty.Unknown
            }
            i = i + 1
        }
        Ty.Bool
}

