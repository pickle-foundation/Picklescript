        }
        let mx = checkExpr(ck, args[4].value)
        ok = false
        match (mx) {
            case Ty.Int -> { ok = true }
            case Ty.Unknown -> { ok = true }
            case Ty.None -> { ok = true }
            case Ty.Option(it) -> {
                match (it) {
                    case Ty.Int -> { ok = true }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        if (!ok) {
            err(ck, args[4].value.span, "`run_spawn`'s `max_out` must be an `int` or `none`")
            return Ty.Unknown
        }
        Ty.Option(Ty.Stream)
}

fn checkProcHandle(ck: Checker, e: Expr, bname: string, args: List<CallArg>) -> Ty {
        if (len(args) != 1 || !isNoneStr(args[0].name) || args[0].spread) {
            err(ck, e.span, "`" + bname + "(handle)` takes exactly one argument")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        if (!checkHandle(ck, args[0])) {
            return Ty.Unknown
        }
        if (bname == "proc_code") {
            return Ty.Option(Ty.Int)
        }
        Ty.Bool
}

fn checkProcRead(ck: Checker, e: Expr, bname: string, args: List<CallArg>) -> Ty {
        var special = false
        for (a in args) {
            if (!isNoneStr(a.name) || a.spread) {
                special = true
            }
        }
        if (len(args) != 2 || special) {
            err(ck, e.span, "`" + bname + "(handle, n)` takes exactly two arguments")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        if (!checkHandle(ck, args[0])) {
            return Ty.Unknown
        }
        let n = checkExpr(ck, args[1].value)
        match (n) {
            case Ty.Int -> {}
            case Ty.Unknown -> {}
            case _ -> {
                err(ck, args[1].value.span, "`" + bname + "`'s `n` must be an `int`")
                return Ty.Unknown
            }
        }
        Ty.Option(Ty.List(Ty.Byte))
}

fn checkProcWrite(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        var special = false
        for (a in args) {
            if (!isNoneStr(a.name) || a.spread) {
                special = true
            }
        }
        if (len(args) != 2 || special) {
            err(ck, e.span, "`proc_in_write(handle, b)` takes exactly two arguments")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        if (!checkHandle(ck, args[0])) {
            return Ty.Unknown
        }
        let b = checkExpr(ck, args[1].value)
        var ok = false
        match (b) {
            case Ty.List(it) -> {
                match (it) {
                    case Ty.Byte -> { ok = true }
                    case Ty.Unknown -> { ok = true }
                    case _ -> {}
                }
            }
            case Ty.Unknown -> { ok = true }
            case _ -> {}
        }
        if (!ok) {
            err(ck, args[1].value.span, "`proc_in_write`'s `b` must be a `List<byte>`")
            return Ty.Unknown
        }
        Ty.Int
}

fn checkCurrentDir(ck: Checker, e: Expr, args: List<CallArg>) -> Ty {
        if (!(len(args) == 0)) {
            err(ck, e.span, "`current_dir()` takes no arguments")
            for (a in args) {
                let _ = checkExpr(ck, a.value)
            }
            return Ty.Unknown
        }
        Ty.Option(Ty.String)
}

fn checkIf(ck: Checker, e: Expr, cond: IfCond, thenBlock: Block, elseExpr: Expr?) -> Ty {
        // For `if (let pattern = value)` the binding stays in scope for the
        // then-block only: a failing pattern skips the binding entirely, so
        // the else branch must not see it.
        var bindScope = false
        match (cond) {
            case IfCond.Cond(c) -> {
                checkBoolCond(ck, c)
            }
            case IfCond.Binding(pattern, value) -> {
                let vt = checkExpr(ck, value)
                checkMatchPattern(ck, pattern, vt, value.span)
                pushScope(ck)
                bindPattern(ck, pattern, vt, false, value.span)
                bindScope = true
            }
        }
        // Analyze each branch from the same entry state and merge the moved
        // bits, so a value moved on one path is treated as moved afterwards
        // without falsely rejecting a move that happens on both paths.
        let before = captureMoved(ck)
        let tt = checkBlock(ck, thenBlock)
        var after = captureMoved(ck)
        if (bindScope) {
            popScope(ck)
        }
        let _ = e.span
        if (let some(elseE) = elseExpr) {
            setMoved(ck, before)
            let et = checkExpr(ck, elseE)
            let afterElse = captureMoved(ck)
            unionMoved(ck, after, afterElse)
            if (tt != Ty.Empty && et != Ty.Empty) {
                if (let some(merged) = mergeFlowTypes(tt, et)) {
                    setMoved(ck, after)
                    return merged
                } else {
                    errNote(ck, elseE.span, "`if` branches have mismatched types: `{bareName(tt)}` and `{bareName(et)}`", "both branches of an if-expression must produce the same type")
                }
            }
            setMoved(ck, after)
            tt
        } else {
            setMoved(ck, after)
            Ty.Empty
        }
}

fn checkMatch(ck: Checker, e: Expr, scrutinee: Expr, arms: List<MatchArm>) -> Ty {
        let st = checkExpr(ck, scrutinee)
        var result = Ty.Empty
        let before = captureMoved(ck)
        var merged: List<Map<string, MovedBits>>? = none
        for (arm in arms) {
            setMoved(ck, before)
            pushScope(ck)
            checkMatchPattern(ck, arm.pattern, st, arm.span)
            bindPattern(ck, arm.pattern, st, false, arm.span)
            if (let some(g) = arm.guard) {
                checkBoolCond(ck, g)
            }
            let bt = checkExpr(ck, arm.body)
            popScope(ck)
            let afterArm = captureMoved(ck)
            if (let some(acc) = merged) {
                unionMoved(ck, acc, afterArm)
            } else {
                merged = afterArm
            }
            if (result == Ty.Empty) {
                result = bt
            } else if (bt != Ty.Empty) {
                if (let some(m) = mergeFlowTypes(result, bt)) {
                    result = m
                } else {
                    errNote(ck, arm.span, "match arms produce inconsistent types: `{bareName(result)}` and `{bareName(bt)}`", "all arms of a match expression must produce the same type")
                }
            }
        }
        if (let some(acc) = merged) {
            setMoved(ck, acc)
        }
        let _ = e.span
        result
}

fn checkMatchPattern(ck: Checker, p: Pattern, st: Ty, span: Span) {
        let skip = match (st) {
            case Ty.Unknown -> true
            case Ty.Var(_) -> true
            case _ -> false
        }
        if (skip) {
            return
        }
        match (p) {
            case Pattern.Wildcard -> {}
            case Pattern.Binding(_, _) -> {}
            case Pattern.Tuple(parts) -> {
                match (st) {
                    case Ty.Tuple(tys) -> {
                        if (len(tys) != len(parts)) {
                            errNote(ck, span, "a {len(parts)}-element tuple pattern cannot match a {len(tys)}-tuple", "tuple patterns must line up with the scrutinee's arity")
                        } else {
                            var i = 0
                            while (i < len(parts)) {
                                checkMatchPattern(ck, parts[i], tys[i], span)
                                i = i + 1
                            }
                        }
                    }
                    case other -> {
                        errNote(ck, span, "a tuple pattern cannot match a value of type `{bareName(other)}`", "tuple patterns require a tuple scrutinee")
                    }
                }
            }
            case Pattern.Or(alts) -> {
                for (a in alts) {
                    checkMatchPattern(ck, a, st, span)
                }
                var anyBinds = false
                for (a in alts) {
                    if (patternIntroducesBinding(a)) {
                        anyBinds = true
                    }
                }
                if (anyBinds) {
                    errNote(ck, span, "an or-pattern alternative may not bind a name", "`a | b` joins patterns that only test values (literals, `_`, `some(_)`, `Tag(_)`)")
                }
            }
            case Pattern.Literal(l) -> checkMatchLiteral(ck, l, st, span)
            case Pattern.Variant(path, payloads) -> {
                if (len(path) == 1 && path[0] == "some") {
                    if (!isOption(st)) {
                        errNote(ck, span, "`some` patterns require an option value, not `{bareName(st)}`", "match `none`/`some(v)` against an option scrutinee")
                    } else {
                        let inner = if (let some(x) = innerOption(st)) { x } else { Ty.Unknown }
                        for (pl in payloads) {
                            checkMatchPattern(ck, pl, inner, span)
                        }
                    }
                    return
                }
                // A variant path on a non-enum, non-option scrutinee is a
                // mismatch; enum variants are validated while binding.
                let isEnumSt = match (st) {
                    case Ty.Enum(_, _) -> true
                    case _ -> false
                }
                if (!isOption(st) && !isEnumSt && len(path) >= 2) {
                    err(ck, span, "variant pattern `" + joinStrs(path, ".") + "` cannot match a value of type `" + bareName(st) + "`")
                }
                if (isOption(st) && !(len(path) == 1 && path[0] == "some")) {
                    err(ck, span, "patterns on an option value must be `some(v)`, `none`, or `_`")
                }
            }
        }
}

fn checkMatchLiteral(ck: Checker, l: Lit, st: Ty, span: Span) {
        var ok = false
        match (st) {
            case Ty.Int -> {
                match (l) {
                    case Lit.Int(_) -> ok = true
                    case Lit.Float(_) -> ok = true
                    case _ -> {}
                }
            }
            case Ty.Float -> {
                match (l) {
                    case Lit.Int(_) -> ok = true
                    case Lit.Float(_) -> ok = true
                    case _ -> {}
                }
            }
            case Ty.Byte -> {
                match (l) {
                    case Lit.Int(_) -> ok = true
                    case Lit.Float(_) -> ok = true
                    case Lit.Char(c) -> {
                        if ((c as int) <= 0x7F) {
                            ok = true
                        }
                    }
                    case _ -> {}
                }
            }
            case Ty.Char -> {
                match (l) {
                    case Lit.Char(_) -> ok = true
                    case _ -> {}
                }
            }
            case Ty.Bool -> {
                match (l) {
                    case Lit.Bool(_) -> ok = true
                    case _ -> {}
                }
            }
            case Ty.String -> {
                match (l) {
                    case Lit.String(parts) -> {
                        ok = true
                        for (pt in parts) {
                            match (pt) {
                                case StrPart.Expr(_) -> ok = false
                                case _ -> {}
                            }
                        }
                    }
                    case _ -> {}
                }
            }
            case _ -> {
                if (isOption(st)) {
                    match (l) {
                        case Lit.None -> ok = true
                        case _ -> {}
                    }
                }
            }
        }
        if (ok) {
            return
        }
        var hasInterp = false
        match (l) {
            case Lit.String(parts) -> {
                for (pt in parts) {
                    match (pt) {
                        case StrPart.Expr(_) -> hasInterp = true
                        case _ -> {}
                    }
                }
            }
            case _ -> {}
        }
        if (hasInterp) {
            errNote(ck, span, "string match patterns may not interpolate", "compare a literal inside the arm body instead")
            return
        }
        var what = ""
        match (l) {
            case Lit.Int(_) -> what = "an integer"
            case Lit.Float(_) -> what = "a float"
            case Lit.Bool(_) -> what = "`true`/`false`"
            case Lit.Char(_) -> what = "a character literal"
            case Lit.String(_) -> what = "a string literal"
            case Lit.None -> what = "`none`"
        }
        errNote(ck, span, "{what} pattern cannot match a value of type `{bareName(st)}`", "match patterns must share the scrutinee's type")
}

fn checkCast(ck: Checker, e: Expr, expr: Expr, ty: TypeExpr, kind: CastKind) -> Ty {
        let src = checkExpr(ck, expr)
        let target = resolvedFnTy(ck, ty, instantiatedGenerics(ck, ck.fnGenerics))
        if (kind == CastKind.Is) {
            // `is` must check against a type the source can actually be.
            if (src != Ty.Unknown && target != Ty.Unknown && !castRelated(ck, src, target)) {
                errNote(ck, e.span, "`{bareName(src)} is {bareName(target)}` can never succeed", "cast target must be assignable from, or an ancestor/descendant of, the source")
            }
            Ty.Bool
        } else {
            // As | TryAs
            var charRel = (src == Ty.Char && (target == Ty.Int || target == Ty.Byte)) || ((src == Ty.Int || src == Ty.Byte) && target == Ty.Char)
            if (src != Ty.Unknown && target != Ty.Unknown && !castRelated(ck, src, target) && !charRel) {
                errNote(ck, e.span, "cannot cast `{bareName(src)}` to `{bareName(target)}`", "cast target must be assignable from, or an ancestor/descendant of, the source")
            }
            if (kind == CastKind.TryAs) {
                optOf(target)
            } else {
                target
            }
        }
}

fn castRelated(ck: Checker, fromTy: Ty, toTy: Ty) -> bool {
        if (tyEq(fromTy, toTy)) {
            return true
        }
if (isNumeric(fromTy) && isNumeric(toTy)) {
                  return true
              }
              // A raw pointer and `int` are both single 64-bit words in the IR
              // domain, and every container ABI body needs to move an object
              // address between a `*T` value and a word slot (`list[5] = data`).
              // Without this the port cannot express a single list/map/object
              // runtime symbol; see PICKLE_AUDIT.md 17.1. Identity lowering in
              // `convert`, so no trap representation is invented.
              if (isPtr(fromTy) && toTy == Ty.Int) {
                  return true
              }
              if (fromTy == Ty.Int && isPtr(toTy)) {
                  return true
              }
              // A function value is also a single 64-bit word in the IR domain
              // (the raw code address, the same word `IrConst::FuncAddr` bakes
              // into registration calls). The GC engine keeps registered
              // `deinit` finalizers as int words and casts them back to a
              // callable only at invocation, so `int` and `fn` need the same
              // word-move relation pointers have. Identity lowering in
              // `convert`; no trap representation is invented.
              if (isFnValue(fromTy) && toTy == Ty.Int) {
                  return true
              }
              if (fromTy == Ty.Int && isFnValue(toTy)) {
                  return true
              }
        // Unwrap option layers on either side.
        if (let some(inner) = innerOption(fromTy)) {
            if (castRelated(ck, inner, toTy)) {
                return true
            }
        }
        if (let some(inner) = innerOption(toTy)) {
            if (castRelated(ck, fromTy, inner)) {
                return true
            }
        }
        // Same-kind structural/type relations.
        var rel = false
        match (fromTy) {
            case Ty.Class(a, _) -> {
                match (toTy) {
                    case Ty.Class(b, _) -> rel = a == b || isAncestor(ck, a, b) || isAncestor(ck, b, a) || conformsTo(ck, fromTy, toTy) || conformsTo(ck, toTy, fromTy)
                    case Ty.Interface(b, _) -> rel = implementsInterface(ck, a, b)
                    case _ -> {}
                }
            }
            case Ty.Struct(a, _) -> {
                match (toTy) {
                    case Ty.Struct(b, _) -> rel = a == b || isAncestor(ck, a, b) || isAncestor(ck, b, a) || conformsTo(ck, fromTy, toTy) || conformsTo(ck, toTy, fromTy)
                    case Ty.Interface(b, _) -> rel = implementsInterface(ck, a, b)
                    case _ -> {}
                }
            }
            case Ty.Interface(a, _) -> {
                match (toTy) {
                    case Ty.Interface(b, _) -> rel = a == b || conformsTo(ck, fromTy, toTy) || conformsTo(ck, toTy, fromTy)
                    case Ty.Class(b, _) -> rel = implementsInterface(ck, b, a)
                    case Ty.Struct(b, _) -> rel = implementsInterface(ck, b, a)
                    case _ -> {}
                }
            }
            case Ty.Enum(a, _) -> {
                match (toTy) {
                    case Ty.Enum(b, _) -> rel = a == b
                    case _ -> {}
                }
            }
            case Ty.List(aa) -> {
                match (toTy) {
                    case Ty.List(bb) -> rel = castRelated(ck, aa, bb)
                    case _ -> {}
                }
            }
            case Ty.Range(aa) -> {
                match (toTy) {
                    case Ty.Range(bb) -> rel = castRelated(ck, aa, bb)
                    case _ -> {}
                }
            }
            case Ty.Map(ka, va) -> {
                match (toTy) {
                    case Ty.Map(kb, vb) -> rel = castRelated(ck, ka, kb) && castRelated(ck, va, vb)
                    case _ -> {}
                }
            }
            case Ty.Fn(pa, ra) -> {
                match (toTy) {
                    case Ty.Fn(pb, rb) -> {
                        if (len(pa) != len(pb)) {
                            rel = false
                        } else {
                            var ok2 = true
                            var xi = 0
                            while (xi < len(pa)) {
                                if (!castRelated(ck, pa[xi], pb[xi])) {
                                    ok2 = false
                                }
                                xi = xi + 1
                            }
                            rel = ok2 && castRelated(ck, ra, rb)
                        }
                    }
                    case _ -> {}
                }
            }
            case _ -> {}
        }
        rel
}

