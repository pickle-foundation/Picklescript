module compiler.ast_test

import { isExpectMethod, emptyModuleDecls, emptyImportDecls, emptyItems, emptyStrs, emptyAttrs, emptyExprs, emptyImports, emptyParams, emptyGenericParams, emptyTypeExprs, emptyStmts, emptyMatchArms, emptyCallArgs, emptyStrParts, emptyProcMembers, emptyEnumVariants, emptyEnumFields, emptyIfaceMembers, emptyBlock } from compiler.ast

test fn expect_method_names() {
    expect(isExpectMethod("toBe")).toBe(true)
    expect(isExpectMethod("toEqual")).toBe(true)
    expect(isExpectMethod("toHaveLength")).toBe(true)
    expect(isExpectMethod("toContain")).toBe(true)
    expect(isExpectMethod("toExist")).toBe(true)
    expect(isExpectMethod("toBeNull")).toBe(true)
    expect(isExpectMethod("toEqualB")).toBe(false)
    expect(isExpectMethod("toBeTruth")).toBe(false)
    expect(isExpectMethod("to")).toBe(false)
    expect(isExpectMethod("")).toBe(false)
}

test fn empty_strs() {
    expect(len(emptyStrs())).toBe(0)
}

test fn empty_list_factories() {
    expect(len(emptyModuleDecls())).toBe(0)
    expect(len(emptyImportDecls())).toBe(0)
    expect(len(emptyItems())).toBe(0)
    expect(len(emptyAttrs())).toBe(0)
    expect(len(emptyExprs())).toBe(0)
    expect(len(emptyImports())).toBe(0)
    expect(len(emptyParams())).toBe(0)
    expect(len(emptyGenericParams())).toBe(0)
    expect(len(emptyTypeExprs())).toBe(0)
    expect(len(emptyStmts())).toBe(0)
    expect(len(emptyMatchArms())).toBe(0)
    expect(len(emptyCallArgs())).toBe(0)
    expect(len(emptyStrParts())).toBe(0)
    expect(len(emptyProcMembers())).toBe(0)
    expect(len(emptyEnumVariants())).toBe(0)
    expect(len(emptyEnumFields())).toBe(0)
    expect(len(emptyIfaceMembers())).toBe(0)
}

test fn empty_block() {
    let b = emptyBlock()
    expect(len(b.stmts)).toBe(0)
    expect(len(emptyStrs())).toBe(0)
}