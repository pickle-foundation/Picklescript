module compiler.error

class CatalogueEntry {
    var code: string
    var title: string
    var rule: string
    var example: string

    constructor(code: string, title: string, rule: string, example: string) {
        this.code = code
        this.title = title
        this.rule = rule
        this.example = example
    }
}

fn catalogue() -> List<CatalogueEntry> {
    [
        CatalogueEntry("E0101", "lexical error", "the source contains a byte sequence the lexer cannot turn into a token; a literal is unterminated, or a character is not valid in this position.", "let s = \"unterminated"),
        CatalogueEntry("E0111", "syntax error", "the token stream does not form a valid declaration, statement, or expression at this position.", "fn main() \{ let = \}"),
        CatalogueEntry("E0201", "duplicate declaration", "a top-level name (function, class, struct, enum, interface, const) is declared twice in the same module.", "fn main() \{\}  fn main() \{\}"),
        CatalogueEntry("E0202", "duplicate import alias", "two module imports resolve to the same alias in this module.", "import a as util  import b as util"),
        CatalogueEntry("E0206", "module not found", "an import path does not resolve to a file: it is searched relative to the importing file's directory, then under `<cwd>/src/` (or `<cwd>/src/<path>.pkl` when the path maps to a nested folder).", "import nowhere.utility"),
        CatalogueEntry("E0207", "item not exported by module", "an `import \{ item \}` references a name the referenced module does not declare at top level.", "import \{ Missing \} from text.lexer"),
        CatalogueEntry("E0208", "module path mismatch", "a file declares a `module` path that differs from the path used to load it; resolving the import locates the file under a different module name than the one it declares.", "import b.tool  // b/tool.pkl declares `module a.tool`"),
        CatalogueEntry("E0209", "ambiguous imported name", "two loaded modules both export the same top-level function or const, and a bare reference in this file cannot tell them apart. Disambiguate with `import <item> from <mod> as <alias>` first.", "import helper from a.utils  import helper from b.utils  fn main() \{ helper() \}"),
        CatalogueEntry("E0203", "duplicate member", "a class or struct declares two members with the same name.", "class P \{\n    var x: int\n    var x: string\n\}"),
        CatalogueEntry("E0204", "duplicate constructor", "a class or struct declares the primary constructor more than once.", "class P \{ constructor() \{\}  constructor() \{\} \}"),
        CatalogueEntry("E0205", "duplicate deinit", "a class declares more than one `deinit` block.", "class P \{ deinit \{\}  deinit \{\} \}"),
        CatalogueEntry("E0210", "unknown type", "a type name does not resolve to a declared class, struct, enum, interface, generic parameter, or built-in type.", "fn f(x: Widget) \{\}"),
        CatalogueEntry("E0211", "type is not generic", "a generic instantiation `Name<T>` is applied to a type that takes no type parameters.", "let xs: string<int> = \"\""),
        CatalogueEntry("E0212", "wrong number of type arguments", "a generic instantiation supplies fewer or more type arguments than the type declares.", "class Box<T> \{\}\nlet b: Box<int, string> = Box<int>()"),
        CatalogueEntry("E0213", "list of references", "lists storing `&T` references are not supported yet; a reference cannot outlive the borrowed local it points to inside a collection.", "let refs: List<&int> = []"),
        CatalogueEntry("E0220", "invalid extends", "only a class may extend a class; extends/`implements` targets must be the right kind of type.", "class Foo extends SomeStruct"),
        CatalogueEntry("E0221", "override signature mismatch", "an `override` method must match its parent's parameter and return types exactly.", "class B extends A \{ override fn m(x: int) -> int \}  // A.m takes string"),
        CatalogueEntry("E0222", "missing override", "a method redefines an inherited method without the `override` keyword.", "class B extends A \{ fn m() \{\} \}  // A already has m()"),
        CatalogueEntry("E0223", "orphan override", "a method is marked `override` but no parent in the class chain declares it.", "class B extends A \{ override fn n() \{\} \}  // A has no n"),
        CatalogueEntry("E0224", "mixed method kind", "a class cannot redeclare an inherited method under the opposite kind: a `static` method cannot shadow an inherited instance method, and an instance method cannot shadow an inherited `static` method.", "class B extends A \{ static fn m() \{\} \}  // A.m is an instance method"),
        CatalogueEntry("E0308", "type mismatch", "an expression's type does not satisfy the declared or expected type, after option/subtyping conversions are tried.", "fn f() -> int \{ return \"x\" \}"),
        CatalogueEntry("E0310", "return value error", "a function with no return type returns a value, or `if`/`match` branches produce inconsistent result types.", "fn f() \{ return 1 \}   fn g(b) \{ if b \{ 1 \} else \{ \"x\" \} \}"),
        CatalogueEntry("E0320", "break or continue outside a loop", "`break` and `continue` are only valid inside `while`/`for` bodies.", "fn f() \{ break \}"),
        CatalogueEntry("E0340", "condition is not bool", "`if`, `while`, `for` conditions, and `&&`/`||` operands must be `bool`.", "if (1) \{\}"),
        CatalogueEntry("E0341", "for-in requires a sequence", "`for (x in seq)` needs a sequence: a List, a string, a Map, or a range.", "for (x in 42) \{\}"),
        CatalogueEntry("E0342", "map keys must be a supported type", "map keys may be `string`, a scalar (`int`, `float`, `bool`, `char`, `byte`), a composite object (`List`, `Map`, class/struct instance, enum, interface), an option, or a tuple. Keys are hashed and compared structurally. Reference, function, and pointer keys are not supported.", "(1, 2) as a map key \u{2014} \{ (1, 2): \"a\" \} is not lowered"),
        CatalogueEntry("E0343", "index error", "the index expression has the wrong type for the indexed value, or the value cannot be indexed at all.", "let xs = [1,2]  let x = xs[\"a\"]"),
        CatalogueEntry("E0351", "undeclared name", "an identifier in expression position is not a local, function, const, type, or member of the surrounding class.", "fn main() \{ print(nope) \}"),
        CatalogueEntry("E0352", "no such member", "a field, property, or method name does not exist on the receiver class, struct, or List/Map built-ins.", "class P \{ var x: int \}\nlet p = P()  p.y"),
        CatalogueEntry("E0353", "enum variant error", "a variant name does not exist on the enum, or a bare variant name is used where a payload constructor is required.", "enum Color \{ Red  Green \}\ncase Color.Purple -> \{\}"),
        CatalogueEntry("E0354", "cannot construct this type", "interfaces and enums are not directly constructible; classes and structs are.", "let i = SomeInterface()"),
        CatalogueEntry("E0355", "member assignment on non-class value", "assigning through `.member` requires the receiver to be a class or struct value.", "let n = 5  n.x = 3"),
        CatalogueEntry("E0360", "interface conformance", "a type declaring `implements I` must provide every member `I` declares.", "class P implements Runnable \{ \}  // no run()"),
        CatalogueEntry("E0361", "this / super misuse", "`this`/`super` are only valid inside a class body; `this(...)` only as a named constructor's single delegation.", "fn f() \{ this \}"),
        CatalogueEntry("E0362", "invalid assignment", "the assignment target is not assignable: it is immutable, undeclared, a wrong receiver kind, a missing setter, or write-through an `&T`.", "fn f() \{ let x = 1  x = 2 \}"),
        CatalogueEntry("E0363", "invalid cast or is", "the cast/`is` target is unrelated to the source type (no numeric conversion, option relationship, or inheritance).", "let n = 5 as bool"),
        CatalogueEntry("E0400", "attribute error", "an attribute name is unknown, repeated, or given arguments it does not take.", "#[wat] let x = 1"),
        CatalogueEntry("E0401", "manualAlloc misuse", "`#[manualAlloc]` applies to class/struct types only: its binding needs an allocation initializer, fields need an initializer and, when untyped, an annotation; it is not allowed on statics or constants.", "#[manualAlloc] let x = 5"),
        CatalogueEntry("E0410", "call argument error", "the call passes too many or too few arguments, uses named arguments where the callee takes positional ones, or a generic function name is unknown.", "fn add(a: int) \{\}  add(1, 2)"),
        CatalogueEntry("E0411", "call of non-function", "only functions, type constructors, and enum variant constructors can be called.", "let n = 5  n()"),
        CatalogueEntry("E0420", "member access on non-class value", "`.member` requires a class, struct, enum, or interface receiver; an option (`T?`) must be unwrapped or accessed with `?.` first, and scalars have no members.", "let n = 5  n.name"),
        CatalogueEntry("E0430", "operator operand error", "an operator is applied to operands of a type it does not define (non-numeric arithmetic, non-int bitwise and shifts, non-bool `!`, unpacking a non-option, dereferencing a non-pointer).", "let s = \"a\"  let n = s * 2"),
        CatalogueEntry("E0440", "alloc / free misuse", "the raw-buffer builtins have a fixed shape: `alloc(T, count)` with a scalar element type and an `int` count, `free(p)` with a pointer argument, zero extra `.free()`/`alloc` arguments when used on bindings.", "unsafe \{ alloc(Widget, 4) \}  // scalar element types only"),
        CatalogueEntry("E0501", "use after free or move", "reading or calling with a `#[manualAlloc]` value after `.free()` or after its ownership moved elsewhere.", "x.free()  println(x)"),
        CatalogueEntry("E0502", "already freed", "a `#[manualAlloc]` binding is released twice.", "x.free()  x.free()"),
        CatalogueEntry("E0503", "free on a non-manual value", "`x.free()` is only available on a `#[manualAlloc]` binding, which owns its allocation.", "let x = User()  x.free()"),
        CatalogueEntry("E0504", "owned position", "a `#[manualAlloc]` value can only reach an owning position by moving a `#[manualAlloc]` binding or a fresh allocation; it cannot be stored in a managed binding, field, or collection.", "#[manualAlloc] let y = x  // x must be manual or fresh"),
        CatalogueEntry("E0505", "overwrite or non-owning return of a manual value", "a `#[manualAlloc]` binding cannot be overwritten, and a manual value cannot be returned from a function that does not declare `#[manualAlloc]`.", "x = make()  // x is manual"),
        CatalogueEntry("E0506", "leaked owned result", "the result of a `#[manualAlloc]` function is owned by the caller and must be bound, passed to an owned parameter, or returned; discarding it leaks.", "make()  // result dropped, not consumed"),
        CatalogueEntry("E0520", "unsafe required", "raw pointers, `&`/`*`, pointer access, indexing and stores, and the raw-buffer builtins are only allowed inside `unsafe \{ \}`.", "let p = &local\n*p = 5"),
        CatalogueEntry("E0700", "reference outside parameter", "`&T` exists only as a function parameter type; stored or returned `&T` would dangle once the borrowed local goes away.", "let r: &int = &x"),
        CatalogueEntry("E0900", "not lowered yet", "the checker accepted the construct, but the code generator does not lower it yet; the program is rejected instead of miscompiled.", "let t = (1, 2)  // tuples check but have no lowering"),
    ]
}

fn normalizeId(raw: string) -> string {
    let bs = bytes(raw)
    var start = 0
    var end = len(bs)
    while (start < end) {
        let b = bs[start] as int
        if (b == 32 || b == 9 || b == 13 || b == 10) {
            start = start + 1
        } else {
            break
        }
    }
    while (end > start) {
        let b = bs[end - 1] as int
        if (b == 32 || b == 9 || b == 13 || b == 10) {
            end = end - 1
        } else {
            break
        }
    }
    var up = ""
    var i = start
    while (i < end) {
        let b = bs[i] as int
        var c = b
        if (b >= 97 && b <= 122) {
            c = b - 32
        }
        up += "{c as char}"
        i = i + 1
    }
    let ubs = bytes(up)
    var lead = 0
    while (lead < len(ubs)) {
        if ((ubs[lead] as int) == 69) {
            lead = lead + 1
        } else {
            break
        }
    }
    var rest = ""
    var k = lead
    while (k < len(ubs)) {
        rest += "{ubs[k] as char}"
        k = k + 1
    }
    "E" + rest
}

fn explainById(id: string) -> CatalogueEntry? {
    let entries = catalogue()
    var i = 0
    while (i < len(entries)) {
        if (entries[i].code == id) {
            return entries[i]
        }
        i = i + 1
    }
    none
}

fn allIds() -> List<string> {
    let entries = catalogue()
    var out = emptyStrs()
    var i = 0
    while (i < len(entries)) {
        out.push(entries[i].code)
        i = i + 1
    }
    out
}

fn emptyStrs() -> List<string> {
    var l = [""]
    l.pop()
    l
}