module cli.probe_stages

import { DiagnosticSink, Severity } from compiler.diag
import { frontend } from compiler.front
import { emitIr } from compiler.emit
import { x64LowerModule } from compiler.x64
import { coffObjFor } from compiler.coff
import { coffRead } from compiler.objread

fn dumpDiags(label: string, sinks: DiagnosticSink) {
    let ds = sinks.diagnostics
    var i = 0
    while (i < len(ds)) {
        let d = ds[i]
        var spanTxt = "none"
        match (d.span) {
            case some(sp) -> spanTxt = "(" + str(sp.start) + "," + str(sp.end) + ")"
            case none -> {}
        }
        println(label + " sev=" + (if (d.severity == Severity.Error) { "Error" } else { "Warning" }) + " msg=" + d.message + " span=" + spanTxt)
        i = i + 1
    }
}

fn main() {
    let argv = args()
    if (len(argv) < 1) {
        return
    }
    let target = argv[0]
    if (let some(src) = read_file(target)) {
        let sinks = DiagnosticSink()
        var loadedOpt = frontend(target, src, sinks)
        if (let some(loaded) = loadedOpt) {
            println("STAGE frontend OK")
            let irSinks = DiagnosticSink()
            var irOpt = emitIr(loaded.program, loaded.resolved, irSinks)
            if (let some(irModule) = irOpt) {
                println("STAGE emit OK")
                let xSinks = DiagnosticSink()
                var xOpt = x64LowerModule(irModule, xSinks)
                if (let some(out) = xOpt) {
                    println("STAGE x64 OK")
                    let objBytes = coffObjFor(irModule, out)
                    let _ = coffRead(target, objBytes)
                    println("STAGE coff OK")
                } else {
                    println("STAGE x64 FAIL")
                    dumpDiags("  x64", xSinks)
                }
            } else {
                println("STAGE emit FAIL")
                dumpDiags("  emit", irSinks)
            }
        } else {
            println("STAGE frontend FAIL")
            dumpDiags("  front", sinks)
        }
    } else {
        println("cannot read " + target)
    }
}