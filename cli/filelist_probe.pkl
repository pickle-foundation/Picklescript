module cli.filelist_probe

import { DiagnosticSink } from compiler.diag
import { Loader } from compiler.front

fn main() {
    let argv = args()
    var target = "pickle/cli/build.pkl"
    if (len(argv) > 0) {
        target = argv[0]
    }
    let src = read_file(target)
    if (let none = src) {
        println("no read")
        return
    }
    let l = Loader(DiagnosticSink())
    let r = l.loadRoot(target, src as string)
    var i = 0
    while (i < len(l.files)) {
        println(str(i) + " " + l.files[i].filePath)
        i = i + 1
    }
}
