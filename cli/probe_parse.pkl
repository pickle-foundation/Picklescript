module cli.probe_parse

import { DiagnosticSink } from compiler.diag
import { Lexer } from compiler.lexer
import { parse } from compiler.parser

fn main() {
    var target = "pickle/compiler/emit.pkl"
    if (len(args()) > 0) {
        target = args()[0]
    }
    if (let some(src) = read_file(target)) {
        let sink = DiagnosticSink()
        let lx = Lexer(bytes(src), 0, 0, none, range(0), 0)
        println("LEXER MADE")
        let toks = lx.run()
        println("LEXED " + str(len(toks)) + " tokens")
        let prog = parse(toks, sink)
        if (let some(_) = prog) {
            println("PARSE OK")
        } else {
            println("PARSE FAIL")
        }
    } else {
        println("NO FILE")
    }
}