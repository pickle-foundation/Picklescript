module cli.gen2_stopA

import { DiagnosticSink } from compiler.diag
import { frontend } from compiler.front

fn main() {
    let argv = args()
    var target = ""
    if (len(argv) > 0) {
        target = argv[0]
    }
    if (target == "") {
        println("NO TARGET")
        return
    }
    if (let some(src) = read_file(target)) {
        let sinks = DiagnosticSink()
        if (let some(loaded) = frontend(target, src, sinks)) {
            let n = len(loaded.program.items)
            println("STOPA " + target + " ok items=" + "{n}")
        } else {
            println("STOPA " + target + " FAIL")
        }
    } else {
        println("NO FILE: " + target)
    }
}

fn frontOk(fileName: string, src: string, sinks: DiagnosticSink) -> bool {
    if (let some(out) = frontend(fileName, src, sinks)) {
        let _ = out
        true
    } else {
        false
    }
}