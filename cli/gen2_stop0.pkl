module cli.gen2_stop0

import { DiagnosticSink } from compiler.diag
import { frontend } from compiler.front
import { emitIr } from compiler.emit

fn main() {
    let argv = args()
    if (len(argv) > 0) {
        if (let some(src) = read_file(argv[0])) {
            let res = go(argv[0], src)
            println(res)
        } else {
            println("NO FILE: " + argv[0])
        }
    } else {
        println("NO TARGET")
    }
}

fn go(fileName: string, src: string) -> string {
    let sinks = DiagnosticSink()
    if (let some(loaded) = frontend(fileName, src, sinks)) {
        if (let some(m) = emitIr(loaded.program, loaded.resolved, sinks)) {
            "ok" + "{len(m.funcs)}"
        } else {
            "irfail1"
        }
    } else {
        "irfail0"
    }
}