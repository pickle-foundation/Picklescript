module cli.build

import { DiagnosticSink } from compiler.diag
import { newObjs, lowerProgram, linkExe } from cli.buildlib

/// Link a program object to a PE image.
///
/// Usage: build <source.pkl> <ignored runtime lib> <out.exe>
///
/// The middle argument is kept so the historical gate scripts keep working.
/// `lowerProgram` already emits the whole import closure, including the
/// runtime prelude, into one object; there is no archive to load.
fn main() {
    let argv = args()
    if (len(argv) < 3) {
        println("BUILD NO ARGS: <source.pkl> <ignored runtime lib> <out.exe>")
        exit(1)
    }
    let target = argv[0]
    let outputExe = argv[2]
    if (let some(src) = read_file(target)) {
        let sinks = DiagnosticSink()
        if (let some(program) = lowerProgram(target, src, sinks)) {
            var objects = newObjs()
            objects.push(program.obj)
            if (let some(errorText) = linkExe(objects, outputExe, program.overrides)) {
                println("BUILD FAIL: " + errorText)
                exit(1)
            }
            printDiags(sinks)
            // The sink can still hold error-severity diagnostics on a
            // lowering that produced a program. Exit codes are the signal
            // scripted checks trust, so never report success in that case.
            if (sinks.anyError()) {
                println("BUILD FAIL: source " + target + " had error diagnostics")
                exit(1)
            }
            println("BUILD OK objects=1 exe=" + outputExe)
            return
        }
        printDiags(sinks)
        println("BUILD FAIL: source " + target + " did not lower to COFF")
        exit(1)
    }
    println("BUILD FAIL: cannot read source " + target)
    exit(1)
}

fn printDiags(diags: DiagnosticSink) {
    let ds = diags.diagnostics
    var i = 0
    while (i < len(ds)) {
        let d = ds[i]
        var sp = "none"
        if (let some(s0) = d.span) {
            sp = "(" + str(s0.start) + "," + str(s0.end) + ")"
        }
        println("DIAG msg=" + d.message + " span=" + sp)
        i = i + 1
    }
}
