module cli.runoneoracle

import { DiagnosticSink } from compiler.diag
import { frontend } from compiler.front
import { emitIr } from compiler.emit
import { irModuleStr, irxModuleStr } from compiler.ir

fn irSources(fileName: string, src: string) -> List<string> {
    let sinks = DiagnosticSink()
    var out = emptyStrs()
    if (let some(loaded) = frontend(fileName, src, sinks)) {
        if (let some(m) = emitIr(loaded.program, loaded.resolved, sinks)) {
            out.push(irModuleStr(m))
            out.push(irxModuleStr(m))
        } else {
            out.push("irfail")
            out.push("irfail")
        }
    } else {
        out.push("irfail")
        out.push("irfail")
    }
    out
}

fn trim(p: string) -> string {
    var out = ""
    var sb = bytes(p)
    var i = 0
    while (i < len(sb)) {
        if (sb[i] == 13 as int || sb[i] == 10 as int) {
            i = i + 1
        } else {
            out = out + "{sb[i] as char}"
            i = i + 1
        }
    }
    out
}

fn main() {
    if (let some(tf) = read_file("cli/one_target.txt")) {
        let target = trim(tf)
        if (let some(src) = read_file(target)) {
            let res = irSources(target, src)
            var base = "one"
            var k = len(target) - 1
            while (k >= 0) {
                let b = bytes(target)[k] as int
                if (b == 47 || b == 92) {
                    break
                }
                k = k - 1
            }
            base = ""
            var j = k + 1
            while (j < len(target)) {
                base = base + "{bytes(target)[j] as char}"
                j = j + 1
            }
            write_file("tools/diff/oracle/" + base + ".ir", res[0] + "\n")
            write_file("tools/diff/oracle/" + base + ".irx", res[1])
            println("ORACLE DONE: " + target)
        } else {
            println("NO FILE: " + target)
        }
    } else {
        println("NO TARGET FILE")
    }
}

fn emptyStrs() -> List<string> {
    var l = [""]
    l.pop()
    l
}

