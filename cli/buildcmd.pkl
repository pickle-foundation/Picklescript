module cli.buildcmd

import { subStr } from compiler.front
import { SYS_PLATFORM } from runtime.abi_sys

/// Options for `pklc build`, shared by the POSIX and Windows front ends so the
/// two commands accept the same flags and compute the same default output.
class BuildOptions {
    var source: string
    var output: string
    var target: string
    var rtDir: string
    var link: bool
    var keepObject: bool

    constructor(source: string, output: string, target: string, rtDir: string, link: bool, keepObject: bool) {
        this.source = source
        this.output = output
        this.target = target
        this.rtDir = rtDir
        this.link = link
        this.keepObject = keepObject
    }
}

/// The target this compiler was built for. A native Linux `pklc` defaults to
/// `linux`; the Windows bootstrap defaults to `win`. `--target` overrides it.
fn defaultBuildTarget() -> string {
    if (SYS_PLATFORM == "posix") {
        return "linux"
    }
    "win"
}

fn parseBuildOptions(argv: List<string>) -> BuildOptions? {
    var source = ""
    var output = ""
    var target = defaultBuildTarget()
    var rtDir = "runtime"
    var link = true
    var keepObject = false
    var i = 1
    while (i < len(argv)) {
        let a = argv[i]
        if (a == "--target") {
            if (i + 1 >= len(argv)) {
                return buildUsage("--target needs win or linux")
            }
            target = normalizeTarget(argv[i + 1])
            if (target == "") {
                return buildUsage("unknown target: " + argv[i + 1])
            }
            i = i + 2
        } else if (a == "-o" || a == "--out") {
            if (i + 1 >= len(argv)) {
                return buildUsage(a + " needs a path")
            }
            output = argv[i + 1]
            i = i + 2
        } else if (a == "--runtime") {
            if (i + 1 >= len(argv)) {
                return buildUsage("--runtime needs a directory")
            }
            rtDir = argv[i + 1]
            i = i + 2
        } else if (a == "--no-link") {
            link = false
            i = i + 1
        } else if (a == "--keep-object") {
            keepObject = true
            i = i + 1
        } else if (hasPrefix(a, "-")) {
            return buildUsage("unknown option: " + a)
        } else {
            if (source != "") {
                return buildUsage("more than one source file")
            }
            source = a
            i = i + 1
        }
    }
    if (source == "") {
        return buildUsage("build needs a source file")
    }
    if (output == "") {
        output = defaultBuildOutput(source, target)
    }
    BuildOptions(source, output, target, rtDir, link, keepObject)
}

fn normalizeTarget(t: string) -> string {
    if (t == "win" || t == "windows") {
        return "win"
    }
    if (t == "linux" || t == "posix") {
        return "linux"
    }
    ""
}

fn defaultBuildOutput(source: string, target: string) -> string {
    let base = stripPkl(source)
    if (target == "win") {
        return base + ".exe"
    }
    base
}

fn stripPkl(p: string) -> string {
    if (hasSuffix(p, ".pkl")) {
        return subStr(p, 0, len(p) - 4)
    }
    p
}

fn hasPrefix(s: string, p: string) -> bool {
    let sb = bytes(s)
    let pb = bytes(p)
    if (len(pb) > len(sb)) {
        return false
    }
    var i = 0
    while (i < len(pb)) {
        if (sb[i] != pb[i]) {
            return false
        }
        i = i + 1
    }
    true
}

fn hasSuffix(s: string, suf: string) -> bool {
    let sb = bytes(s)
    let fb = bytes(suf)
    if (len(fb) > len(sb)) {
        return false
    }
    var i = 0
    while (i < len(fb)) {
        if (sb[len(sb) - len(fb) + i] != fb[i]) {
            return false
        }
        i = i + 1
    }
    true
}

fn buildUsage(msg: string) -> BuildOptions? {
    println("pklc: " + msg)
    println("usage: pklc build [--target win|linux] [-o <path>] [--runtime <dir>] [--no-link] <file.pkl>")
    none
}
