module cli.probews

import { parseWorkspaceMembers, extractKv } from compiler.front

fn main() {
    var text = ""
    let rf = read_file("picklescript.toml")
    if (let some(t) = rf) {
        text = t
    }
    println("len=" + "{len(text)}")
    let direct = extractKv(" name = \"compiler\", path = \"pickle/compiler\" ", "name")
    var dv = "none"
    if (let some(v) = direct) {
        dv = v
    }
    println("extractKv name -> " + dv)
    let m = parseWorkspaceMembers(text)
    println("keys=" + "{len(m.keys())}")
}