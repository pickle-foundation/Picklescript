module cli.probe_ast

import { DiagnosticSink } from compiler.diag
import { frontend } from compiler.front
import { emitIr } from compiler.emit
import { irModuleStr } from compiler.ir

fn dumpDiags(diags: DiagnosticSink) {
    let ds = diags.diagnostics
    var i = 0
    while (i < len(ds)) {
        let d = ds[i]
        println("PROBE diag sev=" + (if (d.severity == Severity.Error) { "Error" } else { "Warning" }) + " msg=" + d.message + " span=" + (if (let some(sp) = d.span) { "(" + str(sp.start) + "," + str(sp.end) + ")" } else { "none" }))
        var j = 0
        while (j < len(d.notes)) {
            println("PROBE diag   note=" + d.notes[j].message)
            j = j + 1
        }
        i = i + 1
    }
}

fn main() {
    let fileName = "pickle/compiler/ast.pkl"
    if (let some(src) = read_file(fileName)) {
        let sinks = DiagnosticSink()
        if (let some(loaded) = frontend(fileName, src, sinks)) {
            println("PROBE frontend ok")
            if (let some(m) = emitIr(loaded.program, loaded.resolved, sinks)) {
                println("PROBE emit ok; ir len=" + str(len(irModuleStr(m))))
            } else {
                println("PROBE emitIr returned none")
                dumpDiags(sinks)
            }
        } else {
            println("PROBE frontend returned none")
            dumpDiags(sinks)
        }
    } else {
        println("PROBE cannot read file")
    }
}