module cli.probe_build

import { DiagnosticSink, Severity } from compiler.diag
import { newObjs, lowerToCoff, loadArchive, linkExe } from cli.buildlib

fn main() {
    let argv = args()
    if (len(argv) < 1) {
        return
    }
    let target = argv[0]
    if (let some(src) = read_file(target)) {
        let sinks = DiagnosticSink()
        if (let some(obj) = lowerToCoff(target, src, sinks)) {
            println("LOWER OK")
        } else {
            println("LOWER FAIL:")
            let ds = sinks.diagnostics
            var i = 0
            while (i < len(ds)) {
                let d = ds[i]
                var spanTxt = "none"
                match (d.span) {
                    case some(sp) -> spanTxt = "(" + str(sp.start) + "," + str(sp.end) + ")"
                    case none -> {}
                }
                println("sev=" + (if (d.severity == Severity.Error) { "Error" } else { "Warning" }) + " msg=" + d.message + " span=" + spanTxt)
                i = i + 1
            }
        }
    } else {
        println("cannot read " + target)
    }
}