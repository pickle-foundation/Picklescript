module cli.dbg_parse

import { Lexer } from compiler.lexer
import { DiagnosticSink } from compiler.diag
import { parse } from compiler.parser

fn main() {
    if (let some(src) = read_file("tests/pickle/classes_test.pkl")) {
        let lx = Lexer(bytes(src), 0, 0, none, range(0), 0)
        let toks = lx.run()
        let diags = DiagnosticSink()
        if (let some(prog) = parse(toks, diags)) {
            for (item in prog.items) {
                match (item.kind) {
                    case ItemKind.Test(f) -> println("TEST[" + f.name + "]")
                    case ItemKind.Fn(f) -> println("FN[" + f.name + "]")
                    case _ -> println("OTHER")
                }
            }
        } else {
            println("PARSE FAIL")
        }
        for (d in diags.diagnostics) {
            println("DIAG " + d.message)
        }
    }
}