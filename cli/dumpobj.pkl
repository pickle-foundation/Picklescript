module cli.dumpobj

import { DiagnosticSink } from compiler.diag
import { lowerModuleObjBytes } from cli.buildlib
import { strFrom } from compiler.linklib

fn main() {
    let argv = args()
    if (len(argv) < 2) {
        println("usage: dumpobj <src.pkl> <out.obj>")
        exit(1)
    }
    var ai = 0
    while (ai < len(argv)) {
        println("ARG " + str(ai) + " " + argv[ai])
        ai = ai + 1
    }
    let target = argv[0]
    let out = argv[1]
    if (let some(src) = read_file(target)) {
        let sinks = DiagnosticSink()
        if (let some(b) = lowerModuleObjBytes(target, src, sinks)) {
            if (write_file(out, strFrom(b.bytes))) {
                println("DUMPOK bytes=" + str(len(b.bytes)))
                return
            }
            println("DUMP FAIL: write")
        } else {
            println("DUMP FAIL: lower")
        }
    } else {
        println("DUMP FAIL: read")
    }
    exit(1)
}
