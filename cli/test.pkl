module cli.tst

import { runTestFile, trimTarget } from cli.testlib

/// The battery's test driver. `pklc test` calls `runTestFile` directly; this
/// wrapper keeps the historical argv shape and stdout byte-for-byte (GATE8
/// pins the testrunner output against the frozen golden).
///
/// Usage: pklc_test.exe <file.pkl> [ignored runtime archive]
fn main() {
    let argv = args()
    var target = ""
    if (len(argv) > 0) {
        target = argv[0]
    } else if (let some(tf) = read_file("cli/one_target.txt")) {
        target = trimTarget(tf)
    }
    if (target == "") {
        println("NO TARGET")
        return
    }
    exit(runTestFile(target, "tools/diff/ptest"))
}
