module std.encoding.toml

// A dependency-free TOML subset parser.
//
// Supported: comments, bare/dotted keys, `[table]` headers, basic strings
// (`"..."` with `\n`, `\t`, `\r`, `\"`, `\\`), literal strings (`'...'`),
// integers with an optional sign, booleans, and arrays (including nested and
// multi-line arrays). Not supported: floats, dates/times, multi-line strings,
// `[[array-of-tables]]`, inline tables, and quoted keys - a document using them
// parses as `none` instead of being silently misread.
//
// `parse(text)` returns the root table value or `none` on any syntax error.
// The accessor helpers mirror `std.json` (`typeOf`, `asStr`, `asInt`, `asBool`,
// `field`, `at`, `size`, `keysOf`). Tables are backed by the native `Map`, so
// `keysOf` reports native map order, not document order; the subset does not
// promise ordered iteration.
//
// The parser reports failure through the `fail` flag rather than through
// option-typed internal returns: error propagation is a single `if (this.fail)`
// instead of a chain of `match`es, and it keeps the module compiling on the
// Rust reference, which does not lower every option shape.

enum Toml {
    TStr(s: string)
    TInt(n: int)
    TBool(b: bool)
    TArr(items: List<Toml>)
    TTable(fields: Map<string, Toml>)
}

/// Whether `b` is an ASCII letter.
fn isAlpha(b: int) -> bool {
    (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

/// Whether `b` is an ASCII digit.
fn isDigit(b: int) -> bool {
    b >= 48 && b <= 57
}

/// Whether `b` may appear in a bare key.
fn isKeyByte(b: int) -> bool {
    isAlpha(b) || isDigit(b) || b == 95 || b == 45
}

/// A table value staged from an empty map literal (the empty-map workaround).
fn emptyTable() -> Map<string, Toml> {
    var fields: Map<string, Toml> = { "__proto": Toml.TBool(false) }
    fields.remove("__proto")
    fields
}

/// A typed empty array of values.
fn emptyArray() -> List<Toml> {
    var items: List<Toml> = [Toml.TBool(false)]
    items.remove(0)
    items
}

/// A recursive-descent parser cursor over the document bytes.
class Parser {
    var bs: List<byte>
    var i: int
    var fail: bool

    constructor(text: string) {
        this.bs = bytes(text)
        this.i = 0
        this.fail = false
    }

    /// Byte at the cursor as `int`, or -1 at end of input.
    fn peek() -> int {
        if (this.i >= len(this.bs)) {
            return -1
        }
        this.bs[this.i] as int
    }

    /// Consume and return the byte at the cursor as `int`, or -1.
    fn next() -> int {
        let c = this.peek()
        if (c >= 0) {
            this.i = this.i + 1
        }
        c
    }

    /// Skip spaces and tabs (not newlines).
    fn skipInline() {
        while (true) {
            let c = this.peek()
            if (c == 0x20 || c == 0x09) {
                this.i = this.i + 1
            } else {
                return
            }
        }
    }

    /// Skip whitespace, newlines, and comments.
    fn skipWs() {
        while (true) {
            let c = this.peek()
            if (c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D) {
                this.i = this.i + 1
            } else if (c == 0x23) {
                while (true) {
                    let h = this.peek()
                    if (h < 0 || h == 0x0A) {
                        break
                    }
                    this.i = this.i + 1
                }
            } else {
                return
            }
        }
    }

    /// Require the rest of the line to be blank or a comment.
    fn lineEnd() {
        this.skipInline()
        if (this.peek() == 0x23) {
            while (true) {
                let c = this.peek()
                if (c < 0 || c == 0x0A) {
                    break
                }
                this.i = this.i + 1
            }
        }
        let c = this.peek()
        if (c == 0x0A) {
            this.i = this.i + 1
            return
        }
        if (c < 0) {
            return
        }
        this.fail = true
    }

    /// A dotted key path; an empty list after `fail` is set on error.
    fn parseKeyPath() -> List<string> {
        var out: List<string> = [""]
        out.remove(0)
        this.skipInline()
        while (!this.fail) {
            var seg = bytes("")
            while (true) {
                let c = this.peek()
                if (isKeyByte(c)) {
                    seg.push(c as byte)
                    this.i = this.i + 1
                } else {
                    break
                }
            }
            if (len(seg) == 0) {
                this.fail = true
                return out
            }
            out.push(str(seg))
            this.skipInline()
            if (this.peek() == 0x2E) {
                this.i = this.i + 1
                this.skipInline()
            } else {
                return out
            }
        }
        out
    }

    /// A `"..."` string with the small TOML escape set; sets `fail` on error.
    fn parseBasicString() -> Toml {
        this.i = this.i + 1
        var out = bytes("")
        while (true) {
            let c = this.next()
            if (c < 0 || c == 0x0A) {
                this.fail = true
                return Toml.TBool(false)
            }
            if (c == 0x22) {
                return Toml.TStr(str(out))
            }
            if (c == 0x5C) {
                let e = this.next()
                if (e == 0x6E) {
                    out.push(0x0A as byte)
                } else if (e == 0x74) {
                    out.push(0x09 as byte)
                } else if (e == 0x72) {
                    out.push(0x0D as byte)
                } else if (e == 0x22) {
                    out.push(0x22 as byte)
                } else if (e == 0x5C) {
                    out.push(0x5C as byte)
                } else {
                    this.fail = true
                    return Toml.TBool(false)
                }
            } else {
                out.push(c as byte)
            }
        }
        Toml.TBool(false)
    }

    /// A `'...'` literal string; sets `fail` on error.
    fn parseLiteralString() -> Toml {
        this.i = this.i + 1
        var out = bytes("")
        while (true) {
            let c = this.next()
            if (c < 0 || c == 0x0A) {
                this.fail = true
                return Toml.TBool(false)
            }
            if (c == 0x27) {
                return Toml.TStr(str(out))
            }
            out.push(c as byte)
        }
        Toml.TBool(false)
    }

    /// An integer with an optional sign; sets `fail` on error.
    fn parseInt() -> Toml {
        var sign = 1
        let first = this.peek()
        if (first == 0x2D) {
            sign = 0 - 1
            this.i = this.i + 1
        } else if (first == 0x2B) {
            this.i = this.i + 1
        }
        var n = 0
        var digits = 0
        while (isDigit(this.peek())) {
            n = n * 10 + (this.next() - 48)
            digits = digits + 1
            if (digits > 18) {
                this.fail = true
                return Toml.TBool(false)
            }
        }
        if (digits == 0) {
            this.fail = true
            return Toml.TBool(false)
        }
        Toml.TInt(sign * n)
    }

    /// Whether the literal `w` starts at the cursor, consuming it on a match.
    fn eatWord(w: string) -> bool {
        let want = bytes(w)
        var k = 0
        while (k < len(want)) {
            if (this.peek() != (want[k] as int)) {
                return false
            }
            this.i = this.i + 1
            k = k + 1
        }
        true
    }

    /// An array value (may span lines); sets `fail` on error.
    fn parseArray() -> Toml {
        this.i = this.i + 1
        var items = emptyArray()
        this.skipWs()
        if (this.peek() == 0x5D) {
            this.i = this.i + 1
            return Toml.TArr(items)
        }
        while (!this.fail) {
            let v = this.parseValue()
            if (this.fail) {
                return Toml.TBool(false)
            }
            items.push(v)
            this.skipWs()
            let c = this.peek()
            if (c == 0x2C) {
                this.i = this.i + 1
                this.skipWs()
                if (this.peek() == 0x5D) {
                    this.i = this.i + 1
                    return Toml.TArr(items)
                }
            } else if (c == 0x5D) {
                this.i = this.i + 1
                return Toml.TArr(items)
            } else {
                this.fail = true
                return Toml.TBool(false)
            }
        }
        Toml.TBool(false)
    }

    /// Any value; sets `fail` on error.
    fn parseValue() -> Toml {
        this.skipInline()
        let c = this.peek()
        if (c == 0x22) {
            return this.parseBasicString()
        }
        if (c == 0x27) {
            return this.parseLiteralString()
        }
        if (c == 0x5B) {
            return this.parseArray()
        }
        if (c == 0x74) {
            if (this.eatWord("true")) {
                return Toml.TBool(true)
            }
            this.fail = true
            return Toml.TBool(false)
        }
        if (c == 0x66) {
            if (this.eatWord("false")) {
                return Toml.TBool(false)
            }
            this.fail = true
            return Toml.TBool(false)
        }
        if (c == 0x2D || c == 0x2B || isDigit(c)) {
            return this.parseInt()
        }
        this.fail = true
        Toml.TBool(false)
    }

    /// The document root table, or `none` on any syntax error.
    fn parseDoc() -> Toml? {
        var root = emptyTable()
        var current = root
        while (!this.fail) {
            this.skipWs()
            if (this.fail) {
                break
            }
            let c = this.peek()
            if (c < 0) {
                break
            }
            if (c == 0x5B) {
                this.i = this.i + 1
                if (this.peek() == 0x5B) {
                    this.fail = true
                    break
                }
                let path = this.parseKeyPath()
                this.skipInline()
                if (this.peek() != 0x5D) {
                    this.fail = true
                    break
                }
                this.i = this.i + 1
                var cur = root
                var k = 0
                while (k < len(path) && !this.fail) {
                    cur = this.ensureTable(cur, path[k])
                    k = k + 1
                }
                current = cur
                this.lineEnd()
            } else {
                let path = this.parseKeyPath()
                this.skipInline()
                if (this.peek() != 0x3D) {
                    this.fail = true
                    break
                }
                this.i = this.i + 1
                let v = this.parseValue()
                if (this.fail) {
                    break
                }
                var parent = current
                var k = 0
                while (k < len(path) - 1 && !this.fail) {
                    parent = this.ensureTable(parent, path[k])
                    k = k + 1
                }
                let last = path[len(path) - 1]
                if (parent.has(last)) {
                    this.fail = true
                    break
                }
                parent[last] = v
                this.lineEnd()
            }
        }
        if (this.fail) {
            return none
        }
        Toml.TTable(root)
    }

    /// The table stored at `key`, creating it when absent. A non-table value
    /// sets `fail` and returns a scratch table.
    fn ensureTable(fields: Map<string, Toml>, key: string) -> Map<string, Toml> {
        match (fields.get(key)) {
            case some(Toml.TTable(inner)) -> inner
            case none -> {
                let made = emptyTable()
                fields[key] = Toml.TTable(made)
                made
            }
            case _ -> {
                this.fail = true
                emptyTable()
            }
        }
    }
}

/// Parse a TOML document into its root table; `none` on any syntax error.
fn parse(text: string) -> Toml? {
    let p = Parser(text)
    p.parseDoc()
}

/// The value's TOML type name (`string`, `int`, `bool`, `array`, `table`).
fn typeOf(v: Toml) -> string {
    match (v) {
        case Toml.TStr(_) -> "string"
        case Toml.TInt(_) -> "int"
        case Toml.TBool(_) -> "bool"
        case Toml.TArr(_) -> "array"
        case Toml.TTable(_) -> "table"
    }
}

/// The value as `string?`.
fn asStr(v: Toml) -> string? {
    match (v) {
        case Toml.TStr(s) -> s
        case _ -> none
    }
}

/// The value as `int?`.
fn asInt(v: Toml) -> int? {
    match (v) {
        case Toml.TInt(n) -> n
        case _ -> none
    }
}

/// The value as `bool?`.
fn asBool(v: Toml) -> bool? {
    match (v) {
        case Toml.TBool(b) -> b
        case _ -> none
    }
}

/// Look up `key` in a table value; `none` when absent or not a table.
fn field(v: Toml, key: string) -> Toml? {
    match (v) {
        case Toml.TTable(fields) -> fields.get(key)
        case _ -> none
    }
}

/// The element at index `i` of an array value; `none` when out of range or
/// not an array.
fn at(v: Toml, i: int) -> Toml? {
    match (v) {
        case Toml.TArr(items) -> {
            if (i >= 0 && i < len(items)) {
                return items[i]
            }
            none
        }
        case _ -> none
    }
}

/// The number of elements in an array or keys in a table; 0 for scalars.
fn size(v: Toml) -> int {
    match (v) {
        case Toml.TArr(items) -> len(items)
        case Toml.TTable(fields) -> len(fields)
        case _ -> 0
    }
}

/// The keys of a table value; empty for non-tables. Order is the native
/// `Map`'s, not document order.
fn keysOf(v: Toml) -> List<string> {
    match (v) {
        case Toml.TTable(fields) -> fields.keys()
        case _ -> {
            var out: List<string> = [""]
            out.remove(0)
            out
        }
    }
}
