module std.math.digits_test

import { count, sum, toDigits, fromDigits, reverse, isPalindrome } from std.math.digits

/// A digit list rendered as `[1, 2, 3]`.
fn showDigits(xs: List<int>) -> string {
    var out = "["
    var i = 0
    while (i < len(xs)) {
        if (i > 0) {
            out = out + ", "
        }
        out = out + "{xs[i]}"
        i = i + 1
    }
    out + "]"
}

test fn digit_counts() {
    expect(count(0)).toBe(1)
    expect(count(5)).toBe(1)
    expect(count(9)).toBe(1)
    expect(count(10)).toBe(2)
    expect(count(99)).toBe(2)
    expect(count(100)).toBe(3)
    expect(count(123456)).toBe(6)
    expect(count(-1)).toBe(1)
    expect(count(-12)).toBe(2)
    expect(count(-999)).toBe(3)
}

test fn digit_sums() {
    expect(sum(0)).toBe(0)
    expect(sum(5)).toBe(5)
    expect(sum(10)).toBe(1)
    expect(sum(123)).toBe(6)
    expect(sum(999)).toBe(27)
    expect(sum(1002003)).toBe(6)
    expect(sum(-12)).toBe(3)
    expect(sum(-999)).toBe(27)
}

test fn to_digits_lists() {
    expect(showDigits(toDigits(0))).toBe("[0]")
    expect(showDigits(toDigits(5))).toBe("[5]")
    expect(showDigits(toDigits(10))).toBe("[1, 0]")
    expect(showDigits(toDigits(123))).toBe("[1, 2, 3]")
    expect(showDigits(toDigits(1002003))).toBe("[1, 0, 0, 2, 0, 0, 3]")
    expect(showDigits(toDigits(-42))).toBe("[4, 2]")
}

test fn from_digits_values() {
    expect(fromDigits([0])).toBe(0)
    expect(fromDigits([5])).toBe(5)
    expect(fromDigits([1, 0])).toBe(10)
    expect(fromDigits([1, 2, 3])).toBe(123)
    expect(fromDigits([1, 0, 0, 2, 0, 0, 3])).toBe(1002003)
    expect(fromDigits([0, 0, 7])).toBe(7)
}

test fn from_digits_rejects_invalid_input() {
    var empty: List<int> = [0]
    empty.remove(0)
    expect(fromDigits(empty)).toBe(-1)
    expect(fromDigits([10])).toBe(-1)
    expect(fromDigits([-1])).toBe(-1)
    expect(fromDigits([1, -2, 3])).toBe(-1)
    expect(fromDigits([1, 10, 3])).toBe(-1)
}

test fn round_trips() {
    let values = [0, 1, 9, 10, 11, 42, 99, 100, 12345, 1002003, 987654321]
    var i = 0
    while (i < len(values)) {
        let n = values[i]
        expect(fromDigits(toDigits(n))).toBe(n)
        expect(sum(n) >= 0).toBe(true)
        expect(count(n)).toBe(len(toDigits(n)))
        i = i + 1
    }
}

test fn reversing_digits() {
    expect(reverse(0)).toBe(0)
    expect(reverse(5)).toBe(5)
    expect(reverse(12)).toBe(21)
    expect(reverse(120)).toBe(21)
    expect(reverse(12345)).toBe(54321)
    expect(reverse(1002003)).toBe(3002001)
    expect(reverse(-12)).toBe(-21)
    expect(reverse(-120)).toBe(-21)
}

test fn palindromes() {
    expect(isPalindrome(0)).toBe(true)
    expect(isPalindrome(7)).toBe(true)
    expect(isPalindrome(11)).toBe(true)
    expect(isPalindrome(121)).toBe(true)
    expect(isPalindrome(12321)).toBe(true)
    expect(isPalindrome(10)).toBe(false)
    expect(isPalindrome(123)).toBe(false)
    expect(isPalindrome(1231)).toBe(false)
    expect(isPalindrome(-121)).toBe(false)
}
