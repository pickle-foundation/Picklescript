module std.math.collatz_test

import { steps, sequence, peak } from std.math.collatz

/// An int list rendered as `[1, 2, 3]`.
fn showInts(xs: List<int>) -> string {
    var out = "["
    var i = 0
    while (i < len(xs)) {
        if (i > 0) {
            out = out + ", "
        }
        out = out + "{xs[i]}"
        i = i + 1
    }
    out + "]"
}

test fn base_cases() {
    expect(steps(1)).toBe(0)
    expect(steps(2)).toBe(1)
    expect(steps(4)).toBe(2)
    expect(peak(1)).toBe(1)
    expect(peak(2)).toBe(2)
    expect(peak(4)).toBe(4)
    expect(showInts(sequence(1))).toBe("[1]")
    expect(showInts(sequence(2))).toBe("[2, 1]")
    expect(showInts(sequence(4))).toBe("[4, 2, 1]")
}

test fn known_step_counts() {
    expect(steps(3)).toBe(7)
    expect(steps(6)).toBe(8)
    expect(steps(7)).toBe(16)
    expect(steps(9)).toBe(19)
    expect(steps(27)).toBe(111)
    expect(steps(97)).toBe(118)
}

test fn known_peaks() {
    expect(peak(3)).toBe(16)
    expect(peak(6)).toBe(16)
    expect(peak(7)).toBe(52)
    expect(peak(9)).toBe(52)
    expect(peak(27)).toBe(9232)
}

test fn sequences_end_at_one() {
    expect(showInts(sequence(3))).toBe("[3, 10, 5, 16, 8, 4, 2, 1]")
    expect(showInts(sequence(6))).toBe("[6, 3, 10, 5, 16, 8, 4, 2, 1]")
    expect(showInts(sequence(7))).toBe("[7, 22, 11, 34, 17, 52, 26, 13, 40, 20, 10, 5, 16, 8, 4, 2, 1]")
    let s27 = sequence(27)
    expect(len(s27)).toBe(112)
    expect(s27[0]).toBe(27)
    expect(s27[111]).toBe(1)
}

test fn invalid_inputs() {
    expect(steps(0)).toBe(-1)
    expect(steps(-1)).toBe(-1)
    expect(steps(-10)).toBe(-1)
    expect(peak(0)).toBe(-1)
    expect(peak(-5)).toBe(-1)
    expect(showInts(sequence(0))).toBe("[]")
    expect(showInts(sequence(-3))).toBe("[]")
}

test fn consistency() {
    let values = [1, 2, 3, 5, 6, 7, 9, 12, 19, 27]
    var i = 0
    while (i < len(values)) {
        let n = values[i]
        let seq = sequence(n)
        expect(steps(n)).toBe(len(seq) - 1)
        expect(seq[0]).toBe(n)
        expect(seq[len(seq) - 1]).toBe(1)
        var maxv = n
        var j = 0
        while (j < len(seq)) {
            if (seq[j] > maxv) {
                maxv = seq[j]
            }
            j = j + 1
        }
        expect(peak(n)).toBe(maxv)
        i = i + 1
    }
}
