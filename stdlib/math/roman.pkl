module std.math.roman

// Roman numerals with the standard subtractive notation.
//
// Only the classic range 1..3999 is accepted: classical Roman numerals have no
// zero, and the usual upper bound comes from writing 1000 as `M` at most three
// times. `toRoman` returns `none` outside that range. `fromRoman` is strict: it
// rejects unknown characters, leftover text, and non-canonical spellings such
// as `IIII`, `VV`, or `IC`, because it re-encodes the parsed value and requires
// the result to equal the input. That means every accepted string is exactly
// what `toRoman` would produce for its value.
//
// Parsing is greedy over the descending pairs `M CM D CD C XC L XL X IX V IV I`,
// which is unambiguous once the canonical-form check is applied.

/// Numeric values of the roman tokens, largest first.
fn tokenValues() -> List<int> {
    [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
}

/// Roman tokens matching `tokenValues`, including the subtractive pairs.
fn tokenTexts() -> List<string> {
    ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
}

/// Whether `text` matches the bytes of `token` starting at `at`.
fn matchesAt(text: List<byte>, token: string, at: int) -> bool {
    let tb = bytes(token)
    if (at < 0 || at + len(tb) > len(text)) {
        return false
    }
    var i = 0
    while (i < len(tb)) {
        if (text[at + i] != tb[i]) {
            return false
        }
        i = i + 1
    }
    true
}

/// The canonical Roman spelling of `n` in 1..3999 (empty otherwise).
fn spell(n: int) -> string {
    if (n < 1 || n > 3999) {
        return ""
    }
    let values = tokenValues()
    let texts = tokenTexts()
    var rest = n
    var out = ""
    var i = 0
    while (i < len(values)) {
        while (rest >= values[i]) {
            out = out + texts[i]
            rest = rest - values[i]
        }
        i = i + 1
    }
    out
}

/// The Roman numeral for `n`, or `none` when `n` is outside 1..3999.
fn toRoman(n: int) -> string? {
    if (n < 1 || n > 3999) {
        return none
    }
    spell(n)
}

/// The value of canonical Roman numeral `text`, or `none` when it is not one.
fn fromRoman(text: string) -> int? {
    let bs = bytes(text)
    if (len(bs) == 0) {
        return none
    }
    let values = tokenValues()
    let texts = tokenTexts()
    var value = 0
    var p = 0
    var i = 0
    while (i < len(values)) {
        while (matchesAt(bs, texts[i], p)) {
            value = value + values[i]
            p = p + len(bytes(texts[i]))
        }
        i = i + 1
    }
    if (p != len(bs)) {
        return none
    }
    if (spell(value) != text) {
        return none
    }
    value
}

/// Whether `text` is a canonical Roman numeral in the supported range.
fn isRoman(text: string) -> bool {
    match (fromRoman(text)) {
    case some(_) -> true
    case none -> false
    }
}
