module std.math.isqrt_test

import { isqrt, isSquare } from std.math.isqrt

test fn base_cases() {
    expect(isqrt(0)).toBe(0)
    expect(isqrt(1)).toBe(1)
    expect(isqrt(2)).toBe(1)
    expect(isqrt(3)).toBe(1)
    expect(isqrt(4)).toBe(2)
    expect(isqrt(5)).toBe(2)
    expect(isqrt(8)).toBe(2)
    expect(isqrt(9)).toBe(3)
    expect(isqrt(10)).toBe(3)
}

test fn perfect_squares() {
    expect(isqrt(16)).toBe(4)
    expect(isqrt(25)).toBe(5)
    expect(isqrt(36)).toBe(6)
    expect(isqrt(100)).toBe(10)
    expect(isqrt(121)).toBe(11)
    expect(isqrt(144)).toBe(12)
    expect(isqrt(10000)).toBe(100)
    expect(isqrt(1000000)).toBe(1000)
}

test fn large_values() {
    expect(isqrt(2147395600)).toBe(46340)
    expect(isqrt(2147483647)).toBe(46340)
    expect(isqrt(9999999999)).toBe(99999)
    expect(isqrt(10000000000)).toBe(100000)
    expect(isqrt(1000000000000)).toBe(1000000)
}

test fn negative_input() {
    expect(isqrt(-1)).toBe(-1)
    expect(isqrt(-4)).toBe(-1)
    expect(isqrt(-100)).toBe(-1)
}

test fn is_square_predicate() {
    expect(isSquare(0)).toBe(true)
    expect(isSquare(1)).toBe(true)
    expect(isSquare(2)).toBe(false)
    expect(isSquare(3)).toBe(false)
    expect(isSquare(4)).toBe(true)
    expect(isSquare(15)).toBe(false)
    expect(isSquare(16)).toBe(true)
    expect(isSquare(99)).toBe(false)
    expect(isSquare(100)).toBe(true)
    expect(isSquare(-1)).toBe(false)
    expect(isSquare(-4)).toBe(false)
}

test fn consistency() {
    var n = 0
    while (n <= 200) {
        let r = isqrt(n)
        expect(r * r <= n).toBe(true)
        expect((r + 1) * (r + 1) > n).toBe(true)
        expect(isSquare(n)).toBe(r * r == n)
        n = n + 1
    }
    let squares = [0, 1, 4, 9, 16, 25, 49, 64, 81, 625, 9801, 998001]
    var i = 0
    while (i < len(squares)) {
        expect(isSquare(squares[i])).toBe(true)
        i = i + 1
    }
}
