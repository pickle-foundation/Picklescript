module std.math.ipow

// Integer exponentiation.
//
// `pow(base, exp)` returns `base` raised to `exp` for `exp >= 0` (with
// `pow(0, 0) == 1`). Negative exponents are not representable as integers and
// return `0`.

/// `base` raised to the non-negative integer power `exp`.
fn pow(base: int, exp: int) -> int {
    if (exp < 0) {
        return 0
    }
    var result = 1
    var b = base
    var e = exp
    while (e > 0) {
        if (e % 2 == 1) {
            result = result * b
        }
        b = b * b
        e = e / 2
    }
    result
}

/// `true` if `n` is an integer power of two (`n >= 1` and of the form 2^k).
fn isPowerOfTwo(n: int) -> bool {
    if (n < 1) {
        return false
    }
    var x = n
    while (x % 2 == 0) {
        x = x / 2
    }
    x == 1
}
