module std.math.complex

// Complex numbers over `float`.
//
// A `Complex` holds a real and an imaginary part and behaves as a value: every
// operation returns a new number and never mutates its inputs. Arithmetic is
// plain IEEE addition, subtraction, multiplication, and division in a fixed
// order, so results are bit-identical across implementations. The magnitude
// uses the same fixed-iteration Newton square root as `std.math.vector`, so
// compare computed magnitudes with a tolerance.
//
// Division by zero (including `0 + 0i`) returns `none`; every other operation
// is total.

/// A complex number `re + im * i`.
class Complex {
    var re: float
    var im: float

    constructor(re: float, im: float) {
        this.re = re
        this.im = im
    }
}

/// The absolute value of `x`.
fn fabs(x: float) -> float {
    if (x < 0.0) {
        return 0.0 - x
    }
    x
}

/// The square root of `x` by Newton's method (fixed 64 halvings); returns 0
/// for `x <= 0`.
fn sqrt(x: float) -> float {
    if (x <= 0.0) {
        return 0.0
    }
    var guess = x
    if (guess < 1.0) {
        guess = 1.0
    }
    var i = 0
    while (i < 64) {
        guess = 0.5 * (guess + x / guess)
        i = i + 1
    }
    guess
}

/// `0 + 0i`.
fn zero() -> Complex {
    Complex(0.0, 0.0)
}

/// `1 + 0i`.
fn one() -> Complex {
    Complex(1.0, 0.0)
}

/// `0 + 1i`.
fn imaginaryUnit() -> Complex {
    Complex(0.0, 1.0)
}

/// `a + b`.
fn add(a: Complex, b: Complex) -> Complex {
    Complex(a.re + b.re, a.im + b.im)
}

/// `a - b`.
fn sub(a: Complex, b: Complex) -> Complex {
    Complex(a.re - b.re, a.im - b.im)
}

/// `a * b`.
fn mul(a: Complex, b: Complex) -> Complex {
    Complex(a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re)
}

/// `a / b`; `none` when `b` is zero.
fn div(a: Complex, b: Complex) -> Complex? {
    let d = b.re * b.re + b.im * b.im
    if (d == 0.0) {
        return none
    }
    Complex((a.re * b.re + a.im * b.im) / d, (a.im * b.re - a.re * b.im) / d)
}

/// `-a`.
fn neg(a: Complex) -> Complex {
    Complex(0.0 - a.re, 0.0 - a.im)
}

/// The complex conjugate `re - im * i`.
fn conj(a: Complex) -> Complex {
    Complex(a.re, 0.0 - a.im)
}

/// `a` scaled by the real factor `k`.
fn scale(a: Complex, k: float) -> Complex {
    Complex(a.re * k, a.im * k)
}

/// The squared magnitude `re^2 + im^2`.
fn normSquared(a: Complex) -> float {
    a.re * a.re + a.im * a.im
}

/// The magnitude `|a|`.
fn magnitude(a: Complex) -> float {
    sqrt(normSquared(a))
}

/// Whether both parts are exactly equal.
fn equals(a: Complex, b: Complex) -> bool {
    a.re == b.re && a.im == b.im
}

/// Whether both parts differ by at most `eps`.
fn approxEq(a: Complex, b: Complex, eps: float) -> bool {
    fabs(a.re - b.re) <= eps && fabs(a.im - b.im) <= eps
}

/// `real` when the imaginary part is zero, and `(re, im)` otherwise.
fn render(a: Complex) -> string {
    if (a.im == 0.0) {
        return "{a.re}"
    }
    "({a.re}, {a.im})"
}
