module std.math.digits

// Decimal digit operations on integers.
//
// All functions operate on base-10 digits. Negative inputs are treated by their
// absolute value where a digit sequence is required: `count(-12)` is 2 and
// `sum(-12)` is 3. `fromDigits` builds a non-negative integer from a
// most-significant-first digit list and returns `-1` for an empty list or any
// value outside 0-9.

/// The absolute value of `n`.
fn absVal(n: int) -> int {
    if (n < 0) {
        return 0 - n
    }
    n
}

/// The number of decimal digits in `n` (at least 1).
fn count(n: int) -> int {
    var x = absVal(n)
    var c = 1
    while (x >= 10) {
        x = x / 10
        c = c + 1
    }
    c
}

/// The sum of the decimal digits of `n`.
fn sum(n: int) -> int {
    var x = absVal(n)
    var total = 0
    while (x > 0) {
        total = total + (x % 10)
        x = x / 10
    }
    total
}

/// The decimal digits of `n`, most significant first.
fn toDigits(n: int) -> List<int> {
    var x = absVal(n)
    if (x == 0) {
        return [0]
    }
    var rev: List<int> = [0]
    rev.remove(0)
    while (x > 0) {
        rev.push(x % 10)
        x = x / 10
    }
    var out: List<int> = [0]
    out.remove(0)
    var i = len(rev) - 1
    while (i >= 0) {
        out.push(rev[i])
        i = i - 1
    }
    out
}

/// The integer value of a most-significant-first digit list, or `-1` if the
/// list is empty or contains a value outside 0-9.
fn fromDigits(ds: List<int>) -> int {
    if (len(ds) == 0) {
        return -1
    }
    var n = 0
    var i = 0
    while (i < len(ds)) {
        let d = ds[i]
        if (d < 0 || d > 9) {
            return -1
        }
        n = n * 10 + d
        i = i + 1
    }
    n
}

/// The reversed integer formed by the decimal digits of `n`, preserving sign.
fn reverse(n: int) -> int {
    let sign = if (n < 0) { -1 } else { 1 }
    var x = absVal(n)
    var out = 0
    while (x > 0) {
        out = out * 10 + (x % 10)
        x = x / 10
    }
    sign * out
}

/// `true` if `n` reads the same forward and backward in base 10.
fn isPalindrome(n: int) -> bool {
    if (n < 0) {
        return false
    }
    reverse(n) == n
}
