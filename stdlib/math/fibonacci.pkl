module std.math.fibonacci

// Fibonacci numbers.
//
// The sequence is defined by `fib(0) = 0`, `fib(1) = 1`, and
// `fib(n) = fib(n - 1) + fib(n - 2)` for `n >= 2`. Negative indices are
// invalid and reported as `-1` by `fib`.

/// The `n`th Fibonacci number, or `-1` if `n < 0`.
fn fib(n: int) -> int {
    if (n < 0) {
        return -1
    }
    if (n == 0) {
        return 0
    }
    var a = 0
    var b = 1
    var i = 1
    while (i < n) {
        let next = a + b
        a = b
        b = next
        i = i + 1
    }
    b
}

/// The first `n` Fibonacci numbers, starting at `fib(0)`.
/// Returns an empty list if `n <= 0`.
fn sequence(n: int) -> List<int> {
    var out: List<int> = [0]
    out.remove(0)
    if (n <= 0) {
        return out
    }
    out.push(0)
    if (n == 1) {
        return out
    }
    out.push(1)
    var a = 0
    var b = 1
    var i = 2
    while (i < n) {
        let next = a + b
        out.push(next)
        a = b
        b = next
        i = i + 1
    }
    out
}

/// `true` if `n` is a Fibonacci number (non-negative).
fn isFib(n: int) -> bool {
    if (n < 0) {
        return false
    }
    var a = 0
    var b = 1
    while (a < n) {
        let next = a + b
        a = b
        b = next
    }
    a == n
}
