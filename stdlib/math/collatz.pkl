module std.math.collatz

// Collatz (3n + 1) sequence utilities.
//
// For a positive integer `n`, one step maps an even value to `n / 2` and an odd
// value to `3 * n + 1`. The total stopping time is the number of steps needed
// to reach 1 (defined as 0 for `n == 1`). Inputs less than 1 are invalid and
// reported as `-1` by `steps` and as an empty list by `sequence`.

/// The number of Collatz steps from `n` to reach 1, or `-1` if `n < 1`.
fn steps(n: int) -> int {
    if (n < 1) {
        return -1
    }
    var x = n
    var count = 0
    while (x != 1) {
        if (x % 2 == 0) {
            x = x / 2
        } else {
            x = 3 * x + 1
        }
        count = count + 1
    }
    count
}

/// The Collatz sequence starting at `n` and ending at 1, inclusive.
/// Returns an empty list if `n < 1`.
fn sequence(n: int) -> List<int> {
    var out: List<int> = [0]
    out.remove(0)
    if (n < 1) {
        return out
    }
    var x = n
    out.push(x)
    while (x != 1) {
        if (x % 2 == 0) {
            x = x / 2
        } else {
            x = 3 * x + 1
        }
        out.push(x)
    }
    out
}

/// The maximum value reached in the Collatz sequence starting at `n`,
/// or `-1` if `n < 1`.
fn peak(n: int) -> int {
    if (n < 1) {
        return -1
    }
    var x = n
    var best = x
    while (x != 1) {
        if (x % 2 == 0) {
            x = x / 2
        } else {
            x = 3 * x + 1
        }
        if (x > best) {
            best = x
        }
    }
    best
}
