module std.math.basic_test

import { isNan, isInfinite, isFinite, isIntegral, floor, ceil, trunc, frac,
         round, sign, gcd, lcm, isqrt, floorDiv, floorMod } from std.math.basic

test fn nan_and_infinity() {
    let nan = (1.0 / 0.0) - (1.0 / 0.0)
    let inf = 1.0 / 0.0
    expect(isNan(nan)).toBe(true)
    expect(isNan(1.0)).toBe(false)
    expect(isInfinite(inf)).toBe(true)
    expect(isInfinite(0.0 - inf)).toBe(true)
    expect(isInfinite(1000000000000000000000000000000.0)).toBe(false)
    expect(isFinite(1.0)).toBe(true)
    expect(isFinite(inf)).toBe(false)
    expect(isFinite(nan)).toBe(false)
}

test fn integrality() {
    expect(isIntegral(3.0)).toBe(true)
    expect(isIntegral(0.0 - 3.0)).toBe(true)
    expect(isIntegral(3.5)).toBe(false)
    expect(isIntegral(9007199254740994.0)).toBe(true)
    expect(isIntegral(1.0 / 0.0)).toBe(false)
    expect(isIntegral((1.0 / 0.0) - (1.0 / 0.0))).toBe(false)
}

test fn floor_and_ceil() {
    expect(floor(2.7)).toBe(2.0)
    expect(floor(0.0 - 2.1)).toBe(0.0 - 3.0)
    expect(floor(3.0)).toBe(3.0)
    expect(floor(0.0)).toBe(0.0)
    expect(ceil(2.1)).toBe(3.0)
    expect(ceil(0.0 - 2.7)).toBe(0.0 - 2.0)
    expect(ceil(3.0)).toBe(3.0)
    expect(ceil(0.0)).toBe(0.0)
}

test fn truncation_and_fraction() {
    expect(trunc(2.7)).toBe(2.0)
    expect(trunc(0.0 - 2.7)).toBe(0.0 - 2.0)
    expect(frac(2.25)).toBe(0.25)
    expect(frac(0.0 - 2.25)).toBe(0.0 - 0.25)
    expect(frac(3.0)).toBe(0.0)
}

test fn rounding_halves_away_from_zero() {
    expect(round(2.4)).toBe(2.0)
    expect(round(2.5)).toBe(3.0)
    expect(round(2.6)).toBe(3.0)
    expect(round(0.0 - 2.4)).toBe(0.0 - 2.0)
    expect(round(0.0 - 2.5)).toBe(0.0 - 3.0)
    expect(round(0.0 - 2.6)).toBe(0.0 - 3.0)
    expect(round(0.0)).toBe(0.0)
}

test fn sign_values() {
    expect(sign(3.5)).toBe(1)
    expect(sign(0.0 - 3.5)).toBe(0 - 1)
    expect(sign(0.0)).toBe(0)
    expect(sign(0.0 * (0.0 - 1.0))).toBe(0)
    expect(sign((1.0 / 0.0) - (1.0 / 0.0))).toBe(0)
}

test fn gcd_and_lcm() {
    expect(gcd(12, 18)).toBe(6)
    expect(gcd(0 - 12, 18)).toBe(6)
    expect(gcd(18, 0 - 12)).toBe(6)
    expect(gcd(0, 7)).toBe(7)
    expect(gcd(0, 0)).toBe(0)
    expect(lcm(4, 6)).toBe(12)
    expect(lcm(0 - 4, 6)).toBe(12)
    expect(lcm(0, 5)).toBe(0)
    expect(lcm(7, 13)).toBe(91)
}

test fn integer_square_root() {
    expect(isqrt(0)).toBe(0)
    expect(isqrt(1)).toBe(1)
    expect(isqrt(2)).toBe(1)
    expect(isqrt(3)).toBe(1)
    expect(isqrt(4)).toBe(2)
    expect(isqrt(15)).toBe(3)
    expect(isqrt(16)).toBe(4)
    expect(isqrt(17)).toBe(4)
    expect(isqrt(999999)).toBe(999)
    expect(isqrt(1000000)).toBe(1000)
    expect(isqrt(0 - 9)).toBe(0)
}

test fn floor_division_and_modulo() {
    expect(floorDiv(7, 2)).toBe(3)
    expect(floorDiv(0 - 7, 2)).toBe(0 - 4)
    expect(floorDiv(7, 0 - 2)).toBe(0 - 4)
    expect(floorDiv(0 - 7, 0 - 2)).toBe(3)
    expect(floorDiv(8, 4)).toBe(2)
    expect(floorMod(7, 2)).toBe(1)
    expect(floorMod(0 - 7, 2)).toBe(1)
    expect(floorMod(7, 0 - 2)).toBe(0 - 1)
    expect(floorMod(0 - 7, 0 - 2)).toBe(0 - 1)
    expect(floorMod(8, 4)).toBe(0)
}

test fn large_magnitudes_are_already_integral() {
    let big = 9007199254740994.0
    expect(floor(big)).toBe(big)
    expect(ceil(big)).toBe(big)
    expect(trunc(big)).toBe(big)
    expect(round(big)).toBe(big)
    expect(floor(0.0 - big)).toBe(0.0 - big)
    expect(ceil(0.0 - big)).toBe(0.0 - big)
}
