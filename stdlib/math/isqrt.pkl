module std.math.isqrt

// Integer square root.
//
// `isqrt(n)` returns the largest integer `r >= 0` such that `r * r <= n`,
// for `n >= 0`. Negative inputs return `-1`.
// `isSquare(n)` reports whether `n` is a non-negative perfect square.

/// Floor of the square root of `n`, or `-1` if `n < 0`.
fn isqrt(n: int) -> int {
    if (n < 0) {
        return -1
    }
    if (n < 2) {
        return n
    }
    // Newton's method on integers, starting above the root.
    var x = n
    var y = (x + 1) / 2
    while (y < x) {
        x = y
        y = (x + n / x) / 2
    }
    x
}

/// `true` if `n` is a non-negative perfect square.
fn isSquare(n: int) -> bool {
    if (n < 0) {
        return false
    }
    let r = isqrt(n)
    r * r == n
}
