module std.collections.bitset_test

import { BitSet } from std.collections.bitset

test fn fresh_set_is_empty() {
    let bs = BitSet(10)
    expect(bs.bitCount()).toBe(10)
    expect(bs.byteCount()).toBe(2)
    expect(bs.count()).toBe(0)
    expect(bs.isEmpty()).toBe(true)
    expect(bs.isFull()).toBe(false)
    expect(bs.get(0)).toBe(false)
    expect(bs.get(9)).toBe(false)
}

test fn set_across_byte_boundaries() {
    let bs = BitSet(20)
    let bits: List<int> = [0, 7, 8, 15, 16, 19]
    for (i in bits) {
        bs.set(i)
    }
    expect(bs.count()).toBe(6)
    for (i in bits) {
        expect(bs.get(i)).toBe(true)
    }
    expect(bs.get(1)).toBe(false)
    expect(bs.get(6)).toBe(false)
    expect(bs.get(9)).toBe(false)
    expect(bs.get(18)).toBe(false)
    expect(bs.byteCount()).toBe(3)
}

test fn clearing_and_toggling() {
    let bs = BitSet(8)
    bs.set(3)
    bs.set(5)
    bs.clear(3)
    expect(bs.get(3)).toBe(false)
    expect(bs.get(5)).toBe(true)
    bs.flip(5)
    expect(bs.get(5)).toBe(false)
    bs.flip(2)
    expect(bs.get(2)).toBe(true)
    bs.setTo(2, false)
    expect(bs.get(2)).toBe(false)
    bs.setTo(2, true)
    bs.setTo(2, true)
    expect(bs.get(2)).toBe(true)
    expect(bs.count()).toBe(1)
}

test fn out_of_range_is_ignored() {
    let bs = BitSet(4)
    bs.set(0 - 1)
    bs.set(4)
    bs.set(999)
    expect(bs.count()).toBe(0)
    expect(bs.get(0 - 1)).toBe(false)
    expect(bs.get(4)).toBe(false)
    bs.setAll()
    expect(bs.count()).toBe(4)
    bs.clear(0 - 1)
    bs.clear(4)
    expect(bs.count()).toBe(4)
    expect(bs.nextSetBit(4)).toBe(0 - 1)
}

test fn count_tracks_set_bits() {
    let bs = BitSet(30)
    expect(bs.count()).toBe(0)
    bs.set(29)
    expect(bs.count()).toBe(1)
    bs.set(0)
    expect(bs.count()).toBe(2)
    bs.set(0)
    expect(bs.count()).toBe(2)
    bs.clear(0)
    expect(bs.count()).toBe(1)
    bs.clearAll()
    expect(bs.count()).toBe(0)
}

test fn set_all_keeps_padding_zero() {
    let bs = BitSet(10)
    bs.setAll()
    expect(bs.count()).toBe(10)
    expect(bs.isFull()).toBe(true)
    let expected: List<byte> = [255 as byte, 3 as byte]
    expect(bs.toBytes()).toEqual(expected)
    bs.clearAll()
    expect(bs.isFull()).toBe(false)
    expect(bs.isEmpty()).toBe(true)
    let zeroed: List<byte> = [0 as byte, 0 as byte]
    expect(bs.toBytes()).toEqual(zeroed)
}

test fn flip_all_inverts_every_bit() {
    let bs = BitSet(9)
    bs.set(0)
    bs.set(8)
    bs.flipAll()
    expect(bs.count()).toBe(7)
    expect(bs.get(0)).toBe(false)
    expect(bs.get(8)).toBe(false)
    expect(bs.get(1)).toBe(true)
    bs.flipAll()
    expect(bs.count()).toBe(2)
    expect(bs.get(0)).toBe(true)
    expect(bs.get(8)).toBe(true)
}

test fn next_bit_queries() {
    let bs = BitSet(12)
    expect(bs.nextSetBit(0)).toBe(0 - 1)
    expect(bs.nextSetBit(5)).toBe(0 - 1)
    expect(bs.nextClearBit(0)).toBe(0)
    expect(bs.nextClearBit(5)).toBe(5)
    bs.set(2)
    bs.set(3)
    bs.set(9)
    expect(bs.nextSetBit(0)).toBe(2)
    expect(bs.nextSetBit(2)).toBe(2)
    expect(bs.nextSetBit(3)).toBe(3)
    expect(bs.nextSetBit(4)).toBe(9)
    expect(bs.nextSetBit(10)).toBe(0 - 1)
    expect(bs.nextSetBit(0 - 5)).toBe(2)
    expect(bs.nextClearBit(2)).toBe(4)
    expect(bs.nextClearBit(0 - 5)).toBe(0)
    bs.setAll()
    expect(bs.nextClearBit(0)).toBe(0 - 1)
    expect(bs.nextSetBit(12)).toBe(0 - 1)
}

test fn string_rendering() {
    expect(BitSet(4).toString()).toBe("0000")
    let bs = BitSet(4)
    bs.set(0)
    bs.set(3)
    expect(bs.toString()).toBe("1001")
    let wide = BitSet(9)
    wide.set(1)
    wide.set(8)
    expect(wide.toString()).toBe("010000001")
    expect(BitSet(0).toString()).toBe("")
}

test fn zero_size_set_is_empty_and_full() {
    let bs = BitSet(0)
    expect(bs.bitCount()).toBe(0)
    expect(bs.byteCount()).toBe(0)
    expect(bs.count()).toBe(0)
    expect(bs.isEmpty()).toBe(true)
    expect(bs.isFull()).toBe(true)
    expect(bs.get(0)).toBe(false)
    bs.set(0)
    bs.flipAll()
    expect(bs.count()).toBe(0)
    expect(bs.nextSetBit(0)).toBe(0 - 1)
    expect(bs.nextClearBit(0)).toBe(0 - 1)
    expect(bs.toBytes()).toEqual(bytes(""))
}
