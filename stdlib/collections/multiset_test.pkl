module std.collections.multiset_test

import { Multiset, unionOf } from std.collections.multiset

test fn fresh_multiset_is_empty() {
    let m = Multiset<int>(0)
    expect(m.size()).toBe(0)
    expect(m.uniqueSize()).toBe(0)
    expect(m.contains(1)).toBe(false)
    expect(m.countOf(1)).toBe(0)
    expect(len(m.keys())).toBe(0)
    expect(len(m.toList())).toBe(0)
}

test fn adds_keep_counts() {
    let m = Multiset<string>("")
    m.add("a")
    m.add("b")
    m.add("a")
    expect(m.size()).toBe(3)
    expect(m.uniqueSize()).toBe(2)
    expect(m.countOf("a")).toBe(2)
    expect(m.countOf("b")).toBe(1)
    expect(m.countOf("c")).toBe(0)
    expect(m.contains("a")).toBe(true)
    expect(m.contains("c")).toBe(false)
}

test fn add_n_adds_batches() {
    let m = Multiset<int>(0)
    m.addN(7, 4)
    m.addN(8, 2)
    m.addN(7, 1)
    expect(m.countOf(7)).toBe(5)
    expect(m.countOf(8)).toBe(2)
    expect(m.size()).toBe(7)
    m.addN(9, 0)
    m.addN(9, 0 - 3)
    expect(m.contains(9)).toBe(false)
    expect(m.size()).toBe(7)
}

test fn remove_drops_one_occurrence() {
    let m = Multiset<int>(0)
    m.addN(5, 3)
    expect(m.remove(5)).toBe(true)
    expect(m.countOf(5)).toBe(2)
    expect(m.size()).toBe(2)
    expect(m.remove(5)).toBe(true)
    expect(m.remove(5)).toBe(true)
    expect(m.countOf(5)).toBe(0)
    expect(m.contains(5)).toBe(false)
    expect(m.remove(5)).toBe(false)
    expect(m.uniqueSize()).toBe(0)
}

test fn remove_all_reports_count() {
    let m = Multiset<int>(0)
    m.addN(1, 5)
    m.add(2)
    expect(m.removeAll(1)).toBe(5)
    expect(m.countOf(1)).toBe(0)
    expect(m.removeAll(1)).toBe(0)
    expect(m.size()).toBe(1)
    expect(m.countOf(2)).toBe(1)
}

test fn keys_follow_first_insertion_order() {
    let m = Multiset<string>("")
    m.add("z")
    m.add("a")
    m.add("z")
    m.add("m")
    let k = m.keys()
    expect(len(k)).toBe(3)
    expect(k[0]).toBe("z")
    expect(k[1]).toBe("a")
    expect(k[2]).toBe("m")
}

test fn to_list_expands_occurrences() {
    let m = Multiset<int>(0)
    m.addN(4, 2)
    m.add(9)
    m.addN(4, 1)
    let xs = m.toList()
    expect(len(xs)).toBe(4)
    expect(xs[0]).toBe(4)
    expect(xs[1]).toBe(4)
    expect(xs[2]).toBe(4)
    expect(xs[3]).toBe(9)
}

test fn clear_resets_everything() {
    let m = Multiset<int>(0)
    m.addN(1, 2)
    m.add(2)
    m.clear()
    expect(m.size()).toBe(0)
    expect(m.uniqueSize()).toBe(0)
    expect(m.contains(1)).toBe(false)
    m.add(3)
    expect(m.countOf(3)).toBe(1)
}

test fn union_sums_counts() {
    let a = Multiset<int>(0)
    a.addN(1, 2)
    a.add(2)
    let b = Multiset<int>(0)
    b.addN(2, 3)
    b.add(3)
    let u = unionOf(a, b)
    expect(u.countOf(1)).toBe(2)
    expect(u.countOf(2)).toBe(4)
    expect(u.countOf(3)).toBe(1)
    expect(u.size()).toBe(7)
    expect(u.uniqueSize()).toBe(3)
    expect(a.size()).toBe(3)
    expect(b.size()).toBe(4)
}

test fn union_with_empty_sides() {
    let empty = Multiset<int>(0)
    let full = Multiset<int>(0)
    full.addN(6, 2)
    expect(unionOf(empty, full).countOf(6)).toBe(2)
    expect(unionOf(full, empty).countOf(6)).toBe(2)
    expect(unionOf(empty, empty).size()).toBe(0)
}
