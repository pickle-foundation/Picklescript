module std.text.words

// Word-level text analysis: tokenization, whitespace normalization, sorted
// vocabularies, frequency tables, n-grams, and set-similarity measures.
//
// A *token* is a maximal run of ASCII letters, ASCII digits, `_`, or bytes
// >= 0x80 (so UTF-8 letters stay intact). Every other byte is a separator.
// Unlike `std.text.casing.splitWords`, tokens never split on case boundaries,
// so `fooBar` is one token; use the casing module when identifiers are the
// input. `splitWhitespace` instead splits on `space`, `\t`, `\n`, `\r`, `\v`,
// and `\f` only, keeping punctuation attached.
//
// Frequency tables order by descending count and then by ascending word, and
// `ngrams` keeps source order, so every result is deterministic. Similarity
// measures compare *sets* of distinct tokens (repetitions count once) and
// return `float` ratios: `jaccard` is `|A n B| / |A u B|`, `dice` is
// `2|A n B| / (|A| + |B|)`, and two empty inputs are defined as identical
// (1.0) while one empty input scores 0.0.

import { StringBuilder } from std.text.stringbuilder

/// A word and how often it occurred.
class WordCount {
    var word: string
    var count: int

    constructor(word: string, count: int) {
        this.word = word
        this.count = count
    }
}

/// A typed empty list of strings.
fn emptyStrings() -> List<string> {
    var out: List<string> = [""]
    out.remove(0)
    out
}

/// A typed empty list of counts.
fn emptyCounts() -> List<WordCount> {
    var out: List<WordCount> = [WordCount("", 0)]
    out.remove(0)
    out
}

/// Whether byte `b` ends or separates a token.
fn isTokenByte(b: int) -> bool {
    if (b >= 0x80) {
        return true
    }
    if (b >= 0x41 && b <= 0x5A) {
        return true
    }
    if (b >= 0x61 && b <= 0x7A) {
        return true
    }
    if (b >= 0x30 && b <= 0x39) {
        return true
    }
    b == 0x5F
}

/// Whether byte `b` is ASCII whitespace (`space`, `\t`, `\n`, `\r`, `\v`,
/// `\f`).
fn isSpaceByte(b: int) -> bool {
    b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0D || b == 0x0B || b == 0x0C
}

/// The bytes `bs[lo..hi)` as a string.
fn sliceOf(bs: List<byte>, lo: int, hi: int) -> string {
    let out = bytes("")
    var i = lo
    while (i < hi) {
        out.push(bs[i])
        i = i + 1
    }
    str(out)
}

/// The tokens of `text`: maximal runs of letters, digits, `_`, and non-ASCII
/// bytes. Case boundaries do not split tokens.
fn tokens(text: string) -> List<string> {
    var out = emptyStrings()
    let bs = bytes(text)
    let n = len(bs)
    var start = 0 - 1
    var i = 0
    while (i < n) {
        if (!isTokenByte(bs[i] as int)) {
            if (start >= 0) {
                out.push(sliceOf(bs, start, i))
                start = 0 - 1
            }
            i = i + 1
            continue
        }
        if (start < 0) {
            start = i
        }
        i = i + 1
    }
    if (start >= 0) {
        out.push(sliceOf(bs, start, n))
    }
    out
}

/// The whitespace-separated fields of `text` (punctuation stays attached).
fn splitWhitespace(text: string) -> List<string> {
    var out = emptyStrings()
    let bs = bytes(text)
    let n = len(bs)
    var start = 0 - 1
    var i = 0
    while (i < n) {
        if (isSpaceByte(bs[i] as int)) {
            if (start >= 0) {
                out.push(sliceOf(bs, start, i))
                start = 0 - 1
            }
            i = i + 1
            continue
        }
        if (start < 0) {
            start = i
        }
        i = i + 1
    }
    if (start >= 0) {
        out.push(sliceOf(bs, start, n))
    }
    out
}

/// `text` with leading/trailing whitespace removed and every internal
/// whitespace run collapsed to a single space.
fn normalizeSpace(text: string) -> string {
    let sb = StringBuilder()
    let bs = bytes(text)
    var pendingSpace = false
    var started = false
    var i = 0
    while (i < len(bs)) {
        let b = bs[i] as int
        if (isSpaceByte(b)) {
            if (started) {
                pendingSpace = true
            }
            i = i + 1
            continue
        }
        if (pendingSpace) {
            sb.append(" ")
            pendingSpace = false
        }
        sb.appendByte(bs[i])
        started = true
        i = i + 1
    }
    sb.toString()
}

/// The number of tokens in `text`.
fn wordCount(text: string) -> int {
    len(tokens(text))
}

/// `words` with every word lowercased in ASCII; other bytes pass through.
fn lowerWords(words: List<string>) -> List<string> {
    var out = emptyStrings()
    var i = 0
    while (i < len(words)) {
        out.push(lowerAsciiWord(words[i]))
        i = i + 1
    }
    out
}

/// `word` with ASCII `A`-`Z` lowercased; other bytes pass through.
fn lowerAsciiWord(word: string) -> string {
    let sb = StringBuilder()
    let bs = bytes(word)
    var i = 0
    while (i < len(bs)) {
        let c = bs[i] as int
        if (c >= 0x41 && c <= 0x5A) {
            sb.appendByte((c + 0x20) as byte)
        } else {
            sb.appendByte(bs[i])
        }
        i = i + 1
    }
    sb.toString()
}

/// A lexicographic comparison of the UTF-8 bytes of `a` and `b`: -1, 0, or 1.
fn compareWords(a: string, b: string) -> int {
    let ab = bytes(a)
    let bb = bytes(b)
    var i = 0
    while (i < len(ab) && i < len(bb)) {
        let x = ab[i] as int
        let y = bb[i] as int
        if (x < y) {
            return 0 - 1
        }
        if (x > y) {
            return 1
        }
        i = i + 1
    }
    if (len(ab) < len(bb)) {
        return 0 - 1
    }
    if (len(ab) > len(bb)) {
        return 1
    }
    0
}

/// An ascending copy of `words` (insertion sort, so equal words keep their
/// relative order).
fn sortedCopy(words: List<string>) -> List<string> {
    var out = emptyStrings()
    var i = 0
    while (i < len(words)) {
        out.push(words[i])
        i = i + 1
    }
    i = 1
    while (i < len(out)) {
        let v = out[i]
        var j = i
        while (j > 0 && compareWords(out[j - 1], v) > 0) {
            out[j] = out[j - 1]
            j = j - 1
        }
        out[j] = v
        i = i + 1
    }
    out
}

/// The distinct words of `words`, ascending.
fn uniqueSorted(words: List<string>) -> List<string> {
    let sorted = sortedCopy(words)
    var out = emptyStrings()
    var i = 0
    while (i < len(sorted)) {
        if (i == 0 || sorted[i] != sorted[i - 1]) {
            out.push(sorted[i])
        }
        i = i + 1
    }
    out
}

/// Whether `wordsBefore` sorts before `wordsAfter` in a frequency table:
/// higher count first, then the word ascending.
fn countBefore(a: WordCount, b: WordCount) -> bool {
    if (a.count != b.count) {
        return a.count > b.count
    }
    compareWords(a.word, b.word) < 0
}

/// The frequency table of `words`: one entry per distinct word, ordered by
/// descending count and then by ascending word.
fn countsOf(words: List<string>) -> List<WordCount> {
    let uniq = uniqueSorted(words)
    var out = emptyCounts()
    var i = 0
    while (i < len(uniq)) {
        var n = 0
        var j = 0
        while (j < len(words)) {
            if (words[j] == uniq[i]) {
                n = n + 1
            }
            j = j + 1
        }
        out.push(WordCount(uniq[i], n))
        i = i + 1
    }
    i = 1
    while (i < len(out)) {
        let v = out[i]
        var j = i
        while (j > 0 && countBefore(v, out[j - 1])) {
            out[j] = out[j - 1]
            j = j - 1
        }
        out[j] = v
        i = i + 1
    }
    out
}

/// The `n` most frequent words of `words`, in frequency-table order; empty
/// when `n <= 0`.
fn topWords(words: List<string>, n: int) -> List<WordCount> {
    var out = emptyCounts()
    if (n <= 0) {
        return out
    }
    let all = countsOf(words)
    var i = 0
    while (i < len(all) && i < n) {
        out.push(all[i])
        i = i + 1
    }
    out
}

/// `words[lo..hi)` joined with single spaces.
fn joinRange(words: List<string>, lo: int, hi: int) -> string {
    var out = ""
    var i = lo
    while (i < hi) {
        if (i > lo) {
            out = out + " "
        }
        out = out + words[i]
        i = i + 1
    }
    out
}

/// Every overlapping n-gram of `words`, each rendered with single spaces;
/// empty when `n < 1` or `n` exceeds the word count.
fn ngrams(words: List<string>, n: int) -> List<string> {
    var out = emptyStrings()
    if (n < 1 || n > len(words)) {
        return out
    }
    var i = 0
    while (i + n <= len(words)) {
        out.push(joinRange(words, i, i + n))
        i = i + 1
    }
    out
}

/// Whether `a` and `b` share the word `word`.
fn containsWord(words: List<string>, word: string) -> bool {
    var i = 0
    while (i < len(words)) {
        if (words[i] == word) {
            return true
        }
        i = i + 1
    }
    false
}

/// How many distinct words `a` and `b` share (repetitions count once).
fn overlapCount(a: List<string>, b: List<string>) -> int {
    let ua = uniqueSorted(a)
    let ub = uniqueSorted(b)
    var i = 0
    var j = 0
    var found = 0
    while (i < len(ua) && j < len(ub)) {
        if (ua[i] == ub[j]) {
            found = found + 1
            i = i + 1
            j = j + 1
        } else if (compareWords(ua[i], ub[j]) < 0) {
            i = i + 1
        } else {
            j = j + 1
        }
    }
    found
}

/// The Jaccard similarity of the distinct words of `a` and `b`
/// (`|A n B| / |A u B|`); two empty inputs score 1.0.
fn jaccard(a: List<string>, b: List<string>) -> float {
    let shared = overlapCount(a, b)
    let unionSize = len(uniqueSorted(a)) + len(uniqueSorted(b)) - shared
    if (unionSize == 0) {
        return 1.0
    }
    (shared as float) / (unionSize as float)
}

/// The Dice similarity of the distinct words of `a` and `b`
/// (`2|A n B| / (|A| + |B|)`); two empty inputs score 1.0.
fn dice(a: List<string>, b: List<string>) -> float {
    let shared = overlapCount(a, b)
    let total = len(uniqueSorted(a)) + len(uniqueSorted(b))
    if (total == 0) {
        return 1.0
    }
    (2.0 * (shared as float)) / (total as float)
}

/// `(word, count)`.
fn renderCount(c: WordCount) -> string {
    "({c.word}, {c.count})"
}

/// `[(word, count), ...]`.
fn renderCounts(counts: List<WordCount>) -> string {
    var out = "["
    var i = 0
    while (i < len(counts)) {
        if (i > 0) {
            out = out + ", "
        }
        out = out + renderCount(counts[i])
        i = i + 1
    }
    out + "]"
}
