module std.text.ngram

// Byte n-gram extraction.
//
// An n-gram is a contiguous sequence of `n` bytes. `ngrams` returns every
// n-gram in order; if `n <= 0` or `n` is greater than the byte length of `s`,
// the result is empty. `count` is the number of n-grams that would be produced.
//
// Comparisons and slicing are byte-for-byte, so multi-byte UTF-8 scalars count
// as their bytes.

/// The number of n-grams of size `n` in `s`.
fn count(s: string, n: int) -> int {
    if (n <= 0) {
        return 0
    }
    let total = len(bytes(s))
    if (n > total) {
        return 0
    }
    total - n + 1
}

/// Contiguous byte n-grams of `s`, in order.
fn ngrams(s: string, n: int) -> List<string> {
    let bs = bytes(s)
    var out: List<string> = [""]
    out.remove(0)
    if (n <= 0 || n > len(bs)) {
        return out
    }
    var i = 0
    let last = len(bs) - n
    while (i <= last) {
        var part: List<byte> = [0 as byte]
        part.remove(0)
        var j = 0
        while (j < n) {
            part.push(bs[i + j])
            j = j + 1
        }
        out.push(str(part))
        i = i + 1
    }
    out
}

/// Contiguous byte bigrams of `s`, in order.
fn bigrams(s: string) -> List<string> {
    ngrams(s, 2)
}

/// Contiguous byte trigrams of `s`, in order.
fn trigrams(s: string) -> List<string> {
    ngrams(s, 3)
}
