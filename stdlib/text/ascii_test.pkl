module std.text.ascii_test

import { isAsciiByte, isDigitByte, isUpperByte, isLowerByte, isAlphaByte, isAlnumByte, isSpaceByte, toLowerByte, toUpperByte, isAscii, isDigit, isAlpha, isAlnum, isUpper, isLower, isSpace, toLower, toUpper } from std.text.ascii

/// A string built by repeating `part` `times` times.
fn repeats(part: string, times: int) -> string {
    var out = ""
    var i = 0
    while (i < times) {
        out = out + part
        i = i + 1
    }
    out
}

test fn byte_predicates() {
    expect(isAsciiByte(0x00 as byte)).toBe(true)
    expect(isAsciiByte(0x7F as byte)).toBe(true)
    expect(isDigitByte(0x30 as byte)).toBe(true)
    expect(isDigitByte(0x39 as byte)).toBe(true)
    expect(isDigitByte(0x2F as byte)).toBe(false)
    expect(isDigitByte(0x3A as byte)).toBe(false)
    expect(isUpperByte(0x41 as byte)).toBe(true)
    expect(isUpperByte(0x5A as byte)).toBe(true)
    expect(isUpperByte(0x61 as byte)).toBe(false)
    expect(isLowerByte(0x61 as byte)).toBe(true)
    expect(isLowerByte(0x7A as byte)).toBe(true)
    expect(isLowerByte(0x41 as byte)).toBe(false)
    expect(isAlphaByte(0x41 as byte)).toBe(true)
    expect(isAlphaByte(0x7A as byte)).toBe(true)
    expect(isAlphaByte(0x30 as byte)).toBe(false)
    expect(isAlnumByte(0x30 as byte)).toBe(true)
    expect(isAlnumByte(0x41 as byte)).toBe(true)
    expect(isAlnumByte(0x2D as byte)).toBe(false)
    expect(isSpaceByte(0x20 as byte)).toBe(true)
    expect(isSpaceByte(0x09 as byte)).toBe(true)
    expect(isSpaceByte(0x0A as byte)).toBe(true)
    expect(isSpaceByte(0x0D as byte)).toBe(true)
    expect(isSpaceByte(0x0B as byte)).toBe(true)
    expect(isSpaceByte(0x0C as byte)).toBe(true)
    expect(isSpaceByte(0x41 as byte)).toBe(false)
}

test fn byte_case_conversion() {
    expect(toLowerByte(0x41 as byte)).toBe(0x61 as byte)
    expect(toLowerByte(0x5A as byte)).toBe(0x7A as byte)
    expect(toLowerByte(0x61 as byte)).toBe(0x61 as byte)
    expect(toLowerByte(0x30 as byte)).toBe(0x30 as byte)
    expect(toUpperByte(0x61 as byte)).toBe(0x41 as byte)
    expect(toUpperByte(0x7A as byte)).toBe(0x5A as byte)
    expect(toUpperByte(0x41 as byte)).toBe(0x41 as byte)
    expect(toUpperByte(0x30 as byte)).toBe(0x30 as byte)
}

test fn string_predicates_positive() {
    expect(isDigit("0")).toBe(true)
    expect(isDigit("0123456789")).toBe(true)
    expect(isAlpha("abc")).toBe(true)
    expect(isAlpha("ABCxyz")).toBe(true)
    expect(isAlnum("abc123XYZ")).toBe(true)
    expect(isUpper("ABC")).toBe(true)
    expect(isLower("abc")).toBe(true)
    expect(isSpace(" \t\n\r")).toBe(true)
    expect(isAscii("Hello, World! 123")).toBe(true)
}

test fn string_predicates_negative_and_empty() {
    expect(isDigit("")).toBe(false)
    expect(isDigit("12a")).toBe(false)
    expect(isDigit(" 1")).toBe(false)
    expect(isAlpha("")).toBe(false)
    expect(isAlpha("abc1")).toBe(false)
    expect(isAlpha("ab-c")).toBe(false)
    expect(isAlnum("")).toBe(false)
    expect(isAlnum("abc-1")).toBe(false)
    expect(isUpper("")).toBe(false)
    expect(isUpper("ABCd")).toBe(false)
    expect(isUpper("ABC1")).toBe(false)
    expect(isLower("")).toBe(false)
    expect(isLower("abcD")).toBe(false)
    expect(isSpace("")).toBe(false)
    expect(isSpace("  a")).toBe(false)
    expect(isAscii("")).toBe(false)
}

test fn unicode_bytes() {
    // Non-ASCII UTF-8 bytes are >= 0x80; string is non-empty but not all-ASCII.
    expect(isAscii("café")).toBe(false)
    expect(isAlpha("café")).toBe(false)
    expect(isAlnum("café1")).toBe(false)
    expect(isLower("café")).toBe(false)
    expect(isDigit("١٢٣")).toBe(false)
}

test fn string_case_conversion() {
    expect(toLower("")).toBe("")
    expect(toLower("ABC")).toBe("abc")
    expect(toLower("AbC123!")).toBe("abc123!")
    expect(toLower("already")).toBe("already")
    expect(toUpper("")).toBe("")
    expect(toUpper("abc")).toBe("ABC")
    expect(toUpper("AbC123!")).toBe("ABC123!")
    expect(toUpper("ALREADY")).toBe("ALREADY")
    expect(toLower("Hello, World!")).toBe("hello, world!")
    expect(toUpper("Hello, World!")).toBe("HELLO, WORLD!")
}

test fn case_conversion_with_unicode() {
    // Non-ASCII bytes pass through unchanged.
    expect(toLower("CAFÉ")).toBe("cafÉ")
    expect(toUpper("café")).toBe("CAFé")
    expect(toLower(toUpper("café"))).toBe("café")
}

test fn long_inputs() {
    let digits = repeats("9", 200)
    let uppers = repeats("A", 200)
    let lowers = repeats("a", 200)
    expect(isDigit(digits)).toBe(true)
    expect(isUpper(uppers)).toBe(true)
    expect(isLower(lowers)).toBe(true)
    expect(toLower(uppers)).toBe(lowers)
    expect(toUpper(lowers)).toBe(uppers)
    expect(isAlnum(uppers + digits)).toBe(true)
}
