module std.text.ascii

// ASCII byte-class predicates and conversions.
//
// Predicates operate on byte values. For string predicates, an empty string
// yields `false` ("non-empty and all bytes satisfy"). `toUpper` and `toLower`
// convert only ASCII letters A-Z/a-z and leave every other byte unchanged.
//
// "Space" bytes are space, tab, newline, carriage return, vertical tab, and
// form feed (0x20, 0x09, 0x0A, 0x0D, 0x0B, 0x0C).

/// `true` if `b` is an ASCII byte (0x00-0x7F).
fn isAsciiByte(b: byte) -> bool {
    b >= 0x00 && b <= 0x7F
}

/// `true` if `b` is an ASCII digit '0'-'9'.
fn isDigitByte(b: byte) -> bool {
    b >= 0x30 && b <= 0x39
}

/// `true` if `b` is an ASCII uppercase letter 'A'-'Z'.
fn isUpperByte(b: byte) -> bool {
    b >= 0x41 && b <= 0x5A
}

/// `true` if `b` is an ASCII lowercase letter 'a'-'z'.
fn isLowerByte(b: byte) -> bool {
    b >= 0x61 && b <= 0x7A
}

/// `true` if `b` is an ASCII letter 'A'-'Z' or 'a'-'z'.
fn isAlphaByte(b: byte) -> bool {
    isUpperByte(b) || isLowerByte(b)
}

/// `true` if `b` is an ASCII letter or digit.
fn isAlnumByte(b: byte) -> bool {
    isAlphaByte(b) || isDigitByte(b)
}

/// `true` if `b` is an ASCII whitespace byte.
fn isSpaceByte(b: byte) -> bool {
    b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0D || b == 0x0B || b == 0x0C
}

/// Convert an ASCII uppercase letter to lowercase; other bytes unchanged.
fn toLowerByte(b: byte) -> byte {
    if (isUpperByte(b)) {
        return (b + 32) as byte
    }
    b
}

/// Convert an ASCII lowercase letter to uppercase; other bytes unchanged.
fn toUpperByte(b: byte) -> byte {
    if (isLowerByte(b)) {
        return (b - 32) as byte
    }
    b
}

/// `true` if `s` is non-empty and every byte is ASCII.
fn isAscii(s: string) -> bool {
    let bs = bytes(s)
    if (len(bs) == 0) {
        return false
    }
    var i = 0
    while (i < len(bs)) {
        if (!isAsciiByte(bs[i])) {
            return false
        }
        i = i + 1
    }
    true
}

/// `true` if `s` is non-empty and every byte is an ASCII digit.
fn isDigit(s: string) -> bool {
    let bs = bytes(s)
    if (len(bs) == 0) {
        return false
    }
    var i = 0
    while (i < len(bs)) {
        if (!isDigitByte(bs[i])) {
            return false
        }
        i = i + 1
    }
    true
}

/// `true` if `s` is non-empty and every byte is an ASCII letter.
fn isAlpha(s: string) -> bool {
    let bs = bytes(s)
    if (len(bs) == 0) {
        return false
    }
    var i = 0
    while (i < len(bs)) {
        if (!isAlphaByte(bs[i])) {
            return false
        }
        i = i + 1
    }
    true
}

/// `true` if `s` is non-empty and every byte is an ASCII letter or digit.
fn isAlnum(s: string) -> bool {
    let bs = bytes(s)
    if (len(bs) == 0) {
        return false
    }
    var i = 0
    while (i < len(bs)) {
        if (!isAlnumByte(bs[i])) {
            return false
        }
        i = i + 1
    }
    true
}

/// `true` if `s` is non-empty and every byte is an ASCII uppercase letter.
fn isUpper(s: string) -> bool {
    let bs = bytes(s)
    if (len(bs) == 0) {
        return false
    }
    var i = 0
    while (i < len(bs)) {
        if (!isUpperByte(bs[i])) {
            return false
        }
        i = i + 1
    }
    true
}

/// `true` if `s` is non-empty and every byte is an ASCII lowercase letter.
fn isLower(s: string) -> bool {
    let bs = bytes(s)
    if (len(bs) == 0) {
        return false
    }
    var i = 0
    while (i < len(bs)) {
        if (!isLowerByte(bs[i])) {
            return false
        }
        i = i + 1
    }
    true
}

/// `true` if `s` is non-empty and every byte is ASCII whitespace.
fn isSpace(s: string) -> bool {
    let bs = bytes(s)
    if (len(bs) == 0) {
        return false
    }
    var i = 0
    while (i < len(bs)) {
        if (!isSpaceByte(bs[i])) {
            return false
        }
        i = i + 1
    }
    true
}

/// `s` with every ASCII uppercase letter converted to lowercase.
fn toLower(s: string) -> string {
    let bs = bytes(s)
    var out: List<byte> = [0 as byte]
    out.remove(0)
    var i = 0
    while (i < len(bs)) {
        out.push(toLowerByte(bs[i]))
        i = i + 1
    }
    str(out)
}

/// `s` with every ASCII lowercase letter converted to uppercase.
fn toUpper(s: string) -> string {
    let bs = bytes(s)
    var out: List<byte> = [0 as byte]
    out.remove(0)
    var i = 0
    while (i < len(bs)) {
        out.push(toUpperByte(bs[i]))
        i = i + 1
    }
    str(out)
}
