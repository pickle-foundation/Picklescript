module std.text.common

// Common byte prefix and suffix utilities.
//
// All comparisons are byte-for-byte, so multi-byte UTF-8 scalars count as their
// bytes. A shared prefix or suffix is returned as the corresponding byte slice
// of the left argument (for two inputs) or of the first string (for a list).

/// The number of leading bytes shared by `a` and `b`.
fn prefixLen(a: string, b: string) -> int {
    let ab = bytes(a)
    let bb = bytes(b)
    var n = len(ab)
    if (len(bb) < n) {
        n = len(bb)
    }
    var i = 0
    while (i < n && ab[i] == bb[i]) {
        i = i + 1
    }
    i
}

/// The longest common leading byte sequence of `a` and `b`.
fn prefix(a: string, b: string) -> string {
    let ab = bytes(a)
    let n = prefixLen(a, b)
    var out: List<byte> = [0 as byte]
    out.remove(0)
    var i = 0
    while (i < n) {
        out.push(ab[i])
        i = i + 1
    }
    str(out)
}

/// The number of trailing bytes shared by `a` and `b`.
fn suffixLen(a: string, b: string) -> int {
    let ab = bytes(a)
    let bb = bytes(b)
    let la = len(ab)
    let lb = len(bb)
    var n = la
    if (lb < n) {
        n = lb
    }
    var i = 0
    while (i < n && ab[la - 1 - i] == bb[lb - 1 - i]) {
        i = i + 1
    }
    i
}

/// The longest common trailing byte sequence of `a` and `b`.
fn suffix(a: string, b: string) -> string {
    let ab = bytes(a)
    let n = suffixLen(a, b)
    let start = len(ab) - n
    var out: List<byte> = [0 as byte]
    out.remove(0)
    var i = start
    while (i < len(ab)) {
        out.push(ab[i])
        i = i + 1
    }
    str(out)
}

/// The longest common leading byte sequence shared by every string in `xs`.
/// Returns `""` for an empty list.
fn longestPrefix(xs: List<string>) -> string {
    if (len(xs) == 0) {
        return ""
    }
    var cur = xs[0]
    var i = 1
    while (i < len(xs)) {
        let n = prefixLen(cur, xs[i])
        let cb = bytes(cur)
        var out: List<byte> = [0 as byte]
        out.remove(0)
        var j = 0
        while (j < n) {
            out.push(cb[j])
            j = j + 1
        }
        cur = str(out)
        if (cur == "") {
            return ""
        }
        i = i + 1
    }
    cur
}

/// The longest common trailing byte sequence shared by every string in `xs`.
/// Returns `""` for an empty list.
fn longestSuffix(xs: List<string>) -> string {
    if (len(xs) == 0) {
        return ""
    }
    var cur = xs[0]
    var i = 1
    while (i < len(xs)) {
        let n = suffixLen(cur, xs[i])
        let cb = bytes(cur)
        let start = len(cb) - n
        var out: List<byte> = [0 as byte]
        out.remove(0)
        var j = start
        while (j < len(cb)) {
            out.push(cb[j])
            j = j + 1
        }
        cur = str(out)
        if (cur == "") {
            return ""
        }
        i = i + 1
    }
    cur
}
