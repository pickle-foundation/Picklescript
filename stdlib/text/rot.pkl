module std.text.rot

// ASCII Caesar/ROT letter shifts.
//
// `caesar` shifts ASCII letters A-Z and a-z by `shift` positions, wrapping
// within the alphabet and preserving case. Non-letter bytes (including all
// non-ASCII UTF-8 bytes) are left unchanged. `rot13` is `caesar(text, 13)`.
//
// Shifts are reduced modulo 26, so negative values and values larger than 25
// are accepted.

/// `n mod 26` in the range 0-25.
fn mod26(n: int) -> int {
    var r = n % 26
    if (r < 0) {
        r = r + 26
    }
    r
}

/// Shift ASCII letters in `text` by `shift` positions, preserving case.
fn caesar(text: string, shift: int) -> string {
    let bs = bytes(text)
    var out: List<byte> = [0 as byte]
    out.remove(0)
    let s = mod26(shift)
    var i = 0
    while (i < len(bs)) {
        let b = bs[i]
        var v = b
        if (b >= 0x41 && b <= 0x5A) {
            // 'A'..'Z'
            let off = (b - 0x41 + s) % 26
            v = (0x41 + off) as byte
        } else {
            if (b >= 0x61 && b <= 0x7A) {
                // 'a'..'z'
                let off = (b - 0x61 + s) % 26
                v = (0x61 + off) as byte
            }
        }
        out.push(v)
        i = i + 1
    }
    str(out)
}

/// Rotate ASCII letters by 13 positions (ROT13).
fn rot13(text: string) -> string {
    caesar(text, 13)
}
