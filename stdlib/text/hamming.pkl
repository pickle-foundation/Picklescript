module std.text.hamming

// Byte-oriented Hamming distance.
//
// `distance` counts the byte positions where `a` and `b` differ. It is defined
// only for strings of equal byte length; when the lengths differ it returns
// `-1`. Multi-byte UTF-8 scalars therefore count as their bytes, so a single
// substituted scalar can register as more than one difference.
//
// `similarity` turns that into an integer percentage of the common byte length:
// `100` for two equal strings (including two empty ones), `0` when the lengths
// differ or every byte differs, and floor division otherwise.

/// The number of differing byte positions, or `-1` when the lengths differ.
fn distance(a: string, b: string) -> int {
    let ab = bytes(a)
    let bb = bytes(b)
    if (len(ab) != len(bb)) {
        return -1
    }
    var diff = 0
    var i = 0
    while (i < len(ab)) {
        if (ab[i] != bb[i]) {
            diff = diff + 1
        }
        i = i + 1
    }
    diff
}

/// Hamming similarity as an integer percentage of the common byte length.
fn similarity(a: string, b: string) -> int {
    let ab = bytes(a)
    let bb = bytes(b)
    let n = len(ab)
    if (n != len(bb)) {
        return 0
    }
    if (n == 0) {
        return 100
    }
    let d = distance(a, b)
    100 * (n - d) / n
}
