module std.text.unicode_test

import { isValid, scalars, fromScalars, scalarCount, charAt, sliceScalars, isDigit, isAsciiAlpha, isAscii, isSpace, isLetter, isAlnum, isUpper, isLower, upperOf, lowerOf, toUpper, toLower, charWidth, displayWidth, truncateToWidth, indexOfScalar } from std.text.unicode

/// A string built from raw byte values (used to create malformed UTF-8).
fn rawBytes(values: List<int>) -> string {
    var out = bytes("")
    var i = 0
    while (i < len(values)) {
        out.push(values[i] as byte)
        i = i + 1
    }
    str(out)
}

/// A scalar list rendered as space-separated decimal values.
fn showScalars(cps: List<int>) -> string {
    var out = ""
    var i = 0
    while (i < len(cps)) {
        if (i > 0) {
            out = out + " "
        }
        out = out + "{cps[i]}"
        i = i + 1
    }
    out
}

/// A `charAt` result, or `<none>`.
fn showCharAt(s: string, i: int) -> string {
    match (charAt(s, i)) {
    case some(cp) -> "{cp}"
    case none -> "<none>"
    }
}

/// A `sliceScalars` result, or `<none>`.
fn showSlice(s: string, start: int, end: int) -> string {
    match (sliceScalars(s, start, end)) {
    case some(part) -> part
    case none -> "<none>"
    }
}

test fn ascii_scalars() {
    expect(showScalars(scalars("AZaz09"))).toBe("65 90 97 122 48 57")
    expect(scalarCount("")).toBe(0)
    expect(scalarCount("hello")).toBe(5)
    expect(isValid("hello")).toBe(true)
    expect(isValid("")).toBe(true)
}

test fn multibyte_scalars() {
    expect(showScalars(scalars("é"))).toBe("233")
    expect(showScalars(scalars("東"))).toBe("26481")
    expect(showScalars(scalars("🎉"))).toBe("127881")
    expect(showScalars(scalars("aé東"))).toBe("97 233 26481")
    expect(scalarCount("aé東")).toBe(3)
    expect(scalarCount("東東東")).toBe(3)
    expect(isValid("aé東🎉")).toBe(true)
}

test fn scalars_round_trip() {
    let sources: List<string> = ["", "abc", "naïve", "東京", "🎉🎊", "a\u{0301}b"]
    var i = 0
    while (i < len(sources)) {
        expect(fromScalars(scalars(sources[i]))).toBe(sources[i])
        i = i + 1
    }
    expect(fromScalars(scalars("x"))).toBe("x")
}

test fn scalar_count_is_stable() {
    expect(scalarCount("")).toBe(0)
    expect(scalarCount("flat")).toBe(4)
    expect(scalarCount("café")).toBe(4)
    expect(scalarCount("日本語")).toBe(3)
    expect(scalarCount("👩‍👩‍👧")).toBe(5)
    expect(scalarCount("e\u{301}")).toBe(2)
}

test fn char_at_indexes() {
    expect(showCharAt("abc", 0)).toBe("97")
    expect(showCharAt("abc", 2)).toBe("99")
    expect(showCharAt("abc", 3)).toBe("<none>")
    expect(showCharAt("abc", -1)).toBe("<none>")
    expect(showCharAt("aé東", 1)).toBe("233")
    expect(showCharAt("aé東", 2)).toBe("26481")
    expect(showCharAt("aé東", 9)).toBe("<none>")
}

test fn slice_by_scalar_index() {
    expect(showSlice("aé東b", 0, 2)).toBe("aé")
    expect(showSlice("aé東b", 1, 3)).toBe("é東")
    expect(showSlice("aé東b", 0, 0)).toBe("")
    expect(showSlice("aé東b", 4, 4)).toBe("")
    expect(showSlice("aé東b", 2, 4)).toBe("東b")
    expect(showSlice("abc", 3, 3)).toBe("")
    expect(showSlice("abc", 0, 4)).toBe("<none>")
    expect(showSlice("abc", -1, 2)).toBe("<none>")
    expect(showSlice("abc", 2, 1)).toBe("<none>")
    expect(showSlice("", 0, 0)).toBe("")
    expect(showSlice("", 1, 1)).toBe("<none>")
}

test fn detects_malformed_utf8() {
    expect(isValid(rawBytes([0x41]))).toBe(true)
    expect(isValid(rawBytes([0x80]))).toBe(false)
    expect(isValid(rawBytes([0xC0, 0x80]))).toBe(false)
    expect(isValid(rawBytes([0xE2, 0x82]))).toBe(false)
    expect(isValid(rawBytes([0xED, 0xA0, 0x80]))).toBe(false)
    expect(isValid(rawBytes([0xF5, 0x80, 0x80, 0x80]))).toBe(false)
    expect(isValid(rawBytes([0xE4, 0xB8, 0x9C]))).toBe(true)
    expect(isValid(rawBytes([0xF0, 0x9F, 0x8E, 0x89]))).toBe(true)
}

test fn malformed_bytes_become_replacement() {
    let lone = rawBytes([0x41, 0x80, 0x42])
    expect(scalarCount(lone)).toBe(3)
    expect(showScalars(scalars(lone))).toBe("65 65533 66")
    expect(showCharAt(lone, 1)).toBe("65533")
    let short = rawBytes([0x41, 0xE2, 0x82])
    expect(scalarCount(short)).toBe(3)
    expect(showCharAt(short, 1)).toBe("65533")
    expect(showCharAt(short, 2)).toBe("65533")
    let surrogate = rawBytes([0xED, 0xA0, 0x80])
    expect(scalarCount(surrogate)).toBe(3)
    expect(showCharAt(surrogate, 0)).toBe("65533")
}

test fn from_scalars_sanitizes() {
    expect(fromScalars([65, 233, 26481])).toBe("Aé東")
    expect(fromScalars([0x110000])).toBe("\u{FFFD}")
    expect(fromScalars([0xD800])).toBe("\u{FFFD}")
    expect(fromScalars([-1])).toBe("\u{FFFD}")
    var empty: List<int> = [0]
    empty.remove(0)
    expect(fromScalars(empty)).toBe("")
}

test fn ascii_case_mapping() {
    expect(toUpper("hello world")).toBe("HELLO WORLD")
    expect(toLower("HELLO WORLD")).toBe("hello world")
    expect(toUpper("abc123!@#")).toBe("ABC123!@#")
    expect(toLower("MiXeD")).toBe("mixed")
    expect(upperOf(97)).toBe(65)
    expect(lowerOf(65)).toBe(97)
    expect(upperOf(48)).toBe(48)
}

test fn latin1_case_mapping() {
    expect(toUpper("café")).toBe("CAFÉ")
    expect(toLower("CAFÉ")).toBe("café")
    expect(toUpper("ÿ")).toBe("\u{178}")
    expect(toLower("\u{178}")).toBe("ÿ")
    expect(toUpper("÷")).toBe("÷")
    expect(toLower("×")).toBe("×")
    expect(toLower("ÀÖØÞ")).toBe("àöøþ")
    expect(toUpper("àöøþ")).toBe("ÀÖØÞ")
}

test fn greek_case_mapping() {
    expect(toUpper("αβγδ")).toBe("ΑΒΓΔ")
    expect(toLower("ΑΒΓΔ")).toBe("αβγδ")
    expect(toUpper("ς")).toBe("Σ")
    expect(toLower("Σ")).toBe("σ")
    expect(toUpper("ω")).toBe("Ω")
    expect(toLower("Ω")).toBe("ω")
    expect(upperOf(0x3C2)).toBe(0x3A3)
    expect(lowerOf(0x3A3)).toBe(0x3C3)
}

test fn cyrillic_case_mapping() {
    expect(toUpper("привет")).toBe("ПРИВЕТ")
    expect(toLower("ПРИВЕТ")).toBe("привет")
    expect(toUpper("ёж")).toBe("ЁЖ")
    expect(toLower("ЁЖ")).toBe("ёж")
    expect(upperOf(0x0451)).toBe(0x0401)
    expect(lowerOf(0x0401)).toBe(0x0451)
}

test fn case_predicates() {
    expect(isUpper(65)).toBe(true)
    expect(isUpper(97)).toBe(false)
    expect(isLower(97)).toBe(true)
    expect(isLower(65)).toBe(false)
    expect(isUpper(0x100)).toBe(false)
    expect(isLower(0x100)).toBe(false)
    expect(isLower(0x307)).toBe(false)
    expect(isUpper(48)).toBe(false)
    expect(isLower(48)).toBe(false)
    expect(isUpper(0x391)).toBe(true)
    expect(isLower(0x391)).toBe(false)
    expect(isLower(0x3B1)).toBe(true)
    expect(isUpper(0x3B1)).toBe(false)
    expect(isUpper(0x410)).toBe(true)
    expect(isLower(0x410)).toBe(false)
    expect(isLower(0x430)).toBe(true)
    expect(isUpper(0x430)).toBe(false)
    expect(toUpper("straße")).toBe("STRAßE")
}

test fn character_classes() {
    expect(isDigit('0' as int)).toBe(true)
    expect(isDigit('9' as int)).toBe(true)
    expect(isDigit('a' as int)).toBe(false)
    expect(isDigit(0x663)).toBe(false)
    expect(isAsciiAlpha('a' as int)).toBe(true)
    expect(isAsciiAlpha('Z' as int)).toBe(true)
    expect(isAsciiAlpha('é' as int)).toBe(false)
    expect(isAscii('~' as int)).toBe(true)
    expect(isAscii('é' as int)).toBe(false)
    expect(isAscii(0)).toBe(true)
    expect(isAlnum('7' as int)).toBe(true)
    expect(isAlnum('q' as int)).toBe(true)
    expect(isAlnum('-' as int)).toBe(false)
    expect(isLetter('é' as int)).toBe(true)
    expect(isLetter('東' as int)).toBe(true)
    expect(isLetter('α' as int)).toBe(true)
    expect(isLetter('א' as int)).toBe(true)
    expect(isLetter('1' as int)).toBe(false)
    expect(isLetter(' ' as int)).toBe(false)
    expect(isLetter(0x1F600)).toBe(false)
}

test fn whitespace_classes() {
    expect(isSpace(' ' as int)).toBe(true)
    expect(isSpace('\t' as int)).toBe(true)
    expect(isSpace('\n' as int)).toBe(true)
    expect(isSpace(0x85)).toBe(true)
    expect(isSpace(0xA0)).toBe(true)
    expect(isSpace(0x1680)).toBe(true)
    expect(isSpace(0x2003)).toBe(true)
    expect(isSpace(0x2028)).toBe(true)
    expect(isSpace(0x3000)).toBe(true)
    expect(isSpace('a' as int)).toBe(false)
    expect(isSpace(0x200B)).toBe(false)
    expect(isSpace(0)).toBe(false)
}

test fn display_width_basics() {
    expect(displayWidth("")).toBe(0)
    expect(displayWidth("abc")).toBe(3)
    expect(displayWidth("café")).toBe(4)
    expect(displayWidth("東")).toBe(2)
    expect(displayWidth("東京")).toBe(4)
    expect(displayWidth("a東b")).toBe(4)
    expect(displayWidth("\u{FF21}")).toBe(2)
    expect(displayWidth("🎉")).toBe(2)
    expect(displayWidth("\t")).toBe(0)
    expect(displayWidth("\u{7F}")).toBe(0)
    expect(charWidth(65)).toBe(1)
    expect(charWidth(0x6771)).toBe(2)
    expect(charWidth(0x301)).toBe(0)
}

test fn display_width_ignores_combining_marks() {
    expect(displayWidth("e\u{301}")).toBe(1)
    expect(displayWidth("a\u{300}\u{301}")).toBe(1)
    expect(displayWidth("\u{200D}")).toBe(0)
    expect(displayWidth("\u{FE0F}")).toBe(0)
    expect(displayWidth("x\u{200D}y")).toBe(2)
    expect(scalarCount("e\u{301}")).toBe(2)
}

test fn truncate_to_width() {
    expect(truncateToWidth("abcdef", 3)).toBe("abc")
    expect(truncateToWidth("abcdef", 0)).toBe("")
    expect(truncateToWidth("abcdef", -2)).toBe("")
    expect(truncateToWidth("abcdef", 99)).toBe("abcdef")
    expect(truncateToWidth("ab東c", 3)).toBe("ab")
    expect(truncateToWidth("ab東c", 4)).toBe("ab東")
    expect(truncateToWidth("東", 1)).toBe("")
    expect(truncateToWidth("e\u{301}f", 1)).toBe("e\u{301}")
    expect(truncateToWidth("café", 3)).toBe("caf")
}

test fn index_of_scalar() {
    expect(indexOfScalar("aé東", 97)).toBe(0)
    expect(indexOfScalar("aé東", 233)).toBe(1)
    expect(indexOfScalar("aé東", 26481)).toBe(2)
    expect(indexOfScalar("aé東", 98)).toBe(-1)
    expect(indexOfScalar("", 65)).toBe(-1)
    expect(indexOfScalar("aaa", 97)).toBe(0)
    expect(indexOfScalar("東東", 26481)).toBe(0)
}
