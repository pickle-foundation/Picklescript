module std.text.lcs

// Longest common subsequence length over UTF-8 strings.
//
// Comparisons are byte-for-byte, so a multi-byte scalar counts as its bytes,
// matching the byte-oriented text distance modules. `length` returns the
// length of a longest byte sequence appearing in both inputs in order (not
// necessarily contiguously). `distance` is the insert/delete edit distance,
// `len(bytes(a)) + len(bytes(b)) - 2 * length(a, b)`.
//
// `length` uses two rows of the DP table, so memory is linear in the shorter
// input's byte length.

/// The smaller of `a` and `b`.
fn minOf2(a: int, b: int) -> int {
    if (a < b) {
        return a
    }
    b
}

/// The longer byte length of `a` and `b`.
fn maxBytes(a: string, b: string) -> int {
    let la = len(bytes(a))
    let lb = len(bytes(b))
    if (la > lb) {
        return la
    }
    lb
}

/// Length of a longest common subsequence of bytes in `a` and `b`.
fn length(a: string, b: string) -> int {
    var ab = bytes(a)
    var bb = bytes(b)
    if (len(ab) < len(bb)) {
        let tmp = ab
        ab = bb
        bb = tmp
    }
    if (len(bb) == 0) {
        return 0
    }
    var prev: List<int> = [0]
    prev.remove(0)
    var j = 0
    while (j <= len(bb)) {
        prev.push(0)
        j = j + 1
    }
    var i = 1
    while (i <= len(ab)) {
        var cur: List<int> = [0]
        cur.remove(0)
        cur.push(0)
        j = 1
        while (j <= len(bb)) {
            if (ab[i - 1] == bb[j - 1]) {
                cur.push(prev[j - 1] + 1)
            } else {
                let up = prev[j]
                let left = cur[j - 1]
                if (up > left) {
                    cur.push(up)
                } else {
                    cur.push(left)
                }
            }
            j = j + 1
        }
        prev = cur
        i = i + 1
    }
    prev[len(bb)]
}

/// Insert/delete edit distance between `a` and `b`.
fn distance(a: string, b: string) -> int {
    let la = len(bytes(a))
    let lb = len(bytes(b))
    la + lb - 2 * length(a, b)
}

/// LCS similarity as an integer percentage of the longer byte length.
fn similarity(a: string, b: string) -> int {
    let n = maxBytes(a, b)
    if (n == 0) {
        return 100
    }
    100 * length(a, b) / n
}
