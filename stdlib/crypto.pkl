module std.crypto

// Cryptographic hashes, HMAC, constant-time comparison, and OS randomness.
//
// Scope. This module provides protocol primitives (SHA-1 for the WebSocket
// handshake, SHA-256/HMAC-SHA256 for tokens, fingerprints, and HTTP), not TLS
// record cryptography. TLS is delegated to the OS provider (Schannel on
// Windows, a native backend on POSIX); never build TLS from these functions.
//
// Implementation. SHA-1, SHA-256, and HMAC-SHA256 are ordinary Pickle code so
// the API behaves identically on every target and can be tested against known
// vectors. Only the CSPRNG is platform-backed (`runtime.abi_crypto`). No state
// is shared between calls.
//
// Conventions. Hashes take and return `List<byte>`; use
// `std.encoding.hex.encode` / `base64.encode` for textual forms.
// `randomBytes(-1)` returns none; zero returns an empty list.

import { cryptoRandom } from runtime.abi_crypto

const MASK32: int = 0xFFFFFFFF

// SHA-1 round constants.
const SHA1_K0: int = 0x5A827999
const SHA1_K1: int = 0x6ED9EBA1
const SHA1_K2: int = 0x8F1BBCDC
const SHA1_K3: int = 0xCA62C1D6

// SHA-256 round constants (FIPS 180-4).
const SHA256_K: List<int> = [
    0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
    0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
    0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
    0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
    0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC,
    0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
    0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7,
    0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
    0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
    0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
    0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3,
    0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
    0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5,
    0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
    0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
    0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2,
]

fn rotl32(x: int, n: int) -> int {
    let v = x & MASK32
    ((v << n) | (v >> (32 - n))) & MASK32
}

fn rotr32(x: int, n: int) -> int {
    let v = x & MASK32
    ((v >> n) | (v << (32 - n))) & MASK32
}

fn readBe32(d: List<byte>, at: int) -> int {
    ((d[at] as int) << 24) |
        ((d[at + 1] as int) << 16) |
        ((d[at + 2] as int) << 8) |
        (d[at + 3] as int)
}

fn appendBe32(out: List<byte>, v: int) {
    let x = v & MASK32
    out.push(((x >> 24) & 255) as byte)
    out.push(((x >> 16) & 255) as byte)
    out.push(((x >> 8) & 255) as byte)
    out.push((x & 255) as byte)
}

/// Append `data` plus MD-style padding: 0x80, zeros to a 56-byte boundary,
/// then the 64-bit big-endian bit length. Works for SHA-1 and SHA-256.
fn pad64(data: List<byte>) -> List<byte> {
    let out = bytes("")
    var i = 0
    while (i < len(data)) {
        out.push(data[i])
        i = i + 1
    }
    out.push(0x80 as byte)
    while (len(out) % 64 != 56) {
        out.push(0 as byte)
    }
    let bits = len(data) * 8
    var shift = 56
    while (shift >= 0) {
        out.push(((bits >> shift) & 255) as byte)
        shift = shift - 8
    }
    out
}

/// SHA-1 digest of `data` (20 bytes).
fn sha1(data: List<byte>) -> List<byte> {
    let msg = pad64(data)
    var h0 = 0x67452301
    var h1 = 0xEFCDAB89
    var h2 = 0x98BADCFE
    var h3 = 0x10325476
    var h4 = 0xC3D2E1F0
    var w: List<int> = []
    var wi = 0
    while (wi < 80) {
        w.push(0)
        wi = wi + 1
    }
    var off = 0
    while (off < len(msg)) {
        var t = 0
        while (t < 16) {
            w[t] = readBe32(msg, off + t * 4)
            t = t + 1
        }
        t = 16
        while (t < 80) {
            w[t] = rotl32(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)
            t = t + 1
        }
        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        t = 0
        while (t < 80) {
            var f = 0
            var k = 0
            if (t < 20) {
                f = (b & c) | (((0 - 1) ^ b) & d)
                k = SHA1_K0
            } else if (t < 40) {
                f = b ^ c ^ d
                k = SHA1_K1
            } else if (t < 60) {
                f = (b & c) | (b & d) | (c & d)
                k = SHA1_K2
            } else {
                f = b ^ c ^ d
                k = SHA1_K3
            }
            let temp = (rotl32(a, 5) + (f & MASK32) + e + k + w[t]) & MASK32
            e = d
            d = c
            c = rotl32(b, 30)
            b = a
            a = temp
            t = t + 1
        }
        h0 = (h0 + a) & MASK32
        h1 = (h1 + b) & MASK32
        h2 = (h2 + c) & MASK32
        h3 = (h3 + d) & MASK32
        h4 = (h4 + e) & MASK32
        off = off + 64
    }
    let out = bytes("")
    appendBe32(out, h0)
    appendBe32(out, h1)
    appendBe32(out, h2)
    appendBe32(out, h3)
    appendBe32(out, h4)
    out
}

/// SHA-256 digest of `data` (32 bytes).
fn sha256(data: List<byte>) -> List<byte> {
    let msg = pad64(data)
    var h0 = 0x6A09E667
    var h1 = 0xBB67AE85
    var h2 = 0x3C6EF372
    var h3 = 0xA54FF53A
    var h4 = 0x510E527F
    var h5 = 0x9B05688C
    var h6 = 0x1F83D9AB
    var h7 = 0x5BE0CD19
    var w: List<int> = []
    var wi = 0
    while (wi < 64) {
        w.push(0)
        wi = wi + 1
    }
    var off = 0
    while (off < len(msg)) {
        var t = 0
        while (t < 16) {
            w[t] = readBe32(msg, off + t * 4)
            t = t + 1
        }
        t = 16
        while (t < 64) {
            let x15 = w[t - 15]
            let x2 = w[t - 2]
            let s0 = rotr32(x15, 7) ^ rotr32(x15, 18) ^ (x15 >> 3)
            let s1 = rotr32(x2, 17) ^ rotr32(x2, 19) ^ (x2 >> 10)
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & MASK32
            t = t + 1
        }
        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        var f = h5
        var g = h6
        var h = h7
        t = 0
        while (t < 64) {
            let ss0 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
            let ch = (e & f) ^ (((0 - 1) ^ e) & g)
            let temp1 = (h + ss0 + (ch & MASK32) + SHA256_K[t] + w[t]) & MASK32
            let ss1 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let temp2 = (ss1 + (maj & MASK32)) & MASK32
            h = g
            g = f
            f = e
            e = (d + temp1) & MASK32
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & MASK32
            t = t + 1
        }
        h0 = (h0 + a) & MASK32
        h1 = (h1 + b) & MASK32
        h2 = (h2 + c) & MASK32
        h3 = (h3 + d) & MASK32
        h4 = (h4 + e) & MASK32
        h5 = (h5 + f) & MASK32
        h6 = (h6 + g) & MASK32
        h7 = (h7 + h) & MASK32
        off = off + 64
    }
    let out = bytes("")
    appendBe32(out, h0)
    appendBe32(out, h1)
    appendBe32(out, h2)
    appendBe32(out, h3)
    appendBe32(out, h4)
    appendBe32(out, h5)
    appendBe32(out, h6)
    appendBe32(out, h7)
    out
}

/// HMAC-SHA256 (RFC 2104). Keys longer than the 64-byte block are hashed.
fn hmacSha256(key: List<byte>, data: List<byte>) -> List<byte> {
    var k = key
    if (len(k) > 64) {
        k = sha256(k)
    }
    let inner = bytes("")
    let outer = bytes("")
    var i = 0
    while (i < 64) {
        var kb = 0
        if (i < len(k)) {
            kb = k[i] as int
        }
        inner.push((kb ^ 0x36) as byte)
        outer.push((kb ^ 0x5C) as byte)
        i = i + 1
    }
    for (b in data) {
        inner.push(b)
    }
    for (b in sha256(inner)) {
        outer.push(b)
    }
    sha256(outer)
}

/// Length-independent comparison for MACs and tokens. Leaks nothing beyond
/// whether the lengths differ (which callers already know).
fn constantTimeEquals(a: List<byte>, b: List<byte>) -> bool {
    if (len(a) != len(b)) {
        return false
    }
    var diff = 0
    var i = 0
    while (i < len(a)) {
        diff = diff | ((a[i] as int) ^ (b[i] as int))
        i = i + 1
    }
    diff == 0
}

// ---------------------------------------------------------------------------
// OS randomness
// ---------------------------------------------------------------------------

/// Allocate a zeroed raw buffer of at least `n` bytes (always >= 8).
fn rawAlloc(n: int) -> int {
    var words = (n + 7) / 8
    if (words < 1) {
        words = 1
    }
    unsafe {
        let p = alloc(int, words)
        var i = 0
        while (i < words) {
            p[i] = 0
            i = i + 1
        }
        return p as int
    }
}

fn rawFree(p: int) {
    if (p != 0) {
        unsafe {
            free(p as *int)
        }
    }
}

fn rawToBytes(p: int, n: int) -> List<byte> {
    let out = bytes("")
    unsafe {
        let w = p as *int
        var i = 0
        while (i < n) {
            out.push(((w[i >> 3] >> ((i & 7) * 8)) & 255) as byte)
            i = i + 1
        }
    }
    out
}

/// `n` bytes from the OS cryptographically secure random generator.
/// `n == 0` returns an empty list; `n < 0` returns none.
fn randomBytes(n: int) -> List<byte>? {
    if (n < 0) {
        return none
    }
    if (n == 0) {
        return bytes("")
    }
    let p = rawAlloc(n)
    let rc = cryptoRandom(p, n)
    if (rc != 0) {
        rawFree(p)
        return none
    }
    let out = rawToBytes(p, n)
    rawFree(p)
    out
}
