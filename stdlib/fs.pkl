module std.fs

import { sliceRange } from std.text.format

/// Whole-file and stream I/O seeds (`std.fs`). Path helpers are POSIX-style
/// (`/` separator, no drive letters); `File`/`Dir` wrap the read/write/delete/
/// mkdir/list_dir/stream intrinsics. Whole-file intrinsics report failure as
/// `none`/`false` — errors are values.

/// Join two path segments with a single `/`.
fn pathJoin(a: string, b: string) -> string {
    if (a == "") {
        return b
    }
    if (b == "") {
        return a
    }
    if ((a[len(a) - 1] as int) == 0x2F) {
        return a + b
    }
    a + "/" + b
}

/// The final path segment of `p` (trailing slashes ignored); `""` when the
/// path is empty or all slashes.
fn pathName(p: string) -> string {
    var end = len(p) - 1
    while (end >= 0 && (p[end] as int) == 0x2F) {
        end = end - 1
    }
    if (end < 0) {
        return ""
    }
    var start = end
    while (start >= 0 && (p[start] as int) != 0x2F) {
        start = start - 1
    }
    sliceRange(p, start + 1, end + 1)
}

/// The directory portion of `p` (trailing slashes ignored), or `""` when it
/// has no `/`.
fn pathDir(p: string) -> string {
    var end = len(p) - 1
    while (end >= 0 && (p[end] as int) == 0x2F) {
        end = end - 1
    }
    var i = end
    while (i >= 0 && (p[i] as int) != 0x2F) {
        i = i - 1
    }
    if (i < 0) {
        return ""
    }
    sliceRange(p, 0, i)
}

/// The extension of `p` without the dot (Rust `Path::extension`): `"gz"` for
/// `"a.tar.gz"`, `""` for `"a."`, and `none` for a name with no dot or a
/// dotfile such as `".gitignore"`.
fn pathExtension(p: string) -> string? {
    let name = pathName(p)
    if (name == "" || name == "." || name == "..") {
        return none
    }
    var i = len(name) - 1
    while (i >= 0 && (name[i] as int) != 0x2E) {
        i = i - 1
    }
    if (i <= 0) {
        return none
    }
    sliceRange(name, i + 1, len(name))
}

/// Lexically normalize `p`: collapse `//`, drop `.` segments, apply `..` to
/// the preceding segment, keep a leading `/`, and map the empty result to `.`
/// (or `/` for an absolute path).
fn pathNormalize(p: string) -> string {
    var absolute = false
    if (len(p) > 0 && (p[0] as int) == 0x2F) {
        absolute = true
    }
    var parts = [""]
    parts.pop()
    var start = 0
    var i = 0
    while (i <= len(p)) {
        if (i == len(p) || (p[i] as int) == 0x2F) {
            if (i > start) {
                let seg = sliceRange(p, start, i)
                if (seg == "..") {
                    if (len(parts) > 0 && parts[len(parts) - 1] != "..") {
                        parts.pop()
                    } else if (!absolute) {
                        parts.push("..")
                    }
                } else if (seg != ".") {
                    parts.push(seg)
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    var out = ""
    for (seg in parts) {
        if (out != "") {
            out = out + "/"
        }
        out = out + seg
    }
    if (absolute) {
        out = "/" + out
    }
    if (out == "") {
        out = "."
    }
    out
}

/// The absolute form of `p`: an already-absolute path is normalized in place,
/// a relative one is joined to the current directory first.
fn pathAbsolute(p: string) -> string {
    if (len(p) > 0 && (p[0] as int) == 0x2F) {
        return pathNormalize(p)
    }
    let cwd = current_dir()
    match (cwd) {
        case some(c) -> pathNormalize(pathJoin(c, p))
        case none -> pathNormalize(p)
    }
}

/// A POSIX-style path wrapper.
class Path {
    var p: string

    constructor(path: string) {
        this.p = path
    }

    /// The path as text.
    fn text() -> string {
        this.p
    }

    /// `this` joined with `rel`.
    fn join(rel: string) -> Path {
        Path(pathJoin(this.p, rel))
    }

    /// The final segment.
    fn name() -> string {
        pathName(this.p)
    }

    /// The parent directory portion.
    fn dir() -> string {
        pathDir(this.p)
    }

    /// The extension without the dot (Rust `Path::extension`).
    fn extension() -> string? {
        pathExtension(this.p)
    }

    /// The lexically normalized path (`.`/`..` resolved, `//` collapsed).
    fn normalize() -> string {
        pathNormalize(this.p)
    }

    /// The absolute form (relative paths joined to the current directory).
    fn absolute() -> string {
        pathAbsolute(this.p)
    }

    /// Whether the path exists on disk.
    fn exists() -> bool {
        file_exists(this.p)
    }
}

/// A whole-file wrapper bound to one path.
class File {
    var p: string

    constructor(path: string) {
        this.p = path
    }

    /// The bound path.
    fn path() -> string {
        this.p
    }

    /// The whole file's bytes as a string; `none` when unreadable.
    fn read() -> string? {
        read_file(this.p)
    }

    /// Overwrite the file; `false` when the write fails.
    fn write(text: string) -> bool {
        write_file(this.p, text)
    }

    /// Append `text` to the file, creating it when absent; `false` when the
    /// file cannot be opened or the write is short.
    fn append(text: string) -> bool {
        let s = stream_open_append(this.p)
        match (s) {
            case some(st) -> {
                let bs = bytes(text)
                let n = st.write(bs)
                st.close()
                n == len(bs)
            }
            case none -> false
        }
    }

    /// Copy this file's bytes to `dest`, overwriting it; `false` on any
    /// failure.
    fn copy(dest: string) -> bool {
        let text = read_file(this.p)
        match (text) {
            case some(t) -> write_file(dest, t)
            case none -> false
        }
    }

    /// Move this file to `dest` (copy then delete); `false` when either step
    /// fails, leaving the source in place if the copy failed.
    fn move(dest: string) -> bool {
        let text = read_file(this.p)
        match (text) {
            case some(t) -> {
                if (write_file(dest, t)) {
                    return delete(this.p)
                }
                false
            }
            case none -> false
        }
    }

    fn exists() -> bool {
        file_exists(this.p)
    }

    /// Remove the file (or empty directory); `false` when it cannot be.
    fn remove() -> bool {
        delete(this.p)
    }

    /// A buffered read stream; `none` when the file cannot be opened.
    fn openRead() -> Stream? {
        stream_open_read(this.p)
    }
}

/// A directory wrapper bound to one path.
class Dir {
    var p: string

    constructor(path: string) {
        this.p = path
    }

    /// The bound path.
    fn path() -> string {
        this.p
    }

    /// Full child paths in host order; `none` when unreadable/missing.
    fn list() -> List<string>? {
        list_dir(this.p)
    }

    fn exists() -> bool {
        file_exists(this.p)
    }

    /// Create the directory (single level; fails when it already exists).
    fn create() -> bool {
        mkdir(this.p)
    }

    /// Remove the empty directory; `false` when it cannot be.
    fn remove() -> bool {
        delete(this.p)
    }
}