module std.net

// TCP-first networking v1 (blocking, loopback-deterministic). Byte-oriented I/O.
// Endpoints are numeric IPv4 dotted quads (e.g. "127.0.0.1") for portability
// and golden determinism; no DNS in v1.

import { net_tcp_socket, net_close, net_shutdown, net_bind4, net_listen, net_accept, net_connect4, net_send, net_recv, net_local_port4, net_peer_port4, net_set_reuseaddr, net_udp_socket, net_sendto4, net_recvfrom4 } from runtime.abi_net

const INVALID: int = -1
const SHUT_RD: int = 0
const SHUT_WR: int = 1
const SHUT_RDWR: int = 2

fn parseIPv4(host: string) -> List<int>? {
    let n = len(host)
    if (n <= 0) { return none }
    var oct = 0
    var digits = 0
    var val = 0
    var a = -1
    var b = -1
    var c = -1
    var d = -1
    var i = 0
    while (i < n) {
        let ch = host[i] as int
        if (ch == 46) { // '.'
            if (digits == 0 || oct >= 3) { return none }
            if (oct == 0) { a = val }
            if (oct == 1) { b = val }
            if (oct == 2) { c = val }
            oct = oct + 1
            digits = 0
            val = 0
        } else {
            if (ch < 48 || ch > 57) { return none }
            if (digits >= 3) { return none }
            val = val * 10 + (ch - 48)
            if (val > 255) { return none }
            digits = digits + 1
        }
        i = i + 1
    }
    if (oct != 3 || digits == 0) { return none }
    d = val
    if (a < 0 || b < 0 || c < 0) { return none }
    [a, b, c, d]
}

class TcpStream {
    var fd: int
    var closed: bool

    constructor(fd: int) {
        this.fd = fd
        this.closed = false
    }

    /// Connect to numeric IPv4 host:port. Returns none on failure.
    static fn connect(host: string, port: int) -> TcpStream? {
        match (parseIPv4(host)) {
            case some(o) -> {
                let fd = net_tcp_socket()
                if (fd == INVALID || fd == 0) {
                    return none
                }
                let rc = net_connect4(fd, o[0], o[1], o[2], o[3], port)
                if (rc != 0) {
                    let _ = net_close(fd)
                    return none
                }
                return TcpStream(fd)
            }
            case none -> {
                return none
            }
        }
    }

    /// Read up to n bytes. Returns empty list on EOF/error.
    fn read(n: int) -> List<byte> {
        var out = bytes("")
        if (this.closed || n <= 0) { return out }
        unsafe {
            var words = (n + 7) / 8
            if (words < 1) { words = 1 }
            let buf = alloc(int, words)
            var i = 0
            while (i < words) {
                buf[i] = 0
                i = i + 1
            }
            let got = net_recv(this.fd, buf as int, n)
            if (got > 0) {
                var j = 0
                while (j < got) {
                    let b = (buf[j >> 3] >> ((j & 7) * 8)) & 255
                    out.push(b as byte)
                    j = j + 1
                }
            }
            free(buf)
        }
        out
    }

    /// Read exactly n bytes. Returns none on EOF/error before n bytes.
    fn readExact(n: int) -> List<byte>? {
        if (n <= 0) { return bytes("") }
        var out = bytes("")
        var need = n
        while (need > 0) {
            let chunk = this.read(need)
            let got = len(chunk)
            if (got <= 0) { return none }
            var i = 0
            while (i < got) {
                out.push(chunk[i])
                i = i + 1
            }
            need = need - got
        }
        out
    }

    /// Write bytes, returns number sent (may be less on error).
    fn write(data: List<byte>) -> int {
        if (this.closed) { return -1 }
        let n = len(data)
        if (n <= 0) { return 0 }
        unsafe {
            var words = (n + 7) / 8
            if (words < 1) { words = 1 }
            let buf = alloc(int, words)
            var i = 0
            while (i < words) {
                buf[i] = 0
                i = i + 1
            }
            i = 0
            while (i < n) {
                let sh = (i & 7) * 8
                let mask = 255 << sh
                let v = data[i] as int
                buf[i >> 3] = (buf[i >> 3] & ((0 - 1) ^ mask)) | ((v & 255) << sh)
                i = i + 1
            }
            let sent = net_send(this.fd, buf as int, n)
            free(buf)
            return sent
        }
    }

    /// Write all bytes. Returns true only if the full buffer was sent.
    fn writeAll(data: List<byte>) -> bool {
        let n = len(data)
        var off = 0
        while (off < n) {
            var chunk = bytes("")
            var i = off
            while (i < n) {
                chunk.push(data[i])
                i = i + 1
            }
            let sent = this.write(chunk)
            if (sent <= 0) { return false }
            off = off + sent
        }
        true
    }

    /// Best-effort close.
    fn close() {
        if (!this.closed) {
            let _ = net_close(this.fd)
            this.closed = true
            this.fd = INVALID
        }
    }

    fn shutdown(how: int) -> int {
        if (this.closed) { return -1 }
        net_shutdown(this.fd, how)
    }

    fn localPort() -> int {
        if (this.closed) { return -1 }
        net_local_port4(this.fd)
    }

    fn peerPort() -> int {
        if (this.closed) { return -1 }
        net_peer_port4(this.fd)
    }
}

class TcpListener {
    var fd: int
    var closed: bool

    constructor(fd: int) {
        this.fd = fd
        this.closed = false
    }

    /// Bind to numeric IPv4 host:port and listen. port 0 = ephemeral.
    static fn bind(host: string, port: int) -> TcpListener? {
        match (parseIPv4(host)) {
            case some(o) -> {
                let fd = net_tcp_socket()
                if (fd == INVALID || fd == 0) {
                    return none
                }
                let _ = net_set_reuseaddr(fd, 1)
                let br = net_bind4(fd, o[0], o[1], o[2], o[3], port)
                if (br != 0) {
                    let _ = net_close(fd)
                    return none
                }
                let lr = net_listen(fd, 128)
                if (lr != 0) {
                    let _ = net_close(fd)
                    return none
                }
                return TcpListener(fd)
            }
            case none -> {
                return none
            }
        }
    }

    /// Accept a connection (blocking). Returns none on failure.
    fn accept() -> TcpStream? {
        if (this.closed) { return none }
        let cfd = net_accept(this.fd)
        if (cfd == INVALID || cfd == 0) {
            return none
        }
        TcpStream(cfd)
    }

    fn localPort() -> int {
        if (this.closed) { return -1 }
        net_local_port4(this.fd)
    }

    fn close() {
        if (!this.closed) {
            let _ = net_close(this.fd)
            this.closed = true
            this.fd = INVALID
        }
    }
}

class UdpDatagram {
    var data: List<byte>
    var host: string
    var port: int

    constructor(data: List<byte>, host: string, port: int) {
        this.data = data
        this.host = host
        this.port = port
    }
}

class UdpSocket {
    var fd: int
    var closed: bool

    constructor(fd: int) {
        this.fd = fd
        this.closed = false
    }

    /// Bind to numeric IPv4 host:port. port 0 = ephemeral.
    static fn bind(host: string, port: int) -> UdpSocket? {
        match (parseIPv4(host)) {
            case some(o) -> {
                let fd = net_udp_socket()
                if (fd == INVALID || fd == 0) {
                    return none
                }
                let _ = net_set_reuseaddr(fd, 1)
                let br = net_bind4(fd, o[0], o[1], o[2], o[3], port)
                if (br != 0) {
                    let _ = net_close(fd)
                    return none
                }
                return UdpSocket(fd)
            }
            case none -> {
                return none
            }
        }
    }

    fn localPort() -> int {
        if (this.closed) { return -1 }
        net_local_port4(this.fd)
    }

    /// Send datagram to numeric IPv4 host:port. Returns bytes sent or -1.
    fn sendTo(data: List<byte>, host: string, port: int) -> int {
        if (this.closed) { return -1 }
        match (parseIPv4(host)) {
            case some(o) -> {
                let n = len(data)
                if (n < 0) { return -1 }
                if (n == 0) {
                    unsafe {
                        let buf = alloc(int, 1)
                        buf[0] = 0
                        let sent = net_sendto4(this.fd, buf as int, 0, o[0], o[1], o[2], o[3], port)
                        free(buf)
                        return sent
                    }
                }
                unsafe {
                    var words = (n + 7) / 8
                    if (words < 1) { words = 1 }
                    let buf = alloc(int, words)
                    var i = 0
                    while (i < words) {
                        buf[i] = 0
                        i = i + 1
                    }
                    i = 0
                    while (i < n) {
                        let sh = (i & 7) * 8
                        let mask = 255 << sh
                        let v = data[i] as int
                        buf[i >> 3] = (buf[i >> 3] & ((0 - 1) ^ mask)) | ((v & 255) << sh)
                        i = i + 1
                    }
                    let sent = net_sendto4(this.fd, buf as int, n, o[0], o[1], o[2], o[3], port)
                    free(buf)
                    return sent
                }
            }
            case none -> {
                return -1
            }
        }
    }

    /// Receive a datagram (blocking). Returns none on error.
    fn recvFrom(max: int) -> UdpDatagram? {
        if (this.closed || max <= 0) { return none }
        unsafe {
            var words = (max + 7) / 8
            if (words < 1) { words = 1 }
            let buf = alloc(int, words)
            var i = 0
            while (i < words) {
                buf[i] = 0
                i = i + 1
            }
            let meta = alloc(int, 5)
            var m = 0
            while (m < 5) {
                meta[m] = 0
                m = m + 1
            }
            let got = net_recvfrom4(this.fd, buf as int, max, meta as int)
            if (got < 0) {
                free(meta)
                free(buf)
                return none
            }
            var out = bytes("")
            var j = 0
            while (j < got) {
                let b = (buf[j >> 3] >> ((j & 7) * 8)) & 255
                out.push(b as byte)
                j = j + 1
            }
            let host = str(meta[0]) + "." + str(meta[1]) + "." + str(meta[2]) + "." + str(meta[3])
            let port = meta[4]
            free(meta)
            free(buf)
            return UdpDatagram(out, host, port)
        }
    }

    fn close() {
        if (!this.closed) {
            let _ = net_close(this.fd)
            this.closed = true
            this.fd = INVALID
        }
    }
}