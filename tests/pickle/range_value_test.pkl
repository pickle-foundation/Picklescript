test fn range_value_len() {
    let r = 1..5
    expect(len(r)).toBe(4)
}

test fn range_value_index() {
    let r = 1..5
    expect(r[0]).toBe(1)
    expect(r[3]).toBe(4)
}

test fn inclusive_range_value() {
    let r = 1..=4
    expect(len(r)).toBe(4)
    expect(r[0]).toBe(1)
    expect(r[3]).toBe(4)
}

test fn range_value_dynamic_index() {
    let r = 10..14
    var i = 2
    expect(r[i]).toBe(12)
}

test fn range_value_in_for() {
    let r = 2..6
    var sum = 0
    for (x in r) {
        sum = sum + x
    }
    expect(sum).toBe(14)
    expect(len(r)).toBe(4)
}

test fn empty_range_value() {
    let r = 3..3
    expect(len(r)).toBe(0)
    expect(len(5..1)).toBe(0)
}

test fn range_value_in_list() {
    var xs = [1..4, 10..12]
    expect(len(xs[0])).toBe(3)
    expect(xs[1][1]).toBe(11)
}

test fn range_value_index_in_loop() {
    let r = 0..4
    var total = 0
    var i = 0
    while (i < len(r)) {
        total = total + r[i]
        i = i + 1
    }
    expect(total).toBe(6)
}
