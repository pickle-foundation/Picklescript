// `len` through an immutable `&T` borrow reads the referent, exactly like
// `indexRead` does, and a tuple's length is its static arity (constant-folded).
// Rust bails on every borrow form here, so these are beyond-parity.

fn list_len(xs: &List<int>) -> int {
    len(xs)
}

fn str_len(s: &string) -> int {
    len(s)
}

fn map_len(m: &Map<string, int>) -> int {
    len(m)
}

fn str_list_len(xs: &List<string>) -> int {
    len(xs)
}

fn tuple_len(t: &(int, string, bool)) -> int {
    len(t)
}

test fn len_of_list_borrow() {
    var xs = [1, 2, 3]
    expect(list_len(xs)).toBe(3)
}

test fn len_of_string_borrow() {
    expect(str_len("abcd")).toBe(4)
}

test fn len_of_map_borrow() {
    var m = {"a": 1, "b": 2}
    expect(map_len(m)).toBe(2)
}

test fn len_of_tuple_borrow() {
    let t = (1, "a", true)
    expect(tuple_len(t)).toBe(3)
}

test fn len_of_plain_tuple() {
    let t = (10, 20)
    expect(len(t)).toBe(2)
}

test fn len_of_inline_tuple() {
    expect(len((1, 2, 3))).toBe(3)
}

test fn borrow_len_in_expression() {
    var xs = [1, 2, 3, 4]
    expect(list_len(xs) + 1).toBe(5)
    expect(list_len(xs) * 2).toBe(8)
}

test fn tuple_len_in_expression() {
    let t = (1, 2, 3)
    expect(len(t) + len(t)).toBe(6)
}

test fn len_of_nested_tuple_element() {
    let t = ((1, 2), (3, 4, 5))
    expect(len(t)).toBe(2)
    expect(len(t[1])).toBe(3)
}

test fn len_of_borrowed_list_of_strings() {
    var xs = ["a", "bb", "ccc"]
    expect(str_list_len(xs)).toBe(3)
}

test fn len_of_borrowed_map_after_mutation() {
    var m = {"a": 1}
    expect(map_len(m)).toBe(1)
    m["b"] = 2
    expect(map_len(m)).toBe(2)
}
