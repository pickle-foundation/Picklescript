fn greet(name: string) -> string {
    format("Hello, %s!", name)
}

fn sum_line(a: int, b: int) -> string {
    format("%s + %s = %s", a, b, a + b)
}

test fn format_substitutes_one_placeholder() {
    expect(format("Hello, %s!", "World")).toBe("Hello, World!")
    expect(format("%s", "solo")).toBe("solo")
}

test fn format_substitutes_in_order() {
    expect(sum_line(2, 3)).toBe("2 + 3 = 5")
    expect(format("%s-%s-%s", "a", "b", "c")).toBe("a-b-c")
}

test fn format_stringifies_scalars() {
    expect(format("%s", 42)).toBe("42")
    expect(format("%s", -7)).toBe("-7")
    expect(format("%s", 1.5)).toBe("1.5")
    expect(format("%s", true)).toBe("true")
    expect(format("%s", false)).toBe("false")
    expect(format("%s", 'x')).toBe("x")
}

test fn format_mixes_types() {
    expect(format("n=%s ok=%s", 10, true)).toBe("n=10 ok=true")
}

test fn format_copies_text_without_placeholders() {
    expect(format("plain text")).toBe("plain text")
    expect(format("")).toBe("")
}

test fn format_escapes_a_percent() {
    expect(format("100%% sure")).toBe("100% sure")
    expect(format("%s%%", 50)).toBe("50%")
    expect(format("%%%s", 1)).toBe("%1")
}

test fn format_leaves_unknown_percent_sequences() {
    expect(format("a%b")).toBe("a%b")
    expect(format("trailing %")).toBe("trailing %")
    expect(format("%x")).toBe("%x")
}

test fn format_leaves_missing_placeholders_literal() {
    expect(format("%s%s", "a")).toBe("a%s")
    expect(format("%s")).toBe("%s")
}

test fn format_ignores_extra_arguments() {
    expect(format("hi %s", "there", "extra", 9)).toBe("hi there")
    expect(format("no slots", 1, 2)).toBe("no slots")
}

test fn format_reads_a_runtime_template() {
    var tpl = "value = %s"
    expect(format(tpl, 7)).toBe("value = 7")
    tpl = "%s and %s"
    expect(format(tpl, "x", "y")).toBe("x and y")
}

test fn format_supports_byte_lists() {
    let bs = bytes("abc")
    expect(format("[%s]", bs)).toBe("[abc]")
}

test fn format_preserves_multibyte_text() {
    expect(format("caf\u{e9} %s", "\u{4f60}\u{597d}")).toBe("caf\u{e9} \u{4f60}\u{597d}")
}

test fn format_composes_with_members() {
    let xs = ["a", "b", "c"]
    expect(format("%s:%s", xs.join("+"), xs.len())).toBe("a+b+c:3")
}
