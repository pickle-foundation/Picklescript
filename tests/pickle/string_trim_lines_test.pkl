// `String.trimStart`, `String.trimEnd`, and `String.splitLines`: beyond-parity
// byte-oriented members. `trim` remains the both-ends form; `splitLines` follows
// Rust's `str::lines` (a final ending is optional, `\r\n` is one ending).

fn borrowed_trim_start(s: &string) -> string {
    s.trimStart()
}

fn borrowed_trim_end(s: &string) -> string {
    s.trimEnd()
}

fn borrowed_split_lines(s: &string) -> List<string> {
    s.splitLines()
}

test fn trim_start_strips_leading_whitespace_only() {
    expect("  hi  ".trimStart()).toBe("hi  ")
    expect("\t\n hi".trimStart()).toBe("hi")
    expect("hi".trimStart()).toBe("hi")
    expect("   ".trimStart()).toBe("")
}

test fn trim_end_strips_trailing_whitespace_only() {
    expect("  hi  ".trimEnd()).toBe("  hi")
    expect("hi \r\n\t".trimEnd()).toBe("hi")
    expect("hi".trimEnd()).toBe("hi")
    expect("   ".trimEnd()).toBe("")
}

test fn trim_start_and_trim_end_compose_like_trim() {
    let s = "\t hello world \r\n"
    expect(s.trimStart().trimEnd()).toBe("hello world")
    expect(s.trimStart().trimEnd()).toBe(s.trim())
}

test fn trim_members_read_through_an_immutable_borrow() {
    expect(borrowed_trim_start("  a ")).toBe("a ")
    expect(borrowed_trim_end(" a  ")).toBe(" a")
}

test fn split_lines_splits_on_newline() {
    let ls = "a\nb\nc".splitLines()
    expect(ls.len()).toBe(3)
    expect(ls[0]).toBe("a")
    expect(ls[1]).toBe("b")
    expect(ls[2]).toBe("c")
}

test fn split_lines_drops_a_final_ending_and_a_cr_before_lf() {
    expect("a\r\nb\n".splitLines().len()).toBe(2)
    let ls = "a\r\nb".splitLines()
    expect(ls[0]).toBe("a")
    expect(ls[1]).toBe("b")
}

test fn split_lines_keeps_interior_empty_lines() {
    let ls = "a\n\nb".splitLines()
    expect(ls.len()).toBe(3)
    expect(ls[0]).toBe("a")
    expect(ls[1]).toBe("")
    expect(ls[2]).toBe("b")
}

test fn split_lines_of_empty_and_ending_only_strings() {
    expect("".splitLines().len()).toBe(0)
    let onlyNl = "\n".splitLines()
    expect(onlyNl.len()).toBe(1)
    expect(onlyNl[0]).toBe("")
    expect("\r\n".splitLines().len()).toBe(1)
}

test fn split_lines_reads_through_an_immutable_borrow() {
    let ls = borrowed_split_lines("x\ny")
    expect(ls.len()).toBe(2)
    expect(ls[1]).toBe("y")
}
