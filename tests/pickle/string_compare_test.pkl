// String ordering: `<`, `<=`, `>`, `>=` compare bytes lexicographically via
// `pickle_str_cmp` (the same primitive `==`/`!=` already used). Rust's checker
// rejects every non-equality string comparison, so this is beyond parity.

fn before(a: string, b: string) -> bool {
    a < b
}

test fn less_and_greater() {
    expect("abc" < "abd").toBe(true)
    expect("abd" < "abc").toBe(false)
    expect("abd" > "abc").toBe(true)
    expect("abc" > "abd").toBe(false)
}

test fn inclusive_bounds() {
    expect("abc" <= "abc").toBe(true)
    expect("abc" >= "abc").toBe(true)
    expect("abc" <= "abd").toBe(true)
    expect("abd" >= "abc").toBe(true)
    expect("abc" <= "abb").toBe(false)
    expect("abc" >= "abd").toBe(false)
}

test fn equality_is_unchanged() {
    expect("abc" == "abc").toBe(true)
    expect("abc" != "abd").toBe(true)
    expect("abc" == "abd").toBe(false)
    expect("abc" != "abc").toBe(false)
}

test fn prefix_is_less() {
    expect("ab" < "abc").toBe(true)
    expect("abc" > "ab").toBe(true)
    expect("" < "a").toBe(true)
    expect("" <= "").toBe(true)
    expect("" > "").toBe(false)
}

test fn compares_variables_and_literals() {
    let a = "apple"
    let b = "banana"
    expect(a < b).toBe(true)
    expect(b > a).toBe(true)
    expect(a < "apricot").toBe(true)
    expect("apricot" > a).toBe(true)
}

test fn through_a_function_parameter() {
    expect(before("a", "b")).toBe(true)
    expect(before("b", "a")).toBe(false)
    expect(before("a", "a")).toBe(false)
}

test fn usable_in_a_condition() {
    var words = ["pear", "apple", "zebra"]
    var i = 1
    while (i < len(words)) {
        if (words[i] < words[0]) {
            words[0] = words[i]
        }
        i = i + 1
    }
    expect(words[0]).toBe("apple")
}

test fn built_strings_compare_by_value() {
    let left = "ab" + "c"
    let right = "ab" + "d"
    expect(left < right).toBe(true)
    expect(left == "abc").toBe(true)
}

test fn byte_order_for_non_ascii() {
    // `pickle_str_cmp` compares UTF-8 bytes, so the multi-byte 'é' (C3 A9)
    // sorts after ASCII 'z' (7A). This is the runtime's documented order.
    expect("é" > "z").toBe(true)
    expect("é" != "e").toBe(true)
}

test fn ordering_result_is_a_bool() {
    let less = "a" < "b"
    expect(less).toBe(true)
    let ge = "b" >= "b"
    expect(ge).toBe(true)
}
