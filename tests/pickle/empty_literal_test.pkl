// Empty collection literals and typed collection constructors.
//
// `[]` carries no element type of its own, so it adopts the type of the
// position it initializes: an annotated `let`/`var`/`const`, a `return`, the
// tail expression of a block-bodied function, an assignment, a field
// initializer, and a call argument. `{}` parses as an empty block (459 match
// arms rely on it), so an empty map is written `Map<K,V>()`; `List<T>()` is the
// explicit empty-list form.

module empty_literal_test

fn empty_ints() -> List<int> {
    return []
}

fn empty_tail_ints() -> List<int> {
    []
}

fn take_ints(xs: List<int>) -> int {
    xs.len()
}

class Holder {
    var xs: List<int> = []
    var m: Map<string, int> = Map<string, int>()
    static var shared: List<string> = []
}

test fn annotated_let_adopts_the_element_type() {
    let xs: List<int> = []
    expect(xs.len()).toBe(0)
    xs.push(3)
    expect(xs[0]).toBe(3)
}

test fn annotated_var_starts_empty() {
    var xs: List<string> = []
    expect(xs.isEmpty()).toBe(true)
    xs.push("a")
    expect(xs.len()).toBe(1)
}

test fn annotated_const_starts_empty() {
    const xs: List<int> = []
    expect(xs.len()).toBe(0)
}

test fn return_adopts_the_declared_type() {
    expect(empty_ints().len()).toBe(0)
}

test fn implicit_tail_adopts_the_declared_type() {
    expect(empty_tail_ints().len()).toBe(0)
}

test fn assignment_adopts_the_binding_type() {
    var xs: List<int> = [1, 2]
    xs = []
    expect(xs.len()).toBe(0)
    xs.push(9)
    expect(xs.len()).toBe(1)
}

test fn call_argument_adopts_the_parameter_type() {
    expect(take_ints([])).toBe(0)
    let rows: List<List<int>> = []
    rows.push([])
    expect(rows.len()).toBe(1)
    expect(rows[0].len()).toBe(0)
}

test fn field_initializer_adopts_the_field_type() {
    let h = Holder()
    expect(h.xs.len()).toBe(0)
    expect(h.m.len()).toBe(0)
    expect(Holder.shared.len()).toBe(0)
    h.xs.push(4)
    expect(h.xs[0]).toBe(4)
}

test fn map_constructor_is_empty() {
    let m: Map<string, int> = Map<string, int>()
    expect(m.len()).toBe(0)
    m["a"] = 1
    expect(m.get("a").unwrap()).toBe(1)
}

test fn map_constructor_infers_from_the_call() {
    let m = Map<int, string>()
    expect(m.len()).toBe(0)
    m[7] = "x"
    expect(m.get(7).unwrap()).toBe("x")
}

test fn map_constructor_accepts_pointer_values() {
    let m = Map<string, List<int>>()
    m["xs"] = []
    expect(m.get("xs").unwrap().len()).toBe(0)
}

test fn map_constructor_index_assignment_adopts_empty_list() {
    let m = Map<string, List<int>>()
    m["xs"] = []
    m["ys"] = [1]
    expect(m.get("ys").unwrap().len()).toBe(1)
}

test fn list_constructor_is_empty() {
    let xs = List<int>()
    expect(xs.len()).toBe(0)
    xs.push(5)
    expect(xs[0]).toBe(5)
}

test fn list_constructor_nests() {
    let rows = List<List<string>>()
    rows.push(List<string>())
    expect(rows.len()).toBe(1)
    expect(rows[0].len()).toBe(0)
}

test fn list_constructor_returns_a_fresh_list() {
    let a = List<int>()
    let b = List<int>()
    a.push(1)
    expect(b.len()).toBe(0)
}

test fn empty_map_can_be_refilled_after_clear() {
    let m = Map<string, int>()
    m["a"] = 1
    m.clear()
    expect(m.len()).toBe(0)
    m["b"] = 2
    expect(m.get("b").unwrap()).toBe(2)
}
