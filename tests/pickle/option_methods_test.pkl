test fn option_is_some_reports_presence() {
    let someVal: int? = 5
    let noneVal: int? = none
    expect(someVal.isSome()).toBe(true)
    expect(noneVal.isSome()).toBe(false)
}

test fn option_is_none_is_the_complement() {
    let someVal: int? = 5
    let noneVal: int? = none
    expect(someVal.isNone()).toBe(false)
    expect(noneVal.isNone()).toBe(true)
}

test fn option_unwrap_returns_the_payload() {
    let o: int? = 42
    expect(o.unwrap()).toBe(42)
    let s: string? = "hi"
    expect(s.unwrap()).toBe("hi")
}

test fn option_unwrap_or_returns_payload_or_default() {
    let someVal: int? = 7
    let noneVal: int? = none
    expect(someVal.unwrapOr(0)).toBe(7)
    expect(noneVal.unwrapOr(0)).toBe(0)
    expect(noneVal.unwrapOr(-1)).toBe(-1)
}

test fn option_expect_returns_the_payload_when_present() {
    let o: int? = 9
    expect(o.expect("missing")).toBe(9)
    let s: string? = "ok"
    expect(s.expect("missing")).toBe("ok")
}

test fn option_methods_compose_with_map_get() {
    let m = {"a": 1}
    expect(m.get("a").isSome()).toBe(true)
    expect(m.get("z").isNone()).toBe(true)
    expect(m.get("a").unwrap()).toBe(1)
    expect(m.get("z").unwrapOr(0)).toBe(0)
    expect(m.get("a").expect("present")).toBe(1)
}

fn borrowed_is_some(o: &int?) -> bool {
    o.isSome()
}

fn borrowed_unwrap_or(o: &int?, d: int) -> int {
    o.unwrapOr(d)
}

test fn option_methods_read_through_an_immutable_borrow() {
    let o: int? = 5
    expect(borrowed_is_some(o)).toBe(true)
    expect(borrowed_unwrap_or(o, 0)).toBe(5)
    let z: int? = none
    expect(borrowed_is_some(z)).toBe(false)
    expect(borrowed_unwrap_or(z, 3)).toBe(3)
}

fn option_double(v: int) -> int {
    v * 2
}

fn option_positive(v: int) -> int? {
    if (v > 0) {
        return v
    }
    none
}

test fn option_map_transforms_the_payload() {
    let someVal: int? = 5
    let noneVal: int? = none
    expect(someVal.map((v: int) => v * 2).unwrap()).toBe(10)
    expect(noneVal.map((v: int) => v * 2).isNone()).toBe(true)
}

test fn option_map_can_change_the_payload_type() {
    let someVal: int? = 7
    expect(someVal.map((v: int) => str(v)).unwrap()).toBe("7")
}

test fn option_map_accepts_a_named_function() {
    let someVal: int? = 4
    expect(someVal.map(option_double).unwrap()).toBe(8)
}

test fn option_map_result_binds_as_an_option() {
    let someVal: int? = 2
    let doubled: int? = someVal.map((v: int) => v * 2)
    expect(doubled.unwrap()).toBe(4)
}

test fn option_map_composes_with_map_get() {
    let m = {"a": 3}
    expect(m.get("a").map((v: int) => v + 1).unwrap()).toBe(4)
    expect(m.get("z").map((v: int) => v + 1).isNone()).toBe(true)
}

test fn option_flat_map_flattens_present_and_absent() {
    let someVal: int? = 3
    let noneVal: int? = none
    expect(someVal.flatMap((v: int) -> int? { v * 2 }).unwrap()).toBe(6)
    expect(noneVal.flatMap((v: int) -> int? { v * 2 }).isNone()).toBe(true)
}

test fn option_flat_map_can_filter() {
    let yes: int? = 5
    let no: int? = -5
    expect(yes.flatMap(option_positive).unwrap()).toBe(5)
    expect(no.flatMap(option_positive).isNone()).toBe(true)
}

test fn option_flat_map_result_binds_as_an_option() {
    let someVal: int? = 6
    let flat: int? = someVal.flatMap((v: int) -> int? { v + 1 })
    expect(flat.unwrap()).toBe(7)
}

fn borrowed_option_map(o: &int?) -> int? {
    o.map((v: int) => v + 1)
}

test fn option_map_reads_through_an_immutable_borrow() {
    let o: int? = 5
    expect(borrowed_option_map(o).unwrap()).toBe(6)
    let z: int? = none
    expect(borrowed_option_map(z).isNone()).toBe(true)
}

