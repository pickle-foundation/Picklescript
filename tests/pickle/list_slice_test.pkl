test fn slice_returns_the_requested_span() {
    let xs = [10, 20, 30, 40]
    let s = xs.slice(1, 3)
    expect(len(s)).toBe(2)
    expect(s[0]).toBe(20)
    expect(s[1]).toBe(30)
    // The receiver is untouched.
    expect(len(xs)).toBe(4)
    expect(xs[1]).toBe(20)
}

test fn slice_clamps_bounds_and_handles_empty_spans() {
    let xs = [1, 2, 3]
    expect(len(xs.slice(0, 99))).toBe(3)
    expect(len(xs.slice(0 - 5, 2))).toBe(2)
    expect(len(xs.slice(2, 1))).toBe(0)
    expect(len(xs.slice(1, 1))).toBe(0)
    expect(len(xs.slice(3, 3))).toBe(0)
}

test fn slice_works_for_string_elements() {
    let xs = ["a", "b", "c"]
    let s = xs.slice(1, 3)
    expect(len(s)).toBe(2)
    expect(s[0]).toBe("b")
    expect(s[1]).toBe("c")
}

test fn slice_is_a_fresh_list() {
    let xs = [1, 2, 3]
    let s = xs.slice(0, 2)
    s.push(9)
    expect(len(s)).toBe(3)
    expect(len(xs)).toBe(3)
    xs[0] = 7
    expect(s[0]).toBe(1)
}

fn borrowed_slice(xs: &List<int>, a: int, b: int) -> List<int> {
    xs.slice(a, b)
}

test fn slice_reads_through_an_immutable_borrow() {
    let xs = [1, 2, 3, 4]
    let s = borrowed_slice(xs, 1, 4)
    expect(len(s)).toBe(3)
    expect(s[0]).toBe(2)
    expect(s[2]).toBe(4)
}
