fn list_double(v: int) -> int {
    v * 2
}

fn list_is_even(v: int) -> bool {
    v % 2 == 0
}

fn borrowed_map(xs: &List<int>) -> List<int> {
    xs.map((v: int) => v + 1)
}

fn borrowed_filter(xs: &List<int>) -> List<int> {
    xs.filter((v: int) => v > 1)
}

test fn map_transforms_every_element() {
    let xs = [1, 2, 3]
    let ys = xs.map((v: int) => v * 2)
    expect(ys.len()).toBe(3)
    expect(ys[0]).toBe(2)
    expect(ys[1]).toBe(4)
    expect(ys[2]).toBe(6)
}

test fn map_can_change_the_element_type() {
    let xs = [1, 2, 3]
    let ss = xs.map((v: int) => str(v))
    expect(ss[0]).toBe("1")
    expect(ss[2]).toBe("3")
    expect(ss.join(",")).toBe("1,2,3")
}

test fn map_accepts_a_named_function() {
    let xs = [4, 5]
    let ys = xs.map(list_double)
    expect(ys[0]).toBe(8)
    expect(ys[1]).toBe(10)
}

test fn map_of_an_empty_list_is_empty() {
    var xs = ["seed"]
    xs.clear()
    let ys = xs.map((v: string) => v + "!")
    expect(ys.isEmpty()).toBe(true)
}

test fn map_leaves_the_receiver_unchanged() {
    let xs = [1, 2]
    let ys = xs.map((v: int) => v + 10)
    expect(xs[0]).toBe(1)
    expect(ys[0]).toBe(11)
}

test fn filter_keeps_matching_elements() {
    let xs = [1, 2, 3, 4, 5, 6]
    let evens = xs.filter(list_is_even)
    expect(evens.len()).toBe(3)
    expect(evens[0]).toBe(2)
    expect(evens[2]).toBe(6)
}

test fn filter_can_drop_everything_or_keep_everything() {
    let xs = [1, 2, 3]
    let noneKept = xs.filter((v: int) => false)
    expect(noneKept.isEmpty()).toBe(true)
    let allKept = xs.filter((v: int) => true)
    expect(allKept.len()).toBe(3)
}

test fn filter_preserves_string_elements() {
    let xs = ["a", "bb", "ccc"]
    let long = xs.filter((s: string) => s.len() > 1)
    expect(long.len()).toBe(2)
    expect(long[0]).toBe("bb")
    expect(long[1]).toBe("ccc")
}

test fn map_and_filter_chain() {
    let xs = [1, 2, 3, 4]
    let out = xs.filter((v: int) => v % 2 == 0).map((v: int) => v * 10)
    expect(out.len()).toBe(2)
    expect(out[0]).toBe(20)
    expect(out[1]).toBe(40)
    expect(out.map((v: int) => str(v)).join(",")).toBe("20,40")
}

test fn map_and_filter_read_through_an_immutable_borrow() {
    let xs = [1, 2, 3]
    expect(borrowed_map(xs)[0]).toBe(2)
    expect(borrowed_filter(xs).len()).toBe(2)
}

test fn map_boxes_float_and_bool_elements() {
    let fs = [1.5, 2.5]
    let gs = fs.map((v: float) => v * 2.0)
    expect(gs[0]).toBe(3.0)
    let bs = [true, false]
    let neg = bs.map((v: bool) => !v)
    expect(neg[0]).toBe(false)
    expect(neg[1]).toBe(true)
}
