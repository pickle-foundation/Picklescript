// `Option.filter` and `Option.toList`: beyond-parity members on `T?`.
// `filter` keeps the receiver when the predicate passes; `toList` is a fresh
// zero-or-one element list. Both read through `&T?`.

fn opt_positive(v: int) -> bool {
    v > 0
}

fn borrowed_option_filter(o: &int?) -> int? {
    o.filter((v: int) => v > 0)
}

fn borrowed_option_to_list(o: &int?) -> List<int> {
    o.toList()
}

test fn option_filter_keeps_a_passing_payload() {
    let o: int? = 5
    expect(o.filter((v: int) => v > 0).unwrap()).toBe(5)
}

test fn option_filter_drops_a_failing_payload() {
    let o: int? = -5
    expect(o.filter((v: int) => v > 0).isNone()).toBe(true)
}

test fn option_filter_of_none_is_none_without_calling_the_predicate() {
    let z: int? = none
    expect(z.filter((v: int) => v > 0).isNone()).toBe(true)
}

test fn option_filter_accepts_a_named_function() {
    let o: int? = 3
    expect(o.filter(opt_positive).unwrap()).toBe(3)
}

test fn option_filter_works_on_strings() {
    let s: string? = "hi"
    expect(s.filter((v: string) => v.len() > 1).unwrap()).toBe("hi")
    expect(s.filter((v: string) => v.len() > 5).isNone()).toBe(true)
}

test fn option_to_list_wraps_a_present_payload() {
    let o: int? = 7
    let xs = o.toList()
    expect(xs.len()).toBe(1)
    expect(xs[0]).toBe(7)
}

test fn option_to_list_of_none_is_empty() {
    let z: int? = none
    expect(z.toList().isEmpty()).toBe(true)
}

test fn option_to_list_works_on_strings() {
    let s: string? = "x"
    expect(s.toList().join(",")).toBe("x")
    let n: string? = none
    expect(n.toList().len()).toBe(0)
}

test fn option_filter_and_to_list_read_through_an_immutable_borrow() {
    let o: int? = 4
    expect(borrowed_option_filter(o).unwrap()).toBe(4)
    expect(borrowed_option_to_list(o).len()).toBe(1)
    let z: int? = none
    expect(borrowed_option_filter(z).isNone()).toBe(true)
    expect(borrowed_option_to_list(z).isEmpty()).toBe(true)
}
