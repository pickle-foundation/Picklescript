// `List.reduce(f)`: fold from the first element. An empty list is `none`.

fn borrowed_reduce(xs: &List<int>) -> int? {
    xs.reduce((a: int, b: int) => a + b)
}

test fn reduce_folds_from_the_first_element() {
    let xs = [1, 2, 3, 4]
    expect(xs.reduce((a: int, b: int) => a + b).unwrap()).toBe(10)
}

test fn reduce_of_one_element_is_that_element() {
    let xs = [7]
    expect(xs.reduce((a: int, b: int) => a + b).unwrap()).toBe(7)
}

test fn reduce_of_empty_is_none() {
    var xs = [0]
    xs.clear()
    expect(xs.reduce((a: int, b: int) => a + b).isNone()).toBe(true)
}

test fn reduce_can_compute_a_maximum() {
    let xs = [3, 9, 2]
    expect(xs.reduce((a: int, b: int) => max(a, b)).unwrap()).toBe(9)
}

test fn reduce_reads_through_an_immutable_borrow() {
    let xs = [1, 2, 3]
    expect(borrowed_reduce(xs).unwrap()).toBe(6)
}

test fn reduce_works_on_strings() {
    let words = ["x", "y", "z"]
    expect(words.reduce((a: string, b: string) => a + b).unwrap()).toBe("xyz")
}

test fn reduce_threads_left_to_right() {
    let xs = [1, 2, 3]
    // 1 - 2 - 3 = -4
    expect(xs.reduce((a: int, b: int) => a - b).unwrap()).toBe(0 - 4)
}
