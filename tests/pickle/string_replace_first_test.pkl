// `String.replaceFirst(from, to)`: beyond-parity first-occurrence replace.
// Always returns a fresh string; a missing or empty needle copies the input.

fn borrowed_replace_first(s: &string, needle: string, repl: string) -> string {
    s.replaceFirst(needle, repl)
}

test fn replace_first_replaces_only_the_first_match() {
    expect("abcabc".replaceFirst("ab", "X")).toBe("Xcabc")
}

test fn replace_first_without_a_match_returns_a_copy() {
    expect("abc".replaceFirst("zz", "X")).toBe("abc")
    let s = "abc"
    let r = s.replaceFirst("zz", "X")
    expect(r).toBe("abc")
}

test fn replace_first_with_an_empty_needle_is_a_copy() {
    expect("ab".replaceFirst("", "X")).toBe("ab")
}

test fn replace_first_handles_longer_and_shorter_replacements() {
    expect("abc".replaceFirst("b", "XY")).toBe("aXYc")
    expect("aXXbc".replaceFirst("XX", "b")).toBe("abbc")
}

test fn replace_first_handles_empty_input() {
    expect("".replaceFirst("a", "b")).toBe("")
}

test fn replace_first_reads_through_an_immutable_borrow() {
    expect(borrowed_replace_first("a-b-c", "-", "+")).toBe("a+b-c")
}
