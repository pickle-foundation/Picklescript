// `Map.clear`: beyond-parity. Empties the map in place and keeps the table, so
// the same map can be refilled without a rehash.

fn borrowed_len(m: &Map<string, int>) -> int {
    m.len()
}

test fn clear_empties_the_map() {
    var m = {"a": 1, "b": 2}
    expect(m.len()).toBe(2)
    m.clear()
    expect(m.len()).toBe(0)
    expect(m.isEmpty()).toBe(true)
    expect(m.has("a")).toBe(false)
    expect(m.keys().len()).toBe(0)
    expect(m.entries().len()).toBe(0)
}

test fn clear_leaves_the_map_usable() {
    var m = {"a": 1}
    m.clear()
    m["b"] = 2
    m["c"] = 3
    expect(m.len()).toBe(2)
    expect(m["b"]).toBe(2)
    expect(m["c"]).toBe(3)
    expect(m.has("a")).toBe(false)
}

test fn clear_is_idempotent_and_survives_removal() {
    var m = {"a": 1, "b": 2, "c": 3}
    m.remove("b")
    expect(m.len()).toBe(2)
    m.clear()
    m.clear()
    expect(m.len()).toBe(0)
    expect(borrowed_len(m)).toBe(0)
}
