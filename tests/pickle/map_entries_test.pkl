test fn entries_counts_each_entry_once() {
    let m = {"a": 1, "b": 2, "c": 3}
    var n = 0
    var sum = 0
    for ((k, v) in m) {
        n += 1
        sum += v
        if (v != m[k]) {
            expect(false).toBe(true)
        }
    }
    expect(n).toBe(3)
    expect(sum).toBe(6)
}

test fn entries_value_is_the_map_value_at_its_key() {
    let m = {"x": 10, "y": 20, "z": 30}
    var ok = true
    var n = 0
    for ((k, v) in m) {
        n += 1
        if (v != m[k]) {
            ok = false
        }
    }
    expect(n).toBe(3)
    expect(ok).toBe(true)
}

test fn entries_string_values_pair_correctly() {
    let m = {"alpha": "one", "beta": "two"}
    let want = {"alpha": "one", "beta": "two"}
    var ok = true
    var n = 0
    for ((k, v) in m) {
        n += 1
        if (v != want[k]) {
            ok = false
        }
    }
    expect(n).toBe(2)
    expect(ok).toBe(true)
}

test fn entries_break_early() {
    let m = {"a": 1}
    var ran = 0
    for ((k, v) in m) {
        ran += 1
        if (k == "a" && v == 1) {
            break
        }
    }
    expect(ran).toBe(1)
}

test fn plain_for_still_iterates_values() {
    let m = {"a": 1, "b": 2}
    var sum = 0
    for (v in m) {
        sum += v
    }
    expect(sum).toBe(3)
}

test fn entries_method_returns_every_pair() {
    let m = {"a": 1, "b": 2, "c": 3}
    let es = m.entries()
    expect(len(es)).toBe(3)
    var sum = 0
    var n = 0
    for ((k, v) in es) {
        n += 1
        sum += v
        expect(v).toBe(m[k])
    }
    expect(n).toBe(3)
    expect(sum).toBe(6)
}

test fn entries_method_of_empty_map_is_empty() {
    var m = {"seed": 0}
    m.remove("seed")
    let es = m.entries()
    expect(len(es)).toBe(0)
}

test fn entries_method_pairs_are_indexable_tuples() {
    let m = {"a": 10}
    let es = m.entries()
    expect(es[0][0]).toBe("a")
    expect(es[0][1]).toBe(10)
}

test fn entries_method_supports_for_destructuring() {
    let m = {"x": "one", "y": "two"}
    var ok = true
    for ((k, v) in m.entries()) {
        if (v != m[k]) {
            ok = false
        }
    }
    expect(ok).toBe(true)
}

fn borrowed_entries(m: &Map<string, int>) -> List<(string, int)> {
    m.entries()
}

test fn entries_method_reads_through_an_immutable_borrow() {
    let m = {"a": 1, "b": 2}
    let es = borrowed_entries(m)
    expect(len(es)).toBe(2)
}