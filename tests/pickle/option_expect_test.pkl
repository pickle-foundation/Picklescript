// `expect` on Option-typed values. `pickle_expect_obj_eq` compares two managed
// pointers, so the raw scalar side of an `int?`/`float?`/`bool?`/`char?` compare
// must be boxed first; passing it straight through dereferences the integer as a
// pointer. `none` (unit) is already null and needs no boxing.

test fn option_some_vs_int_literal() {
    var o: int? = 5
    expect(o).toBe(5)
}

test fn option_some_vs_string_literal() {
    var o: string? = "hi"
    expect(o).toBe("hi")
}

test fn option_some_vs_bool_literal() {
    var o: bool? = true
    expect(o).toBe(true)
}

test fn option_some_vs_float_literal() {
    var o: float? = 1.5
    expect(o).toBe(1.5)
}

test fn option_some_vs_char_literal() {
    var o: char? = 'x'
    expect(o).toBe('x')
}

test fn option_none_vs_none() {
    var o: int? = none
    expect(o).toBe(none)
}

test fn option_some_is_not_none() {
    var o: int? = 5
    expect(o).not().toBe(none)
}

test fn option_none_is_not_a_value() {
    var o: int? = none
    expect(o).not().toBe(5)
}

test fn option_vs_option() {
    var a: int? = 5
    var b: int? = 5
    expect(a).toBe(b)
}

test fn option_to_equal_scalar() {
    var a: int? = 5
    expect(a).toEqual(5)
}

test fn option_wrong_value_fails_cleanly() {
    var o: int? = 5
    // A mismatch is a normal test failure, not a crash: the harness records it
    // under capture and the value renders through the boxed representation.
    expect(o).not().toBe(6)
}

class Holder {
    var o: int?
}

test fn option_field_vs_scalar() {
    var h = Holder(none)
    h.o = 7
    expect(h.o).toBe(7)
    expect(h.o).not().toBe(8)
}
