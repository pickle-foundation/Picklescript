// `List.reversed`, `List.distinct`, `List.chunks`, and `List.windows`:
// beyond-parity producers of fresh lists. All read through `&List` and leave
// the receiver untouched.

fn borrowed_reversed(xs: &List<int>) -> List<int> {
    xs.reversed()
}

fn borrowed_distinct(xs: &List<int>) -> List<int> {
    xs.distinct()
}

fn borrowed_chunks(xs: &List<int>, n: int) -> List<List<int>> {
    xs.chunks(n)
}

fn borrowed_windows(xs: &List<int>, n: int) -> List<List<int>> {
    xs.windows(n)
}

test fn reversed_returns_a_fresh_reversed_copy() {
    let xs = [1, 2, 3]
    let r = xs.reversed()
    expect(r.len()).toBe(3)
    expect(r[0]).toBe(3)
    expect(r[1]).toBe(2)
    expect(r[2]).toBe(1)
    expect(xs[0]).toBe(1)
    expect(xs[2]).toBe(3)
    // Fresh: growing the copy leaves the source alone.
    r.push(99)
    expect(r.len()).toBe(4)
    expect(xs.len()).toBe(3)
}

test fn reversed_of_empty_and_single() {
    var xs = [0]
    xs.clear()
    expect(xs.reversed().isEmpty()).toBe(true)
    let one = [7]
    expect(one.reversed()[0]).toBe(7)
}

test fn reversed_reads_through_an_immutable_borrow() {
    let xs = [1, 2, 3]
    expect(borrowed_reversed(xs)[0]).toBe(3)
}

test fn distinct_keeps_first_occurrences_in_order() {
    let xs = [3, 1, 3, 2, 1, 3]
    let d = xs.distinct()
    expect(d.len()).toBe(3)
    expect(d[0]).toBe(3)
    expect(d[1]).toBe(1)
    expect(d[2]).toBe(2)
    expect(xs.len()).toBe(6)
}

test fn distinct_compares_strings_by_value() {
    let xs = ["a", "b", "a", "c", "b"]
    let d = xs.distinct()
    expect(d.len()).toBe(3)
    expect(d[0]).toBe("a")
    expect(d[1]).toBe("b")
    expect(d[2]).toBe("c")
}

test fn distinct_of_empty_is_empty() {
    var xs = [0]
    xs.clear()
    expect(xs.distinct().isEmpty()).toBe(true)
}

test fn distinct_reads_through_an_immutable_borrow() {
    let xs = [1, 1, 2]
    expect(borrowed_distinct(xs).len()).toBe(2)
}

test fn chunks_splits_into_consecutive_groups() {
    let xs = [1, 2, 3, 4, 5]
    let cs = xs.chunks(2)
    expect(cs.len()).toBe(3)
    expect(cs[0].len()).toBe(2)
    expect(cs[0][0]).toBe(1)
    expect(cs[0][1]).toBe(2)
    expect(cs[2].len()).toBe(1)
    expect(cs[2][0]).toBe(5)
}

test fn chunks_exact_oversized_and_nonpositive() {
    expect([1, 2, 3, 4].chunks(2).len()).toBe(2)
    let big = [1, 2, 3].chunks(9)
    expect(big.len()).toBe(1)
    expect(big[0].len()).toBe(3)
    expect([1, 2, 3].chunks(0).isEmpty()).toBe(true)
    expect([1, 2, 3].chunks(0 - 2).isEmpty()).toBe(true)
}

test fn chunks_of_empty_is_empty() {
    var xs = [0]
    xs.clear()
    expect(xs.chunks(2).isEmpty()).toBe(true)
}

test fn chunks_reads_through_an_immutable_borrow() {
    let xs = [1, 2, 3]
    expect(borrowed_chunks(xs, 2).len()).toBe(2)
}

test fn windows_slides_over_the_list() {
    let xs = [1, 2, 3, 4]
    let ws = xs.windows(2)
    expect(ws.len()).toBe(3)
    expect(ws[0][0]).toBe(1)
    expect(ws[0][1]).toBe(2)
    expect(ws[1][0]).toBe(2)
    expect(ws[1][1]).toBe(3)
    expect(ws[2][0]).toBe(3)
    expect(ws[2][1]).toBe(4)
}

test fn windows_of_whole_and_oversized() {
    let xs = [1, 2, 3]
    expect(xs.windows(3).len()).toBe(1)
    expect(xs.windows(4).isEmpty()).toBe(true)
    expect(xs.windows(0).isEmpty()).toBe(true)
}

test fn windows_of_empty_is_empty() {
    var xs = [0]
    xs.clear()
    expect(xs.windows(1).isEmpty()).toBe(true)
}

test fn windows_reads_through_an_immutable_borrow() {
    let xs = [1, 2, 3]
    expect(borrowed_windows(xs, 2).len()).toBe(2)
}
