// `List.fold(init, f)`: left fold. The accumulator type comes from `init`, so
// it may differ from the element type.

fn add(a: int, b: int) -> int {
    a + b
}

fn borrowed_fold(xs: &List<int>) -> int {
    xs.fold(0, (acc: int, v: int) => acc + v)
}

test fn fold_sums_with_the_initial_value() {
    let xs = [1, 2, 3, 4]
    expect(xs.fold(0, (acc: int, v: int) => acc + v)).toBe(10)
    expect(xs.fold(10, (acc: int, v: int) => acc + v)).toBe(20)
}

test fn fold_accepts_a_named_function() {
    let xs = [1, 2, 3]
    expect(xs.fold(0, add)).toBe(6)
}

test fn fold_of_empty_returns_the_initial_value() {
    var xs = [0]
    xs.clear()
    expect(xs.fold(42, (acc: int, v: int) => acc + v)).toBe(42)
}

test fn fold_can_change_the_accumulator_type() {
    let xs = [1, 2, 3]
    let joined = xs.fold("", (acc: string, v: int) => acc + str(v))
    expect(joined).toBe("123")
}

test fn fold_builds_a_list_accumulator() {
    let xs = [1, 2, 3]
    let doubled = xs.fold([9], (acc: List<int>, v: int) => {
        acc.push(v * 2)
        acc
    })
    expect(doubled.len()).toBe(4)
    expect(doubled[0]).toBe(9)
    expect(doubled[3]).toBe(6)
}

test fn fold_reads_through_an_immutable_borrow() {
    let xs = [1, 2, 3]
    expect(borrowed_fold(xs)).toBe(6)
}

test fn fold_threads_the_accumulator_left_to_right() {
    let xs = [1, 2, 3]
    // 10 - 1 - 2 - 3 = 4, not 10 - (1 - (2 - 3)).
    expect(xs.fold(10, (acc: int, v: int) => acc - v)).toBe(4)
}

test fn fold_works_on_strings() {
    let words = ["a", "b", "c"]
    expect(words.fold("", (acc: string, w: string) => acc + w)).toBe("abc")
}
