// Spread arguments into constructors. A class with an implicit constructor
// synthesizes its parameters from its uninitialised fields, so `...xs` must
// feed those parameters in field order - the trampoline needs the same count
// and element representations the synthesized constructor has.

class Point2 {
    var x: int
    var y: int
}

class Named {
    var name: string
}

class Flag {
    var on: bool
}

class Ratio {
    var r: float
}

class Explicit {
    var total: int

    constructor(a: int, b: int) {
        this.total = a + b
    }
}

class Box<T> {
    var value: T
}

class Pair<A, B> {
    var first: A
    var second: B
}

fn sum3(a: int, b: int, c: int) -> int {
    a + b + c
}

fn apply3(f: (int, int, int) -> int, xs: List<int>) -> int {
    f(...xs)
}

fn apply3b(f: (int, int, int) -> int, a: int, xs: List<int>) -> int {
    f(a, ...xs)
}

test fn plain_ctor_implicit_spread() {
    var xs = [3, 4]
    var p = Point2(...xs)
    expect(p.x).toBe(3)
    expect(p.y).toBe(4)
}

test fn plain_ctor_leading_arg_then_spread() {
    var p = Point2(5, ...[6])
    expect(p.x).toBe(5)
    expect(p.y).toBe(6)
}

test fn plain_ctor_scalar_element_representations() {
    expect(Named(...["tag"]).name).toBe("tag")
    expect(Flag(...[true]).on).toBe(true)
    expect(Ratio(...[1.5]).r).toBe(1.5)
}

test fn plain_ctor_explicit_spread() {
    var xs = [4, 5]
    expect(Explicit(...xs).total).toBe(9)
}

test fn generic_ctor_implicit_spread() {
    var xs = [7]
    var b = Box<int>(...xs)
    expect(b.value).toBe(7)
}

test fn generic_ctor_two_params_spread() {
    var p = Pair<int, int>(...[7, 8])
    expect(p.first).toBe(7)
    expect(p.second).toBe(8)
}

test fn generic_ctor_leading_arg_then_spread() {
    var p = Pair<int, string>(7, ...["seven"])
    expect(p.first).toBe(7)
    expect(p.second).toBe("seven")
}

test fn plain_fn_spread_still_works() {
    expect(sum3(...[1, 2, 3])).toBe(6)
}

test fn fn_value_spread() {
    expect(apply3(sum3, [1, 2, 3])).toBe(6)
}

test fn fn_value_leading_arg_then_spread() {
    expect(apply3b(sum3, 1, [2, 3])).toBe(6)
}

test fn lambda_value_spread() {
    var add = fn(a: int, b: int) -> int { a + b }
    var xs = [2, 3]
    expect(add(...xs)).toBe(5)
}
