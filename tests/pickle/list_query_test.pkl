fn is_even(v: int) -> bool {
    v % 2 == 0
}

fn borrowed_any(xs: &List<int>) -> bool {
    xs.any((v: int) => v > 2)
}

fn borrowed_all(xs: &List<int>) -> bool {
    xs.all((v: int) => v > 0)
}

fn borrowed_find(xs: &List<int>) -> int? {
    xs.find((v: int) => v > 2)
}

fn borrowed_count(xs: &List<int>) -> int {
    xs.count((v: int) => v > 1)
}

test fn any_true_when_a_match_exists() {
    let xs = [1, 2, 3]
    expect(xs.any(is_even)).toBe(true)
    expect(xs.any((v: int) => v > 2)).toBe(true)
}

test fn any_is_false_when_nothing_matches() {
    let xs = [1, 3, 5]
    expect(xs.any(is_even)).toBe(false)
    expect(xs.any((v: int) => v > 9)).toBe(false)
}

test fn any_of_an_empty_list_is_false() {
    var xs = [0]
    xs.clear()
    expect(xs.any((v: int) => true)).toBe(false)
}

test fn all_true_when_every_element_matches() {
    let xs = [2, 4, 6]
    expect(xs.all(is_even)).toBe(true)
}

test fn all_is_false_when_any_element_fails() {
    let xs = [2, 3, 4]
    expect(xs.all(is_even)).toBe(false)
    expect(xs.all((v: int) => v > 9)).toBe(false)
}

test fn all_of_an_empty_list_is_true() {
    var xs = [0]
    xs.clear()
    expect(xs.all((v: int) => false)).toBe(true)
}

test fn find_returns_the_first_match() {
    let xs = [1, 2, 3, 4]
    let f = xs.find(is_even)
    expect(f.isSome()).toBe(true)
    expect(f.unwrap()).toBe(2)
}

test fn find_returns_none_when_nothing_matches() {
    let xs = [1, 3, 5]
    expect(xs.find(is_even).isNone()).toBe(true)
}

test fn find_of_an_empty_list_is_none() {
    var xs = [0]
    xs.clear()
    expect(xs.find((v: int) => true).isNone()).toBe(true)
}

test fn find_preserves_string_elements() {
    let xs = ["a", "bb", "ccc"]
    let f = xs.find((s: string) => s.len() > 1)
    expect(f.isSome()).toBe(true)
    expect(f.unwrap()).toBe("bb")
}

test fn find_preserves_float_elements() {
    let xs = [1.5, 2.5]
    let f = xs.find((v: float) => v > 2.0)
    expect(f.isSome()).toBe(true)
    expect(f.unwrap()).toBe(2.5)
}

test fn count_counts_matches() {
    let xs = [1, 2, 3, 4, 5, 6]
    expect(xs.count(is_even)).toBe(3)
    expect(xs.count((v: int) => v > 4)).toBe(2)
    expect(xs.count((v: int) => v > 9)).toBe(0)
}

test fn count_of_an_empty_list_is_zero() {
    var xs = [0]
    xs.clear()
    expect(xs.count((v: int) => true)).toBe(0)
}

test fn queries_read_through_an_immutable_borrow() {
    let xs = [1, 2, 3]
    expect(borrowed_any(xs)).toBe(true)
    expect(borrowed_all(xs)).toBe(true)
    expect(borrowed_find(xs).unwrap()).toBe(3)
    expect(borrowed_count(xs)).toBe(2)
}

test fn queries_leave_the_receiver_unchanged() {
    let xs = [1, 2, 3]
    let a = xs.any(is_even)
    let b = xs.all(is_even)
    let c = xs.find(is_even)
    let d = xs.count(is_even)
    expect(a).toBe(true)
    expect(b).toBe(false)
    expect(c.unwrap()).toBe(2)
    expect(d).toBe(1)
    expect(xs.len()).toBe(3)
    expect(xs[0]).toBe(1)
    expect(xs[2]).toBe(3)
}

test fn queries_chain_with_other_members() {
    let xs = [1, 2, 3, 4, 5, 6]
    expect(xs.filter(is_even).count((v: int) => v > 2)).toBe(2)
    expect(xs.map((v: int) => v * 2).find((v: int) => v > 8).unwrap()).toBe(10)
}
