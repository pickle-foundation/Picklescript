// `List.lastIndexOf`, `List.sum`, `List.min`, and `List.max`: beyond-parity
// aggregates. `sum` returns the element type; `min`/`max` return `T?` and are
// `none` on an empty list. All read through `&List` without touching it.

fn borrowed_last_index_of(xs: &List<int>) -> int? {
    xs.lastIndexOf(3)
}

fn borrowed_sum(xs: &List<int>) -> int {
    xs.sum()
}

fn borrowed_min(xs: &List<int>) -> int? {
    xs.min()
}

fn borrowed_max(xs: &List<int>) -> int? {
    xs.max()
}

test fn last_index_of_reports_the_final_match() {
    let xs = [1, 3, 2, 3, 4]
    expect(xs.lastIndexOf(3).unwrap()).toBe(3)
    expect(xs.lastIndexOf(1).unwrap()).toBe(0)
    expect(xs.lastIndexOf(4).unwrap()).toBe(4)
}

test fn last_index_of_is_none_when_absent_or_empty() {
    let xs = [1, 2, 3]
    expect(xs.lastIndexOf(9).isNone()).toBe(true)
    var empty = [0]
    empty.clear()
    expect(empty.lastIndexOf(0).isNone()).toBe(true)
}

test fn last_index_of_reads_through_an_immutable_borrow() {
    let xs = [3, 1, 3]
    expect(borrowed_last_index_of(xs).unwrap()).toBe(2)
}

test fn sum_adds_every_element() {
    let xs = [1, 2, 3, 4]
    expect(xs.sum()).toBe(10)
    expect([0 - 5, 2, 0 - 1].sum()).toBe(0 - 4)
}

test fn sum_of_an_empty_list_is_zero() {
    var xs = [0]
    xs.clear()
    expect(xs.sum()).toBe(0)
    var fs = [0.5]
    fs.clear()
    expect(fs.sum()).toBe(0.0)
}

test fn sum_supports_floats_bytes_and_chars() {
    expect([1.5, 2.25, 0.0 - 0.75].sum()).toBe(3.0)
    let bs: List<byte> = [1 as byte, 2 as byte, 3 as byte]
    expect(bs.sum() as int).toBe(6)
    let cs: List<char> = ['a', 'b']
    expect(cs.sum() as int).toBe(195)
}

test fn sum_reads_through_an_immutable_borrow() {
    let xs = [4, 5, 6]
    expect(borrowed_sum(xs)).toBe(15)
}

test fn min_and_max_pick_the_extremes() {
    let xs = [4, 0 - 2, 9, 1]
    expect(xs.min().unwrap()).toBe(0 - 2)
    expect(xs.max().unwrap()).toBe(9)
}

test fn min_and_max_are_none_on_an_empty_list() {
    var xs = [0]
    xs.clear()
    expect(xs.min().isNone()).toBe(true)
    expect(xs.max().isNone()).toBe(true)
}

test fn min_and_max_order_floats_and_strings() {
    expect([1.5, 0.0 - 2.5, 3.0].min().unwrap()).toBe(0.0 - 2.5)
    expect([1.5, 0.0 - 2.5, 3.0].max().unwrap()).toBe(3.0)
    expect(["pear", "apple", "zebra"].min().unwrap()).toBe("apple")
    expect(["pear", "apple", "zebra"].max().unwrap()).toBe("zebra")
}

test fn min_and_max_read_through_an_immutable_borrow() {
    let xs = [7, 3, 5]
    expect(borrowed_min(xs).unwrap()).toBe(3)
    expect(borrowed_max(xs).unwrap()).toBe(7)
}
