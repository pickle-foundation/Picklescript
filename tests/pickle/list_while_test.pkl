// `List.takeWhile(f)` / `List.skipWhile(f)`: beyond-parity producers of fresh
// leading/trailing slices. Both read through `&List` and leave the receiver
// untouched.

fn is_small(v: int) -> bool {
    v < 3
}

fn borrowed_take_while(xs: &List<int>) -> List<int> {
    xs.takeWhile((v: int) => v < 3)
}

fn borrowed_skip_while(xs: &List<int>) -> List<int> {
    xs.skipWhile((v: int) => v < 3)
}

test fn take_while_keeps_the_leading_run() {
    let xs = [1, 2, 3, 1]
    let ys = xs.takeWhile((v: int) => v < 3)
    expect(ys.len()).toBe(2)
    expect(ys[0]).toBe(1)
    expect(ys[1]).toBe(2)
    expect(xs.len()).toBe(4)
}

test fn take_while_accepts_a_named_function() {
    let xs = [1, 2, 5]
    expect(xs.takeWhile(is_small).len()).toBe(2)
}

test fn take_while_of_empty_and_first_false() {
    var xs = [0]
    xs.clear()
    expect(xs.takeWhile((v: int) => v < 3).isEmpty()).toBe(true)
    let ys = [9, 1]
    expect(ys.takeWhile((v: int) => v < 3).isEmpty()).toBe(true)
}

test fn take_while_of_all_true_is_the_whole_list() {
    let xs = [1, 2]
    expect(xs.takeWhile((v: int) => v < 3).len()).toBe(2)
}

test fn skip_while_drops_the_leading_run() {
    let xs = [1, 2, 3, 1]
    let ys = xs.skipWhile((v: int) => v < 3)
    expect(ys.len()).toBe(2)
    expect(ys[0]).toBe(3)
    expect(ys[1]).toBe(1)
}

test fn skip_while_of_empty_and_all_true() {
    var xs = [0]
    xs.clear()
    expect(xs.skipWhile((v: int) => v < 3).isEmpty()).toBe(true)
    let ys = [1, 2]
    expect(ys.skipWhile((v: int) => v < 3).isEmpty()).toBe(true)
}

test fn skip_while_keeps_everything_when_the_first_fails() {
    let xs = [9, 1]
    let ys = xs.skipWhile((v: int) => v < 3)
    expect(ys.len()).toBe(2)
    expect(ys[0]).toBe(9)
}

test fn while_members_work_on_strings_and_borrows() {
    let words = ["a", "ab", "abc"]
    expect(words.takeWhile((w: string) => w.len() < 3).len()).toBe(2)
    let xs = [1, 2, 3]
    expect(borrowed_take_while(xs).len()).toBe(2)
    expect(borrowed_skip_while(xs).len()).toBe(1)
}
