test fn merge_adds_missing_keys() {
    var a = {"a": 1}
    let b = {"b": 2, "c": 3}
    a.merge(b)
    expect(a.len()).toBe(3)
    expect(a["a"]).toBe(1)
    expect(a["b"]).toBe(2)
    expect(a["c"]).toBe(3)
    // The argument is untouched.
    expect(b.len()).toBe(2)
    expect(b.has("a")).toBe(false)
}

test fn merge_lets_the_argument_win_collisions() {
    var a = {"k": 1, "x": 2}
    let b = {"k": 10}
    a.merge(b)
    expect(a.len()).toBe(2)
    expect(a["k"]).toBe(10)
    expect(a["x"]).toBe(2)
}

test fn merge_is_idempotent() {
    var a = {"a": 1}
    let b = {"a": 2, "b": 3}
    a.merge(b)
    a.merge(b)
    expect(a.len()).toBe(2)
    expect(a["a"]).toBe(2)
    expect(a["b"]).toBe(3)
}

test fn merge_into_itself_keeps_every_entry() {
    var a = {"a": 1, "b": 2}
    a.merge(a)
    expect(a.len()).toBe(2)
    expect(a["a"]).toBe(1)
    expect(a["b"]).toBe(2)
}

test fn merge_works_for_string_and_float_values() {
    var s = {"x": "one"}
    let t = {"y": "two"}
    s.merge(t)
    expect(s["x"]).toBe("one")
    expect(s["y"]).toBe("two")
    expect(t.len()).toBe(1)

    var f = {"p": 1.5}
    let g = {"q": 2.5}
    f.merge(g)
    expect(f["p"]).toBe(1.5)
    expect(f["q"]).toBe(2.5)
}

test fn merge_works_for_composite_values() {
    var a = {"xs": [1, 2]}
    let b = {"ys": [3, 4]}
    a.merge(b)
    expect(a.len()).toBe(2)
    expect(a["xs"][0]).toBe(1)
    expect(a["ys"][1]).toBe(4)
}

test fn merge_survives_growth_of_the_receiver() {
    // A one-entry destination plus a many-entry argument forces the receiver to
    // rehash while the merge is walking the argument's table.
    var a = {"keep": 0}
    var b = {"k0": 0, "k1": 1, "k2": 2, "k3": 3, "k4": 4, "k5": 5, "k6": 6, "k7": 7, "k8": 8, "k9": 9, "k10": 10, "k11": 11, "k12": 12, "k13": 13, "k14": 14, "k15": 15, "k16": 16, "k17": 17, "k18": 18, "k19": 19}
    a.merge(b)
    expect(a.len()).toBe(21)
    expect(a["keep"]).toBe(0)
    expect(a["k0"]).toBe(0)
    expect(a["k19"]).toBe(19)
    expect(b.len()).toBe(20)
}
