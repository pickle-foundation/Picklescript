fn borrowed_enumerate(xs: &List<int>) -> List<(int, int)> {
    xs.enumerate()
}

fn borrowed_zip(a: &List<int>, b: &List<int>) -> List<(int, int)> {
    a.zip(b)
}

test fn enumerate_pairs_elements_with_their_index() {
    let xs = [10, 20, 30]
    let ys = xs.enumerate()
    expect(ys.len()).toBe(3)
    expect(ys[0][0]).toBe(0)
    expect(ys[0][1]).toBe(10)
    expect(ys[1][0]).toBe(1)
    expect(ys[1][1]).toBe(20)
    expect(ys[2][0]).toBe(2)
    expect(ys[2][1]).toBe(30)
}

test fn enumerate_of_an_empty_list_is_empty() {
    var xs = [0]
    xs.clear()
    expect(xs.enumerate().isEmpty()).toBe(true)
}

test fn enumerate_preserves_string_elements() {
    let xs = ["a", "bb"]
    let ys = xs.enumerate()
    expect(ys[0][1]).toBe("a")
    expect(ys[1][0]).toBe(1)
    expect(ys[1][1]).toBe("bb")
}

test fn enumerate_returns_a_fresh_list() {
    let xs = [1, 2]
    let ys = xs.enumerate()
    ys.push((9, 9))
    expect(ys.len()).toBe(3)
    expect(xs.len()).toBe(2)
    expect(xs[0]).toBe(1)
}

test fn enumerate_reads_through_an_immutable_borrow() {
    let xs = [7, 8]
    let ys = borrowed_enumerate(xs)
    expect(ys.len()).toBe(2)
    expect(ys[1][0]).toBe(1)
    expect(ys[1][1]).toBe(8)
}

test fn zip_pairs_elements_by_index() {
    let a = [1, 2, 3]
    let b = [4, 5, 6]
    let zs = a.zip(b)
    expect(zs.len()).toBe(3)
    expect(zs[0][0]).toBe(1)
    expect(zs[0][1]).toBe(4)
    expect(zs[2][0]).toBe(3)
    expect(zs[2][1]).toBe(6)
}

test fn zip_stops_at_the_shorter_list() {
    let a = [1, 2, 3, 4]
    let b = [5, 6]
    let zs = a.zip(b)
    expect(zs.len()).toBe(2)
    expect(zs[1][0]).toBe(2)
    expect(zs[1][1]).toBe(6)
}

test fn zip_of_an_empty_list_is_empty() {
    var a = [0]
    a.clear()
    let b = [1, 2]
    expect(a.zip(b).isEmpty()).toBe(true)
    expect(b.zip(a).isEmpty()).toBe(true)
}

test fn zip_preserves_string_elements() {
    let a = ["a", "b"]
    let b = ["x", "y"]
    let zs = a.zip(b)
    expect(zs[0][0]).toBe("a")
    expect(zs[0][1]).toBe("x")
    expect(zs[1][1]).toBe("y")
}

test fn zip_returns_a_fresh_list() {
    let a = [1, 2]
    let b = [3, 4]
    let zs = a.zip(b)
    zs.push((9, 9))
    expect(zs.len()).toBe(3)
    expect(a.len()).toBe(2)
    expect(b.len()).toBe(2)
}

test fn zip_reads_through_an_immutable_borrow() {
    let a = [1, 2]
    let b = [3, 4]
    let zs = borrowed_zip(a, b)
    expect(zs.len()).toBe(2)
    expect(zs[0][1]).toBe(3)
    expect(zs[1][1]).toBe(4)
}

test fn enumerate_and_zip_compose() {
    let a = [10, 20]
    let b = [1, 2]
    let zs = a.enumerate().zip(b.enumerate())
    expect(zs.len()).toBe(2)
    expect(zs[0][0][0]).toBe(0)
    expect(zs[0][0][1]).toBe(10)
    expect(zs[1][1][0]).toBe(1)
    expect(zs[1][1][1]).toBe(2)
}
