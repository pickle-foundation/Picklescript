// Method forms of the `len(x)` builtin (`List`/`Map`/`string`) and of
// `sub in s` (`string.contains`). Rust's member table has no `string` arm and
// no `len` method, so these are beyond parity. `len` on a string is its byte
// length, exactly like `len(s)`.

fn borrowed_str_len(s: &string) -> int {
    s.len()
}

fn borrowed_str_contains(s: &string, sub: string) -> bool {
    s.contains(sub)
}

fn borrowed_list_len(xs: &List<int>) -> int {
    xs.len()
}

fn borrowed_map_len(m: &Map<string, int>) -> int {
    m.len()
}

fn borrowed_str_starts_with(s: &string, prefix: string) -> bool {
    s.startsWith(prefix)
}

fn borrowed_str_ends_with(s: &string, suffix: string) -> bool {
    s.endsWith(suffix)
}

fn borrowed_str_is_empty(s: &string) -> bool {
    s.isEmpty()
}

fn borrowed_list_is_empty(xs: &List<int>) -> bool {
    xs.isEmpty()
}

fn borrowed_map_is_empty(m: &Map<string, int>) -> bool {
    m.isEmpty()
}

test fn string_len_is_byte_length() {
    expect("".len()).toBe(0)
    expect("abc".len()).toBe(3)
    expect(("ab" + "c").len()).toBe(3)
    // 'é' is two UTF-8 bytes, so this agrees with `len(s)`.
    expect("é".len()).toBe(2)
    expect(len("é")).toBe(2)
}

test fn string_contains_matches_in_operator() {
    expect("abcdef".contains("cd")).toBe(true)
    expect("cd" in "abcdef").toBe(true)
    expect("abcdef".contains("xy")).toBe(false)
    expect("xy" in "abcdef").toBe(false)
}

test fn string_contains_edges() {
    expect("abc".contains("")).toBe(true)
    expect("".contains("")).toBe(true)
    expect("".contains("a")).toBe(false)
    expect("abc".contains("abc")).toBe(true)
    expect("abc".contains("abcd")).toBe(false)
    expect("abc".contains("a")).toBe(true)
    expect("abc".contains("c")).toBe(true)
}

test fn string_methods_with_variables() {
    let hay = "hello world"
    let needle = "lo wo"
    expect(hay.contains(needle)).toBe(true)
    expect(hay.contains("wor" + "ld")).toBe(true)
    expect(hay.contains("hello!")).toBe(false)
}

test fn string_methods_in_conditions() {
    let s = "pickle"
    if (s.contains("ick")) {
        expect(s.len()).toBe(6)
    } else {
        expect(false).toBe(true)
    }
}

test fn string_methods_through_an_immutable_borrow() {
    expect(borrowed_str_len("abcd")).toBe(4)
    expect(borrowed_str_contains("abcd", "bc")).toBe(true)
    expect(borrowed_str_contains("abcd", "xy")).toBe(false)
}

test fn list_len_method() {
    var xs = [1, 2, 3]
    expect(xs.len()).toBe(3)
    expect(xs.len()).toBe(len(xs))
    xs.push(4)
    expect(xs.len()).toBe(4)
    xs.pop()
    expect(xs.len()).toBe(3)
    expect(borrowed_list_len(xs)).toBe(3)
}

test fn map_len_method() {
    var m = {"a": 1, "b": 2}
    expect(m.len()).toBe(2)
    expect(m.len()).toBe(len(m))
    m["c"] = 3
    expect(m.len()).toBe(3)
    m.remove("a")
    expect(m.len()).toBe(2)
    expect(borrowed_map_len(m)).toBe(2)
}

test fn len_methods_agree_with_the_builtin() {
    let xs = ["a", "b"]
    let m = {1: "x"}
    expect(xs.len() + m.len()).toBe(3)
    expect("xy".len() + xs.len()).toBe(4)
}

test fn string_starts_with_and_ends_with() {
    expect("abcdef".startsWith("abc")).toBe(true)
    expect("abcdef".startsWith("ab")).toBe(true)
    expect("abcdef".startsWith("bc")).toBe(false)
    expect("abcdef".startsWith("abcdef")).toBe(true)
    expect("abcdef".endsWith("def")).toBe(true)
    expect("abcdef".endsWith("ef")).toBe(true)
    expect("abcdef".endsWith("de")).toBe(false)
    expect("abcdef".endsWith("abcdef")).toBe(true)
}

test fn string_prefix_suffix_edges() {
    expect("abc".startsWith("")).toBe(true)
    expect("".startsWith("")).toBe(true)
    expect("".startsWith("a")).toBe(false)
    expect("abc".startsWith("abcd")).toBe(false)
    expect("abc".endsWith("")).toBe(true)
    expect("".endsWith("")).toBe(true)
    expect("".endsWith("a")).toBe(false)
    expect("abc".endsWith("zabc")).toBe(false)
}

test fn string_prefix_suffix_are_byte_exact() {
    // 'é' is C3 A9, so a prefix that splits the pair is a different byte run.
    expect("é".startsWith("é")).toBe(true)
    expect("é".endsWith("é")).toBe(true)
    expect("aé".startsWith("a")).toBe(true)
    expect("aé".endsWith("é")).toBe(true)
}

test fn string_prefix_suffix_with_variables_and_borrows() {
    let s = "pickle"
    let pre = "pic"
    let suf = "kle"
    expect(s.startsWith(pre)).toBe(true)
    expect(s.endsWith(suf)).toBe(true)
    expect(s.startsWith(suf)).toBe(false)
    expect(borrowed_str_starts_with(s, pre)).toBe(true)
    expect(borrowed_str_ends_with(s, suf)).toBe(true)
}

test fn string_is_empty() {
    expect("".isEmpty()).toBe(true)
    expect("a".isEmpty()).toBe(false)
    expect(("a" + "").isEmpty()).toBe(false)
    expect(("" + "").isEmpty()).toBe(true)
    expect(borrowed_str_is_empty("")).toBe(true)
    expect(borrowed_str_is_empty("x")).toBe(false)
}

test fn list_is_empty() {
    var xs = [1, 2]
    expect(xs.isEmpty()).toBe(false)
    xs.pop()
    xs.pop()
    expect(xs.isEmpty()).toBe(true)
    expect(xs.len()).toBe(0)
    expect(borrowed_list_is_empty(xs)).toBe(true)
    xs.push(3)
    expect(borrowed_list_is_empty(xs)).toBe(false)
}

test fn map_is_empty() {
    var m = {"a": 1}
    expect(m.isEmpty()).toBe(false)
    m.remove("a")
    expect(m.isEmpty()).toBe(true)
    expect(m.len()).toBe(0)
    expect(borrowed_map_is_empty(m)).toBe(true)
    m["b"] = 2
    expect(borrowed_map_is_empty(m)).toBe(false)
}

test fn is_empty_agrees_with_len() {
    let xs = ["a"]
    let m = {1: "x"}
    expect(xs.isEmpty()).toBe(xs.len() == 0)
    expect(m.isEmpty()).toBe(m.len() == 0)
    expect("".isEmpty()).toBe("".len() == 0)
    expect("a".isEmpty()).toBe("a".len() == 0)
}
