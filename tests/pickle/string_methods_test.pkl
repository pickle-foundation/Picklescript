// Method forms of the `len(x)` builtin (`List`/`Map`/`string`) and of
// `sub in s` (`string.contains`). Rust's member table has no `string` arm and
// no `len` method, so these are beyond parity. `len` on a string is its byte
// length, exactly like `len(s)`.

fn borrowed_str_len(s: &string) -> int {
    s.len()
}

fn borrowed_str_contains(s: &string, sub: string) -> bool {
    s.contains(sub)
}

fn borrowed_list_len(xs: &List<int>) -> int {
    xs.len()
}

fn borrowed_map_len(m: &Map<string, int>) -> int {
    m.len()
}

fn borrowed_str_starts_with(s: &string, prefix: string) -> bool {
    s.startsWith(prefix)
}

fn borrowed_str_ends_with(s: &string, suffix: string) -> bool {
    s.endsWith(suffix)
}

fn borrowed_str_is_empty(s: &string) -> bool {
    s.isEmpty()
}

fn borrowed_list_is_empty(xs: &List<int>) -> bool {
    xs.isEmpty()
}

fn borrowed_map_is_empty(m: &Map<string, int>) -> bool {
    m.isEmpty()
}

test fn string_len_is_byte_length() {
    expect("".len()).toBe(0)
    expect("abc".len()).toBe(3)
    expect(("ab" + "c").len()).toBe(3)
    // 'é' is two UTF-8 bytes, so this agrees with `len(s)`.
    expect("é".len()).toBe(2)
    expect(len("é")).toBe(2)
}

test fn string_contains_matches_in_operator() {
    expect("abcdef".contains("cd")).toBe(true)
    expect("cd" in "abcdef").toBe(true)
    expect("abcdef".contains("xy")).toBe(false)
    expect("xy" in "abcdef").toBe(false)
}

test fn string_contains_edges() {
    expect("abc".contains("")).toBe(true)
    expect("".contains("")).toBe(true)
    expect("".contains("a")).toBe(false)
    expect("abc".contains("abc")).toBe(true)
    expect("abc".contains("abcd")).toBe(false)
    expect("abc".contains("a")).toBe(true)
    expect("abc".contains("c")).toBe(true)
}

test fn string_methods_with_variables() {
    let hay = "hello world"
    let needle = "lo wo"
    expect(hay.contains(needle)).toBe(true)
    expect(hay.contains("wor" + "ld")).toBe(true)
    expect(hay.contains("hello!")).toBe(false)
}

test fn string_methods_in_conditions() {
    let s = "pickle"
    if (s.contains("ick")) {
        expect(s.len()).toBe(6)
    } else {
        expect(false).toBe(true)
    }
}

test fn string_methods_through_an_immutable_borrow() {
    expect(borrowed_str_len("abcd")).toBe(4)
    expect(borrowed_str_contains("abcd", "bc")).toBe(true)
    expect(borrowed_str_contains("abcd", "xy")).toBe(false)
}

test fn list_len_method() {
    var xs = [1, 2, 3]
    expect(xs.len()).toBe(3)
    expect(xs.len()).toBe(len(xs))
    xs.push(4)
    expect(xs.len()).toBe(4)
    xs.pop()
    expect(xs.len()).toBe(3)
    expect(borrowed_list_len(xs)).toBe(3)
}

test fn map_len_method() {
    var m = {"a": 1, "b": 2}
    expect(m.len()).toBe(2)
    expect(m.len()).toBe(len(m))
    m["c"] = 3
    expect(m.len()).toBe(3)
    m.remove("a")
    expect(m.len()).toBe(2)
    expect(borrowed_map_len(m)).toBe(2)
}

test fn len_methods_agree_with_the_builtin() {
    let xs = ["a", "b"]
    let m = {1: "x"}
    expect(xs.len() + m.len()).toBe(3)
    expect("xy".len() + xs.len()).toBe(4)
}

test fn string_starts_with_and_ends_with() {
    expect("abcdef".startsWith("abc")).toBe(true)
    expect("abcdef".startsWith("ab")).toBe(true)
    expect("abcdef".startsWith("bc")).toBe(false)
    expect("abcdef".startsWith("abcdef")).toBe(true)
    expect("abcdef".endsWith("def")).toBe(true)
    expect("abcdef".endsWith("ef")).toBe(true)
    expect("abcdef".endsWith("de")).toBe(false)
    expect("abcdef".endsWith("abcdef")).toBe(true)
}

test fn string_prefix_suffix_edges() {
    expect("abc".startsWith("")).toBe(true)
    expect("".startsWith("")).toBe(true)
    expect("".startsWith("a")).toBe(false)
    expect("abc".startsWith("abcd")).toBe(false)
    expect("abc".endsWith("")).toBe(true)
    expect("".endsWith("")).toBe(true)
    expect("".endsWith("a")).toBe(false)
    expect("abc".endsWith("zabc")).toBe(false)
}

test fn string_prefix_suffix_are_byte_exact() {
    // 'é' is C3 A9, so a prefix that splits the pair is a different byte run.
    expect("é".startsWith("é")).toBe(true)
    expect("é".endsWith("é")).toBe(true)
    expect("aé".startsWith("a")).toBe(true)
    expect("aé".endsWith("é")).toBe(true)
}

test fn string_prefix_suffix_with_variables_and_borrows() {
    let s = "pickle"
    let pre = "pic"
    let suf = "kle"
    expect(s.startsWith(pre)).toBe(true)
    expect(s.endsWith(suf)).toBe(true)
    expect(s.startsWith(suf)).toBe(false)
    expect(borrowed_str_starts_with(s, pre)).toBe(true)
    expect(borrowed_str_ends_with(s, suf)).toBe(true)
}

test fn string_is_empty() {
    expect("".isEmpty()).toBe(true)
    expect("a".isEmpty()).toBe(false)
    expect(("a" + "").isEmpty()).toBe(false)
    expect(("" + "").isEmpty()).toBe(true)
    expect(borrowed_str_is_empty("")).toBe(true)
    expect(borrowed_str_is_empty("x")).toBe(false)
}

test fn list_is_empty() {
    var xs = [1, 2]
    expect(xs.isEmpty()).toBe(false)
    xs.pop()
    xs.pop()
    expect(xs.isEmpty()).toBe(true)
    expect(xs.len()).toBe(0)
    expect(borrowed_list_is_empty(xs)).toBe(true)
    xs.push(3)
    expect(borrowed_list_is_empty(xs)).toBe(false)
}

test fn map_is_empty() {
    var m = {"a": 1}
    expect(m.isEmpty()).toBe(false)
    m.remove("a")
    expect(m.isEmpty()).toBe(true)
    expect(m.len()).toBe(0)
    expect(borrowed_map_is_empty(m)).toBe(true)
    m["b"] = 2
    expect(borrowed_map_is_empty(m)).toBe(false)
}

test fn is_empty_agrees_with_len() {
    let xs = ["a"]
    let m = {1: "x"}
    expect(xs.isEmpty()).toBe(xs.len() == 0)
    expect(m.isEmpty()).toBe(m.len() == 0)
    expect("".isEmpty()).toBe("".len() == 0)
    expect("a".isEmpty()).toBe("a".len() == 0)
}

fn borrowed_index_of(s: &string, needle: string) -> int {
    s.indexOf(needle) ?? -1
}

test fn string_index_of_returns_first_byte_offset() {
    expect("hello".indexOf("h") ?? -1).toBe(0)
    expect("hello".indexOf("ll") ?? -1).toBe(2)
    expect("hello".indexOf("o") ?? -1).toBe(4)
    expect("banana".indexOf("an") ?? -1).toBe(1)
    expect("banana".indexOf("na") ?? -1).toBe(2)
}

test fn string_index_of_absent_is_none() {
    expect("hello".indexOf("z") ?? -1).toBe(-1)
    expect("hello".indexOf("hello!") ?? -1).toBe(-1)
    expect("".indexOf("a") ?? -1).toBe(-1)
}

test fn string_index_of_empty_needle_is_zero() {
    expect("hello".indexOf("") ?? -1).toBe(0)
    expect("".indexOf("") ?? -1).toBe(0)
}

test fn string_index_of_with_variables_and_borrows() {
    let hay = "banana"
    let needle = "na"
    expect(hay.indexOf(needle) ?? -1).toBe(2)
    expect(borrowed_index_of(hay, "an")).toBe(1)
    expect(borrowed_index_of(hay, "zz")).toBe(-1)
}

test fn string_index_of_reports_byte_offsets() {
    // 'é' is C3 A9; the offset is the byte offset, not the scalar index.
    expect("aé".indexOf("é") ?? -1).toBe(1)
    expect("éa".indexOf("a") ?? -1).toBe(2)
}

fn borrowed_trim(s: &string) -> string {
    s.trim()
}

test fn string_trim_strips_ascii_whitespace() {
    expect("  hi  ".trim()).toBe("hi")
    expect(" hi ".trim()).toBe("hi")
    expect("\thi\n".trim()).toBe("hi")
    expect("hi\r\n".trim()).toBe("hi")
}

test fn string_trim_keeps_interior_whitespace() {
    expect(" a b ".trim()).toBe("a b")
    expect("a  b".trim()).toBe("a  b")
}

test fn string_trim_of_blank_and_empty_is_empty() {
    expect("   ".trim()).toBe("")
    expect("\t\n\r ".trim()).toBe("")
    expect("".trim()).toBe("")
}

test fn string_trim_without_whitespace_is_unchanged() {
    let s = "hello"
    expect(s.trim()).toBe("hello")
}

test fn string_trim_with_variables_and_borrows() {
    let s = "  padded  "
    expect(s.trim()).toBe("padded")
    expect(borrowed_trim(s)).toBe("padded")
}

fn borrowed_to_upper(s: &string) -> string {
    s.toUpper()
}

fn borrowed_substring(s: &string, start: int, end: int) -> string {
    s.substring(start, end)
}

test fn string_to_upper_maps_ascii_letters() {
    expect("hello".toUpper()).toBe("HELLO")
    expect("Hello, World!".toUpper()).toBe("HELLO, WORLD!")
    expect("abc123".toUpper()).toBe("ABC123")
}

test fn string_to_lower_maps_ascii_letters() {
    expect("HELLO".toLower()).toBe("hello")
    expect("Hello, World!".toLower()).toBe("hello, world!")
    expect("ABC123".toLower()).toBe("abc123")
}

test fn string_case_mapping_leaves_other_bytes_alone() {
    // Digits, punctuation and spaces are untouched.
    expect("a-1 z!".toUpper()).toBe("A-1 Z!")
    expect("A-1 Z!".toLower()).toBe("a-1 z!")
    expect("".toUpper()).toBe("")
    expect("".toLower()).toBe("")
}

test fn string_case_mapping_is_idempotent() {
    expect("MiXeD".toUpper().toUpper()).toBe("MIXED")
    expect("MiXeD".toLower().toLower()).toBe("mixed")
}

test fn string_case_mapping_returns_a_fresh_string() {
    // Mapping always copies, so writing through the result cannot alias the
    // receiver.
    let s = "abc"
    let u = s.toUpper()
    u[0] = 'X'
    expect(u).toBe("XBC")
    expect(s).toBe("abc")
}

test fn string_case_mapping_through_an_immutable_borrow() {
    expect(borrowed_to_upper("pickle")).toBe("PICKLE")
}

test fn string_substring_extracts_a_span() {
    expect("hello".substring(1, 4)).toBe("ell")
    expect("hello".substring(0, 5)).toBe("hello")
    expect("hello".substring(2, 2)).toBe("")
    expect("".substring(0, 0)).toBe("")
}

test fn string_substring_clamps_bounds() {
    expect("hello".substring(-2, 2)).toBe("he")
    expect("hello".substring(3, 99)).toBe("lo")
    expect("hello".substring(4, 2)).toBe("")
    expect("hello".substring(99, 100)).toBe("")
}

test fn string_substring_with_variables() {
    let s = "abcdef"
    let start = 2
    let end = 5
    expect(s.substring(start, end)).toBe("cde")
    expect(s.substring(start + 1, end + 1)).toBe("def")
}

test fn string_substring_through_an_immutable_borrow() {
    expect(borrowed_substring("pickle", 0, 3)).toBe("pic")
    expect(borrowed_substring("pickle", 3, 6)).toBe("kle")
}

test fn string_substring_returns_a_fresh_string() {
    let s = "abc"
    let t = s.substring(0, 3)
    t[0] = 'X'
    expect(t).toBe("Xbc")
    expect(s).toBe("abc")
}

test fn string_substring_composes_with_index_of() {
    let hay = "banana"
    let i = hay.indexOf("na") ?? -1
    expect(i).toBe(2)
    expect(hay.substring(i, i + 2)).toBe("na")
}

test fn string_substring_uses_byte_offsets() {
    // 'Ac' is C3 A9; the span is measured in bytes, the same unit indexOf uses.
    expect("aAc".substring(1, 3)).toBe("Ac")
    expect("aAc".substring(1, 3).len()).toBe(2)
}

test fn string_split_returns_the_fields() {
    let parts = "a,b,c".split(",")
    expect(len(parts)).toBe(3)
    expect(parts[0]).toBe("a")
    expect(parts[1]).toBe("b")
    expect(parts[2]).toBe("c")
}

test fn string_split_keeps_empty_fields() {
    // Leading and trailing separators produce empty fields.
    let parts = ",a,,".split(",")
    expect(len(parts)).toBe(4)
    expect(parts[0]).toBe("")
    expect(parts[1]).toBe("a")
    expect(parts[2]).toBe("")
    expect(parts[3]).toBe("")
}

test fn string_split_without_a_match_is_the_whole_string() {
    let parts = "abc".split(",")
    expect(len(parts)).toBe(1)
    expect(parts[0]).toBe("abc")
}

test fn string_split_with_an_empty_separator_is_the_whole_string() {
    let parts = "abc".split("")
    expect(len(parts)).toBe(1)
    expect(parts[0]).toBe("abc")
}

test fn string_split_of_empty_is_one_empty_field() {
    let parts = "".split(",")
    expect(len(parts)).toBe(1)
    expect(parts[0]).toBe("")
}

test fn string_split_matches_do_not_overlap() {
    // "aaa" split on "aa" is ["", "a"].
    let parts = "aaa".split("aa")
    expect(len(parts)).toBe(2)
    expect(parts[0]).toBe("")
    expect(parts[1]).toBe("a")
}

test fn string_split_reads_through_an_immutable_borrow() {
    let parts = borrowed_split("x-y-z", "-")
    expect(len(parts)).toBe(3)
    expect(parts[1]).toBe("y")
}

test fn string_replace_replaces_every_occurrence() {
    expect("a-b-c".replace("-", "+")).toBe("a+b+c")
    expect("aaa".replace("a", "bb")).toBe("bbbbbb")
    expect("abc".replace("b", "")).toBe("ac")
}

test fn string_replace_without_a_match_returns_a_fresh_string() {
    let s = "abc"
    let t = s.replace("x", "y")
    expect(t).toBe("abc")
    t[0] = 'X'
    expect(t).toBe("Xbc")
    expect(s).toBe("abc")
}

test fn string_replace_with_empty_from_returns_a_fresh_string() {
    let s = "abc"
    let t = s.replace("", "X")
    expect(t).toBe("abc")
    t[0] = 'X'
    expect(s).toBe("abc")
}

test fn string_replace_reads_through_an_immutable_borrow() {
    expect(borrowed_replace("a.b.c", ".", "-")).toBe("a-b-c")
}

test fn string_chars_splits_ascii() {
    let cs = "abc".chars()
    expect(len(cs)).toBe(3)
    expect(cs[0]).toBe("a")
    expect(cs[2]).toBe("c")
}

test fn string_chars_of_empty_is_empty() {
    let cs = "".chars()
    expect(len(cs)).toBe(0)
}

test fn string_chars_keeps_multibyte_scalars_whole() {
    // "a" + e-acute: the scalar is two bytes, so it stays one element.
    let cs = "a\u{e9}".chars()
    expect(len(cs)).toBe(2)
    expect(cs[0]).toBe("a")
    expect(len(cs[1])).toBe(2)
    expect(cs[1]).toBe("\u{e9}")
}

test fn string_chars_reads_through_an_immutable_borrow() {
    let cs = borrowed_chars("\u{e9}x")
    expect(len(cs)).toBe(2)
    expect(cs[0]).toBe("\u{e9}")
}

fn borrowed_split(s: &string, sep: string) -> List<string> {
    s.split(sep)
}

fn borrowed_replace(s: &string, needle: string, repl: string) -> string {
    s.replace(needle, repl)
}

fn borrowed_chars(s: &string) -> List<string> {
    s.chars()
}
