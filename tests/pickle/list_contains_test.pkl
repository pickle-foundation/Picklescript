// `List.contains(value)` is the method form of `value in list`: it routes
// through `pickle_list_contains`, which compares each element with the same
// structural `keyEq` map keys use. Rust bails on the method, so this is
// beyond parity.

class Point {
    var x: int
    var y: int
}

fn borrowed_contains(xs: &List<int>, v: int) -> bool {
    xs.contains(v)
}

test fn finds_and_misses_ints() {
    let xs = [10, 20, 30]
    expect(xs.contains(10)).toBe(true)
    expect(xs.contains(20)).toBe(true)
    expect(xs.contains(30)).toBe(true)
    expect(xs.contains(0)).toBe(false)
    expect(xs.contains(31)).toBe(false)
}

test fn matches_the_in_operator() {
    let xs = [4, 5, 6]
    var i = 0
    while (i < len(xs)) {
        expect(xs.contains(xs[i])).toBe(true)
        expect(xs[i] in xs).toBe(true)
        i = i + 1
    }
    expect(xs.contains(7)).toBe(false)
    expect(7 in xs).toBe(false)
}

test fn strings_compare_by_value() {
    let words = ["alpha", "beta", "gamma"]
    expect(words.contains("alpha")).toBe(true)
    expect(words.contains("beta")).toBe(true)
    expect(words.contains("delta")).toBe(false)
    // A freshly built string with the same bytes still matches.
    let built = "ga" + "mma"
    expect(words.contains(built)).toBe(true)
}

test fn floats_bools_and_chars() {
    let fs = [1.5, 2.5]
    expect(fs.contains(1.5)).toBe(true)
    expect(fs.contains(3.5)).toBe(false)

    let bs = [true, false]
    expect(bs.contains(true)).toBe(true)
    expect(bs.contains(false)).toBe(true)

    let cs = ['a', 'b']
    expect(cs.contains('a')).toBe(true)
    expect(cs.contains('z')).toBe(false)
}

test fn class_elements_compare_structurally() {
    let ps = [Point(1, 2), Point(3, 4)]
    expect(ps.contains(Point(1, 2))).toBe(true)
    expect(ps.contains(Point(3, 4))).toBe(true)
    expect(ps.contains(Point(5, 6))).toBe(false)
}

test fn tuple_elements_compare_structurally() {
    let rows: List<(int, string)> = [(1, "one"), (2, "two")]
    expect(rows.contains((1, "one"))).toBe(true)
    expect(rows.contains((2, "two"))).toBe(true)
    expect(rows.contains((2, "one"))).toBe(false)
}

test fn empty_list_never_contains() {
    let xs = [0]
    xs.pop()
    expect(len(xs)).toBe(0)
    expect(xs.contains(0)).toBe(false)
    expect(xs.contains(1)).toBe(false)
}

test fn reads_through_an_immutable_borrow() {
    let xs = [7, 8, 9]
    expect(borrowed_contains(xs, 7)).toBe(true)
    expect(borrowed_contains(xs, 9)).toBe(true)
    expect(borrowed_contains(xs, 6)).toBe(false)
}

test fn result_is_a_bool_value() {
    let xs = [1, 2, 3]
    let hit = xs.contains(2)
    expect(hit).toBe(true)
    if (xs.contains(3)) {
        expect(true).toBe(true)
    } else {
        expect(false).toBe(true)
    }
}

test fn follows_list_mutation() {
    let xs = [1, 2]
    expect(xs.contains(3)).toBe(false)
    xs.push(3)
    expect(xs.contains(3)).toBe(true)
    xs.remove(0)
    expect(xs.contains(1)).toBe(false)
    expect(xs.contains(2)).toBe(true)
}
