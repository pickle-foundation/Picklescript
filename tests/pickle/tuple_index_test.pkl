class Vec2 {
    var x: int
    var y: int

    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }

    fn sum() -> int {
        this.x + this.y
    }
}

class PairHolder {
    var pair: (int, string)

    constructor(pair: (int, string)) {
        this.pair = pair
    }
}

fn make_pair() -> (int, string) {
    (7, "seven")
}

test fn reads_scalar_elements() {
    let t = (10, 20, 30)
    expect(t[0]).toBe(10)
    expect(t[1]).toBe(20)
    expect(t[2]).toBe(30)
}

test fn reads_mixed_element_types() {
    let t = (1, "hello", true, 'z', 2.5)
    expect(t[0]).toBe(1)
    expect(t[1]).toBe("hello")
    expect(t[2]).toBe(true)
    expect(t[3]).toBe('z')
    expect(t[4]).toBe(2.5)
}

test fn reads_pointer_elements() {
    var xs = [1, 2, 3]
    let t = (xs, 9)
    expect(len(t[0])).toBe(3)
    expect(t[0][1]).toBe(2)
    expect(t[1]).toBe(9)
}

test fn reads_nested_tuple() {
    let t = (1, (2, "inner"), 3)
    expect(t[1][0]).toBe(2)
    expect(t[1][1]).toBe("inner")
}

test fn reads_tuple_result_of_call() {
    expect(make_pair()[0]).toBe(7)
    expect(make_pair()[1]).toBe("seven")
}

test fn reads_inline_tuple_literal() {
    expect((4, 5)[0]).toBe(4)
    expect((4, 5)[1]).toBe(5)
}

test fn reads_class_instance_element() {
    let t = (Vec2(2, 3), 99)
    expect(t[0].x).toBe(2)
    expect(t[0].sum()).toBe(5)
    expect(t[1]).toBe(99)
}

test fn reads_tuple_field_from_class() {
    let h = PairHolder((5, "five"))
    expect(h.pair[0]).toBe(5)
    expect(h.pair[1]).toBe("five")
}

test fn reads_tuple_inside_list() {
    var rows: List<(int, int)> = [(1, 2), (3, 4)]
    expect(rows[0][1]).toBe(2)
    expect(rows[1][0]).toBe(3)
}

test fn reads_tuple_in_map_value() {
    var m = {"a": (1, 2)}
    expect(m["a"][1]).toBe(2)
}

test fn reads_option_element() {
    var o: int? = 5
    let t = (o, 8)
    expect(t[0] ?? 0).toBe(5)
    expect(t[1]).toBe(8)
}

test fn tuple_index_in_for_loop() {
    var rows = [(10, 20), (30, 40)]
    var total = 0
    for (r in rows) {
        total = total + r[0] + r[1]
    }
    expect(total).toBe(100)
}

test fn repeated_reads_are_stable() {
    let t = (1, (2, 3), "x")
    var sum = 0
    var i = 0
    while (i < 3) {
        sum = sum + t[0]
        i = i + 1
    }
    expect(sum).toBe(3)
    expect(t[1][1]).toBe(3)
    expect(t[2]).toBe("x")
}

test fn tuple_index_after_reassignment() {
    var t = (1, 2)
    expect(t[1]).toBe(2)
    t = (3, 4)
    expect(t[0]).toBe(3)
    expect(t[1]).toBe(4)
}

test fn tuple_index_through_function_value() {
    let f = make_pair
    expect(f()[0]).toBe(7)
}
