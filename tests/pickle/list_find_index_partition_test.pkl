// `List.findIndex(f)` and `List.partition(f)`: beyond-parity index search and
// two-way split. Both read through `&List` and leave the receiver untouched.

fn is_even(v: int) -> bool {
    v % 2 == 0
}

fn borrowed_find_index(xs: &List<int>) -> int? {
    xs.findIndex((v: int) => v > 2)
}

fn borrowed_partition(xs: &List<int>) -> (List<int>, List<int>) {
    xs.partition((v: int) => v % 2 == 0)
}

test fn find_index_reports_the_first_match() {
    let xs = [1, 2, 3, 2]
    expect(xs.findIndex((v: int) => v == 2).unwrap()).toBe(1)
}

test fn find_index_of_missing_is_none() {
    let xs = [1, 3]
    expect(xs.findIndex((v: int) => v == 2).isNone()).toBe(true)
}

test fn find_index_of_empty_is_none() {
    var xs = [0]
    xs.clear()
    expect(xs.findIndex((v: int) => true).isNone()).toBe(true)
}

test fn find_index_accepts_a_named_function() {
    let xs = [1, 3, 4]
    expect(xs.findIndex(is_even).unwrap()).toBe(2)
}

test fn find_index_reads_through_an_immutable_borrow() {
    let xs = [1, 2, 3]
    expect(borrowed_find_index(xs).unwrap()).toBe(2)
}

test fn partition_splits_preserving_order() {
    let xs = [1, 2, 3, 4]
    let (evens, odds) = xs.partition((v: int) => v % 2 == 0)
    expect(evens.len()).toBe(2)
    expect(odds.len()).toBe(2)
    expect(evens[0]).toBe(2)
    expect(evens[1]).toBe(4)
    expect(odds[0]).toBe(1)
    expect(odds[1]).toBe(3)
}

test fn partition_of_all_and_none() {
    let xs = [2, 4]
    let (a, b) = xs.partition((v: int) => v % 2 == 0)
    expect(a.len()).toBe(2)
    expect(b.isEmpty()).toBe(true)
    let (c, d) = xs.partition((v: int) => v % 2 != 0)
    expect(c.isEmpty()).toBe(true)
    expect(d.len()).toBe(2)
}

test fn partition_reads_through_an_immutable_borrow_and_strings() {
    let xs = [1, 2]
    let (yes, no) = borrowed_partition(xs)
    expect(yes.len()).toBe(1)
    expect(no.len()).toBe(1)
    let words = ["aa", "b"]
    let (long, short) = words.partition((w: string) => w.len() > 1)
    expect(long.len()).toBe(1)
    expect(short[0]).toBe("b")
}
