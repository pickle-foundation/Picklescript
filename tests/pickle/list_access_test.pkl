fn borrowed_take(xs: &List<int>) -> List<int> {
    xs.take(2)
}

fn borrowed_skip(xs: &List<int>) -> List<int> {
    xs.skip(1)
}

fn borrowed_first(xs: &List<int>) -> int? {
    xs.first()
}

fn borrowed_last(xs: &List<int>) -> int? {
    xs.last()
}

test fn take_keeps_the_first_n() {
    let xs = [1, 2, 3, 4]
    let ys = xs.take(2)
    expect(ys.len()).toBe(2)
    expect(ys[0]).toBe(1)
    expect(ys[1]).toBe(2)
}

test fn take_clamps_to_the_bounds() {
    let xs = [1, 2, 3]
    expect(xs.take(0).isEmpty()).toBe(true)
    expect(xs.take(-1).isEmpty()).toBe(true)
    expect(xs.take(99).len()).toBe(3)
}

test fn take_of_an_empty_list_is_empty() {
    var xs = [0]
    xs.clear()
    expect(xs.take(2).isEmpty()).toBe(true)
}

test fn skip_drops_the_first_n() {
    let xs = [1, 2, 3, 4]
    let ys = xs.skip(2)
    expect(ys.len()).toBe(2)
    expect(ys[0]).toBe(3)
    expect(ys[1]).toBe(4)
}

test fn skip_clamps_to_the_bounds() {
    let xs = [1, 2, 3]
    expect(xs.skip(0).len()).toBe(3)
    expect(xs.skip(-1).len()).toBe(3)
    expect(xs.skip(99).isEmpty()).toBe(true)
}

test fn skip_of_an_empty_list_is_empty() {
    var xs = [0]
    xs.clear()
    expect(xs.skip(2).isEmpty()).toBe(true)
}

test fn take_and_skip_return_fresh_lists() {
    let xs = [1, 2, 3]
    let a = xs.take(2)
    let b = xs.skip(1)
    a.push(99)
    b.push(98)
    expect(xs.len()).toBe(3)
    expect(xs[2]).toBe(3)
}

test fn take_and_skip_compose() {
    let xs = [1, 2, 3, 4, 5]
    let ys = xs.skip(1).take(2)
    expect(ys.len()).toBe(2)
    expect(ys[0]).toBe(2)
    expect(ys[1]).toBe(3)
}

test fn first_returns_the_head() {
    let xs = [10, 20, 30]
    expect(xs.first().isSome()).toBe(true)
    expect(xs.first().unwrap()).toBe(10)
}

test fn last_returns_the_tail() {
    let xs = [10, 20, 30]
    expect(xs.last().isSome()).toBe(true)
    expect(xs.last().unwrap()).toBe(30)
}

test fn first_and_last_of_an_empty_list_are_none() {
    var xs = [0]
    xs.clear()
    expect(xs.first().isNone()).toBe(true)
    expect(xs.last().isNone()).toBe(true)
}

test fn first_and_last_preserve_string_elements() {
    let xs = ["a", "bb", "ccc"]
    expect(xs.first().unwrap()).toBe("a")
    expect(xs.last().unwrap()).toBe("ccc")
}

test fn first_and_last_preserve_float_elements() {
    let xs = [1.5, 2.5]
    expect(xs.first().unwrap()).toBe(1.5)
    expect(xs.last().unwrap()).toBe(2.5)
}

test fn accessors_read_through_an_immutable_borrow() {
    let xs = [1, 2, 3]
    expect(borrowed_take(xs).len()).toBe(2)
    expect(borrowed_skip(xs)[0]).toBe(2)
    expect(borrowed_first(xs).unwrap()).toBe(1)
    expect(borrowed_last(xs).unwrap()).toBe(3)
}

test fn accessors_leave_the_receiver_unchanged() {
    let xs = [1, 2, 3]
    let a = xs.take(1)
    let b = xs.skip(1)
    let c = xs.first()
    let d = xs.last()
    expect(a.len()).toBe(1)
    expect(b.len()).toBe(2)
    expect(c.unwrap()).toBe(1)
    expect(d.unwrap()).toBe(3)
    expect(xs.len()).toBe(3)
    expect(xs[0]).toBe(1)
    expect(xs[2]).toBe(3)
}
