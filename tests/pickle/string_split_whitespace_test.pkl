// `String.splitWhitespace`: beyond-parity, shaped like Rust's
// `str::split_whitespace` but with the same four ASCII whitespace bytes `trim`
// strips (space, `\t`, `\n`, `\r`). Runs collapse; no empty fields.

fn borrowed_split_whitespace(s: &string) -> List<string> {
    s.splitWhitespace()
}

test fn split_whitespace_splits_on_any_run() {
    let ws = "a b\tc\nd\r\ne".splitWhitespace()
    expect(ws.len()).toBe(5)
    expect(ws[0]).toBe("a")
    expect(ws[1]).toBe("b")
    expect(ws[2]).toBe("c")
    expect(ws[3]).toBe("d")
    expect(ws[4]).toBe("e")
}

test fn split_whitespace_collapses_leading_trailing_and_repeated() {
    let ws = "  a \t\n  b  ".splitWhitespace()
    expect(ws.len()).toBe(2)
    expect(ws[0]).toBe("a")
    expect(ws[1]).toBe("b")
}

test fn split_whitespace_of_empty_and_whitespace_only_is_empty() {
    expect("".splitWhitespace().isEmpty()).toBe(true)
    expect(" \t\r\n ".splitWhitespace().isEmpty()).toBe(true)
}

test fn split_whitespace_does_not_split_on_punctuation() {
    let ws = "a,,b".splitWhitespace()
    expect(ws.len()).toBe(1)
    expect(ws[0]).toBe("a,,b")
}

test fn split_whitespace_reads_through_an_immutable_borrow() {
    let ws = borrowed_split_whitespace("x y")
    expect(ws.len()).toBe(2)
    expect(ws[1]).toBe("y")
}

test fn split_whitespace_round_trips_with_join() {
    expect(" one\ttwo\nthree ".splitWhitespace().join("-")).toBe("one-two-three")
}
