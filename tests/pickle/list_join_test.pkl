fn borrowed_join(xs: &List<string>, sep: string) -> string {
    xs.join(sep)
}

test fn join_inserts_the_separator() {
    let xs = ["a", "b", "c"]
    expect(xs.join(",")).toBe("a,b,c")
    expect(xs.join(", ")).toBe("a, b, c")
    expect(xs.join("")).toBe("abc")
}

test fn join_of_an_empty_list_is_empty() {
    var xs = ["seed"]
    xs.clear()
    expect(xs.join(",")).toBe("")
}

test fn join_of_one_element_has_no_separator() {
    let xs = ["solo"]
    expect(xs.join(",")).toBe("solo")
}

test fn join_keeps_empty_elements() {
    let xs = ["", ""]
    expect(xs.join(",")).toBe(",")
    let ys = ["a", "", "b"]
    expect(ys.join("-")).toBe("a--b")
}

test fn join_with_variables_and_mutation() {
    var xs = ["x", "y"]
    xs.push("z")
    let sep = "|"
    expect(xs.join(sep)).toBe("x|y|z")
}

test fn join_reads_through_an_immutable_borrow() {
    expect(borrowed_join(["a", "b"], "-")).toBe("a-b")
}

test fn join_composes_with_string_members() {
    let xs = ["Hello", "World"]
    expect(xs.join(" ").toUpper()).toBe("HELLO WORLD")
    expect(xs.join(" ").len()).toBe(11)
}
