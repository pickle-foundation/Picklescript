// `String.stripPrefix` / `String.stripSuffix`: beyond-parity members with Rust
// `str::strip_prefix` / `str::strip_suffix` semantics. A match yields the
// remainder as a fresh string; no match is `none`.

fn borrowed_strip_prefix(s: &string, p: string) -> string? {
    s.stripPrefix(p)
}

fn borrowed_strip_suffix(s: &string, p: string) -> string? {
    s.stripSuffix(p)
}

test fn strip_prefix_removes_a_matching_prefix() {
    expect("foobar".stripPrefix("foo").unwrap()).toBe("bar")
    expect("foobar".stripPrefix("bar").isNone()).toBe(true)
    expect("abc".stripPrefix("abcd").isNone()).toBe(true)
}

test fn strip_prefix_of_empty_is_the_whole_string() {
    let s = "abc"
    expect(s.stripPrefix("").unwrap()).toBe("abc")
    expect("abc".stripPrefix("abc").unwrap()).toBe("")
}

test fn strip_suffix_removes_a_matching_suffix() {
    expect("foobar".stripSuffix("bar").unwrap()).toBe("foo")
    expect("foobar".stripSuffix("foo").isNone()).toBe(true)
    expect("abc".stripSuffix("zabc").isNone()).toBe(true)
    expect("abc".stripSuffix("").unwrap()).toBe("abc")
    expect("abc".stripSuffix("abc").unwrap()).toBe("")
}

test fn strip_members_are_total_on_empty_input() {
    expect("".stripPrefix("a").isNone()).toBe(true)
    expect("".stripSuffix("a").isNone()).toBe(true)
    expect("".stripPrefix("").unwrap()).toBe("")
    expect("".stripSuffix("").unwrap()).toBe("")
}

test fn strip_members_read_through_an_immutable_borrow() {
    expect(borrowed_strip_prefix("a-b", "a-").unwrap()).toBe("b")
    expect(borrowed_strip_suffix("a-b", "-b").unwrap()).toBe("a")
    expect(borrowed_strip_prefix("a-b", "b-").isNone()).toBe(true)
    expect(borrowed_strip_suffix("a-b", "-a").isNone()).toBe(true)
}

test fn strip_members_compose_with_prefix_predicates() {
    let s = "path/to/file.txt"
    expect(s.startsWith("path/")).toBe(true)
    expect(s.stripPrefix("path/").unwrap()).toBe("to/file.txt")
    expect(s.stripSuffix(".txt").unwrap()).toBe("path/to/file")
}
