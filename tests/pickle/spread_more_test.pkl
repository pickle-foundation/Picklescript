// Spread arguments beyond plain constructors: enum variant constructors,
// named constructors, and generic-function type-argument inference. Each
// shape fills the remaining parameters from one homogeneous list.

enum Trio {
    One(v: int)
    Sum(a: int, b: int)
    Tag(s: string)
}

class NamedBox2 {
    var x: int
    var y: int

    constructor(x: int, y: int) {
        this.x = x
        this.y = y
    }

    constructor.side(n: int) {
        this(n, n)
    }

    constructor.pair(a: int, b: int) {
        this(a, b)
    }
}

class DBase {
    var a: int
    var b: int

    constructor(a: int, b: int) {
        this.a = a
        this.b = b
    }
}

class DChildAll extends DBase {
    constructor(a: int, b: int) {
        super(...[a, b])
    }
}

class DChildLead extends DBase {
    var c: int

    constructor(a: int, b: int) {
        super(a, ...[b])
        this.c = a - b
    }
}

class DImplicitBase {
    var x: int
    var y: int
}

class DImplicitChild extends DImplicitBase {
    var z: int

    constructor(xs: List<int>) {
        super(...xs)
        this.z = 7
    }
}

class DNameBase {
    var name: string
}

class DNameChild extends DNameBase {
    var extra: string

    constructor(name: string) {
        super(...[name])
        this.extra = "!"
    }
}

class NNamed {
    var a: int
    var b: int

    constructor(a: int, b: int) {
        this.a = a
        this.b = b
    }

    constructor.from_all(pair: List<int>) {
        this(...pair)
    }

    constructor.from_lead(a: int, more: List<int>) {
        this(a, ...more)
    }
}

fn three<T>(a: T, b: T, c: T) -> T {
    a
}

fn second<T>(a: T, b: T) -> T {
    b
}

fn keep_b<A, B>(a: A, b: B) -> B {
    b
}

fn list_len<T>(xs: List<T>) -> int {
    len(xs)
}

fn enum_first(e: Trio) -> int {
    match (e) {
        case Trio.One(v) -> v
        case Trio.Sum(a, _b) -> a
        case Trio.Tag(_s) -> 0 - 1
    }
}

fn enum_second(e: Trio) -> int {
    match (e) {
        case Trio.One(v) -> v
        case Trio.Sum(_a, b) -> b
        case Trio.Tag(_s) -> 0 - 1
    }
}

fn enum_tag(e: Trio) -> string {
    match (e) {
        case Trio.One(_v) -> "one"
        case Trio.Sum(_a, _b) -> "sum"
        case Trio.Tag(s) -> s
    }
}

test fn enum_ctor_all_spread() {
    var xs = [4, 5]
    var e = Trio.Sum(...xs)
    expect(enum_first(e)).toBe(4)
    expect(enum_second(e)).toBe(5)
}

test fn enum_ctor_leading_arg_then_spread() {
    var e = Trio.Sum(7, ...[8])
    expect(enum_first(e)).toBe(7)
    expect(enum_second(e)).toBe(8)
}

test fn enum_ctor_pointer_element_spread() {
    var e = Trio.Tag(...["tagged"])
    expect(enum_tag(e)).toBe("tagged")
}

test fn enum_ctor_single_field_spread() {
    var e = Trio.One(...[9])
    expect(enum_first(e)).toBe(9)
}

test fn named_ctor_all_spread() {
    var b = NamedBox2.side(...[6])
    expect(b.x).toBe(6)
    expect(b.y).toBe(6)
}

test fn named_ctor_two_param_spread() {
    var b = NamedBox2.pair(...[2, 3])
    expect(b.x).toBe(2)
    expect(b.y).toBe(3)
}

test fn named_ctor_leading_arg_then_spread() {
    var b = NamedBox2.pair(9, ...[4])
    expect(b.x).toBe(9)
    expect(b.y).toBe(4)
}

test fn generic_fn_infers_from_spread() {
    var xs = [1, 2, 3]
    expect(three(...xs)).toBe(1)
}

test fn generic_fn_infers_from_leading_and_spread() {
    expect(second(9, ...[5])).toBe(5)
}

test fn generic_fn_infers_two_type_params() {
    expect(keep_b(1, ...["s"])).toBe("s")
}

test fn generic_fn_infers_pointer_type() {
    expect(second("a", ...["b"])).toBe("b")
}

test fn generic_fn_infers_from_nested_list_spread() {
    var ls: List<List<int>> = [[1, 2]]
    expect(list_len(...ls)).toBe(2)
}

test fn named_ctor_delegation_all_spread() {
    var n = NNamed.from_all([3, 4])
    expect(n.a).toBe(3)
    expect(n.b).toBe(4)
}

test fn named_ctor_delegation_leading_then_spread() {
    var n = NNamed.from_lead(5, [6])
    expect(n.a).toBe(5)
    expect(n.b).toBe(6)
}

test fn super_delegation_all_spread() {
    var d = DChildAll(1, 2)
    expect(d.a).toBe(1)
    expect(d.b).toBe(2)
}

test fn super_delegation_leading_then_spread() {
    var d = DChildLead(9, 4)
    expect(d.a).toBe(9)
    expect(d.b).toBe(4)
    expect(d.c).toBe(5)
}

test fn super_delegation_into_implicit_ctor_spread() {
    var d = DImplicitChild([11, 12])
    expect(d.x).toBe(11)
    expect(d.y).toBe(12)
    expect(d.z).toBe(7)
}

test fn super_delegation_pointer_element_spread() {
    var d = DNameChild("nm")
    expect(d.name).toBe("nm")
    expect(d.extra).toBe("!")
}

// Mixed element representations (beyond Rust parity). A scalar list element is
// already stored as its boxed pointer, which is exactly the value a managed
// `Option<T>` parameter consumes (`some(v)` is that box for scalars), so a
// `List<int>` may fill an `int?` slot while other slots stay plain `int`.
// Rust's emitter rejects this shape as "mixed element representations".

fn mixed_tail(a: int, b: int?) -> int {
    match (b) {
        case some(v) -> a + v
        case none -> a
    }
}

fn mixed_lead(a: int?, b: int) -> int {
    match (a) {
        case some(v) -> v + b
        case none -> b
    }
}

fn mixed_unwrap(v: int?, d: int) -> int {
    match (v) {
        case some(x) -> x
        case none -> d
    }
}

enum MixedPair {
    Make(a: int, b: int?)
    Solo(s: string)
}

class MixedBase {
    var a: int
    var b: int?

    constructor(a: int, b: int?) {
        this.a = a
        this.b = b
    }
}

class MixedChild extends MixedBase {
    constructor(xs: List<int>) {
        super(...xs)
    }
}

class MixedImplicit {
    var a: int
    var b: int?
}

class MixedNamed {
    var a: int
    var b: int?

    constructor(a: int, b: int?) {
        this.a = a
        this.b = b
    }

    constructor.from_list(xs: List<int>) {
        this(...xs)
    }
}

test fn static_call_spread_into_option_tail() {
    var xs = [3, 4]
    expect(mixed_tail(...xs)).toBe(7)
}

test fn static_call_spread_from_option_head() {
    var xs = [5, 6]
    expect(mixed_lead(...xs)).toBe(11)
}

test fn fn_value_spread_into_option_tail() {
    var f: (int, int?) -> int = mixed_tail
    var xs = [5, 6]
    expect(f(...xs)).toBe(11)
}

test fn enum_ctor_spread_into_option_field() {
    var xs = [5, 6]
    match (MixedPair.Make(...xs)) {
        case MixedPair.Make(a, b) -> expect(a + mixed_unwrap(b, 0)).toBe(11)
        case MixedPair.Solo(_s) -> expect(false).toBe(true)
    }
}

test fn implicit_ctor_spread_into_option_field() {
    var p = MixedImplicit(...[7, 8])
    expect(p.a + mixed_unwrap(p.b, 0)).toBe(15)
}

test fn named_ctor_delegation_spread_into_option_field() {
    var n = MixedNamed.from_list([9, 10])
    expect(n.a + mixed_unwrap(n.b, 0)).toBe(19)
}

test fn super_delegation_spread_into_option_field() {
    var d = MixedChild([11, 12])
    expect(d.a + mixed_unwrap(d.b, 0)).toBe(23)
}

