test fn list_remove_at_middle() {
    let xs = [10, 20, 30, 40]
    let v = xs.remove(1)
    expect(v).toBe(20)
    expect(len(xs)).toBe(3)
    expect(xs[0]).toBe(10)
    expect(xs[1]).toBe(30)
    expect(xs[2]).toBe(40)
}

test fn list_remove_first_and_last() {
    let xs = [1, 2, 3]
    expect(xs.remove(0)).toBe(1)
    expect(xs.remove(1)).toBe(3)
    expect(len(xs)).toBe(1)
    expect(xs[0]).toBe(2)
}

test fn list_insert_middle() {
    let xs = [1, 2, 4, 5]
    xs.insert(2, 3)
    expect(len(xs)).toBe(5)
    expect(xs[0]).toBe(1)
    expect(xs[1]).toBe(2)
    expect(xs[2]).toBe(3)
    expect(xs[3]).toBe(4)
    expect(xs[4]).toBe(5)
}

test fn list_insert_front_and_end() {
    let xs = [2, 3]
    xs.insert(0, 1)
    xs.insert(3, 4)
    expect(len(xs)).toBe(4)
    expect(xs[0]).toBe(1)
    expect(xs[1]).toBe(2)
    expect(xs[2]).toBe(3)
    expect(xs[3]).toBe(4)
}

test fn list_remove_and_insert_strings() {
    let xs = ["a", "b", "c"]
    expect(xs.remove(1)).toBe("b")
    expect(len(xs)).toBe(2)
    expect(xs[0]).toBe("a")
    expect(xs[1]).toBe("c")
    xs.insert(1, "b")
    expect(len(xs)).toBe(3)
    expect(xs[1]).toBe("b")
    expect(xs[2]).toBe("c")
}

test fn list_sort_ints() {
    let xs = [3, 1, 2]
    xs.sort()
    expect(xs[0]).toBe(1)
    expect(xs[1]).toBe(2)
    expect(xs[2]).toBe(3)
}

test fn list_sort_negatives() {
    let xs = [0, -3, 7, -1]
    xs.sort()
    expect(xs[0]).toBe(-3)
    expect(xs[1]).toBe(-1)
    expect(xs[2]).toBe(0)
    expect(xs[3]).toBe(7)
}

test fn list_sort_floats() {
    let xs = [2.5, 0.5, 1.5]
    xs.sort()
    expect(xs[0]).toBe(0.5)
    expect(xs[1]).toBe(1.5)
    expect(xs[2]).toBe(2.5)
}

test fn list_sort_strings() {
    let xs = ["pear", "apple", "mango"]
    xs.sort()
    expect(xs[0]).toBe("apple")
    expect(xs[1]).toBe("mango")
    expect(xs[2]).toBe("pear")
}

test fn list_sort_bools() {
    let xs = [true, false, true]
    xs.sort()
    expect(xs[0]).toBe(false)
    expect(xs[1]).toBe(true)
    expect(xs[2]).toBe(true)
}

fn first_index(xs: &List<int>, v: int) -> int {
    xs.indexOf(v) ?? -1
}

test fn list_clear_empties_but_keeps_the_list_usable() {
    let xs = [1, 2, 3]
    xs.clear()
    expect(len(xs)).toBe(0)
    expect(xs.isEmpty()).toBe(true)
    xs.push(9)
    expect(len(xs)).toBe(1)
    expect(xs[0]).toBe(9)
}

test fn list_reverse_ints() {
    let xs = [1, 2, 3, 4]
    xs.reverse()
    expect(xs[0]).toBe(4)
    expect(xs[1]).toBe(3)
    expect(xs[2]).toBe(2)
    expect(xs[3]).toBe(1)
}

test fn list_reverse_odd_and_strings() {
    let odd = [1, 2, 3]
    odd.reverse()
    expect(odd[0]).toBe(3)
    expect(odd[1]).toBe(2)
    expect(odd[2]).toBe(1)
    let ss = ["a", "b", "c", "d"]
    ss.reverse()
    expect(ss[0]).toBe("d")
    expect(ss[1]).toBe("c")
    expect(ss[2]).toBe("b")
    expect(ss[3]).toBe("a")
}

test fn list_reverse_empty_and_single() {
    let empty = [0]
    empty.pop()
    empty.reverse()
    expect(len(empty)).toBe(0)
    let one = [7]
    one.reverse()
    expect(one[0]).toBe(7)
}

test fn list_index_of_first_match_and_absence() {
    let xs = [10, 20, 30, 20]
    expect(xs.indexOf(10) ?? -1).toBe(0)
    expect(xs.indexOf(30) ?? -1).toBe(2)
    // Duplicates report the first occurrence.
    expect(xs.indexOf(20) ?? -1).toBe(1)
    expect(xs.indexOf(99) ?? -1).toBe(-1)
}

test fn list_index_of_strings_and_borrows() {
    let ss = ["alpha", "beta", "gamma"]
    expect(ss.indexOf("beta") ?? -1).toBe(1)
    expect(ss.indexOf("delta") ?? -1).toBe(-1)
    let xs = [4, 5, 6]
    expect(first_index(xs, 6)).toBe(2)
    expect(first_index(xs, 0)).toBe(-1)
}

test fn list_index_of_agrees_with_contains() {
    let xs = ["a", "b"]
    expect(xs.contains("b")).toBe((xs.indexOf("b") ?? -1) >= 0)
    expect(xs.contains("z")).toBe((xs.indexOf("z") ?? -1) >= 0)
}