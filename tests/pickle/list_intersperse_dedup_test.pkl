// `List.intersperse(sep)` and `List.dedup()`: beyond-parity producers of fresh
// lists. Both read through `&List` and leave the receiver untouched.

fn borrowed_intersperse(xs: &List<int>, sep: int) -> List<int> {
    xs.intersperse(sep)
}

fn borrowed_dedup(xs: &List<int>) -> List<int> {
    xs.dedup()
}

test fn intersperse_puts_the_separator_between_elements() {
    let xs = [1, 2, 3]
    let out = xs.intersperse(0)
    expect(out.len()).toBe(5)
    expect(out[0]).toBe(1)
    expect(out[1]).toBe(0)
    expect(out[2]).toBe(2)
    expect(out[3]).toBe(0)
    expect(out[4]).toBe(3)
    expect(xs.len()).toBe(3)
}

test fn intersperse_of_empty_and_single() {
    var xs = [0]
    xs.clear()
    expect(xs.intersperse(9).isEmpty()).toBe(true)
    let one = [5]
    let out = one.intersperse(9)
    expect(out.len()).toBe(1)
    expect(out[0]).toBe(5)
}

test fn intersperse_works_on_strings() {
    let words = ["a", "b"]
    expect(words.intersperse("-").join("")).toBe("a-b")
}

test fn intersperse_reads_through_an_immutable_borrow() {
    let xs = [1, 2]
    let out = borrowed_intersperse(xs, 7)
    expect(out.len()).toBe(3)
    expect(out[1]).toBe(7)
}

test fn dedup_collapses_adjacent_duplicates() {
    let xs = [1, 1, 2, 2, 2, 3, 1]
    let out = xs.dedup()
    expect(out.len()).toBe(4)
    expect(out[0]).toBe(1)
    expect(out[1]).toBe(2)
    expect(out[2]).toBe(3)
    expect(out[3]).toBe(1)
}

test fn dedup_of_empty_and_all_equal() {
    var xs = [0]
    xs.clear()
    expect(xs.dedup().isEmpty()).toBe(true)
    expect([4, 4, 4].dedup().len()).toBe(1)
}

test fn dedup_compares_strings_by_value() {
    let xs = ["a", "a", "b", "a"]
    let out = xs.dedup()
    expect(out.len()).toBe(3)
    expect(out[1]).toBe("b")
}

test fn dedup_reads_through_an_immutable_borrow() {
    let xs = [1, 1, 2]
    expect(borrowed_dedup(xs).len()).toBe(2)
}
