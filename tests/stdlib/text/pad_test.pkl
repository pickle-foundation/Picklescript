module std.text.pad_test

import { padLeft, padRight, padCenter, truncateRight, truncateLeft, truncateMiddle, fitLeft, fitRight } from std.text.pad

/// The byte width of `s`.
fn widthOf(s: string) -> int {
    len(bytes(s))
}

test fn padding_on_the_left() {
    expect(padLeft("ab", 5, "-")).toBe("---ab")
    expect(padLeft("ab", 4, "-")).toBe("--ab")
    expect(padLeft("ab", 3, "-")).toBe("-ab")
    expect(padLeft("ab", 2, "-")).toBe("ab")
    expect(padLeft("ab", 1, "-")).toBe("ab")
    expect(padLeft("", 3, "-")).toBe("---")
    expect(padLeft("abc", 0, "-")).toBe("abc")
}

test fn padding_on_the_right() {
    expect(padRight("ab", 5, "-")).toBe("ab---")
    expect(padRight("ab", 4, "-")).toBe("ab--")
    expect(padRight("ab", 3, "-")).toBe("ab-")
    expect(padRight("ab", 2, "-")).toBe("ab")
    expect(padRight("", 2, "-")).toBe("--")
    expect(padRight("abc", 0, "-")).toBe("abc")
}

test fn padding_is_centered() {
    expect(padCenter("ab", 6, "-")).toBe("--ab--")
    expect(padCenter("ab", 5, "-")).toBe("-ab--")
    expect(padCenter("ab", 4, "-")).toBe("-ab-")
    expect(padCenter("ab", 3, "-")).toBe("ab-")
    expect(padCenter("ab", 2, "-")).toBe("ab")
    expect(padCenter("a", 5, "*")).toBe("**a**")
    expect(padCenter("", 3, "-")).toBe("---")
}

test fn an_empty_fill_means_a_space() {
    expect(padLeft("ab", 4, "")).toBe("  ab")
    expect(padRight("ab", 4, "")).toBe("ab  ")
    expect(padCenter("ab", 4, "")).toBe(" ab ")
}

test fn only_the_first_fill_byte_is_used() {
    expect(padLeft("x", 3, "ab")).toBe("aax")
    expect(padRight("x", 3, "ab")).toBe("xaa")
    expect(padCenter("x", 3, "ab")).toBe("axa")
}

test fn truncating_from_the_right() {
    expect(truncateRight("abcdefghij", 7, "...")).toBe("abcd...")
    expect(truncateRight("abcdefghij", 8, "...")).toBe("abcde...")
    expect(truncateRight("abcdefghij", 10, "...")).toBe("abcdefghij")
    expect(truncateRight("abcdefghij", 11, "...")).toBe("abcdefghij")
    expect(truncateRight("abc", 3, "...")).toBe("abc")
    expect(truncateRight("abcdef", 3, "")).toBe("abc")
}

test fn truncating_from_the_left() {
    expect(truncateLeft("abcdefghij", 7, "...")).toBe("...ghij")
    expect(truncateLeft("abcdefghij", 8, "...")).toBe("...fghij")
    expect(truncateLeft("abcdefghij", 10, "...")).toBe("abcdefghij")
    expect(truncateLeft("abcdefghij", 11, "...")).toBe("abcdefghij")
    expect(truncateLeft("abcdef", 3, "")).toBe("def")
}

test fn truncating_in_the_middle() {
    expect(truncateMiddle("abcdefghij", 7, "...")).toBe("ab...ij")
    expect(truncateMiddle("abcdefghij", 8, "...")).toBe("abc...ij")
    expect(truncateMiddle("abcdefghij", 9, "...")).toBe("abc...hij")
    expect(truncateMiddle("abcdefghij", 10, "...")).toBe("abcdefghij")
    expect(truncateMiddle("abcdefghij", 5, "")).toBe("abcij")
    expect(truncateMiddle("abcdefghij", 6, "")).toBe("abchij")
}

test fn narrow_widths_fall_back_to_the_ellipsis() {
    expect(truncateRight("abcdef", 2, "...")).toBe("..")
    expect(truncateRight("abcdef", 3, "...")).toBe("...")
    expect(truncateLeft("abcdef", 1, "...")).toBe(".")
    expect(truncateLeft("abcdef", 3, "...")).toBe("...")
    expect(truncateMiddle("abcdef", 2, "...")).toBe("..")
}

test fn non_positive_widths_are_empty() {
    expect(truncateRight("abcdef", 0, "...")).toBe("")
    expect(truncateRight("abcdef", -3, "...")).toBe("")
    expect(truncateLeft("abcdef", 0, "...")).toBe("")
    expect(truncateMiddle("abcdef", -1, "...")).toBe("")
}

test fn fitting_to_an_exact_width() {
    expect(fitRight("abcdef", 8, ".", "...")).toBe("abcdef..")
    expect(fitRight("abcdefghij", 8, ".", "...")).toBe("abcde...")
    expect(fitRight("abc", 3, ".", "...")).toBe("abc")
    expect(fitLeft("abcdef", 8, ".", "...")).toBe("..abcdef")
    expect(fitLeft("abcdefghij", 8, ".", "...")).toBe("...fghij")
    expect(fitLeft("abc", 3, ".", "...")).toBe("abc")
}

test fn fitting_always_hits_the_width() {
    var widths: List<int> = [0]
    widths.remove(0)
    var w = 1
    while (w <= 12) {
        widths.push(w)
        w = w + 1
    }
    var i = 0
    while (i < len(widths)) {
        let n = widths[i]
        expect(widthOf(fitRight("abcdefghij", n, ".", "..."))).toBe(n)
        expect(widthOf(fitLeft("abcdefghij", n, ".", "..."))).toBe(n)
        expect(widthOf(padLeft("x", n, "-"))).toBe(n)
        expect(widthOf(padRight("x", n, "-"))).toBe(n)
        expect(widthOf(padCenter("x", n, "-"))).toBe(n)
        i = i + 1
    }
}

test fn widths_are_measured_in_bytes() {
    // "héllo" is six bytes: h, the two-byte é, l, l, o.
    expect(widthOf("héllo")).toBe(6)
    let padded = padRight("héllo", 8, "*")
    expect(widthOf(padded)).toBe(8)
    expect(padded).toBe("héllo**")
    expect(padLeft("héllo", 6, "*")).toBe("héllo")
    expect(padCenter("héllo", 8, "-")).toBe("-héllo-")
}

test fn a_table_layout() {
    let headers = ["name", "qty", "price"]
    let vals = ["apple", "12", "1.50"]
    var out = ""
    var i = 0
    while (i < len(headers)) {
        out = out + padRight(headers[i], 8, " ") + padLeft(vals[i], 7, " ") + "|\n"
        i = i + 1
    }
    let expected =
        "name" + "    " + "  " + "apple" + "|\n" +
        "qty" + "     " + "     " + "12" + "|\n" +
        "price" + "   " + "   1.50" + "|\n"
    expect(out).toBe(expected)
    expect(widthOf(padRight("name", 8, " ") + padLeft("apple", 7, " "))).toBe(15)
}

test fn truncation_is_idempotent() {
    let once = truncateMiddle("the quick brown fox jumps", 15, "...")
    expect(once).toBe("the qu... jumps")
    expect(truncateMiddle(once, 15, "...")).toBe(once)
    expect(truncateRight(once, 15, "...")).toBe(once)
    expect(truncateLeft(once, 15, "...")).toBe(once)
}
