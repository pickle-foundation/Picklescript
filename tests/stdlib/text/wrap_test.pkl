module std.text.wrap_test

import { words, wrapLine, wrap, wrapIndented, fill, unwrap } from std.text.wrap

test fn words_splits_on_whitespace_runs() {
    expect(len(words(""))).toBe(0)
    expect(len(words("   "))).toBe(0)
    let ws = words("  alpha\tbeta\n gamma ")
    expect(len(ws)).toBe(3)
    expect(ws[0]).toBe("alpha")
    expect(ws[1]).toBe("beta")
    expect(ws[2]).toBe("gamma")
}

test fn short_line_stays_whole() {
    let ls = wrapLine("a b c", 20)
    expect(len(ls)).toBe(1)
    expect(ls[0]).toBe("a b c")
}

test fn empty_and_blank_lines() {
    let e = wrapLine("", 5)
    expect(len(e)).toBe(1)
    expect(e[0]).toBe("")
    let b = wrapLine("   \t ", 5)
    expect(len(b)).toBe(1)
    expect(b[0]).toBe("")
}

test fn greedy_breaks_between_words() {
    let ls = wrapLine("the quick brown fox", 10)
    expect(len(ls)).toBe(2)
    expect(ls[0]).toBe("the quick")
    expect(ls[1]).toBe("brown fox")
}

test fn exact_fit_does_not_break() {
    let ls = wrapLine("abc def", 7)
    expect(len(ls)).toBe(1)
    expect(ls[0]).toBe("abc def")
    let two = wrapLine("a b", 3)
    expect(len(two)).toBe(1)
    expect(two[0]).toBe("a b")
}

test fn width_below_one_is_one() {
    let ls = wrapLine("a b", 0)
    expect(len(ls)).toBe(2)
    expect(ls[0]).toBe("a")
    expect(ls[1]).toBe("b")
    let neg = wrapLine("ab cd", -3)
    expect(len(neg)).toBe(2)
    expect(neg[1]).toBe("cd")
}

test fn overlong_word_is_never_split() {
    let ls = wrapLine("abcdefgh", 3)
    expect(len(ls)).toBe(1)
    expect(ls[0]).toBe("abcdefgh")
    let mixed = wrapLine("x abcdefgh y", 3)
    expect(len(mixed)).toBe(3)
    expect(mixed[1]).toBe("abcdefgh")
}

test fn widths_count_scalars_not_bytes() {
    let ls = wrapLine("café naïve", 6)
    expect(len(ls)).toBe(2)
    expect(ls[0]).toBe("café")
    expect(ls[1]).toBe("naïve")
    let cjk = wrapLine("日本語", 2)
    expect(len(cjk)).toBe(1)
    expect(cjk[0]).toBe("日本語")
}

test fn empty_document_wraps_to_zero_lines() {
    expect(len(wrap("", 10))).toBe(0)
    let blank = wrap(" ", 10)
    expect(len(blank)).toBe(1)
    expect(blank[0]).toBe("")
}

test fn source_newlines_are_preserved() {
    let ls = wrap("a\nb", 10)
    expect(len(ls)).toBe(2)
    expect(ls[0]).toBe("a")
    expect(ls[1]).toBe("b")
    let blanks = wrap("a\n\nb", 10)
    expect(len(blanks)).toBe(3)
    expect(blanks[1]).toBe("")
    let long = wrap("alpha beta\ngamma", 6)
    expect(len(long)).toBe(3)
    expect(long[0]).toBe("alpha")
    expect(long[1]).toBe("beta")
    expect(long[2]).toBe("gamma")
}

test fn wrap_indents_first_and_rest() {
    let ls = wrapIndented("alpha beta gamma", 10, "* ", "  ")
    expect(len(ls)).toBe(3)
    expect(ls[0]).toBe("* alpha")
    expect(ls[1]).toBe("  beta")
    expect(ls[2]).toBe("  gamma")
    let two = wrapIndented("a\nb", 5, "> ", "  ")
    expect(len(two)).toBe(2)
    expect(two[0]).toBe("> a")
    expect(two[1]).toBe("> b")
    let empty = wrapIndented("\n", 5, "> ", "  ")
    expect(len(empty)).toBe(1)
    expect(empty[0]).toBe("> ")
}

test fn fill_joins_wrapped_lines() {
    expect(fill("a b c", 3)).toBe("a b\nc")
    expect(fill("hello", 20)).toBe("hello")
    expect(fill("", 4)).toBe("")
    expect(fill("a\nb", 10)).toBe("a\nb")
}

test fn unwrap_collapses_all_whitespace() {
    expect(unwrap("  a\n\tb   c ")).toBe("a b c")
    expect(unwrap("")).toBe("")
    expect(unwrap("one")).toBe("one")
}
