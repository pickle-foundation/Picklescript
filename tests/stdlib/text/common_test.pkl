module std.text.common_test

import { prefixLen, prefix, suffixLen, suffix, longestPrefix, longestSuffix } from std.text.common

/// A string built by repeating `part` `times` times.
fn repeats(part: string, times: int) -> string {
    var out = ""
    var i = 0
    while (i < times) {
        out = out + part
        i = i + 1
    }
    out
}

test fn prefix_basics() {
    expect(prefixLen("abc", "abd")).toBe(2)
    expect(prefixLen("abc", "abc")).toBe(3)
    expect(prefixLen("abc", "xyz")).toBe(0)
    expect(prefixLen("", "abc")).toBe(0)
    expect(prefixLen("abc", "")).toBe(0)
    expect(prefixLen("", "")).toBe(0)
    expect(prefix("abc", "abd")).toBe("ab")
    expect(prefix("abc", "abc")).toBe("abc")
    expect(prefix("abc", "xyz")).toBe("")
    expect(prefix("prefix", "prelude")).toBe("pre")
}

test fn suffix_basics() {
    expect(suffixLen("abc", "xbc")).toBe(2)
    expect(suffixLen("abc", "abc")).toBe(3)
    expect(suffixLen("abc", "xyz")).toBe(0)
    expect(suffixLen("", "abc")).toBe(0)
    expect(suffixLen("abc", "")).toBe(0)
    expect(suffixLen("", "")).toBe(0)
    expect(suffix("testing", "running")).toBe("ing")
    expect(suffix("abc", "abc")).toBe("abc")
    expect(suffix("abc", "xyz")).toBe("")
    expect(suffix("abc", "xbc")).toBe("bc")
}

test fn differing_lengths() {
    expect(prefix("abcde", "abc")).toBe("abc")
    expect(prefix("abc", "abcde")).toBe("abc")
    expect(suffix("abcde", "cde")).toBe("cde")
    expect(suffix("cde", "abcde")).toBe("cde")
    expect(prefixLen("a", "abc")).toBe(1)
    expect(suffixLen("c", "abc")).toBe(1)
}

test fn byte_semantics_for_unicode() {
    expect(prefix("café", "café")).toBe("café")
    expect(prefix("café", "cafe")).toBe("caf")
    expect(prefixLen("café", "cafe")).toBe(3)
    expect(suffix("héllo", "jéllo")).toBe("éllo")
    // Multi-byte scalars count as their bytes: "aéb" and "aêb" share "a" and
    // the lead byte of the accented scalar (2 bytes) before differing.
    expect(prefixLen("aéb", "aêb")).toBe(2)
    expect(prefixLen("café", "cafè")).toBe(4)
    expect(suffixLen("aéb", "aèb")).toBe(1)
}

test fn longest_prefix_of_lists() {
    expect(longestPrefix(["flower", "flow", "flight"])).toBe("fl")
    expect(longestPrefix(["dog", "racecar", "car"])).toBe("")
    expect(longestPrefix(["interspecies", "interstellar", "interstate"])).toBe("inters")
    expect(longestPrefix(["same", "same", "same"])).toBe("same")
    expect(longestPrefix(["alone"])).toBe("alone")
    expect(longestPrefix(["", "abc"])).toBe("")
    var empty: List<string> = [""]
    empty.remove(0)
    expect(longestPrefix(empty)).toBe("")
}

test fn longest_suffix_of_lists() {
    expect(longestSuffix(["testing", "running", "jumping"])).toBe("ing")
    expect(longestSuffix(["abc", "def", "ghi"])).toBe("")
    expect(longestSuffix(["main.py", "util.py", "test.py"])).toBe(".py")
    expect(longestSuffix(["same", "same"])).toBe("same")
    expect(longestSuffix(["alone"])).toBe("alone")
    expect(longestSuffix(["abc", ""])).toBe("")
    var empty: List<string> = [""]
    empty.remove(0)
    expect(longestSuffix(empty)).toBe("")
}

test fn long_inputs() {
    let a200 = repeats("ab", 100)
    let b200 = repeats("ab", 100)
    let mixed = repeats("ab", 50) + repeats("cd", 50)
    expect(prefixLen(a200, b200)).toBe(200)
    expect(prefix(a200, b200)).toBe(a200)
    expect(suffixLen(a200, b200)).toBe(200)
    expect(prefixLen(a200, mixed)).toBe(100)
    expect(prefix(a200, mixed)).toBe(repeats("ab", 50))
    expect(longestPrefix([a200, b200, a200 + "x"])).toBe(a200)
}
