module std.text.table_test

import { render, renderAligned, renderSeparator, renderSeparatorAligned, renderBordered, widthsOf, columnCount, padTo, Align } from std.text.table

/// A width list rendered as space-separated decimals.
fn showInts(xs: List<int>) -> string {
    var out = ""
    var i = 0
    while (i < len(xs)) {
        if (i > 0) {
            out = out + " "
        }
        out = out + "{xs[i]}"
        i = i + 1
    }
    out
}

/// A typed empty row list.
fn noRows() -> List<List<string>> {
    var out: List<List<string>> = [[""]]
    out.remove(0)
    out
}

/// A typed empty header list.
fn noHeaders() -> List<string> {
    var out: List<string> = [""]
    out.remove(0)
    out
}

/// A typed empty alignment list.
fn noAligns() -> List<Align> {
    var out: List<Align> = [Align.AlignLeft]
    out.remove(0)
    out
}

test fn column_counts_and_widths() {
    let h: List<string> = ["Name", "Qty"]
    let r0: List<string> = ["apple", "10"]
    let r1: List<string> = ["kiwi", "5"]
    var rows: List<List<string>> = [r0]
    rows.push(r1)
    expect(columnCount(h, rows)).toBe(2)
    expect(showInts(widthsOf(h, rows))).toBe("5 3")
    let wide: List<string> = ["東京", "37000000"]
    var wrows: List<List<string>> = [wide]
    expect(showInts(widthsOf(h, wrows))).toBe("4 8")
    let three: List<string> = ["1", "2", "3"]
    var trows: List<List<string>> = [three]
    expect(columnCount(h, trows)).toBe(3)
}

test fn render_basic_table() {
    let h: List<string> = ["Name", "Qty"]
    let r0: List<string> = ["apple", "10"]
    let r1: List<string> = ["kiwi", "5"]
    var rows: List<List<string>> = [r0]
    rows.push(r1)
    expect(render(h, rows)).toBe("Name   Qty\napple  10\nkiwi   5\n")
}

test fn render_right_aligned_column() {
    let h: List<string> = ["Name", "Qty"]
    let r0: List<string> = ["apple", "10"]
    let r1: List<string> = ["kiwi", "5"]
    var rows: List<List<string>> = [r0]
    rows.push(r1)
    var aligns: List<Align> = [Align.AlignLeft]
    aligns.push(Align.AlignRight)
    expect(renderAligned(h, rows, aligns)).toBe("Name   Qty\napple   10\nkiwi     5\n")
}

test fn render_centered_column() {
    let h: List<string> = ["k", "value"]
    let r0: List<string> = ["a", "x"]
    let r1: List<string> = ["bb", "yy"]
    var rows: List<List<string>> = [r0]
    rows.push(r1)
    var aligns: List<Align> = [Align.AlignCenter]
    aligns.push(Align.AlignLeft)
    expect(renderAligned(h, rows, aligns)).toBe("k   value\na   x\nbb  yy\n")
}

test fn missing_alignments_default_left() {
    let h: List<string> = ["k", "value"]
    let r0: List<string> = ["a", "x"]
    var rows: List<List<string>> = [r0]
    var aligns: List<Align> = [Align.AlignCenter]
    expect(renderAligned(h, rows, aligns)).toBe("k  value\na  x\n")
}

test fn render_wide_characters() {
    let h: List<string> = ["city", "pop"]
    let r0: List<string> = ["東京", "37000000"]
    let r1: List<string> = ["Oslo", "709037"]
    var rows: List<List<string>> = [r0]
    rows.push(r1)
    expect(render(h, rows)).toBe("city  pop\n東京  37000000\nOslo  709037\n")
    expect(showInts(widthsOf(h, rows))).toBe("4 8")
}

test fn render_combining_marks() {
    let h: List<string> = ["g", "n"]
    let r0: List<string> = ["e\u{301}", "1"]
    var rows: List<List<string>> = [r0]
    expect(render(h, rows)).toBe("g  n\ne\u{301}  1\n")
}

test fn render_separator_table() {
    let h: List<string> = ["id", "name"]
    let r0: List<string> = ["1", "a"]
    let r1: List<string> = ["22", "bb"]
    var rows: List<List<string>> = [r0]
    rows.push(r1)
    expect(renderSeparator(h, rows)).toBe("id  name\n--  ----\n1   a\n22  bb\n")
}

test fn render_separator_with_alignment() {
    let h: List<string> = ["id", "name"]
    let r0: List<string> = ["1", "a"]
    let r1: List<string> = ["22", "bb"]
    var rows: List<List<string>> = [r0]
    rows.push(r1)
    var aligns: List<Align> = [Align.AlignRight]
    aligns.push(Align.AlignLeft)
    expect(renderSeparatorAligned(h, rows, aligns)).toBe("id  name\n--  ----\n 1  a\n22  bb\n")
}

test fn render_bordered_table() {
    let h: List<string> = ["a", "bb"]
    let r0: List<string> = ["x", "yy"]
    let r1: List<string> = ["zzz", "w"]
    var rows: List<List<string>> = [r0]
    rows.push(r1)
    expect(renderBordered(h, rows)).toBe("+-----+----+\n| a   | bb |\n+-----+----+\n| x   | yy |\n| zzz | w  |\n+-----+----+\n")
}

test fn short_rows_are_padded() {
    let h: List<string> = ["a", "b"]
    let r0: List<string> = ["only"]
    var rows: List<List<string>> = [r0]
    expect(renderSeparator(h, rows)).toBe("a     b\n----  -\nonly\n")
    expect(render(h, rows)).toBe("a     b\nonly\n")
}

test fn widest_row_adds_columns() {
    let h: List<string> = ["a", "b"]
    let r0: List<string> = ["1", "2", "3"]
    var rows: List<List<string>> = [r0]
    expect(render(h, rows)).toBe("a  b\n1  2  3\n")
    var bare = noRows()
    let only: List<string> = ["1", "2", "3"]
    bare.push(only)
    expect(render(noHeaders(), bare)).toBe("1  2  3\n")
}

test fn empty_tables_render_empty() {
    expect(render(noHeaders(), noRows())).toBe("")
    expect(renderSeparator(noHeaders(), noRows())).toBe("")
    expect(renderBordered(noHeaders(), noRows())).toBe("")
}

test fn header_only_table() {
    let h: List<string> = ["h"]
    expect(render(h, noRows())).toBe("h\n")
    expect(renderSeparator(h, noRows())).toBe("h\n-\n")
    expect(renderBordered(h, noRows())).toBe("+---+\n| h |\n+---+\n")
}

test fn pad_to_matches_alignment() {
    expect(padTo("xy", 5, Align.AlignLeft)).toBe("xy   ")
    expect(padTo("xy", 5, Align.AlignRight)).toBe("   xy")
    expect(padTo("xy", 5, Align.AlignCenter)).toBe(" xy  ")
    expect(padTo("toolong", 3, Align.AlignCenter)).toBe("toolong")
    expect(padTo("", 2, Align.AlignRight)).toBe("  ")
    expect(padTo("東", 4, Align.AlignLeft)).toBe("東  ")
}

test fn no_trailing_spaces() {
    let h: List<string> = ["a"]
    let r0: List<string> = ["long"]
    var rows: List<List<string>> = [r0]
    let out = render(h, rows)
    expect(out).toBe("a\nlong\n")
    let cells: List<string> = ["x", "y"]
    var one: List<List<string>> = [cells]
    expect(render(noHeaders(), one)).toBe("x  y\n")
    expect(renderSeparator(noHeaders(), one)).toBe("x  y\n")
}

test fn alignment_does_not_change_widths() {
    let h: List<string> = ["n", "v"]
    let r0: List<string> = ["1", "10"]
    let r1: List<string> = ["1000", "7"]
    var rows: List<List<string>> = [r0]
    rows.push(r1)
    var aligns: List<Align> = [Align.AlignRight]
    aligns.push(Align.AlignRight)
    expect(renderAligned(h, rows, aligns)).toBe("   n   v\n   1  10\n1000   7\n")
    expect(showInts(widthsOf(h, rows))).toBe("4 2")
}

test fn empty_cells_and_extra_aligns() {
    let h: List<string> = ["a", "b"]
    let r0: List<string> = ["", "x"]
    var rows: List<List<string>> = [r0]
    expect(render(h, rows)).toBe("a  b\n   x\n")
    var aligns = noAligns()
    aligns.push(Align.AlignRight)
    aligns.push(Align.AlignRight)
    aligns.push(Align.AlignRight)
    expect(renderAligned(h, rows, aligns)).toBe("a  b\n   x\n")
}
