module std.text.rot_test

import { caesar, rot13 } from std.text.rot

/// A string built by repeating `part` `times` times.
fn repeats(part: string, times: int) -> string {
    var out = ""
    var i = 0
    while (i < times) {
        out = out + part
        i = i + 1
    }
    out
}

test fn rot13_basics() {
    expect(rot13("")).toBe("")
    expect(rot13("abc")).toBe("nop")
    expect(rot13("nop")).toBe("abc")
    expect(rot13("ABC")).toBe("NOP")
    expect(rot13("Hello")).toBe("Uryyb")
    expect(rot13("Uryyb")).toBe("Hello")
}

test fn rot13_is_self_inverse() {
    let samples = ["", "a", "z", "Hello, World!", "The Quick Brown Fox", "PickleScript 123", "café"]
    var i = 0
    while (i < len(samples)) {
        let s = samples[i]
        expect(rot13(rot13(s))).toBe(s)
        i = i + 1
    }
}

test fn caesar_shifts() {
    expect(caesar("abc", 1)).toBe("bcd")
    expect(caesar("abc", 3)).toBe("def")
    expect(caesar("xyz", 3)).toBe("abc")
    expect(caesar("XYZ", 3)).toBe("ABC")
    expect(caesar("Hello", 5)).toBe("Mjqqt")
    expect(caesar("abc", 0)).toBe("abc")
    expect(caesar("abc", 26)).toBe("abc")
    expect(caesar("abc", 52)).toBe("abc")
}

test fn negative_and_large_shifts() {
    expect(caesar("bcd", -1)).toBe("abc")
    expect(caesar("def", -3)).toBe("abc")
    expect(caesar("abc", -3)).toBe("xyz")
    expect(caesar("abc", 29)).toBe("def")
    expect(caesar("abc", -29)).toBe("xyz")
    expect(caesar("The Quick Brown Fox", -5)).toBe("Ocz Lpdxf Wmjri Ajs")
}

test fn non_letters_are_unchanged() {
    expect(caesar("Hello, World! 123", 13)).toBe("Uryyb, Jbeyq! 123")
    expect(caesar("a-b_c.d/e", 1)).toBe("b-c_d.e/f")
    expect(caesar(" \t\n", 7)).toBe(" \t\n")
    expect(rot13("12345 !?@#")).toBe("12345 !?@#")
}

test fn preserves_case() {
    expect(caesar("aBcXyZ", 2)).toBe("cDeZaB")
    expect(rot13("AbCdEfGhIjKlMnOpQrStUvWxYz")).toBe("NoPqRsTuVwXyZaBcDeFgHiJkLm")
}

test fn byte_semantics_for_unicode() {
    // Non-ASCII UTF-8 bytes are not A-Z/a-z and must pass through unchanged.
    expect(caesar("café", 13)).toBe("pnsé")
    expect(rot13("café")).toBe("pnsé")
    expect(rot13(rot13("héllo naïve"))).toBe("héllo naïve")
}

test fn long_inputs() {
    let a200 = repeats("a", 200)
    let n200 = repeats("n", 200)
    expect(rot13(a200)).toBe(n200)
    expect(rot13(n200)).toBe(a200)
    expect(caesar(repeats("Ab", 100), 1)).toBe(repeats("Bc", 100))
}
