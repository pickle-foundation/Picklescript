module std.math.ipow_test

import { pow, isPowerOfTwo } from std.math.ipow

test fn base_cases() {
    expect(pow(0, 0)).toBe(1)
    expect(pow(0, 1)).toBe(0)
    expect(pow(0, 5)).toBe(0)
    expect(pow(1, 0)).toBe(1)
    expect(pow(1, 10)).toBe(1)
    expect(pow(5, 0)).toBe(1)
    expect(pow(5, 1)).toBe(5)
}

test fn positive_powers() {
    expect(pow(2, 1)).toBe(2)
    expect(pow(2, 10)).toBe(1024)
    expect(pow(2, 30)).toBe(1073741824)
    expect(pow(3, 5)).toBe(243)
    expect(pow(10, 6)).toBe(1000000)
    expect(pow(7, 7)).toBe(823543)
    expect(pow(13, 4)).toBe(28561)
}

test fn negative_bases() {
    expect(pow(-1, 0)).toBe(1)
    expect(pow(-1, 1)).toBe(-1)
    expect(pow(-1, 2)).toBe(1)
    expect(pow(-1, 9)).toBe(-1)
    expect(pow(-2, 3)).toBe(-8)
    expect(pow(-2, 4)).toBe(16)
    expect(pow(-3, 5)).toBe(-243)
}

test fn negative_exponents() {
    expect(pow(2, -1)).toBe(0)
    expect(pow(10, -3)).toBe(0)
    expect(pow(-2, -2)).toBe(0)
}

test fn powers_of_two() {
    expect(isPowerOfTwo(1)).toBe(true)
    expect(isPowerOfTwo(2)).toBe(true)
    expect(isPowerOfTwo(4)).toBe(true)
    expect(isPowerOfTwo(8)).toBe(true)
    expect(isPowerOfTwo(1024)).toBe(true)
    expect(isPowerOfTwo(1073741824)).toBe(true)
    expect(isPowerOfTwo(0)).toBe(false)
    expect(isPowerOfTwo(-2)).toBe(false)
    expect(isPowerOfTwo(3)).toBe(false)
    expect(isPowerOfTwo(6)).toBe(false)
    expect(isPowerOfTwo(1023)).toBe(false)
}

test fn consistency() {
    var base = 1
    while (base <= 5) {
        var exp = 0
        var val = 1
        while (exp <= 10) {
            expect(pow(base, exp)).toBe(val)
            val = val * base
            exp = exp + 1
        }
        base = base + 1
    }
    expect(pow(2, 20)).toBe(1048576)
    expect(isPowerOfTwo(pow(2, 20))).toBe(true)
    expect(isPowerOfTwo(pow(2, 20) - 1)).toBe(false)
}
