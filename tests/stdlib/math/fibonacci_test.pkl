module std.math.fibonacci_test

import { fib, sequence, isFib } from std.math.fibonacci

/// An int list rendered as `[0, 1, 1]`.
fn showInts(xs: List<int>) -> string {
    var out = "["
    var i = 0
    while (i < len(xs)) {
        if (i > 0) {
            out = out + ", "
        }
        out = out + "{xs[i]}"
        i = i + 1
    }
    out + "]"
}

test fn base_cases() {
    expect(fib(0)).toBe(0)
    expect(fib(1)).toBe(1)
    expect(fib(2)).toBe(1)
    expect(fib(3)).toBe(2)
    expect(fib(4)).toBe(3)
    expect(fib(5)).toBe(5)
    expect(fib(6)).toBe(8)
}

test fn known_values() {
    expect(fib(10)).toBe(55)
    expect(fib(12)).toBe(144)
    expect(fib(20)).toBe(6765)
    expect(fib(30)).toBe(832040)
    expect(fib(40)).toBe(102334155)
    expect(fib(50)).toBe(12586269025)
}

test fn negative_index() {
    expect(fib(-1)).toBe(-1)
    expect(fib(-5)).toBe(-1)
    expect(fib(-100)).toBe(-1)
}

test fn sequences() {
    expect(showInts(sequence(0))).toBe("[]")
    expect(showInts(sequence(-1))).toBe("[]")
    expect(showInts(sequence(1))).toBe("[0]")
    expect(showInts(sequence(2))).toBe("[0, 1]")
    expect(showInts(sequence(8))).toBe("[0, 1, 1, 2, 3, 5, 8, 13]")
    let s11 = sequence(11)
    expect(len(s11)).toBe(11)
    expect(s11[10]).toBe(55)
}

test fn sequence_matches_fib() {
    let seq = sequence(21)
    expect(len(seq)).toBe(21)
    var i = 0
    while (i < len(seq)) {
        expect(seq[i]).toBe(fib(i))
        i = i + 1
    }
}

test fn membership() {
    expect(isFib(0)).toBe(true)
    expect(isFib(1)).toBe(true)
    expect(isFib(2)).toBe(true)
    expect(isFib(3)).toBe(true)
    expect(isFib(5)).toBe(true)
    expect(isFib(8)).toBe(true)
    expect(isFib(13)).toBe(true)
    expect(isFib(21)).toBe(true)
    expect(isFib(55)).toBe(true)
    expect(isFib(12586269025)).toBe(true)
    expect(isFib(-1)).toBe(false)
    expect(isFib(4)).toBe(false)
    expect(isFib(6)).toBe(false)
    expect(isFib(7)).toBe(false)
    expect(isFib(9)).toBe(false)
    expect(isFib(10)).toBe(false)
    expect(isFib(54)).toBe(false)
    expect(isFib(56)).toBe(false)
}
