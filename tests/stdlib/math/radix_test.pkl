module std.math.radix_test

import { validBase, toBase, toBaseUpper, toBasePadded, fromBase, binary, octal, hexOf, fromBinary, fromOctal, fromHex, parsePrefixed, digitCount, bitLength } from std.math.radix

/// A rendered optional string (`<none>` for `none`).
fn showS(x: string?) -> string {
    match (x) {
    case some(v) -> v
    case none -> "<none>"
    }
}

/// A rendered optional `int` (`<none>` for `none`).
fn showI(x: int?) -> string {
    match (x) {
    case some(v) -> "{v}"
    case none -> "<none>"
    }
}

test fn common_bases() {
    expect(showS(toBase(0, 10))).toBe("0")
    expect(showS(toBase(7, 10))).toBe("7")
    expect(showS(toBase(255, 10))).toBe("255")
    expect(showS(toBase(255, 16))).toBe("ff")
    expect(showS(toBase(255, 2))).toBe("11111111")
    expect(showS(toBase(255, 8))).toBe("377")
    expect(showS(toBase(1000, 7))).toBe("2626")
    expect(showS(toBase(1000000, 16))).toBe("f4240")
}

test fn letters_and_case() {
    expect(showS(toBase(10, 36))).toBe("a")
    expect(showS(toBase(35, 36))).toBe("z")
    expect(showS(toBase(36, 36))).toBe("10")
    expect(showS(toBase(1679615, 36))).toBe("zzzz")
    expect(showS(toBaseUpper(255, 16))).toBe("FF")
    expect(showS(toBaseUpper(35, 36))).toBe("Z")
    expect(showS(toBaseUpper(0, 2))).toBe("0")
}

test fn negative_values_keep_their_sign() {
    expect(showS(toBase(-1, 10))).toBe("-1")
    expect(showS(toBase(-255, 16))).toBe("-ff")
    expect(showS(toBase(-5, 2))).toBe("-101")
    expect(showS(toBase(-36, 36))).toBe("-10")
    expect(showS(toBaseUpper(-255, 16))).toBe("-FF")
}

test fn unsupported_bases_are_rejected() {
    expect(validBase(1)).toBe(false)
    expect(validBase(0)).toBe(false)
    expect(validBase(-4)).toBe(false)
    expect(validBase(37)).toBe(false)
    expect(validBase(2)).toBe(true)
    expect(validBase(36)).toBe(true)
    expect(showS(toBase(5, 1))).toBe("<none>")
    expect(showS(toBase(5, 37))).toBe("<none>")
    expect(showS(toBaseUpper(5, 0))).toBe("<none>")
    expect(showS(toBasePadded(5, 1, 3))).toBe("<none>")
    expect(showI(fromBase("5", 1))).toBe("<none>")
    expect(showI(fromBase("5", 37))).toBe("<none>")
    expect(showI(digitCount(5, 40))).toBe("<none>")
}

test fn parsing_accepts_either_case() {
    expect(showI(fromBase("ff", 16))).toBe("255")
    expect(showI(fromBase("FF", 16))).toBe("255")
    expect(showI(fromBase("Ff", 16))).toBe("255")
    expect(showI(fromBase("z", 36))).toBe("35")
    expect(showI(fromBase("10", 36))).toBe("36")
    expect(showI(fromBase("101", 2))).toBe("5")
    expect(showI(fromBase("0", 7))).toBe("0")
    expect(showI(fromBase("-ff", 16))).toBe("-255")
    expect(showI(fromBase("zzzz", 36))).toBe("1679615")
}

test fn parsing_rejects_bad_text() {
    expect(showI(fromBase("", 10))).toBe("<none>")
    expect(showI(fromBase("-", 10))).toBe("<none>")
    expect(showI(fromBase("12", 2))).toBe("<none>")
    expect(showI(fromBase("8", 8))).toBe("<none>")
    expect(showI(fromBase("g", 16))).toBe("<none>")
    expect(showI(fromBase("12a", 10))).toBe("<none>")
    expect(showI(fromBase(" 12", 10))).toBe("<none>")
    expect(showI(fromBase("+12", 10))).toBe("<none>")
    expect(showI(fromBase("1-2", 10))).toBe("<none>")
}

test fn round_trip_sweep_over_bases() {
    let bases = [2, 3, 7, 8, 10, 16, 36]
    var bad = 0
    var bi = 0
    while (bi < len(bases)) {
        let base = bases[bi]
        var n = 0 - 500
        while (n <= 500) {
            if (let some(s) = toBase(n, base)) {
                if (let some(v) = fromBase(s, base)) {
                    if (v != n) {
                        bad = bad + 1
                    }
                } else {
                    bad = bad + 1
                }
            } else {
                bad = bad + 1
            }
            n = n + 1
        }
        bi = bi + 1
    }
    expect(bad).toBe(0)
}

test fn convenience_renderers() {
    expect(binary(0)).toBe("0")
    expect(binary(10)).toBe("1010")
    expect(binary(-1)).toBe("-1")
    expect(binary(255)).toBe("11111111")
    expect(octal(8)).toBe("10")
    expect(octal(511)).toBe("777")
    expect(octal(-8)).toBe("-10")
    expect(hexOf(255)).toBe("ff")
    expect(hexOf(-16)).toBe("-10")
    expect(hexOf(0)).toBe("0")
}

test fn convenience_parsers() {
    expect(showI(fromBinary("1010"))).toBe("10")
    expect(showI(fromOctal("777"))).toBe("511")
    expect(showI(fromHex("dead"))).toBe("57005")
    expect(showI(fromHex("DEAD"))).toBe("57005")
    expect(showI(fromBinary("102"))).toBe("<none>")
    expect(showI(fromHex("xyz"))).toBe("<none>")
}

test fn prefixed_literals() {
    expect(showI(parsePrefixed("255"))).toBe("255")
    expect(showI(parsePrefixed("-42"))).toBe("-42")
    expect(showI(parsePrefixed("0xff"))).toBe("255")
    expect(showI(parsePrefixed("0XFF"))).toBe("255")
    expect(showI(parsePrefixed("-0x10"))).toBe("-16")
    expect(showI(parsePrefixed("0b101"))).toBe("5")
    expect(showI(parsePrefixed("0B11"))).toBe("3")
    expect(showI(parsePrefixed("0o17"))).toBe("15")
    expect(showI(parsePrefixed("0O777"))).toBe("511")
    expect(showI(parsePrefixed("0"))).toBe("0")
    expect(showI(parsePrefixed("00"))).toBe("0")
    expect(showI(parsePrefixed("0z9"))).toBe("<none>")
}

test fn prefixed_literals_reject_bad_digits() {
    expect(showI(parsePrefixed(""))).toBe("<none>")
    expect(showI(parsePrefixed("-"))).toBe("<none>")
    expect(showI(parsePrefixed("0x"))).toBe("<none>")
    expect(showI(parsePrefixed("0b2"))).toBe("<none>")
    expect(showI(parsePrefixed("0o8"))).toBe("<none>")
    expect(showI(parsePrefixed("0xg"))).toBe("<none>")
    expect(showI(parsePrefixed("-0x"))).toBe("<none>")
}

test fn padded_rendering() {
    expect(showS(toBasePadded(255, 16, 4))).toBe("00ff")
    expect(showS(toBasePadded(255, 16, 2))).toBe("ff")
    expect(showS(toBasePadded(255, 16, 1))).toBe("ff")
    expect(showS(toBasePadded(5, 2, 8))).toBe("00000101")
    expect(showS(toBasePadded(-255, 16, 4))).toBe("-00ff")
    expect(showS(toBasePadded(0, 10, 3))).toBe("000")
    expect(showS(toBasePadded(0, 10, 0))).toBe("0")
}

test fn digit_counts() {
    expect(showI(digitCount(0, 10))).toBe("1")
    expect(showI(digitCount(9, 10))).toBe("1")
    expect(showI(digitCount(10, 10))).toBe("2")
    expect(showI(digitCount(999, 10))).toBe("3")
    expect(showI(digitCount(-1000, 10))).toBe("4")
    expect(showI(digitCount(255, 16))).toBe("2")
    expect(showI(digitCount(7, 2))).toBe("3")
    expect(showI(digitCount(1679615, 36))).toBe("4")
}

test fn bit_lengths() {
    expect(bitLength(0)).toBe(0)
    expect(bitLength(1)).toBe(1)
    expect(bitLength(2)).toBe(2)
    expect(bitLength(3)).toBe(2)
    expect(bitLength(255)).toBe(8)
    expect(bitLength(256)).toBe(9)
    expect(bitLength(-256)).toBe(9)
    expect(bitLength(-1)).toBe(1)
}

test fn large_magnitudes_stay_exact() {
    expect(showS(toBase(1099511627776, 16))).toBe("10000000000")
    expect(showI(fromBase("10000000000", 16))).toBe("1099511627776")
    let bits = showS(toBase(0 - 1099511627776, 2))
    let bs = bytes(bits)
    expect(len(bs)).toBe(42)
    expect(bs[0] as int).toBe(45)
    expect(bs[1] as int).toBe(49)
    expect(showI(fromBase(bits, 2))).toBe("-1099511627776")
}

test fn digit_count_matches_rendering() {
    var bad = 0
    var n = 0
    while (n <= 500) {
        if (let some(count) = digitCount(n, 16)) {
            if (let some(s) = toBase(n, 16)) {
                if (count != len(bytes(s))) {
                    bad = bad + 1
                }
            } else {
                bad = bad + 1
            }
        } else {
            bad = bad + 1
        }
        n = n + 1
    }
    expect(bad).toBe(0)
}
