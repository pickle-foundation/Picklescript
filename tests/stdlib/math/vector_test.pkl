module std.math.vector_test

import { length, isEmpty, copyOf, zeros, ones, get, add, sub, scale, sum, dot, cross, normSquared, norm, distanceSquared, distance, normalize, blend, approxEq, render } from std.math.vector

/// A typed empty vector.
fn noVec() -> List<float> {
    var out: List<float> = [0.0]
    out.remove(0)
    out
}

/// A rendered optional vector (`<none>` for `none`).
fn showVec(v: List<float>?) -> string {
    match (v) {
    case some(x) -> render(x)
    case none -> "<none>"
    }
}

/// A rendered optional float (`<none>` for `none`).
fn showFloat(x: float?) -> string {
    match (x) {
    case some(v) -> "{v}"
    case none -> "<none>"
    }
}

/// A rendered optional component (`<none>` for `none`).
fn showGet(v: List<float>, i: int) -> string {
    match (get(v, i)) {
    case some(x) -> "{x}"
    case none -> "<none>"
    }
}

test fn lengths_and_emptiness() {
    let v: List<float> = [1.0, 2.0, 3.0]
    expect(length(v)).toBe(3)
    expect(isEmpty(v)).toBe(false)
    expect(length(noVec())).toBe(0)
    expect(isEmpty(noVec())).toBe(true)
}

test fn construction_helpers() {
    expect(showVec(zeros(3))).toBe("[0, 0, 0]")
    expect(showVec(zeros(0))).toBe("[]")
    expect(showVec(zeros(-1))).toBe("<none>")
    expect(showVec(ones(2))).toBe("[1, 1]")
    expect(showVec(ones(0))).toBe("[]")
    expect(showVec(ones(-2))).toBe("<none>")
}

test fn component_access() {
    let v: List<float> = [1.5, -2.0]
    expect(showGet(v, 0)).toBe("1.5")
    expect(showGet(v, 1)).toBe("-2")
    expect(showGet(v, 2)).toBe("<none>")
    expect(showGet(v, -1)).toBe("<none>")
    expect(showGet(noVec(), 0)).toBe("<none>")
}

test fn copy_is_independent() {
    let v: List<float> = [1.0, 2.0]
    var c = copyOf(v)
    c[0] = 9.0
    expect(render(c)).toBe("[9, 2]")
    expect(render(v)).toBe("[1, 2]")
}

test fn addition_and_subtraction() {
    let a: List<float> = [1.0, 2.0, 3.0]
    let b: List<float> = [0.5, 0.25, 0.125]
    expect(showVec(add(a, b))).toBe("[1.5, 2.25, 3.125]")
    expect(showVec(sub(a, b))).toBe("[0.5, 1.75, 2.875]")
    let short: List<float> = [1.0, 2.0]
    expect(showVec(add(a, short))).toBe("<none>")
    expect(showVec(sub(short, a))).toBe("<none>")
    expect(showVec(add(noVec(), noVec()))).toBe("[]")
}

test fn scaling_and_sum() {
    let v: List<float> = [1.0, -2.0, 4.0]
    expect(render(scale(v, 2.0))).toBe("[2, -4, 8]")
    expect(render(scale(v, 0.5))).toBe("[0.5, -1, 2]")
    let positive: List<float> = [1.0, 2.0, 4.0]
    expect(render(scale(positive, 0.0))).toBe("[0, 0, 0]")
    expect(sum(v)).toBe(3.0)
    expect(sum(noVec())).toBe(0.0)
    expect(render(scale(noVec(), 5.0))).toBe("[]")
}

test fn dot_products() {
    let a: List<float> = [1.0, 2.0, 3.0]
    let b: List<float> = [4.0, 5.0, 6.0]
    expect(showFloat(dot(a, b))).toBe("32")
    expect(showFloat(dot(a, noVec()))).toBe("<none>")
    expect(showFloat(dot(noVec(), noVec()))).toBe("0")
    expect(showFloat(dot(a, a))).toBe("14")
    let short: List<float> = [1.0]
    expect(showFloat(dot(a, short))).toBe("<none>")
}

test fn cross_products() {
    let x: List<float> = [1.0, 0.0, 0.0]
    let y: List<float> = [0.0, 1.0, 0.0]
    expect(showVec(cross(x, y))).toBe("[0, 0, 1]")
    expect(showVec(cross(y, x))).toBe("[0, 0, -1]")
    expect(showVec(cross(x, x))).toBe("[0, 0, 0]")
    let a: List<float> = [1.0, 2.0, 3.0]
    let b: List<float> = [4.0, 5.0, 6.0]
    expect(showVec(cross(a, b))).toBe("[-3, 6, -3]")
    let flat: List<float> = [1.0, 2.0]
    expect(showVec(cross(a, flat))).toBe("<none>")
    expect(showVec(cross(flat, flat))).toBe("<none>")
}

test fn magnitudes() {
    let v: List<float> = [3.0, 4.0]
    expect(normSquared(v)).toBe(25.0)
    expect(norm(v)).toBe(5.0)
    expect(norm(noVec())).toBe(0.0)
    let z: List<float> = [0.0, 0.0]
    expect(norm(z)).toBe(0.0)
    let one: List<float> = [1.0, 0.0]
    expect(norm(one)).toBe(1.0)
    expect(normSquared(noVec())).toBe(0.0)
}

test fn distances() {
    let a: List<float> = [0.0, 0.0]
    let b: List<float> = [3.0, 4.0]
    expect(showFloat(distanceSquared(a, b))).toBe("25")
    expect(showFloat(distance(a, b))).toBe("5")
    expect(showFloat(distance(b, a))).toBe("5")
    expect(showFloat(distance(a, a))).toBe("0")
    let c: List<float> = [1.0]
    expect(showFloat(distanceSquared(a, c))).toBe("<none>")
    expect(showFloat(distance(a, c))).toBe("<none>")
}

test fn normalization() {
    let v: List<float> = [3.0, 4.0]
    let u = normalize(v)
    match (u) {
    case some(x) -> {
        expect(render(x)).toBe("[0.6, 0.8]")
    }
    case none -> expect(false).toBe(true)
    }
    let z: List<float> = [0.0, 0.0, 0.0]
    expect(showVec(normalize(z))).toBe("<none>")
    expect(showVec(normalize(noVec()))).toBe("<none>")
    let unit: List<float> = [2.0, 0.0]
    expect(showVec(normalize(unit))).toBe("[1, 0]")
}

test fn blending() {
    let a: List<float> = [0.0, 0.0]
    let b: List<float> = [10.0, 20.0]
    expect(showVec(blend(a, b, 0.5))).toBe("[5, 10]")
    expect(showVec(blend(a, b, 0.0))).toBe("[0, 0]")
    expect(showVec(blend(a, b, 1.0))).toBe("[10, 20]")
    expect(showVec(blend(a, b, 2.0))).toBe("[20, 40]")
    expect(showVec(blend(a, b, -0.5))).toBe("[-5, -10]")
    let short: List<float> = [1.0]
    expect(showVec(blend(a, short, 0.5))).toBe("<none>")
}

test fn approximate_equality() {
    let a: List<float> = [1.0, 2.0]
    let b: List<float> = [1.0, 2.0]
    let c: List<float> = [1.0, 2.25]
    expect(approxEq(a, b, 0.0)).toBe(true)
    expect(approxEq(a, c, 0.2)).toBe(false)
    expect(approxEq(a, c, 0.25)).toBe(true)
    let short: List<float> = [1.0]
    expect(approxEq(a, short, 10.0)).toBe(false)
    expect(approxEq(noVec(), noVec(), 0.0)).toBe(true)
}

test fn rendering() {
    expect(render(noVec())).toBe("[]")
    let v: List<float> = [1.0, 2.0, 3.0]
    expect(render(v)).toBe("[1, 2, 3]")
    let frac: List<float> = [0.5, -0.25]
    expect(render(frac)).toBe("[0.5, -0.25]")
    expect(render(scale(v, 1.0))).toBe("[1, 2, 3]")
}

test fn standard_basis_norm_is_one() {
    let e0: List<float> = [1.0, 0.0, 0.0]
    let e1: List<float> = [0.0, 1.0, 0.0]
    let e2: List<float> = [0.0, 0.0, 1.0]
    expect(norm(e0)).toBe(1.0)
    expect(norm(e1)).toBe(1.0)
    expect(norm(e2)).toBe(1.0)
    expect(showFloat(dot(e0, e1))).toBe("0")
    expect(showVec(cross(e1, e2))).toBe("[1, 0, 0]")
    expect(showVec(cross(e2, e0))).toBe("[0, 1, 0]")
}
