module std.math.polynomial_test

import { zero, one, constant, of, monomial, trim, degree, coeffAt, leading, isZero, add, sub, neg, scale, mul, evaluate, derivative, fromRoots, equals, render } from std.math.polynomial

test fn canonical_zero() {
    expect(isZero(zero())).toBe(true)
    expect(degree(zero())).toBe(-1)
    expect(leading(zero())).toBe(0)
    expect(coeffAt(zero(), 0)).toBe(0)
    expect(coeffAt(zero(), 7)).toBe(0)
    expect(render(zero())).toBe("0")
    expect(isZero(constant(0))).toBe(true)
    expect(isZero(of([0, 0, 0]))).toBe(true)
}

test fn construction_canonicalizes() {
    let p = of([1, 2, 3])
    expect(degree(p)).toBe(2)
    expect(coeffAt(p, 0)).toBe(1)
    expect(coeffAt(p, 1)).toBe(2)
    expect(coeffAt(p, 2)).toBe(3)
    expect(coeffAt(p, 3)).toBe(0)
    expect(degree(of([5, 0, 0]))).toBe(0)
    expect(leading(of([5, 0, 0]))).toBe(5)
    expect(leading(of([1, 2, 3]))).toBe(3)
    expect(degree(one())).toBe(0)
    expect(leading(one())).toBe(1)
    expect(equals(of([4, 0]), constant(4))).toBe(true)
}

test fn trimming() {
    let p = trim(of([1, 2, 3]))
    expect(equals(p, of([1, 2, 3]))).toBe(true)
    expect(equals(trim(of([1, 0, 0])), constant(1))).toBe(true)
    expect(equals(trim(zero()), zero())).toBe(true)
}

test fn monomials() {
    expect(equals(monomial(3, 2), of([0, 0, 3]))).toBe(true)
    expect(equals(monomial(1, 0), one())).toBe(true)
    expect(equals(monomial(0, 4), zero())).toBe(true)
    expect(equals(monomial(5, -1), zero())).toBe(true)
    expect(degree(monomial(1, 9))).toBe(9)
}

test fn addition_and_subtraction() {
    let a = of([1, 2])
    let b = of([3, 4, 5])
    expect(equals(add(a, b), of([4, 6, 5]))).toBe(true)
    expect(equals(add(a, a), of([2, 4]))).toBe(true)
    expect(equals(add(a, neg(a)), zero())).toBe(true)
    expect(equals(sub(b, a), of([2, 2, 5]))).toBe(true)
    expect(equals(sub(a, a), zero())).toBe(true)
    expect(equals(add(zero(), a), a)).toBe(true)
    expect(equals(sub(a, zero()), a)).toBe(true)
}

test fn scaling_and_negation() {
    let a = of([1, -2, 3])
    expect(equals(scale(a, 2), of([2, -4, 6]))).toBe(true)
    expect(equals(scale(a, 0), zero())).toBe(true)
    expect(equals(scale(a, -1), neg(a))).toBe(true)
    expect(equals(neg(neg(a)), a)).toBe(true)
    expect(equals(neg(zero()), zero())).toBe(true)
}

test fn multiplication() {
    expect(equals(mul(of([1, 1]), of([1, -1])), of([1, 0, -1]))).toBe(true)
    expect(equals(mul(of([1, 1]), of([1, 1])), of([1, 2, 1]))).toBe(true)
    expect(equals(mul(one(), of([3, -4])), of([3, -4]))).toBe(true)
    expect(equals(mul(zero(), of([3, -4])), zero())).toBe(true)
    expect(equals(mul(constant(3), of([1, 2])), of([3, 6]))).toBe(true)
    expect(equals(mul(monomial(1, 2), monomial(1, 3)), monomial(1, 5))).toBe(true)
    expect(degree(mul(of([1, 2, 3]), of([4, 5])))).toBe(3)
}

test fn evaluation_by_horner() {
    let p = of([1, 2, 3])
    expect(evaluate(p, 0)).toBe(1)
    expect(evaluate(p, 1)).toBe(6)
    expect(evaluate(p, 2)).toBe(17)
    expect(evaluate(p, -1)).toBe(2)
    expect(evaluate(p, -2)).toBe(9)
    expect(evaluate(zero(), 5)).toBe(0)
    expect(evaluate(constant(7), 5)).toBe(7)
    expect(evaluate(monomial(1, 3), -2)).toBe(-8)
}

test fn derivative_rules() {
    expect(equals(derivative(of([5])), zero())).toBe(true)
    expect(equals(derivative(zero()), zero())).toBe(true)
    expect(equals(derivative(of([1, 2, 3])), of([2, 6]))).toBe(true)
    expect(equals(derivative(of([0, 0, 0, 4])), of([0, 0, 12]))).toBe(true)
    expect(equals(derivative(one()), zero())).toBe(true)
    expect(equals(derivative(monomial(7, 1)), constant(7))).toBe(true)
}

test fn roots_and_factorization() {
    let p = fromRoots([1, 2])
    expect(equals(p, of([2, -3, 1]))).toBe(true)
    expect(evaluate(p, 1)).toBe(0)
    expect(evaluate(p, 2)).toBe(0)
    expect(equals(fromRoots([0]), of([0, 1]))).toBe(true)
    expect(equals(fromRoots([0, 0]), of([0, 0, 1]))).toBe(true)
    expect(equals(fromRoots([0 - 3]), of([3, 1]))).toBe(true)
    expect(equals(fromRoots([0]), monomial(1, 1))).toBe(true)
}

test fn equality_is_structural() {
    expect(equals(of([1, 2]), of([1, 2]))).toBe(true)
    expect(equals(of([1, 2]), of([1, 2, 0]))).toBe(true)
    expect(equals(of([1, 2]), of([2, 1]))).toBe(false)
    expect(equals(of([1, 2]), of([1]))).toBe(false)
    expect(equals(zero(), constant(0))).toBe(true)
}

test fn rendering() {
    expect(render(of([1, -2, 3]))).toBe("3x^2 - 2x + 1")
    expect(render(of([1, 0, -1]))).toBe("-x^2 + 1")
    expect(render(of([-5]))).toBe("-5")
    expect(render(of([0, 1]))).toBe("x")
    expect(render(of([0, -1]))).toBe("-x")
    expect(render(of([1, 2]))).toBe("2x + 1")
    expect(render(of([-1, -2]))).toBe("-2x - 1")
    expect(render(of([3]))).toBe("3")
    expect(render(one())).toBe("1")
    expect(render(monomial(1, 4))).toBe("x^4")
    expect(render(monomial(-1, 10))).toBe("-x^10")
    expect(render(of([0, 0, 0]))).toBe("0")
    expect(render(fromRoots([1, 2]))).toBe("x^2 - 3x + 2")
}

test fn product_and_sum_rules_hold_on_a_grid() {
    let a = of([1, 2, 3])
    let b = of([-2, 0, 4])
    var bad = 0
    var x = -3
    while (x <= 3) {
        if (evaluate(mul(a, b), x) != evaluate(a, x) * evaluate(b, x)) {
            bad = bad + 1
        }
        if (evaluate(add(a, b), x) != evaluate(a, x) + evaluate(b, x)) {
            bad = bad + 1
        }
        if (evaluate(derivative(a), x) != 2 + 6 * x) {
            bad = bad + 1
        }
        x = x + 1
    }
    expect(bad).toBe(0)
}
