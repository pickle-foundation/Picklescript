module std.math.combinatorics_test

import { factorial, binomial, permutations, multinomial, catalan, derangements, stirlingSecond, stirlingFirst, bell, partitionCount } from std.math.combinatorics

/// A rendered optional `int` (`<none>` for `none`).
fn showI(x: int?) -> string {
    match (x) {
    case some(v) -> "{v}"
    case none -> "<none>"
    }
}

/// The value of an optional `int`, or 0 for `none`.
fn just(x: int?) -> int {
    match (x) {
    case some(v) -> v
    case none -> 0
    }
}

test fn factorials() {
    expect(showI(factorial(0))).toBe("1")
    expect(showI(factorial(1))).toBe("1")
    expect(showI(factorial(2))).toBe("2")
    expect(showI(factorial(5))).toBe("120")
    expect(showI(factorial(10))).toBe("3628800")
    expect(showI(factorial(13))).toBe("6227020800")
    expect(showI(factorial(20))).toBe("2432902008176640000")
}

test fn factorial_rejects_negative_input() {
    expect(showI(factorial(-1))).toBe("<none>")
    expect(showI(factorial(-20))).toBe("<none>")
}

test fn binomial_coefficients() {
    expect(showI(binomial(0, 0))).toBe("1")
    expect(showI(binomial(5, 0))).toBe("1")
    expect(showI(binomial(5, 1))).toBe("5")
    expect(showI(binomial(5, 2))).toBe("10")
    expect(showI(binomial(5, 5))).toBe("1")
    expect(showI(binomial(10, 5))).toBe("252")
    expect(showI(binomial(20, 10))).toBe("184756")
    expect(showI(binomial(30, 15))).toBe("155117520")
    expect(showI(binomial(40, 20))).toBe("137846528820")
    expect(showI(binomial(60, 30))).toBe("118264581564861424")
}

test fn binomial_is_symmetric() {
    var bad = 0
    var n = 0
    while (n <= 20) {
        var k = 0
        while (k <= n) {
            if (just(binomial(n, k)) != just(binomial(n, n - k))) {
                bad = bad + 1
            }
            k = k + 1
        }
        n = n + 1
    }
    expect(bad).toBe(0)
}

test fn binomial_rejects_out_of_range() {
    expect(showI(binomial(-1, 0))).toBe("<none>")
    expect(showI(binomial(5, -1))).toBe("<none>")
    expect(showI(binomial(5, 6))).toBe("<none>")
    expect(showI(binomial(0, 1))).toBe("<none>")
}

test fn permutation_counts() {
    expect(showI(permutations(0, 0))).toBe("1")
    expect(showI(permutations(5, 0))).toBe("1")
    expect(showI(permutations(5, 2))).toBe("20")
    expect(showI(permutations(5, 5))).toBe("120")
    expect(showI(permutations(10, 3))).toBe("720")
    expect(showI(permutations(20, 20))).toBe("2432902008176640000")
    expect(showI(permutations(5, 6))).toBe("<none>")
    expect(showI(permutations(-1, 0))).toBe("<none>")
}

/// A typed empty list of parts.
fn noParts() -> List<int> {
    var out: List<int> = [0]
    out.remove(0)
    out
}

test fn multinomial_coefficients() {
    expect(showI(multinomial(noParts()))).toBe("1")
    expect(showI(multinomial([5]))).toBe("1")
    expect(showI(multinomial([2, 1, 1]))).toBe("12")
    expect(showI(multinomial([3, 2]))).toBe("10")
    expect(showI(multinomial([1, 1, 1, 1]))).toBe("24")
    expect(showI(multinomial([2, 0, 1]))).toBe("3")
    expect(showI(multinomial([2, -1]))).toBe("<none>")
}

test fn catalan_numbers() {
    expect(showI(catalan(0))).toBe("1")
    expect(showI(catalan(1))).toBe("1")
    expect(showI(catalan(2))).toBe("2")
    expect(showI(catalan(3))).toBe("5")
    expect(showI(catalan(4))).toBe("14")
    expect(showI(catalan(10))).toBe("16796")
    expect(showI(catalan(15))).toBe("9694845")
    expect(showI(catalan(20))).toBe("6564120420")
    expect(showI(catalan(30))).toBe("3814986502092304")
    expect(showI(catalan(-1))).toBe("<none>")
}

test fn derangement_counts() {
    expect(showI(derangements(0))).toBe("1")
    expect(showI(derangements(1))).toBe("0")
    expect(showI(derangements(2))).toBe("1")
    expect(showI(derangements(3))).toBe("2")
    expect(showI(derangements(4))).toBe("9")
    expect(showI(derangements(5))).toBe("44")
    expect(showI(derangements(6))).toBe("265")
    expect(showI(derangements(10))).toBe("1334961")
    expect(showI(derangements(20))).toBe("895014631192902121")
    expect(showI(derangements(-1))).toBe("<none>")
}

test fn stirling_second_kind() {
    expect(showI(stirlingSecond(0, 0))).toBe("1")
    expect(showI(stirlingSecond(4, 1))).toBe("1")
    expect(showI(stirlingSecond(4, 2))).toBe("7")
    expect(showI(stirlingSecond(4, 4))).toBe("1")
    expect(showI(stirlingSecond(5, 3))).toBe("25")
    expect(showI(stirlingSecond(10, 5))).toBe("42525")
    expect(showI(stirlingSecond(20, 10))).toBe("5917584964655")
    expect(showI(stirlingSecond(4, 5))).toBe("<none>")
    expect(showI(stirlingSecond(4, -1))).toBe("<none>")
}

test fn stirling_first_kind() {
    expect(showI(stirlingFirst(0, 0))).toBe("1")
    expect(showI(stirlingFirst(5, 1))).toBe("24")
    expect(showI(stirlingFirst(5, 3))).toBe("35")
    expect(showI(stirlingFirst(5, 5))).toBe("1")
    expect(showI(stirlingFirst(10, 5))).toBe("269325")
    expect(showI(stirlingFirst(4, 5))).toBe("<none>")
    expect(showI(stirlingFirst(4, -1))).toBe("<none>")
}

test fn bell_numbers() {
    expect(showI(bell(0))).toBe("1")
    expect(showI(bell(1))).toBe("1")
    expect(showI(bell(2))).toBe("2")
    expect(showI(bell(3))).toBe("5")
    expect(showI(bell(4))).toBe("15")
    expect(showI(bell(5))).toBe("52")
    expect(showI(bell(8))).toBe("4140")
    expect(showI(bell(10))).toBe("115975")
    expect(showI(bell(15))).toBe("1382958545")
    expect(showI(bell(20))).toBe("51724158235372")
    expect(showI(bell(-1))).toBe("<none>")
}

test fn integer_partitions() {
    expect(showI(partitionCount(0))).toBe("1")
    expect(showI(partitionCount(1))).toBe("1")
    expect(showI(partitionCount(2))).toBe("2")
    expect(showI(partitionCount(5))).toBe("7")
    expect(showI(partitionCount(10))).toBe("42")
    expect(showI(partitionCount(20))).toBe("627")
    expect(showI(partitionCount(50))).toBe("204226")
    expect(showI(partitionCount(100))).toBe("190569292")
    expect(showI(partitionCount(-1))).toBe("<none>")
}

test fn stirling_rows_sum_to_bell_and_factorial() {
    var bellSum = 0
    var firstSum = 0
    var k = 1
    while (k <= 8) {
        if (let some(s) = stirlingSecond(8, k)) {
            bellSum = bellSum + s
        }
        if (let some(c) = stirlingFirst(8, k)) {
            firstSum = firstSum + c
        }
        k = k + 1
    }
    expect(bellSum).toBe(4140)
    expect(showI(bell(8))).toBe("4140")
    expect(firstSum).toBe(40320)
    expect(showI(factorial(8))).toBe("40320")
}

test fn binomial_rows_sum_to_powers_of_two() {
    var total = 0
    var k = 0
    while (k <= 10) {
        if (let some(c) = binomial(10, k)) {
            total = total + c
        }
        k = k + 1
    }
    expect(total).toBe(1024)
}

test fn derangement_recurrence_holds() {
    var bad = 0
    var n = 2
    while (n <= 12) {
        let a = derangements(n)
        let b = derangements(n - 1)
        let c = derangements(n - 2)
        if (let some(dn) = a) {
            if (let some(d1) = b) {
                if (let some(d2) = c) {
                    if (dn != (n - 1) * (d1 + d2)) {
                        bad = bad + 1
                    }
                }
            }
        }
        n = n + 1
    }
    expect(bad).toBe(0)
}
