module globals

var counter: int = 7

fn bump() -> int {
    counter = counter + 1
    counter
}

fn main() {
    if (counter == 7) {
        println("global init ok")
    } else {
        println("global init bad")
    }
    if (bump() == 8) {
        println("global bump ok")
    } else {
        println("global bump bad")
    }
    if (counter == 8) {
        println("global read ok")
    } else {
        println("global read bad")
    }
}
