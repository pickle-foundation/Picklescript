module args

fn add3(a: int, b: int, c: int) -> int {
    a + b + c
}

fn add4(a: int, b: int, c: int, d: int) -> int {
    a + b + c + d
}

fn fadd(a: float, b: float) -> float {
    a + b
}

fn main() {
    if (add3(1, 2, 3) == 6) {
        println("add3 ok")
    } else {
        println("add3 bad")
    }
    if (add4(1, 2, 3, 4) == 10) {
        println("add4 ok")
    } else {
        println("add4 bad")
    }
    if (fadd(1.5, 2.5) == 4.0) {
        println("fadd ok")
    } else {
        println("fadd bad")
    }
}
