module runtime.abi_threads_test

import { abiThreadSpawn, abiThreadJoin, abiThreadFinished, abiThreadPanicMessage, abiThreadCount, abiThreadCurrent, abiThreadSleepMs, abiThreadYield } from runtime.abi_threads
import { abiEngineTempCount, abiEngineCollect } from runtime.abi_gcengine
import { abiShadowRegistryCount } from runtime.abi_shadow

/// The unit suite for the thread port bodies, written for the real-thread
/// (non-inline) contract.
///
/// WHAT THE CONTRACT IS NOW. `pickle_thread_spawn` starts an OS thread, so the
/// body runs concurrently with the spawner and may not have run when `spawn`
/// returns. The runtime keeps its single-threaded shape with a world lock (a
/// GIL) taken around every Pickle instruction: the test thread holds it, and a
/// fresh child parks in its entry wrapper until the spawner blocks. Every
/// assertion below is shaped for those two facts - "the handle this spawn got",
/// "the count grew by one", "the body's effect is visible after join" - never
/// "the body already ran when spawn returned".
///
/// NO TEST SPINS ON A FLAG. A spin loop in the main thread would starve the
/// child, because the child cannot run until the GIL is released; polling
/// `abiThreadFinished` in a tight loop is therefore a deadlock, not a wait.
/// The only waits used here are `abiThreadJoin` and `abiThreadSleepMs`, the two
/// bodies that release the world lock.
///
/// THE 60s CLAMP IS NOT SLEPT. `abiThreadSleepMs` maps the input into
/// [0, 60000] and then calls `Sleep`; proving the upper bound would stall the
/// suite for a minute. The extremes test covers the negative and zero ends, and
/// the upper clamp stays a property of the same three lines of code.
///
/// EFFECTS GO THROUGH MODULE STATE OR RAW CELLS. A lambda is captured by value
/// and cannot assign to an enclosing binding (E0900), so a body here either
/// calls a module function that records the effect (`recordSpawn`) or writes
/// through a raw `*int` cell captured in its environment (`setUpCell`). The raw
/// cell is deliberately unmanaged: it exercises the closure environment, not
/// the collector's object graph.
var seenSpawn: int = 0

fn recordSpawn() -> void {
    seenSpawn = seenSpawn + 1
}

/// Raw-cell write helper. The closure calls this, so the write is an ordinary
/// function call rather than an assignment to a captured binding.
fn setUpCell(cell: *int, v: int) {
    unsafe {
        cell[0] = v
    }
}

fn readCell(cell: *int) -> int {
    unsafe {
        return cell[0]
    }
}

/// Void-returning sleep for use as a closure body: a bare `abiThreadSleepMs`
/// tail expression would infer `() -> int` and not fit `fn () -> void`.
fn sleepBody(ms: int) {
    let _ = abiThreadSleepMs(ms)
}

test fn current_id_is_stable_on_one_thread() {
    let first = abiThreadCurrent()
    expect(first >= 0).toBe(true)
    expect(abiThreadCurrent()).toBe(first)
}

test fn yield_returns_to_the_caller() {
    abiThreadYield()
    expect(abiThreadCurrent() >= 0).toBe(true)
}

test fn sleep_terminates_for_the_small_extremes() {
    abiThreadSleepMs(-5)
    abiThreadSleepMs(0)
    abiThreadSleepMs(1)
}

test fn unknown_handles_answer_like_an_empty_registry() {
    let n = abiThreadCount()
    expect(abiThreadFinished(-1)).toBe(false)
    expect(abiThreadFinished(n + 999)).toBe(false)
    expect(abiThreadJoin(-7)).toBe(true)
    expect(abiThreadJoin(n + 999)).toBe(true)
    expect(abiThreadPanicMessage(n + 999) == 0 as *int).toBe(true)
}

test fn spawn_returns_the_next_handle_before_the_body_finishes() {
    let before = abiThreadCount()
    let h = abiThreadSpawn(fn () { sleepBody(120) })
    expect(h).toBe(before)
    expect(abiThreadCount()).toBe(before + 1)
    // The child is parked in a sleep this thread has not released the world
    // lock for, so a zero-timeout probe is deterministic in the direction that
    // matters: a child that has not run cannot have finished. (A body with no
    // wait would be racy here, which is why this one sleeps.)
    expect(abiThreadFinished(h)).toBe(false)
    expect(abiThreadJoin(h)).toBe(true)
    expect(abiThreadFinished(h)).toBe(true)
}

test fn join_observes_a_body_that_ran() {
    let before = seenSpawn
    let h = abiThreadSpawn(fn () { recordSpawn() })
    expect(abiThreadJoin(h)).toBe(true)
    expect(seenSpawn).toBe(before + 1)
}

test fn a_spawned_body_has_its_own_registry_id() {
    var cell: *int = 0 as *int
    unsafe {
        cell = alloc(int, 1)
    }
    setUpCell(cell, 0 - 1)
    let mainId = abiThreadCurrent()
    let h = abiThreadSpawn(fn () { setUpCell(cell, abiThreadCurrent()) })
    expect(abiThreadJoin(h)).toBe(true)
    let childId = readCell(cell)
    expect(childId >= 0).toBe(true)
    expect(childId != mainId).toBe(true)
}

test fn a_captured_environment_survives_a_collection() {
    var cell: *int = 0 as *int
    unsafe {
        cell = alloc(int, 1)
    }
    setUpCell(cell, 0)
    let value = 4242
    let h = abiThreadSpawn(fn () {
        sleepBody(80)
        setUpCell(cell, value)
    })
    // The child is parked on the world lock or in its sleep; either way the
    // closure object and its captured `cell`/`value` hang off the child's
    // registered shadow frame (or the spawn temp roots, before it starts). A
    // collection here must reclaim neither, or the write below lands in a
    // freed env.
    gcCollect(true)
    expect(abiThreadJoin(h)).toBe(true)
    expect(readCell(cell)).toBe(4242)
}

test fn a_throwing_body_is_reported_by_join() {
    let h = abiThreadSpawn(fn () { throw "task boom" })
    expect(abiThreadJoin(h)).toBe(false)
    expect(abiThreadFinished(h)).toBe(true)
    expect(abiThreadPanicMessage(h) == 0 as *int).toBe(true)
}

/// `spawn` roots the entry and body closures on the process-wide lease list
/// because the parent takes the lease and the child releases it. Both sides of
/// that handoff must balance, on the normal and the throwing path.
test fn spawn_leaves_no_temp_root_leases() {
    let before = abiEngineTempCount()
    let h = abiThreadSpawn(fn () {})
    expect(abiThreadJoin(h)).toBe(true)
    expect(abiEngineTempCount()).toBe(before)
}

test fn a_throwing_spawn_leaves_no_temp_root_leases() {
    let before = abiEngineTempCount()
    let h = abiThreadSpawn(fn () { throw "lease boom" })
    expect(abiThreadJoin(h)).toBe(false)
    expect(abiEngineTempCount()).toBe(before)
}

/// `join` retires the child's shadow-registry node. A sequential spawn/join
/// loop must therefore keep the registry at its baseline size instead of
/// growing one node per task.
test fn joined_tasks_retire_their_registry_nodes() {
    let before = abiShadowRegistryCount()
    var i = 0
    while (i < 8) {
        let h = abiThreadSpawn(fn () {})
        expect(abiThreadJoin(h)).toBe(true)
        i = i + 1
    }
    expect(abiShadowRegistryCount()).toBe(before)
}

/// A worker that allocated leaves its node linked (dead) so the sweep can still
/// reach its private registry block. Once that block empties, the collector
/// reaps the node instead of letting the registry grow by one per task.
test fn an_allocating_task_reaps_its_node_after_a_collection() {
    // Drain any dead node an earlier suite left behind, then measure.
    abiEngineCollect(true)
    let before = abiShadowRegistryCount()
    let h = abiThreadSpawn(fn () {
        let xs = [1, 2, 3]
        expect(xs[1]).toBe(2)
    })
    expect(abiThreadJoin(h)).toBe(true)
    // The worker registered a live object, so its node is dead but still
    // linked until the sweep empties the block.
    expect(abiShadowRegistryCount()).toBe(before + 1)
    abiEngineCollect(true)
    expect(abiShadowRegistryCount() <= before).toBe(true)
}

test fn a_joined_task_stays_joinable() {
    let h = abiThreadSpawn(fn () {})
    expect(abiThreadJoin(h)).toBe(true)
    expect(abiThreadJoin(h)).toBe(true)
}
