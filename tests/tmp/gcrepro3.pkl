class Node {
    var id: int
    var kids: List<Node>
    var data: List<int>
    var attrs: Map<string, int>

    fn count() -> int {
        var t = 1
        for (k in this.kids) {
            t = t + k.count()
        }
        return t
    }
}

var root: List<Node> = []

fn buildGraph(depth: int, fan: int) -> Node {
    let n = Node(depth, [], [depth, depth + 1, depth + 2])
    n.attrs["a"] = depth
    n.attrs["b"] = depth + 1
    if (depth > 0) {
        var i = 0
        while (i < fan) {
            n.kids.push(buildGraph(depth - 1, fan))
            i = i + 1
        }
    }
    return n
}

fn churn() {
    var i = 0
    while (i < 20000) {
        let tmp = [i, i + 1, i + 2]
        let z = len(tmp)
        i = i + z
    }
}

fn main() {
    var r = 0
    while (r < 40) {
        let g = buildGraph(5, 4)
        root.push(g)
        churn()
        r = r + 1
    }
    var total = 0
    for (n in root) {
        total = total + n.count()
    }
    print(len(root))
    print(total)
}
