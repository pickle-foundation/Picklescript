module t_split

import { stringTrim, subStr, splitLines, stringIndexOf, stringStartsWith, matchingBrace } from compiler.front

fn main() {
    var i = 0
    var acc = 0
    while (i < 300000) {
        let parts = splitLines("alpha
beta
gamma
delta")
        acc = acc + len(parts)
        i = i + 1
    }
    println("acc=" + str(acc))
}

