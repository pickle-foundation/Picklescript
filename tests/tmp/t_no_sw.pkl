module t_no_sw

import { stringTrim, subStr, splitLines, stringIndexOf, stringStartsWith, matchingBrace } from compiler.front

fn main() {
    var i = 0
    var acc = 0
    while (i < 300000) {
        let t = stringTrim("   hello world   ")
        acc = acc + len(t)
        let u = subStr("abcdefghijklmnop", 3, 7)
        acc = acc + len(u)
        let parts = splitLines("alpha
beta
gamma
delta")
        acc = acc + len(parts)
        let p = stringIndexOf("the quick brown fox", "brown")
        acc = acc + p
        i = i + 1
    }
    println("acc=" + str(acc))
}

