class Node {
    var name: string
    var kids: List<int>

    fn total() -> int {
        var t = 0
        for (k in this.kids) {
            t = t + k
        }
        return t
    }
}

var gList: List<Node> = [Node("x", [1, 2, 3])]

fn build(depth: int) -> Node {
    let n = Node("n", [depth, depth + 1])
    var i = 0
    while (i < 5) {
        n.kids.push(i)
        i = i + 1
    }
    return n
}

fn rec(n: int) -> int {
    if (n <= 0) {
        return 0
    }
    let nd = build(n)
    gList.push(nd)
    return rec(n - 1) + nd.total()
}

fn main() {
    var r = 0
    while (r < 300) {
        let s = rec(15)
        var j = 0
        while (j < 800) {
            let tmp = [j, j + 1, j + 2, j + 3]
            let z = len(tmp)
            j = j + z
        }
        r = r + 1
    }
    var total = 0
    for (c in gList) {
        total = total + c.total()
    }
    print(len(gList))
    print(total)
    print(rec(3))
}
