module t_sub

import { stringTrim, subStr, splitLines, stringIndexOf, stringStartsWith, matchingBrace } from compiler.front

fn main() {
    var i = 0
    var acc = 0
    while (i < 300000) {
        let u = subStr("abcdefghijklmnop", 3, 7)
        acc = acc + len(u)
        i = i + 1
    }
    println("acc=" + str(acc))
}

