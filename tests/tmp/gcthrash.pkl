class Cell {
    var a: int
    var b: int

    fn sum() -> int {
        this.a + this.b
    }
}

fn main() {
    var keep = [Cell(0, 0)]
    keep.remove(0)
    var rounds = 0
    while (rounds < 60) {
        var i = 0
        while (i < 15000) {
            keep.push(Cell(i, i + 1))
            i = i + 1
        }
        var g = 0
        while (g < 4000) {
            let tmp = [g, g + 1, g + 2, g + 3, g + 4]
            let z = len(tmp)
            g = g + z
        }
        rounds = rounds + 1
    }
    var total = 0
    for (c in keep) {
        total = total + c.sum()
    }
    print(len(keep))
    print(total)
}
