class Cell {
    var a: int
    var b: int

    fn sum() -> int {
        this.a + this.b
    }
}

fn main() {
    var keep = [Cell(0, 0)]
    var m = {"x": 1}
    var r = 0
    while (r < 40) {
        var i = 0
        while (i < 300) {
            keep.push(Cell(i, i + 1))
            var s = "k"
            m[s] = i
            i = i + 1
        }
        var g = 0
        while (g < 200) {
            let tmp = [g, g + 1, g + 2]
            let z = len(tmp)
            g = g + z
        }
        r = r + 1
    }
    var total = 0
    for (c in keep) {
        total = total + c.sum()
    }
    print(len(keep))
    print(total)
}
