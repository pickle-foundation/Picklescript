module compiler.resolve_test

import { ClassTable, entryGenerics, EnumTable, holdsRef, InterfaceTable, mkBuiltin, primitive, renderList, renderPath, TypeTableEntry, varsOf } from compiler.resolvebag
import { anyParam, anyStr, entryKindName, entryName, genericsOfDecl, hasAttr, isClassTy, sigCompatible } from compiler.resolvecore
import { Span } from compiler.diag
import { GenericParam, Attribute } from compiler.ast
import { Ty, tyEq } from compiler.ty

test fn entry_accessors() {
    let ct = ClassTable("Foo", Span(0, 0), Visibility.Public, ["T", "U"], none, [Ty.Int], List<FieldInfo>(), List<CallableInfo>(), List<PropertyInfo>(), none, List<NamedCtorInfo>(), List<FieldInfo>(), false, false)
    let e = TypeTableEntry.Class(ct)
    expect(entryName(e)).toBe("Foo")
    expect(entryKindName(e)).toBe("class")
    expect(len(entryGenerics(e))).toBe(2)
    expect(entryGenerics(e)[0]).toBe("T")
    expect(entryGenerics(e)[1]).toBe("U")
}

test fn enum_entry_accessors() {
    let et = EnumTable("Color", Span(0, 0), Visibility.Public, ["T"], [Ty.Int], List<EnumVariantInfo>())
    let e = TypeTableEntry.Enum(et)
    expect(entryName(e)).toBe("Color")
    expect(entryKindName(e)).toBe("enum")
    expect(entryGenerics(e)[0]).toBe("T")
}

test fn iface_entry_kind() {
    let it = InterfaceTable("Shape", Span(0, 0), Visibility.Public, List<string>(), List<Ty>(), List<InterfaceMemberInfo>())
    let e = TypeTableEntry.Interface(it)
    expect(entryKindName(e)).toBe("interface")
    expect(entryName(e)).toBe("Shape")
}

test fn generics_of_decl() {
    let gs = [GenericParam("T", Span(0, 0)), GenericParam("U", Span(0, 0))]
    let out = genericsOfDecl(gs)
    expect(len(out)).toBe(2)
    expect(out[0]).toBe("T")
    expect(out[1]).toBe("U")
    expect(len(genericsOfDecl(List<GenericParam>()))).toBe(0)
}

test fn has_attr() {
    let attrs = [Attribute("test", List<Expr>(), Span(0, 0))]
    expect(hasAttr(attrs, "test")).toBe(true)
    expect(hasAttr(attrs, "bench")).toBe(false)
    expect(hasAttr(List<Attribute>(), "test")).toBe(false)
}

test fn any_str() {
    expect(anyStr(["a", "b"], "b")).toBe(true)
    expect(anyStr(["a", "b"], "c")).toBe(false)
}

test fn render_path() {
    expect(renderPath(["a"])).toBe("a")
    expect(renderPath(["a", "b", "c"])).toBe("a.b.c")
    expect(renderPath(List<string>())).toBe("")
}

test fn render_list() {
    expect(renderList(List<string>())).toBe("none")
    expect(renderList(["a"])).toBe("a")
    expect(renderList(["a", "b"])).toBe("a, b")
}

test fn primitives() {
    match (primitive("int")) {
        case some(t) -> expect(tyEq(t, Ty.Int)).toBe(true)
        case none -> expect(true).toBe(false)
    }
    match (primitive("string")) {
        case some(t) -> expect(tyEq(t, Ty.String)).toBe(true)
        case none -> expect(true).toBe(false)
    }
    match (primitive("void")) {
        case some(t) -> expect(tyEq(t, Ty.Empty)).toBe(true)
        case none -> expect(true).toBe(false)
    }
    match (primitive("f64")) {
        case some(t) -> expect(tyEq(t, Ty.Float)).toBe(true)
        case none -> expect(true).toBe(false)
    }
    match (primitive("i64")) {
        case some(t) -> expect(tyEq(t, Ty.Int)).toBe(true)
        case none -> expect(true).toBe(false)
    }
    match (primitive("deque")) {
        case some(t) -> expect(true).toBe(false)
        case none -> expect(true).toBe(true)
    }
}

test fn holds_ref() {
    expect(holdsRef(Ty.Ref(Ty.Int))).toBe(true)
    expect(holdsRef(Ty.Option(Ty.Ref(Ty.Int)))).toBe(true)
    expect(holdsRef(Ty.Option(Ty.Int))).toBe(false)
    expect(holdsRef(Ty.Int)).toBe(false)
}

test fn is_class_ty() {
    expect(isClassTy(Ty.Class("Foo", List<Ty>()))).toBe(true)
    expect(isClassTy(Ty.Int)).toBe(false)
    expect(isClassTy(Ty.Struct("Bar", List<Ty>()))).toBe(false)
}

test fn sig_compatible() {
    let pa = [anyParam(Span(0, 0), "a")]
    let pb = [anyParam(Span(0, 0), "b")]
    expect(sigCompatible(pa, Ty.Int, pb, Ty.Int)).toBe(true)
    expect(sigCompatible(List<ParamInfo>(), Ty.Int, pb, Ty.Int)).toBe(false)
    expect(sigCompatible(pa, Ty.Int, pa, Ty.String)).toBe(false)
    expect(sigCompatible(List<ParamInfo>(), Ty.String, List<ParamInfo>(), Ty.String)).toBe(true)
}

test fn empty_table_lists() {
    expect(len(List<ParamInfo>())).toBe(0)
    expect(len(List<CallableInfo>())).toBe(0)
    expect(len(List<FieldInfo>())).toBe(0)
    expect(len(List<PropertyInfo>())).toBe(0)
    expect(len(List<NamedCtorInfo>())).toBe(0)
    expect(len(List<EnumVariantInfo>())).toBe(0)
    expect(len(List<InterfaceMemberInfo>())).toBe(0)
    expect(len(List<MethodSig>())).toBe(0)
    expect(len(List<ClassTable>())).toBe(0)
    expect(len(List<PendingFn>())).toBe(0)
    expect(len(List<ConstDecl>())).toBe(0)
    expect(len(List<ItemKindDecl>())).toBe(0)
}

test fn empty_map_factories() {
    let m = Map<string, TypeTableEntry>()
    expect(len(m)).toBe(0)
    let f = Map<string, List<CallableInfo>>()
    expect(len(f)).toBe(0)
    let a = Map<string, List<string>>()
    expect(len(a)).toBe(0)
    let s = Map<string, Span>()
    expect(len(s)).toBe(0)
}

test fn builtin_ctor() {
    let c = mkBuiltin(Span(0, 0), "len", [anyParam(Span(0, 0), "x")], Ty.Int)
    expect(c.name).toBe("len")
    expect(tyEq(c.ret, Ty.Int)).toBe(true)
    expect(len(c.params)).toBe(1)
    expect(c.params[0].rest).toBe(true)
    expect(c.params[0].name).toBe("x")
}

