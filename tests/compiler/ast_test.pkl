module compiler.ast_test

import { isExpectMethod, emptyBlock } from compiler.ast

test fn expect_method_names() {
    expect(isExpectMethod("toBe")).toBe(true)
    expect(isExpectMethod("toEqual")).toBe(true)
    expect(isExpectMethod("toHaveLength")).toBe(true)
    expect(isExpectMethod("toContain")).toBe(true)
    expect(isExpectMethod("toExist")).toBe(true)
    expect(isExpectMethod("toBeNull")).toBe(true)
    expect(isExpectMethod("toEqualB")).toBe(false)
    expect(isExpectMethod("toBeTruth")).toBe(false)
    expect(isExpectMethod("to")).toBe(false)
    expect(isExpectMethod("")).toBe(false)
}

test fn empty_strs() {
    expect(len(List<string>())).toBe(0)
}

test fn empty_list_factories() {
    expect(len(List<ModuleDecl>())).toBe(0)
    expect(len(List<ImportDecl>())).toBe(0)
    expect(len(List<Item>())).toBe(0)
    expect(len(List<Attribute>())).toBe(0)
    expect(len(List<Expr>())).toBe(0)
    expect(len(List<ImportItem>())).toBe(0)
    expect(len(List<Param>())).toBe(0)
    expect(len(List<GenericParam>())).toBe(0)
    expect(len(List<TypeExpr>())).toBe(0)
    expect(len(List<Stmt>())).toBe(0)
    expect(len(List<MatchArm>())).toBe(0)
    expect(len(List<CallArg>())).toBe(0)
    expect(len(List<StrPart>())).toBe(0)
    expect(len(List<ClassMember>())).toBe(0)
    expect(len(List<EnumVariant>())).toBe(0)
    expect(len(List<EnumField>())).toBe(0)
    expect(len(List<InterfaceMember>())).toBe(0)
}

test fn empty_block() {
    let b = emptyBlock()
    expect(len(b.stmts)).toBe(0)
    expect(len(List<string>())).toBe(0)
}