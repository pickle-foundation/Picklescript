module compiler.x64_test

import { IrTy, IrConst, IrUnOp, IrBinOp, IrInstr, IrTerm, IrParam, IrExtern, IrBlock, IrFunc, IrModule, Callee } from compiler.ir
import { X64Func, X64Out, x64LowerModule, hex2, f64ToBits, x64Dump, magicDivConst, externMayCollect } from compiler.x64
import { DiagnosticSink } from compiler.diag

fn mkFunc(name: string, symbol: string, ret: IrTy, slots: List<IrTy>, blocks: List<IrBlock>) -> IrFunc {
    IrFunc(name, symbol, List<IrParam>(), ret, slots, 0, blocks, false, false, List<string>())
}

fn mkFuncParams(name: string, symbol: string, params: List<IrParam>, ret: IrTy, slots: List<IrTy>, blocks: List<IrBlock>) -> IrFunc {
    IrFunc(name, symbol, params, ret, slots, 0, blocks, false, false, List<string>())
}

fn mkModuleOne(f: IrFunc) -> IrModule {
    var fs: List<IrFunc> = []
    fs.push(f)
    var es: List<IrExtern> = []
    var bn = {"::seed::": 0}
    bn.remove("::seed::")
    var ss: List<List<int>> = []
    IrModule(fs, es, bn, ss, List<IrGlobal>())
}

fn mkModuleExtern(f: IrFunc, e: IrExtern) -> IrModule {
    var fs: List<IrFunc> = []
    fs.push(f)
    var es: List<IrExtern> = []
    es.push(e)
    var bn = {"::seed::": 0}
    bn.remove("::seed::")
    var ss: List<List<int>> = []
    IrModule(fs, es, bn, ss, List<IrGlobal>())
}

fn takeF(out: X64Out?) -> X64Func {
    match (out) {
        case some(o) -> {
            if (len(o.funcs) >= 1) {
                o.funcs[0]
            } else {
                expect(false).toBe(true)
                X64Func("bad", [0], List<Reloc>(), 0, 0)
            }
        }
        case none -> {
            expect(false).toBe(true)
            X64Func("bad", [0], List<Reloc>(), 0, 0)
        }
    }
}

fn lowerF(f: IrFunc) -> X64Func {
    let m = mkModuleOne(f)
    let d = DiagnosticSink()
    takeF(x64LowerModule(m, d))
}

fn lowerFExt(f: IrFunc, e: IrExtern) -> X64Func {
    let m = mkModuleExtern(f, e)
    let d = DiagnosticSink()
    takeF(x64LowerModule(m, d))
}

fn bytesHex(bs: List<int>) -> string {
    var acc = ""
    var i = 0
    while (i < len(bs)) {
        acc = acc + hex2(bs[i])
        i = i + 1
    }
    acc
}

fn assertBytes(xf: X64Func, expected: string) {
    expect(bytesHex(xf.bytes)).toBe(expected)
}

fn byteCat(a: List<int>, b: List<int>) -> List<int> {
    var out: List<int> = []
    var i = 0
    while (i < len(a)) {
        out.push(a[i])
        i = i + 1
    }
    i = 0
    while (i < len(b)) {
        out.push(b[i])
        i = i + 1
    }
    out
}

fn containsSeq(bs: List<int>, seq: List<int>) -> bool {
    if (len(seq) == 0 || len(bs) < len(seq)) {
        return false
    }
    var i = 0
    while (i <= len(bs) - len(seq)) {
        var j = 0
        var ok = true
        while (j < len(seq)) {
            if (bs[i + j] != seq[j]) {
                ok = false
                break
            }
            j = j + 1
        }
        if (ok) {
            return true
        }
        i = i + 1
    }
    false
}

fn floatCmpBytes(op: IrBinOp) -> List<int> {
    let f = mkFunc("f", "pkl_f", IrTy.Bool, [IrTy.Float, IrTy.Float], oneBlockTerm(
        IrTerm.Return(2),
        [IrInstr.LoadSlot(0, 0), IrInstr.LoadSlot(1, 1), IrInstr.BinOp(2, op, 0, 1)]))
    lowerF(f).bytes
}

/// Calls between functions emitted in one module are known to land in the
/// final image's `.text`, so they use `E8 disp32` and REL32 rather than an
/// absolute address load followed by an indirect call. Extern calls retain the
/// latter form because imports and archive-selected runtime symbols are not
/// eligible for this relocation.
test fn internal_calls_use_rel32() {
    let callee = mkFunc("callee", "pkl_callee", IrTy.Int, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(0), [IrInstr.Const(0, IrConst.Int(7))]))
    let caller = mkFunc("caller", "pkl_caller", IrTy.Int, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(0), [IrInstr.Call(0, Callee.Func(0), List<int>())]))
    let fs = [callee, caller]
    let m = IrModule(fs, List<IrExtern>(), {"::seed::": 0}, List<List<int>>(), List<IrGlobal>())
    let d = DiagnosticSink()
    match (x64LowerModule(m, d)) {
        case some(out) -> {
            let xf = out.funcs[1]
            expect(containsSeq(xf.bytes, [0xE8, 0, 0, 0, 0])).toBe(true)
            expect(len(xf.relocs)).toBe(1)
            expect(xf.relocs[0].sym).toBe("pkl_callee")
            expect(xf.relocs[0].type).toBe(4)
        }
        case none -> expect(false).toBe(true)
    }
}

/// Runtime ABI externs are archive-selected but become normal code in the
/// final merged image, so their direct calls are also REL32. Non-runtime
/// externs keep the import/indirect path.
test fn runtime_extern_calls_use_rel32() {
    let e = IrExtern("pickle_runtime_leaf", List<IrTy>(), IrTy.Int)
    let f = mkFunc("caller", "pkl_caller", IrTy.Int, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(0), [IrInstr.Call(0, Callee.Extern(0), List<int>())]))
    let xf = lowerFExt(f, e)
    expect(containsSeq(xf.bytes, [0xE8, 0, 0, 0, 0])).toBe(true)
    expect(len(xf.relocs)).toBe(1)
    expect(xf.relocs[0].sym).toBe("pickle_runtime_leaf")
    expect(xf.relocs[0].type).toBe(4)
}

// Regression: float Eq/Ne/Lt/Le emitted `setcc` twice with ModRM 0xC0, which
// is always AL, so the second clobbered the first and the trailing `20 C8` /
// `08 C8` combined against an undefined CL. `0x20 0xC8` reads like
// `and al,0x20` but is really `AND AL,CL` - 0x20 is the opcode, not an
// immediate. The result depended on whatever CL happened to hold: `!=` was
// always true, `<` and `<=` were always false. That is what stopped the
// self-hosted compiler from being a fixed point (a NaN-only `a != a` guard made
// every float constant in generation 2+ a NaN). The second setcc must target CL
// (ModRM 0xC1); Gt/Ge need only one and were always correct.
test fn float_cmp_second_setcc_targets_cl() {
    let comisd = [0x66, 0x0F, 0x2E, 0xC1]
    // ordered == : sete AL ; setnp CL ; and AL,CL
    expect(containsSeq(floatCmpBytes(IrBinOp.Eq), byteCat(comisd, [0x0F, 0x94, 0xC0, 0x0F, 0x9B, 0xC1, 0x20, 0xC8]))).toBe(true)
    // != : setne AL ; setp CL ; or AL,CL  (NaN counts as !=)
    expect(containsSeq(floatCmpBytes(IrBinOp.Ne), byteCat(comisd, [0x0F, 0x95, 0xC0, 0x0F, 0x9A, 0xC1, 0x08, 0xC8]))).toBe(true)
    // ordered < : setc AL ; setnp CL ; and AL,CL
    expect(containsSeq(floatCmpBytes(IrBinOp.Lt), byteCat(comisd, [0x0F, 0x92, 0xC0, 0x0F, 0x9B, 0xC1, 0x20, 0xC8]))).toBe(true)
    // ordered <= : setbe AL ; setnp CL ; and AL,CL
    expect(containsSeq(floatCmpBytes(IrBinOp.Le), byteCat(comisd, [0x0F, 0x96, 0xC0, 0x0F, 0x9B, 0xC1, 0x20, 0xC8]))).toBe(true)
    // Gt/Ge are single setcc: CF=0 already excludes the unordered case.
    expect(containsSeq(floatCmpBytes(IrBinOp.Gt), byteCat(comisd, [0x0F, 0x97, 0xC0]))).toBe(true)
    expect(containsSeq(floatCmpBytes(IrBinOp.Ge), byteCat(comisd, [0x0F, 0x93, 0xC0]))).toBe(true)
}

// Guards the exact defect: no float compare may emit two setcc into the same
// register. Asserted separately so a future edit cannot reintroduce it while
// still matching the sequences above by accident.
test fn float_cmp_never_writes_two_setcc_into_al() {
    let comisd = [0x66, 0x0F, 0x2E, 0xC1]
    var ops = [IrBinOp.Eq, IrBinOp.Ne, IrBinOp.Lt, IrBinOp.Le]
    var i = 0
    while (i < len(ops)) {
        let bs = floatCmpBytes(ops[i])
        expect(containsSeq(bs, byteCat(comisd, [0x0F, 0x94, 0xC0, 0x0F, 0x94, 0xC0]))).toBe(false)
        expect(containsSeq(bs, byteCat(comisd, [0x0F, 0x95, 0xC0, 0x0F, 0x95, 0xC0]))).toBe(false)
        expect(containsSeq(bs, byteCat(comisd, [0x0F, 0x92, 0xC0, 0x0F, 0x92, 0xC0]))).toBe(false)
        expect(containsSeq(bs, byteCat(comisd, [0x0F, 0x96, 0xC0, 0x0F, 0x96, 0xC0]))).toBe(false)
        expect(containsSeq(bs, byteCat(comisd, [0x0F, 0x9B, 0xC0]))).toBe(false)
        expect(containsSeq(bs, byteCat(comisd, [0x0F, 0x9A, 0xC0]))).toBe(false)
        i = i + 1
    }
}

fn oneBlockTerm(term: IrTerm, instrs: List<IrInstr>) -> List<IrBlock> {
    var l: List<IrBlock> = []
    l.push(IrBlock(0, instrs, term))
    l
}

test fn f64_to_bits_basics() {
    expect(f64ToBits(0.0)).toBe(0)
    expect(f64ToBits(1.0)).toBe(0x3FF0000000000000)
    expect(f64ToBits(2.0)).toBe(0x4000000000000000)
    expect(f64ToBits(2.5)).toBe(0x4004000000000000)
    expect(f64ToBits(1.5)).toBe(0x3FF8000000000000)
    expect(f64ToBits(-2.5)).toBe(-4610560118520545280)
}

// Every expected value here is ground truth taken from Rust's native
// `f64::to_bits()` fed through the same `str::parse::<f64>()` the Pickle
// checker's literal parser mimics, so this also pins the port to the oracle.
// The pre-2026-10-03 implementation got three of these cases wrong: it forced
// the sign bit on overflow (`1.0e400` became `-inf`), let NaN reach the
// mantissa math (`0.0/0.0` came out as the bits for `1.5`), and flushed the
// subnormals - including `2.2250738585072014e-308`, the smallest *normal* - to
// zero.
test fn f64_to_bits_nonfinite_and_extremes() {
    // Overflow. An at-or-above-ceiling literal parses to +inf.
    expect(f64ToBits(1.0e400)).toBe(9218868437227405312)
    expect(f64ToBits(1.8e308)).toBe(9218868437227405312)
    expect(f64ToBits(-1.0e400)).toBe(-4503599627370496)
    expect(f64ToBits(1.0 / 0.0)).toBe(9218868437227405312)
    expect(f64ToBits(-1.0 / 0.0)).toBe(-4503599627370496)
    // NaN: canonical quiet NaN, sign taken from the operand.
    expect(f64ToBits(0.0 / 0.0)).toBe(9221120237041090560)
    // The exponent-field boundary. 2.2250738585072014e-308 is the smallest
    // normal double and must keep exponent field 1; the neighbouring literal
    // is the largest subnormal.
    expect(f64ToBits(2.2250738585072014e-308)).toBe(4503599627370496)
    expect(f64ToBits(2.2250738585072011e-308)).toBe(4503599627370495)
    // Subnormals, whose mantissa field has no implicit leading 1.
    expect(f64ToBits(1.0e-320)).toBe(2024)
    expect(f64ToBits(3.0e-320)).toBe(6072)
    expect(f64ToBits(1.0e-323)).toBe(2)
    expect(f64ToBits(5e-324)).toBe(1)
    // Endpoints.
    expect(f64ToBits(1.7976931348623157e308)).toBe(9218868437227405311)
    expect(f64ToBits(-0.0)).toBe((0 - 9223372036854775807) - 1)
}

test fn hex2_digits() {
    expect(hex2(0)).toBe("00")
    expect(hex2(0x0A)).toBe("0a")
    expect(hex2(0x10)).toBe("10")
    expect(hex2(0x2E)).toBe("2e")
    expect(hex2(255)).toBe("ff")
}

test fn int_const_return() {
    let f = mkFunc("f", "pkl_f", IrTy.Int, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(0), [IrInstr.Const(0, IrConst.Int(42))]))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec2000000048b82a000000000000004889ec5dc3")
    expect(xf.ncells).toBe(0)
    expect(xf.totalK).toBe(32)
    expect(len(xf.relocs)).toBe(0)
    expect(xf.symbol).toBe("pkl_f")
}

test fn bool_const_return() {
    let f = mkFunc("f", "pkl_f", IrTy.Bool, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(0), [IrInstr.Const(0, IrConst.Bool(true))]))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec2000000048b801000000000000004889ec5dc3")
    expect(xf.totalK).toBe(32)
}

test fn unit_return() {
    let f = mkFunc("f", "pkl_f", IrTy.Unit, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(none), List<IrInstr>()))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec200000004889ec5dc3")
    expect(xf.totalK).toBe(32)
    expect(xf.ncells).toBe(0)
}

test fn int_add_return() {
    // Parameters, not constants: scalar constants are folded/rematerialised,
    // so this must load real operands to cover the add lowering.
    let f = mkFuncParams("f", "pkl_f", [IrParam("x", IrTy.Int), IrParam("y", IrTy.Int)], IrTy.Int, [IrTy.Int, IrTy.Int], oneBlockTerm(
        IrTerm.Return(2),
        [IrInstr.LoadSlot(0, 0),
         IrInstr.LoadSlot(1, 1),
         IrInstr.BinOp(2, IrBinOp.Add, 0, 1)]))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec4000000048894de8488955e0488b45e8488945d8488b45e04889c1488b45d84801c84889ec5dc3")
    expect(xf.totalK).toBe(64)
}

test fn int_div_return() {
    // Parameters keep the division lowering live (constant operands fold).
    let f = mkFuncParams("f", "pkl_f", [IrParam("x", IrTy.Int), IrParam("y", IrTy.Int)], IrTy.Int, [IrTy.Int, IrTy.Int], oneBlockTerm(
        IrTerm.Return(2),
        [IrInstr.LoadSlot(0, 0),
         IrInstr.LoadSlot(1, 1),
         IrInstr.BinOp(2, IrBinOp.Div, 0, 1)]))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec4000000048894de8488955e0488b45e8488945d8488b45e04889c1488b45d8489948f7f94889ec5dc3")
}

test fn float_const_return() {
    let f = mkFunc("f", "pkl_f", IrTy.Float, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(0), [IrInstr.Const(0, IrConst.Float(2.5))]))
    let xf = lowerF(f)
    // The float result stays in xmm0 for the return: the store keeps the home
    // current but the reload is elided.
    assertBytes(xf, "554889e54881ec2000000048b8000000000000044066480f6ec0f20f1145e84889ec5dc3")
    expect(xf.totalK).toBe(32)
}

test fn float_cmp_lt_return() {
    let f = mkFunc("f", "pkl_f", IrTy.Bool, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(2),
        [IrInstr.Const(0, IrConst.Float(1.0)),
         IrInstr.Const(1, IrConst.Float(2.0)),
         IrInstr.BinOp(2, IrBinOp.Lt, 0, 1)]))
    let xf = lowerF(f)
assertBytes(xf, "554889e54881ec3000000048b8000000000000f03f66480f6ec0f20f1145e848b8000000000000004066480f6ec0f20f1145e0f20f1045e8f20f104de0660f2ec10f92c00f9bc120c84889ec5dc3")
  }

test fn unop_neg_return() {
    // A parameter keeps the neg lowering live (a constant operand folds).
    let f = mkFuncParams("f", "pkl_f", [IrParam("x", IrTy.Int)], IrTy.Int, [IrTy.Int], oneBlockTerm(
        IrTerm.Return(1),
        [IrInstr.LoadSlot(0, 0),
         IrInstr.UnOp(1, IrUnOp.Neg, 0)]))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec3000000048894de8488b45e848f7d84889ec5dc3")
    expect(xf.totalK).toBe(48)
}

/// The front end's implicit "return zero" tail emits `const 0` (Int) even in a
/// float-returning function (e.g. `abiListSumF64` in the runtime). Scalar
/// constants are rematerialised and own no home, so the float return path must
/// materialise the constant's 64-bit pattern instead of asking for a home. The
/// bits go through r11, not rax, because an already-loaded integer argument
/// may still be live in rax.
test fn float_return_of_int_const() {
    let f = mkFunc("f", "pkl_f", IrTy.Float, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(0), [IrInstr.Const(0, IrConst.Int(0))]))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec2000000049bb000000000000000066490f6ec34889ec5dc3")
    expect(xf.totalK).toBe(32)
    expect(xf.ncells).toBe(0)
}

test fn float_return_of_nonzero_int_const_keeps_bits() {
    let f = mkFunc("f", "pkl_f", IrTy.Float, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(0), [IrInstr.Const(0, IrConst.Int(7))]))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec2000000049bb070000000000000066490f6ec34889ec5dc3")
}

/// A 1-byte home beneath an aligned 8-byte home must not overlap it.
/// An access of width W at [rbp-K] consumes offsets [K-W+1, K], so the Bool
/// slots parked at 24 and 25 must force the next 8-byte home to K >= 33 --
/// here it lands at 40 -- and the Bool temp's byte store at 41 must stay one
/// byte. A qword access for the Int slot would consume [33,40] and clobber the
/// Bool at 25.
test fn bool_then_int_temps_do_not_overlap() {
    let f = mkFunc("f", "pkl_f", IrTy.Int, [IrTy.Bool, IrTy.Bool, IrTy.Int], oneBlockTerm(
        IrTerm.Return(3),
        [IrInstr.LoadSlot(0, 0),
         IrInstr.UnOp(1, IrUnOp.Not, 0),
         IrInstr.BinOp(2, IrBinOp.Eq, 0, 1),
         IrInstr.StoreSlot(1, 2),
         IrInstr.LoadSlot(3, 2)]))
    let xf = lowerF(f)
    expect(xf.totalK).toBe(64)
    assertBytes(xf, "554889e54881ec400000008a45e88845d784c00f94c089c18a45d738c80f94c08845e7488b45d84889ec5dc3")
}

/// `IrUnOp.Not` operates on a `Bool` temp. `tyWidth(Bool)` is 8 bits, so the
/// load and the temp's home store must be 8 bits -- a wider store would overrun
/// the neighbouring 1-byte home and corrupt an unrelated flag.
test fn unop_not_bool_is_one_byte() {
    let f = mkFunc("f", "pkl_f", IrTy.Bool, [IrTy.Bool, IrTy.Bool], oneBlockTerm(
        IrTerm.Return(2),
        [IrInstr.LoadSlot(0, 0),
         IrInstr.UnOp(1, IrUnOp.Not, 0),
         IrInstr.BinOp(2, IrBinOp.Eq, 0, 1)]))
    let xf = lowerF(f)
    // Slot 0 (Bool) is at k = 24; temp 0's home is at 26 (1 byte). The load
    // (`8a`) and the store (`88`) are the single-byte forms; a 64-bit store
    // would encode a disp32 qword instead and overrun its neighbour.
    expect(xf.totalK).toBe(32)
    assertBytes(xf, "554889e54881ec200000008a45e88845e684c00f94c089c18a45e638c80f94c04889ec5dc3")
}

test fn unop_not_return() {
    // A parameter keeps the Not lowering live (a constant operand folds).
    let f = mkFuncParams("f", "pkl_f", [IrParam("b", IrTy.Bool)], IrTy.Bool, [IrTy.Bool], oneBlockTerm(
        IrTerm.Return(1),
        [IrInstr.LoadSlot(0, 0),
         IrInstr.UnOp(1, IrUnOp.Not, 0)]))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec20000000884de88a45e884c00f94c04889ec5dc3")
}

test fn param_seed_and_return() {
    let f = mkFuncParams("f", "pkl_f", [IrParam("x", IrTy.Int)], IrTy.Int, [IrTy.Int], oneBlockTerm(
        IrTerm.Return(0), [IrInstr.LoadSlot(0, 0)]))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec2000000048894de8488b45e84889ec5dc3")
}

test fn branch_fixup_patched() {
    var bs: List<IrBlock> = []
    bs.push(IrBlock(0, [IrInstr.Const(0, IrConst.Bool(true))], IrTerm.BranchIf(0, 1, 2)))
    bs.push(IrBlock(1, List<IrInstr>(), IrTerm.Return(none)))
    bs.push(IrBlock(2, [IrInstr.Const(1, IrConst.Int(7))], IrTerm.Return(none)))
    let f = mkFunc("f", "pkl_f", IrTy.Unit, List<IrTy>(), bs)
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec2000000048b8010000000000000084c00f8505000000e9050000004889ec5dc34889ec5dc3")
    expect(len(xf.bytes)).toBe(44)
}

test fn managed_slot_shadow_push_pop() {
    // A managed slot only needs a shadow frame when the collector can run while
    // that frame is live, i.e. when the function reaches a may-GC callee. The
    // call to the registered extern (`abiEngineRegister` seeds the may-GC set)
    // forces the frame, so this pins the push/register/pop sequence and relocs.
    let e = IrExtern("abiEngineRegister", [IrTy.Int], IrTy.Unit)
    let f = mkFunc("f", "pkl_f", IrTy.Str, [IrTy.Str], oneBlockTerm(
        IrTerm.Return(0),
        [IrInstr.LoadSlot(0, 0), IrInstr.Const(1, IrConst.Int(0)), IrInstr.Call(2, Callee.Extern(0), [1])]))
    let xf = lowerFExt(f, e)
    assertBytes(xf, "554889e54881ec500000000f57e4f30f7f65f048b8020000003000005a488945e8488d4de049ba000000000000000041ffd2488b45f0488945f848b9000000000000000049ba000000000000000041ffd2488945d8488d4de049ba000000000000000041ffd2488b45f84889ec5dc3")
    expect(xf.ncells).toBe(2)
    expect(xf.totalK).toBe(48)
    expect(len(xf.relocs)).toBe(3)
    expect(xf.relocs[0].off).toBe(39)
    expect(xf.relocs[0].sym).toBe("pickle_shadow_push")
    expect(xf.relocs[1].off).toBe(70)
    expect(xf.relocs[1].sym).toBe("abiEngineRegister")
    expect(xf.relocs[2].off).toBe(91)
    expect(xf.relocs[2].sym).toBe("pickle_shadow_pop")
}

/// The perf guard: a frame with managed slots but no may-GC callee must stay
/// unshadowed. Shadowing every managed frame is what made the self-hosted
/// compiler ~2.35x slower (`v6`), so this pins the gate in the other direction.
test fn managed_slot_without_gc_call_has_no_shadow() {
    let f = mkFunc("f", "pkl_f", IrTy.Str, [IrTy.Str], oneBlockTerm(
        IrTerm.Return(0), [IrInstr.LoadSlot(0, 0)]))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec30000000488b45f04889ec5dc3")
    expect(xf.ncells).toBe(2)
    expect(xf.totalK).toBe(48)
    expect(len(xf.relocs)).toBe(0)
}

test fn extern_float_mod_call() {
    let e = IrExtern("pickle_fmod", [IrTy.Float, IrTy.Float], IrTy.Float)
    let f = mkFunc("f", "pkl_f", IrTy.Float, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(2),
        [IrInstr.Const(0, IrConst.Float(5.0)),
         IrInstr.Const(1, IrConst.Float(2.0)),
         IrInstr.Call(2, Callee.Extern(0), [0, 1])]))
    let xf = lowerFExt(f, e)
    assertBytes(xf, "554889e54881ec5000000048b8000000000000144066480f6ec0f20f1145e848b8000000000000004066480f6ec0f20f1145e0f20f1045e8f20f104de0e800000000f20f1145d84889ec5dc3")
    expect(len(xf.relocs)).toBe(1)
    expect(xf.relocs[0].off).toBe(62)
    expect(xf.relocs[0].sym).toBe("pickle_fmod")
    expect(xf.relocs[0].type).toBe(4)
}

/// Win64 reserves 32 bytes of shadow space below the return address of every
/// call, and a callee may spill its argument registers there. Calls with at
/// most four arguments emit no per-call `sub rsp`, so the prologue has to keep
/// that scratch area below every local home. Without it the callee tramples the
/// bottom of the caller's frame - exactly where the pin saves live - and the
/// restored register no longer belongs to the caller: `FindFirstFileW` wrote a
/// 2 over `abiListDir`'s saved rdi, which restarted `std.test.runTests`'s loop
/// at index 2 forever. `xf.totalK` stays the planned locals size; the extra 32
/// bytes are prologue-only scratch.
test fn call_frame_reserves_win64_shadow_space() {
    let e = IrExtern("abiEngineRegister", [IrTy.Int], IrTy.Unit)
    let f = mkFunc("f", "pkl_f", IrTy.Unit, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(none),
        [IrInstr.Const(0, IrConst.Int(0)), IrInstr.Call(none, Callee.Extern(0), [0])]))
    let xf = lowerFExt(f, e)
    // Prologue: `55 48 89 e5 48 81 ec <imm32 little-endian>`.
    let frame = xf.bytes[7] + xf.bytes[8] * 256 + xf.bytes[9] * 65536 + xf.bytes[10] * 16777216
    expect(frame).toBe(xf.totalK + 32)
    // The call has one argument, so it reserves nothing itself; the 32 bytes
    // above are the only shadow space below the frame.
    expect(len(xf.bytes) > 11).toBe(true)
}

test fn ftoi_saturating() {
    let f = mkFunc("f", "pkl_f", IrTy.Int, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(1),
        [IrInstr.Const(0, IrConst.Float(1.5)),
         IrInstr.Ftoi(1, 0)]))
    let xf = lowerF(f)
    assertBytes(xf, "554889e54881ec2000000048b8000000000000f83f66480f6ec0f20f1145e8660f2ec07a3148b9000000000000e04366480f6ec9660f2ec1732148b9000000000000e0c366480f6ec9660f2ec17218f2480f2cc0eb1b4831c0eb1648b8ffffffffffffff7feb0a48b800000000000000804889ec5dc3")
}

/// Regression guard for frame planning. `analyze` must size unmanaged slots and
/// temps with `tyBytes`, not `tyWidth`; using bits here silently inflates every
/// frame 8x. Small functions stay under the disp8 limit either way, so nothing
/// else in this suite would notice. 64 unmanaged Int slots must span 512 bytes
/// here, not the 4096 the bit widths would give.
test fn large_frame_sizes_slots_in_bytes() {
    var slots = List<IrTy>()
    var i = 0
    while (i < 64) {
        slots.push(IrTy.Int)
        i = i + 1
    }
    let f = mkFunc("f", "pkl_f", IrTy.Int, slots, oneBlockTerm(
        IrTerm.Return(1),
        [IrInstr.Const(0, IrConst.Int(7)), IrInstr.LoadSlot(1, 63)]))
    let xf = lowerF(f)
    // 16-byte shadow header + 8 reserved cell bytes = 24, then 64 * 8 = 512 for
    // the slots, rounded up to 16. The const temp is rematerialised (no home)
    // and the load temp is returned straight from rax.
    expect(xf.totalK).toBe(544)
    // Slot 63 lands at k = 528, past the disp8 limit, so the access must use
    // disp32 (0xFFFFFDF0). Asserting the whole image keeps the large-frame
    // prologue and encoding path covered.
    assertBytes(xf, "554889e54881ec20020000488b85f0fdffff4889ec5dc3")
}

test fn x64_dump_smoke() {
    let f = mkFunc("f", "pkl_f", IrTy.Int, List<IrTy>(), oneBlockTerm(
        IrTerm.Return(0), [IrInstr.Const(0, IrConst.Int(42))]))
    let xf = lowerF(f)
    expect(len(x64Dump(X64Out([xf]))) > 20).toBe(true)
}

/// A long enum-tag chain, the shape `Emitter.expr1` uses for its 20-arm
/// `ExprKind` match. Block 0 tests a tag and branches *forward* past a run of
/// arm bodies to the join block. If a branch fixup is resolved against the
/// wrong block start, the chain falls off the end instead of reaching the arm,
/// and the compiler's own `match` panics at runtime.
test fn long_forward_branch_chain_reaches_arm() {
    var blocks = List<IrBlock>()
    var instrs = List<IrInstr>()
    instrs.push(IrInstr.Const(0, IrConst.Int(5)))
    instrs.push(IrInstr.BinOp(1, IrBinOp.Eq, 0, 0))
    // Branch to the last block (the "arm"), skipping every filler block.
    blocks.push(IrBlock(0, instrs, IrTerm.BranchIf(1, 24, 1)))
    var b = 1
    while (b < 24) {
        blocks.push(IrBlock(b, List<IrInstr>(), IrTerm.Branch(1)))
        b = b + 1
    }
    let arm = List<IrInstr>()
    arm.push(IrInstr.Const(2, IrConst.Int(1)))
    blocks.push(IrBlock(24, arm, IrTerm.Return(2)))
    let f = mkFunc("f", "pkl_f", IrTy.Int, List<IrTy>(), blocks)
    let xf = lowerF(f)
    // Prologue, then the tag test in rax (`movabs 1` from the folded
    // `Eq(5, 5)`, then `test al,al`) and a `jne` that must land on the arm past
    // all 24 filler blocks. Each filler is a 5-byte `jmp rel32` back to block 1,
    // so filler k carries rel = -(5*(k+1)); the last is -0x73. Asserting the
    // whole image pins every forward fixup: resolving one against the wrong
    // block start lands elsewhere in this image and fails.
    assertBytes(xf, "")
}

/// The `[M, s]` pairs the strength reducer computes, pinned against values
/// derived independently by long division. A wrong multiplier is a wrong
/// answer for every input, so the table is worth asserting even though the
/// runtime test below exercises the emitted sequence end to end.
test fn magic_div_const_pairs() {
    expect(magicDivConst(3)).toBe([0 - 6148914691236517205, 1])
    expect(magicDivConst(7)).toBe([5270498306774157605, 1])
    expect(magicDivConst(10)).toBe([7378697629483820647, 2])
    expect(magicDivConst(100)).toBe([0 - 6640827866535438581, 6])
    expect(magicDivConst(1000)).toBe([2361183241434822607, 7])
    expect(magicDivConst(99991)).toBe([0 - 6356397746393801451, 16])
    expect(magicDivConst(2147483647)).toBe([0 - 9223372032559808509, 30])
    // Powers of two take the shift path, and the range ends at 2^31 - 1.
    expect(magicDivConst(1)).toBe(none)
    expect(magicDivConst(2)).toBe(none)
    expect(magicDivConst(4)).toBe(none)
    expect(magicDivConst(2147483648)).toBe(none)
}

test fn int_div_by_const_uses_magic_multiply() {
    // A parameter numerator keeps the constant divisor un-folded, so the
    // backend must pick the magic path: `mul r11`, not `cqo; idiv rcx`.
    let f = mkFuncParams("f", "pkl_f", [IrParam("x", IrTy.Int)], IrTy.Int, [IrTy.Int], oneBlockTerm(
        IrTerm.Return(2),
        [IrInstr.LoadSlot(0, 0),
         IrInstr.Const(1, IrConst.Int(7)),
         IrInstr.BinOp(2, IrBinOp.Div, 0, 1)]))
    let xf = lowerF(f)
    expect(containsSeq(xf.bytes, [0x49, 0xF7, 0xE3])).toBe(true)
    expect(containsSeq(xf.bytes, [0x48, 0xF7, 0xF9])).toBe(false)
}

test fn int_mod_by_const_uses_magic_multiply() {
    let f = mkFuncParams("f", "pkl_f", [IrParam("x", IrTy.Int)], IrTy.Int, [IrTy.Int], oneBlockTerm(
        IrTerm.Return(2),
        [IrInstr.LoadSlot(0, 0),
         IrInstr.Const(1, IrConst.Int(100)),
         IrInstr.BinOp(2, IrBinOp.Mod, 0, 1)]))
    let xf = lowerF(f)
    expect(containsSeq(xf.bytes, [0x49, 0xF7, 0xE3])).toBe(true)
    expect(containsSeq(xf.bytes, [0x48, 0xF7, 0xF9])).toBe(false)
}

/// Differential test: `q`/`r` are the strength-reduced `x / C` and `x % C`
/// computed by the caller, while `x / d` and `x % d` inside this function use
/// the hardware `idiv` (the divisor is not a compile-time constant here). The
/// arithmetic must agree for every signed input, including truncation toward
/// zero rather than flooring.
fn expectConstMatchesIdiv(x: int, d: int, q: int, r: int) {
    expect(q).toBe(x / d)
    expect(r).toBe(x % d)
}

test fn const_div_mod_matches_idiv_on_signed_edges() {
    let mins = (0 - 9223372036854775807) - 1
    let maxs = 9223372036854775807
    var xs = List<int>()
    xs.push(0)
    xs.push(1)
    xs.push(0 - 1)
    xs.push(6)
    xs.push(7)
    xs.push(8)
    xs.push(0 - 6)
    xs.push(0 - 7)
    xs.push(0 - 8)
    xs.push(mins)
    xs.push(mins + 1)
    xs.push(0 - 7 * 1000000000)
    xs.push(maxs)
    xs.push(maxs - 1)
    xs.push(100)
    xs.push(0 - 100)
    xs.push(12345678901234567)
    xs.push(0 - 12345678901234567)
    // A deterministic sweep, so negative and positive values on both sides of
    // many multiples of every divisor above are represented.
    var state = 12345
    var i = 0
    while (i < 400) {
        state = state * 6364136223846793005 + 1442695040888963407
        xs.push(state)
        i = i + 1
    }
    for (x in xs) {
        // Magic-number path (all non-power-of-two divisors in (1, 2^31)).
        expectConstMatchesIdiv(x, 3, x / 3, x % 3)
        expectConstMatchesIdiv(x, 7, x / 7, x % 7)
        expectConstMatchesIdiv(x, 9, x / 9, x % 9)
        expectConstMatchesIdiv(x, 10, x / 10, x % 10)
        expectConstMatchesIdiv(x, 100, x / 100, x % 100)
        expectConstMatchesIdiv(x, 1000, x / 1000, x % 1000)
        expectConstMatchesIdiv(x, 99991, x / 99991, x % 99991)
        expectConstMatchesIdiv(x, 2147483647, x / 2147483647, x % 2147483647)
        // Power-of-two shift path.
        expectConstMatchesIdiv(x, 1, x / 1, x % 1)
        expectConstMatchesIdiv(x, 2, x / 2, x % 2)
        expectConstMatchesIdiv(x, 256, x / 256, x % 256)
        expectConstMatchesIdiv(x, 2147483648, x / 2147483648, x % 2147483648)
        // Negative divisors stay on `idiv`; this pins that truncation toward
        // zero is identical on both operands and both operators.
        expectConstMatchesIdiv(x, 0 - 7, x / (0 - 7), x % (0 - 7))
        expectConstMatchesIdiv(x, 0 - 100, x / (0 - 100), x % (0 - 100))
    }
}

/// Backend-only inlining pins. `emitCall` must spell these leaf helpers as
/// their runtime bodies, so no call and no relocation is emitted. The IR/IRX
/// oracles still see the original `IrInstr.Call`, which is why these image pins
/// live only here.

test fn inline_list_get_lowering() {
    let e = IrExtern("pickle_list_get", [IrTy.Ptr, IrTy.Int], IrTy.Ptr)
    let f = mkFuncParams("f", "pkl_f", [IrParam("xs", IrTy.Ptr)], IrTy.Ptr, [IrTy.Ptr], oneBlockTerm(
        IrTerm.Return(2),
        [IrInstr.LoadSlot(0, 0),
         IrInstr.Const(1, IrConst.Int(0)),
         IrInstr.Call(2, Callee.Extern(0), [0, 1])]))
    let xf = lowerFExt(f, e)
    assertBytes(xf, "554889e54881ec5000000048894de8488b45e84889c148ba0000000000000000488b41184839c27d0a488b4128488b04d0eb0231c04889ec5dc3")
    expect(len(xf.relocs)).toBe(0)
}

test fn inline_list_set_lowering() {
    let e = IrExtern("pickle_list_set", [IrTy.Ptr, IrTy.Int, IrTy.Ptr], IrTy.Unit)
    let f = mkFuncParams("f", "pkl_f", [IrParam("xs", IrTy.Ptr), IrParam("v", IrTy.Ptr)], IrTy.Unit, [IrTy.Ptr, IrTy.Ptr], oneBlockTerm(
        IrTerm.Return(none),
        [IrInstr.LoadSlot(0, 0),
         IrInstr.Const(1, IrConst.Int(0)),
         IrInstr.LoadSlot(2, 1),
         IrInstr.Call(none, Callee.Extern(0), [0, 1, 2])]))
    let xf = lowerFExt(f, e)
    // cmp rdx, rax; jge done; mov rax, [rcx+40]; mov [rax+rdx*8], r8.
    expect(containsSeq(xf.bytes, [0x48, 0x39, 0xC2, 0x7D, 0x08, 0x48, 0x8B, 0x41, 0x28, 0x4C, 0x89, 0x04, 0xD0])).toBe(true)
    var calls = 0
    for (r in xf.relocs) {
        if (r.sym == "pickle_list_set") { calls = calls + 1 }
    }
    // The function still has its conservative shadow-frame pair because call
    // classification happens before backend inlining. No relocation may target
    // the runtime list setter.
    expect(calls).toBe(0)
}

