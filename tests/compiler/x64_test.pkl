/// `pickle_box_i64` is NOT a no-call inline: the shared-box cache is probed
/// inline (one global load, an unsigned range check, one table load) and the
/// real extern is called on a miss, a cold table, or an out-of-range value.
/// Because the extern is may-collect, the function keeps its shadow frame and
/// push/pop pair around the whole sequence - the slow leg still needs them.
/// The relocations pin the frame pair, the cache probe and the fallback call.
test fn inline_box_i64_lowering() {
    let e = IrExtern("pickle_box_i64", [IrTy.Int], IrTy.Ptr)
    let f = mkFuncParams("f", "pkl_f", [IrParam("v", IrTy.Int)], IrTy.Ptr, [IrTy.Int], oneBlockTerm(
        IrTerm.Return(1),
        [IrInstr.LoadSlot(0, 0), IrInstr.Call(1, Callee.Extern(0), [0])]))
    let xf = lowerFExt(f, e)
    assertBytes(xf, "")
    // The inline is the 0..4095 cache probe, the allocating small-value miss
    // (alloc + stamp + register + table insert), the out-of-cache allocating
    // tail (same, without the insert) and the cold-table fallback. Both
    // allocating tails are only reachable after the table sentinel proves the
    // cache exists, and both rejoin the fallback's `done` label.
    let want: List<string> = ["pickle_shadow_push", "pkl_global_smallBoxTab", "pkl_global_managedArenaUsed", "pkl_global_managedArenaCap", "pkl_global_managedArenaBase", "pkl_global_managedArenaUsed", "pkl_abiManagedAlloc", "pkl_global_envInited", "pkl_global_noAutoGc", "pkl_global_regCount", "pkl_global_regCap", "pkl_global_regBase", "pkl_global_regCount", "pkl_global_regBytes", "pkl_global_rawAllocCount", "pkl_global_rawAllocBytes", "pkl_abiEngineRegister", "pkl_global_smallBoxTab", "pkl_global_managedArenaUsed", "pkl_global_managedArenaCap", "pkl_global_managedArenaBase", "pkl_global_managedArenaUsed", "pkl_abiManagedAlloc", "pkl_global_envInited", "pkl_global_noAutoGc", "pkl_global_regCount", "pkl_global_regCap", "pkl_global_regBase", "pkl_global_regCount", "pkl_global_regBytes", "pkl_global_rawAllocCount", "pkl_global_rawAllocBytes", "pkl_abiEngineRegister", "pickle_box_i64", "pickle_shadow_pop"]
    expect(len(xf.relocs)).toBe(len(want))
    var i = 0
    while (i < len(want)) {
        expect(xf.relocs[i].sym).toBe(want[i])
        i = i + 1
    }
}

test fn inline_map_len_lowering() {
    let e = IrExtern("pickle_map_len", [IrTy.Ptr], IrTy.Int)
    let f = mkFuncParams("f", "pkl_f", [IrParam("m", IrTy.Ptr)], IrTy.Int, [IrTy.Ptr], oneBlockTerm(
        IrTerm.Return(1),
        [IrInstr.LoadSlot(0, 0), IrInstr.Call(1, Callee.Extern(0), [0])]))
    let xf = lowerFExt(f, e)
    assertBytes(xf, "554889e54881ec5000000048894df0488b45f04889c1488b41184889ec5dc3")
    expect(len(xf.relocs)).toBe(0)
}

/// `pickle_map_get` keeps its call, but only after the bloom filter has
/// rejected the key: a clear filter is a conservative "absent" because bits are
/// only ever set. The byte pins below are the two-bit probe; the relocation pin
/// proves the fallback still enters the real runtime with rcx/rdx untouched.
test fn inline_map_get_bloom_lowering() {
    let e = IrExtern("pickle_map_get", [IrTy.Ptr, IrTy.Ptr], IrTy.Ptr)
    let f = mkFuncParams("f", "pkl_f", [IrParam("m", IrTy.Ptr), IrParam("k", IrTy.Ptr)], IrTy.Ptr, [IrTy.Ptr, IrTy.Ptr], oneBlockTerm(
        IrTerm.Return(2),
        [IrInstr.LoadSlot(0, 0), IrInstr.LoadSlot(1, 1), IrInstr.Call(2, Callee.Extern(0), [0, 1])]))
    let xf = lowerFExt(f, e)
    // cmp rdx, 2 ; jbe slow -- 0/1/2 are sentinels, never dereferenced.
    expect(containsSeq(xf.bytes, [0x48, 0x83, 0xFA, 0x02, 0x0F, 0x86])).toBe(true)
    // cmp qword [rdx+8], 0 ; jne slow -- only string keys may be answered.
    expect(containsSeq(xf.bytes, [0x48, 0x83, 0x7A, 0x08, 0x00, 0x0F, 0x85])).toBe(true)
    // test al, 2 ; je slow -- without a cached hash the index is unknown.
    expect(containsSeq(xf.bytes, [0x48, 0xA8, 0x02, 0x0F, 0x84])).toBe(true)
    // mov r8, [rcx+0x30] ; test r8, r8 ; je slow -- entry table is word 6.
    expect(containsSeq(xf.bytes, [0x4C, 0x8B, 0x41, 0x30, 0x4D, 0x85, 0xC0, 0x0F, 0x84])).toBe(true)
    // mov r9, [r8+r11*8-32] -- the filter lives 32 bytes before entries.
    expect(containsSeq(xf.bytes, [0x4F, 0x8B, 0x4C, 0xD8, 0xE0])).toBe(true)
    // bt r9, r11 ; jnc miss -- a clear bit answers without entering the map.
    expect(containsSeq(xf.bytes, [0x4D, 0x0F, 0xA3, 0xD9, 0x0F, 0x83])).toBe(true)
    var calls = 0
    var shadows = 0
    for (rr in xf.relocs) {
        if (rr.sym == "pickle_map_get") { calls = calls + 1 }
        if (rr.sym == "pickle_shadow_push" || rr.sym == "pickle_shadow_pop") { shadows = shadows + 1 }
    }
    expect(calls).toBe(1)
    expect(shadows).toBe(0)
}

/// The may-collect whitelist is a correctness boundary, so pin both directions:
/// pure/terminal leaves must be "cannot collect", while every allocating helper
/// must stay conservative. A missing CRT entry made `abiRawAlloc` and therefore
/// every string/map/list helper transitively may-GC, silently restoring a shadow
/// frame around the hottest runtime operations.
test fn extern_may_collect_pins() {
    expect(externMayCollect("__imp_memcpy")).toBe(false)
    expect(externMayCollect("__imp_memmove")).toBe(false)
    expect(externMayCollect("__imp_memset")).toBe(false)
    expect(externMayCollect("__imp_memcmp")).toBe(false)
    expect(externMayCollect("__imp_ExitProcess")).toBe(false)
    expect(externMayCollect("__imp_HeapAlloc")).toBe(false)
    expect(externMayCollect("pickle_unbox_char")).toBe(false)
    expect(externMayCollect("pickle_unbox_bool")).toBe(false)
    expect(externMayCollect("pickle_unbox_f64")).toBe(false)
    expect(externMayCollect("pickle_map_len")).toBe(false)
    expect(externMayCollect("pickle_list_len")).toBe(false)
    expect(externMayCollect("pickle_str_len")).toBe(false)
    // Raw heap entry points behind `alloc`/`free`: HeapAlloc/HeapFree only.
    expect(externMayCollect("pickle_raw_alloc")).toBe(false)
    expect(externMayCollect("pickle_raw_free")).toBe(false)
    // String -> string builders allocate, but strings are never registered in
    // the sweepability registry, so none of them can reach the trigger.
    expect(externMayCollect("pickle_str_concat")).toBe(false)
    expect(externMayCollect("pickle_str_append_owned")).toBe(false)
    expect(externMayCollect("pickle_str_from_i64")).toBe(false)
    expect(externMayCollect("pickle_str_from_bytes")).toBe(false)
    expect(externMayCollect("pickle_str_substring")).toBe(false)
    expect(externMayCollect("pickle_str_trim")).toBe(false)
    expect(externMayCollect("pickle_str_repeat")).toBe(false)
    // Allocating or callback-bearing entry points can reach the collector.
    expect(externMayCollect("pickle_box_i64")).toBe(true)
    expect(externMayCollect("pickle_map_set")).toBe(true)
    expect(externMayCollect("pickle_list_push")).toBe(true)
    expect(externMayCollect("pickle_map_keys")).toBe(true)
    // These build lists, and `abiListNew` registers through the engine.
    expect(externMayCollect("pickle_str_split_whitespace")).toBe(true)
    expect(externMayCollect("pickle_str_chars")).toBe(true)
    expect(externMayCollect("abiEngineRegister")).toBe(true)
    expect(externMayCollect("some_unknown_extern")).toBe(true)
}

/// A managed slot only needs a shadow frame when a callee can collect. A CRT
/// `memcpy` cannot, so a function that keeps a `Str` slot live across the call
/// must emit the call with no `pickle_shadow_push`/`pop` relocations at all.
test fn memcpy_call_does_not_shadow_managed_slot() {
    let e = IrExtern("__imp_memcpy", [IrTy.Ptr, IrTy.Ptr, IrTy.Int], IrTy.Unit)
    let f = mkFuncParams("f", "pkl_f", [IrParam("s", IrTy.Str)], IrTy.Str, [IrTy.Str], oneBlockTerm(
        IrTerm.Return(0),
        [IrInstr.LoadSlot(0, 0),
         IrInstr.Const(1, IrConst.Int(0)),
         IrInstr.Const(2, IrConst.Int(0)),
         IrInstr.Call(none, Callee.Extern(0), [0, 1, 2])]))
    let xf = lowerFExt(f, e)
    expect(xf.ncells).toBe(2)
    expect(len(xf.relocs)).toBe(1)
    expect(xf.relocs[0].sym).toBe("__imp_memcpy")
}

// ------------------------------------------------ in-place append selection

fn hasRelocSym(xf: X64Func, sym: string) -> bool {
    var i = 0
    while (i < len(xf.relocs)) {
        if (xf.relocs[i].sym == sym) {
            return true
        }
        i = i + 1
    }
    false
}

fn appendExtern() -> IrExtern {
    IrExtern("pickle_str_concat", [IrTy.Str, IrTy.Str], IrTy.Str)
}

/// Build the langbench-like shape: the string slot is assigned a literal on two
/// different paths, so the optimizer cannot forward the literal into the load
/// that feeds the concat chain. Slot 1 is the string; slot 0 is a bool parameter
/// used only to select the entry path.
fn appendBody(appendInstrs: List<IrInstr>, tail: List<IrBlock>) -> IrFunc {
    var bs: List<IrBlock> = []
    bs.push(IrBlock(0, [IrInstr.LoadSlot(0, 0)], IrTerm.BranchIf(0, 1, 2)))
    bs.push(IrBlock(1, [
        IrInstr.Const(1, IrConst.Str(0)),
        IrInstr.StoreSlot(1, 1)
    ], IrTerm.Branch(3)))
    bs.push(IrBlock(2, [
        IrInstr.Const(2, IrConst.Str(0)),
        IrInstr.StoreSlot(1, 2)
    ], IrTerm.Branch(3)))
    bs.push(IrBlock(3, appendInstrs, IrTerm.Branch(4)))
    for (b in tail) {
        bs.push(b)
    }
    mkFuncParams("f", "pkl_f", [IrParam("c", IrTy.Bool)], IrTy.Str, [IrTy.Bool, IrTy.Str, IrTy.Str], bs)
}

fn appendTail() -> List<IrBlock> {
    var l: List<IrBlock> = []
    l.push(IrBlock(4, [IrInstr.LoadSlot(60, 1)], IrTerm.Return(60)))
    l
}

/// The canonical owned pattern: the slot holds a literal, then a concat's only
/// reader is the store back to that same slot, and the later read cannot reach
/// the append again. The call must lower to `pickle_str_append_owned` while the
/// IR declaration stays `pickle_str_concat`.
test fn append_owned_lowering_reuses_the_private_chain() {
    let f = appendBody([
        IrInstr.LoadSlot(10, 1),
        IrInstr.Const(11, IrConst.Str(1)),
        IrInstr.Call(12, Callee.Extern(0), [10, 11]),
        IrInstr.StoreSlot(1, 12)
    ], appendTail())
    let xf = lowerFExt(f, appendExtern())
    expect(hasRelocSym(xf, "pickle_str_append_owned")).toBe(true)
    expect(hasRelocSym(xf, "pickle_str_concat")).toBe(false)
}

/// The `line = line + term + " "` shape from langbench: two concats, the first
/// result read only as the second call's argument, then one store back to the
/// slot. The backend must emit one fused `pickle_str_append_two` call instead
/// of the two sequential appends, while the IR declarations stay untouched.
test fn append_owned_lowering_handles_a_two_concat_chain() {
    let f = appendBody([
        IrInstr.LoadSlot(10, 1),
        IrInstr.Const(11, IrConst.Str(1)),
        IrInstr.Call(12, Callee.Extern(0), [10, 11]),
        IrInstr.Const(13, IrConst.Str(2)),
        IrInstr.Call(14, Callee.Extern(0), [12, 13]),
        IrInstr.StoreSlot(1, 14)
    ], appendTail())
    let xf = lowerFExt(f, appendExtern())
    expect(hasRelocSym(xf, "pickle_str_append_two")).toBe(true)
    expect(hasRelocSym(xf, "pickle_str_append_owned")).toBe(false)
    expect(hasRelocSym(xf, "pickle_str_concat")).toBe(false)
}

/// Three links stay on the proven sequential path. Fusion is only defined for
/// exactly two links, and skipping the middle call without a fused third
/// operand would lose it.
test fn append_owned_lowering_keeps_a_three_concat_chain_sequential() {
    let f = appendBody([
        IrInstr.LoadSlot(10, 1),
        IrInstr.Const(11, IrConst.Str(1)),
        IrInstr.Call(12, Callee.Extern(0), [10, 11]),
        IrInstr.Const(13, IrConst.Str(2)),
        IrInstr.Call(14, Callee.Extern(0), [12, 13]),
        IrInstr.Const(15, IrConst.Str(2)),
        IrInstr.Call(16, Callee.Extern(0), [14, 15]),
        IrInstr.StoreSlot(1, 16)
    ], appendTail())
    let xf = lowerFExt(f, appendExtern())
    expect(hasRelocSym(xf, "pickle_str_append_two")).toBe(false)
    expect(hasRelocSym(xf, "pickle_str_append_owned")).toBe(true)
    expect(hasRelocSym(xf, "pickle_str_concat")).toBe(false)
}

/// A read of the slot between the root load and the store observes the buffer
/// mid-append, so the proof must reject the whole chain. The read is stored in a
/// second slot so the optimizer cannot delete it as dead.
test fn append_owned_lowering_rejects_an_interleaved_slot_read() {
    let f = appendBody([
        IrInstr.LoadSlot(10, 1),
        IrInstr.LoadSlot(15, 1),
        IrInstr.Const(11, IrConst.Str(1)),
        IrInstr.Call(12, Callee.Extern(0), [10, 11]),
        IrInstr.StoreSlot(1, 12),
        IrInstr.StoreSlot(2, 15)
    ], appendTail())
    let xf = lowerFExt(f, appendExtern())
    expect(hasRelocSym(xf, "pickle_str_append_owned")).toBe(false)
    expect(hasRelocSym(xf, "pickle_str_concat")).toBe(true)
}

/// An escaped read that can reach the concat again (a loop back edge) makes the
/// buffer observable, even though the immediate store looks linear.
test fn append_owned_lowering_rejects_a_read_that_reaches_the_append() {
    var tail: List<IrBlock> = []
    tail.push(IrBlock(4, [
        IrInstr.LoadSlot(60, 1),
        IrInstr.Const(61, IrConst.Int(0)),
        IrInstr.BinOp(62, IrBinOp.Ne, 60, 61)
    ], IrTerm.BranchIf(62, 3, 5)))
    tail.push(IrBlock(5, [IrInstr.Const(63, IrConst.Str(0))], IrTerm.Return(63)))
    let f = appendBody([
        IrInstr.LoadSlot(10, 1),
        IrInstr.Const(11, IrConst.Str(1)),
        IrInstr.Call(12, Callee.Extern(0), [10, 11]),
        IrInstr.StoreSlot(1, 12)
    ], tail)
    let xf = lowerFExt(f, appendExtern())
    expect(hasRelocSym(xf, "pickle_str_append_owned")).toBe(false)
    expect(hasRelocSym(xf, "pickle_str_concat")).toBe(true)
}

/// A concat result with a second reader is not private, so its buffer must be
/// copied rather than mutated in place. The copy is stored in a second slot so
/// the extra reader survives optimization.
test fn append_owned_lowering_rejects_a_shared_concat_result() {
    let f = appendBody([
        IrInstr.LoadSlot(10, 1),
        IrInstr.Const(11, IrConst.Str(1)),
        IrInstr.Call(12, Callee.Extern(0), [10, 11]),
        IrInstr.Copy(13, 12),
        IrInstr.StoreSlot(1, 12),
        IrInstr.StoreSlot(2, 13)
    ], appendTail())
    let xf = lowerFExt(f, appendExtern())
    expect(hasRelocSym(xf, "pickle_str_append_owned")).toBe(false)
    expect(hasRelocSym(xf, "pickle_str_concat")).toBe(true)
}


