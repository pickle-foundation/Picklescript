module probe.big
fn work(k: int) -> int {
    var acc = 0
    var i = 0
    while (i < k) {
        acc = acc + i * i * i
        i = i + 1
    }
    acc
}
fn helper0() -> int { 0 }
fn helper1() -> int { 1 }
fn helper2() -> int { 2 }
fn helper3() -> int { 3 }
fn helper4() -> int { 4 }
fn helper5() -> int { 5 }
fn main() -> int {
    var acc = 0
    var i = 0
    while (i < 50) {
        acc = acc + work(i) + helper0() + helper1() + helper2() + helper3() + helper4() + helper5()
        i = i + 1
    }
    acc
}